# Generated outputs. Each is a deterministic product of a generator, so a
# merge, rebase or cherry-pick takes our side (driver `scalius-generated`,
# installed by `node scripts/regen-after-merge.mjs --install`) and never stops
# on a conflict; `node scripts/regen-after-merge.mjs` then rebuilds them from
# the merged sources. They stay in git as review snapshots of contract drift.
# Without the installed driver git merges them as ordinary text.
# Hand-sealed contracts (stable-operations.snapshot.json, abi.manifest/
# protocol/beta snapshots) are not listed: their conflicts are real.

apps/api/src/generated/** merge=scalius-generated linguist-generated=true
packages/api-client/openapi.json merge=scalius-generated linguist-generated=true
packages/api-client/src/generated/** merge=scalius-generated linguist-generated=true
packages/cli/src/generated/** merge=scalius-generated linguist-generated=true
packages/cli/skills/*/references/recipes.md merge=scalius-generated linguist-generated=true
packages/cli/skills/*/references/workflows*.md merge=scalius-generated linguist-generated=true
packages/shared/src/plugins/abi.sdk.snapshot.txt merge=scalius-generated linguist-generated=true
*.gen.ts merge=scalius-generated linguist-generated=true
*.gen.txt merge=scalius-generated linguist-generated=true
