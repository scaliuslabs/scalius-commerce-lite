{
  "extends": "@scalius/tsconfig/base.json",
  "compilerOptions": {
    "types": [],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "@scalius/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuild/plugin-bulk-discount.tsbuildinfo"
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/plugin-sdk"
    }
  ]
}
