{
  "name": "scalius-commerce",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:all": "pnpm dev",
    "dev:api": "bash scripts/dev.sh --filter=@scalius/api",
    "dev:admin": "bash scripts/dev.sh --filter=@scalius/admin-v2 --filter=@scalius/api",
    "dev:storefront": "bash scripts/dev.sh --filter=@scalius/storefront --filter=@scalius/api",
    "prebuild": "node scripts/copy-flags.mjs",
    "build": "node scripts/turbo-run.mjs build",
    "deploy": "node scripts/deploy.mjs",
    "deploy:api": "node scripts/deploy.mjs --only api",
    "deploy:admin": "node scripts/deploy.mjs --only admin",
    "deploy:storefront": "node scripts/deploy.mjs --only storefront",
    "ops:check": "node scripts/ops-check.mjs",
    "admin:read:check": "node scripts/admin-read-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "repo:check": "node scripts/repository-hygiene.mjs && git show --check --format= --no-renames HEAD",
    "demo:store": "node scripts/demo-store.mjs",
    "typecheck": "node scripts/turbo-run.mjs typecheck --concurrency=1",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:reset": "node scripts/dev-reset.mjs",
    "dev:admin:create": "node scripts/dev-admin.mjs create",
    "dev:admin:reset": "node scripts/dev-admin.mjs reset",
    "dev:admin:status": "node scripts/dev-admin.mjs status",
    "dev:admin:smoke": "node scripts/dev-admin-smoke.mjs",
    "dev:admin:browser-smoke": "node scripts/dev-admin-browser-smoke.mjs",
    "dev:post-sale:seed": "node scripts/dev-postsale.mjs seed",
    "dev:post-sale:smoke": "node scripts/dev-postsale.mjs checkout-smoke",
    "dev:post-sale:load": "node scripts/dev-postsale.mjs load",
    "dev:post-sale:otp": "node scripts/dev-postsale.mjs otp-smoke",
    "dev:post-sale:payment-readiness": "node scripts/dev-postsale.mjs payment-readiness",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:doctor:api": "node scripts/dev-doctor.mjs --profile api --require-running",
    "dev:doctor:admin": "node scripts/dev-doctor.mjs --profile admin --require-running",
    "dev:doctor:storefront": "node scripts/dev-doctor.mjs --profile storefront --require-running",
    "dev:doctor:all": "node scripts/dev-doctor.mjs --profile all --require-running",
    "db:generate": "node scripts/turbo-run.mjs db:generate --filter=@scalius/api",
    "db:migrate:local": "node scripts/turbo-run.mjs db:migrate:local --filter=@scalius/api",
    "db:migrate:remote": "node scripts/turbo-run.mjs db:migrate:remote --filter=@scalius/api",
    "db:studio": "drizzle-kit studio --config packages/database/drizzle.config.ts",
    "check:env": "node scripts/check-worker-env.mjs",
    "check:admin-perf": "node scripts/admin-perf-check.mjs",
    "check:admin-client-bundle": "node scripts/admin-client-bundle-report.mjs --check",
    "check:dist-secrets": "node scripts/clean-dist-env-files.mjs --check",
    "generate:agent-contract": "pnpm --dir apps/api exec tsx src/openapi/generate-agent-operation-manifest-cli.ts",
    "generate:sdk": "pnpm generate:agent-contract && node scripts/turbo-run.mjs generate --filter=@scalius/api-client",
    "lint": "node scripts/turbo-run.mjs lint --filter=!@scalius/tsconfig",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@scalius/tsconfig": "workspace:*",
    "@types/pg": "8.21.0",
    "@types/pg-copy-streams": "1.2.5",
    "country-flag-icons": "1.6.20",
    "domhandler": "6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "htmlparser2": "12.0.0",
    "pg": "8.22.0",
    "pg-copy-streams": "7.0.0",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.66.0",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
