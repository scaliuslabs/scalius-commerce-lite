{
  "name": "scalius-commerce",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "turbo dev --filter=@scalius/admin --filter=@scalius/api",
    "dev:all": "turbo dev",
    "dev:storefront": "turbo dev --filter=@scalius/storefront --filter=@scalius/api",
    "build": "turbo build",
    "deploy": "node scripts/deploy.mjs",
    "deploy:api": "turbo deploy --filter=@scalius/api",
    "deploy:admin": "turbo deploy --filter=@scalius/admin",
    "deploy:storefront": "turbo deploy --filter=@scalius/storefront",
    "typecheck": "turbo typecheck",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:reset": "node scripts/dev-reset.mjs",
    "db:generate": "turbo db:generate --filter=@scalius/api",
    "db:migrate:local": "turbo db:migrate:local --filter=@scalius/api",
    "db:migrate:remote": "turbo db:migrate:remote --filter=@scalius/api",
    "db:studio": "drizzle-kit studio --config packages/database/drizzle.config.ts",
    "generate:sdk": "turbo generate --filter=@scalius/api-client",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@scalius/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.9",
    "turbo": "^2.8.17",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.26.1",
  "overrides": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "protobufjs",
      "@firebase/util"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "date-fns": "3 || 4"
      },
      "ignoreMissing": [
        "react-is"
      ]
    },
    "overrides": {
      "jws": "^3.2.3",
      "esbuild": "^0.25.0",
      "mdast-util-to-hast": "^13.2.1",
      "markdown-it": ">=14.1.1",
      "devalue": ">=5.6.2",
      "h3": ">=1.15.5",
      "diff": ">=5.2.2",
      "lodash": ">=4.17.23",
      "undici": ">=7.18.2",
      "wrangler": ">=4.73.0"
    }
  }
}
