[
  {
    "id": "shortcuts-help",
    "title": "Keyboard shortcuts dialog",
    "route": "/admin",
    "steps": [
      {
        "press": "?",
        "measure": "open-dialog"
      }
    ],
    "waitFor": "[role=dialog]",
    "modal": true
  },
  {
    "id": "command-palette",
    "title": "Search and command palette",
    "route": "/admin",
    "steps": [
      {
        "press": "ControlOrMeta+k",
        "measure": "open-dialog"
      }
    ],
    "waitFor": "[role=dialog]",
    "modal": true
  },
  {
    "id": "notifications",
    "title": "Notifications menu",
    "route": "/admin",
    "steps": [
      {
        "click": "[data-slot=topbar] .justify-end button:nth-of-type(2)",
        "measure": "open-menu"
      }
    ],
    "waitFor": "[role=dialog],[role=menu],[data-radix-popper-content-wrapper]"
  },
  {
    "id": "store-menu",
    "title": "Store and account menu",
    "route": "/admin",
    "steps": [
      {
        "click": "[data-slot=topbar] .justify-end button:last-of-type",
        "measure": "open-menu"
      }
    ],
    "waitFor": "[role=menu],[role=dialog],[data-radix-popper-content-wrapper]"
  },
  {
    "id": "products-sort",
    "title": "Products: sort menu",
    "route": "/admin/products",
    "steps": [
      {
        "click": "button[aria-label='Sort by']",
        "measure": "open-popover"
      }
    ],
    "waitFor": "[role=dialog],[data-radix-popper-content-wrapper]",
    "locales": [
      "en"
    ]
  },
  {
    "id": "products-columns",
    "title": "Products: columns menu",
    "route": "/admin/products",
    "steps": [
      {
        "click": "button[aria-label='Columns']",
        "measure": "open-popover"
      }
    ],
    "waitFor": "[role=dialog],[data-radix-popper-content-wrapper]",
    "locales": [
      "en"
    ]
  },
  {
    "id": "products-filters",
    "title": "Products: filters panel",
    "route": "/admin/products",
    "steps": [
      {
        "click": "button[aria-controls]:has-text('Filters')",
        "measure": "open-panel"
      }
    ],
    "waitFor": "[role=group]",
    "locales": [
      "en"
    ]
  },
  {
    "id": "products-row-menu",
    "title": "Products: row actions menu",
    "route": "/admin/products",
    "steps": [
      {
        "click": "main [aria-haspopup=menu]:visible",
        "measure": "open-menu"
      }
    ],
    "waitFor": "[role=menu],[role=dialog],[data-radix-popper-content-wrapper]"
  },
  {
    "id": "products-import",
    "title": "Products: import dialog",
    "route": "/admin/products",
    "steps": [
      {
        "click": "main button:has-text('Import')",
        "measure": "open-dialog"
      }
    ],
    "waitFor": "[role=dialog]",
    "modal": true,
    "locales": [
      "en"
    ]
  }
]
