# .env.example
# Scalius Commerce Storefront - Build-Time Environment Variables
# Copy this file to `.env.development` for local development.
#
# IMPORTANT: Only PUBLIC_ prefixed vars belong in .env files.
# Secrets (API_TOKEN, JWT_SECRET, PURGE_TOKEN) go in .dev.vars (Cloudflare runtime).
# See .dev.vars.example for secret configuration.

# ── Build-Time Variables (baked into JS bundle via import.meta.env) ───────

# Full API V1 Path (used by client-side components during local dev)
PUBLIC_API_URL="http://localhost:4322/api/v1"

# Base API Path (used by SSR middleware for auth redirects)
PUBLIC_API_BASE_URL="http://localhost:8787"

# ── Optional ──────────────────────────────────────────────────────────────

# Storefront URL (used for sitemaps, og:url, etc.)
# STOREFRONT_URL="http://localhost:4322"
