---
// `/apps/<plugin id>/*`: installed apps' public routes on the store's own
// origin (lib/app-proxy.ts), for every method. Never cached here; only the
// apps that declare the proxy answer.
//
// - A browser navigation the app answers with `{ page }` is drawn inside the
//   store layout (header, footer, theme): its title as the page's h1, an
//   optional description, `noindex,follow` unless the app says `index: true`,
//   its head tags (`sanitizePluginHead`), and its body drawn by the app's own
//   component (a `storefront.components` entry targeting `page`) from the
//   answer's `props`: the same runtime as its sections (JSX escapes every
//   string), checked by the render host, its forms posting only to the app's
//   own routes, its islands under the usual island rules. Private and uncached.
// - `{ redirect }` is a 303 to that path on this store.
// - Everything else (JSON, errors, other requests) passes through exactly as
//   the API answered, keeping its Cache-Control.
import Layout from "@/layouts/Layout.astro";
import AppComponent from "@/components/apps/AppComponent.astro";
import AppHeadTags from "@/components/apps/AppHeadTags.astro";
import { getLayoutData } from "@/lib/api";
import { answerAppProxyRequest } from "@/lib/app-proxy";
import { markRenderUncacheable } from "@/lib/cache-policy";
import { appMarkup, requestExtensions, resolveSkinSettings } from "@/lib/extensions";
import { buildAbsoluteStorefrontSeoUrl } from "@/lib/seo-base-url";
import { sanitizePluginHead } from "@scalius/shared/plugins/storefront";

export const prerender = false;

const pluginId = Astro.params.pluginId ?? "";
const answer = await answerAppProxyRequest(Astro.request, pluginId, Astro.params.path ?? "");
if (answer.kind === "response") return answer.response;

const { page } = answer;
Astro.response.status = answer.status;
markRenderUncacheable(Astro.response.headers);
const head = sanitizePluginHead(page.head);
const indexed = page.index === true;
const layoutData = await getLayoutData();
const canonicalUrl = indexed ? buildAbsoluteStorefrontSeoUrl(Astro.url.pathname) ?? undefined : undefined;
// The app's page component draws the body; without one (inactive, not
// approved for storefront code, no such component) the page says so.
const { byId, host } = await requestExtensions(Astro.locals, Astro.url);
const extension = byId.get(pluginId);
const component = extension?.components.find((entry) => entry.type === page.component && entry.targets.includes("page"));
const html = extension && component
  ? await host.render(extension, { kind: "component", type: component.type, target: "page", settings: resolveSkinSettings(component.settings, {}), props: page.props }, { jsonLd: indexed })
  : null;
const body = extension ? appMarkup(extension, "component", html) : null;
---

<Layout
  title={page.title}
  description={page.description ?? ""}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl}
  noindex={!indexed}
>
  <Fragment slot="head">
    <AppHeadTags heads={[head]} jsonLd={indexed} />
  </Fragment>

  <div class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-10" data-app-page={pluginId}>
    <h1 class="text-2xl font-bold leading-tight text-foreground [overflow-wrap:anywhere] lg:text-3xl">{page.title}</h1>
    {body
      ? <div class="mt-4 [overflow-wrap:anywhere]" data-app-page-body><AppComponent markup={body} /></div>
      : <p class="mt-4 text-base text-muted-foreground" data-app-page-unavailable>This page could not be shown right now.</p>}
  </div>
</Layout>

<script>
  import { installAppForms } from "@/scripts/app-forms";

  installAppForms();
</script>
