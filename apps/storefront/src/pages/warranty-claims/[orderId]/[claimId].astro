---
// A guest's warranty claim: its thread (the store's replies, status lines and
// photos) and a reply form, reached with the order's receipt proof (its
// httpOnly cookie; the URL carries ids only). Signed-in owners have the same
// thread in their Inbox. Server-rendered, marked read when shown, and works
// without JavaScript; private and never cached.
import Layout from "@/layouts/Layout.astro";
import ConversationReplyForm from "@/components/conversation/ConversationReplyForm.astro";
import { getActiveCheckoutLanguage, getLayoutData } from "@/lib/api";
import { checkoutLanguageBaseCode, getCheckoutLanguagePreset } from "@scalius/shared/checkout-language";
import {
  CONVERSATION_COPY,
  conversationStatusLabel,
  isOrderId,
  readConversationStatusFlag,
  renderConversationMessages,
} from "@/lib/account-inbox";
import {
  attachmentUrlFor,
  markConversationRead,
  readConversation,
  type ConversationTarget,
} from "@/lib/account-inbox-server";
import { isWarrantyClaimId, pickWarrantyCopy } from "@/lib/account-warranties";
import { ACCOUNT_CONTAINER, accountUi as ui } from "@/lib/account-ui";
import { PRIVATE_NO_STORE_CACHE_CONTROL } from "@/lib/cache-policy";

export const prerender = false;

const { orderId, claimId } = Astro.params;
const target: ConversationTarget | null = isOrderId(orderId) && isWarrantyClaimId(claimId)
  ? { kind: "claim", orderId, claimId }
  : null;
const [layoutData, language, read] = await Promise.all([
  getLayoutData(),
  getActiveCheckoutLanguage().catch(() => null),
  target ? readConversation(Astro.request, target) : Promise.resolve(null),
]);
Astro.response.headers.set("Cache-Control", PRIVATE_NO_STORE_CACHE_CONTROL);
const copy = pickWarrantyCopy(language?.languageData, getCheckoutLanguagePreset(language?.code));
const thread = read?.ok ? read.data : null;
const failure = thread ? null : read && !read.ok && read.reason === "unavailable" ? "unavailable" : "no_access";
Astro.response.status = failure === "unavailable" ? 503 : failure === "no_access" ? 404 : 200;
if (target && thread) await markConversationRead(Astro.request, target, thread);

const pageHref = target ? `/warranty-claims/${encodeURIComponent(target.orderId)}/${encodeURIComponent(target.claimId)}` : "/track-order";
const receiptHref = target ? `/order-success?${new URLSearchParams({ orderId: target.orderId })}` : "/track-order";
const messagesHtml = target && thread
  ? renderConversationMessages(thread.messages, { attachmentUrl: attachmentUrlFor(target, thread), readSeq: thread.readSeq })
  : "";
const title = thread?.subject?.trim() || copy.warrantyLabelText;
---

<Layout title={title} layoutData={layoutData} documentLanguage={checkoutLanguageBaseCode(language?.code)}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <div class={ACCOUNT_CONTAINER}>
    <a href={receiptHref} data-astro-prefetch="false" class={ui.textButton}>
      <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      {CONVERSATION_COPY.viewOrder}
    </a>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">{title}</h1>

    {failure === "no_access" && (
      <div class={`${ui.empty} mt-6`} role="alert">
        <p class={ui.emptyBody}>{copy.warrantyClaimReceiptExpiredText}</p>
        <a href="/track-order" data-astro-prefetch="false" class={`${ui.primaryButton} mt-6`}>{CONVERSATION_COPY.viewOrder}</a>
      </div>
    )}
    {failure === "unavailable" && (
      <div class={`${ui.errorNotice} mt-6`} role="alert">
        {CONVERSATION_COPY.unavailable} <a href={pageHref} data-astro-prefetch="false" class="underline">{CONVERSATION_COPY.retry}</a>
      </div>
    )}

    {thread && target && (
      <div id="conversation" class="mt-2">
        <p class="text-sm text-muted-foreground">{conversationStatusLabel(thread.status)}</p>
        <div class={`${ui.card} ${ui.cardBody} mt-6`}>
          <ol id="claimMessages" class="space-y-4" aria-label="Messages" hidden={thread.messages.length === 0} set:html={messagesHtml} />
          <ConversationReplyForm
            action={`/api/warranties/orders/${encodeURIComponent(target.orderId)}/claims/${encodeURIComponent(target.claimId)}/messages`}
            returnTo={pageHref}
            messagesTargetId="claimMessages"
            idPrefix="claimReply"
            status={readConversationStatusFlag(Astro.url)}
            label="Reply"
            placeholder="Write a reply"
            note={thread.status === "closed" ? CONVERSATION_COPY.closedNote : null}
          />
        </div>
      </div>
    )}
  </div>
</Layout>
