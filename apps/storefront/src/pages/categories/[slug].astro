---
// src/pages/categories/[slug].astro
import Layout from "@/layouts/Layout.astro";
import {
  getProductsByCategory,
  getLayoutData,
  type Product,
  type ProductListOptions,
  type CategoryProductsResponse,
  type ProductFacet,
  type LayoutData,
  type Category,
} from "@/lib/api";
import CategoryFilters from "@/components/CategoryFilters";
import RichContent from "@/components/RichContent.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import CatalogPagination from "@/components/catalog/CatalogPagination.astro";
import {
  setRuntimeImageCdnPolicy,
} from "@/lib/api/runtime-env";
import {
  buildResourceCanonicalSeoUrl,
  getAbsoluteStorefrontSeoBaseUrl,
  toAbsoluteStorefrontSeoUrl,
} from "@/lib/seo-base-url";
import { getOptimizedImageUrl } from "@/lib/image-optimizer";
import {
  PRODUCT_LIST_NAVIGATION_PARAMS,
  buildProductListPaginationHref,
  resolveProductListQueryState,
} from "@/lib/product-list-query";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { normalizeSeoDiscoverySettings } from "@scalius/shared/seo-discovery";
import {
  SlidersHorizontal,
  X,
  Tags,
  ArrowLeft,
  Search,
} from "lucide-react";

const { slug } = Astro.params;
if (!slug) return new Response(null, { status: 404 });

const initialQueryState = resolveProductListQueryState({
  url: Astro.url,
  allowUnknownAttributes: true,
});
if (initialQueryState.redirectPath) {
  return Astro.redirect(initialQueryState.redirectPath);
}

let category: Category | null;
let productsResponse: CategoryProductsResponse | null;
let layoutData: LayoutData | null;
const productListOptions: ProductListOptions = initialQueryState.options;

try {
  [layoutData, productsResponse] = await Promise.all([
    getLayoutData(),
    getProductsByCategory(slug, productListOptions),
  ]);
  setRuntimeImageCdnPolicy(layoutData?.media);

  if (productsResponse?.categoryNotFound) return new Response(null, { status: 404 });
  if (!layoutData || !productsResponse || !productsResponse.category) {
    const response = storefrontDataUnavailableResponse(
      "We could not load this category. Please try again shortly.",
    );
    response.headers.set("X-Storefront-Data-State", "unavailable");
    return response;
  } else {
    category = productsResponse.category;
  }
} catch (e: unknown) {
  console.error("Error fetching category data:", e);
  const response = storefrontDataUnavailableResponse(
    "We could not load this category. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const facets: ProductFacet[] = productsResponse.facets ?? [];
const queryState = resolveProductListQueryState({ url: Astro.url, facets });
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);
const sortBy = queryState.sortBy;
const currentFilters = queryState.currentFilters;

const products: Product[] = productsResponse?.data || [];
const pagination = productsResponse?.pagination || {
  total: 0,
  totalPages: 0,
  page: 1,
};

const pageTitle = category?.metaTitle || category?.name || "Category";
const pageDescription =
  category?.metaDescription ||
  `Browse products in the ${category?.name} category.`;
const productListPathname = Astro.url.pathname;
const canonicalFilterState = JSON.stringify(currentFilters);
const hasListingQuery = Astro.url.searchParams.size > 0;

function plainText(value: string | null | undefined): string | null {
  const text = value
    ?.replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  return text ? text : null;
}

function getPaginationUrl(pageNum: number) {
  return buildProductListPaginationHref({
    pathname: productListPathname,
    currentFilters,
    page: pageNum,
  });
}

const activeFilterCount = Object.keys(currentFilters).filter(
  (key) => !PRODUCT_LIST_NAVIGATION_PARAMS.includes(key as typeof PRODUCT_LIST_NAVIGATION_PARAMS[number]) && currentFilters[key],
).reduce((count, key) => count + (
  Array.isArray(currentFilters[key]) ? currentFilters[key].length : 1
), 0);

// Include product name for richer analytics data
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;

const analyticsProductData = products.map((p) => ({
  id: p.id,
  name: p.name,
  price: p.discountedPrice,
}));

// --- SEO: per SEO-03, SEO-04, OG-02 ---
const storefrontUrl = getAbsoluteStorefrontSeoBaseUrl();
// Canonical always points to page 1 -- strips ?page, ?sortBy, and filter params (per CAN-01)
const canonicalUrl = buildResourceCanonicalSeoUrl(
  "category",
  `/categories/${slug}`,
  category?.canonicalPath,
);
const discoverySettings = normalizeSeoDiscoverySettings(
  layoutData?.seo?.discovery,
);

// OG image from category image (per OG-02, OG-05)
const ogImageUrl = category?.imageUrl
  ? toAbsoluteStorefrontSeoUrl(
      getOptimizedImageUrl(category.imageUrl, {
        width: 1200,
        height: 630,
        quality: 85,
        format: "auto",
        fit: "cover",
      }),
    )
  : null;

const categorySchemaDescription = category
  ? plainText(category.description) ||
    category.metaDescription ||
    `Browse products in ${category.name}`
  : null;

const categoryBreadcrumbJsonLd =
  discoverySettings.structuredData.breadcrumbs &&
  category &&
  !category.noIndex &&
  canonicalUrl &&
  storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${storefrontUrl}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: category.name,
            item: canonicalUrl,
          },
        ],
      })
    : null;

// CollectionPage JSON-LD for category listings (per SEO-03, SEO-04)
const collectionJsonLd =
  discoverySettings.structuredData.collections &&
  category &&
  !category.noIndex &&
  !hasListingQuery &&
  canonicalUrl &&
  storefrontUrl
  ? serializeJsonForInlineScript({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: category.name,
      ...(categorySchemaDescription ? { description: categorySchemaDescription } : {}),
      url: canonicalUrl,
      numberOfItems: pagination.total,
    })
  : null;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  ogImage={ogImageUrl ?? undefined}
  ogType="website"
  noindex={category?.noIndex === true}
>
  <Fragment slot="head">
    {
      collectionJsonLd && (
        <script is:inline type="application/ld+json" set:html={collectionJsonLd} />
      )
    }
    {
      categoryBreadcrumbJsonLd && (
        <script is:inline type="application/ld+json" set:html={categoryBreadcrumbJsonLd} />
      )
    }
  </Fragment>
  <div
    class="min-h-screen bg-gray-50"
    data-category-name={category?.name}
    data-products-for-analytics={JSON.stringify(analyticsProductData)}
  >
    <div class="bg-linear-to-b from-gray-50 to-white border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
        <nav class="text-sm mb-4">
          <ol class="flex items-center space-x-2">
            <li>
              <a href="/" class="text-gray-500 hover:text-gray-900">Home</a>
            </li>
            <li class="text-gray-300">/</li>
            <li>
              <span class="text-gray-900 font-medium">{category?.name}</span>
            </li>
          </ol>
        </nav>
        <div class="flex justify-between items-start gap-4 flex-wrap">
          <div class="space-y-2 max-w-xl">
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">
              {category?.name}
            </h1>
            {
              category?.description && (
                <RichContent
                  content={category.description}
                  className="text-gray-500 text-lg"
                  processShortcodes={false}
                />
              )
            }
          </div>
          <div
            class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-gray-50 border border-gray-100 shadow-sm"
          >
            <Tags className="w-4 h-4 text-gray-400" />
            <span class="font-medium text-gray-900 text-sm"
              >{pagination.total} products</span
            >
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
      <div class="flex flex-col lg:flex-row gap-6">
        <button
          type="button"
          id="mobile-filter-toggle"
          aria-controls="filter-section"
          aria-expanded="false"
          class="lg:hidden flex items-center justify-center gap-2 w-full py-3 px-4 bg-primary text-primary-foreground rounded-lg shadow-sm font-medium mb-4 relative"
        >
          <SlidersHorizontal className="w-4 h-4" />
          <span>Filters</span>
          {
            activeFilterCount > 0 && (
              <span class="absolute -top-1 -right-1 bg-destructive text-destructive-foreground text-xs rounded-full h-5 w-5 flex items-center justify-center">
                {activeFilterCount}
              </span>
            )
          }
        </button>

        <aside
          id="filter-section"
          aria-labelledby="mobile-filter-title"
          class="fixed inset-0 bg-black/50 z-50 hidden lg:static lg:block lg:bg-transparent lg:z-auto lg:w-80 lg:shrink-0"
        >
          <div
            class="bg-white h-full w-4/5 max-w-sm lg:w-full flex flex-col lg:rounded-lg lg:shadow-sm lg:border lg:border-gray-100"
          >
            <div
              class="flex justify-between items-center lg:hidden p-4 border-b bg-white"
            >
              <h3 id="mobile-filter-title" class="font-semibold text-lg">Filters</h3>
              <button
                type="button"
                id="mobile-filter-close"
                aria-label="Close filters"
                class="p-1 hover:bg-gray-100 rounded"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form id="filterForm" method="get" class="grow overflow-y-auto">
              <input type="hidden" name="page" value="1" />
              <!-- Hidden sortBy field to maintain sort state -->
              <input type="hidden" name="sortBy" value={sortBy} />

              <div class="p-4 lg:p-6">
                <CategoryFilters
                  client:load
                  facets={facets}
                  currentFilters={currentFilters}
                  categorySlug={slug}
                  priceRange={productsResponse.priceRange}
                />
              </div>
            </form>
          </div>
        </aside>

        <div class="flex-1 min-w-0">
          <div
            class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 p-4 bg-white rounded-lg shadow-sm border border-gray-100"
          >
            <p class="text-sm font-medium text-gray-700">
              Showing <span class="font-bold text-primary"
                >{products.length}</span
              > of{" "}
              <span class="font-bold text-primary">{pagination.total}</span> products
            </p>

            <div class="flex items-center gap-3">
              <label
                for="sortBy"
                class="text-sm font-medium text-gray-700 whitespace-nowrap"
              >
                Sort by:
              </label>
              <select
                id="sortBy"
                name="sortBy"
                data-list-pathname={productListPathname}
                data-current-filters={canonicalFilterState}
                class="rounded-lg border-gray-300 text-sm focus:ring-2 focus:ring-primary focus:border-primary min-w-[140px]"
              >
                <option value="newest" selected={sortBy === "newest"}>
                  Latest
                </option>
                <option value="price-asc" selected={sortBy === "price-asc"}>
                  Price: Low to High
                </option>
                <option value="price-desc" selected={sortBy === "price-desc"}>
                  Price: High to Low
                </option>
              </select>
            </div>
          </div>

          {
            products.length === 0 && (
              <div class="flex flex-col items-center justify-center py-16 px-4 bg-white rounded-lg shadow-sm border border-gray-100 text-center">
                <Search className="w-16 h-16 text-gray-400 mb-4" />
                <h3 class="text-xl font-bold text-gray-900 mb-2">
                  {activeFilterCount > 0 ? "No products match these filters" : "No products in this category yet"}
                </h3>
                <p class="text-gray-500 mb-6 max-w-md">
                  {activeFilterCount > 0
                    ? "Remove a filter or broaden the price range to see more products."
                    : "Browse the rest of the store while this category is being prepared."}
                </p>
                <a
                  href={activeFilterCount > 0 ? `/categories/${category?.slug}` : "/search"}
                  class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors"
                >
                  <ArrowLeft className="w-4 h-4" />
                  {activeFilterCount > 0 ? "Reset all filters" : "Browse all products"}
                </a>
              </div>
            )
          }

          {
            products.length > 0 && (
              <Fragment>
                <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 mb-8">
                  {products.map((product) => (
                    <ProductCard
                      product={product}
                      currencySymbol={currencySymbol}
                      currencyCode={currencyCode}
                    />
                  ))}
                </div>

                <CatalogPagination
                  page={pagination.page}
                  totalPages={pagination.totalPages}
                  getPageUrl={getPaginationUrl}
                />
              </Fragment>
            )
          }
        </div>
      </div>
    </div>

  </div>
</Layout>

<script>
  import { buildProductListHref } from "@/lib/product-list-query";
  import type { ProductListFilterState } from "@/lib/product-list-query";
  import { normalizeSearchQuery } from "@/lib/search-query";
  import { setupCatalogFilterDialog } from "@/lib/catalog-filter-dialog";

  function readCanonicalFilters(select: HTMLSelectElement): ProductListFilterState {
    try {
      const parsed = JSON.parse(select.dataset.currentFilters || "{}");
      if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return {};
      return Object.fromEntries(
        Object.entries(parsed).filter(
          ([, value]) =>
            typeof value === "string" ||
            (Array.isArray(value) && value.every((item) => typeof item === "string")),
        ),
      ) as ProductListFilterState;
    } catch {
      return {};
    }
  }

  function setupSortFunctionality() {
    const sortSelect = document.getElementById("sortBy");
    if (!(sortSelect instanceof HTMLSelectElement)) return;
    if (sortSelect.dataset.sortBound === "true") return;
    sortSelect.dataset.sortBound = "true";

    sortSelect.addEventListener("change", () => {
      const currentFilters = readCanonicalFilters(sortSelect);
      const rawQuery = currentFilters.q;
      const query = normalizeSearchQuery(
        Array.isArray(rawQuery) ? rawQuery.at(-1) : rawQuery,
      );
      if (query) currentFilters.q = query;
      else delete currentFilters.q;

      window.location.href = buildProductListHref({
        pathname: sortSelect.dataset.listPathname || window.location.pathname,
        currentFilters,
        overrides: {
          sortBy: sortSelect.value,
          page: 1,
        },
      });
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    setupCatalogFilterDialog();
    setupSortFunctionality();
  });

  document.addEventListener("astro:page-load", () => {
    setupCatalogFilterDialog();
    setupSortFunctionality();
  });
</script>

<script>
  import { trackFbViewContent } from "@/lib/analytics";

  type ProductAnalyticsData = {
    id: string;
    name: string;
    price: number;
  };

  function trackCategoryView() {
    const productListElement = document.querySelector<HTMLElement>(
      "[data-products-for-analytics]",
    );
    if (!productListElement || productListElement.dataset.viewContentTracked === "true")
      return;

    try {
      const productsData: ProductAnalyticsData[] = JSON.parse(
        productListElement.dataset.productsForAnalytics || "[]",
      );
      const categoryName = productListElement.dataset.categoryName || "Category";

      if (productsData.length === 0) return;

      const content_ids = productsData.map((p) => p.id);
      const contents = productsData.map((p) => ({
        id: p.id,
        item_name: p.name,
        quantity: 1,
        item_price: p.price,
      }));
      const value = productsData.reduce((sum, p) => sum + p.price, 0);

      trackFbViewContent({
        content_ids,
        content_name: `Product list for category: ${categoryName}`,
        content_type: "product_group",
        content_category: categoryName,
        contents,
        currency: window.__CURRENCY_CODE__ || "BDT",
        value,
      });

      productListElement.dataset.viewContentTracked = "true";
    } catch (error: unknown) {
      console.error("Failed to track category view content:", error);
    }
  }

  document.addEventListener("DOMContentLoaded", trackCategoryView);
  document.addEventListener("astro:page-load", trackCategoryView);
</script>
