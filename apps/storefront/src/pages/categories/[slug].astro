---
// src/pages/categories/[slug].astro
import Layout from "@/layouts/Layout.astro";
import {
  getProductsByCategory,
  getLayoutData,
  type Product,
  type ProductListOptions,
  type CategoryProductsResponse,
  type ProductFacet,
  type LayoutData,
  type Category,
} from "@/lib/api";
import CategoryFilters from "@/components/CategoryFilters";
import RichContent from "@/components/RichContent.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import CatalogPagination from "@/components/catalog/CatalogPagination.astro";
import AppliedCatalogFilters from "@/components/catalog/AppliedCatalogFilters.astro";
import CatalogEmptyState from "@/components/catalog/CatalogEmptyState.astro";
import { setRuntimeImageCdnPolicy } from "@/lib/api/runtime-env";
import {
  buildResourceCanonicalSeoUrl,
  getAbsoluteStorefrontSeoBaseUrl,
  toAbsoluteStorefrontSeoUrl,
} from "@/lib/seo-base-url";
import { getOptimizedImageUrl } from "@/lib/image-optimizer";
import {
  buildProductListPaginationHref,
  resolveProductListQueryState,
} from "@/lib/product-list-query";
import { shouldShowCatalogControls } from "@/lib/catalog-control-visibility";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { normalizeSeoDiscoverySettings } from "@scalius/shared/seo-discovery";
import {
  hasRenderableHtmlContent,
  htmlToPlainText,
} from "@scalius/shared/html-sanitize";
import { SlidersHorizontal, X, Tags, Search } from "lucide-react";

const { slug } = Astro.params;
if (!slug) return new Response(null, { status: 404 });

const initialQueryState = resolveProductListQueryState({
  url: Astro.url,
  allowUnknownAttributes: true,
});
if (initialQueryState.redirectPath) {
  return Astro.redirect(initialQueryState.redirectPath);
}

let category: Category | null;
let productsResponse: CategoryProductsResponse | null;
let layoutData: LayoutData | null;
const productListOptions: ProductListOptions = initialQueryState.options;

try {
  [layoutData, productsResponse] = await Promise.all([
    getLayoutData(),
    getProductsByCategory(slug, productListOptions),
  ]);
  setRuntimeImageCdnPolicy(layoutData?.media);

  if (productsResponse?.categoryNotFound)
    return new Response(null, { status: 404 });
  if (!layoutData || !productsResponse || !productsResponse.category) {
    const response = storefrontDataUnavailableResponse(
      "We could not load this category. Please try again shortly.",
    );
    response.headers.set("X-Storefront-Data-State", "unavailable");
    return response;
  } else {
    category = productsResponse.category;
  }
} catch (e: unknown) {
  console.error("Error fetching category data:", e);
  const response = storefrontDataUnavailableResponse(
    "We could not load this category. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const facets: ProductFacet[] = productsResponse.facets ?? [];
const queryState = resolveProductListQueryState({ url: Astro.url, facets });
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);
const sortBy = queryState.sortBy;
const currentFilters = queryState.currentFilters;

const products: Product[] = productsResponse?.data || [];
const pagination = productsResponse?.pagination || {
  total: 0,
  totalPages: 0,
  page: 1,
};

const pageTitle = category?.metaTitle || category?.name || "Category";
const pageDescription =
  category?.metaDescription ||
  `Browse products in the ${category?.name} category.`;
const productListPathname = Astro.url.pathname;
const canonicalFilterState = JSON.stringify(currentFilters);
const hasListingQuery = Astro.url.searchParams.size > 0;
const categoryDescription = category?.description ?? null;
const categoryContent = category?.content ?? null;

function plainText(value: string | null | undefined): string | null {
  const text = htmlToPlainText(value);
  return text ? text : null;
}

function getPaginationUrl(pageNum: number) {
  return buildProductListPaginationHref({
    pathname: productListPathname,
    currentFilters,
    page: pageNum,
  });
}

const activeFilterCount = Object.keys(currentFilters)
  .filter((key) => key !== "page" && key !== "sortBy" && currentFilters[key])
  .reduce(
    (count, key) =>
      count +
      (Array.isArray(currentFilters[key]) ? currentFilters[key].length : 1),
    0,
  );
const showCatalogControls = shouldShowCatalogControls({
  resultCount: pagination.total,
  activeFilterCount,
});
const shouldNoindexCategoryView = category?.noIndex === true || hasListingQuery;

// Include product name for richer analytics data
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;

const analyticsProductData = products.map((p) => ({
  id: p.id,
  name: p.name,
  price: p.discountedPrice,
}));

// --- SEO: per SEO-03, SEO-04, OG-02 ---
const storefrontUrl = getAbsoluteStorefrontSeoBaseUrl();
// Canonical always points to page 1 -- strips ?page, ?sortBy, and filter params (per CAN-01)
const canonicalUrl = buildResourceCanonicalSeoUrl(
  "category",
  `/categories/${slug}`,
  category?.canonicalPath,
);
const discoverySettings = normalizeSeoDiscoverySettings(
  layoutData?.seo?.discovery,
);

// OG image from category image (per OG-02, OG-05)
const ogImageUrl = category?.imageUrl
  ? toAbsoluteStorefrontSeoUrl(
      getOptimizedImageUrl(category.imageUrl, {
        width: 1200,
        height: 630,
        quality: 85,
        format: "auto",
        fit: "cover",
        gravity: "auto",
      }),
    )
  : null;

const categorySchemaDescription = category
  ? plainText(category.description) ||
    category.metaDescription ||
    `Browse products in ${category.name}`
  : null;

const categoryBreadcrumbJsonLd =
  discoverySettings.structuredData.breadcrumbs &&
  category &&
  !category.noIndex &&
  canonicalUrl &&
  storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${storefrontUrl}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: category.name,
            item: canonicalUrl,
          },
        ],
      })
    : null;

// CollectionPage JSON-LD for category listings (per SEO-03, SEO-04)
const collectionJsonLd =
  discoverySettings.structuredData.collections &&
  category &&
  !category.noIndex &&
  !hasListingQuery &&
  canonicalUrl &&
  storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: category.name,
        ...(categorySchemaDescription
          ? { description: categorySchemaDescription }
          : {}),
        url: canonicalUrl,
        numberOfItems: pagination.total,
      })
    : null;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  ogImage={ogImageUrl ?? undefined}
  ogType="website"
  noindex={shouldNoindexCategoryView}
>
  <Fragment slot="head">
    {
      collectionJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={collectionJsonLd}
        />
      )
    }
    {
      categoryBreadcrumbJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={categoryBreadcrumbJsonLd}
        />
      )
    }
  </Fragment>
  <div
    class="min-h-screen bg-muted/30"
    data-category-name={category?.name}
    data-products-for-analytics={JSON.stringify(analyticsProductData)}
  >
    <div class="border-b border-border bg-linear-to-b from-muted/30 to-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-8">
        <nav class="text-sm mb-4">
          <ol class="flex items-center space-x-2">
            <li>
              <a href="/" class="text-muted-foreground hover:text-foreground">Home</a>
            </li>
            <li class="text-muted-foreground/50">/</li>
            <li>
              <span class="font-medium text-foreground">{category?.name}</span>
            </li>
          </ol>
        </nav>
        <div class="flex justify-between items-start gap-4 flex-wrap">
          <div class="space-y-2 max-w-xl">
            <h1 class="text-3xl font-bold text-foreground sm:text-4xl">
              {category?.name}
            </h1>
            {
              categoryDescription &&
                hasRenderableHtmlContent(categoryDescription) && (
                  <RichContent
                    content={categoryDescription}
                    className="text-base leading-relaxed text-muted-foreground sm:text-lg"
                    processShortcodes={false}
                  />
                )
            }
          </div>
          <div
            class="hidden items-center gap-2 rounded-lg border border-border bg-background px-3 py-1.5 shadow-sm sm:flex"
          >
            <Tags className="h-4 w-4 text-muted-foreground" />
            <span class="text-sm font-medium text-foreground">
              {pagination.total} {pagination.total === 1 ? "product" : "products"}
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
      {
        showCatalogControls && (
          <div class="sticky top-[calc(var(--header-height,3.5rem)+0.5rem)] z-30 -mx-1 mb-4 grid grid-cols-2 gap-2 rounded-xl bg-background/95 p-1 backdrop-blur lg:hidden">
            <button
              type="button"
              id="mobile-filter-toggle"
              aria-controls="filter-section"
              aria-expanded="false"
              class="relative flex min-h-11 items-center justify-center gap-2 rounded-lg border border-border bg-background px-3 py-2.5 text-sm font-semibold text-foreground shadow-sm"
            >
              <SlidersHorizontal className="w-4 h-4" />
              <span>Filters</span>
              {activeFilterCount > 0 && (
                <span class="absolute -top-1 -right-1 bg-destructive text-destructive-foreground text-xs rounded-full h-5 w-5 flex items-center justify-center">
                  {activeFilterCount}
                </span>
              )}
            </button>

            <label class="relative block">
              <span class="sr-only">Sort products</span>
              <select
                id="sortByMobile"
                name="sortBy"
                data-catalog-sort
                data-list-pathname={productListPathname}
                data-current-filters={canonicalFilterState}
                class="min-h-11 w-full rounded-lg border-border bg-background py-2.5 pl-3 pr-8 text-sm font-semibold text-foreground shadow-sm focus:border-primary focus:ring-2 focus:ring-primary"
              >
                <option value="newest" selected={sortBy === "newest"}>
                  Latest
                </option>
                <option value="price-asc" selected={sortBy === "price-asc"}>
                  Price: Low to High
                </option>
                <option value="price-desc" selected={sortBy === "price-desc"}>
                  Price: High to Low
                </option>
                <option value="name-asc" selected={sortBy === "name-asc"}>
                  Name: A to Z
                </option>
                <option value="name-desc" selected={sortBy === "name-desc"}>
                  Name: Z to A
                </option>
                <option value="discount" selected={sortBy === "discount"}>
                  Biggest discount
                </option>
              </select>
            </label>
          </div>
        )
      }

      <div class="flex flex-col lg:flex-row gap-6">
        {
          showCatalogControls && (
            <aside
              id="filter-section"
              aria-labelledby="mobile-filter-title"
              class="fixed inset-0 z-60 hidden bg-black/50 lg:static lg:z-0 lg:block lg:w-80 lg:shrink-0 lg:bg-transparent"
            >
              <div class="flex h-full w-full flex-col bg-background text-foreground lg:sticky lg:top-[calc(var(--header-height,4rem)+1rem)] lg:max-h-[calc(100dvh-var(--header-height,4rem)-2rem)] lg:w-full lg:overflow-hidden lg:rounded-lg lg:border lg:border-border lg:shadow-sm">
                <div class="flex items-center justify-between border-b border-border bg-background p-4 lg:hidden">
                  <h3 id="mobile-filter-title" class="font-semibold text-lg">
                    Filters
                  </h3>
                  <button
                    type="button"
                    id="mobile-filter-close"
                    aria-label="Close filters"
                    class="inline-flex h-11 w-11 items-center justify-center rounded-lg hover:bg-muted"
                  >
                    <X className="w-5 h-5" />
                  </button>
                </div>

                <form id="filterForm" method="get" class="grow overflow-y-auto">
                  <input type="hidden" name="page" value="1" />
                  <input type="hidden" name="sortBy" value={sortBy} />

                  <div class="p-4 lg:p-6">
                    <div class="relative mb-6">
                      <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                      <label for="category-filter-search" class="sr-only">
                        Search this category
                      </label>
                      <input
                        id="category-filter-search"
                        type="search"
                        name="q"
                        placeholder="Search this category…"
                        value={queryState.query}
                        class="w-full rounded-lg border-border bg-background py-2.5 pl-9 pr-4 text-sm text-foreground focus:border-primary focus:ring-2 focus:ring-primary"
                      />
                    </div>
                    <CategoryFilters
                      client:load
                      facets={facets}
                      currentFilters={currentFilters}
                      categorySlug={slug}
                      priceRange={productsResponse.priceRange}
                    />
                  </div>
                </form>
              </div>
            </aside>
          )
        }

        <div class="flex-1 min-w-0">
          {
            showCatalogControls && (
              <div class="mb-6 hidden items-center justify-between gap-4 rounded-lg border border-border bg-background p-4 shadow-sm lg:flex">
                <p class="text-sm font-medium text-foreground">
                  Showing{" "}
                  <span class="font-bold text-primary">{products.length}</span>{" "}
                  of{" "}
                  <span class="font-bold text-primary">{pagination.total}</span>{" "}
                  products
                </p>

                <div class="flex items-center gap-3">
                  <label
                    for="sortByDesktop"
                    class="whitespace-nowrap text-sm font-medium text-foreground"
                  >
                    Sort by:
                  </label>
                  <select
                    id="sortByDesktop"
                    name="sortBy"
                    data-catalog-sort
                    data-list-pathname={productListPathname}
                    data-current-filters={canonicalFilterState}
                    class="min-w-[140px] rounded-lg border-border bg-background text-sm text-foreground focus:border-primary focus:ring-2 focus:ring-primary"
                  >
                    <option value="newest" selected={sortBy === "newest"}>
                      Latest
                    </option>
                    <option value="price-asc" selected={sortBy === "price-asc"}>
                      Price: Low to High
                    </option>
                    <option
                      value="price-desc"
                      selected={sortBy === "price-desc"}
                    >
                      Price: High to Low
                    </option>
                    <option value="name-asc" selected={sortBy === "name-asc"}>
                      Name: A to Z
                    </option>
                    <option value="name-desc" selected={sortBy === "name-desc"}>
                      Name: Z to A
                    </option>
                    <option value="discount" selected={sortBy === "discount"}>
                      Biggest discount
                    </option>
                  </select>
                </div>
              </div>
            )
          }

          <p class="mb-3 text-sm text-muted-foreground lg:hidden">
            <span class="font-semibold text-foreground">{pagination.total}</span>{
              " "
            }
            {pagination.total === 1 ? "product" : "products"}
          </p>

          <AppliedCatalogFilters
            facets={facets}
            currentFilters={currentFilters}
            pathname={productListPathname}
            resetPath={`/categories/${category?.slug}`}
            currencySymbol={currencySymbol}
          />

          {
            products.length === 0 && (
              <CatalogEmptyState
                title={activeFilterCount > 0 ? "No matching products" : "No products yet"}
                description={activeFilterCount > 0
                  ? "Try fewer filters or a broader price range."
                  : "Explore the rest of the catalog."}
                actionHref={activeFilterCount > 0
                  ? `/categories/${category?.slug}`
                  : "/search"}
                actionLabel={activeFilterCount > 0 ? "Clear filters" : "Browse products"}
              />
            )
          }

          {
            products.length > 0 && (
              <Fragment>
                <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 mb-8">
                  {products.map((product) => (
                    <ProductCard
                      product={product}
                      currencySymbol={currencySymbol}
                      currencyCode={currencyCode}
                    />
                  ))}
                </div>

                <CatalogPagination
                  page={pagination.page}
                  totalPages={pagination.totalPages}
                  getPageUrl={getPaginationUrl}
                />
              </Fragment>
            )
          }
        </div>
      </div>

      {
        categoryContent &&
          hasRenderableHtmlContent(categoryContent) &&
          !hasListingQuery && (
            <section
              class="mx-auto mt-10 max-w-4xl border-t border-border pt-8 sm:mt-12 sm:pt-10"
              aria-label={`${category.name} guide`}
            >
              <RichContent
                content={categoryContent}
                className="prose-sm sm:prose-base prose-headings:scroll-mt-24"
                processShortcodes={false}
              />
            </section>
          )
      }
    </div>
  </div>
</Layout>

<script>
  import { setupCatalogFilterDialog } from "@/lib/catalog-filter-dialog";
  import { setupCatalogSorts } from "@/lib/catalog-sort";

  document.addEventListener("DOMContentLoaded", () => {
    setupCatalogFilterDialog();
    setupCatalogSorts();
  });

  document.addEventListener("astro:page-load", () => {
    setupCatalogFilterDialog();
    setupCatalogSorts();
  });
</script>

<script>
  import { trackFbViewContent } from "@/lib/analytics";

  type ProductAnalyticsData = {
    id: string;
    name: string;
    price: number;
  };

  function trackCategoryView() {
    const productListElement = document.querySelector<HTMLElement>(
      "[data-products-for-analytics]",
    );
    if (
      !productListElement ||
      productListElement.dataset.viewContentTracked === "true"
    )
      return;

    try {
      const productsData: ProductAnalyticsData[] = JSON.parse(
        productListElement.dataset.productsForAnalytics || "[]",
      );
      const categoryName =
        productListElement.dataset.categoryName || "Category";

      if (productsData.length === 0) return;

      const content_ids = productsData.map((p) => p.id);
      const contents = productsData.map((p) => ({
        id: p.id,
        item_name: p.name,
        quantity: 1,
        item_price: p.price,
      }));
      const value = productsData.reduce((sum, p) => sum + p.price, 0);

      trackFbViewContent({
        content_ids,
        content_name: `Product list for category: ${categoryName}`,
        content_type: "product_group",
        content_category: categoryName,
        contents,
        currency: window.__CURRENCY_CODE__ || "BDT",
        value,
      });

      productListElement.dataset.viewContentTracked = "true";
    } catch (error: unknown) {
      console.error("Failed to track category view content:", error);
    }
  }

  document.addEventListener("DOMContentLoaded", trackCategoryView);
  document.addEventListener("astro:page-load", trackCategoryView);
</script>
