---
import { lowercaseHandleRedirect } from "@/lib/lowercase-route";
// src/pages/categories/[slug].astro
import { localizedPaths } from "@/lib/localized-paths";
import Layout from "@/layouts/Layout.astro";
import { resolveRequestTheme } from "@/lib/storefront-theme-context";
import { resourceBindingContext } from "@/lib/setting-bindings";
import {
  getProductsByCategory,
  getLayoutData,
  type Product,
  type ProductListOptions,
  type CategoryProductsResponse,
  type ProductFacet,
  type LayoutData,
  type Category,
} from "@/lib/api";
import CatalogListingPage from "@/components/catalog/CatalogListingPage.astro";
import { storefrontFieldValues } from "@/lib/extensions/data";
import CatalogEmptyState from "@/components/catalog/CatalogEmptyState.astro";
import { catalogChildLinks } from "@/lib/catalog-listing";
import { setRuntimeImageCdnPolicy } from "@/lib/api/runtime";
import {
  buildResourceCanonicalSeoUrl,
  getAbsoluteStorefrontSeoBaseUrl,
  toAbsoluteStorefrontSeoUrl,
  buildAbsoluteStorefrontSeoUrl,
} from "@/lib/seo-base-url";
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import { MEDIA_DISCOVERY_IMAGE_WIDTH } from "@scalius/shared/media-variants";
import {
  countActiveProductListFilters,
  isIndexableProductListView,
  isMissingProductListPage,
  productListCanonicalUrl,
  productListMetaDescription,
  resolveProductListQueryState,
} from "@/lib/product-list-query";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { catalogCopy } from "@/lib/catalog-copy";
import { formatCount, pageLanguage } from "@/lib/store-time-zone";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { htmlToPlainText } from "@scalius/shared/html-sanitize";
import RichTextStyles from "@/components/RichTextStyles.astro";

const { slug } = Astro.params;
// Handles are lowercase: a mis-cased link redirects to the one real URL.
const lowercaseRedirect = lowercaseHandleRedirect(Astro.url);
if (lowercaseRedirect) return lowercaseRedirect;
if (!slug) return new Response(null, { status: 404 });

const initialQueryState = resolveProductListQueryState({
  url: Astro.url,
  allowUnknownAttributes: true,
});
if (initialQueryState.redirectPath) {
  return Astro.redirect(initialQueryState.redirectPath);
}

let category: Category | null;
let productsResponse: CategoryProductsResponse | null;
let layoutData: LayoutData | null;
const productListOptions: ProductListOptions = initialQueryState.options;

try {
  [layoutData, productsResponse] = await Promise.all([
    getLayoutData(),
    getProductsByCategory(slug, { ...productListOptions, shelfPreview: true }),
  ]);
  setRuntimeImageCdnPolicy(layoutData?.media);

  if (productsResponse?.categoryNotFound)
    return new Response(null, { status: 404 });
  if (!layoutData || !productsResponse || !productsResponse.category) {
    const response = storefrontDataUnavailableResponse(
      "We could not load this category. Please try again shortly.",
    );
    response.headers.set("X-Storefront-Data-State", "unavailable");
    return response;
  } else {
    category = productsResponse.category;
  }
} catch (e: unknown) {
  console.error("Error fetching category data:", e);
  const response = storefrontDataUnavailableResponse(
    "We could not load this category. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const facets: ProductFacet[] = productsResponse.facets ?? [];
const queryState = resolveProductListQueryState({ url: Astro.url, facets });
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);
const currentFilters = queryState.currentFilters;

const products: Product[] = productsResponse?.data || [];
const pagination = productsResponse?.pagination || {
  total: 0,
  totalPages: 0,
  page: 1,
};
if (isMissingProductListPage(pagination)) return new Response(null, { status: 404 });

const pageTitle = `${category?.metaTitle || category?.name || "Category"}${
  pagination.page > 1 ? catalogCopy(pageLanguage()).search.page(formatCount(pagination.page)) : ""
}`;
const pageDescription =
  category.metaDescription ||
  productListMetaDescription(category.name, products.map((product) => product.name));
const productListPathname = Astro.url.pathname;
const hasListingQuery = Object.keys(currentFilters).length > 0;
const categoryDescription = category?.description ?? null;
const categoryContent = category?.content ?? null;

function plainText(value: string | null | undefined): string | null {
  const text = htmlToPlainText(value);
  return text ? text : null;
}

const activeFilterCount = countActiveProductListFilters(currentFilters);
const shouldNoindexCategoryView =
  category?.noIndex === true || !isIndexableProductListView(currentFilters);

// Include product name for richer analytics data
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;

const analyticsProductData = products.map((p) => ({
  id: p.id,
  name: p.name,
  price: p.discountedPrice,
}));

// --- SEO: per SEO-03, SEO-04, OG-02 ---
const storefrontUrl = getAbsoluteStorefrontSeoBaseUrl();
// Each paginated page is self-canonical; sort, filter and tracking params are stripped.
// The category's own handle (a localized one at a presence), not the URL's.
const categoryUrl = buildResourceCanonicalSeoUrl(
  "category",
  `/categories/${category?.slug ?? slug}`,
  category?.canonicalPath,
);
const categoryPaths = localizedPaths(category, (handle) => `/categories/${handle}`);
const canonicalUrl = productListCanonicalUrl(categoryUrl, pagination.page);

// OG image from category image (per OG-02, OG-05)
const ogImageUrl = category?.imageUrl
  ? toAbsoluteStorefrontSeoUrl(
      mediaImageUrl(category.imageUrl, MEDIA_DISCOVERY_IMAGE_WIDTH),
    )
  : null;

// The store's words, in its language (the layout read set it).
const copy = catalogCopy(pageLanguage());
const categorySchemaDescription = category
  ? plainText(category.description) ||
    category.metaDescription ||
    copy.listing.browseIn(category.name)
  : null;

// Published ancestors, root first (the category itself is the last entry).
const ancestors = (category.breadcrumb ?? []).filter((crumb) => crumb.id !== category.id);
const categoryBreadcrumbJsonLd =
  category &&
  !category.noIndex &&
  canonicalUrl &&
  storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { name: copy.breadcrumb.home, item: buildAbsoluteStorefrontSeoUrl("/") },
          ...ancestors.map((crumb) => ({
            name: crumb.name,
            item: buildResourceCanonicalSeoUrl("category", `/categories/${crumb.slug}`, crumb.canonicalPath),
          })),
          { name: category.name, item: categoryUrl },
        ]
          // Never a relative or missing URL in discovery JSON-LD.
          .filter((entry): entry is { name: string; item: string } => Boolean(entry.item))
          .map((entry, index) => ({ "@type": "ListItem", position: index + 1, ...entry })),
      })
    : null;

// CollectionPage JSON-LD for category listings (per SEO-03, SEO-04)
const collectionJsonLd =
  category &&
  !category.noIndex &&
  !hasListingQuery &&
  categoryUrl &&
  storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: category.name,
        ...(categorySchemaDescription
          ? { description: categorySchemaDescription }
          : {}),
        url: categoryUrl,
        ...(pagination.totalIsCapped ? {} : { numberOfItems: pagination.total }),
      })
    : null;
await resolveRequestTheme(Astro, layoutData, resourceBindingContext(category, `/categories/${category.slug}`));

---

<Layout
  title={pageTitle}
  description={pageDescription}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  localizedPaths={categoryPaths}
  ogImage={ogImageUrl ?? undefined}
  ogType="website"
  noindex={shouldNoindexCategoryView}
>
  <Fragment slot="head">
    <RichTextStyles when={Boolean((pagination.page === 1 && categoryDescription?.trim()) || (!hasListingQuery && categoryContent?.trim()))} />
    {
      collectionJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={collectionJsonLd}
        />
      )
    }
    {
      categoryBreadcrumbJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={categoryBreadcrumbJsonLd}
        />
      )
    }
  </Fragment>
  <CatalogListingPage
    template
    kind="category"
    fields={storefrontFieldValues(category.customFields)}
    data={{
      "data-category-name": category.name,
      "data-products-for-analytics": JSON.stringify(analyticsProductData),
    }}
    hero={{
      title: category.name,
      breadcrumb: ancestors.map((crumb) => ({ label: crumb.name, href: `/categories/${encodeURIComponent(crumb.slug)}` })),
      description: pagination.page === 1 ? categoryDescription : null,
      count: pagination.total,
      countCapped: pagination.totalIsCapped,
      banner: category.imageUrl
        ? { src: mediaImageUrl(category.imageUrl, 1440), srcset: mediaImageSrcSet(category.imageUrl), alt: "" }
        : null,
    }}
    listing={{
      products,
      shelfProducts: productsResponse.shelfProducts ?? [],
      pagination,
      facets,
      priceRange: productsResponse.priceRange,
      ratingFacet: productsResponse.ratingFacet,
      queryState,
      pathname: productListPathname,
      resetPath: `/categories/${category.slug}`,
      searchLabel: copy.listing.searchCategory,
      countEndpoint: `/categories/${encodeURIComponent(slug)}/products`,
      currencySymbol,
      currencyCode,
      listingName: category.name,
      subListings: catalogChildLinks(category),
      listingTemplate: category.listingTemplate ?? null,
    }}
    content={!hasListingQuery && categoryContent ? { html: categoryContent, label: copy.listing.guide(category.name) } : null}
  >
    <CatalogEmptyState
      slot="empty"
      title={activeFilterCount > 0 ? copy.search.noMatching : copy.listing.emptyTitle}
      description={activeFilterCount > 0 ? copy.listing.emptyFiltered : copy.listing.emptyDescription}
      actionHref={activeFilterCount > 0 ? `/categories/${category.slug}` : "/search"}
      actionLabel={activeFilterCount > 0 ? copy.listing.clearFilters : copy.listing.browseProducts}
    />
  </CatalogListingPage>
</Layout>

<script>
  import { scheduleNonCriticalAnalytics } from "@/lib/non-critical-analytics";

  type ProductAnalyticsData = {
    id: string;
    name: string;
    price: number;
  };

  async function trackCategoryView() {
    const productListElement = document.querySelector<HTMLElement>(
      "[data-products-for-analytics]",
    );
    if (
      !productListElement ||
      productListElement.dataset.viewContentTracked === "true"
    )
      return;

    try {
      const productsData: ProductAnalyticsData[] = JSON.parse(
        productListElement.dataset.productsForAnalytics || "[]",
      );
      const categoryName =
        productListElement.dataset.categoryName || "Category";

      if (productsData.length === 0) return;

      const content_ids = productsData.map((p) => p.id);
      const contents = productsData.map((p) => ({
        id: p.id,
        item_name: p.name,
        quantity: 1,
        item_price: p.price,
      }));
      const value = productsData.reduce((sum, p) => sum + p.price, 0);

      const { trackFbViewContent } = await import("@/lib/analytics");
      trackFbViewContent({
        content_ids,
        content_name: `Product list for category: ${categoryName}`,
        content_type: "product_group",
        content_category: categoryName,
        contents,
        currency: window.__CURRENCY_CODE__ || "BDT",
        value,
      });

      productListElement.dataset.viewContentTracked = "true";
    } catch (error: unknown) {
      console.error("Failed to track category view content:", error);
    }
  }

  const scheduleCategoryView = () => {
    scheduleNonCriticalAnalytics(() => void trackCategoryView());
  };
  document.addEventListener("DOMContentLoaded", scheduleCategoryView);
  document.addEventListener("astro:page-load", scheduleCategoryView);
</script>
