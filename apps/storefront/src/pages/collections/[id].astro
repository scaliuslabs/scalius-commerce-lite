---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import CategoryFilters from "@/components/CategoryFilters";
import AppliedCatalogFilters from "@/components/catalog/AppliedCatalogFilters.astro";
import RichContent from "@/components/RichContent.astro";
import { getCollectionByIdResult } from "@/lib/api";
import {
  buildResourceCanonicalSeoUrl,
  getAbsoluteStorefrontSeoBaseUrl,
  toAbsoluteStorefrontSeoUrl,
} from "@/lib/seo-base-url";
import { loadPageWithLayout } from "@/lib/page-data";
import { getProductImageUrl } from "@/lib/product-media";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import { normalizeSeoDiscoverySettings } from "@scalius/shared/seo-discovery";
import {
  hasRenderableHtmlContent,
  htmlToPlainText,
} from "@scalius/shared/html-sanitize";
import {
  buildProductListPaginationHref,
  resolveProductListQueryState,
} from "@/lib/product-list-query";
import { shouldShowCatalogControls } from "@/lib/catalog-control-visibility";
import {
  ArrowLeft,
  Tags,
  SlidersHorizontal,
  X,
  Search,
  ChevronLeft,
  ChevronRight,
} from "lucide-react";

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404 });
}

let queryState = resolveProductListQueryState({
  url: Astro.url,
  allowUnknownAttributes: true,
});
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);

const { layoutData, pageData: collectionResult } = await loadPageWithLayout(
  () => getCollectionByIdResult(id, queryState.options),
);

if (collectionResult.state === "not_found") {
  return new Response(null, { status: 404 });
}
if (collectionResult.state === "unavailable" || !layoutData) {
  const response = storefrontDataUnavailableResponse(
    "We could not load this collection. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const collection = collectionResult.data;
queryState = resolveProductListQueryState({
  url: Astro.url,
  facets: collection.facets ?? [],
});
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);
const products = collection.products ?? [];
const facets = collection.facets ?? [];
const pagination = collection.pagination;
const currentFilters = queryState.currentFilters;
const sortBy = queryState.sortBy;
const categories = collection.categories ?? [];
const defaultSortLabel = categories.length > 0 ? "Latest" : "Featured";
const canonicalFilterState = JSON.stringify(currentFilters);
const collectionDescription = collection.description ?? null;
const collectionContent = collection.content ?? null;
const title = collection.metaTitle || collection.name;
const plainDescription = htmlToPlainText(collection.description);
const description =
  collection.metaDescription ||
  plainDescription ||
  `Browse ${collection.name}.`;
const storefrontUrl = getAbsoluteStorefrontSeoBaseUrl();
const collectionPath = `/collections/${encodeURIComponent(collection.id)}`;
const canonicalUrl = buildResourceCanonicalSeoUrl(
  "collection",
  collectionPath,
  collection.canonicalPath,
);
const discoverySettings = normalizeSeoDiscoverySettings(
  layoutData?.seo?.discovery,
);
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;
const firstProductImage =
  products.find((product) => product.imageUrl)?.imageUrl ?? null;
const activeFilterCount = Object.keys(currentFilters)
  .filter((key) => key !== "page" && key !== "sortBy" && currentFilters[key])
  .reduce(
    (count, key) =>
      count +
      (Array.isArray(currentFilters[key]) ? currentFilters[key].length : 1),
    0,
  );
const showCatalogControls = shouldShowCatalogControls({
  resultCount: pagination.total,
  activeFilterCount,
});
const collectionPathname = Astro.url.pathname;
const hasListingQuery = Astro.url.searchParams.size > 0;
const shouldNoindexCollectionView =
  collection.noIndex === true || hasListingQuery;

function getPaginationUrl(page: number) {
  return buildProductListPaginationHref({
    pathname: collectionPathname,
    currentFilters,
    page,
  });
}
const ogImageUrl = firstProductImage
  ? toAbsoluteStorefrontSeoUrl(
      getProductImageUrl(firstProductImage, {
        width: 1200,
        height: 630,
        quality: 85,
        format: "auto",
        fit: "pad",
      }),
    )
  : undefined;

const collectionBreadcrumbJsonLd =
  discoverySettings.structuredData.breadcrumbs &&
  !collection.noIndex &&
  canonicalUrl &&
  storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${storefrontUrl}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: collection.name,
            item: canonicalUrl,
          },
        ],
      })
    : null;

const collectionJsonLd =
  discoverySettings.structuredData.collections &&
  !collection.noIndex &&
  !hasListingQuery &&
  canonicalUrl &&
  storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: collection.name,
        description,
        url: canonicalUrl,
        numberOfItems: pagination.total,
      })
    : null;
---

<Layout
  title={title}
  description={description}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  ogImage={ogImageUrl ?? undefined}
  ogType="website"
  noindex={shouldNoindexCollectionView}
>
  <Fragment slot="head">
    {
      collectionJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={collectionJsonLd}
        />
      )
    }
    {
      collectionBreadcrumbJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={collectionBreadcrumbJsonLd}
        />
      )
    }
  </Fragment>

  <div class="min-h-screen bg-gray-50">
    <section
      class="bg-linear-to-b from-gray-50 to-white border-b border-gray-100"
    >
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
        <nav class="mb-4 text-sm">
          <ol class="flex items-center gap-2">
            <li>
              <a
                href="/"
                class="inline-flex items-center gap-1.5 text-gray-500 hover:text-gray-900"
              >
                <ArrowLeft className="h-4 w-4" />
                Home
              </a>
            </li>
            <li class="text-gray-300">/</li>
            <li>
              <span class="font-medium text-gray-900">{collection.name}</span>
            </li>
          </ol>
        </nav>

        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="max-w-2xl space-y-2">
            <h1
              class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
            >
              {collection.name}
            </h1>
            {
              collectionDescription &&
                hasRenderableHtmlContent(collectionDescription) && (
                  <RichContent
                    content={collectionDescription}
                    className="text-base leading-relaxed text-gray-500 sm:text-lg"
                    processShortcodes={false}
                  />
                )
            }
            {
              categories.length > 0 && (
                <div class="flex flex-wrap gap-2 pt-2">
                  {categories.map((category) => (
                    <a
                      href={`/categories/${category.slug}`}
                      class="rounded-full bg-muted px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-primary"
                    >
                      {category.name}
                    </a>
                  ))}
                </div>
              )
            }
          </div>

          <div
            class="hidden items-center gap-2 rounded-lg border border-gray-100 bg-white px-3 py-1.5 shadow-sm lg:flex"
          >
            <Tags className="h-4 w-4 text-gray-400" />
            <span class="text-sm font-medium text-gray-900">
              {pagination.total} products
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      {
        showCatalogControls && (
          <div class="sticky top-[calc(var(--header-height,3.5rem)+0.5rem)] z-30 -mx-1 mb-4 grid grid-cols-2 gap-2 rounded-xl bg-gray-50/95 p-1 backdrop-blur lg:hidden">
            <button
              id="collection-filter-toggle"
              type="button"
              aria-controls="collection-filter-section"
              aria-expanded="false"
              class="relative flex min-h-11 items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm font-semibold text-gray-800 shadow-sm"
            >
              <SlidersHorizontal className="h-4 w-4" />
              <span>Filters</span>
              {activeFilterCount > 0 && (
                <span class="absolute -right-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-destructive px-1 text-xs text-destructive-foreground">
                  {activeFilterCount}
                </span>
              )}
            </button>

            <label class="relative block">
              <span class="sr-only">Sort products</span>
              <select
                id="collectionSortByMobile"
                name="sortBy"
                data-catalog-sort
                data-list-pathname={collectionPath}
                data-current-filters={canonicalFilterState}
                class="min-h-11 w-full rounded-lg border-gray-200 bg-white py-2.5 pl-3 pr-8 text-sm font-semibold text-gray-800 shadow-sm focus:border-primary focus:ring-2 focus:ring-primary"
              >
                <option value="newest" selected={sortBy === "newest"}>
                  {defaultSortLabel}
                </option>
                <option value="price-asc" selected={sortBy === "price-asc"}>
                  Price: Low to High
                </option>
                <option value="price-desc" selected={sortBy === "price-desc"}>
                  Price: High to Low
                </option>
                <option value="name-asc" selected={sortBy === "name-asc"}>
                  Name: A to Z
                </option>
                <option value="name-desc" selected={sortBy === "name-desc"}>
                  Name: Z to A
                </option>
                <option value="discount" selected={sortBy === "discount"}>
                  Biggest discount
                </option>
              </select>
            </label>
          </div>
        )
      }

      <div class="flex flex-col gap-6 lg:flex-row">
        {
          showCatalogControls && (
            <aside
              id="collection-filter-section"
              class="fixed inset-0 z-60 hidden bg-black/50 lg:static lg:z-0 lg:block lg:w-80 lg:shrink-0 lg:bg-transparent"
              aria-labelledby="collection-filter-title"
            >
              <div class="flex h-full w-full flex-col bg-white lg:sticky lg:top-[calc(var(--header-height,4rem)+1rem)] lg:max-h-[calc(100dvh-var(--header-height,4rem)-2rem)] lg:w-full lg:overflow-hidden lg:rounded-lg lg:border lg:border-gray-100 lg:shadow-sm">
                <div class="flex items-center justify-between border-b p-4 lg:hidden">
                  <h2
                    id="collection-filter-title"
                    class="text-lg font-semibold"
                  >
                    Filters
                  </h2>
                  <button
                    id="collection-filter-close"
                    type="button"
                    class="inline-flex h-11 w-11 items-center justify-center rounded-lg hover:bg-gray-100"
                    aria-label="Close filters"
                  >
                    <X className="h-5 w-5" />
                  </button>
                </div>
                <form id="filterForm" method="get" class="grow overflow-y-auto">
                  <input type="hidden" name="page" value="1" />
                  <input type="hidden" name="sortBy" value={sortBy} />
                  <div class="p-4 lg:p-6">
                    <div class="relative mb-6">
                      <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" />
                      <input
                        type="search"
                        name="q"
                        placeholder="Search this collection…"
                        value={queryState.query}
                        class="w-full rounded-lg border-gray-300 py-2.5 pl-9 pr-4 text-sm focus:border-primary focus:ring-2 focus:ring-primary"
                      />
                    </div>
                    <CategoryFilters
                      client:load
                      facets={facets}
                      currentFilters={currentFilters}
                      priceRange={collection.priceRange}
                      resetPath={collectionPath}
                    />
                  </div>
                </form>
              </div>
            </aside>
          )
        }

        <div class="min-w-0 flex-1">
          {
            showCatalogControls && (
              <div class="mb-6 hidden items-center justify-between gap-4 rounded-lg border border-gray-100 bg-white p-4 shadow-sm lg:flex">
                <p class="text-sm font-medium text-gray-700">
                  Showing{" "}
                  <span class="font-bold text-primary">{products.length}</span>{" "}
                  of{" "}
                  <span class="font-bold text-primary">{pagination.total}</span>{" "}
                  products
                </p>

                <div class="flex items-center gap-3">
                  <label
                    for="collectionSortByDesktop"
                    class="whitespace-nowrap text-sm font-medium text-gray-700"
                  >
                    Sort by:
                  </label>
                  <select
                    id="collectionSortByDesktop"
                    name="sortBy"
                    data-catalog-sort
                    data-list-pathname={collectionPath}
                    data-current-filters={canonicalFilterState}
                    class="min-w-[160px] rounded-lg border-gray-300 text-sm focus:border-primary focus:ring-2 focus:ring-primary"
                  >
                    <option value="newest" selected={sortBy === "newest"}>
                      {defaultSortLabel}
                    </option>
                    <option value="price-asc" selected={sortBy === "price-asc"}>
                      Price: Low to High
                    </option>
                    <option
                      value="price-desc"
                      selected={sortBy === "price-desc"}
                    >
                      Price: High to Low
                    </option>
                    <option value="name-asc" selected={sortBy === "name-asc"}>
                      Name: A to Z
                    </option>
                    <option value="name-desc" selected={sortBy === "name-desc"}>
                      Name: Z to A
                    </option>
                    <option value="discount" selected={sortBy === "discount"}>
                      Biggest discount
                    </option>
                  </select>
                </div>
              </div>
            )
          }

          <p class="mb-3 text-sm text-gray-600 lg:hidden">
            <span class="font-semibold text-gray-900">{pagination.total}</span>{
              " "
            }
            {pagination.total === 1 ? "product" : "products"}
          </p>

          <AppliedCatalogFilters
            facets={facets}
            currentFilters={currentFilters}
            pathname={collectionPath}
            resetPath={collectionPath}
            currencySymbol={currencySymbol}
          />

          {
            products.length > 0 ? (
              <>
                <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 xl:grid-cols-4">
                  {products.map((product) => (
                    <ProductCard
                      product={product}
                      currencySymbol={currencySymbol}
                      currencyCode={currencyCode}
                    />
                  ))}
                </div>

                {pagination.totalPages > 1 && (
                  <nav
                    class="mt-8 flex items-center justify-center"
                    aria-label="Collection pagination"
                  >
                    <div class="flex items-center gap-1 rounded-lg border border-gray-100 bg-white p-2 shadow-sm">
                      {pagination.page > 1 ? (
                        <a
                          href={getPaginationUrl(pagination.page - 1)}
                          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-200 text-gray-700 hover:bg-gray-50"
                          aria-label="Previous page"
                        >
                          <ChevronLeft className="h-4 w-4" aria-hidden="true" />
                        </a>
                      ) : (
                        <button
                          type="button"
                          disabled
                          aria-label="Previous page"
                          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-100 text-gray-300"
                        >
                          <ChevronLeft className="h-4 w-4" aria-hidden="true" />
                        </button>
                      )}
                      <span class="px-3 text-sm font-medium text-gray-700">
                        Page {pagination.page} of {pagination.totalPages}
                      </span>
                      {pagination.page < pagination.totalPages ? (
                        <a
                          href={getPaginationUrl(pagination.page + 1)}
                          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-200 text-gray-700 hover:bg-gray-50"
                          aria-label="Next page"
                        >
                          <ChevronRight
                            className="h-4 w-4"
                            aria-hidden="true"
                          />
                        </a>
                      ) : (
                        <button
                          type="button"
                          disabled
                          aria-label="Next page"
                          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-100 text-gray-300"
                        >
                          <ChevronRight
                            className="h-4 w-4"
                            aria-hidden="true"
                          />
                        </button>
                      )}
                    </div>
                  </nav>
                )}
              </>
            ) : (
              <div class="rounded-lg border border-dashed border-gray-200 bg-white px-6 py-12 text-center">
                <p class="text-sm font-medium text-gray-900">
                  {activeFilterCount > 0 || queryState.query
                    ? "No products match these filters."
                    : "No products in this collection yet."}
                </p>
                {(activeFilterCount > 0 || queryState.query) && (
                  <a
                    href={collectionPath}
                    class="mt-3 inline-flex text-sm font-medium text-primary hover:underline"
                  >
                    Reset filters
                  </a>
                )}
              </div>
            )
          }
        </div>
      </div>

      {
        collectionContent &&
          hasRenderableHtmlContent(collectionContent) &&
          !hasListingQuery && (
            <section
              class="mx-auto mt-10 max-w-4xl border-t border-gray-200 pt-8 sm:mt-12 sm:pt-10"
              aria-label={`${collection.name} guide`}
            >
              <RichContent
                content={collectionContent}
                className="prose-sm sm:prose-base prose-headings:scroll-mt-24"
                processShortcodes={false}
              />
            </section>
          )
      }
    </section>
  </div>
</Layout>

<script>
  import { setupCatalogFilterDialog } from "@/lib/catalog-filter-dialog";
  import { setupCatalogSorts } from "@/lib/catalog-sort";

  const setupCollectionCatalog = () => {
    setupCatalogFilterDialog({
      toggleId: "collection-filter-toggle",
      closeId: "collection-filter-close",
      dialogId: "collection-filter-section",
    });
    setupCatalogSorts();
  };

  document.addEventListener("DOMContentLoaded", setupCollectionCatalog);
  document.addEventListener("astro:page-load", setupCollectionCatalog);
</script>
