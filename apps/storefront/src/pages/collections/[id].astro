---
import Layout from "@/layouts/Layout.astro";
import CatalogListing from "@/components/catalog/CatalogListing.astro";
import CatalogDescription from "@/components/catalog/CatalogDescription.astro";
import CatalogEmptyState from "@/components/catalog/CatalogEmptyState.astro";
import RichContent from "@/components/RichContent.astro";
import { getCollectionByIdResult } from "@/lib/api";
import {
  buildResourceCanonicalSeoUrl,
  getAbsoluteStorefrontSeoBaseUrl,
  toAbsoluteStorefrontSeoUrl,
} from "@/lib/seo-base-url";
import { loadPageWithLayout } from "@/lib/page-data";
import { getProductImageUrl } from "@/lib/product-media";
import { MEDIA_DISCOVERY_IMAGE_WIDTH } from "@scalius/shared/media-variants";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import {
  hasRenderableHtmlContent,
  htmlToPlainText,
} from "@scalius/shared/html-sanitize";
import {
  countActiveProductListFilters,
  isIndexableProductListView,
  isMissingProductListPage,
  productListCanonicalUrl,
  productListMetaDescription,
  resolveProductListQueryState,
} from "@/lib/product-list-query";
import { ArrowLeft, Tags } from "lucide-react";

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404 });
}

let queryState = resolveProductListQueryState({
  url: Astro.url,
  allowUnknownAttributes: true,
});
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);

const { layoutData, pageData: collectionResult } = await loadPageWithLayout(
  () => getCollectionByIdResult(id, queryState.options),
);

if (collectionResult.state === "not_found") {
  return new Response(null, { status: 404 });
}
if (collectionResult.state === "unavailable" || !layoutData) {
  const response = storefrontDataUnavailableResponse(
    "We could not load this collection. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const collection = collectionResult.data;
queryState = resolveProductListQueryState({
  url: Astro.url,
  facets: collection.facets ?? [],
});
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);
const products = collection.products ?? [];
const facets = collection.facets ?? [];
const pagination = collection.pagination;
if (isMissingProductListPage(pagination)) return new Response(null, { status: 404 });
const currentFilters = queryState.currentFilters;
const categories = collection.categories ?? [];
const collectionDescription = collection.description ?? null;
const collectionContent = collection.content ?? null;
const title = `${collection.metaTitle || collection.name}${
  pagination.page > 1 ? ` – Page ${pagination.page}` : ""
}`;
const plainDescription = htmlToPlainText(collection.description);
const description =
  collection.metaDescription ||
  plainDescription ||
  productListMetaDescription(collection.name, products.map((product) => product.name));
const storefrontUrl = getAbsoluteStorefrontSeoBaseUrl();
const collectionPath = `/collections/${encodeURIComponent(collection.id)}`;
// Each paginated page is self-canonical; sort, filter and tracking params are stripped.
const collectionUrl = buildResourceCanonicalSeoUrl(
  "collection",
  collectionPath,
  collection.canonicalPath,
);
const canonicalUrl = productListCanonicalUrl(collectionUrl, pagination.page);
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;
const firstProductImage =
  products.find((product) => product.imageUrl)?.imageUrl ?? null;
const activeFilterCount = countActiveProductListFilters(currentFilters);
const hasListingQuery = Object.keys(currentFilters).length > 0;
const shouldNoindexCollectionView =
  collection.noIndex === true || !isIndexableProductListView(currentFilters);
const ogImageUrl = firstProductImage
  ? toAbsoluteStorefrontSeoUrl(
      getProductImageUrl(firstProductImage, MEDIA_DISCOVERY_IMAGE_WIDTH),
    )
  : undefined;

const collectionBreadcrumbJsonLd =
  !collection.noIndex &&
  canonicalUrl &&
  storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${storefrontUrl}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: collection.name,
            item: collectionUrl,
          },
        ],
      })
    : null;

const collectionJsonLd =
  !collection.noIndex &&
  !hasListingQuery &&
  collectionUrl &&
  storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: collection.name,
        description,
        url: collectionUrl,
        numberOfItems: pagination.total,
      })
    : null;
---

<Layout
  title={title}
  description={description}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  ogImage={ogImageUrl ?? undefined}
  ogType="website"
  noindex={shouldNoindexCollectionView}
>
  <Fragment slot="head">
    {
      collectionJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={collectionJsonLd}
        />
      )
    }
    {
      collectionBreadcrumbJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={collectionBreadcrumbJsonLd}
        />
      )
    }
  </Fragment>

  <div class="min-h-screen bg-muted/30">
    <section
      class="border-b border-border bg-linear-to-b from-muted/30 to-background"
    >
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
        <nav class="mb-4 text-sm">
          <ol class="flex items-center gap-2">
            <li>
              <a
                href="/"
                class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground"
              >
                <ArrowLeft className="h-4 w-4" />
                Home
              </a>
            </li>
            <li class="text-muted-foreground/50" aria-hidden="true">/</li>
            <li>
              <span class="font-medium text-foreground">{collection.name}</span>
            </li>
          </ol>
        </nav>

        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="max-w-2xl space-y-2">
            <h1
              class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
            >
              {collection.name}
            </h1>
            {
              collectionDescription &&
                hasRenderableHtmlContent(collectionDescription) &&
                pagination.page === 1 && <CatalogDescription content={collectionDescription} />
            }
            {
              categories.length > 0 && (
                <div class="flex flex-wrap gap-2 pt-2">
                  {categories.map((category) => (
                    <a
                      href={`/categories/${category.slug}`}
                      class="rounded-full bg-muted px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-primary"
                    >
                      {category.name}
                    </a>
                  ))}
                </div>
              )
            }
          </div>

          <div
            class="hidden items-center gap-2 rounded-lg border border-border bg-background px-3 py-1.5 shadow-sm lg:flex"
          >
            <Tags className="h-4 w-4 text-muted-foreground" />
            <span class="text-sm font-medium text-foreground">
              {pagination.total} {pagination.total === 1 ? "product" : "products"}
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <CatalogListing
        products={products}
        pagination={pagination}
        facets={facets}
        priceRange={collection.priceRange}
        queryState={queryState}
        pathname={collectionPath}
        resetPath={collectionPath}
        searchLabel="Search this collection"
        newestLabel={categories.length > 0 ? "Latest" : "Featured"}
        countEndpoint={collectionPath}
        currencySymbol={currencySymbol}
        currencyCode={currencyCode}
      >
        <CatalogEmptyState
          slot="empty"
          title={activeFilterCount > 0 ? "No matching products" : "No products yet"}
          description={activeFilterCount > 0
            ? "Try fewer filters or a different search."
            : "Explore the rest of the catalog."}
          actionHref={activeFilterCount > 0 ? collectionPath : "/search"}
          actionLabel={activeFilterCount > 0 ? "Clear filters" : "Browse products"}
        />
      </CatalogListing>

      {
        collectionContent &&
          hasRenderableHtmlContent(collectionContent) &&
          !hasListingQuery && (
            <section
              class="mx-auto mt-10 max-w-4xl border-t border-border pt-8 sm:mt-12 sm:pt-10"
              aria-label={`${collection.name} guide`}
            >
              <RichContent
                content={collectionContent}
                className="prose-sm sm:prose-base prose-headings:scroll-mt-24"
                processShortcodes={false}
              />
            </section>
          )
      }
    </section>
  </div>
</Layout>
