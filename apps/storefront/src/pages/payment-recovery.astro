---
import Layout from "@/layouts/Layout.astro";
import {
  getActiveCheckoutLanguage,
  getLayoutData,
  type CheckoutLanguageData,
  type LayoutData,
} from "@/lib/api";
import { getCheckoutConfig } from "@/lib/api/checkout";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import {
  ENGLISH_CHECKOUT_LANGUAGE_DATA,
  checkoutLanguageBaseCode,
} from "@scalius/shared/checkout-language";

const orderId = Astro.url.searchParams.get("orderId")?.trim() ?? "";
const [layoutData, checkoutConfig, checkoutLanguageResponse]: [
  LayoutData | null,
  Awaited<ReturnType<typeof getCheckoutConfig>>,
  CheckoutLanguageData | null,
] = await Promise.all([
  getLayoutData(),
  getCheckoutConfig(),
  getActiveCheckoutLanguage(),
]);
const checkoutLanguage: CheckoutLanguageData = checkoutLanguageResponse ?? {
  id: "fallback",
  name: "English (Fallback)",
  code: "en",
  languageData: { ...ENGLISH_CHECKOUT_LANGUAGE_DATA },
  fieldVisibility: {
    showEmailField: true,
    showOrderNotesField: true,
    showAreaField: true,
  },
  isActive: true,
  isDefault: true,
};
const copy = checkoutLanguage.languageData;
const recoveryChannelLabels = {
  sms: copy.paymentRecoverySmsChannelText,
  whatsapp: copy.paymentRecoveryWhatsappChannelText,
  email: copy.paymentRecoveryEmailChannelText,
} as const;
const recoveryChannels = (checkoutConfig.customerAuthPolicy?.otpChannels ?? [])
  .filter((channel): channel is keyof typeof recoveryChannelLabels => channel in recoveryChannelLabels);
const defaultRecoveryChannel = checkoutConfig.customerAuthPolicy?.defaultOtpChannel;
const orderedRecoveryChannels = defaultRecoveryChannel && recoveryChannels.includes(defaultRecoveryChannel)
  ? [defaultRecoveryChannel, ...recoveryChannels.filter((channel) => channel !== defaultRecoveryChannel)]
  : recoveryChannels;
const serializedCheckoutLanguage = serializeJsonForInlineScript(checkoutLanguage);
---

<Layout
  title={copy.paymentRecoveryPageTitleText}
  layoutData={layoutData}
  documentLanguage={checkoutLanguageBaseCode(checkoutLanguage.code)}
>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <section class="container mx-auto flex min-h-[60vh] items-center px-4 py-10">
    <div class="mx-auto w-full max-w-xl rounded-xl border border-border bg-background p-5 shadow-sm sm:p-6">
      <div class="mb-5">
        <p class="text-sm font-medium uppercase text-muted-foreground">{copy.paymentRecoveryEyebrowText}</p>
        <h1 class="mt-1 text-2xl font-semibold tracking-normal text-foreground">{copy.paymentRecoveryHeadingText}</h1>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          {copy.paymentRecoveryIntroText}
        </p>
      </div>

      {orderId && orderedRecoveryChannels.length > 0 ? (
        <form id="paymentRecoveryForm" class="space-y-4" method="post" action="/api/payment-recovery/send-code">
          <input type="hidden" id="paymentRecoveryOrderId" name="orderId" value={orderId} />

          <div class="rounded-lg border border-border bg-muted/20 px-3 py-2 text-sm">
            <span class="text-muted-foreground">{copy.paymentRecoveryOrderReferenceText}</span>
            <span class="ml-2 font-mono font-medium text-foreground">{orderId}</span>
          </div>

          <div class="grid gap-2">
            <label for="paymentRecoveryChannel" class="text-sm font-medium text-foreground">{copy.paymentRecoveryVerificationChannelText}</label>
            <select
              id="paymentRecoveryChannel"
              name="channel"
              class="min-h-11 rounded-lg border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none transition focus:border-ring focus:ring-2 focus:ring-ring/20"
            >
              {orderedRecoveryChannels.map((channel) => (
                <option value={channel}>{recoveryChannelLabels[channel]}</option>
              ))}
            </select>
          </div>

          <div class="flex flex-col gap-2 sm:flex-row">
            <button
              type="button"
              id="paymentRecoverySendCode"
              class="inline-flex min-h-11 flex-1 items-center justify-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60"
            >
              {copy.paymentRecoverySendCodeText}
            </button>
          </div>

          <div class="grid gap-2">
            <label for="paymentRecoveryCode" class="text-sm font-medium text-foreground">{copy.paymentRecoveryVerificationCodeText}</label>
            <input
              id="paymentRecoveryCode"
              name="code"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="12"
              class="min-h-11 rounded-lg border border-input bg-background px-3 text-center font-mono text-lg tracking-[0.35em] text-foreground shadow-sm outline-none transition focus:border-ring focus:ring-2 focus:ring-ring/20"
              placeholder="000000"
            />
          </div>

          <button
            type="button"
            id="paymentRecoveryVerify"
            class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-foreground px-4 text-sm font-semibold text-background transition-colors hover:bg-foreground/90 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {copy.paymentRecoveryContinueToReceiptText}
          </button>

          <p id="paymentRecoveryMessage" class="min-h-5 text-sm text-muted-foreground" aria-live="polite"></p>
        </form>
      ) : orderId ? (
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
          {copy.paymentRecoveryUnavailableText}
        </div>
      ) : (
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
          {copy.paymentRecoveryMissingOrderText}
        </div>
      )}

      <div class="mt-5 flex flex-wrap gap-2 border-t border-border pt-4 text-sm">
        <a href="/account" data-astro-prefetch={getStorefrontPrefetchAttribute("/account", Astro.url)} class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">{copy.paymentRecoveryViewAccountOrdersText}</a>
        <span class="text-muted-foreground">/</span>
        <a href="/" class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">{copy.continueShoppingText}</a>
      </div>
    </div>
  </section>

  <script
    is:inline
    set:html={`window.__CHECKOUT_LANGUAGE__=${serializedCheckoutLanguage};`}
  ></script>
</Layout>

<script>
  import {
    ENGLISH_CHECKOUT_LANGUAGE_DATA,
    type CheckoutLanguageData,
  } from "@scalius/shared/checkout-language";
  import { getPaymentRecoveryFailureText } from "@/lib/payment-recovery-messages";

  class PaymentRecoveryRequestError extends Error {
    readonly errorCode?: string;
    readonly status: number;

    constructor(status: number, errorCode?: string) {
      super("Payment recovery request failed");
      this.name = "PaymentRecoveryRequestError";
      this.status = status;
      this.errorCode = errorCode;
    }
  }

  const activeLanguage = window.__CHECKOUT_LANGUAGE__ as
    | { languageData?: CheckoutLanguageData }
    | undefined;
  const copy = activeLanguage?.languageData ?? ENGLISH_CHECKOUT_LANGUAGE_DATA;
  const form = document.getElementById("paymentRecoveryForm") as HTMLFormElement | null;
  const orderInput = document.getElementById("paymentRecoveryOrderId") as HTMLInputElement | null;
  const channelInput = document.getElementById("paymentRecoveryChannel") as HTMLSelectElement | null;
  const codeInput = document.getElementById("paymentRecoveryCode") as HTMLInputElement | null;
  const sendButton = document.getElementById("paymentRecoverySendCode") as HTMLButtonElement | null;
  const verifyButton = document.getElementById("paymentRecoveryVerify") as HTMLButtonElement | null;
  const message = document.getElementById("paymentRecoveryMessage");

  function setMessage(text: string, tone: "neutral" | "danger" | "success" = "neutral") {
    if (!message) return;
    message.textContent = text;
    message.className = [
      "min-h-5 text-sm",
      tone === "danger" ? "text-destructive" : tone === "success" ? "text-emerald-700" : "text-muted-foreground",
    ].join(" ");
  }

  async function postJson(url: string, payload: Record<string, unknown>) {
    const response = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await response.json().catch(() => ({} as Record<string, unknown>));
    if (!response.ok || data.success === false) {
      throw new PaymentRecoveryRequestError(
        response.status,
        typeof data.errorCode === "string" ? data.errorCode : undefined,
      );
    }
    return data;
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
  });

  sendButton?.addEventListener("click", async () => {
    const orderId = orderInput?.value.trim() ?? "";
    const channel = channelInput?.value ?? "sms";
    if (!orderId) {
      setMessage(copy.paymentRecoveryMissingOrderText, "danger");
      return;
    }

    sendButton.disabled = true;
    setMessage(copy.paymentRecoverySendingCodeText);
    try {
      await postJson("/api/payment-recovery/send-code", { orderId, channel });
      setMessage(copy.paymentRecoveryCodeSentText, "success");
      codeInput?.focus();
    } catch (error) {
      setMessage(
        error instanceof PaymentRecoveryRequestError
          ? getPaymentRecoveryFailureText({
              copy,
              operation: "send",
              errorCode: error.errorCode,
              status: error.status,
            })
          : copy.paymentRecoverySendFailedText,
        "danger",
      );
    } finally {
      sendButton.disabled = false;
    }
  });

  verifyButton?.addEventListener("click", async () => {
    const orderId = orderInput?.value.trim() ?? "";
    const channel = channelInput?.value ?? "sms";
    const code = codeInput?.value.trim() ?? "";
    if (!orderId || !code) {
      setMessage(copy.paymentRecoveryEnterCodeText, "danger");
      return;
    }

    verifyButton.disabled = true;
    setMessage(copy.paymentRecoveryVerifyingCodeText);
    try {
      const data = await postJson("/api/payment-recovery/verify", { orderId, channel, code });
      const redirectUrl = typeof data.redirectUrl === "string" ? data.redirectUrl : `/order-success?orderId=${encodeURIComponent(orderId)}`;
      window.location.href = redirectUrl;
    } catch (error) {
      verifyButton.disabled = false;
      setMessage(
        error instanceof PaymentRecoveryRequestError
          ? getPaymentRecoveryFailureText({
              copy,
              operation: "verify",
              errorCode: error.errorCode,
              status: error.status,
            })
          : copy.paymentRecoveryVerificationFailedText,
        "danger",
      );
    }
  });
</script>
