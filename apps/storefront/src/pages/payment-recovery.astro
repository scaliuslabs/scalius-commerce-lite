---
// Finish paying: the merchant-sendable link (/payment-recovery?orderId=…)
// opens nothing by itself. A code sent to the contact saved on the order
// proves the buyer, then the receipt reopens with the payment choices. A
// signed-in owner goes straight to the receipt. Works without JavaScript: the
// form posts back here.
import Layout from "@/layouts/Layout.astro";
import StoreContact from "@/components/StoreContact.astro";
import {
  getActiveCheckoutLanguage,
  getLayoutData,
  type CheckoutLanguageData,
  type LayoutData,
} from "@/lib/api";
import { failureNeedsStoreContact, formatCountdown, getOrderCodeFailureText } from "@/lib/order-lookup";
import {
  accountOwnerReceiptRedirect,
  readOrderCodeFields,
  sendPaymentRecoveryCode,
  verifiedReceiptResponse,
  verifyPaymentRecoveryCode,
  type VerifiedOrderReceipt,
} from "@/lib/order-lookup-api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { formatOrderNumber } from "@scalius/shared/order-utils";
import { shouldRejectCrossOriginCookieRequest } from "@scalius/shared/request-origin-guard";
import {
  ENGLISH_CHECKOUT_LANGUAGE_DATA,
  checkoutLanguageBaseCode,
  formatCheckoutLanguageText,
} from "@scalius/shared/checkout-language";

const isPost = Astro.request.method === "POST";
if (isPost && shouldRejectCrossOriginCookieRequest(Astro.request)) {
  return new Response(null, { status: 403 });
}

const requestedOrderId = Astro.url.searchParams.get("orderId")?.trim() ?? "";
const orderId = /^[A-Za-z0-9_-]{1,128}$/.test(requestedOrderId) ? requestedOrderId : "";

const ownerRedirect = await accountOwnerReceiptRedirect(orderId, Astro.request.headers.get("cookie"), Astro.url.searchParams);
if (ownerRedirect) return ownerRedirect;

const [layoutData, checkoutLanguage]: [LayoutData | null, CheckoutLanguageData | null] = await Promise.all([
  getLayoutData(),
  getActiveCheckoutLanguage(),
]);
const copy = checkoutLanguage?.languageData ?? ENGLISH_CHECKOUT_LANGUAGE_DATA;

let codeSent = false;
let message = "";
let failed = false;
let needsStoreContact = false;
let orderNumber: number | null = null;
let resendAfterSeconds = 0;
let verified: VerifiedOrderReceipt | null = null;

if (isPost && orderId) {
  const fields = (await readOrderCodeFields(Astro.request)) ?? {};
  codeSent = fields.intent === "verify" || fields.intent === "resend";
  failed = true;
  if (fields.intent === "verify") {
    if (!fields.code) {
      message = copy.paymentRecoveryEnterCodeText;
    } else {
      const result = await verifyPaymentRecoveryCode({ orderId, code: fields.code });
      if (result.ok) verified = result.data;
      else {
        needsStoreContact = failureNeedsStoreContact(result.failure);
        message = getOrderCodeFailureText(copy, result.failure, "verify", copy.paymentRecoveryCodesUnavailableText);
      }
    }
  } else {
    const result = await sendPaymentRecoveryCode({ orderId });
    if (result.ok) {
      // A neutral answer (nothing to pay online, or no such order) sends nothing.
      codeSent = result.data.sent;
      failed = false;
      message = result.data.message || copy.paymentRecoveryCodeRequestedText;
      orderNumber = result.data.orderNumber;
      resendAfterSeconds = result.data.resendAfterSeconds;
    } else {
      needsStoreContact = failureNeedsStoreContact(result.failure);
      message = getOrderCodeFailureText(copy, result.failure, "send", copy.paymentRecoveryCodesUnavailableText);
    }
  }
}

// A correct code: store the receipt proof and open the receipt (303).
const verifiedRedirect = verified ? verifiedReceiptResponse(verified, "redirect") : null;
if (verifiedRedirect) return verifiedRedirect;

const fieldClass =
  "min-h-11 w-full rounded-lg border border-input bg-background px-3 text-base text-foreground shadow-sm outline-none transition focus:border-ring focus:ring-2 focus:ring-ring/20";
const serializedCopy = serializeJsonForInlineScript({ languageData: copy });
---

<Layout
  title={copy.paymentRecoveryFinishTitleText}
  layoutData={layoutData}
  hideNavigationSidebar
  documentLanguage={checkoutLanguageBaseCode(checkoutLanguage?.code)}
>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <section class="container mx-auto px-4 py-10">
    <div class="mx-auto w-full max-w-md">
      <h1 class="text-2xl font-semibold text-foreground">{copy.paymentRecoveryFinishTitleText}</h1>

      {orderId ? (
        <>
          <p class="mt-2 text-sm text-muted-foreground">{copy.paymentRecoveryCodeIntroText}</p>
          <form
            method="post"
            action={Astro.url.pathname + Astro.url.search}
            class="mt-6 space-y-4"
            data-order-code-form
            data-send-url="/api/payment-recovery/send-code"
            data-verify-url="/api/payment-recovery/verify"
            data-code-sent={codeSent ? "true" : undefined}
          >
            <input type="hidden" name="orderId" value={orderId} />
            <p class="text-sm" data-order-code-order hidden={orderNumber === null}>
              <span class="text-muted-foreground">{copy.orderReceiptOrderNumberText}</span>
              <span data-order-number class="ml-2 font-medium text-foreground">{orderNumber !== null ? formatOrderNumber(orderNumber, "") : ""}</span>
            </p>
            <div class="grid gap-2" data-order-code-step hidden={!codeSent}>
              <label for="paymentRecoveryCode" class="text-sm font-medium text-foreground">{copy.paymentRecoveryVerificationCodeText}</label>
              <input id="paymentRecoveryCode" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" class={`${fieldClass} font-mono tracking-[0.3em]`} autofocus={codeSent} />
            </div>

            <p data-order-code-message aria-live="polite" class={`min-h-5 text-sm ${failed ? "text-destructive" : "text-muted-foreground"}`}>{message}</p>
            <StoreContact layoutData={layoutData} hidden={!needsStoreContact} label={copy.storeContactLabelText} />

            <button
              type="submit"
              name="intent"
              value={codeSent ? "verify" : "send"}
              data-order-code-submit
              class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60"
            >
              {codeSent ? copy.paymentRecoveryContinueToPaymentText : copy.paymentRecoverySendCodeText}
            </button>
            <button
              type="submit"
              name="intent"
              value="resend"
              data-order-code-resend
              data-resend-after={resendAfterSeconds || undefined}
              hidden={!codeSent}
              class="inline-flex min-h-11 w-full items-center justify-center rounded-lg px-4 text-sm font-medium text-foreground underline-offset-4 hover:underline disabled:cursor-not-allowed disabled:text-muted-foreground disabled:no-underline"
            >
              {resendAfterSeconds
                ? formatCheckoutLanguageText(copy.orderCodeResendInText, { time: formatCountdown(resendAfterSeconds) })
                : copy.orderCodeSendNewText}
            </button>
          </form>
        </>
      ) : (
        <p class="mt-2 text-sm text-muted-foreground">{copy.paymentRecoveryLinkIncompleteText}</p>
      )}

      <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-4 text-sm">
        <a href="/account" data-astro-prefetch={getStorefrontPrefetchAttribute("/account", Astro.url)} class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">{copy.paymentRecoveryViewAccountOrdersText}</a>
        <a href="/" class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">{copy.continueShoppingText}</a>
      </div>
    </div>
  </section>

  <script is:inline set:html={`window.__CHECKOUT_LANGUAGE__=${serializedCopy};`}></script>
</Layout>

<script>
  import type { CheckoutLanguageData } from "@scalius/shared/checkout-language";
  import { enhanceOrderCodeForm } from "@/lib/order-lookup-form";

  // The page always inlines its copy above this module.
  const copy = (window.__CHECKOUT_LANGUAGE__ as { languageData: CheckoutLanguageData }).languageData;
  const form = document.querySelector<HTMLFormElement>("[data-order-code-form]");
  if (form) {
    enhanceOrderCodeForm(form, copy, {
      verifyCode: copy.paymentRecoveryContinueToPaymentText,
      codeSent: copy.paymentRecoveryCodeRequestedText,
      unavailable: copy.paymentRecoveryCodesUnavailableText,
    });
  }
</script>
