---
import { localizedPaths } from "@/lib/localized-paths";
import Layout from "@/layouts/Layout.astro";
import { getArticleBySlug } from "@/lib/api/articles";
import { getLayoutData } from "@/lib/api";
import { setRuntimeImageCdnPolicy } from "@/lib/api/runtime";
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import { firstRichContentImageUrl, optimizeRichContentImages } from "@/lib/rich-content-media";
import RichTextStyles from "@/components/RichTextStyles.astro";
import { resolveStoreShareImage } from "@/lib/store-identity";
import { resolveRequestTheme } from "@/lib/storefront-theme-context";
import { applyStorefrontPrefetchPolicyToHtml } from "@/lib/prefetch-policy";
import { expandShortcodes, type RichContentPiece } from "@/lib/shortcodes";
import { withoutShortcodes } from "@/lib/shortcode-content";
import RichContentPieces from "@/components/RichContentPieces.astro";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import {
  buildAbsoluteStorefrontSeoUrl,
  buildResourceCanonicalSeoUrl,
  toAbsoluteStorefrontSeoUrl,
} from "@/lib/seo-base-url";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { htmlToPlainText, sanitizeHtml } from "@scalius/shared/html-sanitize";
import { formatCount, formatStoreDateTime, pageLanguage } from "@/lib/store-time-zone";
import { pagesCopy } from "@/lib/pages-copy";
import { catalogCopy } from "@/lib/catalog-copy";

const { slug } = Astro.params;
if (!slug || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
  return new Response(null, { status: 404 });
}

const [layoutData, article] = await Promise.all([
  getLayoutData(),
  getArticleBySlug(slug),
]);
if (!article) return new Response(null, { status: 404 });
if (!layoutData) {
  const response = storefrontDataUnavailableResponse(
    "We could not load this article. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}
setRuntimeImageCdnPolicy(layoutData.media);

const plainContent = withoutShortcodes(htmlToPlainText(article.content));
const description =
  article.metaDescription || article.excerpt || plainContent.slice(0, 180);
const title = article.metaTitle || article.title;
// The article's own handle (a localized one at a presence), not the URL's.
const canonicalUrl = buildResourceCanonicalSeoUrl(
  "article",
  `/blog/${article.slug ?? slug}`,
  article.canonicalPath,
);
const articlePaths = localizedPaths(article, (handle) => `/blog/${handle}`);
const featuredImageUrl = article.featuredImage?.url
  ? mediaImageUrl(article.featuredImage.url, 1200)
  : null;
// Posts without a featured image share their first content image, then the
// store's share image (the social image, else the theme's logo), so
// BlogPosting always has an image.
const { brand } = await resolveRequestTheme(Astro, layoutData);
const shareImageUrl =
  featuredImageUrl ||
  firstRichContentImageUrl(article.content, 1200) ||
  resolveStoreShareImage({
    socialImage: layoutData.seo?.socialImage,
    logo: brand.logo?.url,
  });
const absoluteImageUrl = toAbsoluteStorefrontSeoUrl(shareImageUrl);
const featuredImageAlt =
  article.featuredImage?.altText ||
  article.featuredImage?.filename ||
  article.title;
// Rewritten first, then split at its shortcodes: each product is drawn on the server.
const rewrittenContent = applyStorefrontPrefetchPolicyToHtml(
  optimizeRichContentImages(sanitizeHtml(article.content || "")),
  Astro.url,
);
let pieces: RichContentPiece[] = [];
try {
  pieces = await expandShortcodes(rewrittenContent, {
    code: layoutData.currency?.code ?? DEFAULT_CURRENCY.code,
    priceIncrementMinor: layoutData.currency?.priceIncrementMinor ?? undefined,
  });
} catch (error: unknown) {
  console.error(`Error processing article shortcodes for "${slug}":`, error);
  pieces = rewrittenContent ? [{ kind: "html", html: rewrittenContent }] : [];
}

function asDate(value: number | null): Date | null {
  if (!value) return null;
  const date = new Date(value < 1_000_000_000_000 ? value * 1000 : value);
  return Number.isNaN(date.getTime()) ? null : date;
}
const publishedDate = asDate(article.publishedAt);
const updatedDate = asDate(article.updatedAt ?? null);
const language = pageLanguage();
const copy = pagesCopy(language).blog;
const home = catalogCopy(language).breadcrumb;
const displayDate = publishedDate
  ? formatStoreDateTime(publishedDate, language, { dateStyle: "long" })
  : null;
const readingMinutes = Math.max(
  1,
  Math.ceil(plainContent.split(/\s+/).filter(Boolean).length / 220),
);
const articleJsonLd =
  canonicalUrl && !article.noIndex
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: article.title.trim(),
        description,
        url: canonicalUrl,
        mainEntityOfPage: canonicalUrl,
        ...(publishedDate
          ? { datePublished: publishedDate.toISOString() }
          : {}),
        ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
        ...(article.author
          ? { author: { "@type": "Person", name: article.author } }
          : {}),
        ...(absoluteImageUrl ? { image: [absoluteImageUrl] } : {}),
      })
    : null;
const breadcrumbJsonLd =
  canonicalUrl && !article.noIndex
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: home.home,
            item: buildAbsoluteStorefrontSeoUrl("/"),
          },
          {
            "@type": "ListItem",
            position: 2,
            name: copy.title,
            item: buildAbsoluteStorefrontSeoUrl("/blog"),
          },
          {
            "@type": "ListItem",
            position: 3,
            name: article.title.trim(),
            item: canonicalUrl,
          },
        ].filter((item) => item.item),
      })
    : null;
---

<Layout
  title={title}
  description={description}
  hideHeader={article.hideHeader}
  hideFooter={article.hideFooter}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  localizedPaths={articlePaths}
  ogImage={shareImageUrl ?? undefined}
  ogType="article"
  noindex={article.noIndex === true}
>
  <Fragment slot="head">
    <RichTextStyles />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={copy.feed}
      href="/blog/feed.xml"
    />
    {
      publishedDate && (
        <meta
          property="article:published_time"
          content={publishedDate.toISOString()}
        />
      )
    }
    {
      updatedDate && (
        <meta
          property="article:modified_time"
          content={updatedDate.toISOString()}
        />
      )
    }
    {
      articleJsonLd && (
        <script is:inline type="application/ld+json" set:html={articleJsonLd} />
      )
    }
    {
      breadcrumbJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={breadcrumbJsonLd}
        />
      )
    }
  </Fragment>

  <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <nav aria-label={home.label} class="text-sm text-muted-foreground">
      <a href="/blog" class="hover:text-foreground">{copy.title}</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span aria-current="page" class="text-foreground">{article.title}</span>
    </nav>

    <header class="mx-auto mt-8 max-w-3xl text-center">
      <h1
        class="text-balance text-3xl font-semibold tracking-tight text-foreground sm:text-5xl sm:leading-tight"
      >
        {article.title}
      </h1>
      {
        (displayDate || article.author) && (
          <div class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
            {article.author && <span>{article.author}</span>}
            {article.author && displayDate && <span aria-hidden="true">·</span>}
            {displayDate && (
              <time datetime={publishedDate?.toISOString()}>{displayDate}</time>
            )}
            <span aria-hidden="true">·</span>
            <span>{copy.minRead(formatCount(readingMinutes))}</span>
          </div>
        )
      }
      {
        article.excerpt && (
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">
            {article.excerpt}
          </p>
        )
      }
    </header>

    {
      featuredImageUrl && (
        <figure class="mt-10 overflow-hidden rounded-2xl bg-muted">
          <img
            src={featuredImageUrl}
            srcset={mediaImageSrcSet(article.featuredImage?.url)}
            sizes="(max-width: 1024px) calc(100vw - 2rem), 1024px"
            alt={featuredImageAlt}
            width="1440"
            height="810"
            loading="eager"
            decoding="async"
            class="aspect-video w-full object-cover"
          />
        </figure>
      )
    }

    <article
      class="prose sm:prose-lg mx-auto mt-10 max-w-3xl dark:prose-invert prose-h2:text-2xl prose-h3:text-xl prose-headings:scroll-mt-24 prose-headings:text-foreground prose-p:text-foreground/85 prose-li:text-foreground/85 prose-a:text-primary prose-img:rounded-xl prose-blockquote:border-primary/40 prose-blockquote:text-foreground"
    ><RichContentPieces pieces={pieces} /></article>

    {
      article.tags.length > 0 && (
        <footer class="mx-auto mt-10 flex max-w-3xl flex-wrap gap-2 border-t border-border pt-6">
          {article.tags.map((tag) => (
            <a
              href={`/blog?tag=${encodeURIComponent(tag)}`}
              class="rounded-full border border-border px-3 py-1.5 text-sm text-muted-foreground hover:border-foreground/40 hover:text-foreground"
            >
              {tag}
            </a>
          ))}
        </footer>
      )
    }
  </div>

</Layout>
