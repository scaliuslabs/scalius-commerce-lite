<script>
  import { trackFbPurchase } from "@/lib/analytics";
  import type { PurchaseTrackingPayload } from "@/lib/order-success-state";
  import { claimMetaPurchaseTracking } from "@/lib/tracking/meta-purchase-guard";
  import { finalizeCheckoutReceipt } from "@/lib/checkout/receipt-finalization";

  document.addEventListener("DOMContentLoaded", async () => {
    const receiptElement = document.querySelector<HTMLElement>(
      "[data-order-success-state][data-order-id]",
    );
    if (receiptElement) await finalizeCheckoutReceipt(receiptElement);

    const mainElement = document.querySelector(
      "[data-order-finalize='true'][data-fb-order-details]"
    ) as HTMLElement | null;
    if (!mainElement) {
      return;
    }

    const orderDataAttr = mainElement.dataset.fbOrderDetails;
    if (!orderDataAttr) {
      console.error("FB Purchase: Missing data attribute on main element.");
      return;
    }

    try {
      const parsedData: PurchaseTrackingPayload = JSON.parse(orderDataAttr);
      const { order, items: orderItems } = parsedData;

      setTimeout(() => {
        if (!order || !orderItems) {
          console.warn("Order data not available for FB Purchase tracking.");
          return;
        }

        const claim = claimMetaPurchaseTracking(order.id);
        if (!claim.shouldSend) {
          console.info("FB Purchase event already tracked for order:", order.id);
          return;
        }

        trackFbPurchase(
          {
            order_id: order.id,
            content_name: `Order ${order.id}`,
            content_ids: orderItems.map(
              (item) => item.variantId || item.productId
            ),
            content_type: "product_group",
            contents: orderItems.map((item) => ({
              id: item.variantId || item.productId,
              quantity: item.quantity,
              item_price: item.price,
            })),
            currency: window.__CURRENCY_CODE__ || "BDT",
            num_items: orderItems.reduce(
              (sum, item) => sum + item.quantity,
              0
            ),
            value: order.totalAmount,
          },
          {},
          { eventId: claim.eventId, sendCapi: false }
        );
        console.log("FB Purchase event tracked for order:", order.id);
      }, 500);
    } catch (error: unknown) {
      console.error("FB Purchase: Error parsing data attribute:", error);
    }
  });
</script>

<script>
  import {
    ENGLISH_CHECKOUT_LANGUAGE_DATA,
    type CheckoutLanguageData,
  } from "@scalius/shared/checkout-language";

  const PAYMENT_STATUS_DELAYS_MS = [1500, 2500, 4000, 6000, 8000, 12000] as const;

  document.addEventListener("DOMContentLoaded", () => {
    const checkoutLanguage = window.__CHECKOUT_LANGUAGE__ as { languageData?: CheckoutLanguageData } | undefined;
    const copy = checkoutLanguage?.languageData ?? ENGLISH_CHECKOUT_LANGUAGE_DATA;
    const receipt = document.querySelector<HTMLElement>(
      "[data-order-success-state][data-order-id]",
    );
    if (!receipt) return;

    const orderId = receipt.dataset.orderId;
    const initialState = receipt.dataset.orderSuccessState;
    const initialUpdatedAt = receipt.dataset.orderUpdatedAt || null;
    const message = receipt.querySelector<HTMLElement>("[data-payment-status-message]");
    const checkNowButton = receipt.querySelector<HTMLButtonElement>("[data-payment-check-now]");
    if (!orderId || (initialState !== "payment_pending" && initialState !== "payment_issue")) return;

    let stopped = false;
    let suspended = false;
    let checking = false;
    let delayIndex = 0;
    let timeoutId: number | undefined;
    let stripeActionMessage: string | null = null;
    let stripeReconciliationRequested = false;
    const isPageHidden = () => document.visibilityState === "hidden";

    const requestStripeReconciliation = async () => {
      if (receipt.dataset.paymentMethod !== "stripe") return null;
      try {
        const response = await fetch("/api/checkout/stripe-reconcile", {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ orderId }),
        });
        if (!response.ok) return null;
        const payload = await response.json() as {
          success?: boolean;
          data?: { providerStatus?: unknown };
        };
        return payload.success === true && typeof payload.data?.providerStatus === "string"
          ? payload.data.providerStatus
          : null;
      } catch {
        // Provider verification is best-effort here; bounded receipt polling remains active.
        return null;
      }
    };

    const showStripeGuidance = (providerStatus: string | null) => {
      stripeActionMessage = providerStatus === "requires_payment_method"
        ? copy.orderReceiptStripePaymentMethodRequiredText
        : providerStatus === "requires_action"
          ? copy.orderReceiptStripeAuthenticationRequiredText
          : null;
      if (message) {
        message.textContent = stripeActionMessage ?? copy.orderReceiptCheckingPaymentText;
      }
    };

    const schedule = () => {
      if (stopped || suspended) return;
      if (delayIndex >= PAYMENT_STATUS_DELAYS_MS.length) {
        if (message) {
          message.textContent = stripeActionMessage ?? copy.orderReceiptConfirmationDelayedText;
        }
        checkNowButton?.classList.remove("hidden");
        return;
      }
      timeoutId = window.setTimeout(() => {
        timeoutId = undefined;
        void checkStatus();
      }, PAYMENT_STATUS_DELAYS_MS[delayIndex]);
      delayIndex += 1;
    };

    const checkStatus = async (reconcileStripe = false) => {
      if (reconcileStripe) stripeReconciliationRequested = true;
      if (stopped || suspended || checking) return;
      if (isPageHidden()) {
        schedule();
        return;
      }

      checking = true;
      try {
        if (stripeReconciliationRequested) {
          const providerStatus = await requestStripeReconciliation();
          if (stopped || suspended || isPageHidden()) return;
          stripeReconciliationRequested = false;
          showStripeGuidance(providerStatus);
        }
        const response = await fetch(
          `/api/order-receipt/status?orderId=${encodeURIComponent(orderId)}`,
          {
            method: "GET",
            credentials: "same-origin",
            cache: "no-store",
            headers: { Accept: "application/json" },
          },
        );
        const payload = await response.json() as {
          success?: boolean;
          data?: { state?: string; updatedAt?: string | null };
        };
        const state = payload.success ? payload.data?.state : undefined;
        const updatedAt = payload.success ? payload.data?.updatedAt : undefined;
        if (
          state && (
            state !== initialState ||
            (updatedAt && initialUpdatedAt && updatedAt !== initialUpdatedAt)
          )
        ) {
          stopped = true;
          if (message) message.textContent = copy.orderReceiptStatusUpdatedText;
          window.location.reload();
          return;
        }
      } catch {
        // A transient read failure must not turn a successful payment into a buyer-facing error.
      } finally {
        checking = false;
      }

      if (stripeReconciliationRequested) {
        void checkStatus();
        return;
      }
      schedule();
    };

    const checkWhenVisible = () => {
      if (document.visibilityState !== "visible" || stopped) return;
      if (timeoutId) window.clearTimeout(timeoutId);
      timeoutId = undefined;
      void checkStatus();
    };

    document.addEventListener("visibilitychange", checkWhenVisible);
    checkNowButton?.addEventListener("click", () => {
      checkNowButton.disabled = true;
      if (timeoutId) window.clearTimeout(timeoutId);
      timeoutId = undefined;
      if (message) message.textContent = copy.orderReceiptCheckingPaymentText;
      void checkStatus(true).finally(() => {
        checkNowButton.disabled = false;
      });
    });
    window.addEventListener("pagehide", () => {
      suspended = true;
      if (timeoutId) window.clearTimeout(timeoutId);
    });
    window.addEventListener("pageshow", (event) => {
      if (!(event as PageTransitionEvent).persisted || stopped) return;
      suspended = false;
      delayIndex = 0;
      void checkStatus(true);
    });

    void checkStatus(true);
  });
</script>

<script>
  import { stripeHandler } from "@/lib/checkout/handlers/stripe";
  import { fetchPaymentSessionWithProcessingRetry } from "@/lib/checkout/payment-session-retry";
  import {
    normalizeCheckoutRedirectUrl,
    normalizeHostedCheckoutUrl,
  } from "@/lib/checkout/redirect-url";
  import { writeHostedPaymentRecoverySession } from "@/lib/checkout/session-state";
  import type { CheckoutConfig, PaymentContext } from "@/lib/checkout/types";
  import {
    ENGLISH_CHECKOUT_LANGUAGE_DATA,
    formatCheckoutLanguageText,
    type CheckoutLanguageData,
  } from "@scalius/shared/checkout-language";

  document.addEventListener("DOMContentLoaded", () => {
    const checkoutLanguage = window.__CHECKOUT_LANGUAGE__ as { languageData?: CheckoutLanguageData } | undefined;
    const copy = checkoutLanguage?.languageData ?? ENGLISH_CHECKOUT_LANGUAGE_DATA;
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-payment-retry-button]")
    );
    const message = document.getElementById("retryPaymentMessage");
    const stripeSection = document.getElementById("stripeSection");
    const stripePayButton = document.getElementById("payButton") as HTMLButtonElement | null;
    if (buttons.length === 0) return;

    const setRetryButtonsBusy = (busy: boolean, activeButton?: HTMLButtonElement) => {
      buttons.forEach((retryButton) => {
        retryButton.disabled = busy;
        retryButton.setAttribute("aria-busy", busy && retryButton === activeButton ? "true" : "false");
      });
    };

    const buildRecoveryHref = (
      orderId: string,
      gateway: string,
      paymentType: string,
      depositAmount: number,
    ) => {
      const params = new URLSearchParams({ orderId, payment: gateway });
      if (paymentType) params.set("paymentType", paymentType);
      if (paymentType === "deposit" && Number.isFinite(depositAmount) && depositAmount > 0) {
        params.set("depositAmount", String(depositAmount));
      }
      return `/order-success?${params.toString()}`;
    };

    buttons.forEach((button) => button.addEventListener("click", async () => {
      const endpoint = button.dataset.endpoint;
      const gateway = button.dataset.gateway;
      const orderId = button.dataset.orderId;
      const paymentType = button.dataset.paymentType || "full";
      const depositAmount = Number(button.dataset.depositAmount);

      if (!endpoint || !gateway || !orderId) {
        if (message) message.textContent = copy.orderReceiptRetryUnavailableText;
        return;
      }

      if (gateway === "stripe") {
        if (!stripeSection || !stripePayButton) {
          if (message) message.textContent = copy.orderReceiptCardUnavailableText;
          return;
        }
        stripeSection.classList.remove("hidden");
        stripeSection.scrollIntoView({ behavior: "smooth", block: "nearest" });
        setRetryButtonsBusy(true, button);
        if (message) message.textContent = copy.orderReceiptLoadingCardText;
        try {
          await stripeHandler.onSelect?.(stripeSection);
          if (message) message.textContent = copy.orderReceiptEnterCardText;
        } catch {
          if (message) message.textContent = copy.orderReceiptCardLoadFailedText;
        } finally {
          setRetryButtonsBusy(false);
        }
        return;
      }

      stripeSection?.classList.add("hidden");
      setRetryButtonsBusy(true, button);
      if (message) message.textContent = copy.orderReceiptOpeningPaymentText;

      try {
        const payload: Record<string, unknown> = {
          orderId,
          paymentType,
          currency: window.__CURRENCY_CODE__ || "BDT",
          replaceExistingAttempt: paymentType !== "balance",
        };
        if (paymentType === "deposit" && Number.isFinite(depositAmount) && depositAmount > 0) {
          payload.depositAmount = depositAmount;
        }

        const { data, response } = await fetchPaymentSessionWithProcessingRetry<Record<string, unknown>>(() => fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        }), {
          onProcessing: (event) => {
            if (message) {
              message.textContent = formatCheckoutLanguageText(
                copy.orderReceiptPaymentProcessingRetryText,
                { seconds: event.retryAfterSeconds },
              );
            }
          },
        });
        if (!response.ok) {
          throw new Error("hosted_payment_failed");
        }
        const gatewayUrl = normalizeHostedCheckoutUrl(
          typeof data.gatewayUrl === "string" ? data.gatewayUrl : "",
        );
        if (!gatewayUrl) {
          throw new Error("unsafe_payment_redirect");
        }
        writeHostedPaymentRecoverySession(
          buildRecoveryHref(orderId, gateway, paymentType, depositAmount),
          undefined,
          gateway,
        );
        window.location.href = gatewayUrl;
      } catch (error) {
        setRetryButtonsBusy(false);
        if (message) {
          message.textContent = error instanceof Error && error.message === "unsafe_payment_redirect"
            ? copy.orderReceiptGatewayRedirectFailedText
            : copy.orderReceiptStartPaymentFailedText;
        }
      }
    }));

    stripePayButton?.addEventListener("click", async () => {
      if (!stripeSection) return;
      const orderId = stripeSection.dataset.orderId;
      const paymentType = stripeSection.dataset.paymentType || "full";
      const depositAmount = Number(stripeSection.dataset.depositAmount);
      const totalAmount = Number(stripeSection.dataset.totalAmount);
      const checkoutConfig = window.__CHECKOUT_CONFIG__ as CheckoutConfig | undefined;
      if (!orderId || !checkoutConfig || !Number.isFinite(totalAmount)) {
        if (message) message.textContent = copy.orderReceiptCardUnavailableText;
        return;
      }

      stripePayButton.disabled = true;
      setRetryButtonsBusy(true);
      if (message) message.textContent = copy.orderReceiptConfirmingCardText;
      const context: PaymentContext = {
        checkoutData: {},
        config: checkoutConfig,
        orderId,
        totalAmount,
        advanceAmount: paymentType === "deposit" && Number.isFinite(depositAmount)
          ? depositAmount
          : 0,
        currencySymbol: window.__CURRENCY_SYMBOL__ || "",
        paymentType: paymentType === "deposit" || paymentType === "balance"
          ? paymentType
          : "full",
        depositAmount: paymentType === "deposit" && Number.isFinite(depositAmount)
          ? depositAmount
          : undefined,
        replaceExistingAttempt: paymentType !== "balance",
      };

      try {
        const result = await stripeHandler.processPayment(context);
        if (!result.success || !result.redirectUrl) {
          throw new Error("card_payment_failed");
        }
        const redirectUrl = normalizeCheckoutRedirectUrl(result.redirectUrl, window.location.origin);
        if (!redirectUrl) throw new Error("unsafe_receipt_redirect");
        writeHostedPaymentRecoverySession(redirectUrl, undefined, "stripe");
        window.location.href = redirectUrl;
      } catch {
        stripePayButton.disabled = stripeHandler.isReady?.() !== true;
        setRetryButtonsBusy(false);
        if (message) message.textContent = copy.orderReceiptCardPaymentFailedText;
      }
    });
  });
</script>

<style>
  /* A short, unambiguous success cue that remains visible after motion ends. */
  .success-checkmark {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
