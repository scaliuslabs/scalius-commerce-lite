---
import { checkoutText } from "@/lib/checkout-text";
import OrderConversationPanel from "@/components/conversation/OrderConversationPanel.astro";
import ReceiptCards from "@/components/order/ReceiptCards.astro";
import ReceiptStatusHeader from "@/components/order/ReceiptStatusHeader.astro";
import { orderReceiptView } from "@/lib/order-receipt-view";
import { resolveRequestTheme } from "@/lib/storefront-theme-context";
import Layout from "@/layouts/Layout.astro";
import CheckoutProgress from "@/components/CheckoutProgress.astro";
import OrderSuccessButtons from "../components/OrderSuccessButtons";
import ProductCard from "@/components/cards/ProductCard.astro";
import ProductGrid from "@/components/cards/ProductGrid.astro";
import { recommendationTitle } from "@/lib/recommendations";
import { storeContactLinks } from "@/lib/store-contact";
import {
  getProductRecommendations,
  getAccountOwnerReceiptProof,
  getActiveCheckoutLanguage,
  getOrderReceipt,
  getLayoutData,
  OrderReceiptAccessError,
  type CheckoutLanguageData,
  type OrderItem,
  type LayoutData,
} from "@/lib/api";
import { getCheckoutConfig, isCodOnly, type CheckoutConfig } from "@/lib/api/checkout";
import { isPaymentMethodIdShape } from "@/lib/payment-method-id";
import {
  createPurchaseTrackingPayload,
  getOrderSuccessNextSteps,
  getOrderSuccessStateKind,
  getOrderSuccessViewState,
  isOrderStatusView,
  shouldClearCheckoutCartForOrder,
} from "@/lib/order-success-state";
import {
  canRetryOrderSuccessPayment,
  getOrderSuccessRetryOptions,
  isHostedPaymentRetryResult,
  normalizeRetryDepositAmount,
  resolveOrderSuccessRetryPaymentType,
} from "@/lib/order-success-payment-retry";
import {
  clearOrderReceiptFinalizeCookieHeader,
  createOrderReceiptCookieHeader,
  readOrderReceiptFinalizeCookie,
  readOrderReceiptCookie,
} from "@/lib/order-receipt-cookie";
import { getCustomerSessionTokenFromCookie } from "@/lib/customer-session-cookie";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { getGatewayPresentation, isAppGatewayId } from "@/lib/checkout/gateway-presentation";
import { formatOrderReceiptDate } from "@/lib/order-success-localization";
import { isGatewayEligibleForPaymentAmount } from "@/lib/checkout/gateway-amount-eligibility";
import { DEFAULT_CURRENCY } from "@/lib/currency";

import { ENGLISH_CHECKOUT_LANGUAGE_DATA, checkoutLanguageBaseCode } from "@scalius/shared/checkout-language";
import { receiptLinkRecoveryState } from "@/lib/order-success-recovery";
import {
  orderProgressMarkup,
  orderShipmentMarkup,
  orderTimelineMarkup,
  safeTrackingUrl,
  type OrderTrackingText,
} from "@/lib/order-tracking-markup";
import { presentOrderTracking } from "@/lib/account-format";
import {
  withOrderCompletionWording,
} from "@/lib/order-line-groups";

const legacyProofParams = ["token", "receipt_token", "receiptToken"];
if (legacyProofParams.some((param) => Astro.url.searchParams.has(param))) {
  const cleanUrl = new URL(Astro.url);
  for (const param of legacyProofParams) {
    cleanUrl.searchParams.delete(param);
  }
  return Astro.redirect(`${cleanUrl.pathname}${cleanUrl.search}`);
}

// Same shape the receipt proxies accept; anything else is never echoed or looked up.
const ORDER_ID_PATTERN = /^[A-Za-z0-9_-]{1,128}$/;
const requestedOrderId = Astro.url.searchParams.get("orderId")?.trim() ?? "";
const orderId = ORDER_ID_PATTERN.test(requestedOrderId) ? requestedOrderId : "";
const requestCookieHeader = Astro.request.headers.get("cookie");
let receiptToken = orderId
  ? readOrderReceiptCookie(requestCookieHeader, orderId)
  : "";
// A signed-in account owner (order email link, another device) proves the
// order with their customer session; the proof lands in the httpOnly cookie.
const customerSessionToken = getCustomerSessionTokenFromCookie(requestCookieHeader);
if (orderId && !receiptToken && customerSessionToken) {
  const ownerProof = await getAccountOwnerReceiptProof(orderId, customerSessionToken).catch(() => null);
  const ownerCookie = ownerProof ? createOrderReceiptCookieHeader(orderId, ownerProof) : null;
  if (ownerProof && ownerCookie) {
    receiptToken = ownerProof;
    Astro.response.headers.append("Set-Cookie", ownerCookie);
  }
}
const currentCheckoutFinalizeMarker = orderId
  ? readOrderReceiptFinalizeCookie(requestCookieHeader, orderId)
  : null;
const hasCurrentCheckoutFinalizeMarker = currentCheckoutFinalizeMarker !== null;
const paymentResult = Astro.url.searchParams.get("result");
const requestedPayment = Astro.url.searchParams.get("payment");
const requestedPaymentType = Astro.url.searchParams.get("paymentType");
const requestedDepositAmount = normalizeRetryDepositAmount(Astro.url.searchParams.get("depositAmount"));
// Hosted (redirect) gateways return here; card (Stripe) and COD never do.
const hostedRecoveryPayment = requestedPayment
  && isPaymentMethodIdShape(requestedPayment)
  && requestedPayment !== "stripe"
  && requestedPayment !== "cod"
  && requestedPayment !== "gift_card"
  ? requestedPayment
  : null;

let order: Awaited<ReturnType<typeof getOrderReceipt>> = null;
let recoveryState: {
  title: string;
  message: string;
  status: number;
  action: { href: string; label: string };
} | null = null;

const [layoutData, checkoutConfig, checkoutLanguageResponse]: [
  LayoutData | null,
  CheckoutConfig,
  CheckoutLanguageData | null,
] = await Promise.all([
  getLayoutData(),
  getCheckoutConfig(),
  getActiveCheckoutLanguage(),
]);
const checkoutLanguage: CheckoutLanguageData = checkoutLanguageResponse ?? {
  id: "fallback",
  name: "English (Fallback)",
  code: "en",
  languageData: { ...ENGLISH_CHECKOUT_LANGUAGE_DATA },
  fieldVisibility: {
    showOrderNotesField: true,
    showAreaField: true,
  },
  isActive: true,
  isDefault: true,
};
const copy = checkoutLanguage.languageData;
// Guests who lost the receipt cookie (another device, or after a week) look it up here.
const trackOrderAction = { href: "/track-order", label: copy.trackOrderText };
const retryReceiptAction = { href: Astro.url.pathname + Astro.url.search, label: copy.orderReceiptRetryText };

if (!orderId || !receiptToken) {
  const recoveryUrl = orderId && hostedRecoveryPayment && isHostedPaymentRetryResult(paymentResult)
    ? (() => {
        const url = new URL("/payment-recovery", Astro.url);
        url.searchParams.set("orderId", orderId);
        url.searchParams.set("payment", hostedRecoveryPayment);
        url.searchParams.set("result", "failed");
        if (requestedPaymentType) url.searchParams.set("paymentType", requestedPaymentType);
        if (requestedDepositAmount) url.searchParams.set("depositAmount", String(requestedDepositAmount));
        return `${url.pathname}${url.search}`;
      })()
    : undefined;
  recoveryState = receiptLinkRecoveryState({ requestedOrderId, recoveryUrl }, copy);
} else {
  try {
    order = await getOrderReceipt(orderId, receiptToken);
    if (!order) {
      recoveryState = {
        title: copy.orderReceiptUnavailableTitleText,
        message: copy.orderReceiptPrivateUnavailableMessageText,
        status: 200,
        action: retryReceiptAction,
      };
    }
  } catch (e: unknown) {
    if (e instanceof OrderReceiptAccessError && e.status === 404) {
      recoveryState = {
        title: copy.orderReceiptExpiredTitleText,
        message: copy.orderReceiptTrackOrderHelpText,
        status: 404,
        action: trackOrderAction,
      };
    } else {
      console.error("Order receipt fetch failed", e instanceof OrderReceiptAccessError ? { status: e.status } : e);
      recoveryState = {
        title: copy.orderReceiptUnavailableTitleText,
        message: copy.orderReceiptUnavailableMessageText,
        status: 200,
        action: retryReceiptAction,
      };
    }
  }
}

if (recoveryState) {
  Astro.response.status = recoveryState.status;
}

const orderItemsFromApi: OrderItem[] = order?.items || [];
// A finished pickup order reads "Picked up"; a service/digital-only one "complete", never "Delivered".
const orderSuccessView = order
  ? withOrderCompletionWording(getOrderSuccessViewState(order, copy, paymentResult), order, copy)
  : null;
const configuredCurrencyCode = checkoutConfig.currency?.code
  ?? layoutData?.currency?.code
  ?? DEFAULT_CURRENCY.code;
// What the receipt's cards show (lib/order-receipt-view.ts, shared with the theme editor's sample receipt).
const receiptView = order
  ? orderReceiptView({ order, copy, languageCode: checkoutLanguage.code, configuredCurrencyCode })
  : null;
const visibleBalanceDue = receiptView?.visibleBalanceDue ?? 0;
const receiptCurrencyCode = receiptView?.receiptCurrencyCode ?? configuredCurrencyCode;
// The theme's receipt block (the request's one theme resolution: no read of its own).
const receiptBlock = (await resolveRequestTheme(Astro, layoutData)).resolved.blocks.receipt;
const shouldClearCheckoutCart = order ? shouldClearCheckoutCartForOrder(order) : false;
const showsPositiveOrderState = orderSuccessView?.kind === "order_placed"
  || orderSuccessView?.kind === "order_updated";
const successfulUpdatedStatuses = new Set(["confirmed", "processing", "shipped", "delivered", "completed"]);
const showsSuccessHero = orderSuccessView?.kind === "order_placed"
  || (orderSuccessView?.kind === "order_updated" && successfulUpdatedStatuses.has((order?.status ?? "").toLowerCase()));
const shouldConsumeCurrentCheckoutFinalizeMarker = Boolean(
  hasCurrentCheckoutFinalizeMarker && orderId && showsPositiveOrderState,
);
if (shouldConsumeCurrentCheckoutFinalizeMarker && orderId) {
  const clearFinalizeCookie = clearOrderReceiptFinalizeCookieHeader(orderId);
  if (clearFinalizeCookie) Astro.response.headers.append("Set-Cookie", clearFinalizeCookie);
}
const retryPaymentType = order
  ? resolveOrderSuccessRetryPaymentType(order, requestedPaymentType)
  : null;
const configuredDepositAmount = Number(checkoutConfig.partialPaymentAmount ?? 0);
const retryPaymentAmount = retryPaymentType === "deposit"
  ? Math.min(
      order?.totalAmount ?? visibleBalanceDue,
      requestedDepositAmount
        ?? (Number.isFinite(configuredDepositAmount) && configuredDepositAmount > 0
          ? configuredDepositAmount
          : visibleBalanceDue),
    )
  : visibleBalanceDue;
const retryEligibleGateways = checkoutConfig.gateways.filter((gateway) =>
  isGatewayEligibleForPaymentAmount(gateway, retryPaymentAmount, receiptCurrencyCode),
);
const retryPaymentOptions = order && orderSuccessView && receiptToken && canRetryOrderSuccessPayment(order, orderSuccessView.kind, paymentResult)
  ? getOrderSuccessRetryOptions(order, orderSuccessView.kind, paymentResult, retryEligibleGateways)
      .filter((option) => retryPaymentType !== "balance" || option.current)
      // The method that didn't go through first ("Try again"), then the others.
      .sort((a, b) => Number(b.current) - Number(a.current))
      .map((option) => {
        const presentation = getGatewayPresentation(option.gateway, option.label, copy);
        return {
          ...option,
          presentation,
          actionLabel: orderSuccessView.kind === "payment_pending"
            ? checkoutText(copy.completeWithProviderText, {
                provider: presentation.providerLabel ?? presentation.buyerLabel,
              })
            : option.current
              ? checkoutText(copy.orderReceiptTryAgainWithProviderText, {
                  provider: presentation.providerLabel ?? presentation.buyerLabel,
                })
              : presentation.buyerLabel,
        };
      })
  : [];
// "Or choose another method" goes above the first method that isn't the order's own.
const firstOtherRetryIndex = retryPaymentOptions.some((option) => option.current)
  ? retryPaymentOptions.findIndex((option) => !option.current)
  : -1;
const stripeRetryGateway = retryPaymentOptions.some((option) => option.gateway === "stripe")
  ? checkoutConfig.gateways.find((gateway) => gateway.id === "stripe")
  : null;
const stripeRetryPublishableKey = typeof stripeRetryGateway?.publishableKey === "string"
  ? stripeRetryGateway.publishableKey
  : "";
const serializedRecoveryCheckoutConfig = serializeJsonForInlineScript(checkoutConfig);
const serializedCheckoutLanguage = serializeJsonForInlineScript(checkoutLanguage);
const purchaseTrackingPayload =
  order && orderSuccessView?.shouldFinalizeClientSide
    ? createPurchaseTrackingPayload(order, orderItemsFromApi)
    : null;
const merchantReceiptName = layoutData?.business?.companyName?.trim()
  || layoutData?.business?.legalName?.trim()
  || null;
const orderNumber = receiptView?.orderNumber ?? "";
const nextSteps = order && orderSuccessView ? getOrderSuccessNextSteps(order, orderSuccessView.kind, copy) : [];
// Opened by tracking or later: a status page ("Order #1057", where it is) instead of the checkout confirmation.
const statusView = orderSuccessView
  ? isOrderStatusView(orderSuccessView.kind, {
      requestedView: Astro.url.searchParams.get("view"),
      freshCheckout: hasCurrentCheckoutFinalizeMarker || Boolean(paymentResult),
    })
  : false;
const paymentNeedsBuyer = orderSuccessView?.kind === "payment_pending" || orderSuccessView?.kind === "payment_issue";
const statusTitle = checkoutText(copy.orderStatusTitleText, { orderNumber });
const receiptTracking = statusView ? order?.tracking ?? null : null;
// Pickup and no-delivery orders track as "Ready for pickup"/"Picked up" or "Preparing"/"Completed".
// In the page's words by their keys, as every order-status surface words them (presentOrderTracking).
const tracking = order && receiptTracking
  ? presentOrderTracking(receiptTracking, receiptTracking.shipments[0]?.courierName ?? null, order, copy)
  : null;
const trackingText: OrderTrackingText = {
  done: copy.orderTrackingStepDoneText,
  trackingId: copy.orderTrackingIdText,
  trackWithCourier: copy.orderTrackWithCourierText,
  formatDate: (iso) => formatOrderReceiptDate(iso, checkoutLanguage.code) ?? "",
};
const trackingShipments = (tracking?.shipments ?? []).map((shipment) => orderShipmentMarkup({
  statusLabel: shipment.statusLabel,
  courier: shipment.courierName,
  trackingId: shipment.trackingId,
  trackingUrl: safeTrackingUrl(shipment.trackingUrl),
}, trackingText)).join("");
// Keep shopping, on the fresh confirmation only (never the status view):
// products related to what was just ordered, from public catalog data.
const orderRecommendations = order && showsSuccessHero && !statusView
  ? await getProductRecommendations(orderItemsFromApi.map((item) => item.productId), 4).catch(() => null)
  : null;
---

<Layout
  title={statusView ? statusTitle : orderSuccessView?.title ?? recoveryState?.title ?? copy.orderReceiptPageTitleText}
  layoutData={layoutData}
  hideNavigationSidebar
  documentLanguage={checkoutLanguageBaseCode(checkoutLanguage.code)}
>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <section
    class={receiptBlock.layout === "split" ? "container mx-auto max-w-5xl px-4 py-6 sm:py-8" : "container mx-auto max-w-3xl px-4 py-6 sm:py-8"}
    data-order-success-print={order ? "receipt" : undefined}
    data-fb-order-details={purchaseTrackingPayload ? JSON.stringify(purchaseTrackingPayload) : undefined}
    data-order-success-state={orderSuccessView?.kind ?? "recovery"}
    data-order-recorded-state={order ? getOrderSuccessStateKind(order) : undefined}
    data-order-finalize={orderSuccessView?.shouldFinalizeClientSide ? "true" : "false"}
    data-checkout-cart-finalize={shouldClearCheckoutCart ? "true" : "false"}
    data-checkout-finalize-id={order ? currentCheckoutFinalizeMarker?.checkoutId ?? undefined : undefined}
    data-checkout-finalize-cart-hash={order ? currentCheckoutFinalizeMarker?.cartFingerprintHash ?? undefined : undefined}
    data-order-id={order?.id}
    data-order-currency={receiptCurrencyCode}
    data-payment-method={order?.paymentMethod}
    data-order-updated-at={order?.updatedAt ?? undefined}
  >
    {order && orderSuccessView ? (
    <>
    {!statusView && (
      <CheckoutProgress
        current={order.paymentMethod !== "cod" && paymentNeedsBuyer ? "payment" : "confirmation"}
        paymentRequired={!(order.paymentMethod === "cod" && isCodOnly(checkoutConfig))}
        copy={copy}
      />
    )}
    <ReceiptStatusHeader
      merchantReceiptName={merchantReceiptName}
      statusView={statusView}
      paymentNeedsBuyer={paymentNeedsBuyer}
      showsSuccessHero={showsSuccessHero}
      orderSuccessView={orderSuccessView}
      statusTitle={statusTitle}
      nextSteps={nextSteps}
      copy={copy}
    >
      {retryPaymentOptions.length > 0 && retryPaymentType && (
        <div class="no-print mt-5 flex flex-col items-center gap-2">
          <div class="flex flex-col justify-center gap-2 sm:flex-row sm:flex-wrap">
            {retryPaymentOptions.map((option, index) => (
              <>
              {index === firstOtherRetryIndex && (
                <p class="mt-2 text-center text-sm font-medium text-muted-foreground sm:basis-full" data-retry-other-methods>
                  {copy.orderReceiptChooseAnotherMethodText}
                </p>
              )}
              <button
                type="button"
                class={`inline-flex min-h-16 items-center gap-3 rounded-xl border bg-background px-4 py-3 text-start text-sm text-foreground transition-colors hover:bg-muted/40 disabled:cursor-not-allowed disabled:opacity-60 ${option.current ? "border-primary ring-1 ring-primary" : "border-border"}`}
                aria-label={orderSuccessView.kind === "payment_pending" || option.current
                  ? option.actionLabel
                  : checkoutText(copy.orderReceiptRetryWithProviderText, {
                      provider: option.presentation.buyerLabel,
                    })}
                data-payment-retry-button
                data-endpoint={option.endpoint}
                data-gateway={option.gateway}
                data-provider-name={isAppGatewayId(option.gateway) ? option.presentation.buyerLabel : undefined}
                data-order-id={order.id}
                data-payment-type={retryPaymentType}
                data-deposit-amount={retryPaymentType === "deposit" && requestedDepositAmount ? String(requestedDepositAmount) : undefined}
              >
                <span class={`flex h-8 w-16 shrink-0 items-center justify-center rounded-md border border-border bg-white px-1.5 ${option.presentation.darkMarkSrc ? "dark:bg-card" : ""}`} aria-hidden="true">
                  {option.presentation.markSrc && (
                    <img
                      src={option.presentation.markSrc}
                      alt=""
                      width={option.presentation.markKind === "wordmark" ? 52 : 20}
                      height={20}
                      class={`${option.presentation.markKind === "wordmark" ? "h-5 w-full" : "h-5 w-5"} object-contain ${option.presentation.darkMarkSrc ? "dark:hidden" : ""}`}
                    />
                  )}
                  {option.presentation.darkMarkSrc && (
                    <img src={option.presentation.darkMarkSrc} alt="" width="20" height="20" class="hidden h-5 w-5 object-contain dark:block" />
                  )}
                </span>
                <span class="min-w-0">
                  <span class="block font-semibold">{option.actionLabel}</span>
                  {option.presentation.description && (
                    <span class="mt-0.5 block text-xs font-normal text-muted-foreground">{option.presentation.description}</span>
                  )}
                </span>
              </button>
              </>
            ))}
          </div>
          {stripeRetryGateway && (
            <div
              id="stripeSection"
              class="hidden w-full max-w-lg rounded-xl border border-border bg-card p-5 text-start"
              data-publishable-key={stripeRetryPublishableKey}
              data-order-id={order.id}
              data-total-amount={String(order.totalAmount)}
              data-payment-type={retryPaymentType}
              data-deposit-amount={retryPaymentType === "deposit" && requestedDepositAmount ? String(requestedDepositAmount) : undefined}
            >
              <h2 class="text-sm font-semibold text-foreground">{copy.cardDetailsText}</h2>
              <p class="mt-1 text-xs text-muted-foreground">
                {copy.orderReceiptExistingOrderCardHelpText}
              </p>
              <div id="stripeCardElement" class="mt-4 rounded-lg border border-input bg-background p-3"></div>
              <div id="stripeError" class="mt-2 hidden text-xs text-foreground" aria-live="polite"></div>
              <button
                id="payButton"
                type="button"
                class="mt-4 w-full rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50"
                disabled
              >
                <span id="payButtonText">{copy.paySecurelyByCardText}</span>
              </button>
            </div>
          )}
          <p id="retryPaymentMessage" class="min-h-5 text-sm text-muted-foreground" aria-live="polite"></p>
        </div>
      )}
    </ReceiptStatusHeader>

    {tracking && (
      <section class="no-print mb-6 rounded-xl border border-border bg-background p-4 sm:p-6" aria-label={copy.orderReceiptStatusText}>
        {tracking.progress && <div set:html={orderProgressMarkup(tracking.progress, trackingText)} />}
        {trackingShipments && <div class="mt-4 space-y-3" set:html={trackingShipments} />}
        {tracking.timeline.length > 0 && (
          <>
            <h2 class="mb-3 mt-6 text-sm font-semibold text-foreground">{copy.orderTrackingUpdatesText}</h2>
            <ol class="space-y-3 border-s border-border ps-4" set:html={orderTimelineMarkup(tracking.timeline, trackingText)} />
          </>
        )}
      </section>
    )}

    {receiptView && (
      <ReceiptCards
        order={order}
        orderId={orderId}
        copy={copy}
        orderSuccessView={orderSuccessView}
        gateways={checkoutConfig.gateways}
        view={receiptView}
        block={receiptBlock}
      />
    )}

    <div
      data-buyer-ui-target={statusView ? "account.order" : "order.confirmation"}
      data-buyer-ui={JSON.stringify(order.buyerUi ?? [])}
      class="mt-6 empty:hidden print:hidden"
    ></div>
    <OrderSuccessButtons
      orderId={order.id}
      accountLinked={order.accountLinked}
      accountPrefill={{
        name: order.customerName,
        ...(order.customerPhone ? { phone: order.customerPhone } : {}),
        ...(order.customerEmail ? { email: order.customerEmail } : {}),
      }}
      supportRequests={order.supportRequests}
      supportRequestActions={order.supportRequestActions}
      statusView={statusView}
      storeContact={storeContactLinks(layoutData?.business)}
      copy={copy}
      client:load
    />
    {/* The order's conversation with the store, through this browser's receipt proof. */}
    <OrderConversationPanel orderId={orderId} access="receipt" class="mt-6 rounded-xl border border-border bg-card p-5 print:hidden" />
    {orderRecommendations && orderRecommendations.products.length > 0 && (
      <section aria-labelledby="order-recommendations" class="mt-10 print:hidden">
        <h2 id="order-recommendations" class="mb-4 text-lg font-semibold text-foreground">
          {recommendationTitle(orderRecommendations.reason)}
        </h2>
        <ProductGrid>
          {orderRecommendations.products.map((product) => (
            <ProductCard
              product={product}
              currencySymbol={layoutData?.currency?.symbol}
              currencyCode={layoutData?.currency?.code}
            />
          ))}
        </ProductGrid>
      </section>
    )}
    </>
    ) : (
      <div class="mx-auto max-w-lg py-10 text-center">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
          <svg class="h-8 w-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z"></path></svg>
        </div>
        <h1 class="mb-3 text-2xl font-bold text-foreground">{recoveryState?.title}</h1>
        <p class="mb-6 text-muted-foreground">{recoveryState?.message}</p>
        {recoveryState && (
          <div class="flex flex-col justify-center gap-3 sm:flex-row">
            <a href={recoveryState.action.href} data-astro-prefetch={getStorefrontPrefetchAttribute(recoveryState.action.href, Astro.url)} class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">{recoveryState.action.label}</a>
            <a href="/" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-muted">{copy.continueShoppingText}</a>
          </div>
        )}
      </div>
    )}
  </section>
</Layout>

<script>
  // A paid download is prepared in the background: the receipt checks back
  // and shows it when it is ready (lib/receipt-download-poll.ts).
  import { pollPreparingDownloads } from "@/lib/receipt-download-poll";
  import { enhanceBuyerUi } from "@/lib/buyer-ui";

  enhanceBuyerUi();

  const orderId = document.querySelector<HTMLElement>("[data-order-success-state][data-order-id]")?.dataset.orderId;
  const laterText = document.querySelector<HTMLElement>("[data-download-preparing]")?.dataset.laterText ?? "";
  if (orderId) void pollPreparingDownloads({ root: document, orderId, laterText });
</script>

<script is:inline set:html={`window.__CHECKOUT_CONFIG__=${serializedRecoveryCheckoutConfig};window.__CHECKOUT_LANGUAGE__=${serializedCheckoutLanguage};`}></script>

<script>
  import { emitBuyerEvent } from "@/lib/buyer-events/bus";
  import { buyerCheckout, buyerMoney, merchandise } from "@/lib/buyer-events/lines";
  import type { PurchaseTrackingPayload } from "@/lib/order-success-state";
  import { claimMetaPurchaseTracking } from "@/lib/tracking/meta-purchase-guard";
  import { finalizeCheckoutReceipt } from "@/lib/checkout/receipt-finalization";

  document.addEventListener("DOMContentLoaded", async () => {
    const receiptElement = document.querySelector<HTMLElement>(
      "[data-order-success-state][data-order-id]",
    );
    if (receiptElement) await finalizeCheckoutReceipt(receiptElement);

    const mainElement = document.querySelector(
      "[data-order-finalize='true'][data-fb-order-details]"
    ) as HTMLElement | null;
    if (!mainElement) {
      return;
    }

    const orderDataAttr = mainElement.dataset.fbOrderDetails;
    if (!orderDataAttr) {
      console.error("FB Purchase: Missing data attribute on main element.");
      return;
    }

    try {
      const parsedData: PurchaseTrackingPayload = JSON.parse(orderDataAttr);
      const { order, items: orderItems } = parsedData;

      if (!order || !orderItems) return;
      // `checkout_completed` once per order (buyer-events.ts): a reload or a second tab says nothing.
      if (!claimMetaPurchaseTracking(order.id).shouldSend) return;
      // The order's currency (a market's own, MARKETS-DESIGN step 6), not the page's.
      const currency = mainElement.dataset.orderCurrency || window.__CURRENCY_CODE__ || "BDT";
      const lines = orderItems.map((item) => ({
        merchandise: merchandise({ productId: item.productId, variantId: item.variantId, price: item.price, currency }),
        quantity: item.quantity,
      }));
      emitBuyerEvent("checkout_completed", {
        checkout: buyerCheckout(null, lines, buyerMoney(order.totalAmount, currency)),
        order: { id: order.id },
      });
    } catch (error: unknown) {
      console.error("FB Purchase: Error parsing data attribute:", error);
    }
  });
</script>

<script>
  import {
    ENGLISH_CHECKOUT_LANGUAGE_DATA,
    type CheckoutLanguageData,
  } from "@scalius/shared/checkout-language";

  const PAYMENT_STATUS_DELAYS_MS = [1500, 2500, 4000, 6000, 8000, 12000] as const;

  document.addEventListener("DOMContentLoaded", () => {
    const checkoutLanguage = window.__CHECKOUT_LANGUAGE__ as { languageData?: CheckoutLanguageData } | undefined;
    const copy = checkoutLanguage?.languageData ?? ENGLISH_CHECKOUT_LANGUAGE_DATA;
    const receipt = document.querySelector<HTMLElement>(
      "[data-order-success-state][data-order-id]",
    );
    if (!receipt) return;

    const orderId = receipt.dataset.orderId;
    // The page may say a payment failed before the store records it (a failed
    // return): the status read is compared with what the store had recorded.
    const initialState = receipt.dataset.orderRecordedState || receipt.dataset.orderSuccessState;
    const shownState = receipt.dataset.orderSuccessState;
    const initialUpdatedAt = receipt.dataset.orderUpdatedAt || null;
    const message = receipt.querySelector<HTMLElement>("[data-payment-status-message]");
    const checkNowButton = receipt.querySelector<HTMLButtonElement>("[data-payment-check-now]");
    if (!orderId || (shownState !== "payment_pending" && shownState !== "payment_issue")) return;

    let stopped = false;
    let suspended = false;
    let checking = false;
    let delayIndex = 0;
    let timeoutId: number | undefined;
    let stripeActionMessage: string | null = null;
    let stripeReconciliationRequested = false;
    const isPageHidden = () => document.visibilityState === "hidden";

    const requestStripeReconciliation = async () => {
      if (receipt.dataset.paymentMethod !== "stripe") return null;
      try {
        const response = await fetch("/api/checkout/stripe-reconcile", {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ orderId }),
        });
        if (!response.ok) return null;
        const payload = await response.json() as {
          success?: boolean;
          data?: { providerStatus?: unknown };
        };
        return payload.success === true && typeof payload.data?.providerStatus === "string"
          ? payload.data.providerStatus
          : null;
      } catch {
        // Provider verification is best-effort here; bounded receipt polling remains active.
        return null;
      }
    };

    const showStripeGuidance = (providerStatus: string | null) => {
      stripeActionMessage = providerStatus === "requires_payment_method"
        ? copy.orderReceiptStripePaymentMethodRequiredText
        : providerStatus === "requires_action"
          ? copy.orderReceiptStripeAuthenticationRequiredText
          : null;
      if (message) {
        message.textContent = stripeActionMessage ?? copy.orderReceiptCheckingPaymentText;
      }
    };

    const schedule = () => {
      if (stopped || suspended) return;
      if (delayIndex >= PAYMENT_STATUS_DELAYS_MS.length) {
        if (message) {
          message.textContent = stripeActionMessage ?? copy.orderReceiptConfirmationDelayedText;
        }
        checkNowButton?.classList.remove("hidden");
        return;
      }
      timeoutId = window.setTimeout(() => {
        timeoutId = undefined;
        void checkStatus();
      }, PAYMENT_STATUS_DELAYS_MS[delayIndex]);
      delayIndex += 1;
    };

    const checkStatus = async (reconcileStripe = false) => {
      if (reconcileStripe) stripeReconciliationRequested = true;
      if (stopped || suspended || checking) return;
      if (isPageHidden()) {
        schedule();
        return;
      }

      checking = true;
      try {
        if (stripeReconciliationRequested) {
          const providerStatus = await requestStripeReconciliation();
          if (stopped || suspended || isPageHidden()) return;
          stripeReconciliationRequested = false;
          showStripeGuidance(providerStatus);
        }
        const response = await fetch(
          `/api/order-receipt/status?orderId=${encodeURIComponent(orderId)}`,
          {
            method: "GET",
            credentials: "same-origin",
            cache: "no-store",
            headers: { Accept: "application/json" },
          },
        );
        const payload = await response.json() as {
          success?: boolean;
          data?: { state?: string; updatedAt?: string | null };
        };
        const state = payload.success ? payload.data?.state : undefined;
        const updatedAt = payload.success ? payload.data?.updatedAt : undefined;
        if (
          state && (
            state !== initialState ||
            (updatedAt && initialUpdatedAt && updatedAt !== initialUpdatedAt)
          )
        ) {
          stopped = true;
          if (message) message.textContent = copy.orderReceiptStatusUpdatedText;
          window.location.reload();
          return;
        }
      } catch {
        // A transient read failure must not turn a successful payment into a buyer-facing error.
      } finally {
        checking = false;
      }

      if (stripeReconciliationRequested) {
        void checkStatus();
        return;
      }
      schedule();
    };

    const checkWhenVisible = () => {
      if (document.visibilityState !== "visible" || stopped) return;
      if (timeoutId) window.clearTimeout(timeoutId);
      timeoutId = undefined;
      void checkStatus();
    };

    document.addEventListener("visibilitychange", checkWhenVisible);
    checkNowButton?.addEventListener("click", () => {
      checkNowButton.disabled = true;
      if (timeoutId) window.clearTimeout(timeoutId);
      timeoutId = undefined;
      if (message) message.textContent = copy.orderReceiptCheckingPaymentText;
      void checkStatus(true).finally(() => {
        checkNowButton.disabled = false;
      });
    });
    window.addEventListener("pagehide", () => {
      suspended = true;
      if (timeoutId) window.clearTimeout(timeoutId);
    });
    window.addEventListener("pageshow", (event) => {
      if (!(event as PageTransitionEvent).persisted || stopped) return;
      suspended = false;
      delayIndex = 0;
      void checkStatus(true);
    });

    void checkStatus(true);
  });
</script>

<script>
  import { stripeHandler } from "@/lib/checkout/handlers/stripe";
  import { pagePath } from "@/lib/presence-url";
  import { fetchPaymentSessionWithProcessingRetry } from "@/lib/checkout/payment-session-retry";
  import { SLOW_REDIRECT_AFTER_MS } from "@/lib/checkout/loading-overlay";
  import {
    normalizeCheckoutRedirectUrl,
    normalizeHostedCheckoutUrl,
  } from "@/lib/checkout/redirect-url";
  import { writeHostedPaymentRecoverySession } from "@/lib/checkout/session-state";
  import type { CheckoutConfig, PaymentContext } from "@/lib/checkout/types";
  import { ENGLISH_CHECKOUT_LANGUAGE_DATA, type CheckoutLanguageData } from "@scalius/shared/checkout-language";
  import { checkoutText } from "@/lib/checkout-text";

  document.addEventListener("DOMContentLoaded", () => {
    const checkoutLanguage = window.__CHECKOUT_LANGUAGE__ as { languageData?: CheckoutLanguageData } | undefined;
    const copy = checkoutLanguage?.languageData ?? ENGLISH_CHECKOUT_LANGUAGE_DATA;
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-payment-retry-button]")
    );
    const message = document.getElementById("retryPaymentMessage");
    const stripeSection = document.getElementById("stripeSection");
    const stripePayButton = document.getElementById("payButton") as HTMLButtonElement | null;
    if (buttons.length === 0) return;

    const setRetryButtonsBusy = (busy: boolean, activeButton?: HTMLButtonElement) => {
      buttons.forEach((retryButton) => {
        retryButton.disabled = busy;
        retryButton.setAttribute("aria-busy", busy && retryButton === activeButton ? "true" : "false");
      });
    };

    const buildRecoveryHref = (
      orderId: string,
      gateway: string,
      paymentType: string,
      depositAmount: number,
    ) => {
      const params = new URLSearchParams({ orderId, payment: gateway });
      if (paymentType) params.set("paymentType", paymentType);
      if (paymentType === "deposit" && Number.isFinite(depositAmount) && depositAmount > 0) {
        params.set("depositAmount", String(depositAmount));
      }
      return pagePath(`/order-success?${params.toString()}`);
    };

    buttons.forEach((button) => button.addEventListener("click", async () => {
      const endpoint = button.dataset.endpoint;
      const gateway = button.dataset.gateway;
      const orderId = button.dataset.orderId;
      const paymentType = button.dataset.paymentType || "full";
      const depositAmount = Number(button.dataset.depositAmount);

      if (!endpoint || !gateway || !orderId) {
        if (message) message.textContent = copy.orderReceiptRetryUnavailableText;
        return;
      }

      if (gateway === "stripe") {
        if (!stripeSection || !stripePayButton) {
          if (message) message.textContent = copy.orderReceiptCardUnavailableText;
          return;
        }
        stripeSection.classList.remove("hidden");
        stripeSection.scrollIntoView({ behavior: "smooth", block: "nearest" });
        setRetryButtonsBusy(true, button);
        if (message) message.textContent = copy.orderReceiptLoadingCardText;
        try {
          await stripeHandler.onSelect?.(stripeSection, copy);
          if (message) message.textContent = copy.orderReceiptEnterCardText;
        } catch {
          if (message) message.textContent = copy.orderReceiptCardLoadFailedText;
        } finally {
          setRetryButtonsBusy(false);
        }
        return;
      }

      stripeSection?.classList.add("hidden");
      setRetryButtonsBusy(true, button);
      if (message) message.textContent = copy.orderReceiptOpeningPaymentText;
      // An app's wallet page can be slow to open on a phone network: say it is
      // still on its way so the buyer waits instead of paying twice.
      const providerName = button.dataset.providerName;
      const slowRedirect = providerName
        ? window.setTimeout(() => {
            if (message) {
              message.textContent = checkoutText(
                copy.redirectSlowMessage || ENGLISH_CHECKOUT_LANGUAGE_DATA.redirectSlowMessage,
                { provider: providerName },
              );
            }
          }, SLOW_REDIRECT_AFTER_MS)
        : undefined;

      try {
        const payload: Record<string, unknown> = {
          orderId,
          paymentType,
          currency: window.__CURRENCY_CODE__ || "BDT",
          replaceExistingAttempt: paymentType !== "balance",
        };
        if (paymentType === "deposit" && Number.isFinite(depositAmount) && depositAmount > 0) {
          payload.depositAmount = depositAmount;
        }

        const { data, response } = await fetchPaymentSessionWithProcessingRetry<Record<string, unknown>>(() => fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        }), {
          onProcessing: (event) => {
            if (message) {
              message.textContent = checkoutText(
                copy.orderReceiptPaymentProcessingRetryText,
                { seconds: event.retryAfterSeconds },
              );
            }
          },
        });
        if (!response.ok) {
          throw new Error("hosted_payment_failed");
        }
        const gatewayUrl = normalizeHostedCheckoutUrl(
          typeof data.gatewayUrl === "string" ? data.gatewayUrl : "",
        );
        if (!gatewayUrl) {
          throw new Error("unsafe_payment_redirect");
        }
        writeHostedPaymentRecoverySession(
          buildRecoveryHref(orderId, gateway, paymentType, depositAmount),
          undefined,
          gateway,
        );
        window.location.href = gatewayUrl;
      } catch (error) {
        window.clearTimeout(slowRedirect);
        setRetryButtonsBusy(false);
        if (message) {
          message.textContent = error instanceof Error && error.message === "unsafe_payment_redirect"
            ? copy.orderReceiptGatewayRedirectFailedText
            : copy.orderReceiptStartPaymentFailedText;
        }
      }
    }));

    stripePayButton?.addEventListener("click", async () => {
      if (!stripeSection) return;
      const orderId = stripeSection.dataset.orderId;
      const paymentType = stripeSection.dataset.paymentType || "full";
      const depositAmount = Number(stripeSection.dataset.depositAmount);
      const totalAmount = Number(stripeSection.dataset.totalAmount);
      const checkoutConfig = window.__CHECKOUT_CONFIG__ as CheckoutConfig | undefined;
      if (!orderId || !checkoutConfig || !Number.isFinite(totalAmount)) {
        if (message) message.textContent = copy.orderReceiptCardUnavailableText;
        return;
      }

      stripePayButton.disabled = true;
      setRetryButtonsBusy(true);
      if (message) message.textContent = copy.orderReceiptConfirmingCardText;
      const context: PaymentContext = {
        checkoutData: {},
        config: checkoutConfig,
        copy,
        orderId,
        totalAmount,
        advanceAmount: paymentType === "deposit" && Number.isFinite(depositAmount)
          ? depositAmount
          : 0,
        currencySymbol: window.__CURRENCY_SYMBOL__ || "",
        paymentType: paymentType === "deposit" || paymentType === "balance"
          ? paymentType
          : "full",
        depositAmount: paymentType === "deposit" && Number.isFinite(depositAmount)
          ? depositAmount
          : undefined,
        replaceExistingAttempt: paymentType !== "balance",
      };

      try {
        const result = await stripeHandler.processPayment(context);
        if (!result.success || !result.redirectUrl) {
          throw new Error("card_payment_failed");
        }
        const redirectUrl = normalizeCheckoutRedirectUrl(result.redirectUrl, window.location.origin);
        if (!redirectUrl) throw new Error("unsafe_receipt_redirect");
        writeHostedPaymentRecoverySession(redirectUrl, undefined, "stripe");
        window.location.href = redirectUrl;
      } catch {
        stripePayButton.disabled = stripeHandler.isReady?.() !== true;
        setRetryButtonsBusy(false);
        if (message) message.textContent = copy.orderReceiptCardPaymentFailedText;
      }
    });
  });
</script>

