---
import Layout from "@/layouts/Layout.astro";
import CheckoutProgress from "@/components/CheckoutProgress.astro";
import OrderSuccessButtons from "../components/OrderSuccessButtons";
import { getOrderReceipt, getLayoutData, OrderReceiptAccessError, type OrderReceipt, type OrderItem, type LayoutData } from "@/lib/api";
import { getCheckoutConfig, type CheckoutConfig } from "@/lib/api/checkout";
import {
  createPurchaseTrackingPayload,
  formatOrderSuccessPaymentMethod,
  getOrderSuccessViewState,
  getOrderSuccessVisibleBalanceDue,
  shouldClearCheckoutCartForOrder,
} from "@/lib/order-success-state";
import {
  canRetryOrderSuccessPayment,
  getOrderSuccessRetryOptions,
  isHostedPaymentRetryResult,
  normalizeRetryDepositAmount,
  resolveOrderSuccessRetryPaymentType,
} from "@/lib/order-success-payment-retry";
import {
  clearOrderReceiptFinalizeCookieHeader,
  readOrderReceiptFinalizeCookie,
  readOrderReceiptCookie,
} from "@/lib/order-receipt-cookie";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import {
  formatSavedMinorAmount,
  resolveSavedOrderLineMoney,
  resolveSavedOrderMoneySummary,
} from "@/lib/order-tax-presentation";
import { getGatewayPresentation } from "@/lib/checkout/gateway-presentation";
import { isGatewayEligibleForPaymentAmount } from "@/lib/checkout/gateway-amount-eligibility";
import { DEFAULT_CURRENCY, formatPrice } from "@scalius/shared/currency";


const legacyProofParams = ["token", "receipt_token", "receiptToken"];
if (legacyProofParams.some((param) => Astro.url.searchParams.has(param))) {
  const cleanUrl = new URL(Astro.url);
  for (const param of legacyProofParams) {
    cleanUrl.searchParams.delete(param);
  }
  return Astro.redirect(`${cleanUrl.pathname}${cleanUrl.search}`);
}

const orderId = Astro.url.searchParams.get("orderId");
const requestCookieHeader = Astro.request.headers.get("cookie");
const receiptToken = orderId
  ? readOrderReceiptCookie(requestCookieHeader, orderId)
  : "";
const currentCheckoutFinalizeMarker = orderId
  ? readOrderReceiptFinalizeCookie(requestCookieHeader, orderId)
  : null;
const hasCurrentCheckoutFinalizeMarker = currentCheckoutFinalizeMarker !== null;
const paymentResult = Astro.url.searchParams.get("result");
const requestedPayment = Astro.url.searchParams.get("payment");
const requestedPaymentType = Astro.url.searchParams.get("paymentType");
const requestedDepositAmount = normalizeRetryDepositAmount(Astro.url.searchParams.get("depositAmount"));
const hostedRecoveryPayment = requestedPayment === "sslcommerz" || requestedPayment === "polar"
  ? requestedPayment
  : null;

let order: OrderReceipt | null = null;
let recoveryState: {
  title: string;
  message: string;
  status: number;
  showRetry: boolean;
  recoveryUrl?: string;
} | null = null;

const [layoutData, checkoutConfig]: [LayoutData | null, CheckoutConfig] = await Promise.all([
  getLayoutData(),
  getCheckoutConfig(),
]);

if (!orderId || !receiptToken) {
  const recoveryUrl = orderId && hostedRecoveryPayment && isHostedPaymentRetryResult(paymentResult)
    ? (() => {
        const url = new URL("/payment-recovery", Astro.url);
        url.searchParams.set("orderId", orderId);
        url.searchParams.set("payment", hostedRecoveryPayment);
        url.searchParams.set("result", "failed");
        if (requestedPaymentType) url.searchParams.set("paymentType", requestedPaymentType);
        if (requestedDepositAmount) url.searchParams.set("depositAmount", String(requestedDepositAmount));
        return `${url.pathname}${url.search}`;
      })()
    : undefined;
  recoveryState = {
    title: "We could not open this receipt",
    message: recoveryUrl
      ? "This receipt can only be opened in the browser used at checkout. Verify your contact to recover payment."
      : "This receipt can only be opened in the browser used at checkout. Sign in to view your orders, or return to the checkout browser.",
    status: 400,
    showRetry: false,
    recoveryUrl,
  };
} else {
  try {
    order = await getOrderReceipt(orderId, receiptToken);
    if (!order) {
      recoveryState = {
        title: "Receipt temporarily unavailable",
        message: "We could not load this receipt from the private order link. If the order was placed, it may still appear in your account history.",
        status: 200,
        showRetry: true,
      };
    }
  } catch (e: unknown) {
    if (e instanceof OrderReceiptAccessError && e.status === 404) {
      recoveryState = {
        title: "Receipt access expired",
        message: "This private receipt is no longer available in this browser. Sign in to check account orders, or contact the store if you still need help.",
        status: 404,
        showRetry: false,
      };
    } else {
      console.error("Order receipt fetch failed", e instanceof OrderReceiptAccessError ? { status: e.status } : e);
      recoveryState = {
        title: "Receipt temporarily unavailable",
        message: "We could not load this receipt right now. Please retry or check your account order history.",
        status: 200,
        showRetry: true,
      };
    }
  }
}

if (recoveryState) {
  Astro.response.status = recoveryState.status;
}

const orderItemsFromApi: OrderItem[] = order?.items || [];
const orderSuccessView = order ? getOrderSuccessViewState(order, paymentResult) : null;
const visibleBalanceDue = order ? getOrderSuccessVisibleBalanceDue(order) : 0;
const savedMoneySummary = order ? resolveSavedOrderMoneySummary(order) : null;
const configuredCurrencyCode = checkoutConfig.currency?.code
  ?? layoutData?.currency?.code
  ?? DEFAULT_CURRENCY.code;
const receiptCurrencyCode = savedMoneySummary?.currencyCode ?? configuredCurrencyCode;
const shouldClearCheckoutCart = order ? shouldClearCheckoutCartForOrder(order) : false;
const showsPositiveOrderState = orderSuccessView?.kind === "order_placed"
  || orderSuccessView?.kind === "order_updated";
const successfulUpdatedStatuses = new Set(["confirmed", "processing", "shipped", "delivered", "completed"]);
const showsSuccessHero = orderSuccessView?.kind === "order_placed"
  || (orderSuccessView?.kind === "order_updated" && successfulUpdatedStatuses.has((order?.status ?? "").toLowerCase()));
const shouldConsumeCurrentCheckoutFinalizeMarker = Boolean(
  hasCurrentCheckoutFinalizeMarker && orderId && showsPositiveOrderState,
);
if (shouldConsumeCurrentCheckoutFinalizeMarker && orderId) {
  const clearFinalizeCookie = clearOrderReceiptFinalizeCookieHeader(orderId);
  if (clearFinalizeCookie) Astro.response.headers.append("Set-Cookie", clearFinalizeCookie);
}
const retryPaymentType = order
  ? resolveOrderSuccessRetryPaymentType(order, requestedPaymentType)
  : null;
const configuredDepositAmount = Number(checkoutConfig.partialPaymentAmount ?? 0);
const retryPaymentAmount = retryPaymentType === "deposit"
  ? Math.min(
      order?.totalAmount ?? visibleBalanceDue,
      requestedDepositAmount
        ?? (Number.isFinite(configuredDepositAmount) && configuredDepositAmount > 0
          ? configuredDepositAmount
          : visibleBalanceDue),
    )
  : visibleBalanceDue;
const retryEligibleGateways = checkoutConfig.gateways.filter((gateway) =>
  isGatewayEligibleForPaymentAmount(gateway, retryPaymentAmount, receiptCurrencyCode),
);
const retryPaymentOptions = order && orderSuccessView && receiptToken && canRetryOrderSuccessPayment(order, orderSuccessView.kind, paymentResult)
  ? getOrderSuccessRetryOptions(order, orderSuccessView.kind, paymentResult, retryEligibleGateways)
      .filter((option) => retryPaymentType !== "balance" || option.current)
      .map((option) => ({
        ...option,
        presentation: getGatewayPresentation(option.gateway, option.label),
      }))
  : [];
const stripeRetryGateway = retryPaymentOptions.some((option) => option.gateway === "stripe")
  ? checkoutConfig.gateways.find((gateway) => gateway.id === "stripe")
  : null;
const stripeRetryPublishableKey = typeof stripeRetryGateway?.publishableKey === "string"
  ? stripeRetryGateway.publishableKey
  : "";
const serializedRecoveryCheckoutConfig = serializeJsonForInlineScript(checkoutConfig);
const purchaseTrackingPayload =
  order && orderSuccessView?.shouldFinalizeClientSide
    ? createPurchaseTrackingPayload(order, orderItemsFromApi)
    : null;
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const receiptCurrencySymbol = savedMoneySummary
  ? `${receiptCurrencyCode} `
  : currencySymbol;
const formatReceiptAmount = (amount: number) => formatPrice(amount, {
  symbol: receiptCurrencySymbol,
  code: receiptCurrencyCode,
  precision: savedMoneySummary?.decimalPlaces,
});
const legacySubtotal = order
  ? order.totalAmount - order.shippingCharge + (order.discountAmount ?? 0)
  : 0;
const deliveryLocality = order
  ? [order.areaName || order.area, order.zoneName || order.zone, order.cityName || order.city]
      .filter((value): value is string => Boolean(value))
      .join(", ")
  : "";
const merchantReceiptName = layoutData?.business?.companyName?.trim()
  || layoutData?.business?.legalName?.trim()
  || null;
const orderPlacedAt = order?.createdAt
  ? (() => {
      const value = new Date(order.createdAt);
      if (Number.isNaN(value.getTime())) return null;
      return new Intl.DateTimeFormat("en-BD", {
        dateStyle: "medium",
        timeStyle: "short",
        timeZone: "Asia/Dhaka",
      }).format(value);
    })()
  : null;
---

<Layout title={orderSuccessView?.title ?? "Order Recovery"} layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <section
    class="container mx-auto max-w-3xl px-4 py-6 sm:py-8"
    data-order-success-print={order ? "receipt" : undefined}
    data-fb-order-details={purchaseTrackingPayload ? JSON.stringify(purchaseTrackingPayload) : undefined}
    data-order-success-state={orderSuccessView?.kind ?? "recovery"}
    data-order-finalize={orderSuccessView?.shouldFinalizeClientSide ? "true" : "false"}
    data-checkout-cart-finalize={shouldClearCheckoutCart ? "true" : "false"}
    data-checkout-finalize-id={currentCheckoutFinalizeMarker?.checkoutId ?? undefined}
    data-checkout-finalize-cart-hash={currentCheckoutFinalizeMarker?.cartFingerprintHash ?? undefined}
    data-order-id={order?.id}
    data-payment-method={order?.paymentMethod}
    data-order-updated-at={order?.updatedAt ?? undefined}
  >
    {order && orderSuccessView ? (
    <>
    <CheckoutProgress
      current={order.paymentMethod !== "cod" && (orderSuccessView.kind === "payment_pending" || orderSuccessView.kind === "payment_issue") ? "payment" : "confirmation"}
      paymentRequired={order.paymentMethod !== "cod"}
    />
    <div class="order-success-print-header text-center mb-8 animate-fade-in">
      {merchantReceiptName && <p class="order-success-print-merchant hidden font-semibold">{merchantReceiptName}</p>}
      {showsSuccessHero ? (
        <div class="success-checkmark" aria-hidden="true">
          <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="m5 12 4 4L19 6" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path>
          </svg>
        </div>
      ) : (
        <div class={`mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full ${orderSuccessView.kind === "payment_issue" ? "bg-destructive/10 text-destructive" : orderSuccessView.kind === "payment_pending" ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-700"}`}>
          <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={orderSuccessView.kind === "payment_issue" ? "M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" : orderSuccessView.kind === "payment_pending" ? "M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z" : "M12 16h.01M12 8v4m9 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"}></path>
          </svg>
        </div>
      )}
      <h1 class="mb-2 text-2xl font-bold">{orderSuccessView.title}</h1>
      <p class="text-gray-600">{orderSuccessView.message}</p>
      {(orderSuccessView.kind === "payment_pending" || orderSuccessView.kind === "payment_issue") && (
        <div class="mt-3 text-sm text-muted-foreground">
          <p data-payment-status-message aria-live="polite">
            {orderSuccessView.kind === "payment_pending" ? "Checking payment status…" : "Checking for a payment update…"}
          </p>
          <button type="button" class="mt-2 hidden min-h-11 rounded-lg border border-border px-4 py-2 font-medium text-foreground hover:bg-muted" data-payment-check-now>
            Check payment status
          </button>
        </div>
      )}
      {retryPaymentOptions.length > 0 && retryPaymentType && (
        <div class="mt-5 flex flex-col items-center gap-2">
          <div class="flex flex-col justify-center gap-2 sm:flex-row">
            {retryPaymentOptions.map((option) => (
              <button
                type="button"
                class={`inline-flex min-h-16 items-center gap-3 rounded-xl border bg-background px-4 py-3 text-left text-sm text-foreground transition-colors hover:bg-muted/40 disabled:cursor-not-allowed disabled:opacity-60 ${option.current ? "border-primary ring-1 ring-primary" : "border-border"}`}
                aria-label={`Retry payment with ${option.presentation.buyerLabel}`}
                data-payment-retry-button
                data-endpoint={option.endpoint}
                data-gateway={option.gateway}
                data-order-id={order.id}
                data-payment-type={retryPaymentType}
                data-deposit-amount={retryPaymentType === "deposit" && requestedDepositAmount ? String(requestedDepositAmount) : undefined}
              >
                <span class="flex h-8 min-w-12 shrink-0 items-center justify-center gap-1.5 rounded-md border border-border bg-background px-2" aria-hidden="true">
                  {option.presentation.markSrc && (
                    <img
                      src={option.presentation.markSrc}
                      alt=""
                      width={option.presentation.markKind === "wordmark" ? 72 : 20}
                      height={24}
                      class={`${option.presentation.markKind === "wordmark" ? "h-4 max-w-18" : "h-5 w-5"} object-contain ${option.presentation.darkMarkSrc ? "dark:hidden" : ""}`}
                    />
                  )}
                  {option.presentation.darkMarkSrc && (
                    <img src={option.presentation.darkMarkSrc} alt="" width="20" height="20" class="hidden h-5 w-5 object-contain dark:block" />
                  )}
                  {option.presentation.markKind === "icon" && option.presentation.providerLabel && (
                    <span class="text-[11px] font-semibold text-foreground">{option.presentation.providerLabel}</span>
                  )}
                </span>
                <span class="min-w-0">
                  <span class="block font-semibold">{option.presentation.buyerLabel}</span>
                  {option.presentation.description && (
                    <span class="mt-0.5 block text-xs font-normal text-muted-foreground">{option.presentation.description}</span>
                  )}
                </span>
              </button>
            ))}
          </div>
          {stripeRetryGateway && (
            <div
              id="stripeSection"
              class="hidden w-full max-w-lg rounded-xl border border-border bg-card p-5 text-left"
              data-publishable-key={stripeRetryPublishableKey}
              data-order-id={order.id}
              data-total-amount={String(order.totalAmount)}
              data-payment-type={retryPaymentType}
              data-deposit-amount={retryPaymentType === "deposit" && requestedDepositAmount ? String(requestedDepositAmount) : undefined}
            >
              <h2 class="text-sm font-semibold text-foreground">Card details</h2>
              <p class="mt-1 text-xs text-muted-foreground">
                Your existing order will be updated. This will not create another order.
              </p>
              <div id="stripeCardElement" class="mt-4 rounded-lg border border-input bg-background p-3"></div>
              <div id="stripeError" class="mt-2 hidden text-xs text-destructive" aria-live="polite"></div>
              <button
                id="payButton"
                type="button"
                class="mt-4 w-full rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50"
                disabled
              >
                <span id="payButtonText">Pay securely by card</span>
              </button>
            </div>
          )}
          <p id="retryPaymentMessage" class="min-h-5 text-sm text-muted-foreground" aria-live="polite"></p>
        </div>
      )}
    </div>

    <div class="order-success-print-grid space-y-6 animate-slide-up">
      {/* Order details sections */}
      <div
        class="order-success-print-card order-success-print-order rounded-xl border border-border bg-background p-4 sm:p-6"
      >
        <h2 class="text-lg font-medium mb-4 flex items-center">
          <svg
            class="w-5 h-5 mr-2 text-gray-700"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
            ></path>
          </svg>
          Order details
        </h2>
        <div class="space-y-4">
          <div class="flex justify-between">
            <span class="text-gray-600">Order number</span>
            <span class="break-all text-right font-medium">{order.id}</span>
          </div>
          {orderPlacedAt && <div class="flex justify-between gap-4">
            <span class="text-gray-600">Placed</span>
            <span class="text-right font-medium">{orderPlacedAt}</span>
          </div>}
          <div class="flex justify-between">
            <span class="text-gray-600">Status</span>
            <span
              class={`rounded-full px-2 py-0.5 text-sm font-medium ${orderSuccessView.orderBadgeClass}`}
              >{orderSuccessView.orderStatusLabel}</span
            >
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Payment</span>
            <span class="text-right font-medium">{formatOrderSuccessPaymentMethod(order.paymentMethod)}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Payment status</span>
            <span
              class={`rounded-full px-2 py-0.5 text-sm font-medium ${orderSuccessView.paymentBadgeClass}`}
              >{orderSuccessView.paymentStatusLabel}</span
            >
          </div>
          {savedMoneySummary ? (
            <div class="space-y-3 border-t border-gray-200 pt-4">
              <div class="flex justify-between gap-4">
                <span class="text-gray-600">Subtotal</span>
                <span class="font-medium">{formatSavedMinorAmount(savedMoneySummary.subtotalMinor, savedMoneySummary)}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Shipping</span>
                <span class="font-medium">{savedMoneySummary.shippingMinor === 0 ? "Free" : formatSavedMinorAmount(savedMoneySummary.shippingMinor, savedMoneySummary)}</span>
              </div>
              {savedMoneySummary.discountMinor > 0 && <div class="flex justify-between gap-4">
                <span class="text-gray-600">Discount</span>
                <span class="font-medium text-primary">
                  −{formatSavedMinorAmount(savedMoneySummary.discountMinor, savedMoneySummary)}
                </span>
              </div>}
              {savedMoneySummary.taxMinor > 0 && <div class="flex justify-between gap-4">
                <span class="text-gray-600">{savedMoneySummary.taxLabel}{savedMoneySummary.pricesIncludeTax ? " (included)" : ""}</span>
                <span class="font-medium">{formatSavedMinorAmount(savedMoneySummary.taxMinor, savedMoneySummary)}</span>
              </div>}
              <div class="flex justify-between gap-4 border-t border-gray-200 pt-3">
                <span class="font-semibold text-gray-900">Total</span>
                <span class="font-semibold text-gray-900">{formatSavedMinorAmount(savedMoneySummary.totalMinor, savedMoneySummary)}</span>
              </div>
            </div>
          ) : (
            <div class="space-y-3 border-t border-gray-200 pt-4">
              <div class="flex justify-between gap-4">
                <span class="text-gray-600">Subtotal</span>
                <span class="font-medium">{formatReceiptAmount(legacySubtotal)}</span>
              </div>
              {order.shippingCharge > 0 && (
                <div class="flex justify-between gap-4">
                  <span class="text-gray-600">Shipping</span>
                  <span class="font-medium">{formatReceiptAmount(order.shippingCharge)}</span>
                </div>
              )}
              {(order.discountAmount ?? 0) > 0 && (
                <div class="flex justify-between">
                  <span class="text-gray-600">Discount</span>
                  <span class="font-medium text-primary">
                    −{formatReceiptAmount(order.discountAmount ?? 0)}
                  </span>
                </div>
              )}
              <div class="flex justify-between gap-4 border-t border-gray-200 pt-3">
                <span class="font-semibold text-gray-900">Total</span>
                <span class="font-semibold text-gray-900">{formatReceiptAmount(order.totalAmount)}</span>
              </div>
            </div>
          )}
          {
            order.paidAmount > 0 && visibleBalanceDue > 0 && (
              <div class="flex justify-between">
                <span class="text-gray-600">Paid</span>
                <span class="font-medium text-emerald-700">
                  {formatReceiptAmount(order.paidAmount)}
                </span>
              </div>
            )
          }
          {
            visibleBalanceDue > 0 && (
              <div class="flex justify-between">
                <span class="text-gray-600">{order.paymentMethod === "cod" ? "Due on delivery" : "Balance due"}</span>
                <span class="font-medium">
                  {formatReceiptAmount(visibleBalanceDue)}
                </span>
              </div>
            )
          }
        </div>
      </div>

      <div
        class="order-success-print-card order-success-print-shipping rounded-xl border border-border bg-background p-4 sm:p-6"
      >
        <h2 class="text-lg font-medium mb-4 flex items-center">
          <svg
            class="w-5 h-5 mr-2 text-gray-700"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          Delivery details
        </h2>
        <div class="space-y-1 text-sm">
          <p class="font-medium text-foreground">{order.customerName}</p>
          <p class="text-muted-foreground">{order.shippingAddress}</p>
          {deliveryLocality && <p class="text-muted-foreground">{deliveryLocality}</p>}
        </div>
      </div>

      <div
        class="order-success-print-card order-success-print-items rounded-xl border border-border bg-background p-4 sm:p-6"
      >
        <h2 class="text-lg font-medium mb-4 flex items-center">
          <svg
            class="w-5 h-5 mr-2 text-gray-700"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          Items
        </h2>
        <div class="space-y-4">
          {
            orderItemsFromApi.map((item) => {
              const savedLine = resolveSavedOrderLineMoney(item, savedMoneySummary);
              return (
                <div class="order-success-print-item flex items-center justify-between gap-3 border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                  <div class="flex min-w-0 items-center gap-3">
                    {item.productImage && (
                      <img
                        src={item.productImage}
                        alt=""
                        width="48"
                        height="48"
                        loading="lazy"
                        class="h-12 w-12 shrink-0 rounded-lg border border-border object-cover"
                      />
                    )}
                    <div class="min-w-0">
                    <p class="font-medium">
                      {item.productName || "Product Unavailable"}
                    </p>
                    {item.variantLabel && (
                      <p class="text-xs text-gray-500 mt-1">
                        {item.variantLabel}
                      </p>
                    )}
                    <p class="text-sm text-gray-600 mt-1">
                      Quantity: {item.quantity} × {savedLine && savedMoneySummary
                        ? formatSavedMinorAmount(savedLine.unitPriceMinor, savedMoneySummary)
                        : formatReceiptAmount(item.price)}
                    </p>
                    {savedLine && savedMoneySummary && savedLine.discountMinor > 0 && (
                      <p class="mt-1 text-xs text-gray-500">
                        Item discount: −{formatSavedMinorAmount(savedLine.discountMinor, savedMoneySummary)}
                      </p>
                    )}
                    {savedLine && savedMoneySummary && savedLine.taxMinor > 0 && (
                      <p class="mt-1 text-xs text-gray-500">
                        {savedMoneySummary.taxLabel}{savedMoneySummary.pricesIncludeTax ? " included" : " added"}: {formatSavedMinorAmount(savedLine.taxMinor, savedMoneySummary)}
                      </p>
                    )}
                    </div>
                  </div>
                  <div class="shrink-0 text-right">
                    {savedLine && savedMoneySummary && <p class="text-xs text-gray-500">Line total</p>}
                    <p class="font-medium">
                      {savedLine && savedMoneySummary
                        ? formatSavedMinorAmount(savedLine.totalMinor, savedMoneySummary)
                        : formatReceiptAmount(item.quantity * item.price)}
                    </p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>

    <OrderSuccessButtons
      orderId={order.id}
      supportRequests={order.supportRequests}
      supportRequestActions={order.supportRequestActions}
      client:load
    />
    </>
    ) : (
      <div class="mx-auto max-w-lg py-10 text-center">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
          <svg class="h-8 w-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z"></path></svg>
        </div>
        <h1 class="mb-3 text-2xl font-bold text-foreground">{recoveryState?.title}</h1>
        <p class="mb-4 text-muted-foreground">{recoveryState?.message}</p>
        {orderId && (
          <p class="mb-6 rounded-xl border border-border bg-muted/30 p-3 text-sm text-muted-foreground">
            Reference: <span class="font-mono text-foreground">{orderId}</span>
          </p>
        )}
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          {recoveryState?.recoveryUrl && (
            <a href={recoveryState.recoveryUrl} data-astro-prefetch={getStorefrontPrefetchAttribute(recoveryState.recoveryUrl, Astro.url)} class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">Verify payment recovery</a>
          )}
          {recoveryState?.showRetry && (
            <a href={Astro.url.pathname + Astro.url.search} data-astro-prefetch={getStorefrontPrefetchAttribute(Astro.url.pathname + Astro.url.search, Astro.url)} class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">Retry receipt</a>
          )}
          <a href="/account" data-astro-prefetch={getStorefrontPrefetchAttribute("/account", Astro.url)} class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">View account orders</a>
          <a href="/" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-muted">Continue shopping</a>
        </div>
      </div>
    )}
  </section>
</Layout>

