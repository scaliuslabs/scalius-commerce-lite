---
import Layout from "@/layouts/Layout.astro";
import OrderSuccessButtons from "../components/OrderSuccessButtons";
import { getOrderReceipt, getLayoutData, type OrderReceipt, type OrderItem, type LayoutData } from "@/lib/api";
import { getCheckoutConfig, type CheckoutConfig } from "@/lib/api/checkout";
import {
  createPurchaseTrackingPayload,
  formatOrderSuccessLabel,
  getOrderSuccessViewState,
} from "@/lib/order-success-state";
import {
  canRetryOrderSuccessPayment,
  getOrderSuccessRetryOptions,
  normalizeRetryDepositAmount,
  resolveOrderSuccessRetryPaymentType,
} from "@/lib/order-success-payment-retry";
import { readOrderReceiptCookie } from "@/lib/order-receipt-cookie";
import {
  formatSavedMinorAmount,
  resolveSavedOrderLineMoney,
  resolveSavedOrderMoneySummary,
} from "@/lib/order-tax-presentation";


const legacyProofParams = ["token", "receipt_token", "receiptToken"];
if (legacyProofParams.some((param) => Astro.url.searchParams.has(param))) {
  const cleanUrl = new URL(Astro.url);
  for (const param of legacyProofParams) {
    cleanUrl.searchParams.delete(param);
  }
  return Astro.redirect(`${cleanUrl.pathname}${cleanUrl.search}`);
}

const orderId = Astro.url.searchParams.get("orderId");
const receiptToken = orderId
  ? readOrderReceiptCookie(Astro.request.headers.get("cookie"), orderId)
  : "";
const paymentResult = Astro.url.searchParams.get("result");
const requestedPayment = Astro.url.searchParams.get("payment");
const requestedPaymentType = Astro.url.searchParams.get("paymentType");
const requestedDepositAmount = normalizeRetryDepositAmount(Astro.url.searchParams.get("depositAmount"));
const hostedRecoveryPayment = requestedPayment === "sslcommerz" || requestedPayment === "polar"
  ? requestedPayment
  : null;

let order: OrderReceipt | null = null;
let recoveryState: {
  title: string;
  message: string;
  status: number;
  showRetry: boolean;
  recoveryUrl?: string;
} | null = null;

const [layoutData, checkoutConfig]: [LayoutData | null, CheckoutConfig] = await Promise.all([
  getLayoutData(),
  getCheckoutConfig(),
]);

if (!orderId || !receiptToken) {
  const recoveryUrl = orderId && hostedRecoveryPayment
    ? (() => {
        const url = new URL("/payment-recovery", Astro.url);
        url.searchParams.set("orderId", orderId);
        url.searchParams.set("payment", hostedRecoveryPayment);
        url.searchParams.set("result", "failed");
        if (requestedPaymentType) url.searchParams.set("paymentType", requestedPaymentType);
        if (requestedDepositAmount) url.searchParams.set("depositAmount", String(requestedDepositAmount));
        return `${url.pathname}${url.search}`;
      })()
    : undefined;
  recoveryState = {
    title: "We could not open this receipt",
    message: recoveryUrl
      ? "This browser is missing the private receipt cookie for this order. Verify the buyer contact to recover payment from this browser."
      : "This browser is missing the private receipt cookie for this order. Reopen the receipt from the same browser used at checkout, or sign in to check account orders before placing another order.",
    status: 400,
    showRetry: false,
    recoveryUrl,
  };
} else {
  try {
    order = await getOrderReceipt(orderId, receiptToken);
    if (!order) {
      recoveryState = {
        title: "Receipt temporarily unavailable",
        message: "We could not load this receipt from the private order link. If the order was placed, it may still appear in your account history.",
        status: 200,
        showRetry: true,
      };
    }
  } catch (e: unknown) {
    console.error(`Error fetching order receipt for ID ${orderId}:`, e);
    recoveryState = {
      title: "Receipt temporarily unavailable",
      message: "We could not load this receipt right now. Please retry or check your account order history.",
      status: 200,
      showRetry: true,
    };
  }
}

if (recoveryState) {
  Astro.response.status = recoveryState.status;
}

const orderItemsFromApi: OrderItem[] = order?.items || [];
const orderSuccessView = order ? getOrderSuccessViewState(order) : null;
const retryPaymentType = order
  ? resolveOrderSuccessRetryPaymentType(order, requestedPaymentType)
  : null;
const retryPaymentOptions = order && orderSuccessView && receiptToken && canRetryOrderSuccessPayment(order, orderSuccessView.kind, paymentResult)
  ? getOrderSuccessRetryOptions(order, orderSuccessView.kind, paymentResult, checkoutConfig.gateways)
  : [];
const purchaseTrackingPayload =
  order && orderSuccessView?.shouldFinalizeClientSide
    ? createPurchaseTrackingPayload(order, orderItemsFromApi)
    : null;
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const savedMoneySummary = order ? resolveSavedOrderMoneySummary(order) : null;
const legacySubtotal = order
  ? order.totalAmount - order.shippingCharge + (order.discountAmount ?? 0)
  : 0;
---

<Layout title={orderSuccessView?.title ?? "Order Recovery"} layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <section
    class="container mx-auto px-4 py-8 max-w-2xl"
    data-fb-order-details={purchaseTrackingPayload ? JSON.stringify(purchaseTrackingPayload) : undefined}
    data-order-success-state={orderSuccessView?.kind ?? "recovery"}
    data-order-finalize={orderSuccessView?.shouldFinalizeClientSide ? "true" : "false"}
    data-order-id={order?.id}
  >
    {order && orderSuccessView ? (
    <div class="text-center mb-8 animate-fade-in">
      {orderSuccessView.shouldFinalizeClientSide ? (
        <div class="success-checkmark">
          <div class="check-icon">
            <span class="icon-line line-tip"></span>
            <span class="icon-line line-long"></span>
            <div class="icon-circle"></div>
            <div class="icon-fix"></div>
          </div>
        </div>
      ) : (
        <div class={`mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full ${orderSuccessView.kind === "payment_issue" ? "bg-destructive/10 text-destructive" : "bg-amber-100 text-amber-700"}`}>
          <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={orderSuccessView.kind === "payment_issue" ? "M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" : "M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z"}></path>
          </svg>
        </div>
      )}
      <h1 class="text-2xl font-bold mb-2">{orderSuccessView.title}</h1>
      <p class="text-gray-600">{orderSuccessView.message}</p>
      {orderSuccessView.kind === "payment_pending" && (
        <p class="mt-3 text-sm text-muted-foreground" data-payment-status-message aria-live="polite">
          Checking payment status…
        </p>
      )}
      {retryPaymentOptions.length > 0 && retryPaymentType && (
        <div class="mt-5 flex flex-col items-center gap-2">
          <div class="flex flex-col justify-center gap-2 sm:flex-row">
            {retryPaymentOptions.map((option) => (
              <button
                type="button"
                class={`inline-flex min-h-11 items-center justify-center rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors disabled:cursor-not-allowed disabled:opacity-60 ${option.current ? "bg-primary text-primary-foreground hover:bg-primary/90" : "border border-border bg-background text-foreground hover:bg-muted"}`}
                data-payment-retry-button
                data-endpoint={option.endpoint}
                data-gateway={option.gateway}
                data-order-id={order.id}
                data-payment-type={retryPaymentType}
                data-deposit-amount={retryPaymentType === "deposit" && requestedDepositAmount ? String(requestedDepositAmount) : undefined}
              >
                {option.label}
              </button>
            ))}
          </div>
          <p id="retryPaymentMessage" class="min-h-5 text-sm text-muted-foreground" aria-live="polite"></p>
        </div>
      )}
    </div>

    <div class="space-y-6 animate-slide-up">
      <!-- Order details sections -->
      <div
        class="bg-gray-50 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow"
      >
        <h2 class="text-lg font-medium mb-4 flex items-center">
          <svg
            class="w-5 h-5 mr-2 text-gray-700"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
            ></path>
          </svg>
          Order Details
        </h2>
        <div class="space-y-4">
          <div class="flex justify-between">
            <span class="text-gray-600">Order ID:</span>
            <span class="font-medium">{order.id}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Order Status:</span>
            <span
              class={`font-medium px-2 py-0.5 rounded-full text-sm ${orderSuccessView.badgeClass}`}
              >{orderSuccessView.orderStatusLabel}</span
            >
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Payment Method:</span>
            <span class="font-medium">{formatOrderSuccessLabel(order.paymentMethod)}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Payment Status:</span>
            <span
              class={`font-medium px-2 py-0.5 rounded-full text-sm ${orderSuccessView.badgeClass}`}
              >{orderSuccessView.paymentStatusLabel}</span
            >
          </div>
          {savedMoneySummary ? (
            <div class="space-y-3 border-t border-gray-200 pt-4">
              <div class="flex justify-between gap-4">
                <span class="text-gray-600">Subtotal:</span>
                <span class="font-medium">{formatSavedMinorAmount(savedMoneySummary.subtotalMinor, savedMoneySummary)}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Shipping Charge:</span>
                <span class="font-medium">{formatSavedMinorAmount(savedMoneySummary.shippingMinor, savedMoneySummary)}</span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-gray-600">Discount:</span>
                <span class="font-medium text-primary">
                  {savedMoneySummary.discountMinor > 0 ? "−" : ""}{formatSavedMinorAmount(savedMoneySummary.discountMinor, savedMoneySummary)}
                </span>
              </div>
              <div class="flex justify-between gap-4">
                <span class="text-gray-600">{savedMoneySummary.taxLabel}{savedMoneySummary.pricesIncludeTax ? " (included)" : ""}:</span>
                <span class="font-medium">{formatSavedMinorAmount(savedMoneySummary.taxMinor, savedMoneySummary)}</span>
              </div>
              <div class="flex justify-between gap-4 border-t border-gray-200 pt-3">
                <span class="font-semibold text-gray-900">Total Amount:</span>
                <span class="font-semibold text-gray-900">{formatSavedMinorAmount(savedMoneySummary.totalMinor, savedMoneySummary)}</span>
              </div>
              <p class="text-left text-xs text-gray-500">
                Amounts saved in {savedMoneySummary.currencyCode} when this order was placed.
                {savedMoneySummary.pricesIncludeTax && ` ${savedMoneySummary.taxLabel} is already included in the prices above.`}
              </p>
            </div>
          ) : (
            <div class="space-y-3 border-t border-gray-200 pt-4">
              <div class="flex justify-between gap-4">
                <span class="text-gray-600">Subtotal:</span>
                <span class="font-medium">{currencySymbol}{legacySubtotal.toFixed(2)}</span>
              </div>
              {order.shippingCharge > 0 && (
                <div class="flex justify-between gap-4">
                  <span class="text-gray-600">Shipping Charge:</span>
                  <span class="font-medium">{currencySymbol}{order.shippingCharge.toFixed(2)}</span>
                </div>
              )}
              {(order.discountAmount ?? 0) > 0 && (
                <div class="flex justify-between">
                  <span class="text-gray-600">Discount:</span>
                  <span class="font-medium text-primary">
                    -{currencySymbol}{(order.discountAmount ?? 0).toFixed(2)}
                  </span>
                </div>
              )}
              <div class="flex justify-between gap-4 border-t border-gray-200 pt-3">
                <span class="font-semibold text-gray-900">Total Amount:</span>
                <span class="font-semibold text-gray-900">{currencySymbol}{order.totalAmount.toFixed(2)}</span>
              </div>
            </div>
          )}
          {
            order.paidAmount > 0 && (
              <div class="flex justify-between">
                <span class="text-gray-600">Paid Amount:</span>
                <span class="font-medium text-emerald-700">
                  {currencySymbol}{order.paidAmount.toFixed(2)}
                </span>
              </div>
            )
          }
          {
            order.balanceDue > 0 && (
              <div class="flex justify-between">
                <span class="text-gray-600">Balance Due:</span>
                <span class="font-medium">
                  {currencySymbol}{order.balanceDue.toFixed(2)}
                </span>
              </div>
            )
          }
        </div>
      </div>

      <div
        class="bg-gray-50 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow"
      >
        <h2 class="text-lg font-medium mb-4 flex items-center">
          <svg
            class="w-5 h-5 mr-2 text-gray-700"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          Shipping Details
        </h2>
        <div class="space-y-2">
          <p>
            <span class="text-gray-600">Name:</span>{" "}
            <span class="font-medium">{order.customerName}</span>
          </p>
          <p>
            <span class="text-gray-600">Address:</span>{" "}
            <span class="font-medium">{order.shippingAddress}</span>
          </p>
          <div class="flex flex-col items-center md:items-start">
            <p class="flex items-center gap-1 text-sm">
              <span class="text-gray-600">City:</span>{" "}
              <span class="font-medium">{order.cityName || order.city}</span>
            </p>
            <p class="flex items-center gap-1 text-sm">
              <span class="text-gray-600">Zone:</span>{" "}
              <span class="font-medium">{order.zoneName || order.zone}</span>
            </p>
            {
              (order.areaName || order.area) && (
                <p class="flex items-center gap-1 text-sm">
                  <span class="text-gray-600">Area:</span>{" "}
                  <span class="font-medium">
                    {order.areaName || order.area}
                  </span>
                </p>
              )
            }
          </div>
        </div>
      </div>

      <div
        class="bg-gray-50 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow"
      >
        <h2 class="text-lg font-medium mb-4 flex items-center">
          <svg
            class="w-5 h-5 mr-2 text-gray-700"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          Order Items
        </h2>
        <div class="space-y-4">
          {
            orderItemsFromApi.map((item) => {
              const savedLine = resolveSavedOrderLineMoney(item, savedMoneySummary);
              return (
                <div class="flex justify-between items-center border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                  <div>
                    <p class="font-medium">
                      {item.productName || "Product Unavailable"}
                    </p>
                    {item.variantLabel && (
                      <p class="text-xs text-gray-500 mt-1">
                        {item.variantLabel}
                      </p>
                    )}
                    <p class="text-sm text-gray-600 mt-1">
                      Quantity: {item.quantity} × {savedLine && savedMoneySummary
                        ? formatSavedMinorAmount(savedLine.unitPriceMinor, savedMoneySummary)
                        : `${currencySymbol}${item.price.toFixed(2)}`}
                    </p>
                    {savedLine && savedMoneySummary && savedLine.discountMinor > 0 && (
                      <p class="mt-1 text-xs text-gray-500">
                        Item discount: −{formatSavedMinorAmount(savedLine.discountMinor, savedMoneySummary)}
                      </p>
                    )}
                    {savedLine && savedMoneySummary && savedLine.taxMinor > 0 && (
                      <p class="mt-1 text-xs text-gray-500">
                        {savedMoneySummary.taxLabel}{savedMoneySummary.pricesIncludeTax ? " included" : " added"}: {formatSavedMinorAmount(savedLine.taxMinor, savedMoneySummary)}
                      </p>
                    )}
                  </div>
                  <div class="shrink-0 text-right">
                    {savedLine && savedMoneySummary && <p class="text-xs text-gray-500">Line total</p>}
                    <p class="font-medium">
                      {savedLine && savedMoneySummary
                        ? formatSavedMinorAmount(savedLine.totalMinor, savedMoneySummary)
                        : `${currencySymbol}${(item.quantity * item.price).toFixed(2)}`}
                    </p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>

    <OrderSuccessButtons
      orderId={order.id}
      supportRequests={order.supportRequests}
      supportRequestActions={order.supportRequestActions}
      supportRequestIntro={order.supportRequestIntro}
      client:load
    />
    ) : (
      <div class="mx-auto max-w-lg py-10 text-center">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
          <svg class="h-8 w-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z"></path></svg>
        </div>
        <h1 class="mb-3 text-2xl font-bold text-foreground">{recoveryState?.title}</h1>
        <p class="mb-4 text-muted-foreground">{recoveryState?.message}</p>
        {orderId && (
          <p class="mb-6 rounded-xl border border-border bg-muted/30 p-3 text-sm text-muted-foreground">
            Reference: <span class="font-mono text-foreground">{orderId}</span>
          </p>
        )}
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          {recoveryState?.recoveryUrl && (
            <a href={recoveryState.recoveryUrl} class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">Verify payment recovery</a>
          )}
          {recoveryState?.showRetry && (
            <a href={Astro.url.pathname + Astro.url.search} class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">Retry Receipt</a>
          )}
          <a href="/account" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-muted">View Account Orders</a>
          <a href="/" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-foreground transition-colors hover:bg-muted">Continue Shopping</a>
        </div>
      </div>
    )}
  </section>
</Layout>

<script>
  import { trackFbPurchase } from "@/lib/analytics";
  import { clearCheckoutSession } from "@/lib/checkout/session-state";
  import type { PurchaseTrackingPayload } from "@/lib/order-success-state";
  import { claimMetaPurchaseTracking } from "@/lib/tracking/meta-purchase-guard";
  import { clearCart } from "@/store/cart";

  document.addEventListener("DOMContentLoaded", () => {
    const mainElement = document.querySelector(
      "[data-order-finalize='true'][data-fb-order-details]"
    ) as HTMLElement | null;
    if (!mainElement) {
      return;
    }

    const orderDataAttr = mainElement.dataset.fbOrderDetails;
    if (!orderDataAttr) {
      console.error("FB Purchase: Missing data attribute on main element.");
      return;
    }

    try {
      const parsedData: PurchaseTrackingPayload = JSON.parse(orderDataAttr);
      const { order, items: orderItems } = parsedData;

      clearCheckoutSession();
      clearCart();

      setTimeout(() => {
        if (!order || !orderItems) {
          console.warn("Order data not available for FB Purchase tracking.");
          return;
        }

        const claim = claimMetaPurchaseTracking(order.id);
        if (!claim.shouldSend) {
          console.info("FB Purchase event already tracked for order:", order.id);
          return;
        }

        trackFbPurchase(
          {
            order_id: order.id,
            content_name: `Order ${order.id}`,
            content_ids: orderItems.map(
              (item) => item.variantId || item.productId
            ),
            content_type: "product_group",
            contents: orderItems.map((item) => ({
              id: item.variantId || item.productId,
              quantity: item.quantity,
              item_price: item.price,
            })),
            currency: window.__CURRENCY_CODE__ || "BDT",
            num_items: orderItems.reduce(
              (sum, item) => sum + item.quantity,
              0
            ),
            value: order.totalAmount,
          },
          {},
          { eventId: claim.eventId, sendCapi: false }
        );
        console.log("FB Purchase event tracked for order:", order.id);
      }, 500);
    } catch (error: unknown) {
      console.error("FB Purchase: Error parsing data attribute:", error);
    }
  });
</script>

<script>
  const PAYMENT_STATUS_DELAYS_MS = [1500, 2500, 4000, 6000, 8000, 12000] as const;

  document.addEventListener("DOMContentLoaded", () => {
    const receipt = document.querySelector<HTMLElement>(
      "[data-order-success-state='payment_pending'][data-order-id]",
    );
    if (!receipt) return;

    const orderId = receipt.dataset.orderId;
    const message = receipt.querySelector<HTMLElement>("[data-payment-status-message]");
    if (!orderId) return;

    let stopped = false;
    let checking = false;
    let delayIndex = 0;
    let timeoutId: number | undefined;

    const schedule = () => {
      if (stopped) return;
      if (delayIndex >= PAYMENT_STATUS_DELAYS_MS.length) {
        if (message) message.textContent = "Confirmation is taking longer than usual. You can safely leave this receipt and return later.";
        return;
      }
      timeoutId = window.setTimeout(checkStatus, PAYMENT_STATUS_DELAYS_MS[delayIndex]);
      delayIndex += 1;
    };

    const checkStatus = async () => {
      if (stopped || checking) return;
      if (document.visibilityState === "hidden") {
        schedule();
        return;
      }

      checking = true;
      try {
        const response = await fetch(
          `/api/order-receipt/status?orderId=${encodeURIComponent(orderId)}`,
          {
            method: "GET",
            credentials: "same-origin",
            cache: "no-store",
            headers: { Accept: "application/json" },
          },
        );
        const payload = await response.json() as {
          success?: boolean;
          data?: { state?: string };
        };
        const state = payload.success ? payload.data?.state : undefined;
        if (state && state !== "payment_pending") {
          stopped = true;
          if (message) message.textContent = "Payment status updated. Refreshing your receipt…";
          window.location.reload();
          return;
        }
      } catch {
        // A transient read failure must not turn a successful payment into a buyer-facing error.
      } finally {
        checking = false;
      }

      schedule();
    };

    const checkWhenVisible = () => {
      if (document.visibilityState !== "visible" || stopped) return;
      if (timeoutId) window.clearTimeout(timeoutId);
      void checkStatus();
    };

    document.addEventListener("visibilitychange", checkWhenVisible);
    window.addEventListener("pagehide", () => {
      stopped = true;
      if (timeoutId) window.clearTimeout(timeoutId);
      document.removeEventListener("visibilitychange", checkWhenVisible);
    }, { once: true });

    schedule();
  });
</script>

<script>
  import { fetchPaymentSessionWithProcessingRetry } from "@/lib/checkout/payment-session-retry";

  document.addEventListener("DOMContentLoaded", () => {
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-payment-retry-button]")
    );
    const message = document.getElementById("retryPaymentMessage");
    if (buttons.length === 0) return;

    buttons.forEach((button) => button.addEventListener("click", async () => {
      const endpoint = button.dataset.endpoint;
      const orderId = button.dataset.orderId;
      const paymentType = button.dataset.paymentType || "full";
      const depositAmount = Number(button.dataset.depositAmount);

      if (!endpoint || !orderId) {
        if (message) message.textContent = "Payment retry is unavailable for this order.";
        return;
      }

      const previousText = new Map(buttons.map((retryButton) => [
        retryButton,
        retryButton.textContent || "Retry payment",
      ]));
      buttons.forEach((retryButton) => {
        retryButton.disabled = true;
      });
      button.textContent = "Opening payment...";
      if (message) message.textContent = "";

      try {
        const payload: Record<string, unknown> = {
          orderId,
          paymentType,
          currency: window.__CURRENCY_CODE__ || "BDT",
        };
        if (paymentType === "deposit" && Number.isFinite(depositAmount) && depositAmount > 0) {
          payload.depositAmount = depositAmount;
        }

        const { data, response } = await fetchPaymentSessionWithProcessingRetry<Record<string, unknown>>(() => fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        }), {
          onProcessing: (event) => {
            if (message) {
              message.textContent = `${event.message} Retrying in ${event.retryAfterSeconds}s...`;
            }
          },
        });
        if (!response.ok) {
          const error = typeof data.error === "string" ? data.error : "Could not start payment. Please try again.";
          throw new Error(error);
        }
        const gatewayUrl = typeof data.gatewayUrl === "string" ? data.gatewayUrl : "";
        if (!gatewayUrl) {
          throw new Error("Payment gateway did not return a redirect URL.");
        }
        window.location.href = gatewayUrl;
      } catch (error) {
        buttons.forEach((retryButton) => {
          retryButton.disabled = false;
          retryButton.textContent = previousText.get(retryButton) ?? "Retry payment";
        });
        if (message) {
          message.textContent = error instanceof Error ? error.message : "Could not start payment. Please try again.";
        }
      }
    }));
  });
</script>

