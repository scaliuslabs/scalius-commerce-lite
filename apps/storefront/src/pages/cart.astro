---
// src/pages/cart.astro
import Layout from "@/layouts/Layout.astro";
import CheckoutHeader from "@/components/CheckoutHeader.astro";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import LocationSelector from "@/components/LocationSelector";
import ShippingLocationSelector from "@/components/ShippingLocationSelector";
import PhoneField from "@/components/PhoneField";
import CheckoutLoadingOverlay from "@/components/CheckoutLoadingOverlay.astro";
import CheckoutProgress from "@/components/CheckoutProgress.astro";
import { getCities, processOrder } from "@/lib/cart/server";
import {
  getShippingMethods,
  getLayoutData,
  type ShippingMethod,
  getActiveCheckoutLanguage,
  type CheckoutLanguageData,
  getCheckoutConfig,
  isCodOnly,
} from "@/lib/api";
import { getCustomerSessionTokenFromCookie } from "@/lib/customer-session-cookie";
import {
  createOrderReceiptCookieHeader,
  createOrderReceiptFinalizeCookieHeader,
} from "@/lib/order-receipt-cookie";
import { MIN_SHIPPING_ADDRESS_LENGTH } from "@/lib/checkout/shipping-address";
import { hashCheckoutCartFingerprint } from "@/lib/checkout/session-state";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import type { CartValidationIssue } from "@/lib/api/orders";
import {
  ENGLISH_CHECKOUT_LANGUAGE_DATA,
  checkoutLanguageBaseCode,
} from "@scalius/shared/checkout-language";

// Parallel fetch: layout + cities + shipping methods + checkout language + checkout config
const [
  layoutData,
  cities,
  shippingMethodsResponse,
  checkoutLanguageResponse,
  checkoutConfig,
] = await Promise.all([
  getLayoutData(),
  getCities(),
  getShippingMethods(),
  getActiveCheckoutLanguage(),
  getCheckoutConfig(),
]);
const shippingMethods: ShippingMethod[] = shippingMethodsResponse || [];
const checkoutUnavailable =
  checkoutConfig.unavailable === true ||
  checkoutConfig.gateways.length === 0 ||
  shippingMethods.length === 0 ||
  cities.length === 0;
const checkoutUnavailableMessage =
  checkoutConfig.unavailableMessage ||
  checkoutLanguageResponse?.languageData.checkoutUnavailableMessage ||
  ENGLISH_CHECKOUT_LANGUAGE_DATA.checkoutUnavailableMessage;
const codOnly = !checkoutUnavailable && isCodOnly(checkoutConfig);
const allowedCountriesMode = checkoutConfig?.allowedCountriesMode || "include";
const lang: CheckoutLanguageData = checkoutLanguageResponse || {
  id: "fallback",
  name: "English (Fallback)",
  code: "en",
  languageData: { ...ENGLISH_CHECKOUT_LANGUAGE_DATA },
  fieldVisibility: {
    showEmailField: true,
    showOrderNotesField: true,
    showAreaField: true,
  },
  isActive: true,
  isDefault: true,
};
const copy = lang.languageData;
const [existingCheckoutMessageBefore, existingCheckoutMessageAfter = ""] =
  copy.existingCheckoutMessage.split("{orderId}", 2);

// Initialize error message and success state
let errorMessage = "";
let successOrderId = "";
let isProcessing = false;
let codCartRepairState: {
  source: "cart";
  message: string;
  issues: CartValidationIssue[];
  createdAt: number;
} | null = null;

if (Astro.url.searchParams.get("quickBuyStorage") === "blocked") {
  errorMessage = copy.quickBuyStorageBlockedText;
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function isCartValidationIssue(value: unknown): value is CartValidationIssue {
  return (
    isRecord(value) &&
    typeof value.index === "number" &&
    typeof value.productId === "string" &&
    typeof value.message === "string"
  );
}

function extractItemIssues(details: unknown): CartValidationIssue[] {
  if (!isRecord(details) || !Array.isArray(details.itemIssues)) return [];
  return details.itemIssues.filter(isCartValidationIssue);
}

// Handle form submission — only for COD-only checkout submits.
// Other forms on the page may use POST to avoid URL/query leakage.
// When multiple gateways are active, the checkout form is intercepted client-side
// and the user is redirected to /checkout for payment selection.
if (Astro.request.method === "POST" && codOnly) {
  try {
    const formData = await Astro.request.formData();

    if (formData.get("formIntent") === "checkout") {
      isProcessing = true;

      // Check if cart is empty
      const cartItems = formData.get("cartItems") as string;
      if (!cartItems || cartItems === "{}" || cartItems === "[]") {
        throw new Error(
          copy.cartEmptyErrorText,
        );
      }

      const result = await processOrder(formData, {
        customerSessionToken: getCustomerSessionTokenFromCookie(
          Astro.request.headers.get("cookie"),
        ),
        waitUntil: (promise) => Astro.locals.cfContext.waitUntil(promise),
      });

      if (
        result.success &&
        "orderId" in result &&
        "receiptToken" in result &&
        result.orderId &&
        result.receiptToken
      ) {
        successOrderId = result.orderId;
        const response = Astro.redirect(
          `/order-success?orderId=${encodeURIComponent(result.orderId)}`,
        );
        const receiptCookie = createOrderReceiptCookieHeader(
          result.orderId,
          result.receiptToken,
        );
        if (receiptCookie) {
          response.headers.append("Set-Cookie", receiptCookie);
        }
        const finalizeCookie = createOrderReceiptFinalizeCookieHeader(
          result.orderId,
          {
            checkoutId: String(formData.get("checkoutId") ?? ""),
            cartFingerprintHash: await hashCheckoutCartFingerprint(cartItems),
          },
        );
        if (finalizeCookie) {
          response.headers.append("Set-Cookie", finalizeCookie);
        }
        return response;
      } else {
        console.error("Order processing failed:", result.error);
        const resultError = result.error;
        errorMessage =
          ("errorCode" in result &&
          result.errorCode === "STOREFRONT_CHECKOUT_QUOTE_CONFLICT"
            ? copy.totalChangedReviewText
            : (typeof resultError === "string"
                ? resultError
                : resultError?.message)) ||
          copy.orderProcessingFailedText;
        const itemIssues = extractItemIssues(
          "details" in result ? result.details : undefined,
        );
        if (itemIssues.length > 0) {
          codCartRepairState = {
            source: "cart",
            message:
              itemIssues.length === 1
                ? errorMessage
                : copy.cartItemsNeedAttentionText.replace("{count}", String(itemIssues.length)),
            issues: itemIssues,
            createdAt: Date.now(),
          };
        }
      }
    }
  } catch (error: unknown) {
    console.error("Order creation failed:", error);
    errorMessage =
      error instanceof Error ? error.message : copy.unexpectedErrorText;
  } finally {
    isProcessing = false;
  }
}

// Determine submit button label
const submitLabel = codOnly
  ? copy.placeOrderText
  : checkoutUnavailable
    ? copy.checkoutUnavailableText
    : copy.continueToPaymentText;
const serializedCheckoutConfig = serializeJsonForInlineScript(checkoutConfig);
const serializedCheckoutLanguage = serializeJsonForInlineScript(lang);
---

<Layout
  title={copy.pageTitle}
  layoutData={layoutData}
  documentLanguage={checkoutLanguageBaseCode(lang.code)}
  noindex
  hideHeader
  hideFooter
>
  <CheckoutHeader layoutData={layoutData} copy={copy} />
  <!-- Hidden checkout meta for client-side JS -->
  <script
    is:inline
    set:html={`window.__CHECKOUT_CONFIG__=${serializedCheckoutConfig};window.__CHECKOUT_LANGUAGE__=${serializedCheckoutLanguage};`}
  />
  {
    codCartRepairState && (
      <script
        is:inline
        id="codCartRepairState"
        type="application/json"
        set:html={serializeJsonForInlineScript(codCartRepairState)}
      />
    )
  }

  <div
    id="checkout-meta"
    data-cod-only={codOnly ? "true" : "false"}
    data-checkout-unavailable={checkoutUnavailable ? "true" : "false"}
    data-checkout-unavailable-message={checkoutUnavailableMessage}
    data-gateways={JSON.stringify(checkoutConfig.gateways)}
    data-guest-checkout-enabled={checkoutConfig.guestCheckoutEnabled !== false
      ? "true"
      : "false"}
    data-default-shipping-id={shippingMethods[0]?.id || ""}
    data-default-shipping-fee={String(shippingMethods[0]?.fee ?? 0)}
    data-default-shipping-name={shippingMethods[0]?.name || ""}
    hidden
  >
  </div>

  <div
    id="cartPageRoot"
    data-cart-ready="false"
    data-cart-has-items="false"
    class="container mx-auto max-w-6xl px-4 pb-6 pt-5 sm:px-6 sm:pt-7"
  >
    <noscript>
      <div
        class="mb-3 rounded-lg border border-border bg-muted/50 px-3 py-2 text-sm text-foreground"
        role="alert"
      >
        {copy.noScriptText}
      </div>
    </noscript>
    <CheckoutProgress current="information" paymentRequired={!codOnly} copy={copy} />
    {
      checkoutUnavailable && (
        <div
          class="bg-destructive/10 border border-destructive/20 text-destructive px-3 py-2 sm:px-4 sm:py-3 rounded mb-2 sm:mb-2.5 relative text-xs sm:text-sm"
          role="alert"
        >
          <strong class="font-bold">{copy.checkoutUnavailableText}: </strong>
          <span class="block sm:inline">{checkoutUnavailableMessage}</span>
        </div>
      )
    }

    {
      errorMessage && (
        <div
          class="bg-destructive/10 border border-destructive/20 text-destructive px-3 py-2 sm:px-4 sm:py-3 rounded mb-2 sm:mb-2.5 relative text-xs sm:text-sm"
          role="alert"
        >
          <strong class="font-bold">{copy.errorPrefixText} </strong>
          <span class="block sm:inline">{errorMessage}</span>
        </div>
      )
    }

    {
      successOrderId && (
        <div
          class="bg-primary/10 border border-primary/20 text-primary px-3 py-2 sm:px-4 sm:py-3 rounded mb-2 sm:mb-2.5 relative text-xs sm:text-sm"
          role="alert"
        >
          <strong class="font-bold">{copy.successPrefixText} </strong>
          <span class="block sm:inline">
            {copy.orderPlacedSuccessText.replace("{orderId}", successOrderId)}
          </span>
        </div>
      )
    }

    <aside
      id="checkoutRecoveryNotice"
      class="hidden mb-3 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-amber-950 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100"
      role="status"
      aria-hidden="true"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-semibold">{copy.existingCheckoutTitle}</p>
          <p class="mt-1 text-xs leading-5 opacity-80">
            {existingCheckoutMessageBefore}<span id="checkoutRecoveryReference" class="font-mono"></span>{existingCheckoutMessageAfter}
          </p>
        </div>
        <a
          id="checkoutRecoveryLink"
          data-astro-prefetch="false"
          class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-amber-950 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-amber-900 dark:bg-amber-100 dark:text-amber-950 dark:hover:bg-white"
        >
          {copy.reviewExistingCheckoutText}
        </a>
      </div>
    </aside>

    <div class="flex flex-col lg:flex-row-reverse gap-4 lg:gap-8">
      <!-- Cart Items Section - Right on Desktop -->
      <div
        class="lg:w-5/12 lg:sticky lg:self-start transition-all duration-200 order-1"
        style="top: calc(var(--header-height, 64px) + 1rem);"
      >
        <div
          class="bg-card rounded-xl border border-border shadow-sm overflow-hidden"
        >
          <div
            class="p-3 sm:p-4 border-b border-border bg-muted/50 flex items-center justify-between"
          >
            <h1 class="text-[1.25rem] font-bold leading-tight text-foreground sm:text-2xl">
              {lang.languageData.cartSectionTitle}
            </h1>
            <a
              href="/"
              class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-border bg-background px-3 text-sm font-semibold text-foreground shadow-sm transition-colors hover:bg-muted sm:min-h-9"
            >
              <span aria-hidden="true">←</span>
              {lang.languageData.continueShoppingText}
            </a>
          </div>

          <div
            id="cartValidationMessage"
            class="hidden mx-3 mt-3 rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-xs font-medium text-destructive sm:mx-4"
            role="alert"
          >
          </div>

          <div
            class="min-h-24 divide-y divide-gray-50 p-3 sm:p-4 block"
            id="cartItems"
            aria-live="polite"
            aria-busy="true"
          >
            <div
              class="py-8 text-center text-sm text-muted-foreground"
              role="status"
            >
              {copy.cartLoadingText}
            </div>
          </div>

          <div
            id="cartSummary"
            class="hidden bg-muted/50 p-3 sm:p-4 space-y-2 border-t border-border"
          >
            <div
              class="flex justify-between text-xs sm:text-sm text-muted-foreground"
            >
              <span>{lang.languageData.subtotalText}</span>
              <span id="subtotal" class="font-medium text-foreground">—</span>
            </div>
            <div
              class="flex justify-between text-xs sm:text-sm text-muted-foreground"
            >
              <span>{lang.languageData.shippingText}</span>
              <span id="shippingCost" class="font-medium text-foreground"
                >—</span
              >
            </div>
            <div
              id="taxRow"
              class="flex justify-between gap-3 text-xs sm:text-sm text-muted-foreground"
            >
              <span id="taxLabel">{copy.taxText}</span>
              <span
                id="taxAmount"
                class="text-right font-medium text-foreground"
                aria-live="polite"
                aria-atomic="true"
              >
                —
              </span>
            </div>
            <p
              id="taxStatus"
              class="hidden text-xs leading-4 text-destructive"
              role="status"
            >
            </p>
            <div
              class="flex justify-between text-xs sm:text-sm text-primary"
              id="discountRow"
            >
              <span class="flex items-center gap-1"
                >{lang.languageData.discountText}
                <span
                  id="appliedDiscountCode"
                  class="font-mono text-xs bg-primary/10 px-1 rounded"
                ></span></span
              >
              <span id="discountAmount" class="font-bold">—</span>
            </div>

            <div class="pt-2 border-t border-border mt-2">
              <div class="flex justify-between items-baseline">
                <span
                  id="totalLabel"
                  data-final-label={lang.languageData.totalText}
                  class="text-sm font-bold text-foreground"
                  >{copy.estimatedTotalText}</span
                >
                <span
                  id="total"
                  class="text-lg sm:text-xl font-extrabold text-foreground tracking-tight"
                  >—</span
                >
              </div>
            </div>

            <!-- Discount Code Form -->
            <div class="pt-3 mt-1">
              <form
                id="discountForm"
                method="post"
                action="/cart"
                class="relative"
                novalidate
              >
                <div class="flex gap-2">
                  <input
                    type="text"
                    id="discountCodeInput"
                    aria-describedby="discountMessage"
                    placeholder={lang.languageData.discountCodePlaceholder}
                    class="h-11 min-w-0 flex-1 rounded-lg border border-input bg-background px-3 text-base font-mono uppercase tracking-wider text-foreground transition-all focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary sm:h-9"
                  />
                  <button
                    type="submit"
                    id="applyDiscountBtn"
                    class="h-11 rounded-lg bg-primary px-4 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90 sm:h-9 sm:text-sm"
                  >
                    {lang.languageData.applyDiscountText}
                  </button>
                  <button
                    type="button"
                    id="removeDiscountBtn"
                    class="h-11 rounded-lg border border-destructive/20 bg-destructive/10 px-4 text-xs font-semibold text-destructive transition-colors hover:bg-destructive/20 sm:h-9 sm:text-sm"
                    style="display: none;"
                  >
                    {lang.languageData.removeDiscountText}
                  </button>
                </div>
                <div
                  id="discountMessage"
                  role="status"
                  aria-live="polite"
                  aria-atomic="true"
                  class="absolute -bottom-5 left-0 text-[10px] sm:text-xs font-medium text-danger truncate max-w-full"
                  style="display: none;"
                >
                </div>
              </form>
            </div>
          </div>
        </div>

      </div>

      <!-- Checkout Form Section - Left on Desktop -->
      <div id="checkoutPanel" class="hidden lg:w-7/12 order-2">
        <!-- Optional customer login trigger -->
        <div id="checkoutSignInPrompt" class="mb-3" data-account-required={checkoutConfig.guestCheckoutEnabled === false ? "true" : "false"}>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-auth-modal', { detail: { intent: 'sign_in' } }))"
            class="w-full text-left rounded-lg bg-primary/10 border border-border px-4 py-3 text-sm text-primary hover:bg-primary/20 transition-colors shadow-sm flex items-center justify-between group"
          >
            <span class="flex items-center gap-2">
              <svg
                class="h-5 w-5 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
              <span class="font-medium">
                {checkoutConfig.guestCheckoutEnabled === false
                  ? copy.signInToCheckoutText
                  : copy.signInPromptText}
              </span>
            </span>
            <span
              class="text-primary font-bold group-hover:translate-x-0.5 transition-transform"
              >→</span
            >
          </button>
        </div>

        <div
          id="checkoutFormCard"
          class:list={[
            "bg-card rounded-xl border border-border shadow-sm p-3 sm:p-4 mb-3",
            { hidden: checkoutConfig.guestCheckoutEnabled === false },
          ]}
        >
          <form
            method="POST"
            action="/cart"
            class="space-y-3"
            id="checkoutForm"
            novalidate
          >
            <input type="hidden" name="formIntent" value="checkout" />
            <input type="hidden" name="cartItems" id="cartItemsInput" />
            <input type="hidden" name="checkoutId" id="checkoutIdInput" />
            <input
              type="hidden"
              name="expectedQuoteFingerprint"
              id="expectedQuoteFingerprint"
            />
            <input
              type="hidden"
              name="discountCodeHidden"
              id="discountCodeHidden"
            />

            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <Label
                  htmlFor="customerName"
                  className="mb-1 block text-sm font-medium text-foreground"
                >
                  {lang.languageData.customerNameLabel}
                  <span class="text-destructive ml-0.5">*</span>
                </Label>
                <Input
                  type="text"
                  id="customerName"
                  name="customerName"
                  required
                  placeholder={lang.languageData.customerNamePlaceholder}
                  className="h-11 w-full bg-muted border-input rounded-lg focus:bg-background focus:border-primary focus:ring-primary/20 text-base text-foreground sm:h-9"
                />
              </div>

              <div>
                <PhoneField
                  client:load
                  name="customerPhone"
                  label={lang.languageData.customerPhoneLabel}
                  placeholder={lang.languageData.customerPhonePlaceholder}
                  required
                  allowedCountries={checkoutConfig.allowedCountries || []}
                  allowedCountriesMode={allowedCountriesMode}
                  requiredMessage={copy.phoneRequiredText}
                  invalidMessage={copy.phoneInvalidText}
                  countryNotAcceptedMessage={copy.phoneCountryNotAcceptedText}
                  countrySelectLabel={copy.phoneCountryLabelText}
                  languageCode={lang.code}
                />
              </div>

              {
                lang.fieldVisibility.showEmailField && (
                  <div class="sm:col-span-2">
                    <Label
                      htmlFor="customerEmail"
                      className="mb-1 block text-sm font-medium text-foreground"
                    >
                      {lang.languageData.customerEmailLabel}
                    </Label>
                    <Input
                      type="email"
                      id="customerEmail"
                      name="customerEmail"
                      placeholder={lang.languageData.customerEmailPlaceholder}
                      className="h-11 w-full bg-muted border-input rounded-lg focus:bg-background focus:border-primary focus:ring-primary/20 text-base text-foreground sm:h-9"
                    />
                  </div>
                )
              }

              <div class="sm:col-span-2 border-t border-border pt-4">
                <Label
                  htmlFor="shippingAddress"
                  className="mb-1 block text-sm font-medium text-foreground"
                >
                  {lang.languageData.shippingAddressLabel}
                  <span class="text-destructive ml-0.5">*</span>
                </Label>
                <Textarea
                  id="shippingAddress"
                  name="shippingAddress"
                  required
                  minLength={MIN_SHIPPING_ADDRESS_LENGTH}
                  aria-describedby="shippingAddressError"
                  placeholder={lang.languageData.shippingAddressPlaceholder}
                  rows={2}
                  className="w-full min-h-16 resize-none bg-muted border-input rounded-lg focus:bg-background focus:border-primary focus:ring-primary/20 px-3 py-2 text-base text-foreground"
                />
                <p
                  id="shippingAddressError"
                  class="mt-1 hidden text-xs font-medium text-destructive"
                  role="alert"
                >
                </p>
              </div>

              <div class="sm:col-span-2">
                <div class="space-y-4">
                  <div class="relative pt-1">
                    <LocationSelector
                      client:load
                      cities={cities}
                      cityLabel={lang.languageData.cityLabel}
                      zoneLabel={lang.languageData.zoneLabel}
                      areaLabel={lang.languageData.areaLabel}
                      cityPlaceholder={copy.selectCityPlaceholder}
                      zonePlaceholder={copy.selectZonePlaceholder}
                      areaPlaceholder={copy.selectAreaPlaceholder}
                      loadingText={copy.loadingText}
                      zonesLoadFailedText={copy.zonesLoadFailedText}
                      areasLoadFailedText={copy.areasLoadFailedText}
                      showAreaField={lang.fieldVisibility.showAreaField}
                    />
                    <p
                      id="shippingLocationError"
                      class="mt-1 hidden text-xs font-medium text-destructive"
                      role="alert"
                    >
                    </p>
                  </div>

                  <ShippingLocationSelector
                    client:load
                    shippingMethods={shippingMethods}
                    shippingMethodLabel={lang.languageData.shippingMethodLabel}
                    freeText={copy.freeText}
                    noShippingMethodsText={copy.noShippingMethodsText}
                    waivedShippingFeeText={copy.waivedShippingFeeText}
                  />
                </div>
              </div>

              {
                lang.fieldVisibility.showOrderNotesField && (
                  <div class="sm:col-span-2">
                    <Label
                      htmlFor="notes"
                      className="mb-1.5 block text-sm font-medium text-foreground"
                    >
                      {lang.languageData.orderNotesLabel}
                    </Label>
                    <Textarea
                      id="notes"
                      name="notes"
                      placeholder={lang.languageData.orderNotesPlaceholder}
                      rows={2}
                      className="w-full min-h-16 resize-none bg-muted border-input rounded-lg focus:bg-background focus:border-primary focus:ring-primary/20 px-3 py-2.5 text-base text-foreground"
                    />
                  </div>
                )
              }
            </div>

            <div class="pt-4">
              <p
                id="checkoutFormMessage"
                class="mb-3 hidden rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive"
                role="alert"
                tabindex="-1"
              >
              </p>
              <Button
                type="submit"
                className="h-11 w-full bg-primary text-primary-foreground font-bold text-base py-3 sm:h-10 sm:py-3.5 rounded-xl shadow-lg hover:bg-primary/90 hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.99] transition-all duration-200 overflow-hidden relative"
                id="submitButton"
                disabled={true}
              >
                <span class="relative z-10" id="submitButtonText">
                  {
                    isProcessing
                      ? lang.languageData.processingText
                      : submitLabel
                  }
                </span>
              </Button>

              {
                codOnly && (
                  <p class="mt-3 text-center text-[10px] text-muted-foreground">
                    {lang.languageData.termsText}
                  </p>
                )
              }
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>

<CheckoutLoadingOverlay
  title={lang.languageData.processingOrderTitle}
  message={lang.languageData.processingOrderMessage}
/>

<script>
  import {
    initCartFunctionality,
    resumeCartPageFromHistory,
  } from "@/lib/cart/client";
  import { getCustomerSession } from "@/lib/api/customer-auth";
  import { getEffectiveCartShippingFee } from "@/store/cart";
  import { validateStorefrontPhone } from "@/lib/phone-country-policy";
  import {
    readCheckoutFormDraft,
    readHostedPaymentRecoverySession,
    syncCheckoutTransferSession,
    writeCheckoutFormDraft,
    writeCheckoutTransferSession,
  } from "@/lib/checkout/session-state";
  import { findNamedCheckoutControl } from "@/lib/checkout/form-controls";
  import {
    getShippingAddressError,
    MIN_SHIPPING_ADDRESS_LENGTH,
  } from "@/lib/checkout/shipping-address";
  import {
    hideCheckoutLoadingOverlay,
    showCheckoutLoadingOverlay,
  } from "@/lib/checkout/loading-overlay";
  import {
    ENGLISH_CHECKOUT_LANGUAGE_DATA,
    formatCheckoutLanguageText,
    type CheckoutLanguageData as CheckoutLanguageStrings,
  } from "@scalius/shared/checkout-language";

  type CustomerAutofillProfile = {
    name?: string | null;
    phone?: string | null;
    email?: string | null;
    address?: string | null;
    city?: string | null;
    cityName?: string | null;
    zone?: string | null;
    zoneName?: string | null;
    area?: string | null;
    areaName?: string | null;
  };

  window.__scaliusCartPageAbortController?.abort();
  const cartPageAbortController = new AbortController();
  window.__scaliusCartPageAbortController = cartPageAbortController;
  const cartPageSignal = cartPageAbortController.signal;

  const meta = document.getElementById("checkout-meta");
  const codOnly = meta?.dataset.codOnly === "true";
  const checkoutUnavailable = meta?.dataset.checkoutUnavailable === "true";
  const guestCheckoutEnabled = meta?.dataset.guestCheckoutEnabled !== "false"; // default true
  const checkoutLanguage = window.__CHECKOUT_LANGUAGE__ as
    | {
        languageData?: CheckoutLanguageStrings;
      }
    | undefined;
  const checkoutCopy = checkoutLanguage?.languageData ?? ENGLISH_CHECKOUT_LANGUAGE_DATA;
  const checkoutUnavailableMessage =
    meta?.dataset.checkoutUnavailableMessage ||
    checkoutCopy.checkoutUnavailableMessage;

  const runWhenDomReady = (callback: () => void | Promise<void>) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => void callback(), {
        once: true,
        signal: cartPageSignal,
      });
      return;
    }

    void callback();
  };

  void initCartFunctionality();

  // ── Customer login pre-fill ───────────────────────────────────────────────

  // Helper to normalize phone numbers — pass through E.164 or raw value
  const normalizePhone = (phone: string | undefined | null) => {
    if (!phone) return "";
    return phone.trim();
  };

  // Helper to fill basic fields
  const fillBasicCustomerFields = (customer: CustomerAutofillProfile) => {
    const draft = readCheckoutFormDraft();
    const preferredName = draft && "customerName" in draft
      ? draft.customerName
      : customer?.name;
    if (preferredName) {
      const el = document.getElementById("customerName") as HTMLInputElement;
      if (el && !el.value) el.value = preferredName;
    }
    const preferredPhone = draft && "customerPhone" in draft
      ? draft.customerPhone
      : customer?.phone;
    if (preferredPhone) {
      // PhoneField is a React component — dispatch custom event to update its state
      const phone = normalizePhone(preferredPhone);
      const phoneInput = document.querySelector<HTMLInputElement>(
        '[name="customerPhone"]',
      );
      if (phone && !phoneInput?.value) {
        window.dispatchEvent(
          new CustomEvent("phone-prefill", { detail: phone }),
        );
      }
    }
    const preferredEmail = draft && "customerEmail" in draft
      ? draft.customerEmail
      : customer?.email;
    if (preferredEmail) {
      const el = document.getElementById("customerEmail") as HTMLInputElement;
      if (el && !el.value) el.value = preferredEmail;
    }
    const preferredAddress = draft && "shippingAddress" in draft
      ? draft.shippingAddress
      : customer?.address;
    if (preferredAddress) {
      const el = document.getElementById(
        "shippingAddress",
      ) as HTMLTextAreaElement;
      if (el && !el.value) el.value = preferredAddress;
    }
  };

  const checkoutDraftFields = [
    "customerName",
    "customerPhone",
    "customerEmail",
    "shippingAddress",
    "city",
    "cityName",
    "zone",
    "zoneName",
    "area",
    "areaName",
    "shippingLocation",
    "notes",
  ] as const;

  let latestDraftLocation: {
    city?: string;
    cityName?: string;
    zone?: string;
    zoneName?: string;
    area?: string;
    areaName?: string;
  } = {};
  let phoneFieldHasBuyerEdit = false;

  const readCheckoutFormValues = () => {
    const draft = readCheckoutFormDraft();
    const values: Record<string, string> = {};
    for (const field of checkoutDraftFields) {
      const input = findNamedCheckoutControl(document, field);
      const inputValue =
        field === "customerPhone" &&
        input instanceof HTMLInputElement &&
        input.dataset.e164Value !== undefined
          ? input.dataset.e164Value
          : input?.value;
      if (
        field === "customerPhone" &&
        input &&
        !phoneFieldHasBuyerEdit &&
        !inputValue &&
        draft &&
        Object.prototype.hasOwnProperty.call(draft, field)
      ) {
        values[field] = draft[field] ?? "";
      } else if (input) values[field] = inputValue ?? "";
      else if (draft && field in draft) values[field] = draft[field] ?? "";
    }
    Object.assign(values, latestDraftLocation);
    return values;
  };

  const syncExistingCheckoutTransfer = (values: Record<string, string>) => {
    const cartItems = (
      document.getElementById("cartItemsInput") as HTMLInputElement | null
    )?.value;
    const checkoutId = (
      document.getElementById("checkoutIdInput") as HTMLInputElement | null
    )?.value;
    const discountCodeHidden = (
      document.getElementById("discountCodeHidden") as HTMLInputElement | null
    )?.value;
    const expectedQuoteFingerprint = (
      document.getElementById("expectedQuoteFingerprint") as HTMLInputElement | null
    )?.value;
    const shippingMethodId =
      window.lastShippingEventDetail?.id || values.shippingLocation;
    const shippingMethodName = window.lastShippingEventDetail?.name;
    let shippingCharge = "";
    if (cartItems) {
      try {
        shippingCharge = String(
          getEffectiveCartShippingFee(
            JSON.parse(cartItems),
            window.lastShippingEventDetail?.fee ?? 0,
          ),
        );
      } catch {
        shippingCharge = "";
      }
    }
    syncCheckoutTransferSession({
      ...values,
      ...(cartItems ? { cartItems } : {}),
      ...(checkoutId ? { checkoutId } : {}),
      ...(discountCodeHidden !== undefined ? { discountCodeHidden } : {}),
      ...(expectedQuoteFingerprint ? { expectedQuoteFingerprint } : {}),
      ...(shippingMethodId ? { shippingMethodId } : {}),
      ...(shippingMethodName ? { shippingMethodName } : {}),
      ...(shippingCharge ? { shippingCharge } : {}),
    });
  };

  const persistCheckoutFormDraftNow = () => {
    const values = readCheckoutFormValues();
    writeCheckoutFormDraft(values);
    syncExistingCheckoutTransfer(values);
  };

  let draftWriteTimer: number | null = null;
  const persistCheckoutFormDraft = () => {
    if (draftWriteTimer !== null) window.clearTimeout(draftWriteTimer);
    draftWriteTimer = window.setTimeout(() => {
      draftWriteTimer = null;
      persistCheckoutFormDraftNow();
    }, 120);
  };

  document.addEventListener(
    "astro:before-swap",
    () => {
      if (draftWriteTimer !== null) {
        window.clearTimeout(draftWriteTimer);
        draftWriteTimer = null;
      }
      persistCheckoutFormDraftNow();
      cartPageAbortController.abort();
    },
    { once: true, signal: cartPageSignal },
  );

  const restoreCheckoutFormDraft = () => {
    const draft = readCheckoutFormDraft();
    if (!draft) return;

    for (const field of [
      "customerName",
      "customerEmail",
      "shippingAddress",
      "notes",
    ] as const) {
      const input = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(
        `[name="${field}"]`,
      );
      if (input && !input.value && draft[field]) input.value = draft[field] || "";
    }

    if (draft.customerPhone) {
      window.dispatchEvent(
        new CustomEvent("phone-prefill", { detail: draft.customerPhone }),
      );
    }
  };

  runWhenDomReady(() => {
    restoreCheckoutFormDraft();
    const form = document.getElementById("checkoutForm");
    form?.addEventListener("input", (event) => {
      if (
        event.isTrusted &&
        (event.target as HTMLInputElement | null)?.id === "customerPhone-input"
      ) {
        phoneFieldHasBuyerEdit = true;
      }
      persistCheckoutFormDraft();
    }, {
      signal: cartPageSignal,
    });
    form?.addEventListener("change", persistCheckoutFormDraft, {
      signal: cartPageSignal,
    });
    window.addEventListener(
      "checkout-location-change",
      (event) => {
        const detail = (event as CustomEvent<Record<string, unknown>>).detail;
        latestDraftLocation = {
          city: typeof detail?.cityId === "string" ? detail.cityId : "",
          cityName: typeof detail?.cityName === "string" ? detail.cityName : "",
          zone: typeof detail?.zoneId === "string" ? detail.zoneId : "",
          zoneName: typeof detail?.zoneName === "string" ? detail.zoneName : "",
          area: typeof detail?.areaId === "string" ? detail.areaId : "",
          areaName: typeof detail?.areaName === "string" ? detail.areaName : "",
        };
        persistCheckoutFormDraft();
      },
      { signal: cartPageSignal },
    );
    window.addEventListener("shippingLocationChange", persistCheckoutFormDraft, {
      signal: cartPageSignal,
    });
    window.addEventListener(
      "pagehide",
      persistCheckoutFormDraftNow,
      { signal: cartPageSignal },
    );
    document.addEventListener("cart-updated", persistCheckoutFormDraft, {
      signal: cartPageSignal,
    });
  });

  // Helper to auto-select City/Zone dropdowns through LocationSelector's event API.
  const fillLocationDropdowns = (customer: CustomerAutofillProfile) => {
    try {
      const draft = readCheckoutFormDraft();
      const draftOwnsLocation = Boolean(
        draft && ["city", "cityName", "zone", "zoneName", "area", "areaName"]
          .some((field) => Object.prototype.hasOwnProperty.call(draft, field)),
      );
      const preferred = draftOwnsLocation
        ? {
            city: draft?.city,
            cityName: draft?.cityName,
            zone: draft?.zone,
            zoneName: draft?.zoneName,
            area: draft?.area,
            areaName: draft?.areaName,
          }
        : customer;
      if (!preferred?.cityName && !preferred?.city) return;
      const existingCity =
        document.querySelector<HTMLInputElement>('input[name="city"]')?.value;
      const existingZone =
        document.querySelector<HTMLInputElement>('input[name="zone"]')?.value;
      if (existingCity || existingZone) return;
      window.dispatchEvent(
        new CustomEvent("location-prefill", {
          detail: {
            city: preferred.city,
            cityName: preferred.cityName,
            zone: preferred.zone,
            zoneName: preferred.zoneName,
            area: preferred.area,
            areaName: preferred.areaName,
          },
        }),
      );
    } catch (err: unknown) {
      console.error("Cart autofill location err:", err);
    }
  };

  const revealCheckoutFormForCustomer = () => {
    document.getElementById("checkoutSignInPrompt")?.classList.add("hidden");
    document.getElementById("checkoutFormCard")?.classList.remove("hidden");
  };

  // 1. Initial page load hydration (standalone fetch)
  runWhenDomReady(async () => {
    const isUserLoggedIn = document.cookie
      .split(";")
      .some((c) => c.trim().startsWith("cs_auth=1"));
    if (isUserLoggedIn || !guestCheckoutEnabled) {
      const session = await getCustomerSession();
      if (session.unavailable) {
        console.warn(
          "Customer session autofill skipped:",
          session.error || "Account status could not be read.",
        );
        return;
      }
      if (session?.authenticated && session.customer) {
        fillBasicCustomerFields(session.customer);
        fillLocationDropdowns(session.customer);
        revealCheckoutFormForCustomer();
      }
    }
  });

  // 2. Active login intercept (AuthModal)
  window.addEventListener(
    "customer-login",
    ((e: CustomEvent<CustomerAutofillProfile>) => {
      if (cartPageSignal.aborted) return;
      const customer = e.detail;
      fillBasicCustomerFields(customer);
      revealCheckoutFormForCustomer();
      // Modal normally resolves quickly, but schedule location fill slightly later to avoid DOM races
      const timeoutId = window.setTimeout(
        () => fillLocationDropdowns(customer),
        300,
      );
      cartPageSignal.addEventListener(
        "abort",
        () => window.clearTimeout(timeoutId),
        { once: true },
      );
    }) as EventListener,
    { signal: cartPageSignal },
  );

  // ── Multi-gateway checkout redirect ──

  runWhenDomReady(() => {
    const form = document.getElementById("checkoutForm") as HTMLFormElement;
    const submitButton = document.getElementById(
      "submitButton",
    ) as HTMLButtonElement;
    const submitButtonText = document.getElementById("submitButtonText");
    const isCartEmpty = () => {
      const input = document.getElementById(
        "cartItemsInput",
      ) as HTMLInputElement;
      return !input?.value || input.value === "{}" || input.value === "[]";
    };

    const readCustomerSessionForCheckout = async () => getCustomerSession();
    const initialSubmitText = submitButtonText?.textContent?.trim() || checkoutCopy.placeOrderText;
    const checkoutFormMessage = document.getElementById("checkoutFormMessage");
    let submitAfterCustomerSessionCheck = false;
    let submitAfterCartValidation = false;

    const setSubmitButtonText = (text: string) => {
      if (submitButtonText) submitButtonText.textContent = text;
    };

    const restoreSubmitButton = () => {
      setSubmitButtonText(initialSubmitText);
      updateCheckoutButtonState();
    };

    const showCheckoutFormError = (message: string, focusTarget?: HTMLElement | null) => {
      if (!checkoutFormMessage) return;
      checkoutFormMessage.textContent = message;
      checkoutFormMessage.classList.remove("hidden");
      checkoutFormMessage.scrollIntoView?.({ behavior: "smooth", block: "center" });
      (focusTarget ?? checkoutFormMessage).focus({ preventScroll: true });
    };

    const clearCheckoutFormError = () => {
      if (!checkoutFormMessage) return;
      checkoutFormMessage.textContent = "";
      checkoutFormMessage.classList.add("hidden");
    };

    const showCheckoutTransferError = (message: string) => {
      restoreSubmitButton();
      hideCheckoutLoadingOverlay();

      const messageEl = document.getElementById("cartValidationMessage");
      if (!messageEl) {
        showCheckoutFormError(message, submitButton);
        return;
      }

      messageEl.textContent = message;
      messageEl.classList.remove("hidden");
      messageEl.scrollIntoView?.({ behavior: "smooth", block: "center" });
    };

    const updateCheckoutButtonState = () => {
      if (submitButton) {
        const cartReady =
          document.getElementById("cartPageRoot")?.dataset.cartReady === "true";
        const empty = isCartEmpty();
        const cartBlocked = window.hasCartValidationIssues?.() === true;
        const checkoutPending = readHostedPaymentRecoverySession() !== null;
        const quoteUnverified =
          codOnly &&
          !/^taxq_[A-Za-z0-9_-]{22}$/.test(
            (document.getElementById("expectedQuoteFingerprint") as HTMLInputElement | null)
              ?.value ?? "",
          );
        submitButton.disabled =
          !cartReady || checkoutUnavailable || empty || cartBlocked || checkoutPending || quoteUnverified;
        if (!cartReady || checkoutUnavailable || empty || cartBlocked || checkoutPending || quoteUnverified)
          submitButton.classList.add("opacity-50", "cursor-not-allowed");
        else submitButton.classList.remove("opacity-50", "cursor-not-allowed");
        submitButton.title = !cartReady
          ? checkoutCopy.cartLoadingText
          : checkoutUnavailable
            ? checkoutUnavailableMessage
            : empty
              ? checkoutCopy.emptyCartText
              : cartBlocked
                ? window.getCartBlockedMessage?.() ||
                  checkoutCopy.cartAttentionText
                : checkoutPending
                  ? checkoutCopy.reviewExistingCheckoutText
                : quoteUnverified
                  ? checkoutCopy.totalVerificationFailedText
                : "";
      }
    };

    updateCheckoutButtonState();
    document.addEventListener("cart-updated", updateCheckoutButtonState, {
      signal: cartPageSignal,
    });

    if (!form || !submitButton) return;

    window.addEventListener(
      "pageshow",
      (event) => {
        if (!(event as PageTransitionEvent).persisted) return;
        submitAfterCustomerSessionCheck = false;
        submitAfterCartValidation = false;
        hideCheckoutLoadingOverlay({ restoreFocus: false });
        restoreSubmitButton();
        void resumeCartPageFromHistory();
      },
      { signal: cartPageSignal },
    );

    const shippingAddressInput = document.getElementById(
      "shippingAddress",
    ) as HTMLTextAreaElement | null;
    const shippingAddressError = document.getElementById(
      "shippingAddressError",
    );
    const shippingLocationError = document.getElementById(
      "shippingLocationError",
    );
    const syncShippingAddressValidity = (showError: boolean) => {
      if (!shippingAddressInput) return true;
      const addressError = getShippingAddressError(shippingAddressInput.value);
      const message = !addressError
        ? null
        : shippingAddressInput.value.trim()
          ? formatCheckoutLanguageText(checkoutCopy.addressIncompleteText, {
              minimum: MIN_SHIPPING_ADDRESS_LENGTH,
            })
          : checkoutCopy.addressRequiredText;
      shippingAddressInput.setCustomValidity(message ?? "");
      if (shippingAddressError) {
        shippingAddressError.textContent = showError ? (message ?? "") : "";
        shippingAddressError.classList.toggle("hidden", !showError || !message);
      }
      return message === null;
    };

    shippingAddressInput?.addEventListener(
      "input",
      () => {
        const errorIsVisible =
          shippingAddressError?.classList.contains("hidden") === false;
        syncShippingAddressValidity(errorIsVisible);
      },
      { signal: cartPageSignal },
    );
    shippingAddressInput?.addEventListener(
      "invalid",
      () => syncShippingAddressValidity(true),
      { signal: cartPageSignal },
    );
    window.addEventListener(
      "checkout-location-change",
      () => {
        if (!shippingLocationError) return;
        shippingLocationError.textContent = "";
        shippingLocationError.classList.add("hidden");
      },
      { signal: cartPageSignal },
    );

    form.addEventListener(
      "submit",
      async (e) => {
        clearCheckoutFormError();
        if (checkoutUnavailable) {
          e.preventDefault();
          showCheckoutFormError(checkoutUnavailableMessage, submitButton);
          return;
        }

        const pendingCheckout = readHostedPaymentRecoverySession();
        if (pendingCheckout) {
          e.preventDefault();
          restoreSubmitButton();
          const recoveryLink = document.getElementById("checkoutRecoveryLink") as HTMLAnchorElement | null;
          showCheckoutFormError(
            checkoutCopy.reviewExistingCheckoutText,
            recoveryLink ?? submitButton,
          );
          return;
        }

        // Guest Checkout Interception
        if (!guestCheckoutEnabled && !submitAfterCustomerSessionCheck) {
          e.preventDefault();
          submitButton.disabled = true;
          setSubmitButtonText(checkoutCopy.checkingAccountText);

          const session = await readCustomerSessionForCheckout();
          if (session.unavailable) {
            restoreSubmitButton();
            showCheckoutFormError(
              session.error ||
                checkoutCopy.accountUnavailableText,
              submitButton,
            );
            return;
          }

          if (!session.authenticated) {
            restoreSubmitButton();
            window.dispatchEvent(new CustomEvent("open-auth-modal"));
            return;
          }

          if (codOnly) {
            submitAfterCustomerSessionCheck = true;
            form.requestSubmit();
            return;
          }
        }

        if (submitAfterCustomerSessionCheck) {
          submitAfterCustomerSessionCheck = false;
        }

        // Cart empty check
        if (isCartEmpty()) {
          e.preventDefault();
          restoreSubmitButton();
          showCheckoutFormError(
            checkoutCopy.cartEmptyErrorText,
            submitButton,
          );
          return;
        }

        // Persist the current DOM immediately so explicit empty edits replace
        // older draft values before any async validation or navigation.
        persistCheckoutFormDraftNow();

        // Validate in visual form order and keep every error inline. The form
        // is novalidate so browser-native validation bubbles cannot conflict
        // with the field that receives focus.
        const requiredFields = [
          "customerName",
          "customerPhone",
          "shippingAddress",
        ];
        const missing: string[] = [];
        for (const field of requiredFields) {
          const el = document.querySelector(
            `[name="${field}"]`,
          ) as HTMLInputElement | null;
          if (!el?.value?.trim()) missing.push(field);
        }
        if (missing.length > 0) {
          e.preventDefault();
          restoreSubmitButton();
          const firstMissing = missing[0];
          const missingTarget = document.querySelector<HTMLElement>(`[name="${firstMissing}"]`);
          if (firstMissing === "customerPhone") {
            window.dispatchEvent(new CustomEvent("phone-validation-error", {
              detail: { name: "customerPhone", message: checkoutCopy.phoneRequiredText },
            }));
            missingTarget?.focus({ preventScroll: true });
          } else {
            const missingMessage = firstMissing === "customerName"
              ? checkoutCopy.nameRequiredText
              : checkoutCopy.addressRequiredText;
            showCheckoutFormError(missingMessage, missingTarget);
          }
          return;
        }

        const phoneInput = document.querySelector<HTMLInputElement>(
          '[name="customerPhone"]',
        );
        const checkoutConfig = window.__CHECKOUT_CONFIG__;
        const phonePolicy =
          checkoutConfig && typeof checkoutConfig === "object"
            ? {
                countries: Array.isArray(
                  (checkoutConfig as { allowedCountries?: unknown }).allowedCountries,
                )
                  ? ((checkoutConfig as { allowedCountries: string[] }).allowedCountries)
                  : [],
                mode:
                  (checkoutConfig as { allowedCountriesMode?: unknown })
                    .allowedCountriesMode === "exclude"
                    ? ("exclude" as const)
                    : ("include" as const),
              }
            : undefined;
        const phoneValidation = validateStorefrontPhone(
          phoneInput?.value || "",
          phonePolicy,
        );
        if (!phoneValidation.ok) {
          e.preventDefault();
          restoreSubmitButton();
          window.dispatchEvent(
            new CustomEvent("phone-validation-error", {
              detail: {
                name: "customerPhone",
                message: phoneValidation.message?.includes("does not accept")
                  ? checkoutCopy.phoneCountryNotAcceptedText
                  : checkoutCopy.phoneInvalidText,
              },
            }),
          );
          return;
        }
        persistCheckoutFormDraftNow();

        if (!syncShippingAddressValidity(true)) {
          e.preventDefault();
          restoreSubmitButton();
          shippingAddressInput?.focus({ preventScroll: true });
          shippingAddressInput?.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
          return;
        }

        const cityInput = document.querySelector<HTMLInputElement>(
          '[name="city"]',
        );
        const zoneInput = document.querySelector<HTMLInputElement>(
          '[name="zone"]',
        );
        if (!cityInput?.value?.trim() || !zoneInput?.value?.trim()) {
          e.preventDefault();
          restoreSubmitButton();
          const missingCity = !cityInput?.value?.trim();
          const message = missingCity
            ? checkoutCopy.cityZoneRequiredText
            : checkoutCopy.zoneRequiredText;
          if (shippingLocationError) {
            shippingLocationError.textContent = message;
            shippingLocationError.classList.remove("hidden");
            shippingLocationError.scrollIntoView({
              behavior: "smooth",
              block: "center",
            });
          }
          const target = document.querySelector<HTMLButtonElement>(
            missingCity
              ? 'button[aria-label^="City:"]'
              : 'button[aria-label^="Zone:"]',
          );
          target?.focus({ preventScroll: true });
          return;
        }

        const shippingLocationInput = findNamedCheckoutControl(
          document,
          "shippingLocation",
        );
        if (!shippingLocationInput?.value?.trim()) {
          e.preventDefault();
          restoreSubmitButton();
          if (shippingLocationError) {
            shippingLocationError.textContent = checkoutCopy.deliveryRequiredText;
            shippingLocationError.classList.remove("hidden");
            shippingLocationError.scrollIntoView({ behavior: "smooth", block: "center" });
          }
          document.querySelector<HTMLButtonElement>('[role="radio"][aria-label]')
            ?.focus({ preventScroll: true });
          return;
        }

        const expectedQuoteFingerprintInput = document.getElementById(
          "expectedQuoteFingerprint",
        ) as HTMLInputElement | null;
        if (
          codOnly &&
          !/^taxq_[A-Za-z0-9_-]{22}$/.test(expectedQuoteFingerprintInput?.value ?? "")
        ) {
          e.preventDefault();
          restoreSubmitButton();
          showCheckoutFormError(
            checkoutCopy.totalVerificationFailedText,
            submitButton,
          );
          return;
        }

        if (!submitAfterCartValidation) {
          e.preventDefault();
          submitButton.disabled = true;
          setSubmitButtonText(checkoutCopy.checkingCartText);
          const cartIsValid = await (window.validateCartSnapshot?.() ??
            Promise.resolve(true));
          if (!cartIsValid || window.hasCartValidationIssues?.() === true) {
            restoreSubmitButton();
            showCheckoutFormError(
              window.getCartBlockedMessage?.() ||
                checkoutCopy.reviewCartItemsText,
              submitButton,
            );
            return;
          }

          if (codOnly) {
            submitAfterCartValidation = true;
            form.requestSubmit();
            return;
          }
        }

        if (submitAfterCartValidation) {
          submitAfterCartValidation = false;
        }

        if (!codOnly) {
          // ── Multi-gateway flow: intercept and redirect to /checkout ──
          e.preventDefault();

          // Collect all form data + cart items into sessionStorage
          const formData = new FormData(form);
          const checkoutData: Record<string, string> = {};
          formData.forEach((value, key) => {
            checkoutData[key] = value as string;
          });
          checkoutData.customerPhone = phoneValidation.value;

          // Also grab location hidden fields that may not be in formData
          const fields = [
            "city",
            "zone",
            "area",
            "shippingLocation",
            "cityName",
            "zoneName",
            "areaName",
          ];
          for (const f of fields) {
            const el = findNamedCheckoutControl(document, f);
            if (el) checkoutData[f] = el.value;
          }

          // Capture the current shipping fee from the ShippingLocationSelector
          // Fall back to the first shipping method's fee when no selection has been made
          const defaultShippingFee = parseFloat(
            meta?.dataset.defaultShippingFee || "0",
          );
          const defaultShippingId =
            meta?.dataset.defaultShippingId || undefined;
          const selectedShippingFee =
            window.lastShippingEventDetail?.fee ?? defaultShippingFee;
          const shippingMethodId =
            window.lastShippingEventDetail?.id ?? defaultShippingId;
          const shippingMethodName = window.lastShippingEventDetail?.name
            ?? meta?.dataset.defaultShippingName;

          const cartDataForShipping = JSON.parse(
            (document.getElementById("cartItemsInput") as HTMLInputElement)
              ?.value || "{}",
          );
          const shippingFee = getEffectiveCartShippingFee(
            cartDataForShipping,
            selectedShippingFee,
          );

          checkoutData["shippingCharge"] = String(shippingFee);
          if (shippingMethodId)
            checkoutData["shippingMethodId"] = shippingMethodId;
          if (shippingMethodName)
            checkoutData["shippingMethodName"] = shippingMethodName;

          const transferWrite = writeCheckoutTransferSession(
            checkoutData,
            meta?.dataset.gateways || "[]",
          );
          if (!transferWrite.ok) {
            showCheckoutTransferError(transferWrite.message);
            return;
          }

          submitButton.disabled = true;
          setSubmitButtonText(checkoutCopy.redirectingToPaymentText);

          showCheckoutLoadingOverlay({
            title: checkoutCopy.openingPaymentOptionsTitle,
            message: checkoutCopy.openingPaymentOptionsMessage,
          });
          window.location.href = "/checkout";
          return;
        }

        // ── COD-only flow: normal form POST ──
        submitButton.disabled = true;
        setSubmitButtonText(checkoutCopy.processingText);
        showCheckoutLoadingOverlay({
          title:
            checkoutLanguage?.languageData?.processingOrderTitle ||
            checkoutCopy.processingOrderTitle,
          message:
            checkoutLanguage?.languageData?.processingOrderMessage ||
            checkoutCopy.processingOrderMessage,
        });
      },
      { signal: cartPageSignal },
    );
  });
</script>

