              class="inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-foreground underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-ring group-data-[cart-state=empty]:hidden sm:min-h-9"
              data-part="lines-continue"
            >
              <span aria-hidden="true">←</span>
              {copy.continueShoppingText}
            </a>
          </div>

          {/* Loading skeleton at a cart line's size; the real lines render
              hidden underneath and appear together with the summary. */}
          <div class="hidden p-4 group-data-[cart-state=loading]:block" data-part="lines-loading" data-cart-loading>
            <p class="sr-only" role="status">{copy.cartLoadingText}</p>
            <div class="flex gap-3 py-2" aria-hidden="true" data-cart-loading-line>
              <div class="theme-skeleton size-20 shrink-0"></div>
              <div class="flex-1 space-y-2 pt-1">
                <div class="theme-skeleton h-4 w-3/4" data-cart-loading-name></div>
                <div class="theme-skeleton h-4 w-1/3"></div>
                <div class="theme-skeleton h-9 w-28"></div>
              </div>
            </div>
          </div>
          {/* The saved lines at their size, named, before the cart script loads
              (the same for every buyer: it reads only this browser's storage).
              The cart script replaces them with the checked lines. */}
          <script is:inline set:html={CART_LOADING_LINES_SCRIPT} />
          <div
            class="min-h-24 p-4 group-data-[cart-state=loading]:hidden"
            id="cartItems"
            aria-busy="true"
            data-part="lines-list"
          >
            {/* The empty state as HTML, for the first paint; the cart script
                replaces it with the lines (renderEmptyCartState keeps it in step). */}
            <div class="text-center py-8 px-4" data-cart-empty data-part="cart-empty">
              {cartPlan.icons["cart.empty"] ? (
                <img src={cartPlan.icons["cart.empty"]} alt="" width="48" height="48" class="mx-auto h-12 w-12 object-contain" data-part="cart-empty-icon" />
              ) : (
              <svg class="mx-auto h-12 w-12 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" data-part="cart-empty-icon">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              )}
              <h2 class="mt-2 text-lg font-medium text-foreground">{copy.emptyCartText}</h2>
              <p class="mt-1 text-sm text-muted-foreground">{copy.emptyCartDescriptionText}</p>
              <div class="mt-6 flex flex-col items-center justify-center gap-2 sm:flex-row">
                <a
                  href="/"
                  class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-primary-foreground bg-primary hover:bg-primary/90"
                >
                  <svg class="-ms-1 me-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                  </svg>
                  {copy.continueShoppingText}
                </a>
              </div>
            </div>
          </div>
          {/* Clear cart is here, not in the drawer (one action there); lib/cart/client.ts offers Undo. */}
          <div class="hidden px-4 pb-3 text-end group-data-[cart-state=items]:block" data-part="lines-clear">
            <button
              type="button"
              id="clearCartButton"
              class="inline-flex min-h-11 items-center text-sm text-muted-foreground underline decoration-border underline-offset-2 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring sm:min-h-9"
            >
              {cartWords.clearCart}
            </button>
          </div>
          <p id="cartUndo" class="mx-4 mb-3 text-sm text-muted-foreground" role="status" hidden data-part="lines-undo"></p>

      </Fragment>
      <Fragment slot="summary">
            <div class="flex justify-between text-sm text-muted-foreground" data-summary-row="subtotal">
              <span>{copy.subtotalText}</span>
              <span id="subtotal" class="font-medium tabular-nums text-foreground">—</span>
            </div>
            {/* The apps' add-ons as their own rows ("Protection ৳350"), drawn with the totals: Subtotal and these add up to the cart's subtotal. */}
            <div id="addOnRows" class="space-y-2" hidden></div>
            <div class="flex justify-between gap-3 text-sm text-muted-foreground group-data-[delivery-need=none]:hidden" id="shippingRow" data-summary-row="delivery">
              {/* A pickup order has no shipping: the row names the pickup. */}
              <span class="group-data-[delivery-mode=pickup]:hidden">{copy.shippingText}</span>
              <span class="hidden group-data-[delivery-mode=pickup]:inline">{copy.deliveryModePickupText}</span>
              <span id="shippingCost" class="text-end font-medium tabular-nums text-foreground">—</span>
            </div>
            <p id="shippingProgress" class="hidden text-sm text-primary" role="status"></p>
            <div id="discountLines" class="space-y-1" data-summary-row="discount"></div>
            <div id="taxRow" data-summary-row="tax" class="hidden flex justify-between gap-3 text-sm text-muted-foreground">
              <span id="taxLabel">{copy.taxText}</span>
              <span id="taxAmount" class="text-end font-medium tabular-nums text-foreground">—</span>
            </div>

            <div class="mt-2 border-t border-border pt-2">
              <div class="flex items-baseline justify-between" aria-live="polite" aria-atomic="true" data-summary-row="total">
                <span
                  id="totalLabel"
                  data-final-label={copy.totalText}
                  class="text-sm font-semibold text-foreground"
                  >{copy.estimatedTotalText}</span
                >
                <span id="total" class="text-xl font-semibold tabular-nums text-foreground">—</span>
              </div>
              <p id="taxStatus" class="mt-1 hidden text-sm text-destructive" role="status"></p>
              <p id="estimateNote" class="mt-1 hidden text-sm text-muted-foreground" role="status"></p>
            </div>

      </Fragment>
      <Fragment slot="discount">
            <form id="discountForm" method="post" action="/cart" class="pt-3" novalidate data-part="discount">
              <label for="discountCodeInput" class="sr-only">{copy.discountCodePlaceholder}</label>
              <div class="flex gap-2">
                <input
                  type="text"
                  id="discountCodeInput"
                  aria-describedby="discountMessage"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  enterkeyhint="done"
                  maxlength="50"
                  placeholder={copy.discountCodePlaceholder}
                  class={`${fieldClass} min-w-0 flex-1`}
                />
                <button
                  type="submit"
                  id="applyDiscountBtn"
                  class="h-11 shrink-0 rounded-lg border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:opacity-50"
                >
                  {copy.applyDiscountText}
                </button>
              </div>
              <p id="discountMessage" class="mt-1.5 text-sm" role="status" aria-live="polite" hidden></p>
            </form>
            <ul id="appliedCodes" class="hidden flex flex-wrap gap-2 pt-1"></ul>
            <ul id="discountOffers" class="hidden space-y-2" role="status"></ul>
      </Fragment>
      <Fragment slot="summaryEnd">
            {/* Cart-level availability answer: below the totals, never above
                painted lines, so it lands without moving them. */}
            <div
              id="cartValidationMessage"
              class="hidden mt-3 rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive"
              role="alert"
              data-part="summary-validation"
            >
            </div>
      </Fragment>
      <Fragment slot="empty">
          {emptyCartCategories.length > 0 && (
            <nav aria-labelledby="cartEmptyCategoriesTitle">
              <h2 id="cartEmptyCategoriesTitle" class="mb-3 text-base font-semibold text-foreground">{cartWords.shopByCategory}</h2>
              <ul class="flex flex-wrap gap-2">
                {emptyCartCategories.map((node) => (
                  <li>
                    <a
                      href={node.canonicalPath ?? `/categories/${encodeURIComponent(node.slug)}`}
                      class="inline-flex min-h-11 items-center rounded-lg border border-border bg-card px-4 text-sm font-medium text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                    >{node.name}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <EmptyCartPopular
            title={cartWords.popularNow}
            recommendations={popularProducts}
            currencySymbol={layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol}
            currencyCode={layoutData?.currency?.code ?? DEFAULT_CURRENCY.code}
          />
      </Fragment>
      <Fragment slot="details">
        <div id="checkoutSignInPrompt" class="mb-3" data-part="details-sign-in" data-account-required={checkoutConfig.guestCheckoutEnabled === false ? "true" : "false"}>
          <button
            type="button"
            data-open-auth="sign_in"
            class="flex min-h-11 w-full items-center justify-between gap-3 rounded-lg border border-border bg-card px-4 py-3 text-start text-sm text-foreground transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
          >
            <span class="font-medium">
              {checkoutConfig.guestCheckoutEnabled === false
                ? copy.signInToCheckoutText
                : copy.signInPromptText}
            </span>
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <div
          id="checkoutFormCard"
          data-part="details-form"
          class:list={[
            "rounded-xl border border-border bg-card p-4 sm:p-5",
            { hidden: checkoutConfig.guestCheckoutEnabled === false },
          ]}
        >
          <form
            method="POST"
            action="/cart"
            class="space-y-6"
            id="checkoutForm"
            novalidate
          >
            <input type="hidden" name="formIntent" value="checkout" />
            {/* "skipped": this buyer can pay only cash, placed here (set by the page script). */}
            {codPlaceable && !codOnly && <input type="hidden" name="paymentStep" value="" />}
            <input type="hidden" name="cartItems" id="cartItemsInput" />
            <input type="hidden" name="attributes" id="attributesInput" />
            <input type="hidden" name="checkoutId" id="checkoutIdInput" />
            <input
              type="hidden"
              name="expectedQuoteFingerprint"
              id="expectedQuoteFingerprint"
            />
            <input
              type="hidden"
              name="discountCodes"
              id="discountCodesInput"
            />

            <section aria-labelledby="contactHeading" class="space-y-3" data-part="contact">
              <h2 id="contactHeading" class="text-base font-semibold text-foreground">{copy.contactHeadingText}</h2>
              <div class="grid gap-3 sm:grid-cols-2">
                <div>
                  <label for="customerName" class={labelClass}>
                    {copy.customerNameLabel}
                    <span aria-hidden="true" class="ms-0.5 text-destructive">*</span>
                  </label>
                  <input
                    type="text"
                    id="customerName"
                    name="customerName"
                    autocomplete="name"
                    aria-required="true"
                    aria-describedby="customerName-error"
                    maxlength="100"
                    placeholder={copy.customerNamePlaceholder}
                    class={fieldClass}
                  />
                  <p id="customerName-error" class={errorClass} role="alert"></p>
                </div>

                <div>
                  <CheckoutPhoneField
                    label={copy.customerPhoneLabel}
                    help={copy.customerPhoneHelp}
                    pickupHelp={copy.customerPhonePickupHelp}
                    serviceHelp={copy.customerPhoneServiceHelp}
                    placeholder={copy.customerPhonePlaceholder}
                    allowedCountries={checkoutConfig.allowedCountries || []}
                    allowedCountriesMode={allowedCountriesMode}
                    requiredMessage={copy.phoneRequiredText}
                    invalidMessage={copy.phoneIntlInvalidText}
                    mobileMessage={copy.phoneInvalidText}
                    countryNotAcceptedMessage={copy.phoneCountryNotAcceptedText}
                    countrySelectLabel={copy.phoneCountryLabelText}
                    languageCode={lang.code}
                    shippingCountries={shippingCountries}
                    shippingCountry={shippingCountry}
                    intl={{
                      help: copy.customerPhoneIntlHelp,
                      pickupHelp: copy.customerPhoneIntlPickupHelp,
                      serviceHelp: copy.customerPhoneIntlServiceHelp,
                      exampleText: copy.customerPhoneExampleText,
                    }}
                    optional={phoneOptionalForDigital ? { label: copy.customerPhoneOptionalLabel, help: copy.customerPhoneOptionalHelp } : undefined}
                  />
                </div>

                {
                  contactFields.email !== "hidden" && (
                    <div class="sm:col-span-2">
                      <label for="customerEmail" class={labelClass}>
                        {phoneOptionalForDigital && contactFields.email === "optional" ? (
                          <>
                            {/* Required while the phone is optional (data-phone-need on the page root). */}
                            <span class="group-data-[phone-need=optional]:hidden">{copy.customerEmailLabel}</span>
                            <span class="hidden group-data-[phone-need=optional]:inline">{copy.customerEmailRequiredLabel}<span aria-hidden="true" class="ms-0.5 text-destructive">*</span></span>
                          </>
                        ) : (
                          <>
                            {contactFields.email === "required" ? copy.customerEmailRequiredLabel : copy.customerEmailLabel}
                            {contactFields.email === "required" && <span aria-hidden="true" class="ms-0.5 text-destructive">*</span>}
                          </>
                        )}
                      </label>
                      <input
                        type="email"
                        id="customerEmail"
                        name="customerEmail"
                        autocomplete="email"
                        inputmode="email"
                        aria-describedby="customerEmail-error"
                        maxlength="254"
                        required={contactFields.email === "required"}
                        placeholder={copy.customerEmailPlaceholder}
                        class={fieldClass}
                      />
                      <p id="customerEmail-error" class={errorClass} role="alert"></p>
                    </div>
                  )
                }
                {
                  contactFields.whatsapp === "optional" && (
                    <div class="sm:col-span-2">
                      <label for="customerWhatsapp" class={labelClass}>{copy.customerWhatsappLabel}</label>
                      <input
                        type="tel"
                        id="customerWhatsapp"
                        name="customerWhatsapp"
                        inputmode="tel"
                        autocomplete="off"
                        aria-describedby="customerWhatsapp-help customerWhatsapp-error"
                        maxlength="20"
                        class={fieldClass}
                      />
                      <p id="customerWhatsapp-help" class="mt-1 text-sm text-muted-foreground">{copy.customerWhatsappHelpText}</p>
                      <p id="customerWhatsapp-error" class={errorClass} role="alert"></p>
                    </div>
                  )
                }
              </div>
            </section>
            <div data-buyer-ui-target="checkout.contact.after"></div>

            {/* Nothing physical in the cart (services): no delivery section. */}
            <p
              class="hidden rounded-lg border border-border bg-muted/50 px-3 py-2 text-sm text-foreground group-data-[delivery-need=none]:block"
              data-no-delivery-note
              role="status"
            >
              {copy.noDeliveryNeededText}
            </p>

            {/* A cart that needs delivery in a store that delivers nowhere it sells (shown by the style below). */}
            {!physicalDelivery && (
              <p class="hidden rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive" data-store-not-delivering data-message={copy.cartDeliveryUnavailableText} role="alert">
                {copy.cartDeliveryUnavailableText}
                {cartRequestTheme.preview !== null && (
                  <span class="mt-1 block font-normal text-muted-foreground" data-merchant-hint>{catalogCopy(cartRequestTheme.language).delivery.setupHint}</span>
                )}
              </p>
            )}
            <section aria-labelledby="deliveryHeading" class="space-y-3 group-data-[delivery-need=none]:hidden" data-delivery-section data-part="delivery">
              <h2 id="deliveryHeading" class="text-base font-semibold text-foreground">{copy.deliveryHeadingText}</h2>
              {
                deliveryModeSwitch && (
                  <fieldset class="grid grid-cols-2 gap-2" data-delivery-mode-switch>
                    <legend class="sr-only">{copy.deliveryMethodLegendText}</legend>
                    {([
                      ["delivery", copy.deliveryModeShipText],
                      ["pickup", copy.deliveryModePickupText],
                    ] as const).map(([mode, label]) => (
                      <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-lg border border-border bg-background px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted/50 has-[:checked]:border-primary has-[:checked]:ring-1 has-[:checked]:ring-primary has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-ring">
                        <input
                          type="radio"
                          name="deliveryMode"
                          value={mode}
                          checked={mode === "delivery"}
                          class="h-4 w-4 shrink-0 accent-primary"
                        />
                        <span>{label}</span>
                      </label>
                    ))}
                  </fieldset>
                )
              }
              {pickupOnly && <input type="hidden" name="deliveryMode" value="pickup" />}
              {
                deliveryModeSwitch && (
                  <script is:inline set:html={CART_PICKUP_CHOICE_SCRIPT} />
                )
              }
              <fieldset class="min-w-0 space-y-3 border-0 p-0 group-data-[delivery-mode=pickup]:hidden" data-address-fields>
              <ShippingCountryField
                id="checkout-country"
                countries={shippingCountries}
                selected={shippingCountry}
                label={copy.shippingCountryLabel}
                language={checkoutLanguageBaseCode(lang.code)}
                labelClass={labelClass}
                fieldClass={fieldClass}
              />
              <div>
                <label for="shippingAddress" class={labelClass}>
                  {copy.shippingAddressLabel}
                  <span aria-hidden="true" class="ms-0.5 text-destructive">*</span>
                </label>
                <textarea
                  id="shippingAddress"
                  name="shippingAddress"
                  autocomplete="street-address"
                  aria-required="true"
                  minlength={shipsAbroad ? undefined : MIN_SHIPPING_ADDRESS_LENGTH}
                  maxlength="500"
                  aria-describedby="shippingAddressError"
                  placeholder={copy.shippingAddressPlaceholder}
                  rows={2}
                  class={`${fieldClass} h-auto min-h-16 resize-none py-2`}
                ></textarea>
                <p id="shippingAddressError" class={errorClass} role="alert"></p>
              </div>

              {shipsToBangladesh && (
                <div data-country-block={shipsAbroad ? "BD" : undefined}>
                  <LocationFields
                    cities={cities}
                    copy={copy}
                    showAreaField={lang.fieldVisibility.showAreaField}
                    errorId="shippingLocationError"
                  />
                  <p id="shippingLocationError" class={errorClass} role="alert"></p>
                </div>
              )}
              {shipsAbroad && (
                <ForeignAddressFields
                  idPrefix="checkout"
                  labels={{
                    shippingAddressLine2: copy.shippingAddressLine2Label,
                    shippingDependentLocality: copy.shippingDependentLocalityLabel,
                    shippingLocality: copy.shippingLocalityLabel,
                    shippingAdminArea: copy.shippingAdminAreaLabel,
                    shippingPostalCode: copy.shippingPostalCodeLabel,
                  }}
                  labelClass={labelClass}
                  fieldClass={fieldClass}
                  errorClass={errorClass}
                />
              )}
              </fieldset>

              <CheckoutShippingMethods
                shippingMethods={shippingMethods}
                shippingMethodLabel={copy.shippingMethodLabel}
                pickupLocationLabel={copy.pickupLocationLabel}
                modeSwitch={deliveryModeSwitch}
                freeText={copy.freeText}
                freeOverText={copy.freeOverText}
                waivedShippingFeeText={copy.waivedShippingFeeText}
                pickupFromText={copy.pickupFromText}
                pickupHoursText={copy.pickupHoursText}
                chooseAddressText={copy.chooseAddressForDeliveryText}
                noDeliveryText={copy.noDeliveryToAddressText}
                failedText={copy.deliveryOptionsFailedText}
                unavailableText={copy.deliveryOptionsUnavailableText}
                retryText={copy.retryText}
                loadingText={copy.loadingText}
                feeChangedText={copy.deliveryFeeChangedText}
                replacedText={copy.deliveryOptionReplacedText}
                replacedSameFeeText={copy.deliveryOptionReplacedSameFeeText}
                goneText={copy.deliveryOptionGoneText}
                overWeightText={copy.deliveryOverWeightText}
                overWeightNoneText={copy.deliveryOverWeightNoneText}
                itemsUnavailableText={copy.deliveryItemsUnavailableText}
                itemsUnavailableNoneText={copy.deliveryItemsUnavailableNoneText}
              />
            </section>
            <div data-buyer-ui-target="checkout.delivery.after"></div>

            {/* The billing address (Shopify's rule): asked when nothing ships, or when the merchant requires one. */}
            <BillingAddressFields
              countries={shippingCountries}
              selected={shippingCountry}
              requireFull={checkoutConfig.requireFullBillingAddress === true}
              language={checkoutLanguageBaseCode(lang.code)}
              labels={{
                heading: copy.billingHeadingText,
                sameAsShipping: copy.billingSameAsShippingText,
                help: copy.billingHelpText,
                country: copy.shippingCountryLabel,
                billingName: copy.billingNameLabel,
                billingCompany: copy.billingCompanyLabel,
                billingAddress: copy.billingAddressLabel,
                billingAddressLine2: copy.shippingAddressLine2Label,
                billingDependentLocality: copy.shippingDependentLocalityLabel,
                billingLocality: copy.shippingLocalityLabel,
                billingAdminArea: copy.shippingAdminAreaLabel,
                billingPostalCode: copy.shippingPostalCodeLabel,
              }}
              labelClass={labelClass}
              fieldClass={fieldClass}
            />

            {
              lang.fieldVisibility.showOrderNotesField && (
                <BuyerField
                  attribute={{ key: "notes", label: copy.orderNotesLabel, type: "multiline", maxLength: 500 }}
                  id="notes" name="notes" placeholder={copy.orderNotesPlaceholder} rows={2}
                  labelClass={labelClass} controlClass={`${fieldClass} h-auto min-h-16 resize-none py-2`}
                />
              )
            }

            <MarketingConsentField consent={marketingConsent} />

            <div>
              {/* A store app's rule that blocks the order (lib/cart/client.ts fills it, as text). */}
              <div
                id="cartRuleErrors"
                data-part="details-errors"
                class="mb-3 hidden rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive"
                role="alert"
                tabindex="-1"
              >
              </div>
              <p
                id="checkoutFormMessage"
                data-part="details-errors"
                class="mb-3 hidden rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive"
                role="alert"
                tabindex="-1"
              >
              </p>
              <button
                type="submit"
                class="flex h-12 w-full items-center justify-center rounded-lg bg-primary px-4 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-50"
                id="submitButton"
                data-part="details-submit"
                aria-describedby={checkoutUnavailable ? "submitButtonReason" : undefined}
                disabled
              >
                <span id="submitButtonText">
                  {isProcessing ? copy.processingText : submitLabel}
                </span>
                {/* "Place order · ৳1,500": the total the summary shows, beside the label (the cart page script fills it). */}
                <span id="submitButtonTotal" class="tabular-nums" hidden><span aria-hidden="true" class="mx-1.5">·</span><span data-amount></span></span>
              </button>
              {/* Why Place order is disabled, in the checkout language (lib/cart/checkout-button-state.ts). */}
              <p id="submitButtonReason" class="mt-2 text-center text-sm font-medium text-muted-foreground" hidden={!checkoutUnavailable}>{checkoutUnavailable ? checkoutUnavailableMessage : ""}</p>

              {
                // A cash-on-delivery-only store places the order here; a gift
                // card is used on the payment step (script only: without it
                // the field there cannot apply a card anyway).
                codPlaceable && (
                  <button
                    type="button"
                    id="giftCardCheckoutStep"
                    hidden
                    class="mt-3 inline-flex min-h-11 w-full items-center justify-center text-sm font-medium text-foreground underline underline-offset-2 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                  >
                    {giftCopy.giftCardCheckoutStepText}
                  </button>
                )
              }

              {
                // Buyers are only asked to agree to policies the store has published.
                codPlaceable && hasAgreementPolicies && (
                  <p id={codOnly ? undefined : "cashAgreement"} class="mt-3 text-center text-sm text-muted-foreground" hidden={!codOnly} data-part="legal">
                    {agreement.map((segment) =>
                      segment.href ? (
                        <a href={segment.href} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-foreground">{segment.text}</a>
                      ) : (
                        segment.text
                      ),
                    )}
                  </p>
                )
              }
            </div>
          </form>
        </div>
      </Fragment>
    </CartPageLayout>
    {/* Before first paint: the cart column sits where it shows (after the form
        on wide screens). On a phone the summary starts folded behind its
        "Show order summary" bar (Dawn's checkout), so the first screen is the
        form; the bar states the total and opens the lines. A theme's
        arrangement is read in its own order at every width: only the fold. */}
    {cartPlan.layout === null ? (
    <script is:inline set:html={CART_COLUMN_PLACE_SCRIPT} />
    ) : (
    <script is:inline set:html={CART_SUMMARY_FOLD_SCRIPT} />
    )}
    {/* A cart that needs delivery where the store delivers nowhere: the note, not the address and options. */}
    {!physicalDelivery && (
      <style is:global>
        #cartPageRoot[data-physical-delivery="none"][data-delivery-need="method"] [data-store-not-delivering] { display: block; }
        #cartPageRoot[data-physical-delivery="none"][data-delivery-need="method"] [data-delivery-section] { display: none; }
      </style>
    )}
    {/* Below lg the folded summary hides the cart (never an empty cart's message). */}
    {/* With saved lines the form is part of the first paint; the cart script
        then shows or hides it as the checked cart says. */}
    <style is:global>
      #cartPageRoot[data-cart-prepaint="items"][data-cart-state="loading"] #checkoutPanel { display: block; }
    </style>
    <style is:global>
      @media (max-width: 63.99rem) {
        #cartPageRoot[data-summary="closed"]:not([data-cart-state="empty"]) #orderSummaryBody { display: none; }
      }
    </style>
  </div>

  <TemplateSections
    template={cartTemplate}
    region="after"
    data={templateData}
    currencySymbol={layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol}
    currencyCode={layoutData?.currency?.code ?? DEFAULT_CURRENCY.code}
    preview={cartRequestTheme.preview !== null}
    languageCode={layoutData?.storefrontCopy?.languageCode}
  />
</Layout>

<CheckoutLoadingOverlay
  title={copy.processingOrderTitle}
  message={copy.processingOrderMessage}
/>

{/* The page scripts' config and copy (about 40 KB), after the content so the
    cart paints without waiting for it; only the module scripts read it. */}
<WindowGlobals values={{ __CHECKOUT_CONFIG__: checkoutConfig, __CHECKOUT_LANGUAGE__: lang }} />

<script>
  import { readBuyerAttributes } from "@/lib/buyer-ui/state";
  import { onTextEdit } from "@/lib/text-edits";
  import { buyerUiDrawn, buyerUiPending } from "@/lib/buyer-ui/lazy";
  import { checkoutText } from "@/lib/checkout-text";
  import { pagePath } from "@/lib/presence-url";
  import { loadLazyScript } from "@/scripts/lazy-script";
  import {
    initCartFunctionality,
    emitCheckoutFormSubmitted,
    isDiscountValidationPending,
    decideUndecidedCartLines,
    hasUndecidedCartLines,
    holdCheckoutButtonWhile,
    refreshCartBlockingState,
    resumeCartPageFromHistory,
    updateCheckoutButtonState,
    updateTotals,
  } from "@/lib/cart/client";
  import { getCustomerSession } from "@/lib/api/customer-session-later";
  import {
    cartShipsAllFree,
    cartShippedSubtotal,
    cartNeedsDeliveryMethod,
    cartStore,
    getEffectiveCartShippingFee,
  } from "@/store/cart";
  import { enhanceShippingMethods, fetchDeliveryRates } from "@/lib/checkout/shipping-methods";
  import {
    applyCheckoutDeliveryMode,
    checkoutTransferPath,
    readCheckoutDeliveryMode,
  } from "@/lib/checkout/delivery-mode";
  import { BILLING_ADDRESS_FIELDS, checkoutBillingFields } from "@/lib/checkout/billing-address";
  import { enhanceBillingAddress } from "@/lib/checkout/billing-address-rules";
  import { formatMoney } from "@/lib/currency";
  import { browserApiUrl } from "@/lib/api/browser-url";
  import {
    enhanceLocationSelects,
    fetchLocationOptions,
    type LocationPrefillDetail,
  } from "@/lib/checkout/location-select";
  import {
    checkoutPhoneResult,
    initCheckoutPhoneField,
    loadCheckoutPhoneValidator,
  } from "@/lib/checkout/phone-field";
  import { phoneHintCopy } from "@/lib/checkout/phone-hint";
  import {
    applyCheckoutContactNeeds,
    checkoutContactNeeds,
    offersDeferredPayment,
    readCheckoutPhoneNeed,
  } from "@/lib/checkout/contact-need";
  import type { CheckoutConfig } from "@/lib/checkout/types";
  import {
    clearCheckoutFormDraft,
    discardCheckoutFormDraftOfOtherOwner,
    readCheckoutFormDraft,
    readHostedPaymentRecoverySession,
    syncCheckoutTransferSession,
    writeCheckoutFormDraft,
    writeCheckoutTransferSession,
  } from "@/lib/checkout/session-state";
  import { rememberSubmittedCart } from "@/lib/checkout/receipt-finalization";
  import { readStoredGiftCards } from "@/lib/checkout/gift-card-storage";
  import { codPaymentStep } from "@/lib/checkout/payment-step";
  import { findNamedCheckoutControl } from "@/lib/checkout/form-controls";
  
  import { shippingCountryName } from "@/lib/checkout/shipping-country";
  import { enhanceShippingCountry } from "@/lib/checkout/country-address";
  import { addressAutocompleteService, pageLocale } from "@/lib/app-services";
  import {
    checkoutInformationFields,
    enhanceCheckoutFields,
    setFieldError,
  } from "@/lib/checkout/field-validation";
  import { createSubmit, onHistoryRestore, submitBusy, SubmitStepTimeout, withinStepLimit, type SubmitStep } from "@/lib/checkout/submit-machine";
  import type { CheckoutLanguageData as CheckoutLanguageStrings } from "@scalius/shared/checkout-language";
  import type { QuotedShippingRate } from "@/lib/checkout/tax-quote-contract";
  import type { ItemsDeliveryRefusal } from "@/lib/checkout/tax-quote-error-contract";

  type CustomerAutofillProfile = {
    customerId?: string | null;
    name?: string | null;
    phone?: string | null;
    email?: string | null;
    /** The address book's default address (a Bangladesh one fills City/Thana/Area). */
    defaultAddress?: {
      countryCode?: string | null;
      line1?: string | null;
      line2?: string | null;
      dependentLocality?: string | null;
      locality?: string | null;
      adminArea?: string | null;
      postalCode?: string | null;
      city?: string | null;
      cityName?: string | null;
      zone?: string | null;
      zoneName?: string | null;
      area?: string | null;
      areaName?: string | null;
    } | null;
  };

  /** The country select (only on a store that sells to several countries). */
  const countrySelect = () => document.querySelector<HTMLSelectElement>("select[data-shipping-country]");
  /** The countries some shipping zone serves, from the store's rates on the page. */
  const zoneCountries = (() => {
    let countries: Set<string> | undefined;
    return (): Set<string> | null => {
      if (countries) return countries;
      try {
        const rates = JSON.parse(document.querySelector("script[data-shipping-rates]")?.textContent || "[]") as Array<{
          kind?: string;
          countries?: Array<{ code?: unknown }>;
        }>;
        const read = new Set<string>();
        for (const rate of Array.isArray(rates) ? rates : []) {
          if (rate.kind === "pickup") continue;
          for (const entry of rate.countries ?? []) if (typeof entry.code === "string") read.add(entry.code);
        }
        countries = read;
        return countries;
      } catch {
        // Unreadable: no country is named as unserved.
        return null;
      }
    };
  })();
  /** The country the form posts: Bangladesh unless the store sells elsewhere and the buyer chose it. */
  const chosenShippingCountry = () =>
    findNamedCheckoutControl(document, "shippingCountryCode")?.value || "BD";
  /** Chooses a country the store sells to, as if the buyer had (the address blocks and options follow). */
  const chooseShippingCountry = (countryCode: string | null | undefined) => {
    const select = countrySelect();
    if (!select || !countryCode || select.value === countryCode) return;
    if (![...select.options].some((option) => option.value === countryCode)) return;
    select.value = countryCode;
    select.dispatchEvent(new Event("change", { bubbles: true }));
  };

  window.__scaliusCartPageAbortController?.abort();
  const cartPageAbortController = new AbortController();
  window.__scaliusCartPageAbortController = cartPageAbortController;
  const cartPageSignal = cartPageAbortController.signal;

  const meta = document.getElementById("checkout-meta");
  // A cash-on-delivery-only store places the order from this page, unless the
  // buyer brings a gift card: then the payment step (where its field is) follows.
  let codOnly = meta?.dataset.codOnly === "true";
  // A store that takes cash among other methods (a cash-only store always places it here).
  const codPlaceable = codOnly || meta?.dataset.codPlaceable === "true";
  const checkoutUnavailable = meta?.dataset.checkoutUnavailable === "true";
  const guestCheckoutEnabled = meta?.dataset.guestCheckoutEnabled !== "false"; // default true
  // The frontmatter always serializes a fully resolved language (English
  // fallback included), so the browser never ships the default copy tables.
  const checkoutCopy = (
    window.__CHECKOUT_LANGUAGE__ as { languageData: CheckoutLanguageStrings }
  ).languageData;
  const checkoutUnavailableMessage =
    meta?.dataset.checkoutUnavailableMessage ||
    checkoutCopy.checkoutUnavailableMessage;

  const runWhenDomReady = (callback: () => void | Promise<void>) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => void callback(), {
        once: true,
        signal: cartPageSignal,
      });
      return;
    }

    void callback();
  };

  const isSignedIn = () =>
    document.cookie.split(";").some((c) => c.trim().startsWith("cs_auth=1"));
  const ownerOf = (customer: CustomerAutofillProfile) =>
    customer.customerId || customer.email || "customer";

  // A draft written by a guest (or another account) never follows a signed-in
  // buyer, and a signed-in buyer's draft never outlives their sign-out.
  if (!isSignedIn()) discardCheckoutFormDraftOfOtherOwner("guest");

  initCheckoutPhoneField(cartPageSignal, { copy: phoneHintCopy(checkoutCopy) });

  void initCartFunctionality();

  // Wired after the cart runtime so its listeners receive the initial
  // delivery-method and location events. The delivery options follow the
  // address, so they are wired first and re-read on every location change.
  const shippingMethods = enhanceShippingMethods(document, {
    loadRates: (address) => fetchDeliveryRates(browserApiUrl(""), address),
    readDraftMethod: () => readCheckoutFormDraft()?.shippingLocation,
    readSubtotal: () => cartShippedSubtotal(cartStore.get().items),
    readCartKey: () => JSON.stringify(Object.entries(cartStore.get().items).map(([key, item]) => [key, item.quantity])),
    isFeeWaived: () => cartShipsAllFree(cartStore.get().items),
    formatMoney,
    readMode: () => readCheckoutDeliveryMode(),
    // A country no shipping zone serves says so by name (MARKETS-DESIGN step 3b).
    readNoDeliveryReason: () => {
      const countryCode = chosenShippingCountry();
      const served = zoneCountries();
      return countryCode === "BD" || !served || served.has(countryCode)
        ? null
        : checkoutText(checkoutCopy.deliveryCountryUnavailableText, {
            country: shippingCountryName(countryCode, document.documentElement.lang || "en"),
          });
    },
    signal: cartPageSignal,
  });

  // The checkout path follows the cart (nothing physical: no delivery
  // section) and the buyer's Delivery/Pickup choice; the address fields are
  // left out of the form unless delivering.
  // Customer accounts' opt-in: a cart of digital or service lines may go
  // without a phone (email is then required). Off: the page stays as rendered.
  const contactConfig = window.__CHECKOUT_CONFIG__ as CheckoutConfig | undefined;
  // Settings → Checkout: every order asks for a full billing address (Shopify's option).
  const requireFullBillingAddress = contactConfig?.requireFullBillingAddress === true;
  const syncContactNeeds = () => {
    const identity = contactConfig?.customerIdentity;
    if (!identity?.phoneOptionalForDigital) return;
    // An order with nothing to ship is placed in its billing country.
    const orderCountry = findNamedCheckoutControl(document, "billingCountryCode")?.value || null;
    applyCheckoutContactNeeds(checkoutContactNeeds({
      identity,
      lines: Object.values(cartStore.get().items),
      cashEnabled: (contactConfig?.gateways ?? []).some((gateway) => gateway.flow === "cod"),
      // A pay-later method always needs a phone (the server refuses it without one).
      deferredEnabled: offersDeferredPayment(contactConfig?.gateways ?? []),
      partialPaymentEnabled: contactConfig?.partialPaymentEnabled === true,
      // A cart that ships is placed where it goes; the rule then needs a phone anyway.
      countryCode: readCheckoutDeliveryMode() === "none" ? orderCountry : null,
    }));
  };
  const syncDeliveryPath = () => {
    const root = document.getElementById("cartPageRoot");
    const { items } = cartStore.get();
    const need = Object.keys(items).length === 0 || cartNeedsDeliveryMethod(items) ? "method" : "none";
    if (root && root.dataset.deliveryNeed !== need) root.dataset.deliveryNeed = need;
    void shippingMethods?.setMode(applyCheckoutDeliveryMode(document));
    // An option these items couldn't take is offered again once the items change.
    void shippingMethods?.cartChanged();
    syncContactNeeds();
  };
  syncDeliveryPath();
  document.addEventListener("cart-updated", syncDeliveryPath, { signal: cartPageSignal });
  // The billing country's rules (full, or the minimal region and postal code)
  // follow the country and the path.
  const billingAddress = enhanceBillingAddress(document, {
    readMode: () => (requireFullBillingAddress ? "full" : "minimal"),
    signal: cartPageSignal,
  });
  document.getElementById("checkoutForm")?.addEventListener(
    "change",
    (event) => {
      const name = (event.target as HTMLInputElement | null)?.name;
      if (name === "deliveryMode") syncDeliveryPath();
      // A cart with nothing physical is taxed at its billing country, region
      // and postal code, and placed in that country (the contact rule reads it).
      if (name === "billingCountryCode" || name === "billingAdminArea" || name === "billingPostalCode") {
        if (name === "billingCountryCode") syncContactNeeds();
        if (readCheckoutDeliveryMode() === "none") void updateTotals();
      }
    },
    { signal: cartPageSignal },
  );
  window.addEventListener(
    "delivery-rate-changed",
    () => void shippingMethods?.recheck(),
    { signal: cartPageSignal },
  );
  // The detail's `shippingRates` are the options still offered when a store
  // app hid the chosen one (null: re-read the store's own).
  window.addEventListener(
    "delivery-rate-rejected",
    (event) => {
      const detail = (event as CustomEvent<{ shippingRates?: QuotedShippingRate[] | null; forItems?: ItemsDeliveryRefusal | null } | null>).detail;
      void shippingMethods?.rejectSelected(detail?.shippingRates ?? null, detail?.forItems ?? null);
    },
    { signal: cartPageSignal },
  );
  // Whether this address and cart have a delivery option decides Place order.
  window.addEventListener("delivery-availability-change", () => updateCheckoutButtonState(), { signal: cartPageSignal });
  // Each quote says which options a store app changed for this cart (null: none).
  window.addEventListener(
    "delivery-rates-quoted",
    (event) =>
      shippingMethods?.applyQuotedRates(
        (event as CustomEvent<{ shippingRates?: QuotedShippingRate[] | null } | null>).detail?.shippingRates ?? null,
      ),
    { signal: cartPageSignal },
  );
  const locationRoot = document.querySelector<HTMLElement>("[data-location-fields]");
  const locationSelects = locationRoot
    ? enhanceLocationSelects(locationRoot, {
        load: (level, parentId) =>
          fetchLocationOptions(browserApiUrl(""), level, parentId),
        onChange: (detail) => {
          window.dispatchEvent(
            new CustomEvent("checkout-location-change", { detail }),
          );
          void shippingMethods?.setAddress(detail);
        },
        signal: cartPageSignal,
      })
    : null;
  // An address already in the form (restored by the browser) gets its rates too.
  const formLocation = (name: string) => findNamedCheckoutControl(document, name)?.value ?? "";
  // Another country's shipping zone matches on its region and postal code.
  const formAddress = () => chosenShippingCountry() === "BD"
    ? { cityId: formLocation("city"), zoneId: formLocation("zone"), areaId: formLocation("area") }
    : {
        countryCode: chosenShippingCountry(),
        cityId: "",
        zoneId: "",
        areaId: "",
        adminArea: formLocation("shippingAdminArea").trim(),
        postalCode: formLocation("shippingPostalCode").trim(),
      };
  void shippingMethods?.setAddress(formAddress());
  countrySelect()?.addEventListener(
    "change",
    () => void shippingMethods?.setAddress(formAddress()),
    { signal: cartPageSignal },
  );
  // A region or postal code entered: re-read the zone's options once the field is left.
  for (const name of ["shippingAdminArea", "shippingPostalCode"]) {
    findNamedCheckoutControl(document, name)?.addEventListener(
      "change",
      () => void shippingMethods?.setAddress(formAddress()),
      { signal: cartPageSignal },
    );
  }
  window.addEventListener(
    "location-prefill",
    (event) =>
      void locationSelects?.prefill(
        (event as CustomEvent<LocationPrefillDetail>).detail ?? {},
      ),
    { signal: cartPageSignal },
  );
  // The merchant removed the city, thana or area the buyer chose: clear it,
  // list the level again without it, and say so once, at that field. The
  // totals follow the cleared address like any other change.
  window.addEventListener(
    "delivery-location-unavailable",
    (event) => {
      const field = (event as CustomEvent<{ field?: string }>).detail?.field;
      if (field !== "city" && field !== "zone" && field !== "area") return;
      const control = document.getElementById(`checkout-${field}`);
      const error = document.getElementById("shippingLocationError");
      if (control && error) {
        setFieldError({ control, error }, field === "city"
          ? checkoutCopy.cityUnavailableText
          : field === "zone" ? checkoutCopy.thanaUnavailableText : checkoutCopy.areaUnavailableText);
      }
      void locationSelects?.forget(field);
    },
    { signal: cartPageSignal },
  );

  const unsubscribeShippingFees = cartStore.subscribe(() =>
    shippingMethods?.refreshFees(),
  );
  cartPageSignal.addEventListener("abort", unsubscribeShippingFees, {
    once: true,
  });

  // ── Draft and account prefill ─────────────────────────────────────────────

  const buyerEditedFields = new Set<string>();
  const contactFields = ["customerName", "customerEmail", "shippingAddress", "notes"] as const;

  const setFieldValue = (name: string, value: string | null | undefined, overwrite: boolean) => {
    const el = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
    if (el && (overwrite || (!el.value && value))) el.value = value ?? "";
  };

  /** Empty fields take the account's saved details; the buyer's own edits win. */
  const fillBasicCustomerFields = (customer: CustomerAutofillProfile, overwrite = false) => {
    const draft = overwrite ? null : readCheckoutFormDraft();
    const pick = (field: keyof NonNullable<typeof draft>, fallback?: string | null) =>
      draft && field in draft ? draft[field] : fallback;
    if (!buyerEditedFields.has("customerName")) setFieldValue("customerName", pick("customerName", customer.name), overwrite);
    if (!buyerEditedFields.has("customerEmail")) setFieldValue("customerEmail", pick("customerEmail", customer.email), overwrite);
    const saved = customer.defaultAddress ?? null;
    // A saved address in another country fills only where the store sells there.
    const savedCountry = saved?.countryCode || "BD";
    const savedFits = savedCountry === "BD" ? !countrySelect() || [...countrySelect()!.options].some((option) => option.value === "BD")
      : Boolean(countrySelect() && [...countrySelect()!.options].some((option) => option.value === savedCountry));
    if (savedFits && !buyerEditedFields.has("shippingCountryCode") && !(draft && "shippingCountryCode" in draft)) {
      chooseShippingCountry(savedCountry);
    }
    if (!buyerEditedFields.has("shippingAddress")) setFieldValue("shippingAddress", pick("shippingAddress", savedFits ? saved?.line1 : null), overwrite);
    if (savedFits && savedCountry !== "BD") {
      const foreign = {
        shippingAddressLine2: saved?.line2,
        shippingDependentLocality: saved?.dependentLocality,
        shippingLocality: saved?.locality,
        shippingAdminArea: saved?.adminArea,
        shippingPostalCode: saved?.postalCode,
      } as const;
      for (const [field, value] of Object.entries(foreign)) {
        if (!buyerEditedFields.has(field)) setFieldValue(field, pick(field as keyof NonNullable<typeof draft>, value), overwrite);
      }
    }
    const phone = pick("customerPhone", customer.phone);
    if (phone && !buyerEditedFields.has("customerPhone")) {
      // The field validates the profile phone against the store's policy.
      window.dispatchEvent(new CustomEvent("phone-prefill", { detail: phone }));
    }
  };

  const checkoutDraftFields = [
    "customerName",
    "customerPhone",
    "customerEmail",
    "deliveryMode",
    "shippingCountryCode",
    "shippingAddress",
    "shippingAddressLine2",
    "shippingDependentLocality",
    "shippingLocality",
    "shippingAdminArea",
    "shippingPostalCode",
    "city",
    "cityName",
    "zone",
    "zoneName",
    "area",
    "areaName",
    "shippingLocation",
    "notes",
  ] as const;

  let latestDraftLocation: {
    city?: string;
    cityName?: string;
    zone?: string;
    zoneName?: string;
    area?: string;
    areaName?: string;
  } = {};
  const readCheckoutFormValues = (captureAllFields = false) => {
    const draft = readCheckoutFormDraft();
    const values: Record<string, string> = {};
    for (const field of checkoutDraftFields) {
      const input = findNamedCheckoutControl(document, field);
      const inputValue =
        field === "customerPhone" &&
        input instanceof HTMLInputElement &&
        input.dataset.e164Value !== undefined
          ? input.dataset.e164Value
          : input?.value;
      // Initialization may snapshot empty controls before account prefill.
      // Only buyer edits or an explicit submit give those blanks draft ownership.
      if (
        !inputValue &&
        !buyerEditedFields.has(field) &&
        (!captureAllFields || (
          field === "customerPhone" && draft &&
          Object.prototype.hasOwnProperty.call(draft, field)
        ))
      ) {
        if (draft && field in draft) values[field] = draft[field] ?? "";
      } else if (input) values[field] = inputValue ?? "";
      else if (draft && field in draft) values[field] = draft[field] ?? "";
    }
    Object.assign(values, latestDraftLocation);
    return values;
  };

  const syncExistingCheckoutTransfer = (values: Record<string, string>) => {
    const cartItems = (
      document.getElementById("cartItemsInput") as HTMLInputElement | null
    )?.value;
    const checkoutId = (
      document.getElementById("checkoutIdInput") as HTMLInputElement | null
    )?.value;
    const discountCodes = (
      document.getElementById("discountCodesInput") as HTMLInputElement | null
    )?.value;
    const expectedQuoteFingerprint = (
      document.getElementById("expectedQuoteFingerprint") as HTMLInputElement | null
    )?.value;
    // The path the page shows decides what the transfer carries, as on
    // submit: a cart with nothing physical keeps no address and no rate,
    // whatever a hidden Delivery radio or a saved draft still holds.
    const mode = readCheckoutDeliveryMode();
    const path = checkoutTransferPath(mode, { ...values, shippingCountryCode: chosenShippingCountry() });
    const shippingMethodId = window.lastShippingEventDetail?.id;
    const shippingMethodName = window.lastShippingEventDetail?.name;
    let shippingCharge = "";
    if (cartItems && window.lastShippingEventDetail) {
      try {
        shippingCharge = String(
          getEffectiveCartShippingFee(
            JSON.parse(cartItems),
            window.lastShippingEventDetail.fee,
            window.lastShippingEventDetail.freeOver,
            window.lastShippingEventDetail.quoted,
          ),
        );
      } catch {
        shippingCharge = "";
      }
    }
    syncCheckoutTransferSession({
      ...values,
      ...path,
      ...(cartItems ? { cartItems } : {}),
      ...(checkoutId ? { checkoutId } : {}),
      ...(discountCodes !== undefined ? { discountCodes } : {}),
      ...(expectedQuoteFingerprint ? { expectedQuoteFingerprint } : {}),
      ...(mode === "none"
        ? { shippingMethodId: null, shippingMethodName: null, shippingLocation: null, shippingCharge: "0" }
        : {
          ...(shippingMethodId ? { shippingMethodId } : {}),
          ...(shippingMethodName ? { shippingMethodName } : {}),
          ...(shippingCharge ? { shippingCharge } : {}),
        }),
    });
  };

  const persistCheckoutFormDraftNow = (captureAllFields = false) => {
    const values = readCheckoutFormValues(captureAllFields);
    writeCheckoutFormDraft(values);
    syncExistingCheckoutTransfer(values);
  };

  let draftWriteTimer: number | null = null;
  const persistCheckoutFormDraft = () => {
    if (draftWriteTimer !== null) window.clearTimeout(draftWriteTimer);
    draftWriteTimer = window.setTimeout(() => {
      draftWriteTimer = null;
      persistCheckoutFormDraftNow();
    }, 120);
  };

  document.addEventListener(
    "astro:before-swap",
    () => {
      if (draftWriteTimer !== null) {
        window.clearTimeout(draftWriteTimer);
        draftWriteTimer = null;
      }
      persistCheckoutFormDraftNow();
      cartPageAbortController.abort();
    },
    { once: true, signal: cartPageSignal },
  );

  // A signed-in buyer's draft is restored only once the account confirms it is theirs.
  const restoreCheckoutFormDraft = (ownerVerified = !isSignedIn()) => {
    const draft = ownerVerified ? readCheckoutFormDraft() : null;
    if (!draft) return;
    chooseShippingCountry(draft.shippingCountryCode);
    for (const field of contactFields) setFieldValue(field, draft[field], false);
    for (const field of ["shippingAddressLine2", "shippingDependentLocality", "shippingLocality", "shippingAdminArea", "shippingPostalCode"] as const) {
      setFieldValue(field, draft[field], false);
    }
    if (draft.customerPhone) {
      window.dispatchEvent(
        new CustomEvent("phone-prefill", { detail: draft.customerPhone }),
      );
    }
  };

  /** Clears every contact and address field (another person's draft, or sign-out). */
  const clearCustomerFields = () => {
    for (const field of contactFields) setFieldValue(field, "", true);
    const phone = document.getElementById("customerPhone-input") as HTMLInputElement | null;
    if (phone) phone.value = "";
    buyerEditedFields.clear();
  };

  runWhenDomReady(() => {
    restoreCheckoutFormDraft();
    const form = document.getElementById("checkoutForm");
    const handleBuyerFieldEdit = (event: Event) => {
      const input = event.target;
      if (
        event.isTrusted &&
        (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement || input instanceof HTMLSelectElement)
      ) {
        const field = input.id === "customerPhone-input" ? "customerPhone" : input.name;
        if (checkoutDraftFields.some((name) => name === field)) {
          buyerEditedFields.add(field);
        }
      }
      persistCheckoutFormDraft();
    };
    if (form) onTextEdit(form, handleBuyerFieldEdit, { signal: cartPageSignal });
    form?.addEventListener("change", handleBuyerFieldEdit, {
      signal: cartPageSignal,
    });
    window.addEventListener(
      "checkout-location-change",
      (event) => {
        const detail = (event as CustomEvent<Record<string, unknown>>).detail;
        latestDraftLocation = {
          city: typeof detail?.cityId === "string" ? detail.cityId : "",
          cityName: typeof detail?.cityName === "string" ? detail.cityName : "",
          zone: typeof detail?.zoneId === "string" ? detail.zoneId : "",
          zoneName: typeof detail?.zoneName === "string" ? detail.zoneName : "",
          area: typeof detail?.areaId === "string" ? detail.areaId : "",
          areaName: typeof detail?.areaName === "string" ? detail.areaName : "",
        };
        persistCheckoutFormDraft();
      },
      { signal: cartPageSignal },
    );
    window.addEventListener("shippingLocationChange", persistCheckoutFormDraft, {
      signal: cartPageSignal,
    });
    window.addEventListener(
      "pagehide",
      () => persistCheckoutFormDraftNow(),
      { signal: cartPageSignal },
    );
    document.addEventListener("cart-updated", persistCheckoutFormDraft, {
      signal: cartPageSignal,
    });

    const draft = isSignedIn() ? null : readCheckoutFormDraft();
    if (draft?.city || draft?.cityName) {
      void locationSelects?.prefill({
        city: draft.city,
        cityName: draft.cityName,
        zone: draft.zone,
        zoneName: draft.zoneName,
        area: draft.area,
        areaName: draft.areaName,
      });
    }
  });

  // City/Zone/Area for a signed-in customer.
  const fillLocationDropdowns = (customer: CustomerAutofillProfile, overwrite = false) => {
    try {
      if (!overwrite && (latestDraftLocation.city || latestDraftLocation.cityName)) return;
      const draft = overwrite ? null : readCheckoutFormDraft();
      const draftOwnsLocation = Boolean(
        draft && ["city", "cityName", "zone", "zoneName", "area", "areaName"]
          .some((field) => Object.prototype.hasOwnProperty.call(draft, field)),
      );
      const preferred = draftOwnsLocation
        ? {
            city: draft?.city,
            cityName: draft?.cityName,
            zone: draft?.zone,
            zoneName: draft?.zoneName,
            area: draft?.area,
            areaName: draft?.areaName,
          }
        // The default address fills City/Thana/Area only when it is in Bangladesh.
        : (customer.defaultAddress?.countryCode ?? "BD") === "BD" ? customer.defaultAddress : null;
      if (!preferred?.cityName && !preferred?.city) return;
      if (!overwrite) {
        const existingCity =
          document.querySelector<HTMLSelectElement>('select[name="city"]')?.value;
        const existingZone =
          document.querySelector<HTMLSelectElement>('select[name="zone"]')?.value;
        if (existingCity || existingZone) return;
      }
      window.dispatchEvent(
        new CustomEvent("location-prefill", {
          detail: {
            city: preferred.city,
            cityName: preferred.cityName,
            zone: preferred.zone,
            zoneName: preferred.zoneName,
            area: preferred.area,
            areaName: preferred.areaName,
          },
        }),
      );
    } catch (err: unknown) {
      console.error("Cart autofill location err:", err);
    }
  };

  // The cash order was refused for a session that ended during the press:
  // sign in here, then press again on this cart (the auth modal loads on the event).
  if (meta?.dataset.signInRequired === "true") {
    const openSignIn = () => window.dispatchEvent(new CustomEvent("open-auth-modal"));
    if (document.readyState === "complete") openSignIn();
    else window.addEventListener("load", openSignIn, { once: true, signal: cartPageSignal });
  }

  const revealCheckoutFormForCustomer = () => {
    document.getElementById("checkoutSignInPrompt")?.classList.add("hidden");
    document.getElementById("checkoutFormCard")?.classList.remove("hidden");
  };

  // 1. Page load: a signed-in buyer's empty fields take their saved details.
  runWhenDomReady(async () => {
    if (!isSignedIn() && guestCheckoutEnabled) return;
    const session = await getCustomerSession();
    if (session.unavailable) {
      console.warn(
        "Customer session autofill skipped:",
        session.error || "Account status could not be read.",
      );
      return;
    }
    if (session?.authenticated && session.customer) {
      discardCheckoutFormDraftOfOtherOwner(ownerOf(session.customer));
      restoreCheckoutFormDraft(true);
      fillBasicCustomerFields(session.customer);
      fillLocationDropdowns(session.customer);
      revealCheckoutFormForCustomer();
    } else if (discardCheckoutFormDraftOfOtherOwner("guest")) {
      clearCustomerFields();
    }
  });

  // 2. Signing in from checkout: the account's details replace what was typed
  // before (possibly someone else's), and the cart stays.
  window.addEventListener(
    "customer-login",
    ((e: CustomEvent<CustomerAutofillProfile>) => {
      if (cartPageSignal.aborted) return;
      const customer = e.detail;
      clearCheckoutFormDraft();
      discardCheckoutFormDraftOfOtherOwner(ownerOf(customer));
      buyerEditedFields.clear();
      fillBasicCustomerFields(customer, true);
      fillLocationDropdowns(customer, true);
      revealCheckoutFormForCustomer();
      persistCheckoutFormDraftNow();
    }) as EventListener,
    { signal: cartPageSignal },
  );

  // 3. Signing out: the next person on this phone sees an empty form.
  window.addEventListener(
    "customer-logout",
    () => {
      clearCheckoutFormDraft();
      discardCheckoutFormDraftOfOtherOwner("guest");
      clearCustomerFields();
    },
    { signal: cartPageSignal },
  );

  // ── Submit ──
  // One press runs the checks below in order on the submit machine
  // (lib/checkout/submit-machine.ts). A wait is a step of the same press,
  // which then reads the page again from the top; the account and a cash
  // order's cart are checked once per press.

  runWhenDomReady(() => {
    const form = document.getElementById("checkoutForm") as HTMLFormElement;
    const submitButton = document.getElementById(
      "submitButton",
    ) as HTMLButtonElement;
    const submitButtonText = document.getElementById("submitButtonText");
    const isCartEmpty = () => {
      const input = document.getElementById(
        "cartItemsInput",
      ) as HTMLInputElement;
      return !input?.value || input.value === "{}" || input.value === "[]";
    };

    // What a press does: the server's words until the quote decides (cash here, or the payment step).
    let submitLabel = submitButtonText?.textContent?.trim() || checkoutCopy.placeOrderText;
    const checkoutFormMessage = document.getElementById("checkoutFormMessage");

    // The order total rides on the phone summary bar and beside the button's
    // label ("Place order · ৳1,500"), as the summary shows it: an amount only,
    // never "—" or "Calculating…", and not while the button says something else.
    const totalNode = document.getElementById("total");
    const submitTotal = document.getElementById("submitButtonTotal");
    const summaryBarTotal = document.getElementById("orderSummaryToggleTotal");
    let submitShowsLabel = true;
    // The total as the buyer last saw it beside Place order (an amount, never "Calculating…").
    let lastShownTotal = "";
    const syncOrderTotal = () => {
      const text = totalNode?.textContent?.trim() ?? "";
      const amount = /\p{Nd}/u.test(text) ? text : "";
      if (amount) lastShownTotal = amount;
      if (summaryBarTotal && summaryBarTotal.textContent !== amount) summaryBarTotal.textContent = amount;
      const amountSlot = submitTotal?.querySelector("[data-amount]");
      if (amountSlot && amountSlot.textContent !== amount) amountSlot.textContent = amount;
      if (submitTotal) submitTotal.hidden = !amount || !submitShowsLabel || checkoutUnavailable;
    };
    if (totalNode) {
      const totalWatch = new MutationObserver(syncOrderTotal);
      totalWatch.observe(totalNode, { childList: true, characterData: true, subtree: true });
      cartPageSignal.addEventListener("abort", () => totalWatch.disconnect(), { once: true });
    }
    syncOrderTotal();

    const stepText: Partial<Record<SubmitStep, string>> = {
      account: checkoutCopy.checkingAccountText,
      quote: checkoutCopy.calculatingText,
      cart: checkoutCopy.checkingCartText,
    };
    const submit = createSubmit({
      button: submitButton,
      label: submitButtonText,
      labelText: () => submitLabel,
      text: (state) =>
        state.status === "validating"
          ? stepText[state.step!] ?? null
          : state.status === "placing"
            ? checkoutCopy.processingText
            : state.status === "redirecting"
              ? checkoutCopy.redirectingToPaymentText
              : null,
      ready: updateCheckoutButtonState,
      rendered: (showsLabel) => {
        submitShowsLabel = showsLabel;
        syncOrderTotal();
      },
    });
    holdCheckoutButtonWhile(() => submitBusy(submit.state.status));

    // Gift cards are applied on the payment step: a COD-only store sends a
    // buyer who has one (or already applied one) there instead of placing
    // the order from this page.
    // A store that takes cash among other methods places it here too when this
    // buyer's quote leaves cash alone (a guest is never offered the invoice):
    // no payment step that offers one choice.
    const giftCardStep = document.getElementById("giftCardCheckoutStep") as HTMLButtonElement | null;
    const paymentStepInput = form.querySelector<HTMLInputElement>('input[name="paymentStep"]');
    const quoteFingerprint = document.getElementById("expectedQuoteFingerprint") as HTMLInputElement | null;
    const storeCodOnly = codOnly;
    let giftCardChosen = readStoredGiftCards().length > 0;
    let quotedPaymentMethods: readonly string[] | null = null;
    const refreshPaymentStep = () => {
      // Nothing to decide: the store takes no cash here (or checkout is closed).
      if (!codPlaceable) return;
      const placesCash = codPaymentStep({
        storeCodOnly,
        codPlaceable,
        giftCardChosen,
        quotedMethods: /^taxq_/.test(quoteFingerprint?.value ?? "") ? quotedPaymentMethods : null,
      });
      if (placesCash === codOnly && giftCardStep?.hidden === !placesCash) return;
      codOnly = placesCash;
      if (meta) meta.dataset.codOnly = placesCash ? "true" : "false";
      if (paymentStepInput) paymentStepInput.value = placesCash && !storeCodOnly ? "skipped" : "";
      if (giftCardStep) giftCardStep.hidden = !placesCash;
      document.getElementById("cashAgreement")?.toggleAttribute("hidden", !placesCash);
      document.querySelectorAll<HTMLElement>("[data-checkout-payment-step]").forEach((step) => step.toggleAttribute("hidden", placesCash));
      refreshCartBlockingState();
      submitLabel = placesCash ? checkoutCopy.placeOrderText : checkoutCopy.continueToPaymentText;
      submit.render();
    };
    giftCardStep?.addEventListener("click", () => {
      // The cart no longer needs cash to pay: the payment step takes the card.
      giftCardChosen = true;
      refreshPaymentStep();
    }, { signal: cartPageSignal });
    window.addEventListener("cart-quote-payment-methods", (event) => {
      // A quote's methods, or null: the totals settled on an estimate (no address yet).
      quotedPaymentMethods = (event as CustomEvent<readonly string[] | null>).detail;
      refreshPaymentStep();
      // Decided: the progress row shows, its space kept until now, so nothing shifts.
      document.querySelectorAll<HTMLElement>("[data-checkout-progress-pending]").forEach((row) => {
        row.classList.remove("invisible");
        row.removeAttribute("data-checkout-progress-pending");
      });
    }, { signal: cartPageSignal });
    refreshPaymentStep();

    const showCheckoutFormError = (message: string, focusTarget?: HTMLElement | null) => {
      if (!checkoutFormMessage) return;
      checkoutFormMessage.textContent = message;
      checkoutFormMessage.classList.remove("hidden");
      checkoutFormMessage.scrollIntoView?.({ behavior: "smooth", block: "center" });
      (focusTarget ?? checkoutFormMessage).focus({ preventScroll: true });
    };

    const clearCheckoutFormError = () => {
      if (!checkoutFormMessage) return;
      checkoutFormMessage.textContent = "";
      checkoutFormMessage.classList.add("hidden");
    };

    updateCheckoutButtonState();
    document.addEventListener("cart-updated", updateCheckoutButtonState, {
      signal: cartPageSignal,
    });
    document.addEventListener("discount-validation-state", updateCheckoutButtonState, {
      signal: cartPageSignal,
    });

    if (!form || !submitButton) return;

    onHistoryRestore(() => {
      currentPress = null;
      submit.move("reset");
      return resumeCartPageFromHistory();
    }, cartPageSignal);

    const fields = enhanceCheckoutFields(
      checkoutInformationFields(form, checkoutCopy, () => readCheckoutDeliveryMode(), () => billingAddress?.readRules() ?? null),
      cartPageSignal,
    );
    // A restored draft never blurred: say now if a typed value (an email) is wrong.
    fields.checkFilled();
    // New delivery options (or none read): a "Choose a delivery option." from an
    // earlier attempt follows them instead of standing beside a load failure.
    window.addEventListener("shippingLocationChange", () => fields.recheckMarked(), { signal: cartPageSignal });

    /**
     * Marks every problem under its field at once, then moves to the first
     * one (the phone field reports its own message in place).
     */
    const validateInformation = (): boolean => {
      const firstField = fields.validateAll();
      const phone = checkoutPhoneResult();
      // An empty phone is fine when this cart may go without one (a typed one must still be valid).
      const phoneMessage = phone.ok || (phone.message === "required" && readCheckoutPhoneNeed() === "optional")
        ? ""
        : phone.message === "required"
          ? checkoutCopy.phoneRequiredText
          : phone.message === "country"
            ? checkoutCopy.phoneCountryNotAcceptedText
            : phone.message === "invalid"
              ? checkoutCopy.phoneIntlInvalidText
              : checkoutCopy.phoneInvalidText;
      if (phoneMessage) {
        window.dispatchEvent(new CustomEvent("phone-validation-error", {
          detail: { name: "customerPhone", message: phoneMessage, focus: false },
        }));
      }
      const phoneInput = document.getElementById("customerPhone-input");
      const nameInput = document.getElementById("customerName");
      // Visual order: name, phone, then the rest.
      let first: HTMLElement | null = firstField;
      if (phoneMessage && phoneInput && (!first || first !== nameInput)) first = phoneInput;
      // Delivery options that couldn't be read leave nothing to choose: their
      // note says so; the order waits on its Try again.
      if (!first && readCheckoutDeliveryMode() !== "none") {
        first = document.querySelector<HTMLElement>('[data-shipping-methods][data-rates-failed="true"] [data-shipping-note] button');
      }
      if (!first) return true;
      first.scrollIntoView?.({ behavior: "smooth", block: "center" });
      const focusable = first.matches("fieldset")
        ? first.querySelector<HTMLElement>("input:checked, input")
        : first;
      focusable?.focus({ preventScroll: true });
      return false;
    };

    /**
     * What a press confirmed: the total beside the button and what the button
     * meant (cash placed here, or the payment step). A different total is shown
     * and confirmed again, never placed (shipping-profiles QA D5); a quote that
     * changes how this buyer pays stops the press, and the buyer presses again
     * on the screen that shows it.
     */
    type Press = { total: string; placesCash: boolean; accountChecked: boolean; cartChecked: boolean };

    // The press whose checks may still act: a later press, or Back/Forward, ends an earlier one.
    let currentPress: Press | null = null;
    class PressSuperseded extends Error {}
    /** A check's answer for `press`, within the step limit (`bounded` false: the buyer's own choice). */
    async function answer<T>(press: Press, work: Promise<T> | T, bounded = true): Promise<T> {
      const value = await (bounded ? withinStepLimit(Promise.resolve(work)) : work);
      if (currentPress !== press) throw new PressSuperseded();
      return value;
    }

    /** The press ends here (the page says why where it belongs): false, the press is over. */
    const fail = (reason: string, message?: string, focus?: HTMLElement | null) => {
      submit.move("fail", { reason });
      if (message) showCheckoutFormError(message, focus ?? submitButton);
      return false;
    };
    const paymentChanged = (press: Press) => {
      if (codOnly === press.placesCash) return false;
      fail("payment_changed");
      submitButton.focus({ preventScroll: true });
      return true;
    };

    /** One reading of the page for the press: true when it waited and reads the page again. */
    const checkPress = async (press: Press): Promise<boolean> => {
      clearCheckoutFormError();
      if (buyerUiPending()) {
        // An app's fields are still loading: check their answers once they are drawn.
        submit.move("step", { step: "buyer_ui" });
        await answer(press, buyerUiDrawn());
        return true;
      }
      for (const control of document.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[data-buyer-attribute]")) {
        if (!control.reportValidity()) return fail("attributes");
      }
      if (isDiscountValidationPending()) return fail("discount_pending");
      if (checkoutPhoneResult().pending) {
        // Numbers outside the Bangladesh-mobile fast path need the full validator first.
        submit.move("step", { step: "phone" });
        await answer(press, loadCheckoutPhoneValidator());
        return true;
      }
      if (checkoutUnavailable) return fail("unavailable", checkoutUnavailableMessage);

      const pendingCheckout = readHostedPaymentRecoverySession();
      const checkoutId = form.querySelector<HTMLInputElement>('[name="checkoutId"]')?.value;
      if (pendingCheckout?.checkoutId && pendingCheckout.checkoutId === checkoutId) {
        return fail("existing_checkout", checkoutCopy.reviewExistingCheckoutText, document.getElementById("checkoutRecoveryLink"));
      }

      // Guest checkout off: the press checks the account once.
      if (!guestCheckoutEnabled && !press.accountChecked) {
        submit.move("step", { step: "account" });
        const session = await answer(press, getCustomerSession());
        if (isDiscountValidationPending()) return fail("discount_pending");
        if (session.unavailable) return fail("account_unavailable", session.error || checkoutCopy.accountUnavailableText);
        if (!session.authenticated) {
          fail("signed_out");
          window.dispatchEvent(new CustomEvent("open-auth-modal"));
          return false;
        }
        press.accountChecked = true;
        if (codOnly) return true;
      }

      if (isCartEmpty()) return fail("cart_empty", checkoutCopy.cartEmptyErrorText);

      // Persist the current DOM immediately so explicit empty edits replace
      // older draft values before any async validation or navigation.
      persistCheckoutFormDraftNow(true);

      if (!validateInformation()) return fail("information");
      const phoneValidation = checkoutPhoneResult();

      const quoted = () => /^taxq_[A-Za-z0-9_-]{22}$/.test(quoteFingerprint?.value ?? "");
      if (codOnly && !quoted()) {
        // A thana chosen a moment ago: its options and total are on their
        // way. Wait for them and place the order the buyer sees (buyer QA M6),
        // deciding on that quote (it may add a method: the payment step follows).
        submit.move("step", { step: "quote" });
        await answer(press, shippingMethods?.settled());
        await answer(press, window.cartTotalsSettled?.());
        refreshPaymentStep();
        if (paymentChanged(press)) return false;
        if (quoted()) return true;
        // Still no total: said here, on the page the buyer is on.
        return fail("total_unverified", checkoutCopy.taxVerificationFailedText);
      }

      if (!press.cartChecked) {
        submit.move("step", { step: "cart" });
        // A quote still on its way (an address changed a moment ago) decides
        // how this buyer pays, as it does before the payment step: wait for
        // it, then place cash only if that fresh quote leaves cash alone.
        await answer(press, shippingMethods?.settled());
        await answer(press, window.cartTotalsSettled?.());
        refreshPaymentStep();
        if (paymentChanged(press)) return false;
        if (codOnly && !quoted()) return fail("total_unverified", checkoutCopy.taxVerificationFailedText);
        // A delivery rate the merchant removed or repriced since the buyer chose
        // it: say what changed next to the options and let the buyer review first.
        if (await answer(press, shippingMethods?.recheck())) return fail("delivery_rate_changed");
        const cartIsValid = await answer(press, window.validateCartSnapshot?.() ?? true);
        if (isDiscountValidationPending()) return fail("discount_pending");
        if (!cartIsValid || window.hasCartValidationIssues?.() === true) {
          fail("cart_invalid");
          // A removed thana is asked for again at its own field.
          const locationControl = document.querySelector<HTMLElement>(
            '[data-location-fields] [aria-invalid="true"]',
          );
          if (locationControl) {
            locationControl.scrollIntoView?.({ behavior: "smooth", block: "center" });
            locationControl.focus({ preventScroll: true });
            return false;
          }
          // A store app's rule is already said above this button.
          const ruleBanner = document.getElementById("cartRuleErrors");
          if (window.hasCartRuleErrors?.() && ruleBanner && !ruleBanner.classList.contains("hidden")) {
            ruleBanner.scrollIntoView?.({ behavior: "smooth", block: "center" });
            ruleBanner.focus({ preventScroll: true });
            return false;
          }
          // A refused delivery rate is explained next to the delivery options,
          // never with the cart-items copy.
          const blocked = window.getCartBlockedMessage?.();
          if (blocked || !document.querySelector("[data-shipping-notice]:not(.hidden)")) {
            showCheckoutFormError(blocked || checkoutCopy.reviewCartItemsText, submitButton);
          }
          return false;
        }

        if (paymentChanged(press)) return false;
        // Lines an app needs a decision on (a protection plan or its decline): asked once,
        // then the changed cart is checked and quoted again before the order goes.
        if (hasUndecidedCartLines()) {
          const decided = await answer(press, decideUndecidedCartLines(submitButton), false);
          return decided.decided || fail("lines_undecided", decided.message, decided.focus);
        }
        if (codOnly) {
          press.cartChecked = true;
          return true;
        }
      }

      // The payment step's handoff waits for a total still on its way (cash posts only once quoted).
      if (!codOnly) await answer(press, window.cartTotalsSettled?.());
      if (paymentChanged(press)) return false;
      syncOrderTotal();
      // The summary already shows the new total; the next press confirms it.
      if (lastShownTotal !== press.total) return fail("total_changed", checkoutCopy.totalChangedReviewText);

      const attributesInput = document.getElementById("attributesInput") as HTMLInputElement | null;
      if (attributesInput) attributesInput.value = JSON.stringify(readBuyerAttributes());

      const submittedCart =
        (document.getElementById("cartItemsInput") as HTMLInputElement | null)?.value ?? "{}";

      if (!codOnly) {
        // ── Multi-gateway flow: hand the checkout to /checkout ──
        submit.move("hand_off");
        const formData = new FormData(form);
        const checkoutData: Record<string, string> = {};
        formData.forEach((value, key) => {
          checkoutData[key] = value as string;
        });
        checkoutData.customerPhone = phoneValidation.value;

        // The address travels only when something ships: a pickup or
        // service order carries none (the disabled address fieldset is not
        // in the form data; the location controls are read here).
        const deliveryMode = readCheckoutDeliveryMode();
        const locationValue = (name: string) => findNamedCheckoutControl(document, name)?.value;
        Object.assign(checkoutData, checkoutTransferPath(deliveryMode, {
          shippingCountryCode: chosenShippingCountry(),
          shippingAddressLine2: locationValue("shippingAddressLine2"),
          shippingDependentLocality: locationValue("shippingDependentLocality"),
          shippingLocality: locationValue("shippingLocality"),
          shippingAdminArea: locationValue("shippingAdminArea"),
          shippingPostalCode: locationValue("shippingPostalCode"),
          shippingAddress: locationValue("shippingAddress"),
          city: locationValue("city"),
          zone: locationValue("zone"),
          area: locationValue("area"),
          cityName: locationValue("cityName"),
          zoneName: locationValue("zoneName"),
          areaName: locationValue("areaName"),
        }));
        // The billing address: only what checkout asked for (Shopify's rule).
        const billingFields = checkoutBillingFields(deliveryMode, requireFullBillingAddress, checkoutData);
        for (const field of ["billingSameAsShipping", "billingCountryCode", ...BILLING_ADDRESS_FIELDS]) delete checkoutData[field];
        for (const [field, value] of Object.entries(billingFields)) checkoutData[field] = String(value);
        for (const field of Object.keys(checkoutData)) {
          if (checkoutData[field] === null || checkoutData[field] === undefined) delete checkoutData[field];
        }

        // The delivery or pickup option chosen (validation required one); none without physical items.
        const chosenMethod = deliveryMode === "none" ? undefined : window.lastShippingEventDetail;
        const shippingLocation = locationValue("shippingLocation");
        if (chosenMethod && shippingLocation) checkoutData.shippingLocation = shippingLocation;
        else delete checkoutData.shippingLocation;

        checkoutData["shippingCharge"] = String(chosenMethod
          ? getEffectiveCartShippingFee(JSON.parse(submittedCart), chosenMethod.fee, chosenMethod.freeOver, chosenMethod.quoted)
          : 0);
        if (chosenMethod) {
          checkoutData["shippingMethodId"] = chosenMethod.id;
          checkoutData["shippingMethodName"] = chosenMethod.name;
          if (chosenMethod.kind === "pickup") {
            if (chosenMethod.pickupAddress) checkoutData.pickupAddress = chosenMethod.pickupAddress;
            if (chosenMethod.pickupHours) checkoutData.pickupHours = chosenMethod.pickupHours;
          }
        }

        const transferWrite = writeCheckoutTransferSession(
          checkoutData,
          meta?.dataset.gateways || "[]",
        );
        if (!transferWrite.ok) {
          fail("transfer");
          const message = checkoutCopy[transferWrite.copyKey];
          const messageEl = document.getElementById("cartValidationMessage");
          if (!messageEl) {
            showCheckoutFormError(message, submitButton);
            return false;
          }
          messageEl.textContent = message;
          messageEl.classList.remove("hidden");
          messageEl.scrollIntoView?.({ behavior: "smooth", block: "center" });
          return false;
        }
        emitCheckoutFormSubmitted(checkoutData);
        submit.move("redirect", {
          overlay: { title: checkoutCopy.openingPaymentOptionsTitle, message: checkoutCopy.openingPaymentOptionsMessage },
        });
        window.location.href = pagePath("/checkout");
        return false;
      }

      // ── Cash placed here: the form's own POST, which the submit listener lets through ──
      const postedFields: Record<string, string> = {};
      new FormData(form).forEach((value, key) => {
        if (typeof value === "string") postedFields[key] = value;
      });
      emitCheckoutFormSubmitted({ ...postedFields, customerPhone: phoneValidation.value });
      rememberSubmittedCart(submittedCart);
      submit.move("place", {
        overlay: { title: checkoutCopy.processingOrderTitle, message: checkoutCopy.processingOrderMessage },
      });
      form.requestSubmit();
      return false;
    };

    form.addEventListener(
      "submit",
      (e) => {
        // The cash order's own POST, sent by the press it ends.
        if (submit.state.status === "placing") return;
        e.preventDefault();
        syncOrderTotal();
        const press: Press = { total: lastShownTotal, placesCash: codOnly, accountChecked: false, cartChecked: false };
        if (!submit.move("press", { step: "start" })) return;
        currentPress = press;
        void (async () => {
          while (await checkPress(press));
        })().catch((error: unknown) => {
          // A check that threw or never answered: the button comes back and the buyer presses again.
          if (error instanceof PressSuperseded || currentPress !== press) return;
          fail(error instanceof SubmitStepTimeout ? "timeout" : "error", checkoutCopy.genericErrorText);
          if (!(error instanceof SubmitStepTimeout)) console.error("Checkout press failed:", error);
        });
      },
      { signal: cartPageSignal },
    );
  });

  // ── Address country ──
  // The chosen country's rules hide the fields it doesn't use and mark the
  // required ones (the form already works without this).
  enhanceShippingCountry(document, { signal: cartPageSignal });

  // ── Address autocomplete ──
  // Only when an active app completes addresses (the layout names it): the
  // code loads then and not otherwise. The street line suggests addresses for
  // the countries the app serves; the form is the same without it.
  const addressApp = addressAutocompleteService();
  const streetLine = document.getElementById("shippingAddress");
  if (addressApp && (streetLine instanceof HTMLTextAreaElement || streetLine instanceof HTMLInputElement)) {
    // Without its script the street line is a plain field, as it is without the app.
    loadLazyScript(() => import("@/lib/checkout/address-autocomplete"), { needed: false }).then(({ apiPost, enhanceAddressAutocomplete }) => {
      enhanceAddressAutocomplete({
        root: document,
        input: streetLine,
        service: addressApp,
        locale: pageLocale(),
        copy: checkoutCopy,
        post: apiPost(browserApiUrl),
        signal: cartPageSignal,
      });
    }, () => undefined);
  }
</script>
