---
// src/pages/cart.astro
import WindowGlobals from "@/components/WindowGlobals.astro";
import { CART_COLUMN_PLACE_SCRIPT, CART_EARLY_CONTROLS_SCRIPT, CART_FIRST_PAINT_SCRIPT, CART_LOADING_LINES_SCRIPT, CART_PICKUP_CHOICE_SCRIPT, CART_QUICK_BUY_NOTICE_SCRIPT, CART_SUMMARY_FOLD_SCRIPT } from "@/lib/cart/cart-page-scripts";
import { DEFAULT_CUSTOMER_IDENTITY, checkoutContactFields } from "@scalius/shared/customer-auth-policy";
import Layout from "@/layouts/Layout.astro";
import CheckoutHeader from "@/components/CheckoutHeader.astro";
import LocationFields from "@/components/checkout/LocationFields.astro";
import CheckoutShippingMethods from "@/components/checkout/CheckoutShippingMethods.astro";
import CheckoutPhoneField from "@/components/CheckoutPhoneField.astro";
import CheckoutLoadingOverlay from "@/components/CheckoutLoadingOverlay.astro";
import CheckoutProgress from "@/components/CheckoutProgress.astro";
import MarketingConsentField from "@/components/checkout/MarketingConsentField.astro";
import ShippingCountryField from "@/components/checkout/ShippingCountryField.astro";
import ForeignAddressFields from "@/components/checkout/ForeignAddressFields.astro";
import BillingAddressFields from "@/components/checkout/BillingAddressFields.astro";
import BuyerField from "@/components/apps/BuyerField.astro";
import EmptyCartPopular from "@/components/checkout/EmptyCartPopular.astro";
import CartPageLayout from "@/components/cart/CartPageLayout.astro";
import { privateAssetUrls } from "@/lib/private-pages/html";
import { privatePagePlan, privateStyle } from "@/lib/private-pages/plan";
import { withCartLabels } from "@/lib/private-pages/labels";
import { readStorefrontExtensions } from "@scalius/shared/plugins/storefront-components";
import {
  LOCATION_COUNTRY,
  defaultShippingCountry,
  presenceMarketCountries,
  storeShippingCountries,
} from "@/lib/checkout/shipping-country";
import { bangladeshAddressesOffered, physicalDeliveryOffered } from "@/lib/delivery-facts";
import { catalogCopy } from "@/lib/catalog-copy";
import { marketingConsentCheckbox } from "@/lib/checkout/marketing-consent";
import { cashOrderNeedsSignIn, processOrder } from "@/lib/cart/server";
import { CheckoutCopyError, checkoutFailureText } from "@/lib/checkout/error-messages";
import { checkoutAttemptRecoveryHref } from "@/lib/checkout/attempt-recovery";
import {
  getCities,
  getShippingMethods,
  getLayoutData,
  type ShippingMethod,
  getActiveCheckoutLanguage,
  type CheckoutLanguageData,
  getCheckoutConfig,
  getProductRecommendations,
  isCheckoutConfigReadFailure,
  checkoutTakesOrders,
  isCodOnly,
  canPlaceCashHere,
} from "@/lib/api";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import { THEME_EDITOR_MARKS } from "@scalius/shared/theme-editor-bridge";
import TemplateSections from "@/components/homepage/TemplateSections.astro";
import { shopCopy } from "@/lib/storefront-shop-copy";
import { resolveRequestTheme } from "@/lib/storefront-theme-context";
import { servedPrivatePages } from "@scalius/shared/storefront-theme";
import { templateSectionData } from "@/lib/template-sections";
import { markRenderUncacheable } from "@/lib/cache-policy";
import { getRuntimePresence } from "@/lib/api/runtime";
import { ENDED_CUSTOMER_SESSION_COOKIES, getCustomerSessionTokenFromCookie } from "@/lib/customer-session-cookie";
import {
  createOrderReceiptCookieHeader,
  createOrderReceiptFinalizeCookieHeader,
} from "@/lib/order-receipt-cookie";
import { MIN_SHIPPING_ADDRESS_LENGTH } from "@/lib/checkout/shipping-address";
import { termsSegments } from "@/lib/checkout/terms-text";
import { giftCardCheckoutCopy } from "@/lib/checkout/gift-cards";
import { hashCheckoutCartFingerprint } from "@/lib/checkout/session-state";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import type { CartRuleError, CartValidationIssue } from "@/lib/api/orders";
import { cartRuleRefusal } from "@/lib/checkout/tax-quote-error-contract";
import { checkoutLanguageBaseCode } from "@scalius/shared/checkout-language-format";
import { ENGLISH_CHECKOUT_LANGUAGE_DATA } from "@scalius/shared/checkout-language";
import { CART_REQUEST_MAX_BYTES, readBoundedForm } from "@/lib/bounded-body";

// The GET render is a buyer-agnostic shell that the edge caches under the
// store's cache generation (lib/cache-policy.ts isBuyerShellPathname): it
// reads only public, generation-cached settings and never a cookie, a query
// parameter or the buyer's cart. The lines paint from localStorage and
// everything buyer-specific comes from no-store APIs or the POST below.
// Parallel fetch: layout + cities + shipping methods + checkout language +
const [
  layoutData,
  citiesResponse,
  shippingMethodsResponse,
  checkoutLanguageResponse,
  checkoutConfig,
  popularProducts,
] = await Promise.all([
  getLayoutData(),
  getCities(),
  getShippingMethods(),
  getActiveCheckoutLanguage(),
  getCheckoutConfig(),
  // The empty cart's "Popular now" (store-wide, no source product).
  getProductRecommendations([], 8),
]);
const cities = citiesResponse ?? [];
const shippingMethods: ShippingMethod[] = shippingMethodsResponse || [];
// A failed public read must never populate the shared cache. A failed
// checkout-config read also keeps checkout unavailable until it can be proved.
if (
  !layoutData ||
  citiesResponse === null ||
  shippingMethodsResponse === null ||
  checkoutLanguageResponse === null ||
  isCheckoutConfigReadFailure(checkoutConfig)
) {
  markRenderUncacheable(Astro.response.headers);
}
// Delivery or pickup, like Shopify's checkout: the switch shows only when the
// store offers both; a pickup-only store never asks for an address.
const hasPickupRates = shippingMethods.some((method) => method.kind === "pickup");
const hasDeliveryRates = shippingMethods.some((method) => method.kind !== "pickup");
const deliveryModeSwitch = hasPickupRates && hasDeliveryRates;
// No delivery or pickup option reaches this page's buyers (no zone serves
// their countries, or Bangladesh has no city and thana to choose): a cart
// that needs delivery is told so, instead of an empty city picker, and Place
// order is off. The product page draws the same rule (physicalDeliveryOffered).
// An unreadable rate list proves nothing (the render is uncacheable then), and
// an unavailable checkout already says why nothing can be ordered.
const physicalDelivery = shippingMethodsResponse === null || !checkoutTakesOrders(checkoutConfig) || physicalDeliveryOffered(
  shippingMethods,
  presenceMarketCountries(layoutData?.markets, getRuntimePresence()),
  bangladeshAddressesOffered(checkoutConfig),
);
const pickupOnly = hasPickupRates && !hasDeliveryRates;
// This cacheable shell has no cart. The API owns global readiness; each
// physical cart proves its destination and delivery option when quoted.
const checkoutUnavailable =
  checkoutConfig.unavailable === true ||
  checkoutConfig.gateways.length === 0;
const checkoutUnavailableMessage =
  checkoutConfig.unavailableMessage ||
  checkoutLanguageResponse?.languageData.checkoutUnavailableMessage ||
  ENGLISH_CHECKOUT_LANGUAGE_DATA.checkoutUnavailableMessage;
const codOnly = !checkoutUnavailable && isCodOnly(checkoutConfig);
// The store takes cash among other methods: when this buyer's quote leaves
// cash alone (a guest never gets the invoice), the page places it here, with
// no payment step showing one choice (codPaymentStep in lib/checkout/payment-step.ts).
const codPlaceable = !checkoutUnavailable && canPlaceCashHere(checkoutConfig);
// Settings → Customer accounts decides the contact fields. With its opt-in, a
// cart of digital or service lines may go without a phone (email is then
// required); the page script decides per cart (lib/checkout/contact-need.ts).
const contactFields = checkoutContactFields(checkoutConfig.customerIdentity ?? DEFAULT_CUSTOMER_IDENTITY);
const phoneOptionalForDigital = checkoutConfig.customerIdentity?.phoneOptionalForDigital === true;
const allowedCountriesMode = checkoutConfig?.allowedCountriesMode || "include";
// The theme the page draws with (the draft in a preview): the cart template's
// sections around the cart, and the theme's arrangement, words and stylesheet
// for the cart page (lib/private-pages). Read from the layout read: no query of its own.
const cartRequestTheme = await resolveRequestTheme(Astro, layoutData);
const checkoutLanguage: CheckoutLanguageData = checkoutLanguageResponse || {
  id: "fallback",
  name: "English (Fallback)",
  code: "en",
  languageData: { ...ENGLISH_CHECKOUT_LANGUAGE_DATA },
  fieldVisibility: {
    showOrderNotesField: true,
    showAreaField: true,
  },
  isActive: true,
  isDefault: true,
};
const pageLanguageCode = checkoutLanguageBaseCode(checkoutLanguage.code);
const privateAsset = privateAssetUrls(readStorefrontExtensions(layoutData?.appExtensions));
const cartPlan = privatePagePlan(cartRequestTheme.theme, "cart", pageLanguageCode, privateAsset);
// The theme's words for the cart's labels, on the page and in the cart script alike.
const lang: CheckoutLanguageData = { ...checkoutLanguage, languageData: withCartLabels(checkoutLanguage.languageData, cartPlan.labels) };
const copy = lang.languageData;
const giftCopy = giftCardCheckoutCopy(copy);
const policyPath = (kind: "terms" | "privacy") =>
  layoutData?.policies?.find((policy) => policy.kind === kind)?.path ?? null;
const hasAgreementPolicies = Boolean(policyPath("terms") && policyPath("privacy"));
const agreement = termsSegments(copy.termsText, {
  terms: { label: copy.termsLinkText, href: policyPath("terms") },
  privacy: { label: copy.privacyLinkText, href: policyPath("privacy") },
});
const [existingCheckoutMessageBefore, existingCheckoutMessageAfter = ""] =
  copy.existingCheckoutMessage.split("{orderId}", 2);

// Initialize error message and success state
let errorMessage = "";
let isProcessing = false;
let expiredCheckoutId: string | undefined;
// The cash order needs a signed-in buyer again: the page opens sign-in (cashOrderNeedsSignIn).
let signInRequired = false;
let codCartRepairState: {
  source: "cart";
  message: string;
  issues: CartValidationIssue[];
  ruleErrors?: CartRuleError[];
  createdAt: number;
} | null = null;

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function isCartValidationIssue(value: unknown): value is CartValidationIssue {
  return (
    isRecord(value) &&
    typeof value.index === "number" &&
    typeof value.productId === "string" &&
    typeof value.message === "string"
  );
}

function extractItemIssues(details: unknown): CartValidationIssue[] {
  if (!isRecord(details) || !Array.isArray(details.itemIssues)) return [];
  return details.itemIssues.filter(isCartValidationIssue);
}

// Handle form submission — only for COD-only checkout submits.
// Other forms on the page may use POST to avoid URL/query leakage.
// When multiple gateways are active, the checkout form is intercepted client-side
// and the user is redirected to /checkout for payment selection.
if (Astro.request.method === "POST" && codPlaceable) {
  try {
    const posted = await readBoundedForm(Astro.request, CART_REQUEST_MAX_BYTES);
    if (!posted.ok) throw new TypeError(posted.reason === "too_large" ? "The checkout form is too large" : "The checkout form is unreadable");
    const formData = posted.value;

    // Cash placed here: the store's only method, or the only one this buyer's quote left (the API checks it again).
    if (formData.get("formIntent") === "checkout" && (codOnly || formData.get("paymentStep") === "skipped")) {
      isProcessing = true;

      // Check if cart is empty
      const cartItems = formData.get("cartItems") as string;
      if (!cartItems || cartItems === "{}" || cartItems === "[]") {
        throw new CheckoutCopyError("cartEmptyErrorText");
      }

      const result = await processOrder(formData, {
        copy,
        languageCode: checkoutLanguageBaseCode(lang.code),
        customerSessionToken: getCustomerSessionTokenFromCookie(
          Astro.request.headers.get("cookie"),
        ),
        requireFullBillingAddress: checkoutConfig.requireFullBillingAddress === true,
      });

      if (
        result.success &&
        "orderId" in result &&
        "receiptToken" in result &&
        result.orderId &&
        result.receiptToken
      ) {
        const response = Astro.redirect(
          `/order-success?orderId=${encodeURIComponent(result.orderId)}`,
        );
        // Placed as a guest's: the ended session's cookies go.
        if ("customerSessionEnded" in result && result.customerSessionEnded) {
          for (const cookie of ENDED_CUSTOMER_SESSION_COOKIES) response.headers.append("Set-Cookie", cookie);
        }
        const receiptCookie = createOrderReceiptCookieHeader(
          result.orderId,
          result.receiptToken,
        );
        if (receiptCookie) {
          response.headers.append("Set-Cookie", receiptCookie);
        }
        const finalizeCookie = createOrderReceiptFinalizeCookieHeader(
          result.orderId,
          {
            checkoutId: String(formData.get("checkoutId") ?? ""),
            cartFingerprintHash: await hashCheckoutCartFingerprint(cartItems),
          },
        );
        if (finalizeCookie) {
          response.headers.append("Set-Cookie", finalizeCookie);
        }
        return response;
      } else {
        const errorCode = "errorCode" in result ? result.errorCode : undefined;
        if (errorCode === "checkout_attempt_conflict") {
          const href = checkoutAttemptRecoveryHref("details" in result ? result.details : undefined);
          if (href) {
            const response = Astro.redirect(href, 303);
            const existingOrderId = new URL(href, Astro.url).searchParams.get("orderId");
            const checkoutId = formData.get("checkoutId");
            if (existingOrderId && typeof checkoutId === "string") {
              const marker = createOrderReceiptFinalizeCookieHeader(existingOrderId, { checkoutId, mode: "attempt-only" });
              if (marker) response.headers.append("Set-Cookie", marker);
            }
            return response;
          }
        }
        if (errorCode === "checkout_attempt_expired") {
          const checkoutId = formData.get("checkoutId");
          if (typeof checkoutId === "string") expiredCheckoutId = checkoutId.trim();
        }
        console.error("Order processing failed:", result.error);
        const resultError = result.error;
        // A store app's rules: the page says them at their lines and above Place order.
        const ruleErrors = cartRuleRefusal({
          details: "details" in result ? result.details : undefined,
        });
        const quoteConflict =
          "errorCode" in result &&
          result.errorCode === "storefront_checkout_quote_conflict";
        errorMessage =
          (errorCode === "checkout_attempt_expired"
            ? copy.checkoutAttemptExpiredText
            : errorCode === "checkout_attempt_conflict"
              ? copy.checkoutAttemptConflictText
              : ruleErrors
                ? copy.cartRulesBlockedText
                : quoteConflict
                  ? copy.totalChangedReviewText
                  : typeof resultError === "string"
                    ? resultError
                    : resultError?.message) ||
          copy.orderProcessingFailedText;
        const itemIssues = extractItemIssues(
          "details" in result ? result.details : undefined,
        );
        if (ruleErrors && itemIssues.length === 0) {
          codCartRepairState = {
            source: "cart",
            message: errorMessage,
            issues: [],
            ruleErrors,
            createdAt: Date.now(),
          };
        } else if (itemIssues.length > 0) {
          codCartRepairState = {
            source: "cart",
            message:
              itemIssues.length === 1
                ? errorMessage
                : copy.cartItemsNeedAttentionText.replace("{count}", String(itemIssues.length)),
            issues: itemIssues,
            createdAt: Date.now(),
          };
        }
        if (cashOrderNeedsSignIn(result)) {
          signInRequired = true;
          errorMessage = "";
        }
      }
    }
  } catch (error: unknown) {
    console.error("Order creation failed:", error);
    // The buyer's words only: a developer's message stays in the log above.
    errorMessage = checkoutFailureText(error, copy, "unexpectedErrorText");
  } finally {
    isProcessing = false;
  }
}

// The countries the store sells to (its active markets): a store that sells
// only to Bangladesh shows no country field and its form is unchanged.
const shippingCountries = storeShippingCountries(layoutData?.markets);
const shipsAbroad = shippingCountries.some((country) => country !== LOCATION_COUNTRY);
const shipsToBangladesh = shippingCountries.includes(LOCATION_COUNTRY);
const shippingCountry = defaultShippingCountry(layoutData?.markets, getRuntimePresence(), shippingCountries);

// Determine submit button label
const submitLabel = codOnly
    ? copy.placeOrderText
    : checkoutUnavailable
      ? copy.checkoutUnavailableText
      : copy.continueToPaymentText;
// One input style for every checkout field.
const labelClass = "mb-1 block text-sm font-medium text-foreground";
const fieldClass =
  "block h-11 w-full rounded-lg border border-input bg-background px-3 text-base text-foreground placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/30 aria-[invalid=true]:border-destructive";
const errorClass = "mt-1 hidden text-sm font-medium text-destructive";
// Settings → Customers: the marketing consent box (unchecked, never required).
const marketingConsent = marketingConsentCheckbox(checkoutConfig, lang.code);
// The cart page's own words: Clear cart, the phone summary bar, and the empty cart's categories and popular products.
const cartWords = shopCopy(checkoutLanguageBaseCode(lang.code)).cart;
const emptyCartCategories = (layoutData?.categoryTree?.nodes ?? []).filter((node) => node.parentId === null).slice(0, 8);
const cartTemplate = cartRequestTheme.resolved.pages.templates.cart;
// The phone summary bar's words (the theme may reword them).
const foldWords = { show: cartPlan.labels["cart.showSummary"] ?? cartWords.showSummary, hide: cartPlan.labels["cart.hideSummary"] ?? cartWords.hideSummary };
// The theme's own header and footer (`privatePages.chrome: theme`), script-free; else the store's checkout header.
const themeChrome = servedPrivatePages(cartRequestTheme.theme.privatePages).chrome === "theme";
// The theme's stylesheet for these pages, compiled when it was saved, and what its guard checks.
const cartStyle = privateStyle(cartRequestTheme.theme, privateAsset);
// The theme's words for the confirmation dialog's buttons (lib/cart/confirm-dialog.ts reads them).
const dialogLabels = Object.fromEntries(Object.entries(cartPlan.labels).filter(([key]) => key.startsWith("dialog.")));
const templateData = await templateSectionData("cart", cartRequestTheme);
---

<Layout
  title={copy.pageTitle}
  layoutData={layoutData}
  documentLanguage={checkoutLanguageBaseCode(lang.code)}
  noindex
  hideHeader={!themeChrome}
  hideFooter={!themeChrome}
  hideNavigationSidebar
  privateChrome={themeChrome}
  privateStyle={cartStyle}
  privateTokens={cartPlan.tokens}
>
  {!themeChrome && <CheckoutHeader layoutData={layoutData} copy={copy} />}
  {Object.keys(dialogLabels).length > 0 && (
    <script is:inline type="application/json" id="privateLabels" set:html={serializeJsonForInlineScript(dialogLabels)} />
  )}
  {
    codCartRepairState && (
      <script
        is:inline
        id="codCartRepairState"
        type="application/json"
        set:html={serializeJsonForInlineScript(codCartRepairState)}
      />
    )
  }

  <div
    id="checkout-meta"
    data-cod-only={codOnly ? "true" : "false"}
    data-cod-placeable={codPlaceable && !codOnly ? "true" : undefined}
    data-checkout-unavailable={checkoutUnavailable ? "true" : "false"}
    data-checkout-unavailable-message={checkoutUnavailableMessage}
    data-gateways={JSON.stringify(checkoutConfig.gateways)}
    data-guest-checkout-enabled={checkoutConfig.guestCheckoutEnabled !== false
      ? "true"
      : "false"}
    data-sign-in-required={signInRequired ? "true" : undefined}
    hidden
  >
  </div>

  <TemplateSections
    template={cartTemplate}
    region="before"
    data={templateData}
    currencySymbol={layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol}
    currencyCode={layoutData?.currency?.code ?? DEFAULT_CURRENCY.code}
    preview={cartRequestTheme.preview !== null}
    languageCode={layoutData?.storefrontCopy?.languageCode}
  />

  <div
    id="cartPageRoot"
    data-expired-checkout-id={expiredCheckoutId}
    data-theme-section-id={cartRequestTheme.preview ? THEME_EDITOR_MARKS.cart : undefined}
    data-cart-ready="false"
    data-cart-has-items="false"
    data-cart-state="loading"
    data-delivery-need="method"
    data-delivery-mode={pickupOnly ? "pickup" : "delivery"}
    data-mode-switch={deliveryModeSwitch ? "true" : "false"}
    data-physical-delivery={physicalDelivery ? undefined : "none"}
    data-summary="closed"
    class={cartPlan.frame === "narrow" ? "group container mx-auto max-w-3xl px-4 pb-6 pt-5 sm:px-6 sm:pt-7" : "group container mx-auto max-w-6xl px-4 pb-6 pt-5 sm:px-6 sm:pt-7"}
    data-private="cart"
  >
    {/* Before first paint: with nothing saved, the server-rendered empty state
        shows at once instead of after the page scripts load (PERF-01). */}
    {/* Also before first paint: a cart with nothing physical hides the
        delivery section, and a buyer who chose pickup sees no address fields,
        so neither moves the form once the scripts load. */}
    <script is:inline set:html={CART_FIRST_PAINT_SCRIPT} />
    <script is:inline set:html={CART_EARLY_CONTROLS_SCRIPT} />
    <noscript>
      {/* The lines live in browser storage: without scripts there is nothing
          to load, so no endless skeleton or empty form, only this note. */}
      <style>#cartPageRoot [data-cart-grid] { display: none; }</style>
      <div
        class="mb-3 rounded-lg border border-border bg-muted/50 px-3 py-2 text-sm text-foreground"
        role="alert"
      >
        {copy.noScriptText}
      </div>
    </noscript>
    <CartPageLayout plan={cartPlan} language={pageLanguageCode} asset={privateAsset}>
      <Fragment slot="progress">
    <div class="group-data-[cart-state=empty]:hidden" data-part="progress">
      <CheckoutProgress current="information" paymentRequired={!codOnly} paymentStepMayHide={codPlaceable && !codOnly} copy={copy} />
    </div>
      </Fragment>
      <Fragment slot="notices">
    {
      checkoutUnavailable && (
        <div
          class="mb-3 rounded-lg border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive"
          role="alert"
          data-part="notice"
        >
          <strong class="font-semibold">{copy.checkoutUnavailableText}: </strong>
          <span>{checkoutUnavailableMessage}</span>
        </div>
      )
    }

    {
      errorMessage && (
        <div
          class="mb-3 rounded-lg border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive"
          role="alert"
          data-part="notice"
        >
          {errorMessage}
        </div>
      )
    }
    {/* Quick buy lands here with ?quickBuyStorage=blocked when the browser
        refused session storage. The shell is shared by every buyer, so the
        notice is revealed from the URL in the browser, before first paint. */}
    <div
      id="quickBuyStorageNotice"
      class="mb-3 rounded-lg border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive"
      role="alert"
      hidden
      data-part="notice"
    >
      {copy.quickBuyStorageBlockedText}
    </div>
    <script is:inline set:html={CART_QUICK_BUY_NOTICE_SCRIPT} />

    <aside
      id="checkoutRecoveryNotice"
      class="hidden mb-3 rounded-xl border border-border bg-muted px-4 py-3 text-foreground"
      role="status"
      aria-hidden="true"
      data-part="notice"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-semibold">{copy.existingCheckoutTitle}</p>
          <p class="mt-1 text-sm text-muted-foreground">
            {existingCheckoutMessageBefore}<span id="checkoutRecoveryReference" class="font-mono"></span>{existingCheckoutMessageAfter}
          </p>
        </div>
        <a
          id="checkoutRecoveryLink"
          data-astro-prefetch="false"
          class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          {copy.reviewExistingCheckoutText}
        </a>
      </div>
    </aside>

      </Fragment>
      <Fragment slot="foldBar">
        {/* Phones (Shopify): the summary folds into one bar with the total, so
            the form starts near the top. Works before the page scripts load. */}
        <button
          type="button"
          id="orderSummaryToggle"
          aria-controls="orderSummaryBody"
          aria-expanded="false"
          data-part="fold-toggle"
          class="mb-3 flex min-h-12 w-full items-center justify-between gap-3 rounded-xl border border-border bg-card px-4 py-3 text-start text-sm font-semibold text-foreground transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring lg:hidden group-data-[cart-state=empty]:hidden"
        >
          <span class="flex items-center gap-1.5">
            <span class="group-data-[summary=open]:hidden">{foldWords.show}</span>
            <span class="hidden group-data-[summary=open]:inline">{foldWords.hide}</span>
            <svg class="size-4 shrink-0 transition-transform group-data-[summary=open]:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
            </svg>
          </span>
          <span id="orderSummaryToggleTotal" class="text-base font-semibold tabular-nums"></span>
        </button>
        {/* Phones: the lines that need the buyer's choice (an app input that needs a decision, a refused
            answer), drawn by the line-input controls above the folded summary, editable without unfolding it. */}
        <div class="mb-3 lg:hidden group-data-[summary=open]:hidden group-data-[cart-state=empty]:hidden" data-cart-line-decisions hidden></div>
      </Fragment>
      <Fragment slot="lines">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border px-4 py-3">
