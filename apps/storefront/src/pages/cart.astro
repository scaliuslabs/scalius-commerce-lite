---
// src/pages/cart.astro
import Layout from "@/layouts/Layout.astro";
import CheckoutHeader from "@/components/CheckoutHeader.astro";
import CheckoutLocationFields from "@/components/checkout/CheckoutLocationFields.astro";
import CheckoutShippingMethods from "@/components/checkout/CheckoutShippingMethods.astro";
import CheckoutPhoneField from "@/components/CheckoutPhoneField.astro";
import CheckoutLoadingOverlay from "@/components/CheckoutLoadingOverlay.astro";
import CheckoutProgress from "@/components/CheckoutProgress.astro";
import { processOrder } from "@/lib/cart/server";
import {
  getCities,
  getShippingMethods,
  getLayoutData,
  type ShippingMethod,
  getActiveCheckoutLanguage,
  type CheckoutLanguageData,
  getCheckoutConfig,
  isCheckoutConfigReadFailure,
  isCodOnly,
} from "@/lib/api";
import { markRenderUncacheable } from "@/lib/cache-policy";
import { getCustomerSessionTokenFromCookie } from "@/lib/customer-session-cookie";
import {
  createOrderReceiptCookieHeader,
  createOrderReceiptFinalizeCookieHeader,
} from "@/lib/order-receipt-cookie";
import { MIN_SHIPPING_ADDRESS_LENGTH } from "@/lib/checkout/shipping-address";
import { termsSegments } from "@/lib/checkout/terms-text";
import { hashCheckoutCartFingerprint } from "@/lib/checkout/session-state";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import type { CartValidationIssue } from "@/lib/api/orders";
import {
  ENGLISH_CHECKOUT_LANGUAGE_DATA,
  checkoutLanguageBaseCode,
} from "@scalius/shared/checkout-language";

// The GET render is a buyer-agnostic shell that the edge caches under the
// store's cache generation (lib/cache-policy.ts isBuyerShellPathname): it
// reads only public, generation-cached settings and never a cookie, a query
// parameter or the buyer's cart. The lines paint from localStorage and
// everything buyer-specific comes from no-store APIs or the POST below.
// Parallel fetch: layout + cities + shipping methods + checkout language + checkout config
const [
  layoutData,
  citiesResponse,
  shippingMethodsResponse,
  checkoutLanguageResponse,
  checkoutConfig,
] = await Promise.all([
  getLayoutData(),
  getCities(),
  getShippingMethods(),
  getActiveCheckoutLanguage(),
  getCheckoutConfig(),
]);
const cities = citiesResponse ?? [];
const shippingMethods: ShippingMethod[] = shippingMethodsResponse || [];
// A failed read renders the fail-closed page (checkout unavailable, English
// copy); that answer is for this request only, never the shared cache.
if (
  !layoutData ||
  citiesResponse === null ||
  shippingMethodsResponse === null ||
  checkoutLanguageResponse === null ||
  isCheckoutConfigReadFailure(checkoutConfig)
) {
  markRenderUncacheable(Astro.response.headers);
}
// Delivery or pickup, like Shopify's checkout: the switch shows only when the
// store offers both; a pickup-only store never asks for an address.
const hasPickupRates = shippingMethods.some((method) => method.kind === "pickup");
const hasDeliveryRates = shippingMethods.some((method) => method.kind !== "pickup");
const deliveryModeSwitch = hasPickupRates && hasDeliveryRates;
const pickupOnly = hasPickupRates && !hasDeliveryRates;
const checkoutUnavailable =
  checkoutConfig.unavailable === true ||
  checkoutConfig.gateways.length === 0 ||
  shippingMethods.length === 0 ||
  (cities.length === 0 && !hasPickupRates);
const checkoutUnavailableMessage =
  checkoutConfig.unavailableMessage ||
  checkoutLanguageResponse?.languageData.checkoutUnavailableMessage ||
  ENGLISH_CHECKOUT_LANGUAGE_DATA.checkoutUnavailableMessage;
const codOnly = !checkoutUnavailable && isCodOnly(checkoutConfig);
const allowedCountriesMode = checkoutConfig?.allowedCountriesMode || "include";
const lang: CheckoutLanguageData = checkoutLanguageResponse || {
  id: "fallback",
  name: "English (Fallback)",
  code: "en",
  languageData: { ...ENGLISH_CHECKOUT_LANGUAGE_DATA },
  fieldVisibility: {
    showEmailField: true,
    showOrderNotesField: true,
    showAreaField: true,
  },
  isActive: true,
  isDefault: true,
};
const copy = lang.languageData;
const policyPath = (kind: "terms" | "privacy") =>
  layoutData?.policies?.find((policy) => policy.kind === kind)?.path ?? null;
const hasAgreementPolicies = Boolean(policyPath("terms") && policyPath("privacy"));
const agreement = termsSegments(copy.termsText, {
  terms: { label: copy.termsLinkText, href: policyPath("terms") },
  privacy: { label: copy.privacyLinkText, href: policyPath("privacy") },
});
const [existingCheckoutMessageBefore, existingCheckoutMessageAfter = ""] =
  copy.existingCheckoutMessage.split("{orderId}", 2);

// Initialize error message and success state
let errorMessage = "";
let isProcessing = false;
let staleCustomerSession = false;
let codCartRepairState: {
  source: "cart";
  message: string;
  issues: CartValidationIssue[];
  createdAt: number;
} | null = null;

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function isCartValidationIssue(value: unknown): value is CartValidationIssue {
  return (
    isRecord(value) &&
    typeof value.index === "number" &&
    typeof value.productId === "string" &&
    typeof value.message === "string"
  );
}

function extractItemIssues(details: unknown): CartValidationIssue[] {
  if (!isRecord(details) || !Array.isArray(details.itemIssues)) return [];
  return details.itemIssues.filter(isCartValidationIssue);
}

// Handle form submission — only for COD-only checkout submits.
// Other forms on the page may use POST to avoid URL/query leakage.
// When multiple gateways are active, the checkout form is intercepted client-side
// and the user is redirected to /checkout for payment selection.
if (Astro.request.method === "POST" && codOnly) {
  try {
    const formData = await Astro.request.formData();

    if (formData.get("formIntent") === "checkout") {
      isProcessing = true;

      // Check if cart is empty
      const cartItems = formData.get("cartItems") as string;
      if (!cartItems || cartItems === "{}" || cartItems === "[]") {
        throw new Error(
          copy.cartEmptyErrorText,
        );
      }

      const result = await processOrder(formData, {
        customerSessionToken: getCustomerSessionTokenFromCookie(
          Astro.request.headers.get("cookie"),
        ),
        waitUntil: (promise) => Astro.locals.cfContext.waitUntil(promise),
      });

      if (
        result.success &&
        "orderId" in result &&
        "receiptToken" in result &&
        result.orderId &&
        result.receiptToken
      ) {
        const response = Astro.redirect(
          `/order-success?orderId=${encodeURIComponent(result.orderId)}`,
        );
        const receiptCookie = createOrderReceiptCookieHeader(
          result.orderId,
          result.receiptToken,
        );
        if (receiptCookie) {
          response.headers.append("Set-Cookie", receiptCookie);
        }
        const finalizeCookie = createOrderReceiptFinalizeCookieHeader(
          result.orderId,
          {
            checkoutId: String(formData.get("checkoutId") ?? ""),
            cartFingerprintHash: await hashCheckoutCartFingerprint(cartItems),
          },
        );
        if (finalizeCookie) {
          response.headers.append("Set-Cookie", finalizeCookie);
        }
        return response;
      } else {
        console.error("Order processing failed:", result.error);
        const resultError = result.error;
        if (
          "errorCode" in result &&
          result.errorCode === "CUSTOMER_SESSION_STALE"
        ) {
          Astro.cookies.delete("cs_tok", {
            path: "/",
            httpOnly: true,
            sameSite: "lax",
            secure: true,
          });
          Astro.cookies.delete("cs_auth", {
            path: "/",
            sameSite: "lax",
            secure: true,
          });
          staleCustomerSession = true;
        }
        errorMessage =
          ("errorCode" in result &&
          result.errorCode === "STOREFRONT_CHECKOUT_QUOTE_CONFLICT"
            ? copy.totalChangedReviewText
            : (typeof resultError === "string"
                ? resultError
                : resultError?.message)) ||
          copy.orderProcessingFailedText;
        const itemIssues = extractItemIssues(
          "details" in result ? result.details : undefined,
        );
        if (itemIssues.length > 0) {
          codCartRepairState = {
            source: "cart",
            message:
              itemIssues.length === 1
                ? errorMessage
                : copy.cartItemsNeedAttentionText.replace("{count}", String(itemIssues.length)),
            issues: itemIssues,
            createdAt: Date.now(),
          };
        }
      }
    }
  } catch (error: unknown) {
    console.error("Order creation failed:", error);
    errorMessage =
      error instanceof Error ? error.message : copy.unexpectedErrorText;
  } finally {
    isProcessing = false;
  }
}

// Determine submit button label
const submitLabel = staleCustomerSession && checkoutConfig.guestCheckoutEnabled !== false
  ? copy.continueAsGuestText
  : codOnly
    ? copy.placeOrderText
    : checkoutUnavailable
      ? copy.checkoutUnavailableText
      : copy.continueToPaymentText;
const serializedCheckoutConfig = serializeJsonForInlineScript(checkoutConfig);
// One input style for every checkout field.
const labelClass = "mb-1 block text-sm font-medium text-foreground";
const fieldClass =
  "block h-11 w-full rounded-lg border border-input bg-background px-3 text-base text-foreground placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/30 aria-[invalid=true]:border-destructive";
const errorClass = "mt-1 hidden text-sm font-medium text-destructive";
const serializedCheckoutLanguage = serializeJsonForInlineScript(lang);
---

<Layout
  title={copy.pageTitle}
  layoutData={layoutData}
  documentLanguage={checkoutLanguageBaseCode(lang.code)}
  noindex
  hideHeader
  hideFooter
>
  <CheckoutHeader layoutData={layoutData} copy={copy} />
  <!-- Hidden checkout meta for client-side JS -->
  <script
    is:inline
    set:html={`window.__CHECKOUT_CONFIG__=${serializedCheckoutConfig};window.__CHECKOUT_LANGUAGE__=${serializedCheckoutLanguage};`}
  />
  {
    codCartRepairState && (
      <script
        is:inline
        id="codCartRepairState"
        type="application/json"
        set:html={serializeJsonForInlineScript(codCartRepairState)}
      />
    )
  }

  <div
    id="checkout-meta"
    data-cod-only={codOnly ? "true" : "false"}
    data-checkout-unavailable={checkoutUnavailable ? "true" : "false"}
    data-checkout-unavailable-message={checkoutUnavailableMessage}
    data-gateways={JSON.stringify(checkoutConfig.gateways)}
    data-guest-checkout-enabled={checkoutConfig.guestCheckoutEnabled !== false
      ? "true"
      : "false"}
    hidden
  >
  </div>

  <div
    id="cartPageRoot"
    data-cart-ready="false"
    data-cart-has-items="false"
    data-cart-state="loading"
    data-delivery-need="method"
    data-delivery-mode={pickupOnly ? "pickup" : "delivery"}
    data-mode-switch={deliveryModeSwitch ? "true" : "false"}
    class="group container mx-auto max-w-6xl px-4 pb-6 pt-5 sm:px-6 sm:pt-7"
  >
    {/* Before first paint: with nothing saved, the server-rendered empty state
        shows at once instead of after the page scripts load (PERF-01). */}
    {/* Also before first paint: a cart with nothing physical hides the
        delivery section, and a buyer who chose pickup sees no address fields,
        so neither moves the form once the scripts load. */}
    <script is:inline>
      (function () {
        try {
          var root = document.getElementById("cartPageRoot");
          var cart = JSON.parse(localStorage.getItem("cart:v3") || "null");
          var lines = cart && cart.items && typeof cart.items === "object" ? cart.items : {};
          var items = Object.keys(lines);
          var recovery = "scalius_hosted_payment_recovery";
          if (items.length === 0 && !sessionStorage.getItem("quickBuyData")
            && !localStorage.getItem(recovery) && !sessionStorage.getItem(recovery)) {
            root.dataset.cartState = "empty";
          }
          var physical = items.length === 0 || !!sessionStorage.getItem("quickBuyData") || items.some(function (key) {
            var kind = lines[key] && lines[key].fulfillmentKind;
            return !kind || kind === "physical";
          });
          if (!physical) root.dataset.deliveryNeed = "none";
          if (root.dataset.modeSwitch === "true") {
            var draft = JSON.parse(sessionStorage.getItem("scalius_checkout_form_draft") || "null");
            if (draft && draft.values && draft.values.deliveryMode === "pickup") root.dataset.deliveryMode = "pickup";
          }
        } catch (error) {}
      })();
    </script>
    <h1 class="sr-only">{copy.pageTitle}</h1>
    <noscript>
      {/* The lines live in browser storage: without scripts there is nothing
          to load, so no endless skeleton or empty form, only this note. */}
      <style>#cartPageRoot [data-cart-grid] { display: none; }</style>
      <div
        class="mb-3 rounded-lg border border-border bg-muted/50 px-3 py-2 text-sm text-foreground"
        role="alert"
      >
        {copy.noScriptText}
      </div>
    </noscript>
    <div class="group-data-[cart-state=empty]:hidden">
      <CheckoutProgress current="information" paymentRequired={!codOnly} copy={copy} />
    </div>
    {
      checkoutUnavailable && (
        <div
          class="mb-3 rounded-lg border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive"
          role="alert"
        >
          <strong class="font-semibold">{copy.checkoutUnavailableText}: </strong>
          <span>{checkoutUnavailableMessage}</span>
        </div>
      )
    }

    {
      errorMessage && (
        <div
          class="mb-3 rounded-lg border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive"
          role="alert"
        >
          {errorMessage}
        </div>
      )
    }
    {/* Quick buy lands here with ?quickBuyStorage=blocked when the browser
        refused session storage. The shell is shared by every buyer, so the
        notice is revealed from the URL in the browser, before first paint. */}
    <div
      id="quickBuyStorageNotice"
      class="mb-3 rounded-lg border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive"
      role="alert"
      hidden
    >
      {copy.quickBuyStorageBlockedText}
    </div>
    <script is:inline>
      (function () {
        try {
          if (new URLSearchParams(location.search).get("quickBuyStorage") === "blocked") {
            document.getElementById("quickBuyStorageNotice").hidden = false;
          }
        } catch {
          // An unreadable URL keeps the notice hidden.
        }
      })();
    </script>

    <aside
      id="checkoutRecoveryNotice"
      class="hidden mb-3 rounded-xl border border-border bg-muted px-4 py-3 text-foreground"
      role="status"
      aria-hidden="true"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-semibold">{copy.existingCheckoutTitle}</p>
          <p class="mt-1 text-sm text-muted-foreground">
            {existingCheckoutMessageBefore}<span id="checkoutRecoveryReference" class="font-mono"></span>{existingCheckoutMessageAfter}
          </p>
        </div>
        <a
          id="checkoutRecoveryLink"
          data-astro-prefetch="false"
          class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
        >
          {copy.reviewExistingCheckoutText}
        </a>
      </div>
    </aside>

    <!-- The form comes first in reading and keyboard order; on phones the cart shows above it. -->
    {/* The grid holds a screen of space from first paint, so the footer stays
        below the fold and does not move when the lines render (CLS). */}
    <div class="grid min-h-[100svh] content-start gap-4 lg:grid-cols-12 lg:gap-8" data-cart-grid>
      <div id="checkoutPanel" class="hidden order-2 min-w-0 lg:order-1 lg:col-span-7">
        <div id="checkoutSignInPrompt" class="mb-3" data-account-required={checkoutConfig.guestCheckoutEnabled === false ? "true" : "false"}>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-auth-modal', { detail: { intent: 'sign_in' } }))"
            class="flex min-h-11 w-full items-center justify-between gap-3 rounded-lg border border-border bg-card px-4 py-3 text-left text-sm text-foreground transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
          >
            <span class="font-medium">
              {checkoutConfig.guestCheckoutEnabled === false
                ? copy.signInToCheckoutText
                : copy.signInPromptText}
            </span>
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <div
          id="checkoutFormCard"
          class:list={[
            "rounded-xl border border-border bg-card p-4 sm:p-5",
            { hidden: checkoutConfig.guestCheckoutEnabled === false },
          ]}
        >
          <form
            method="POST"
            action="/cart"
            class="space-y-6"
            id="checkoutForm"
            novalidate
          >
            <input type="hidden" name="formIntent" value="checkout" />
            <input type="hidden" name="cartItems" id="cartItemsInput" />
            <input type="hidden" name="checkoutId" id="checkoutIdInput" />
            <input
              type="hidden"
              name="expectedQuoteFingerprint"
              id="expectedQuoteFingerprint"
            />
            <input
              type="hidden"
              name="discountCodes"
              id="discountCodesInput"
            />

            <section aria-labelledby="contactHeading" class="space-y-3">
              <h2 id="contactHeading" class="text-base font-semibold text-foreground">{copy.contactHeadingText}</h2>
              <div class="grid gap-3 sm:grid-cols-2">
                <div>
                  <label for="customerName" class={labelClass}>
                    {copy.customerNameLabel}
                    <span aria-hidden="true" class="ml-0.5 text-destructive">*</span>
                  </label>
                  <input
                    type="text"
                    id="customerName"
                    name="customerName"
                    autocomplete="name"
                    aria-required="true"
                    aria-describedby="customerName-error"
                    maxlength="100"
                    placeholder={copy.customerNamePlaceholder}
                    class={fieldClass}
                  />
                  <p id="customerName-error" class={errorClass} role="alert"></p>
                </div>

                <div>
                  <CheckoutPhoneField
                    label={copy.customerPhoneLabel}
                    help={copy.customerPhoneHelp}
                    pickupHelp={copy.customerPhonePickupHelp}
                    serviceHelp={copy.customerPhoneServiceHelp}
                    placeholder={copy.customerPhonePlaceholder}
                    allowedCountries={checkoutConfig.allowedCountries || []}
                    allowedCountriesMode={allowedCountriesMode}
                    requiredMessage={copy.phoneRequiredText}
                    invalidMessage={copy.phoneIntlInvalidText}
                    mobileMessage={copy.phoneInvalidText}
                    countryNotAcceptedMessage={copy.phoneCountryNotAcceptedText}
                    countrySelectLabel={copy.phoneCountryLabelText}
                    languageCode={lang.code}
                  />
                </div>

                {
                  lang.fieldVisibility.showEmailField && (
                    <div class="sm:col-span-2">
                      <label for="customerEmail" class={labelClass}>
                        {copy.customerEmailLabel}
                      </label>
                      <input
                        type="email"
                        id="customerEmail"
                        name="customerEmail"
                        autocomplete="email"
                        inputmode="email"
                        aria-describedby="customerEmail-error"
                        maxlength="254"
                        placeholder={copy.customerEmailPlaceholder}
                        class={fieldClass}
                      />
                      <p id="customerEmail-error" class={errorClass} role="alert"></p>
                    </div>
                  )
                }
              </div>
            </section>

            {/* Nothing physical in the cart (services): no delivery section. */}
            <p
              class="hidden rounded-lg border border-border bg-muted/50 px-3 py-2 text-sm text-foreground group-data-[delivery-need=none]:block"
              data-no-delivery-note
              role="status"
            >
              {copy.noDeliveryNeededText}
            </p>

            <section aria-labelledby="deliveryHeading" class="space-y-3 group-data-[delivery-need=none]:hidden" data-delivery-section>
              <h2 id="deliveryHeading" class="text-base font-semibold text-foreground">{copy.deliveryHeadingText}</h2>
              {
                deliveryModeSwitch && (
                  <fieldset class="grid grid-cols-2 gap-2" data-delivery-mode-switch>
                    <legend class="sr-only">{copy.deliveryMethodLegendText}</legend>
                    {([
                      ["delivery", copy.deliveryModeShipText],
                      ["pickup", copy.deliveryModePickupText],
                    ] as const).map(([mode, label]) => (
                      <label class="flex min-h-11 cursor-pointer items-center gap-2 rounded-lg border border-border bg-background px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted/50 has-[:checked]:border-primary has-[:checked]:ring-1 has-[:checked]:ring-primary has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-ring">
                        <input
                          type="radio"
                          name="deliveryMode"
                          value={mode}
                          checked={mode === "delivery"}
                          class="h-4 w-4 shrink-0 accent-primary"
                          onchange="document.getElementById('cartPageRoot').dataset.deliveryMode=this.value"
                        />
                        <span>{label}</span>
                      </label>
                    ))}
                  </fieldset>
                )
              }
              {pickupOnly && <input type="hidden" name="deliveryMode" value="pickup" />}
              {
                deliveryModeSwitch && (
                  <script is:inline>
                    (function () {
                      var root = document.getElementById("cartPageRoot");
                      var pickup = document.querySelector('input[name="deliveryMode"][value="pickup"]');
                      if (root && pickup && root.dataset.deliveryMode === "pickup") pickup.checked = true;
                    })();
                  </script>
                )
              }
              <fieldset class="min-w-0 space-y-3 border-0 p-0 group-data-[delivery-mode=pickup]:hidden" data-address-fields>
              <div>
                <label for="shippingAddress" class={labelClass}>
                  {copy.shippingAddressLabel}
                  <span aria-hidden="true" class="ml-0.5 text-destructive">*</span>
                </label>
                <textarea
                  id="shippingAddress"
                  name="shippingAddress"
                  autocomplete="street-address"
                  aria-required="true"
                  minlength={MIN_SHIPPING_ADDRESS_LENGTH}
                  maxlength="500"
                  aria-describedby="shippingAddressError"
                  placeholder={copy.shippingAddressPlaceholder}
                  rows={2}
                  class={`${fieldClass} h-auto min-h-16 resize-none py-2`}
                ></textarea>
                <p id="shippingAddressError" class={errorClass} role="alert"></p>
              </div>

              <div>
                <CheckoutLocationFields
                  cities={cities}
                  cityLabel={copy.cityLabel}
                  zoneLabel={copy.zoneLabel}
                  areaLabel={copy.areaLabel}
                  cityPlaceholder={copy.selectCityPlaceholder}
                  zonePlaceholder={copy.selectZonePlaceholder}
                  areaPlaceholder={copy.selectAreaPlaceholder}
                  zoneSearchPlaceholder={copy.zoneSearchPlaceholder}
                  loadingText={copy.loadingText}
                  zonesLoadFailedText={copy.zonesLoadFailedText}
                  areasLoadFailedText={copy.areasLoadFailedText}
                  showAreaField={lang.fieldVisibility.showAreaField}
                />
                <p id="shippingLocationError" class={errorClass} role="alert"></p>
              </div>
              </fieldset>

              <CheckoutShippingMethods
                shippingMethods={shippingMethods}
                shippingMethodLabel={copy.shippingMethodLabel}
                pickupLocationLabel={copy.pickupLocationLabel}
                modeSwitch={deliveryModeSwitch}
                freeText={copy.freeText}
                freeOverText={copy.freeOverText}
                waivedShippingFeeText={copy.waivedShippingFeeText}
                pickupFromText={copy.pickupFromText}
                pickupHoursText={copy.pickupHoursText}
                chooseAddressText={copy.chooseAddressForDeliveryText}
                noDeliveryText={copy.noDeliveryToAddressText}
                failedText={copy.deliveryOptionsFailedText}
                retryText={copy.retryText}
                loadingText={copy.loadingText}
                feeChangedText={copy.deliveryFeeChangedText}
                replacedText={copy.deliveryOptionReplacedText}
                replacedSameFeeText={copy.deliveryOptionReplacedSameFeeText}
                goneText={copy.deliveryOptionGoneText}
              />
            </section>

            {
              lang.fieldVisibility.showOrderNotesField && (
                <div>
                  <label for="notes" class={labelClass}>
                    {copy.orderNotesLabel}
                  </label>
                  <textarea
                    id="notes"
                    name="notes"
                    maxlength="500"
                    placeholder={copy.orderNotesPlaceholder}
                    rows={2}
                    class={`${fieldClass} h-auto min-h-16 resize-none py-2`}
                  ></textarea>
                </div>
              )
            }

            <div>
              <p
                id="checkoutFormMessage"
                class="mb-3 hidden rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive"
                role="alert"
                tabindex="-1"
              >
              </p>
              <button
                type="submit"
                class="flex h-12 w-full items-center justify-center rounded-lg bg-primary px-4 text-base font-semibold text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-50"
                id="submitButton"
                disabled
              >
                <span id="submitButtonText">
                  {isProcessing ? copy.processingText : submitLabel}
                </span>
              </button>

              {
                // Buyers are only asked to agree to policies the store has published.
                codOnly && hasAgreementPolicies && (
                  <p class="mt-3 text-center text-sm text-muted-foreground">
                    {agreement.map((segment) =>
                      segment.href ? (
                        <a href={segment.href} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-foreground">{segment.text}</a>
                      ) : (
                        segment.text
                      ),
                    )}
                  </p>
                )
              }
            </div>
          </form>
        </div>
      </div>

      <div
        id="cartColumn"
        class="order-1 min-w-0 lg:order-2 lg:col-span-5 lg:sticky lg:self-start group-data-[cart-state=empty]:lg:col-span-12"
        style="top: calc(var(--header-height, 64px) + 1rem);"
      >
        <section
          aria-labelledby="cartHeading"
          class="overflow-hidden rounded-xl border border-border bg-card group-data-[cart-state=empty]:mx-auto group-data-[cart-state=empty]:max-w-lg"
        >
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border px-4 py-3">
            <h2 id="cartHeading" class="text-lg font-semibold text-foreground">
              {copy.cartSectionTitle}
            </h2>
            <a
              href="/"
              class="inline-flex min-h-11 items-center gap-1.5 rounded-lg px-2 text-sm font-medium text-foreground underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-ring group-data-[cart-state=empty]:hidden sm:min-h-9"
            >
              <span aria-hidden="true">←</span>
              {copy.continueShoppingText}
            </a>
          </div>

          {/* Loading skeleton at a cart line's size; the real lines render
              hidden underneath and appear together with the summary. */}
          <div class="hidden p-4 group-data-[cart-state=loading]:block" data-cart-loading>
            <p class="sr-only" role="status">{copy.cartLoadingText}</p>
            <div class="flex gap-3 py-2" aria-hidden="true">
              <div class="theme-skeleton size-20 shrink-0"></div>
              <div class="flex-1 space-y-2 pt-1">
                <div class="theme-skeleton h-4 w-3/4"></div>
                <div class="theme-skeleton h-4 w-1/3"></div>
                <div class="theme-skeleton h-9 w-28"></div>
              </div>
            </div>
          </div>
          <div
            class="min-h-24 p-4 group-data-[cart-state=loading]:hidden"
            id="cartItems"
            aria-busy="true"
          >
            {/* The empty state as HTML, for the first paint; the cart script
                replaces it with the lines (renderEmptyCartState keeps it in step). */}
            <div class="text-center py-8 px-4" data-cart-empty>
              <svg class="mx-auto h-12 w-12 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <h3 class="mt-2 text-lg font-medium text-foreground">{copy.emptyCartText}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{copy.emptyCartDescriptionText}</p>
              <div class="mt-6 flex flex-col items-center justify-center gap-2 sm:flex-row">
                <a
                  href="/"
                  class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-primary-foreground bg-primary hover:bg-primary/90"
                >
                  <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a1 1 0 110 2H7.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                  </svg>
                  {copy.continueShoppingText}
                </a>
              </div>
            </div>
          </div>
          <p id="cartUndo" class="mx-4 mb-3 text-sm text-muted-foreground" role="status" hidden></p>

          <div
            id="cartSummary"
            class="hidden space-y-2 border-t border-border bg-muted/40 p-4"
          >
            <div class="flex justify-between text-sm text-muted-foreground">
              <span>{copy.subtotalText}</span>
              <span id="subtotal" class="font-medium tabular-nums text-foreground">—</span>
            </div>
            <div class="flex justify-between gap-3 text-sm text-muted-foreground group-data-[delivery-need=none]:hidden" id="shippingRow">
              <span>{copy.shippingText}</span>
              <span id="shippingCost" class="text-right font-medium tabular-nums text-foreground">—</span>
            </div>
            <p id="shippingProgress" class="hidden text-sm text-primary" role="status"></p>
            <div id="discountLines" class="space-y-1"></div>
            <div id="taxRow" class="hidden flex justify-between gap-3 text-sm text-muted-foreground">
              <span id="taxLabel">{copy.taxText}</span>
              <span id="taxAmount" class="text-right font-medium tabular-nums text-foreground">—</span>
            </div>

            <div class="mt-2 border-t border-border pt-2">
              <div class="flex items-baseline justify-between" aria-live="polite" aria-atomic="true">
                <span
                  id="totalLabel"
                  data-final-label={copy.totalText}
                  class="text-sm font-semibold text-foreground"
                  >{copy.estimatedTotalText}</span
                >
                <span id="total" class="text-xl font-semibold tabular-nums text-foreground">—</span>
              </div>
              <p id="taxStatus" class="mt-1 hidden text-sm text-destructive" role="status"></p>
            </div>

            <form id="discountForm" method="post" action="/cart" class="pt-3" novalidate>
              <label for="discountCodeInput" class="sr-only">{copy.discountCodePlaceholder}</label>
              <div class="flex gap-2">
                <input
                  type="text"
                  id="discountCodeInput"
                  aria-describedby="discountMessage"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  enterkeyhint="done"
                  maxlength="50"
                  placeholder={copy.discountCodePlaceholder}
                  class={`${fieldClass} min-w-0 flex-1`}
                />
                <button
                  type="submit"
                  id="applyDiscountBtn"
                  class="h-11 shrink-0 rounded-lg border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:opacity-50"
                >
                  {copy.applyDiscountText}
                </button>
              </div>
              <p id="discountMessage" class="mt-1.5 text-sm" role="status" aria-live="polite" hidden></p>
            </form>
            <ul id="appliedCodes" class="hidden flex flex-wrap gap-2 pt-1"></ul>
            <ul id="discountOffers" class="hidden space-y-2" role="status"></ul>
            {/* Cart-level availability answer: below the totals, never above
                painted lines, so it lands without moving them. */}
            <div
              id="cartValidationMessage"
              class="hidden mt-3 rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive"
              role="alert"
            >
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>

<CheckoutLoadingOverlay
  title={copy.processingOrderTitle}
  message={copy.processingOrderMessage}
/>

<script>
  import {
    initCartFunctionality,
    isDiscountValidationPending,
    resumeCartPageFromHistory,
    updateCheckoutButtonState,
  } from "@/lib/cart/client";
  import { getCustomerSession } from "@/lib/api/customer-auth";
  import {
    cartHasFreeDeliveryItem,
    cartItemsSubtotal,
    cartNeedsDeliveryMethod,
    cartStore,
    getEffectiveCartShippingFee,
  } from "@/store/cart";
  import { enhanceShippingMethods, fetchDeliveryRates } from "@/lib/checkout/shipping-methods";
  import {
    applyCheckoutDeliveryMode,
    checkoutAddressForMode,
    readCheckoutDeliveryMode,
  } from "@/lib/checkout/delivery-mode";
  import { formatMoney } from "@/lib/currency";
  import { browserApiUrl } from "@/lib/api/browser-url";
  import {
    enhanceLocationSelects,
    fetchLocationOptions,
    type LocationPrefillDetail,
  } from "@/lib/checkout/location-select";
  import {
    checkoutPhoneResult,
    initCheckoutPhoneField,
    loadCheckoutPhoneValidator,
  } from "@/lib/checkout/phone-field";
  import {
    clearCheckoutFormDraft,
    discardCheckoutFormDraftOfOtherOwner,
    readCheckoutFormDraft,
    readHostedPaymentRecoverySession,
    syncCheckoutTransferSession,
    writeCheckoutFormDraft,
    writeCheckoutTransferSession,
  } from "@/lib/checkout/session-state";
  import { rememberSubmittedCart } from "@/lib/checkout/receipt-finalization";
  import { findNamedCheckoutControl } from "@/lib/checkout/form-controls";
  import {
    checkoutInformationFields,
    enhanceCheckoutFields,
    setFieldError,
  } from "@/lib/checkout/field-validation";
  import {
    hideCheckoutLoadingOverlay,
    showCheckoutLoadingOverlay,
  } from "@/lib/checkout/loading-overlay";
  import type { CheckoutLanguageData as CheckoutLanguageStrings } from "@scalius/shared/checkout-language";

  type CustomerAutofillProfile = {
    customerId?: string | null;
    name?: string | null;
    phone?: string | null;
    email?: string | null;
    address?: string | null;
    city?: string | null;
    cityName?: string | null;
    zone?: string | null;
    zoneName?: string | null;
    area?: string | null;
    areaName?: string | null;
  };

  window.__scaliusCartPageAbortController?.abort();
  const cartPageAbortController = new AbortController();
  window.__scaliusCartPageAbortController = cartPageAbortController;
  const cartPageSignal = cartPageAbortController.signal;

  const meta = document.getElementById("checkout-meta");
  const codOnly = meta?.dataset.codOnly === "true";
  const checkoutUnavailable = meta?.dataset.checkoutUnavailable === "true";
  const guestCheckoutEnabled = meta?.dataset.guestCheckoutEnabled !== "false"; // default true
  // The frontmatter always serializes a fully resolved language (English
  // fallback included), so the browser never ships the default copy tables.
  const checkoutCopy = (
    window.__CHECKOUT_LANGUAGE__ as { languageData: CheckoutLanguageStrings }
  ).languageData;
  const checkoutUnavailableMessage =
    meta?.dataset.checkoutUnavailableMessage ||
    checkoutCopy.checkoutUnavailableMessage;

  const runWhenDomReady = (callback: () => void | Promise<void>) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => void callback(), {
        once: true,
        signal: cartPageSignal,
      });
      return;
    }

    void callback();
  };

  const isSignedIn = () =>
    document.cookie.split(";").some((c) => c.trim().startsWith("cs_auth=1"));
  const ownerOf = (customer: CustomerAutofillProfile) =>
    customer.customerId || customer.email || "customer";

  // A draft written by a guest (or another account) never follows a signed-in
  // buyer, and a signed-in buyer's draft never outlives their sign-out.
  if (!isSignedIn()) discardCheckoutFormDraftOfOtherOwner("guest");

  initCheckoutPhoneField(cartPageSignal);

  void initCartFunctionality();

  // Wired after the cart runtime so its listeners receive the initial
  // delivery-method and location events. The delivery options follow the
  // address, so they are wired first and re-read on every location change.
  const shippingMethods = enhanceShippingMethods(document, {
    loadRates: (address) => fetchDeliveryRates(browserApiUrl(""), address),
    readDraftMethod: () => readCheckoutFormDraft()?.shippingLocation,
    readSubtotal: () => cartItemsSubtotal(cartStore.get().items),
    isFeeWaived: () => cartHasFreeDeliveryItem(cartStore.get().items),
    formatMoney,
    readMode: () => readCheckoutDeliveryMode(),
    signal: cartPageSignal,
  });

  // The checkout path follows the cart (nothing physical: no delivery
  // section) and the buyer's Delivery/Pickup choice; the address fields are
  // left out of the form unless delivering.
  const syncDeliveryPath = () => {
    const root = document.getElementById("cartPageRoot");
    const { items } = cartStore.get();
    const need = Object.keys(items).length === 0 || cartNeedsDeliveryMethod(items) ? "method" : "none";
    if (root && root.dataset.deliveryNeed !== need) root.dataset.deliveryNeed = need;
    void shippingMethods?.setMode(applyCheckoutDeliveryMode(document));
  };
  syncDeliveryPath();
  document.addEventListener("cart-updated", syncDeliveryPath, { signal: cartPageSignal });
  document.getElementById("checkoutForm")?.addEventListener(
    "change",
    (event) => {
      if ((event.target as HTMLInputElement | null)?.name === "deliveryMode") syncDeliveryPath();
    },
    { signal: cartPageSignal },
  );
  window.addEventListener(
    "delivery-rate-changed",
    () => void shippingMethods?.recheck(),
    { signal: cartPageSignal },
  );
  window.addEventListener(
    "delivery-rate-rejected",
    () => void shippingMethods?.rejectSelected(),
    { signal: cartPageSignal },
  );
  const locationRoot = document.querySelector<HTMLElement>("[data-location-fields]");
  const locationSelects = locationRoot
    ? enhanceLocationSelects(locationRoot, {
        load: (level, parentId) =>
          fetchLocationOptions(browserApiUrl(""), level, parentId),
        onChange: (detail) => {
          window.dispatchEvent(
            new CustomEvent("checkout-location-change", { detail }),
          );
          void shippingMethods?.setAddress(detail);
        },
        signal: cartPageSignal,
      })
    : null;
  // An address already in the form (restored by the browser) gets its rates too.
  const formLocation = (name: string) => findNamedCheckoutControl(document, name)?.value ?? "";
  void shippingMethods?.setAddress({
    cityId: formLocation("city"),
    zoneId: formLocation("zone"),
    areaId: formLocation("area"),
  });
  window.addEventListener(
    "location-prefill",
    (event) =>
      void locationSelects?.prefill(
        (event as CustomEvent<LocationPrefillDetail>).detail ?? {},
      ),
    { signal: cartPageSignal },
  );
  // The merchant removed the city, thana or area the buyer chose: clear it,
  // list the level again without it, and say so once, at that field. The
  // totals follow the cleared address like any other change.
  window.addEventListener(
    "delivery-location-unavailable",
    (event) => {
      const field = (event as CustomEvent<{ field?: string }>).detail?.field;
      if (field !== "city" && field !== "zone" && field !== "area") return;
      const control = document.getElementById(`checkout-${field}`);
      const error = document.getElementById("shippingLocationError");
      if (control && error) {
        setFieldError({ control, error }, field === "city"
          ? checkoutCopy.cityUnavailableText
          : field === "zone" ? checkoutCopy.thanaUnavailableText : checkoutCopy.areaUnavailableText);
      }
      void locationSelects?.forget(field);
    },
    { signal: cartPageSignal },
  );

  const unsubscribeShippingFees = cartStore.subscribe(() =>
    shippingMethods?.refreshFees(),
  );
  cartPageSignal.addEventListener("abort", unsubscribeShippingFees, {
    once: true,
  });

  // ── Draft and account prefill ─────────────────────────────────────────────

  const buyerEditedFields = new Set<string>();
  const contactFields = ["customerName", "customerEmail", "shippingAddress", "notes"] as const;

  const setFieldValue = (name: string, value: string | null | undefined, overwrite: boolean) => {
    const el = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
    if (el && (overwrite || (!el.value && value))) el.value = value ?? "";
  };

  /** Empty fields take the account's saved details; the buyer's own edits win. */
  const fillBasicCustomerFields = (customer: CustomerAutofillProfile, overwrite = false) => {
    const draft = overwrite ? null : readCheckoutFormDraft();
    const pick = (field: keyof NonNullable<typeof draft>, fallback?: string | null) =>
      draft && field in draft ? draft[field] : fallback;
    if (!buyerEditedFields.has("customerName")) setFieldValue("customerName", pick("customerName", customer.name), overwrite);
    if (!buyerEditedFields.has("customerEmail")) setFieldValue("customerEmail", pick("customerEmail", customer.email), overwrite);
    if (!buyerEditedFields.has("shippingAddress")) setFieldValue("shippingAddress", pick("shippingAddress", customer.address), overwrite);
    const phone = pick("customerPhone", customer.phone);
    if (phone && !buyerEditedFields.has("customerPhone")) {
      // The field validates the profile phone against the store's policy.
      window.dispatchEvent(new CustomEvent("phone-prefill", { detail: phone }));
    }
  };

  const checkoutDraftFields = [
    "customerName",
    "customerPhone",
    "customerEmail",
    "deliveryMode",
    "shippingAddress",
    "city",
    "cityName",
    "zone",
    "zoneName",
    "area",
    "areaName",
    "shippingLocation",
    "notes",
  ] as const;

  let latestDraftLocation: {
    city?: string;
    cityName?: string;
    zone?: string;
    zoneName?: string;
    area?: string;
    areaName?: string;
  } = {};
  const readCheckoutFormValues = (captureAllFields = false) => {
    const draft = readCheckoutFormDraft();
    const values: Record<string, string> = {};
    for (const field of checkoutDraftFields) {
      const input = findNamedCheckoutControl(document, field);
      const inputValue =
        field === "customerPhone" &&
        input instanceof HTMLInputElement &&
        input.dataset.e164Value !== undefined
          ? input.dataset.e164Value
          : input?.value;
      // Initialization may snapshot empty controls before account prefill.
      // Only buyer edits or an explicit submit give those blanks draft ownership.
      if (
        !inputValue &&
        !buyerEditedFields.has(field) &&
        (!captureAllFields || (
          field === "customerPhone" && draft &&
          Object.prototype.hasOwnProperty.call(draft, field)
        ))
      ) {
        if (draft && field in draft) values[field] = draft[field] ?? "";
      } else if (input) values[field] = inputValue ?? "";
      else if (draft && field in draft) values[field] = draft[field] ?? "";
    }
    Object.assign(values, latestDraftLocation);
    return values;
  };

  const syncExistingCheckoutTransfer = (values: Record<string, string>) => {
    const cartItems = (
      document.getElementById("cartItemsInput") as HTMLInputElement | null
    )?.value;
    const checkoutId = (
      document.getElementById("checkoutIdInput") as HTMLInputElement | null
    )?.value;
    const discountCodes = (
      document.getElementById("discountCodesInput") as HTMLInputElement | null
    )?.value;
    const expectedQuoteFingerprint = (
      document.getElementById("expectedQuoteFingerprint") as HTMLInputElement | null
    )?.value;
    const shippingMethodId = window.lastShippingEventDetail?.id;
    const shippingMethodName = window.lastShippingEventDetail?.name;
    let shippingCharge = "";
    if (cartItems && window.lastShippingEventDetail) {
      try {
        shippingCharge = String(
          getEffectiveCartShippingFee(
            JSON.parse(cartItems),
            window.lastShippingEventDetail.fee,
            window.lastShippingEventDetail.freeOver,
          ),
        );
      } catch {
        shippingCharge = "";
      }
    }
    syncCheckoutTransferSession({
      ...values,
      ...(cartItems ? { cartItems } : {}),
      ...(checkoutId ? { checkoutId } : {}),
      ...(discountCodes !== undefined ? { discountCodes } : {}),
      ...(expectedQuoteFingerprint ? { expectedQuoteFingerprint } : {}),
      ...(shippingMethodId ? { shippingMethodId } : {}),
      ...(shippingMethodName ? { shippingMethodName } : {}),
      ...(shippingCharge ? { shippingCharge } : {}),
    });
  };

  const persistCheckoutFormDraftNow = (captureAllFields = false) => {
    const values = readCheckoutFormValues(captureAllFields);
    writeCheckoutFormDraft(values);
    syncExistingCheckoutTransfer(values);
  };

  let draftWriteTimer: number | null = null;
  const persistCheckoutFormDraft = () => {
    if (draftWriteTimer !== null) window.clearTimeout(draftWriteTimer);
    draftWriteTimer = window.setTimeout(() => {
      draftWriteTimer = null;
      persistCheckoutFormDraftNow();
    }, 120);
  };

  document.addEventListener(
    "astro:before-swap",
    () => {
      if (draftWriteTimer !== null) {
        window.clearTimeout(draftWriteTimer);
        draftWriteTimer = null;
      }
      persistCheckoutFormDraftNow();
      cartPageAbortController.abort();
    },
    { once: true, signal: cartPageSignal },
  );

  // A signed-in buyer's draft is restored only once the account confirms it is theirs.
  const restoreCheckoutFormDraft = (ownerVerified = !isSignedIn()) => {
    const draft = ownerVerified ? readCheckoutFormDraft() : null;
    if (!draft) return;
    for (const field of contactFields) setFieldValue(field, draft[field], false);
    if (draft.customerPhone) {
      window.dispatchEvent(
        new CustomEvent("phone-prefill", { detail: draft.customerPhone }),
      );
    }
  };

  /** Clears every contact and address field (another person's draft, or sign-out). */
  const clearCustomerFields = () => {
    for (const field of contactFields) setFieldValue(field, "", true);
    const phone = document.getElementById("customerPhone-input") as HTMLInputElement | null;
    if (phone) phone.value = "";
    buyerEditedFields.clear();
  };

  runWhenDomReady(() => {
    restoreCheckoutFormDraft();
    const form = document.getElementById("checkoutForm");
    const handleBuyerFieldEdit = (event: Event) => {
      const input = event.target;
      if (
        event.isTrusted &&
        (input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)
      ) {
        const field = input.id === "customerPhone-input" ? "customerPhone" : input.name;
        if (checkoutDraftFields.some((name) => name === field)) {
          buyerEditedFields.add(field);
        }
      }
      persistCheckoutFormDraft();
    };
    form?.addEventListener("input", handleBuyerFieldEdit, {
      signal: cartPageSignal,
    });
    form?.addEventListener("change", handleBuyerFieldEdit, {
      signal: cartPageSignal,
    });
    window.addEventListener(
      "checkout-location-change",
      (event) => {
        const detail = (event as CustomEvent<Record<string, unknown>>).detail;
        latestDraftLocation = {
          city: typeof detail?.cityId === "string" ? detail.cityId : "",
          cityName: typeof detail?.cityName === "string" ? detail.cityName : "",
          zone: typeof detail?.zoneId === "string" ? detail.zoneId : "",
          zoneName: typeof detail?.zoneName === "string" ? detail.zoneName : "",
          area: typeof detail?.areaId === "string" ? detail.areaId : "",
          areaName: typeof detail?.areaName === "string" ? detail.areaName : "",
        };
        persistCheckoutFormDraft();
      },
      { signal: cartPageSignal },
    );
    window.addEventListener("shippingLocationChange", persistCheckoutFormDraft, {
      signal: cartPageSignal,
    });
    window.addEventListener(
      "pagehide",
      () => persistCheckoutFormDraftNow(),
      { signal: cartPageSignal },
    );
    document.addEventListener("cart-updated", persistCheckoutFormDraft, {
      signal: cartPageSignal,
    });

    const draft = isSignedIn() ? null : readCheckoutFormDraft();
    if (draft?.city || draft?.cityName) {
      void locationSelects?.prefill({
        city: draft.city,
        cityName: draft.cityName,
        zone: draft.zone,
        zoneName: draft.zoneName,
        area: draft.area,
        areaName: draft.areaName,
      });
    }
  });

  // City/Zone/Area for a signed-in customer.
  const fillLocationDropdowns = (customer: CustomerAutofillProfile, overwrite = false) => {
    try {
      if (!overwrite && (latestDraftLocation.city || latestDraftLocation.cityName)) return;
      const draft = overwrite ? null : readCheckoutFormDraft();
      const draftOwnsLocation = Boolean(
        draft && ["city", "cityName", "zone", "zoneName", "area", "areaName"]
          .some((field) => Object.prototype.hasOwnProperty.call(draft, field)),
      );
      const preferred = draftOwnsLocation
        ? {
            city: draft?.city,
            cityName: draft?.cityName,
            zone: draft?.zone,
            zoneName: draft?.zoneName,
            area: draft?.area,
            areaName: draft?.areaName,
          }
        : customer;
      if (!preferred?.cityName && !preferred?.city) return;
      if (!overwrite) {
        const existingCity =
          document.querySelector<HTMLSelectElement>('select[name="city"]')?.value;
        const existingZone =
          document.querySelector<HTMLSelectElement>('select[name="zone"]')?.value;
        if (existingCity || existingZone) return;
      }
      window.dispatchEvent(
        new CustomEvent("location-prefill", {
          detail: {
            city: preferred.city,
            cityName: preferred.cityName,
            zone: preferred.zone,
            zoneName: preferred.zoneName,
            area: preferred.area,
            areaName: preferred.areaName,
          },
        }),
      );
    } catch (err: unknown) {
      console.error("Cart autofill location err:", err);
    }
  };

  const revealCheckoutFormForCustomer = () => {
    document.getElementById("checkoutSignInPrompt")?.classList.add("hidden");
    document.getElementById("checkoutFormCard")?.classList.remove("hidden");
  };

  // 1. Page load: a signed-in buyer's empty fields take their saved details.
  runWhenDomReady(async () => {
    if (!isSignedIn() && guestCheckoutEnabled) return;
    const session = await getCustomerSession();
    if (session.unavailable) {
      console.warn(
        "Customer session autofill skipped:",
        session.error || "Account status could not be read.",
      );
      return;
    }
    if (session?.authenticated && session.customer) {
      discardCheckoutFormDraftOfOtherOwner(ownerOf(session.customer));
      restoreCheckoutFormDraft(true);
      fillBasicCustomerFields(session.customer);
      fillLocationDropdowns(session.customer);
      revealCheckoutFormForCustomer();
    } else if (discardCheckoutFormDraftOfOtherOwner("guest")) {
      clearCustomerFields();
    }
  });

  // 2. Signing in from checkout: the account's details replace what was typed
  // before (possibly someone else's), and the cart stays.
  window.addEventListener(
    "customer-login",
    ((e: CustomEvent<CustomerAutofillProfile>) => {
      if (cartPageSignal.aborted) return;
      const customer = e.detail;
      clearCheckoutFormDraft();
      discardCheckoutFormDraftOfOtherOwner(ownerOf(customer));
      buyerEditedFields.clear();
      fillBasicCustomerFields(customer, true);
      fillLocationDropdowns(customer, true);
      revealCheckoutFormForCustomer();
      persistCheckoutFormDraftNow();
    }) as EventListener,
    { signal: cartPageSignal },
  );

  // 3. Signing out: the next person on this phone sees an empty form.
  window.addEventListener(
    "customer-logout",
    () => {
      clearCheckoutFormDraft();
      discardCheckoutFormDraftOfOtherOwner("guest");
      clearCustomerFields();
    },
    { signal: cartPageSignal },
  );

  // ── Submit ──

  runWhenDomReady(() => {
    const form = document.getElementById("checkoutForm") as HTMLFormElement;
    const submitButton = document.getElementById(
      "submitButton",
    ) as HTMLButtonElement;
    const submitButtonText = document.getElementById("submitButtonText");
    const isCartEmpty = () => {
      const input = document.getElementById(
        "cartItemsInput",
      ) as HTMLInputElement;
      return !input?.value || input.value === "{}" || input.value === "[]";
    };

    const initialSubmitText = submitButtonText?.textContent?.trim() || checkoutCopy.placeOrderText;
    const checkoutFormMessage = document.getElementById("checkoutFormMessage");
    let submitAfterCustomerSessionCheck = false;
    let submitAfterCartValidation = false;
    let awaitingPhoneValidator = false;

    const setSubmitButtonText = (text: string) => {
      if (submitButtonText) submitButtonText.textContent = text;
    };

    const restoreSubmitButton = () => {
      setSubmitButtonText(initialSubmitText);
      updateCheckoutButtonState();
    };

    const showCheckoutFormError = (message: string, focusTarget?: HTMLElement | null) => {
      if (!checkoutFormMessage) return;
      checkoutFormMessage.textContent = message;
      checkoutFormMessage.classList.remove("hidden");
      checkoutFormMessage.scrollIntoView?.({ behavior: "smooth", block: "center" });
      (focusTarget ?? checkoutFormMessage).focus({ preventScroll: true });
    };

    const clearCheckoutFormError = () => {
      if (!checkoutFormMessage) return;
      checkoutFormMessage.textContent = "";
      checkoutFormMessage.classList.add("hidden");
    };

    const showCheckoutTransferError = (message: string) => {
      restoreSubmitButton();
      hideCheckoutLoadingOverlay();

      const messageEl = document.getElementById("cartValidationMessage");
      if (!messageEl) {
        showCheckoutFormError(message, submitButton);
        return;
      }

      messageEl.textContent = message;
      messageEl.classList.remove("hidden");
      messageEl.scrollIntoView?.({ behavior: "smooth", block: "center" });
    };

    updateCheckoutButtonState();
    document.addEventListener("cart-updated", updateCheckoutButtonState, {
      signal: cartPageSignal,
    });
    document.addEventListener("discount-validation-state", updateCheckoutButtonState, {
      signal: cartPageSignal,
    });

    if (!form || !submitButton) return;

    window.addEventListener(
      "pageshow",
      (event) => {
        if (!(event as PageTransitionEvent).persisted) return;
        submitAfterCustomerSessionCheck = false;
        submitAfterCartValidation = false;
        hideCheckoutLoadingOverlay({ restoreFocus: false });
        restoreSubmitButton();
        void resumeCartPageFromHistory();
      },
      { signal: cartPageSignal },
    );

    const fields = enhanceCheckoutFields(
      checkoutInformationFields(form, checkoutCopy, () => readCheckoutDeliveryMode()),
      cartPageSignal,
    );
    // A restored draft never blurred: say now if a typed value (an email) is wrong.
    fields.checkFilled();

    /**
     * Marks every problem under its field at once, then moves to the first
     * one (the phone field reports its own message in place).
     */
    const validateInformation = (): boolean => {
      const firstField = fields.validateAll();
      const phone = checkoutPhoneResult();
      const phoneMessage = phone.ok
        ? ""
        : phone.message === "required"
          ? checkoutCopy.phoneRequiredText
          : phone.message === "country"
            ? checkoutCopy.phoneCountryNotAcceptedText
            : phone.message === "invalid"
              ? checkoutCopy.phoneIntlInvalidText
              : checkoutCopy.phoneInvalidText;
      if (phoneMessage) {
        window.dispatchEvent(new CustomEvent("phone-validation-error", {
          detail: { name: "customerPhone", message: phoneMessage, focus: false },
        }));
      }
      const phoneInput = document.getElementById("customerPhone-input");
      const nameInput = document.getElementById("customerName");
      // Visual order: name, phone, then the rest.
      let first: HTMLElement | null = firstField;
      if (phoneMessage && phoneInput && (!first || first !== nameInput)) first = phoneInput;
      if (!first) return true;
      first.scrollIntoView?.({ behavior: "smooth", block: "center" });
      const focusable = first.matches("fieldset")
        ? first.querySelector<HTMLElement>("input:checked, input")
        : first;
      focusable?.focus({ preventScroll: true });
      return false;
    };

    form.addEventListener(
      "submit",
      async (e) => {
        clearCheckoutFormError();
        if (isDiscountValidationPending()) {
          e.preventDefault();
          restoreSubmitButton();
          return;
        }
        if (checkoutPhoneResult().pending) {
          // Numbers outside the Bangladesh-mobile fast path need the full
          // validator first; the resubmitted pass then validates synchronously.
          e.preventDefault();
          if (awaitingPhoneValidator) return;
          awaitingPhoneValidator = true;
          submitButton.disabled = true;
          await loadCheckoutPhoneValidator();
          awaitingPhoneValidator = false;
          restoreSubmitButton();
          form.requestSubmit();
          return;
        }
        if (checkoutUnavailable) {
          e.preventDefault();
          showCheckoutFormError(checkoutUnavailableMessage, submitButton);
          return;
        }

        const pendingCheckout = readHostedPaymentRecoverySession();
        if (pendingCheckout) {
          e.preventDefault();
          restoreSubmitButton();
          const recoveryLink = document.getElementById("checkoutRecoveryLink") as HTMLAnchorElement | null;
          showCheckoutFormError(
            checkoutCopy.reviewExistingCheckoutText,
            recoveryLink ?? submitButton,
          );
          return;
        }

        // Guest Checkout Interception
        if (!guestCheckoutEnabled && !submitAfterCustomerSessionCheck) {
          e.preventDefault();
          submitButton.disabled = true;
          setSubmitButtonText(checkoutCopy.checkingAccountText);

          const session = await getCustomerSession();
          if (isDiscountValidationPending()) {
            restoreSubmitButton();
            return;
          }
          if (session.unavailable) {
            restoreSubmitButton();
            showCheckoutFormError(
              session.error ||
                checkoutCopy.accountUnavailableText,
              submitButton,
            );
            return;
          }

          if (!session.authenticated) {
            restoreSubmitButton();
            window.dispatchEvent(new CustomEvent("open-auth-modal"));
            return;
          }

          if (codOnly) {
            submitAfterCustomerSessionCheck = true;
            form.requestSubmit();
            return;
          }
        }

        if (submitAfterCustomerSessionCheck) {
          submitAfterCustomerSessionCheck = false;
        }

        if (isCartEmpty()) {
          e.preventDefault();
          restoreSubmitButton();
          showCheckoutFormError(
            checkoutCopy.cartEmptyErrorText,
            submitButton,
          );
          return;
        }

        // Persist the current DOM immediately so explicit empty edits replace
        // older draft values before any async validation or navigation.
        persistCheckoutFormDraftNow(true);

        if (!validateInformation()) {
          e.preventDefault();
          restoreSubmitButton();
          return;
        }
        const phoneValidation = checkoutPhoneResult();

        const expectedQuoteFingerprintInput = document.getElementById(
          "expectedQuoteFingerprint",
        ) as HTMLInputElement | null;
        if (
          codOnly &&
          !/^taxq_[A-Za-z0-9_-]{22}$/.test(expectedQuoteFingerprintInput?.value ?? "")
        ) {
          e.preventDefault();
          restoreSubmitButton();
          showCheckoutFormError(
            checkoutCopy.totalVerificationFailedText,
            submitButton,
          );
          return;
        }

        if (!submitAfterCartValidation) {
          e.preventDefault();
          submitButton.disabled = true;
          setSubmitButtonText(checkoutCopy.checkingCartText);
          // A delivery rate the merchant removed or repriced since the buyer chose
          // it: say what changed next to the options and let the buyer review first.
          if (await shippingMethods?.recheck()) {
            restoreSubmitButton();
            return;
          }
          const cartIsValid = await (window.validateCartSnapshot?.() ??
            Promise.resolve(true));
          if (isDiscountValidationPending()) {
            restoreSubmitButton();
            return;
          }
          if (!cartIsValid || window.hasCartValidationIssues?.() === true) {
            restoreSubmitButton();
            // A removed thana is asked for again at its own field.
            const locationControl = document.querySelector<HTMLElement>(
              '[data-location-fields] [aria-invalid="true"]',
            );
            if (locationControl) {
              locationControl.scrollIntoView?.({ behavior: "smooth", block: "center" });
              locationControl.focus({ preventScroll: true });
              return;
            }
            // A refused delivery rate is explained next to the delivery options,
            // never with the cart-items copy.
            const blocked = window.getCartBlockedMessage?.();
            if (blocked || !document.querySelector("[data-shipping-notice]:not(.hidden)")) {
              showCheckoutFormError(blocked || checkoutCopy.reviewCartItemsText, submitButton);
            }
            return;
          }

          if (codOnly) {
            submitAfterCartValidation = true;
            form.requestSubmit();
            return;
          }
        }

        if (submitAfterCartValidation) {
          submitAfterCartValidation = false;
        }

        const submittedCart =
          (document.getElementById("cartItemsInput") as HTMLInputElement | null)?.value ?? "{}";

        if (!codOnly) {
          // ── Multi-gateway flow: intercept and redirect to /checkout ──
          e.preventDefault();

          const formData = new FormData(form);
          const checkoutData: Record<string, string> = {};
          formData.forEach((value, key) => {
            checkoutData[key] = value as string;
          });
          checkoutData.customerPhone = phoneValidation.value;

          // The address travels only when something ships: a pickup or
          // service order carries none (the disabled address fieldset is not
          // in the form data; the location controls are read here).
          const deliveryMode = readCheckoutDeliveryMode();
          checkoutData.deliveryMode = deliveryMode;
          const locationValue = (name: string) => findNamedCheckoutControl(document, name)?.value;
          Object.assign(checkoutData, checkoutAddressForMode(deliveryMode, {
            shippingAddress: locationValue("shippingAddress"),
            city: locationValue("city"),
            zone: locationValue("zone"),
            area: locationValue("area"),
            cityName: locationValue("cityName"),
            zoneName: locationValue("zoneName"),
            areaName: locationValue("areaName"),
          }));
          for (const field of Object.keys(checkoutData)) {
            if (checkoutData[field] === null || checkoutData[field] === undefined) delete checkoutData[field];
          }

          // The delivery or pickup option chosen (validation required one); none without physical items.
          const chosenMethod = deliveryMode === "none" ? undefined : window.lastShippingEventDetail;
          const shippingLocation = locationValue("shippingLocation");
          if (chosenMethod && shippingLocation) checkoutData.shippingLocation = shippingLocation;
          else delete checkoutData.shippingLocation;

          checkoutData["shippingCharge"] = String(chosenMethod
            ? getEffectiveCartShippingFee(JSON.parse(submittedCart), chosenMethod.fee, chosenMethod.freeOver)
            : 0);
          if (chosenMethod) {
            checkoutData["shippingMethodId"] = chosenMethod.id;
            checkoutData["shippingMethodName"] = chosenMethod.name;
            if (chosenMethod.kind === "pickup") {
              if (chosenMethod.pickupAddress) checkoutData.pickupAddress = chosenMethod.pickupAddress;
              if (chosenMethod.pickupHours) checkoutData.pickupHours = chosenMethod.pickupHours;
            }
          }

          const transferWrite = writeCheckoutTransferSession(
            checkoutData,
            meta?.dataset.gateways || "[]",
          );
          if (!transferWrite.ok) {
            showCheckoutTransferError(transferWrite.message);
            return;
          }

          submitButton.disabled = true;
          setSubmitButtonText(checkoutCopy.redirectingToPaymentText);

          showCheckoutLoadingOverlay({
            title: checkoutCopy.openingPaymentOptionsTitle,
            message: checkoutCopy.openingPaymentOptionsMessage,
          });
          window.location.href = "/checkout";
          return;
        }

        // ── COD-only flow: normal form POST ──
        rememberSubmittedCart(submittedCart);
        submitButton.disabled = true;
        setSubmitButtonText(checkoutCopy.processingText);
        showCheckoutLoadingOverlay({
          title: checkoutCopy.processingOrderTitle,
          message: checkoutCopy.processingOrderMessage,
        });
      },
      { signal: cartPageSignal },
    );
  });
</script>
