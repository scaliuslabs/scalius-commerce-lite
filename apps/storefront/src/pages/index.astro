---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Collection2 from "@/components/collection2.astro";
import Collection1 from "../components/collection1.astro";
import Hero from "@/components/hero.astro";
import HomepageCategoryRail from "@/components/homepage/HomepageCategoryRail.astro";
import HomepageTrustStrip from "@/components/homepage/HomepageTrustStrip.astro";
import { getHomepageData, type CollectionWithProducts } from "@/lib/api";
import { loadPageWithLayout } from "@/lib/page-data";
import { buildAbsoluteStorefrontSeoUrl } from "@/lib/seo-base-url";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { getOptimizedImageUrl } from "@/lib/image-optimizer";
import {
  HERO_SLIDE_DEFAULT_FOCAL_POINT,
  getHeroSlideImageTransform,
} from "@scalius/shared/hero-slider";

// Parallel fetch: layout data + homepage data
const { layoutData, pageData: homepageData } = await loadPageWithLayout(() =>
  getHomepageData(),
);

if (!layoutData || !homepageData) {
  const response = storefrontDataUnavailableResponse(
    "We could not load the storefront homepage data. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const seo = homepageData?.seo ?? {
  siteTitle: null as string | null,
  homepageTitle: null as string | null,
  homepageMetaDescription: null as string | null,
};
const hero = homepageData?.hero || { desktop: null, mobile: null };
const firstDesktopHero = hero.desktop?.images?.[0] ?? null;
const firstMobileHero = hero.mobile?.images?.[0] ?? null;
const desktopHeroPreload = firstDesktopHero
  ? getOptimizedImageUrl(firstDesktopHero.url, {
      ...getHeroSlideImageTransform(
        "desktop",
        firstDesktopHero.focalPoint ?? HERO_SLIDE_DEFAULT_FOCAL_POINT,
        { quality: 90 },
      ),
    })
  : "";
const mobileHeroPreload = firstMobileHero
  ? getOptimizedImageUrl(firstMobileHero.url, {
      ...getHeroSlideImageTransform(
        "mobile",
        firstMobileHero.focalPoint ?? HERO_SLIDE_DEFAULT_FOCAL_POINT,
        { quality: 85 },
      ),
    })
  : "";
const activeCollections = homepageData?.collections || [];
const presentation = homepageData.presentation;
const firstCollection = activeCollections[0] ?? null;
const remainingCollections = activeCollections.slice(1);

const homepageTitle =
  seo.homepageTitle || seo.siteTitle || "Welcome to Our Store";
const homepageMetaDescription =
  seo.homepageMetaDescription || "Find the best products here.";
const homepageHeading =
  seo.siteTitle?.trim() ||
  layoutData.business?.companyName?.trim() ||
  layoutData.business?.legalName?.trim() ||
  homepageTitle;

import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;

// --- SEO: canonical URL for homepage ---
const canonicalUrl = buildAbsoluteStorefrontSeoUrl("/");

function isCollection1(
  collection: CollectionWithProducts,
): collection is CollectionWithProducts & { presentation: "grid" } {
  return collection.presentation === "grid";
}

function isCollection2(
  collection: CollectionWithProducts,
): collection is CollectionWithProducts & { presentation: "carousel" } {
  return collection.presentation === "carousel";
}
---

<Layout
  title={homepageTitle}
  description={homepageMetaDescription}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  ogType="website"
>
  <Fragment slot="head">
    {
      mobileHeroPreload && (
        <link
          rel="preload"
          as="image"
          href={mobileHeroPreload}
          media="(max-width: 767px)"
          fetchpriority="high"
        />
      )
    }
    {
      desktopHeroPreload && (
        <link
          rel="preload"
          as="image"
          href={desktopHeroPreload}
          media="(min-width: 768px)"
          fetchpriority="high"
        />
      )
    }
  </Fragment>

  <h1 class="sr-only">{homepageHeading}</h1>

  <section class="w-full">
    <Hero hero={hero} />
  </section>

  <div class="flex flex-col">
    {
      firstCollection && (
        <Fragment key={firstCollection.id}>
          {isCollection1(firstCollection) && (
            <Collection1
              collection={firstCollection}
              currencySymbol={currencySymbol}
              currencyCode={currencyCode}
            />
          )}
          {isCollection2(firstCollection) && (
            <Collection2
              collection={firstCollection}
              currencySymbol={currencySymbol}
              currencyCode={currencyCode}
            />
          )}
        </Fragment>
      )
    }

    <HomepageCategoryRail rail={presentation.categoryRail} />

    {
      remainingCollections.map((collection) => (
        <Fragment key={collection.id}>
          {isCollection1(collection) && (
            <Collection1
              collection={collection}
              currencySymbol={currencySymbol}
              currencyCode={currencyCode}
            />
          )}
          {isCollection2(collection) && (
            <Collection2
              collection={collection}
              currencySymbol={currencySymbol}
              currencyCode={currencyCode}
            />
          )}
        </Fragment>
      ))
    }

    <HomepageTrustStrip strip={presentation.trustStrip} />
  </div>
</Layout>
