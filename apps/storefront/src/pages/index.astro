---
import { presenceMarketCountries } from "@/lib/checkout/shipping-country";
import { getRuntimePresence } from "@/lib/api/runtime";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import HomepageSections from "@/components/homepage/HomepageSections.astro";
import {
  getCheckoutConfig, isCheckoutConfigReadFailure,
  getHomepageData,
  getThemePreviewHomepageSections,
  getShippingMethods,
} from "@/lib/api";
import { loadPageWithLayout } from "@/lib/page-data";
import { buildDeliveryFacts } from "@/lib/delivery-facts";
import { formatMoney } from "@/lib/currency";
import { resolveStoreDisplayName } from "@/lib/store-identity";
import { heroLeadCandidates } from "@/lib/homepage-hero";
import { homepageLandingPath } from "@/lib/homepage-landing";
import {
  EMPTY_HOMEPAGE_SECTION_DATA,
  homepageCategoryTiles,
  homepageContent,
  homepageHero,
  homepageLeadSection,
  homepageLead,
  homepagePhoneSections,
  homepageSectionRenders,
} from "@/lib/homepage-sections";
import {
  buildAbsoluteStorefrontSeoUrl,
  getAbsoluteStorefrontSeoBaseUrl,
} from "@/lib/seo-base-url";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import { MEDIA_DISCOVERY_IMAGE_WIDTH } from "@scalius/shared/media-variants";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import { homeSectionsShowDeliveryFacts } from "@scalius/shared/storefront-theme";
import { applyRequestThemeBindings, resolveRequestTheme } from "@/lib/storefront-theme-context";

// One batch: layout, homepage (with every section's products, images,
// categories and collections), and the delivery facts a delivery-facts strip
// shows (read speculatively so they add no second round trip).
const shippingMethodsPromise = getShippingMethods();
const checkoutConfigPromise = getCheckoutConfig();
const { layoutData, pageData: homepageData } = await loadPageWithLayout(() =>
  getHomepageData(),
);

if (!layoutData || !homepageData) {
  const response = storefrontDataUnavailableResponse(
    "We could not load the storefront homepage data. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

// Theme -> Homepage: the theme document's sections, in order. The homepage
// read carries the published theme's section data; a dashboard preview of
// a draft reads its own behind the preview token (a second, private read,
// only under the preview cookie), so slides, tiles, collections and the
// product home all preview with the draft.
const requestTheme = await resolveRequestTheme(Astro, layoutData);
let sectionData = homepageData.sections ?? EMPTY_HOMEPAGE_SECTION_DATA;
if (requestTheme.preview && requestTheme.previewToken) {
  const previewData = await getThemePreviewHomepageSections(requestTheme.previewToken, { presence: getRuntimePresence() });
  if (previewData === null) return storefrontDataUnavailableResponse();
  sectionData = previewData;
}

if (sectionData.bindingObjects) applyRequestThemeBindings(requestTheme, { objects: sectionData.bindingObjects, mediaIds: new Set(sectionData.media.map((asset) => asset.id)) });
const homeSections = requestTheme.resolved.pages.home;

// A product homepage answers `/` with its product's own page while that
// product is public; otherwise `/` renders the sections.
const landingPath = homepageLandingPath(requestTheme.resolved.pages.homeMode, sectionData.homeProduct);
if (landingPath) return Astro.redirect(landingPath, 302);

const seo = homepageData.seo ?? {
  homepageTitle: null as string | null,
  homepageMetaDescription: null as string | null,
};

const storeName = resolveStoreDisplayName(
  layoutData.business,
  getAbsoluteStorefrontSeoBaseUrl(),
);
// Layout appends the store name, so an unset homepage title is just the name.
const homepageTitle = seo.homepageTitle || storeName || "Home";
const homepageMetaDescription = seo.homepageMetaDescription || undefined;
const homepageHeading = storeName || homepageTitle || "Shop";

const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;

// Delivery facts come from the same live data product pages use, read only
// when a section shows them.
const showsDeliveryFacts = homeSectionsShowDeliveryFacts(homeSections);
const [shippingMethods, checkoutConfig] = await Promise.all([
  showsDeliveryFacts ? shippingMethodsPromise : Promise.resolve(null),
  showsDeliveryFacts ? checkoutConfigPromise : Promise.resolve(null),
]);
if (requestTheme.preview && showsDeliveryFacts && (shippingMethods === null || checkoutConfig === null || isCheckoutConfigReadFailure(checkoutConfig))) {
  return storefrontDataUnavailableResponse();
}
const deliveryFacts = showsDeliveryFacts
  ? buildDeliveryFacts({
      shippingMethods,
      checkoutConfig,
      returnPolicy: layoutData.seo?.returnPolicy,
      formatMoney: (amount) => formatMoney(amount, { code: currencyCode, symbol: currencySymbol }),
      // Only delivery to the page's market's countries is stated.
      countries: presenceMarketCountries(layoutData.markets, getRuntimePresence()),
    })
  : [];

const content = homepageContent(sectionData, deliveryFacts);
const leadSection = homepageLeadSection(homeSections, content);
const phoneSections = homepagePhoneSections(homeSections, content);
const headerLead = homepageLead(homeSections, phoneSections, content);
const phoneHeroMoved = phoneSections !== homeSections;
const phoneLeadSection = phoneHeroMoved ? homepageLeadSection(phoneSections, content, true) : leadSection;
// Preload the banner only when it is the first thing buyers see: the same
// candidates the hero's first slide offers, so the preload is the file the
// banner paints (a phone-sized rendition on phones).
const heroPreloads = leadSection?.type === "hero" && homepageSectionRenders(leadSection, content)
  ? heroLeadCandidates(homepageHero(leadSection, content), leadSection.settings.layout)
    .filter((candidate) => !phoneHeroMoved || candidate.media !== "(max-width: 767px)")
    .map((candidate) => phoneHeroMoved && candidate.media === "all" ? { ...candidate, media: "(min-width: 768px)" } : candidate)
  : [];
// The page's share image when the store sets none: the first shown hero's first slide.
const firstHero = homeSections.find((section) => section.type === "hero" && homepageSectionRenders(section, content));
const firstHeroSlide = firstHero?.type === "hero" ? homepageHero(firstHero, content).desktop[0] ?? null : null;
const phoneCategory = phoneLeadSection?.type === "category_tiles"
  ? homepageCategoryTiles(phoneLeadSection, content).find((category) => category.imageUrl)
  : null;
const phoneCategoryImage = phoneCategory?.imageUrl ?? null;
// The leading tiles' phone photo, at the width and sizes CategoryTiles draws
// it with (the preload must name that file).
const phoneCategoryStyle = phoneLeadSection?.type === "category_tiles" ? phoneLeadSection.settings.style : null;
const phoneCategoryWidth = phoneCategoryStyle === "photo" || phoneCategoryStyle === "photo-grid" ? 480 : phoneCategoryStyle === "round-small" ? 160 : 320;
const phoneCategorySizes = phoneCategoryStyle ? {
  photo: "min(42vw, 176px)",
  "photo-grid": "min(42vw, 176px)",
  icons: "56px",
  round: "30vw",
  "round-small": "56px",
  "round-row": "30vw",
  square: "30vw",
  quad: "45vw",
}[phoneCategoryStyle] : "";

// --- SEO: canonical URL for homepage ---
const canonicalUrl = buildAbsoluteStorefrontSeoUrl("/");
---

<Layout
  title={homepageTitle}
  description={homepageMetaDescription}
  layoutData={layoutData}
  pageLead={headerLead}
  canonicalUrl={canonicalUrl ?? undefined}
  ogType="website"
  fallbackOgImage={
    firstHeroSlide
      ? mediaImageUrl(firstHeroSlide.url, MEDIA_DISCOVERY_IMAGE_WIDTH)
      : undefined
  }
>
  <Fragment slot="preload">
    {phoneCategoryImage && (
      <link
        rel="preload"
        as="image"
        href={mediaImageSrcSet(phoneCategoryImage) ? undefined : mediaImageUrl(phoneCategoryImage, phoneCategoryWidth)}
        imagesrcset={mediaImageSrcSet(phoneCategoryImage)}
        imagesizes={phoneCategorySizes}
        media="(max-width: 767px)"
        fetchpriority="high"
      />
    )}
    {
      heroPreloads.map((candidate) => (
        // With renditions, href is left out so a browser without
        // imagesrcset support can't fetch a second, different file.
        <link
          rel="preload"
          as="image"
          href={candidate.srcset ? undefined : candidate.src}
          imagesrcset={candidate.srcset}
          imagesizes={candidate.srcset ? candidate.sizes : undefined}
          media={candidate.media}
          fetchpriority="high"
        />
      ))
    }
  </Fragment>

  <h1 class="sr-only">{homepageHeading}</h1>

  <HomepageSections
    sections={homeSections}
    content={content}
    leadSectionId={leadSection?.id ?? null}
    headerLeadSectionId={headerLead?.kind === "app" ? headerLead.instanceId : null}
    currencySymbol={currencySymbol}
    currencyCode={currencyCode}
    previewMarks={requestTheme.preview !== null}
    languageCode={layoutData.storefrontCopy?.languageCode}
  />
</Layout>
