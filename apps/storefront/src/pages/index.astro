---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Collection2 from "@/components/collection2.astro";
import Collection1 from "../components/collection1.astro";
import Hero from "@/components/hero.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import HomepageCategoryRail from "@/components/homepage/HomepageCategoryRail.astro";
import DeliveryFacts from "@/components/DeliveryFacts.astro";
import {
  getAllProducts,
  getCheckoutConfig,
  getHomepageData,
  getShippingMethods,
  type CollectionWithProducts,
} from "@/lib/api";
import { loadPageWithLayout } from "@/lib/page-data";
import { buildDeliveryFacts } from "@/lib/delivery-facts";
import { formatMoney } from "@/lib/currency";
import { resolveStoreName } from "@/lib/store-identity";
import { resolveHomepageHero } from "@/lib/homepage-hero";
import { buildAbsoluteStorefrontSeoUrl } from "@/lib/seo-base-url";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { mediaImageUrl } from "@/lib/media-url";
import { HERO_SLIDE_PRESENTATION } from "@scalius/shared/hero-slider";
import { MEDIA_DISCOVERY_IMAGE_WIDTH } from "@scalius/shared/media-variants";

// Parallel fetch: layout data + homepage data
const { layoutData, pageData: homepageData } = await loadPageWithLayout(() =>
  getHomepageData(),
);

if (!layoutData || !homepageData) {
  const response = storefrontDataUnavailableResponse(
    "We could not load the storefront homepage data. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const seo = homepageData?.seo ?? {
  homepageTitle: null as string | null,
  homepageMetaDescription: null as string | null,
};
// Phones fall back to the desktop banners when no phone banners exist.
const hero = resolveHomepageHero(homepageData.hero);
const firstDesktopHero = hero.desktop[0] ?? null;
const firstMobileHero = hero.mobile[0] ?? null;
const desktopHeroPreload = firstDesktopHero
  ? mediaImageUrl(firstDesktopHero.url, HERO_SLIDE_PRESENTATION.desktop.width)
  : "";
const mobileHeroPreload = firstMobileHero
  ? mediaImageUrl(firstMobileHero.url, HERO_SLIDE_PRESENTATION.mobile.width)
  : "";
const activeCollections = homepageData?.collections || [];
const presentation = homepageData.presentation;
const firstCollection = activeCollections[0] ?? null;
const remainingCollections = activeCollections.slice(1);

const storeName = resolveStoreName(layoutData.business);
// Layout appends the store name, so an unset homepage title is just the name.
const homepageTitle = seo.homepageTitle || storeName || "Home";
const homepageMetaDescription = seo.homepageMetaDescription || undefined;
const homepageHeading = storeName || homepageTitle || "Shop";

import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;

// A store with products never shows a blank homepage: without merchant
// sections, buyers get the newest products. Delivery facts come from the
// same live data product pages use.
const needsProductFallback = activeCollections.length === 0;
const [fallbackProducts, shippingMethods, checkoutConfig] = await Promise.all([
  needsProductFallback
    ? getAllProducts({ limit: 8, sort: "newest" }).then((page) => page?.data ?? [])
    : Promise.resolve([]),
  presentation.trustStrip.enabled ? getShippingMethods() : Promise.resolve(null),
  presentation.trustStrip.enabled ? getCheckoutConfig() : Promise.resolve(null),
]);
const deliveryFacts = presentation.trustStrip.enabled
  ? buildDeliveryFacts({
      shippingMethods,
      checkoutConfig,
      returnPolicy: layoutData.seo?.returnPolicy,
      formatMoney: (amount) => formatMoney(amount, { code: currencyCode, symbol: currencySymbol }),
    })
  : [];

// --- SEO: canonical URL for homepage ---
const canonicalUrl = buildAbsoluteStorefrontSeoUrl("/");

function isCollection1(
  collection: CollectionWithProducts,
): collection is CollectionWithProducts & { presentation: "grid" } {
  return collection.presentation === "grid";
}

function isCollection2(
  collection: CollectionWithProducts,
): collection is CollectionWithProducts & { presentation: "carousel" } {
  return collection.presentation === "carousel";
}
---

<Layout
  title={homepageTitle}
  description={homepageMetaDescription}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  ogType="website"
  fallbackOgImage={
    firstDesktopHero || firstMobileHero
      ? mediaImageUrl((firstDesktopHero ?? firstMobileHero)!.url, MEDIA_DISCOVERY_IMAGE_WIDTH)
      : undefined
  }
>
  <Fragment slot="preload">
    {
      mobileHeroPreload && (
        <link
          rel="preload"
          as="image"
          href={mobileHeroPreload}
          media="(max-width: 767px)"
          fetchpriority="high"
        />
      )
    }
    {
      desktopHeroPreload && (
        <link
          rel="preload"
          as="image"
          href={desktopHeroPreload}
          media="(min-width: 768px)"
          fetchpriority="high"
        />
      )
    }
  </Fragment>

  <h1 class="sr-only">{homepageHeading}</h1>

  <section class="w-full">
    <Hero hero={hero} />
  </section>

  <div class="flex flex-col">
    {
      firstCollection && (
        <Fragment key={firstCollection.id}>
          {isCollection1(firstCollection) && (
            <Collection1
              collection={firstCollection}
              currencySymbol={currencySymbol}
              currencyCode={currencyCode}
            />
          )}
          {isCollection2(firstCollection) && (
            <Collection2
              collection={firstCollection}
              currencySymbol={currencySymbol}
              currencyCode={currencyCode}
            />
          )}
        </Fragment>
      )
    }

    <HomepageCategoryRail rail={presentation.categoryRail} />

    {
      remainingCollections.map((collection) => (
        <Fragment key={collection.id}>
          {isCollection1(collection) && (
            <Collection1
              collection={collection}
              currencySymbol={currencySymbol}
              currencyCode={currencyCode}
            />
          )}
          {isCollection2(collection) && (
            <Collection2
              collection={collection}
              currencySymbol={currencySymbol}
              currencyCode={currencyCode}
            />
          )}
        </Fragment>
      ))
    }

    {
      fallbackProducts.length > 0 && (
        <section class="w-full py-2 md:py-6" aria-labelledby="home-products-title">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="mb-3 flex items-end justify-between gap-2 md:mb-5">
              <h2 id="home-products-title" class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">
                New arrivals
              </h2>
              <a href="/search" class="inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:underline">
                View all products
              </a>
            </div>
            <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
              {fallbackProducts.map((product, index) => (
                <ProductCard
                  product={product}
                  currencySymbol={currencySymbol}
                  currencyCode={currencyCode}
                  priority={index < 2 && !firstMobileHero}
                />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <DeliveryFacts facts={deliveryFacts} />
  </div>
</Layout>
