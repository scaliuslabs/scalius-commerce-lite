---
// Account → Orders, after Shopify's customer accounts: every order as a card
// (status, date, total, thumbnails, Buy again), dense rows on a phone like
// Daraz and Amazon, under the account's numbers (orders, spend per currency,
// open conversations), each a link to its list. Server-rendered from the
// session cookie, so it works without JavaScript; "Older orders" pages with
// the API's opaque cursor.
import Layout from "@/layouts/Layout.astro";
import AccountShell from "@/components/account/AccountShell.astro";
import StoreContact from "@/components/StoreContact.astro";
import { getLayoutData } from "@/lib/api";
import { readAccountOrders, readAccountSummaryForRequest } from "@/lib/account-server";
import AccountOrderCards from "@/components/account/AccountOrderCards.astro";
import { accountOrderCards } from "@/lib/account-order-cards";
import { accountSummaryStats } from "@/lib/account-tabs";
import { accountCopy } from "@/lib/account-copy";
import { formatCount } from "@/lib/store-time-zone";
import { getCheckoutLanguagePreset } from "@scalius/shared/checkout-language";
import { accountUi as ui } from "@/lib/account-ui";
import { PRIVATE_NO_STORE_CACHE_CONTROL } from "@/lib/cache-policy";

export const prerender = false;

const rawCursor = Astro.url.searchParams.get("cursor");
const cursor = rawCursor && rawCursor.length <= 512 ? rawCursor : null;
const [layoutData, read, summary] = await Promise.all([
  getLayoutData(),
  readAccountOrders(Astro.request, cursor),
  readAccountSummaryForRequest(Astro.request),
]);
Astro.response.headers.set("Cache-Control", PRIVATE_NO_STORE_CACHE_CONTROL);
if (!read.ok && read.reason === "unavailable") Astro.response.status = 503;

const page = read.ok ? read.data : null;
const orders = page?.orders ?? [];
const nextCursor = page?.pagination?.hasMore ? page.pagination.nextCursor : null;
const olderHref = nextCursor ? `/account?${new URLSearchParams({ cursor: nextCursor })}` : null;
const phoneVerified = Astro.url.searchParams.get("phone") === "verified";
// The store's language (the layout read set it): words, digits, dates and payment wording.
const copy = accountCopy();
const words = copy.orders;
const checkoutCopy = getCheckoutLanguagePreset(layoutData?.storefrontCopy?.languageCode);
// The summary says the order count; without it (unreachable, or nothing yet) the heading does.
const stats = accountSummaryStats(summary, { storeCurrency: layoutData?.currency?.code ?? "BDT", ordersHref: "#accountOrders" });
const countText = page && !stats ? words.count(formatCount(page.totalOrders), page.totalOrders === 1) : null;

const cards = accountOrderCards(orders, copy, checkoutCopy);
---

<Layout title={words.title} layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <AccountShell
    current="orders"
    summary={summary}
    state={read.ok ? "ok" : read.reason}
    title={words.title}
    intro={countText}
    signedOut={{ title: words.signInTitle, body: words.signInBody }}
    unavailable={{ text: copy.shell.unavailable, retryHref: "/account" }}
  >
    {phoneVerified && <p role="status" class={`${ui.notice} mb-6`}>{words.phoneVerified}</p>}
    {page?.phoneVerification && (
      <div class="mb-6">
        <div id="phoneVerification" data-phone={page.phoneVerification.phone} class={`${ui.card} ${ui.cardBody}`}></div>
        <StoreContact layoutData={layoutData} id="phoneVerificationContact" hidden class="mt-2 text-sm text-muted-foreground" />
      </div>
    )}

    {stats && (
      <section aria-label={words.summary} class="mb-6 grid grid-cols-2 gap-3 sm:mb-8 sm:grid-cols-3 sm:gap-4" data-account-summary>
        {stats.map((stat) => (
          <a href={stat.href} data-astro-prefetch="false" data-account-stat={stat.key} class:list={[ui.card, "block p-4 transition-colors hover:border-foreground/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring", stat.key === "spent" && "col-span-2 sm:col-span-1"]}>
            <span class="block text-sm text-muted-foreground">{stat.label}</span>
            {stat.values.map((value) => <span class="mt-1 block break-words text-xl font-semibold tabular-nums text-foreground">{value}</span>)}
            {stat.note && <span class="mt-1 block text-sm font-medium text-primary">{stat.note}</span>}
          </a>
        ))}
      </section>
    )}
    {stats && <h2 id="accountOrders" tabindex="-1" class="sr-only">{words.title}</h2>}

    {cards.length === 0 ? (
      <div class={ui.empty}>
        <svg aria-hidden="true" class="mx-auto mb-3 h-10 w-10 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"></path></svg>
        <h2 class={ui.emptyTitle}>{cursor ? words.noOlder : words.none}</h2>
        <p class={ui.emptyBody}>{words.noneBody}</p>
        <div class="mt-6 flex flex-col items-center justify-center gap-2 sm:flex-row">
          <a href="/" class={ui.primaryButton}>{words.startShopping}</a>
          <a href="/track-order" data-astro-prefetch="false" class={ui.secondaryButton}>{words.trackGuest}</a>
        </div>
      </div>
    ) : (
      <AccountOrderCards cards={cards} words={words} />
    )}

    {(olderHref || cursor) && (
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {cursor && <a href="/account" data-astro-prefetch="false" class={ui.secondaryButton}>{words.newest}</a>}
        {olderHref && <a href={olderHref} data-astro-prefetch="false" class={ui.secondaryButton}>{words.older}</a>}
      </div>
    )}
    <div data-buyer-ui-target="account.overview" data-buyer-ui={JSON.stringify(summary?.buyerUi ?? [])} class="mt-8 empty:hidden"></div>
  </AccountShell>
</Layout>

<script>
  import { buyAgainOrder } from "@/lib/account-buy-again";
  import { renderPhoneVerification } from "@/lib/account-phone-verification";
  import { enhanceBuyerUiWhenNeeded } from "@/lib/buyer-ui/lazy";

  void enhanceBuyerUiWhenNeeded();

  // Buy again: the lines still sold go back in the cart at today's price.
  // Without JavaScript (or before this script) the link opens the order, which adds the lines.
  document.querySelectorAll<HTMLAnchorElement>("a[data-buy-again]").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      if (link.getAttribute("aria-disabled") === "true") return;
      const status = link.closest("article")?.querySelector<HTMLElement>("[data-buy-again-status]");
      const orderId = link.dataset.buyAgain ?? "";
      if (!orderId) return;
      link.setAttribute("aria-disabled", "true");
      void buyAgainOrder(orderId).then((text) => {
        link.removeAttribute("aria-disabled");
        if (!status) return;
        status.textContent = text;
        status.classList.toggle("hidden", !status.textContent);
      });
    });
  });

  // The account's own phone, unverified: prove it to add the orders placed with it.
  // Once proven the page loads again with the new session cookie.
  const phoneBox = document.getElementById("phoneVerification");
  if (phoneBox?.dataset.phone) {
    renderPhoneVerification(phoneBox, { phone: phoneBox.dataset.phone }, {
      storeContact: document.getElementById("phoneVerificationContact"),
    });
  }
</script>
