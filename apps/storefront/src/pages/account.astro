---
// Account → Orders, after Shopify's customer accounts: every order as a card
// (status, date, total, thumbnails, Buy again), dense rows on a phone like
// Daraz and Amazon. Server-rendered from the session cookie, so it works
// without JavaScript; "Older orders" pages with the API's opaque cursor.
import Layout from "@/layouts/Layout.astro";
import AccountShell from "@/components/account/AccountShell.astro";
import StoreContact from "@/components/StoreContact.astro";
import { getLayoutData } from "@/lib/api";
import { readAccountOrders, readAccountSummaryForRequest } from "@/lib/account-server";
import { accountMoney, formatAccountDate, openRequestLabel, orderPaymentLine } from "@/lib/account-format";
import { accountPill, accountUi as ui, orderStatusTone } from "@/lib/account-ui";
import { getProductImageUrl } from "@/lib/product-media";
import { PRIVATE_NO_STORE_CACHE_CONTROL } from "@/lib/cache-policy";
import { formatOrderNumber } from "@scalius/shared/order-utils";

export const prerender = false;

const rawCursor = Astro.url.searchParams.get("cursor");
const cursor = rawCursor && rawCursor.length <= 512 ? rawCursor : null;
const [layoutData, read, summary] = await Promise.all([
  getLayoutData(),
  readAccountOrders(Astro.request, cursor),
  readAccountSummaryForRequest(Astro.request),
]);
Astro.response.headers.set("Cache-Control", PRIVATE_NO_STORE_CACHE_CONTROL);
if (!read.ok && read.reason === "unavailable") Astro.response.status = 503;

const page = read.ok ? read.data : null;
const orders = page?.orders ?? [];
const nextCursor = page?.pagination?.hasMore ? page.pagination.nextCursor : null;
const olderHref = nextCursor ? `/account?${new URLSearchParams({ cursor: nextCursor })}` : null;
const phoneVerified = Astro.url.searchParams.get("phone") === "verified";
const countText = page
  ? `${page.totalOrders} order${page.totalOrders === 1 ? "" : "s"}`
  : null;

const cards = orders.map((order) => {
  const itemCount = order.items.reduce((sum, item) => sum + item.quantity, 0);
  const payment = orderPaymentLine(order);
  const shipment = order.latestShipment;
  const courier = shipment ? shipment.providerName || shipment.courierName : null;
  const request = openRequestLabel(order.openSupportRequestType);
  const needsPayment = payment.state === "Payment needs attention";
  return {
    id: order.id,
    href: `/account/orders/${encodeURIComponent(order.id)}`,
    number: formatOrderNumber(order.orderNumber, order.id),
    status: order.statusLabel ?? order.status,
    tone: orderStatusTone(order.status),
    request,
    date: formatAccountDate(order.createdAt, { time: false }),
    items: `${itemCount} item${itemCount === 1 ? "" : "s"}`,
    total: accountMoney(order.totalAmount, order.currencyCode),
    detail: needsPayment
      ? { text: payment.state, warn: true }
      : shipment
        ? { text: [courier, shipment.statusLabel].filter(Boolean).join(" · "), warn: false }
        : { text: `${payment.method} · ${payment.state}`, warn: false },
    thumbs: order.items.slice(0, 4).map((item) => ({ src: getProductImageUrl(item.productImage, 160), alt: item.productName ?? "" })),
    more: Math.max(0, order.items.length - 4),
    buyAgain: JSON.stringify(order.items.map((item) => ({
      productId: item.productId,
      variantId: item.variantId,
      quantity: item.quantity,
      price: item.price,
      productName: item.productName,
      productSlug: item.productSlug,
      productImage: item.productImage,
      variantLabel: item.variantLabel,
    }))),
  };
});
---

<Layout title="Orders" layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <AccountShell
    current="orders"
    summary={summary}
    state={read.ok ? "ok" : read.reason}
    title="Orders"
    intro={countText}
    signedOut={{ title: "Sign in to see your orders", body: "Track orders and save your delivery details for faster checkout." }}
    unavailable={{ text: "We couldn't reach the store. Check your connection and try again.", retryHref: "/account" }}
  >
    {phoneVerified && <p role="status" class={`${ui.notice} mb-6`}>Phone verified. Orders placed with it are now in your account.</p>}
    {page?.phoneVerification && (
      <div class="mb-6">
        <div id="phoneVerification" data-phone={page.phoneVerification.phone} class={`${ui.card} ${ui.cardBody}`}></div>
        <StoreContact layoutData={layoutData} id="phoneVerificationContact" hidden class="mt-2 text-sm text-muted-foreground" />
      </div>
    )}

    {cards.length === 0 ? (
      <div class={ui.empty}>
        <svg aria-hidden="true" class="mx-auto mb-3 h-10 w-10 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"></path></svg>
        <h2 class={ui.emptyTitle}>{cursor ? "No older orders" : "No orders yet"}</h2>
        <p class={ui.emptyBody}>When you place an order, it shows here with its status and delivery updates.</p>
        <div class="mt-6 flex flex-col items-center justify-center gap-2 sm:flex-row">
          <a href="/" class={ui.primaryButton}>Start shopping</a>
          <a href="/track-order" data-astro-prefetch="false" class={ui.secondaryButton}>Track an order placed without signing in</a>
        </div>
      </div>
    ) : (
      <ul class="grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3" aria-label="Orders">
        {cards.map((card) => (
          <li>
            <article class={`${ui.card} group relative flex h-full gap-3 p-3 transition-colors hover:border-foreground/25 sm:flex-col sm:p-4`}>
              <div class="flex shrink-0 gap-2 sm:order-2" aria-hidden="true">
                {card.thumbs.map((thumb, index) => (
                  <span class:list={["relative block h-16 w-16 overflow-hidden rounded-lg border border-border bg-muted sm:h-14 sm:w-14", index > 0 && "hidden sm:block"]}>
                    <img src={thumb.src} alt="" width="64" height="64" loading="lazy" decoding="async" class="h-full w-full object-contain" />
                    {index === 0 && card.thumbs.length + card.more > 1 && (
                      <span class="absolute bottom-0.5 right-0.5 rounded-md bg-background/90 px-1 text-[0.6875rem] font-semibold tabular-nums text-foreground sm:hidden">+{card.thumbs.length + card.more - 1}</span>
                    )}
                  </span>
                ))}
                {card.more > 0 && <span class="hidden h-14 w-14 items-center justify-center rounded-lg border border-border bg-muted text-xs font-semibold text-muted-foreground sm:flex">+{card.more}</span>}
              </div>

              <div class="flex min-w-0 flex-1 flex-col sm:order-1 sm:flex-none">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class={accountPill(card.tone)}>{card.status}</span>
                  {card.request && <span class={accountPill("warning")}>{card.request}</span>}
                </div>
                <h2 class="mt-1.5 text-sm font-semibold text-foreground sm:text-base">
                  <a href={card.href} data-astro-prefetch="false" class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-ring">Order {card.number}</a>
                </h2>
                <p class="text-xs text-muted-foreground sm:text-sm">{card.date} · {card.items}</p>
                <p class:list={["mt-1 truncate text-xs sm:text-sm", card.detail.warn ? "font-medium text-destructive" : "text-muted-foreground"]}>{card.detail.text}</p>
              </div>

              <div class="flex shrink-0 flex-col items-end justify-between gap-2 sm:order-3 sm:mt-auto sm:flex-row sm:items-center sm:border-t sm:border-border sm:pt-3">
                <p class="text-sm font-semibold tabular-nums text-foreground sm:text-base">{card.total}</p>
                <a
                  href={card.href}
                  data-astro-prefetch="false"
                  data-buy-again={card.buyAgain}
                  class="relative z-10 inline-flex min-h-9 items-center rounded-lg border border-border bg-background px-3 text-xs font-medium text-foreground transition-colors hover:bg-muted sm:min-h-10 sm:text-sm"
                >Buy again</a>
              </div>
              <p class="relative z-10 hidden w-full text-xs text-muted-foreground empty:hidden sm:order-4" role="status" data-buy-again-status></p>
            </article>
          </li>
        ))}
      </ul>
    )}

    {(olderHref || cursor) && (
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {cursor && <a href="/account" data-astro-prefetch="false" class={ui.secondaryButton}>Newest orders</a>}
        {olderHref && <a href={olderHref} data-astro-prefetch="false" class={ui.secondaryButton}>Older orders</a>}
      </div>
    )}
  </AccountShell>
</Layout>

<script>
  import { addOrderToCart } from "@/lib/account-buy-again";
  import { renderPhoneVerification } from "@/lib/account-phone-verification";
  import { ACCOUNT_OFFLINE_MESSAGE } from "@/lib/account-format";

  // Buy again: the lines still sold go back in the cart at today's price.
  // Without JavaScript the link opens the order.
  document.querySelectorAll<HTMLAnchorElement>("a[data-buy-again]").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      if (link.getAttribute("aria-disabled") === "true") return;
      const status = link.closest("article")?.querySelector<HTMLElement>("[data-buy-again-status]");
      let items: Parameters<typeof addOrderToCart>[0] = [];
      try { items = JSON.parse(link.dataset.buyAgain ?? "[]"); } catch { items = []; }
      link.setAttribute("aria-disabled", "true");
      void addOrderToCart(items).then((result) => {
        link.removeAttribute("aria-disabled");
        if (!status) return;
        status.textContent = !result
          ? ACCOUNT_OFFLINE_MESSAGE
          : result.added === 0
            ? "These items are no longer available."
            : result.missing > 0 ? "Some items are no longer available, so they weren't added." : "";
        status.classList.toggle("hidden", !status.textContent);
      });
    });
  });

  // The account's own phone, unverified: prove it to add the orders placed with it.
  const phoneBox = document.getElementById("phoneVerification");
  if (phoneBox?.dataset.phone) {
    renderPhoneVerification(phoneBox, { phone: phoneBox.dataset.phone }, {
      storeContact: document.getElementById("phoneVerificationContact"),
      onVerified: () => window.location.assign("/account?phone=verified"),
    });
  }
</script>
