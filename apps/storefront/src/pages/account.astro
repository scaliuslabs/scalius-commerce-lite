---
// Customer account: profile, delivery details and order history.
import Layout from "@/layouts/Layout.astro";
import StoreContact from "@/components/StoreContact.astro";
import { getLayoutData } from "@/lib/api";
import { ACCOUNT_OFFLINE_MESSAGE } from "@/lib/account-format";
import { ENGLISH_CHECKOUT_LANGUAGE_DATA as copy } from "@scalius/shared/checkout-language";

const layoutData = await getLayoutData();
const field = "w-full rounded-lg border border-input bg-background px-3 py-2.5 text-sm text-foreground outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/20 aria-[invalid=true]:border-destructive disabled:opacity-50";
const label = "mb-1.5 block text-sm font-medium text-foreground";
const error = "mt-1 hidden text-sm text-destructive";
---

<Layout title="Account" layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <section class="container mx-auto max-w-5xl px-4 py-8" data-account-page>
    <div id="loadingState" class="flex min-h-[400px] items-center justify-center">
      <p class="text-sm text-muted-foreground">Loading your account…</p>
    </div>

    <div id="unauthState" class="hidden">
      <div class="mx-auto max-w-md py-16 text-center">
        <h1 class="mb-2 text-2xl font-semibold text-foreground">Sign in to see your orders</h1>
        <p class="mb-6 text-muted-foreground">Track orders and save your delivery details for faster checkout.</p>
        <button type="button" onclick="window.dispatchEvent(new CustomEvent('open-auth-modal'))" class="inline-flex min-h-11 items-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground hover:bg-primary/90">
          Sign in
        </button>
      </div>
    </div>

    <div id="accountError" class="hidden">
      <div class="mx-auto max-w-md py-16 text-center" role="alert">
        <p class="mb-6 text-foreground">{ACCOUNT_OFFLINE_MESSAGE}</p>
        <button type="button" id="accountRetryBtn" class="inline-flex min-h-11 items-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground hover:bg-primary/90">Retry</button>
      </div>
    </div>

    <div id="authState" class="hidden">
      <div class="mb-8 flex items-center justify-between gap-4">
        <h1 class="text-2xl font-semibold text-foreground sm:text-3xl">Account</h1>
        <form method="POST" action="/api/auth/logout" id="signOutForm">
          <button type="submit" class="inline-flex min-h-11 items-center gap-2 whitespace-nowrap rounded-lg px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            Sign out
          </button>
        </form>
      </div>

      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-10">
        <div class="space-y-6">
          <section class="rounded-xl border border-border bg-card p-5" aria-labelledby="profileHeading">
            <div class="flex items-center justify-between gap-3">
              <h2 id="profileHeading" class="text-base font-semibold text-foreground">Profile</h2>
              <button type="button" id="nameToggle" aria-expanded="false" aria-controls="nameForm" class="min-h-11 whitespace-nowrap text-sm font-medium text-primary hover:underline">Edit</button>
            </div>
            <p id="profileName" class="mt-2 break-words text-sm font-medium text-foreground"></p>
            <p id="profileEmail" class="break-all text-sm text-muted-foreground"></p>
            <p id="profilePhone" class="text-sm text-muted-foreground"></p>
            <p id="nameSaved" role="status" class="mt-2 hidden text-sm text-primary">Name saved</p>
            <form id="nameForm" method="post" class="mt-4 hidden space-y-4" novalidate>
              <div>
                <label for="fieldProfileName" class={label}>Full name</label>
                <input id="fieldProfileName" type="text" autocomplete="name" required aria-describedby="fieldProfileNameError" class={field} />
                <p id="fieldProfileNameError" class={error}></p>
              </div>
              <p id="nameSaveStatus" role="status" aria-live="polite" class="text-sm text-destructive empty:hidden"></p>
              <button id="saveNameBtn" type="submit" class="min-h-11 w-full rounded-lg bg-primary text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50">Save name</button>
            </form>
          </section>

          <section class="rounded-xl border border-border bg-card p-5" aria-labelledby="deliveryHeading">
            <div class="flex items-center justify-between gap-3">
              <h2 id="deliveryHeading" class="text-base font-semibold text-foreground">Delivery details</h2>
              <button type="button" id="profileToggle" aria-expanded="false" aria-controls="profileForm" class="min-h-11 whitespace-nowrap text-sm font-medium text-primary hover:underline">Edit</button>
            </div>
            <div id="profileSummary" class="mt-2 space-y-0.5 break-words text-sm text-muted-foreground"></div>
            <p id="profileSaved" role="status" class="mt-2 hidden text-sm text-primary">Address saved</p>
            <form id="profileForm" method="post" class="mt-4 hidden space-y-4" novalidate>
              <div>
                <label for="fieldName" class={label}>Full name</label>
                <input id="fieldName" type="text" autocomplete="name" required aria-describedby="fieldNameError" class={field} />
                <p id="fieldNameError" class={error}></p>
              </div>
              <div>
                <label for="fieldAddress" class={label}>Address</label>
                <input id="fieldAddress" type="text" autocomplete="street-address" required aria-describedby="fieldAddressError" placeholder="House, road, area" class={field} />
                <p id="fieldAddressError" class={error}></p>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="fieldCity" class={label}>City</label>
                  <select id="fieldCity" required aria-describedby="fieldCityError" class={field}><option value="">Select a city</option></select>
                  <p id="fieldCityError" class={error}></p>
                </div>
                <div>
                  <label for="fieldZone" class={label}>{copy.zoneLabel}</label>
                  <select id="fieldZone" required disabled aria-describedby="fieldZoneError" class={field}><option value="">{copy.selectZonePlaceholder}</option></select>
                  <p id="fieldZoneError" class={error}></p>
                </div>
              </div>
              <div id="profileAreaField" hidden>
                <label for="fieldArea" class={label}>Area (optional)</label>
                <select id="fieldArea" disabled class={field}><option value="">Select an area (optional)</option></select>
              </div>
              <p id="profileSaveStatus" role="status" aria-live="polite" class="hidden text-sm"></p>
              <button id="profileLocationsRetryBtn" type="button" class="hidden min-h-11 text-sm font-medium text-primary hover:underline">Retry</button>
              <button id="saveProfileBtn" type="submit" disabled class="min-h-11 w-full rounded-lg bg-primary text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50">Save address</button>
            </form>
          </section>
        </div>

        <section aria-labelledby="ordersHeading">
          <div class="mb-4 flex items-baseline justify-between gap-3">
            <h2 id="ordersHeading" tabindex="-1" class="text-xl font-semibold text-foreground focus:outline-none">Orders</h2>
            <span id="orderCount" class="text-sm text-muted-foreground"></span>
          </div>

          <p id="phoneVerificationStatus" role="status" aria-live="polite" class="mb-4 text-sm text-primary empty:hidden"></p>
          <div id="phoneVerification" class="mb-4 hidden"></div>
          <StoreContact layoutData={layoutData} id="phoneVerificationContact" hidden />

          <div id="emptyOrders" class="hidden rounded-xl border border-dashed border-border p-10 text-center">
            <h3 class="mb-1 text-base font-semibold text-foreground">No orders yet</h3>
            <p class="mb-6 text-sm text-muted-foreground">Your orders will appear here after you buy something.</p>
            <a href="/" class="inline-flex min-h-11 items-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/90">Start shopping</a>
          </div>

          <div id="ordersError" class="hidden rounded-xl border border-border p-8 text-center" role="alert">
            <p id="ordersErrorMessage" class="mb-4 text-sm text-foreground"></p>
            <button type="button" id="ordersRetryBtn" class="inline-flex min-h-11 items-center rounded-lg border border-border px-5 text-sm font-medium text-foreground hover:bg-muted">Retry</button>
          </div>

          <div id="ordersList" class="space-y-3"></div>

          <div id="showMoreContainer" class="mt-6 hidden text-center">
            <button id="showMoreBtn" type="button" class="inline-flex min-h-11 items-center rounded-lg border border-border px-6 text-sm font-medium text-foreground hover:bg-muted">Show more orders</button>
            <p id="showMoreError" role="status" class="mt-2 text-sm text-destructive"></p>
          </div>
        </section>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { bindSignOut, initializeAccountPage } from "@/lib/account-page";

  type AccountWindow = Window & { __scaliusAccountPageBound?: boolean };
  const accountWindow = window as AccountWindow;
  const start = () => {
    bindSignOut();
    void initializeAccountPage();
  };

  if (!accountWindow.__scaliusAccountPageBound) {
    accountWindow.__scaliusAccountPageBound = true;
    document.addEventListener("astro:page-load", start);
    window.addEventListener("customer-login", () => void initializeAccountPage());
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
</script>
