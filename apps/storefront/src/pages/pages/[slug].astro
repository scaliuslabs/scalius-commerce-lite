---
// A landing page: the live theme's `pages.landing[slug]`, composed from the
// homepage's sections and rendered from the same single batch (layout plus
// one landing read, and the delivery reads its sections may show). A theme
// preview renders the previewed draft's (or version's) page instead.
import { presenceMarketCountries } from "@/lib/checkout/shipping-country";
import { getRuntimePresence } from "@/lib/api/runtime";
import Layout from "../../layouts/Layout.astro";
import LandingSections from "@/components/homepage/LandingSections.astro";
import { getLandingPageData, getThemePreviewHomepageSections, getShippingMethods, getCheckoutConfig, isCheckoutConfigReadFailure } from "@/lib/api";
import { loadPageWithLayout } from "@/lib/page-data";
import { resolveRequestTheme } from "@/lib/storefront-theme-context";
import { EMPTY_HOMEPAGE_SECTION_DATA } from "@/lib/homepage-sections";
import { buildDeliveryFacts } from "@/lib/delivery-facts";
import { formatMoney } from "@/lib/currency";
import { buildAbsoluteStorefrontSeoUrl } from "@/lib/seo-base-url";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import { homeSectionsShowDeliveryFacts, storefrontLandingSlugSchema } from "@scalius/shared/storefront-theme";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";

const slug = Astro.params.slug ?? "";
if (!storefrontLandingSlugSchema.safeParse(slug).success) return new Response(null, { status: 404 });
const shippingPromise = getShippingMethods();
const checkoutPromise = getCheckoutConfig();
const { layoutData, pageData } = await loadPageWithLayout(() => getLandingPageData(slug));
if (!layoutData) return storefrontDataUnavailableResponse("We could not load this page. Please try again shortly.");
const requestTheme = await resolveRequestTheme(Astro, layoutData);
if (!requestTheme.preview && pageData === null) {
  return storefrontDataUnavailableResponse("We could not load this page. Please try again shortly.");
}
// The page's sections as the request's theme resolves them for this store
// (hidden and unfit sections left out), exactly as the homepage does.
const landing = requestTheme.resolved.pages.landing[slug];
if (!landing || (!requestTheme.preview && pageData === "missing")) return new Response(null, { status: 404 });
const sections = landing.sections;
const data = requestTheme.preview && requestTheme.previewToken
  ? await getThemePreviewHomepageSections(requestTheme.previewToken, { pageSlug: slug, presence: getRuntimePresence() })
  : pageData && pageData !== "missing" ? pageData.sections : EMPTY_HOMEPAGE_SECTION_DATA;
if (data === null) return storefrontDataUnavailableResponse();
const currency = layoutData.currency ?? DEFAULT_CURRENCY;
const [shippingMethods, checkoutConfig] = await Promise.all([shippingPromise, checkoutPromise]);
if (requestTheme.preview && homeSectionsShowDeliveryFacts(sections) && (shippingMethods === null || isCheckoutConfigReadFailure(checkoutConfig))) {
  return storefrontDataUnavailableResponse();
}
const deliveryFacts = homeSectionsShowDeliveryFacts(sections)
  ? buildDeliveryFacts({
    shippingMethods,
    checkoutConfig,
    returnPolicy: layoutData.seo?.returnPolicy,
    formatMoney: (amount) => formatMoney(amount, { code: currency.code, symbol: currency.symbol }),
    // Only delivery to the page's market's countries is stated.
    countries: presenceMarketCountries(layoutData.markets, getRuntimePresence()),
  })
  : [];
---
<Layout
  title={landing.title}
  description={landing.description || undefined}
  layoutData={layoutData}
  canonicalUrl={buildAbsoluteStorefrontSeoUrl(`/pages/${slug}`) ?? undefined}
  ogType="website"
  noindex={landing.noIndex === true}
>
  <h1 class="sr-only">{landing.title}</h1>
  <LandingSections
    sections={sections}
    data={data}
    deliveryFacts={deliveryFacts}
    currencySymbol={currency.symbol}
    currencyCode={currency.code}
    previewMarks={requestTheme.preview !== null}
    languageCode={layoutData.storefrontCopy?.languageCode}
  />
</Layout>
