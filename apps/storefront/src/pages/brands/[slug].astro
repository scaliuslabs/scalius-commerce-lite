---
import { lowercaseHandleRedirect } from "@/lib/lowercase-route";
// src/pages/brands/[slug].astro
// A brand's page: the published brand record and its products, laid out by
// the same listing as category and collection pages (CatalogListingPage).
// Draft, trashed and unknown brands are 404s.
import { localizedPaths } from "@/lib/localized-paths";
import Layout from "@/layouts/Layout.astro";
import { resolveRequestTheme } from "@/lib/storefront-theme-context";
import { resourceBindingContext } from "@/lib/setting-bindings";
import CatalogListingPage from "@/components/catalog/CatalogListingPage.astro";
import { storefrontFieldValues } from "@/lib/extensions/data";
import CatalogEmptyState from "@/components/catalog/CatalogEmptyState.astro";
import { getProductsByBrand } from "@/lib/api";
import {
  buildResourceCanonicalSeoUrl,
  getAbsoluteStorefrontSeoBaseUrl,
  toAbsoluteStorefrontSeoUrl,
  buildAbsoluteStorefrontSeoUrl,
} from "@/lib/seo-base-url";
import { loadPageWithLayout } from "@/lib/page-data";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import { htmlToPlainText } from "@scalius/shared/html-sanitize";
import { catalogCopy } from "@/lib/catalog-copy";
import { formatCount, pageLanguage } from "@/lib/store-time-zone";
import RichTextStyles from "@/components/RichTextStyles.astro";
import {
  countActiveProductListFilters,
  isIndexableProductListView,
  isMissingProductListPage,
  productListCanonicalUrl,
  productListMetaDescription,
  resolveProductListQueryState,
} from "@/lib/product-list-query";

const { slug } = Astro.params;
// Handles are lowercase: a mis-cased link redirects to the one real URL.
const lowercaseRedirect = lowercaseHandleRedirect(Astro.url);
if (lowercaseRedirect) return lowercaseRedirect;
if (!slug) return new Response(null, { status: 404 });

let queryState = resolveProductListQueryState({ url: Astro.url, allowUnknownAttributes: true });
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);

const { layoutData, pageData: brandResult } = await loadPageWithLayout(
  () => getProductsByBrand(slug, queryState.options),
);

if (brandResult?.brandNotFound) return new Response(null, { status: 404 });
if (!brandResult?.brand || !layoutData) {
  const response = storefrontDataUnavailableResponse(
    "We could not load this brand. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const brand = brandResult.brand;
const facets = brandResult.facets ?? [];
queryState = resolveProductListQueryState({ url: Astro.url, facets });
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);
const currentFilters = queryState.currentFilters;
const products = brandResult.data ?? [];
const pagination = brandResult.pagination;
if (isMissingProductListPage(pagination)) return new Response(null, { status: 404 });

const brandPath = `/brands/${encodeURIComponent(brand.slug)}`;
// The store's words, in its language (the layout read set it).
const copy = catalogCopy(pageLanguage());
const title = `${brand.metaTitle || brand.name}${pagination.page > 1 ? copy.search.page(formatCount(pagination.page)) : ""}`;
const plainDescription = htmlToPlainText(brand.description);
const description =
  brand.metaDescription ||
  plainDescription ||
  productListMetaDescription(brand.name, products.map((product) => product.name));
const storefrontUrl = getAbsoluteStorefrontSeoBaseUrl();
// Each paginated page is self-canonical; sort, filter and tracking params are stripped.
const brandUrl = buildResourceCanonicalSeoUrl("brand", brandPath, brand.canonicalPath);
const canonicalUrl = productListCanonicalUrl(brandUrl, pagination.page);
const brandPaths = localizedPaths(brand, (handle) => `/brands/${encodeURIComponent(handle)}`);
const currencySymbol = layoutData.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData.currency?.code ?? DEFAULT_CURRENCY.code;
const activeFilterCount = countActiveProductListFilters(currentFilters);
const hasListingQuery = Object.keys(currentFilters).length > 0;
const shouldNoindex = brand.noIndex === true || !isIndexableProductListView(currentFilters);
const ogImageUrl = brand.logo ? toAbsoluteStorefrontSeoUrl(brand.logo.url) : null;

const breadcrumbJsonLd =
  !brand.noIndex && brandUrl && storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: buildAbsoluteStorefrontSeoUrl("/") },
          { "@type": "ListItem", position: 2, name: brand.name, item: brandUrl },
        ],
      })
    : null;

const collectionJsonLd =
  !brand.noIndex && !hasListingQuery && brandUrl && storefrontUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        name: brand.name,
        description,
        url: brandUrl,
        ...(pagination.totalIsCapped ? {} : { numberOfItems: pagination.total }),
        about: {
          "@type": "Brand",
          name: brand.name,
          ...(ogImageUrl ? { logo: ogImageUrl } : {}),
        },
      })
    : null;
await resolveRequestTheme(Astro, layoutData, resourceBindingContext(brand, `/brands/${brand.slug}`));

---

<Layout
  title={title}
  description={description}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  localizedPaths={brandPaths}
  ogImage={ogImageUrl ?? undefined}
  ogType="website"
  noindex={shouldNoindex}
>
  <Fragment slot="head">
    <RichTextStyles when={Boolean(pagination.page === 1 && brand.description?.trim())} />
    {collectionJsonLd && <script is:inline type="application/ld+json" set:html={collectionJsonLd} />}
    {breadcrumbJsonLd && <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd} />}
  </Fragment>

  <CatalogListingPage
    template
    kind="brand"
    fields={storefrontFieldValues(brand.customFields)}
    data={{ "data-brand-name": brand.name }}
    hero={{
      title: brand.name,
      description: pagination.page === 1 ? brand.description : null,
      count: pagination.total,
      countCapped: pagination.totalIsCapped,
    }}
    listing={{
      products,
      pagination,
      facets,
      priceRange: brandResult.priceRange,
      ratingFacet: brandResult.ratingFacet,
      queryState,
      pathname: Astro.url.pathname,
      resetPath: brandPath,
      searchLabel: copy.listing.searchIn(brand.name),
      countEndpoint: `${brandPath}/products`,
      currencySymbol,
      currencyCode,
      listingName: brand.name,
      listingTemplate: brand.listingTemplate,
    }}
  >
    <CatalogEmptyState
      slot="empty"
      title={activeFilterCount > 0 ? copy.search.noMatching : copy.listing.emptyTitle}
      description={activeFilterCount > 0 ? copy.listing.emptyFiltered : copy.listing.emptyDescription}
      actionHref={activeFilterCount > 0 ? brandPath : "/search"}
      actionLabel={activeFilterCount > 0 ? copy.listing.clearFilters : copy.listing.browseProducts}
    />
  </CatalogListingPage>
</Layout>
