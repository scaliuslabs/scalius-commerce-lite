---
// Buyer payment selection. The authoritative quote and merchant eligibility
// are loaded before any payment action becomes available.
import Layout from "@/layouts/Layout.astro";
import CheckoutHeader from "@/components/CheckoutHeader.astro";
import CheckoutLoadingOverlay from "@/components/CheckoutLoadingOverlay.astro";
import CheckoutProgress from "@/components/CheckoutProgress.astro";
import {
  getLayoutData,
  getCheckoutConfig,
  getActiveCheckoutLanguage,
  type CheckoutLanguageData,
} from "@/lib/api";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import {
  ENGLISH_CHECKOUT_LANGUAGE_DATA,
  checkoutLanguageBaseCode,
} from "@scalius/shared/checkout-language";

const [layoutData, checkoutConfig, checkoutLanguageResponse] = await Promise.all([
  getLayoutData(),
  getCheckoutConfig(),
  getActiveCheckoutLanguage(),
]);
const checkoutLanguage: CheckoutLanguageData = checkoutLanguageResponse ?? {
  id: "fallback",
  name: "English (Fallback)",
  code: "en",
  languageData: { ...ENGLISH_CHECKOUT_LANGUAGE_DATA },
  fieldVisibility: {
    showEmailField: true,
    showOrderNotesField: true,
    showAreaField: true,
  },
  isActive: true,
  isDefault: true,
};
const copy = checkoutLanguage.languageData;
const serializedCheckoutConfig = serializeJsonForInlineScript(checkoutConfig);
const serializedCheckoutLanguage = serializeJsonForInlineScript(checkoutLanguage);
---

<Layout
  title={copy.paymentPageTitle}
  layoutData={layoutData}
  documentLanguage={checkoutLanguageBaseCode(checkoutLanguage.code)}
  hideHeader
  hideFooter
>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <CheckoutHeader layoutData={layoutData} copy={copy} />

  <div class="mx-auto w-full max-w-6xl px-4 py-5 sm:px-6 sm:py-7">
    <CheckoutProgress current="payment" copy={copy} />

    <div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)] lg:gap-10">
      <aside
        id="orderSummary"
        class="order-1 hidden overflow-hidden rounded-xl border border-border bg-card lg:order-2 lg:sticky lg:top-6"
        aria-label={copy.orderSummaryText}
      >
        <button
          id="orderSummaryToggle"
          type="button"
          class="flex min-h-12 w-full items-center justify-between gap-3 px-4 py-3 text-left lg:hidden"
          aria-expanded="false"
          aria-controls="summaryPanel"
        >
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-foreground">
            {copy.orderSummaryText}
            <svg id="orderSummaryChevron" class="h-4 w-4 transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
              <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
            </svg>
          </span>
          <span id="orderSummaryToggleTotal" class="text-sm font-semibold tabular-nums text-foreground"></span>
        </button>
        <div id="summaryPanel" class="hidden border-t border-border p-4 lg:block lg:border-t-0">
          <h2 class="mb-3 hidden text-sm font-semibold text-foreground lg:block">{copy.orderSummaryText}</h2>
          <div class="space-y-2 text-sm text-muted-foreground" id="summaryDetails"></div>
        </div>
      </aside>

      <section class="order-2 min-w-0 lg:order-1" aria-labelledby="paymentHeading">
        <div class="mb-5">
          <h1 id="paymentHeading" class="text-2xl font-semibold tracking-tight text-foreground">{copy.paymentPageTitle}</h1>
        </div>

        <div
          id="errorMsg"
          class="mb-4 hidden rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm text-destructive"
          role="alert"
          aria-live="assertive"
        ></div>

        <a
          id="checkoutRecoveryAction"
          href="/cart"
          hidden
          class="mb-4 inline-flex min-h-11 w-fit items-center justify-center rounded-lg border border-border bg-background px-4 py-2 text-sm font-semibold text-foreground shadow-sm transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          {copy.returnToCartText}
        </a>

        <div
          id="paymentMethods"
          class="space-y-2"
          role="radiogroup"
          aria-label={copy.paymentMethodsText}
          aria-busy="true"
        >
          <div class="h-16 animate-pulse rounded-xl border border-border bg-muted/50" aria-hidden="true"></div>
          <div class="h-16 animate-pulse rounded-xl border border-border bg-muted/50" aria-hidden="true"></div>
          <span class="sr-only" role="status">{copy.loadingPaymentMethodsText}</span>
        </div>

        <div id="paymentActionParking" class="hidden">
        <div id="paymentActionHost" class="hidden space-y-3">
          <div
            id="testModeNotice"
            class="hidden rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-950 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100"
            role="status"
          >
            {copy.testModeNoticeText}
          </div>

          <div id="stripeSection" class="hidden space-y-2">
            <h3 class="text-sm font-semibold text-foreground">{copy.cardDetailsText}</h3>
            <div id="stripeCardElement" class="min-h-12 rounded-lg border border-input bg-background p-3"></div>
            <div id="stripeError" class="hidden text-xs font-medium text-destructive" role="alert" aria-live="polite"></div>
          </div>

          <p id="hostedRedirectNote" class="hidden text-xs leading-5 text-muted-foreground"></p>

          <button
            id="payButton"
            class="min-h-12 w-full rounded-lg bg-primary px-4 py-3 text-base font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            disabled
          >
            <span id="payButtonText">{copy.selectPaymentMethodText}</span>
          </button>
        </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<CheckoutLoadingOverlay
  title={copy.processingPaymentTitle}
  message={copy.processingPaymentMessage}
/>

<script is:inline set:html={`window.__CHECKOUT_CONFIG__=${serializedCheckoutConfig};window.__CHECKOUT_LANGUAGE__=${serializedCheckoutLanguage};`}></script>
<script>
  import {
    initCheckoutPage,
    resumeCheckoutPageFromHistory,
  } from "@/lib/checkout";

  const startCheckout = () => void initCheckoutPage();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startCheckout, { once: true });
  } else {
    startCheckout();
  }
  window.addEventListener("pageshow", (event) => {
    if ((event as PageTransitionEvent).persisted) {
      void resumeCheckoutPageFromHistory();
    }
  });
</script>
