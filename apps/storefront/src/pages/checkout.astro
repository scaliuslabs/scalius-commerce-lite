---
// Buyer payment selection. The authoritative quote and merchant eligibility
// are loaded before any payment action becomes available.
// The GET render is a buyer-agnostic shell the edge caches like the cart
// (lib/cache-policy.ts isBuyerShellPathname): it reads only public,
// dependency-validated settings and never a cookie or a query parameter. The
// checkout session, quote and payment options load in the browser from
// no-store APIs.
import Layout from "@/layouts/Layout.astro";
import CheckoutHeader from "@/components/CheckoutHeader.astro";
import CheckoutLoadingOverlay from "@/components/CheckoutLoadingOverlay.astro";
import CheckoutPaymentStep from "@/components/checkout/CheckoutPaymentStep.astro";
import {
  getLayoutData,
  getCheckoutConfig,
  getActiveCheckoutLanguage,
  isCheckoutConfigReadFailure,
  type CheckoutLanguageData,
} from "@/lib/api";
import { markRenderUncacheable } from "@/lib/cache-policy";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { resolveRequestTheme } from "@/lib/storefront-theme-context";
import { giftCardCheckoutCopy } from "@/lib/checkout/gift-cards";
import { checkoutLanguageBaseCode } from "@scalius/shared/checkout-language-format";
import { ENGLISH_CHECKOUT_LANGUAGE_DATA } from "@scalius/shared/checkout-language";

const [layoutData, checkoutConfig, checkoutLanguageResponse] = await Promise.all([
  getLayoutData(),
  getCheckoutConfig(),
  getActiveCheckoutLanguage(),
]);
// A failed read renders the fail-closed page (checkout unavailable, English
// copy); that answer is for this request only, never the shared cache.
if (!layoutData || checkoutLanguageResponse === null || isCheckoutConfigReadFailure(checkoutConfig)) {
  markRenderUncacheable(Astro.response.headers);
}
const checkoutLanguage: CheckoutLanguageData = checkoutLanguageResponse ?? {
  id: "fallback",
  name: "English (Fallback)",
  code: "en",
  languageData: { ...ENGLISH_CHECKOUT_LANGUAGE_DATA },
  fieldVisibility: {
    showOrderNotesField: true,
    showAreaField: true,
  },
  isActive: true,
  isDefault: true,
};
const copy = checkoutLanguage.languageData;
const giftCopy = giftCardCheckoutCopy(copy);
const serializedCheckoutConfig = serializeJsonForInlineScript(checkoutConfig);
// The theme's checkout block (the request's one theme resolution: no read of its own).
const checkoutBlock = (await resolveRequestTheme(Astro, layoutData)).resolved.blocks.checkout;
const serializedCheckoutLanguage = serializeJsonForInlineScript(checkoutLanguage);
---

<Layout
  title={copy.paymentPageTitle}
  layoutData={layoutData}
  documentLanguage={checkoutLanguageBaseCode(checkoutLanguage.code)}
  hideHeader
  hideFooter
>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <CheckoutHeader layoutData={layoutData} copy={copy} />

  {/* data-checkout-state: the HTML says "missing", the empty cart (true
      without JavaScript: the cart lives in the browser). Before anything
      below is parsed, the script makes a checkout in progress (or an order
      just placed, whose link the page script builds) "loading", and sends a
      buyer with neither to the cart, the step they skipped. */}
  <CheckoutPaymentStep copy={copy} giftCopy={giftCopy} block={checkoutBlock} />
</Layout>

<CheckoutLoadingOverlay
  title={copy.processingPaymentTitle}
  message={copy.processingPaymentMessage}
/>

<script is:inline set:html={`window.__CHECKOUT_CONFIG__=${serializedCheckoutConfig};window.__CHECKOUT_LANGUAGE__=${serializedCheckoutLanguage};`}></script>
<script>
  import {
    initCheckoutPage,
    resumeCheckoutPageFromHistory,
  } from "@/lib/checkout";

  const startCheckout = () => void initCheckoutPage();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startCheckout, { once: true });
  } else {
    startCheckout();
  }
  window.addEventListener("pageshow", (event) => {
    if ((event as PageTransitionEvent).persisted) {
      void resumeCheckoutPageFromHistory();
    }
  });
</script>
