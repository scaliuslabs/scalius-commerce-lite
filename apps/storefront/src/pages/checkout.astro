---
// src/pages/checkout.astro
// Payment method selection and processing page.
// Reached after completing the checkout form in /cart when multiple
// payment gateways are active.
//
// Flow:
//  1. Reads checkout data from sessionStorage (set by cart.astro)
//  2. Shows payment method selection (Stripe / SSLCommerz / COD)
//  3. Processes payment according to selected method
//  4. Redirects to /order-success on completion

import Layout from "@/layouts/Layout.astro";
import CheckoutLoadingOverlay from "@/components/CheckoutLoadingOverlay.astro";
import { getLayoutData, getCheckoutConfig } from "@/lib/api";
import { serializeJsonForInlineScript } from "@/lib/safe-json";

const [layoutData, checkoutConfig] = await Promise.all([
  getLayoutData(),
  getCheckoutConfig(),
]);
const serializedCheckoutConfig = serializeJsonForInlineScript(checkoutConfig);
---

<Layout title="Payment" layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <div class="container max-w-2xl mx-auto px-4 py-8">
    <!-- Back link -->
    <a
      href="/cart"
      id="backToCart"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground mb-6 transition-colors"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M15 19l-7-7 7-7" />
      </svg>
      Back to cart
    </a>

    <h1 class="text-2xl font-bold mb-6">Choose Payment Method</h1>

    <!-- Order summary (populated by JS) -->
    <div id="orderSummary" class="rounded-xl border border-border bg-muted p-4 mb-6 hidden">
      <h2 class="text-sm font-semibold text-foreground uppercase tracking-wide mb-3">Order Summary</h2>
      <div class="space-y-1 text-sm text-muted-foreground" id="summaryDetails"></div>
    </div>

    <!-- Error message -->
    <div id="errorMsg" class="hidden bg-destructive/10 border border-destructive/20 text-destructive rounded-lg px-4 py-3 text-sm mb-4"></div>

    <!-- Payment method cards -->
    <div
      id="paymentMethods"
      class="space-y-3 mb-6"
      role="radiogroup"
      aria-label="Payment methods"
    >
      <!-- Populated by JS -->
    </div>

    <!-- Stripe card element (shown only when Stripe selected) -->
    <div id="stripeSection" class="hidden rounded-xl border border-border bg-card p-5 mb-4">
      <h3 class="text-sm font-semibold mb-3">Card Details</h3>
      <div id="stripeCardElement" class="rounded-lg border border-input p-3 bg-muted"></div>
      <div id="stripeError" class="text-xs text-destructive mt-2 hidden"></div>
    </div>

    <!-- Pay button -->
    <button
      id="payButton"
      class="w-full bg-primary text-primary-foreground font-bold text-base py-3.5 rounded-xl shadow-lg hover:bg-primary/90 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
      disabled
    >
      <span id="payButtonText">Select a payment method</span>
    </button>

    <p class="text-xs text-muted-foreground text-center mt-3">
      Secure checkout
    </p>
  </div>
</Layout>

<CheckoutLoadingOverlay
  title="Processing payment"
  message="Confirming your order and payment details."
/>

<style>
  .space-y-3 > * { position: relative; }
</style>

<script is:inline set:html={`window.__CHECKOUT_CONFIG__=${serializedCheckoutConfig};`}></script>
<script>
  import { initCheckoutPage } from "@/lib/checkout";
  document.addEventListener("DOMContentLoaded", () => {
    void initCheckoutPage();
  });
</script>
