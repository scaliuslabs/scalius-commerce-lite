---
import { getLayoutData, getProductBySlug, getShippingMethods } from "@/lib/api";
import Layout from "@/layouts/Layout.astro";
import ProductBreadcrumbs from "@/components/product/ProductBreadcrumbs.astro";
import ProductGallery from "@/components/product/ProductGallery.astro";
import ProductSummary from "@/components/product/ProductSummary.astro";
import RelatedProducts from "@/components/product/RelatedProducts.astro";
import WidgetPlacementZone from "@/components/WidgetPlacementZone.astro";
import { getProductImageUrl, hasProductImage } from "@/lib/product-media";
import { getOptimizedImageUrl } from "@/lib/image-optimizer";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import {
  setRuntimeImageCdnPolicy,
} from "@/lib/api/runtime-env";
import {
  buildResourceCanonicalSeoUrl,
  getAbsoluteStorefrontSeoBaseUrl,
} from "@/lib/seo-base-url";
import {
  buildMerchantReturnPolicyJsonLd,
  buildOfferShippingDetails,
  gtinJsonLdForVariant,
} from "@/lib/commerce-structured-data";
import { getActiveWidgetsForScope } from "@/lib/api/widgets";
import {
  getBuyerStockSummary,
  isVariantAvailable,
  resolveBuyerVariants,
} from "@/lib/product-sellable-variants";
import { getVariantDiscountedPrice } from "@/components/product/lib/pricing-engine";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { normalizeSeoDiscoverySettings } from "@scalius/shared/seo-discovery";
import {
  DEFAULT_PRODUCT_OPTION_LABELS,
  DEFAULT_PRODUCT_OPTION_SCHEMA,
  normalizeProductOptionLabel,
  normalizeProductOptionSchema,
  type ProductOptionSchema,
} from "@scalius/shared/product-options";
import {
  normalizeSavedProductCondition,
  PRODUCT_CONDITION_SCHEMA_URLS,
} from "@scalius/shared/product-condition";
import { resolveCatalogDiscoveryImageUrl } from "@scalius/shared/catalog-discovery-media";

const { slug } = Astro.params;
if (!slug) {
  return new Response(null, { status: 404 });
}

const layoutPromise = getLayoutData();
const productPromise = getProductBySlug(slug);
const shippingMethodsPromise = getShippingMethods();
const productWidgetsPromise = productPromise.then((data) =>
  data ? getActiveWidgetsForScope("product", data.product.id) : null,
);

// Parallel fetch: layout + product + shipping + scoped widgets in the first cold-cache wave
const [layoutData, productData, shippingMethods, fetchedProductWidgets] = await Promise.all([
  layoutPromise,
  productPromise,
  shippingMethodsPromise,
  productWidgetsPromise,
]);
setRuntimeImageCdnPolicy(layoutData?.media);
if (!productData) {
  return new Response(null, { status: 404 });
}
if (!layoutData) {
  const response = storefrontDataUnavailableResponse(
    "We could not load this product. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const { product, category, images, variants, relatedProducts } = productData;
const productWidgets = fetchedProductWidgets ?? [];
const buyerVariantResolution = resolveBuyerVariants(variants);
const buyerVariants = buyerVariantResolution.variants;
const buyerStockSummary = getBuyerStockSummary(buyerVariants);

const variantImageMarker = product.metaDescription?.match(
  /<!--variant_images:(enabled|option1|option2)-->/,
)?.[1];
const isVariantSpecificImagesEnabled = Boolean(variantImageMarker);
const variantImageAxis = variantImageMarker === "option1" ? "option1" : "option2";
const cleanMetaDescription =
  product.metaDescription
    ?.replace(/<!--variant_images:(?:enabled|option1|option2)-->/g, "")
    .trim() || "";

const discountedPrice = product.discountedPrice;
const productCategory = category ?? null;
const productCategoryUrl = productCategory
  ? buildResourceCanonicalSeoUrl(
      "category",
      `/categories/${productCategory.slug}`,
      productCategory.canonicalPath,
    )
  : null;

const sizeOrderMap = new Map<string, number>();
buyerVariants.forEach((v) => {
  if (v.size && !sizeOrderMap.has(v.size)) {
    sizeOrderMap.set(v.size, v.sizeSortOrder);
  }
});
const sizeOptions = Array.from(sizeOrderMap.entries())
  .sort((a, b) => a[1] - b[1])
  .map((entry) => entry[0]);

const colorOrderMap = new Map<string, number>();
buyerVariants.forEach((v) => {
  if (v.color && !colorOrderMap.has(v.color)) {
    colorOrderMap.set(v.color, v.colorSortOrder);
  }
});
const colorOptions = Array.from(colorOrderMap.entries())
  .sort((a, b) => a[1] - b[1])
  .map((entry) => entry[0]);

const pageTitle = product.metaTitle || product.name;
const pageDescription = cleanMetaDescription;
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const quickBuyNoticeByError: Record<string, string> = {
  product_unavailable: "This item is not available right now.",
  variant_required: "Please choose an available option before buying.",
  variant_not_found: "That option is no longer available. Please choose another option.",
  out_of_stock: "This item is out of stock right now.",
  invalid_quantity: "Please choose a quantity between 1 and 99.",
  quantity_unavailable: "The requested quantity is not available. Please lower the quantity.",
  price_changed: "This item's price changed. Please review it before buying.",
  validation_unavailable: "We could not refresh this item. Please try again.",
  processing_failed: "We could not prepare this item. Please try again.",
};
const quickBuyNotice = quickBuyNoticeByError[Astro.url.searchParams.get("error") ?? ""] ?? null;

// --- SEO: per SEO-01, SEO-02, OG-01, OG-05 ---
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;
const storefrontUrl = getAbsoluteStorefrontSeoBaseUrl();
const canonicalUrl = buildResourceCanonicalSeoUrl(
  "product",
  `/products/${product.slug}`,
  product.canonicalPath,
);
const discoverySettings = normalizeSeoDiscoverySettings(
  layoutData?.seo?.discovery,
);

// OG image: 1200x630 for social sharing (per OG-05)
const primaryImageUrl =
  images.find((image) => hasProductImage(image.url))?.url ||
  (hasProductImage(product.imageUrl) ? product.imageUrl : null);
const serializedProductImageUrl = getProductImageUrl(primaryImageUrl, {
  width: 600,
  height: 600,
  quality: 85,
  format: "auto",
  fit: "contain",
});
const ogImageUrl = primaryImageUrl && storefrontUrl
  ? resolveCatalogDiscoveryImageUrl(primaryImageUrl, storefrontUrl, {
      transformImageUrl: (imageUrl) =>
        getOptimizedImageUrl(imageUrl, {
          width: 1200,
          height: 630,
          quality: 85,
          format: "auto",
          fit: "cover",
        }),
    })
  : null;

// Description for OG and JSON-LD -- strip HTML (per research constraint)
const seoDescription = (
  cleanMetaDescription ||
  product.description ||
  product.name
)
  .replace(/<[^>]+>/g, "")
  .slice(0, 200);

const sellerSchemaName =
  layoutData.business?.companyName?.trim() ||
  layoutData.business?.legalName?.trim() ||
  null;

// Brand from product attributes (mirrors facebook-feed.xml.ts pattern)
const brandAttribute = product.attributes?.find(
  (a: { name: string }) => a.name.toLowerCase() === "brand",
);
const brandName = brandAttribute?.value?.trim() || null;
const productCondition = normalizeSavedProductCondition(product.productCondition);
const productConditionSchemaUrl = productCondition
  ? PRODUCT_CONDITION_SCHEMA_URLS[productCondition]
  : null;

// Primary SKU
const primarySku = buyerVariants[0]?.sku || product.id;

function normalizedVariantOption(value: string | null | undefined): string | null {
  const normalized = value?.trim();
  return normalized ? normalized : null;
}

type VariantOptionAxis = "option1" | "option2";

const PRODUCT_OPTION_SCHEMA_URLS: Record<Exclude<ProductOptionSchema, "none">, string> = {
  size: "https://schema.org/size",
  color: "https://schema.org/color",
  material: "https://schema.org/material",
  pattern: "https://schema.org/pattern",
};

const productOptionMetadata: Record<
  VariantOptionAxis,
  { label: string; schema: ProductOptionSchema }
> = {
  option1: {
    label: normalizeProductOptionLabel(
      product.variantOption1Label,
      DEFAULT_PRODUCT_OPTION_LABELS.option1,
    ),
    schema: normalizeProductOptionSchema(
      product.variantOption1Schema,
      DEFAULT_PRODUCT_OPTION_SCHEMA.option1,
    ),
  },
  option2: {
    label: normalizeProductOptionLabel(
      product.variantOption2Label,
      DEFAULT_PRODUCT_OPTION_LABELS.option2,
    ),
    schema: normalizeProductOptionSchema(
      product.variantOption2Schema,
      DEFAULT_PRODUCT_OPTION_SCHEMA.option2,
    ),
  },
};

function getProductOptionSchema(axis: VariantOptionAxis): ProductOptionSchema {
  return productOptionMetadata[axis].schema;
}

function getProductOptionLabel(axis: VariantOptionAxis): string {
  return productOptionMetadata[axis].label;
}

function mappedVariantSchemaProps(variant: typeof buyerVariants[number]): Record<string, string> {
  const props: Record<string, string> = {};
  const options = [
    {
      axis: "option1" as const,
      value: normalizedVariantOption(variant.size),
    },
    {
      axis: "option2" as const,
      value: normalizedVariantOption(variant.color),
    },
  ];

  for (const option of options) {
    if (!option.value) continue;
    const schema = getProductOptionSchema(option.axis);
    if (schema === "none" || props[schema]) continue;
    props[schema] = option.value;
  }

  return props;
}

function buildVariantProductUrl(variant: typeof buyerVariants[number]): string | null {
  if (!canonicalUrl) return null;

  const url = new URL(canonicalUrl);
  const size = normalizedVariantOption(variant.size);
  const color = normalizedVariantOption(variant.color);
  if (size) url.searchParams.set("size", size);
  if (color) url.searchParams.set("color", color);
  return url.toString();
}

function getVariantSchemaName(variant: typeof buyerVariants[number]): string {
  const options = [
    {
      axis: "option1" as const,
      value: normalizedVariantOption(variant.size),
    },
    {
      axis: "option2" as const,
      value: normalizedVariantOption(variant.color),
    },
  ]
    .filter((option) => Boolean(option.value))
    .map((option) => `${getProductOptionLabel(option.axis)}: ${option.value}`);
  return options.length > 0 ? `${product.name} - ${options.join(" / ")}` : product.name;
}

function getVariantSchemaPrice(variant: typeof buyerVariants[number]): number {
  return getVariantDiscountedPrice(
    variant.price,
    product.price,
    variant.discountType,
    variant.discountPercentage,
    variant.discountAmount,
    product.discountType,
    product.discountPercentage,
    product.discountAmount,
  );
}

const productGroupVariesBy = [
  ...(sizeOptions.length > 0 && getProductOptionSchema("option1") !== "none"
    ? [PRODUCT_OPTION_SCHEMA_URLS[getProductOptionSchema("option1") as Exclude<ProductOptionSchema, "none">]]
    : []),
  ...(colorOptions.length > 0 && getProductOptionSchema("option2") !== "none"
    ? [PRODUCT_OPTION_SCHEMA_URLS[getProductOptionSchema("option2") as Exclude<ProductOptionSchema, "none">]]
    : []),
].filter((value, index, values) => values.indexOf(value) === index);
const shouldEmitProductGroupJsonLd =
  discoverySettings.structuredData.productGroups &&
  buyerVariantResolution.mode === "optioned" &&
  buyerVariants.length > 0;

const offerShippingDetails = discoverySettings.structuredData.offerShippingDetails
  ? buildOfferShippingDetails({
      shippingMethods,
      currencyCode,
      freeDelivery: product.freeDelivery,
      country: layoutData.business?.country,
    })
  : [];
const merchantReturnPolicyJsonLd = buildMerchantReturnPolicyJsonLd({
  settings: layoutData.seo?.returnPolicy,
  storefrontUrl,
  fallbackCountry: layoutData.business?.country,
});

function withOfferCommerceDetails<T extends Record<string, unknown>>(offer: T): T {
  return {
    ...offer,
    ...(sellerSchemaName
      ? { seller: { "@type": "Organization", name: sellerSchemaName } }
      : {}),
    ...(offerShippingDetails.length > 0
      ? { shippingDetails: offerShippingDetails }
      : {}),
    ...(merchantReturnPolicyJsonLd
      ? { hasMerchantReturnPolicy: merchantReturnPolicyJsonLd }
      : {}),
  } as T;
}

// Product JSON-LD -- per SEO-01 (merchant listing spec)
const productJsonLd = discoverySettings.structuredData.products && !product.noIndex && canonicalUrl
  ? serializeJsonForInlineScript(
      shouldEmitProductGroupJsonLd
        ? {
            "@context": "https://schema.org",
            "@type": "ProductGroup",
            name: product.name,
            url: canonicalUrl,
            description: (product.description || product.name).replace(/<[^>]+>/g, ""),
            ...(ogImageUrl ? { image: [ogImageUrl] } : {}),
            productGroupID: product.id,
            ...(brandName ? { brand: { "@type": "Brand", name: brandName } } : {}),
            ...(productGroupVariesBy.length > 0 ? { variesBy: productGroupVariesBy } : {}),
            hasVariant: buyerVariants.map((variant) => {
              const variantPrice = getVariantSchemaPrice(variant);
              return {
                "@type": "Product",
                name: getVariantSchemaName(variant),
                url: buildVariantProductUrl(variant) ?? canonicalUrl,
                description: (product.description || product.name).replace(/<[^>]+>/g, ""),
                ...(ogImageUrl ? { image: [ogImageUrl] } : {}),
                sku: normalizedVariantOption(variant.sku) || variant.id,
                ...gtinJsonLdForVariant(variant.barcode, variant.barcodeType),
                ...mappedVariantSchemaProps(variant),
                ...(brandName ? { brand: { "@type": "Brand", name: brandName } } : {}),
                offers: withOfferCommerceDetails({
                  "@type": "Offer",
                  url: buildVariantProductUrl(variant) ?? canonicalUrl,
                  priceCurrency: currencyCode,
                  price: variantPrice.toFixed(2),
                  ...(productConditionSchemaUrl ? { itemCondition: productConditionSchemaUrl } : {}),
                  availability: isVariantAvailable(variant)
                    ? "https://schema.org/InStock"
                    : "https://schema.org/OutOfStock",
                }),
              };
            }),
          }
        : {
            "@context": "https://schema.org",
            "@type": "Product",
            name: product.name,
            url: canonicalUrl,
            description: (product.description || product.name).replace(/<[^>]+>/g, ""),
            ...(ogImageUrl ? { image: [ogImageUrl] } : {}),
            sku: primarySku,
            ...gtinJsonLdForVariant(
              buyerVariants[0]?.barcode,
              buyerVariants[0]?.barcodeType,
            ),
            ...(brandName ? { brand: { "@type": "Brand", name: brandName } } : {}),
            offers: withOfferCommerceDetails({
              "@type": "Offer",
              url: canonicalUrl,
              priceCurrency: currencyCode,
              price: product.discountedPrice.toFixed(2),
              ...(productConditionSchemaUrl ? { itemCondition: productConditionSchemaUrl } : {}),
              availability: buyerStockSummary.canPurchaseAny
                ? "https://schema.org/InStock"
                : "https://schema.org/OutOfStock",
            }),
          },
    )
  : null;

// BreadcrumbList JSON-LD -- per SEO-02
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: `${storefrontUrl}/` },
  ...(productCategory && productCategoryUrl
    ? [
        {
          "@type": "ListItem",
          position: 2,
          name: productCategory.name,
          item: productCategoryUrl,
        },
      ]
    : []),
  {
    "@type": "ListItem",
    position: productCategory ? 3 : 2,
    name: product.name,
    item: canonicalUrl,
  },
];
const breadcrumbJsonLd =
  discoverySettings.structuredData.breadcrumbs && !product.noIndex && storefrontUrl && canonicalUrl
  ? serializeJsonForInlineScript({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems,
    })
  : null;

const productCategoryAnalytics = productCategory
  ? {
      id: productCategory.id,
      name: productCategory.name,
      slug: productCategory.slug,
    }
  : null;
---

<Layout
  title={pageTitle}
  description={seoDescription || pageDescription}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  ogImage={ogImageUrl ?? undefined}
  ogType="product"
  ogPrice={product.discountedPrice.toFixed(2)}
  ogCurrency={currencyCode}
  noindex={product.noIndex === true}
>
  <Fragment slot="head">
    {
      primaryImageUrl && (
        <link
          rel="preload"
          as="image"
          href={getProductImageUrl(primaryImageUrl, {
            width: 600,
            height: 600,
            quality: 85,
            format: "auto",
            fit: "contain",
          })}
          fetchpriority="high"
        />
      )
    }
    {productJsonLd && <script is:inline type="application/ld+json" set:html={productJsonLd} />}
    {breadcrumbJsonLd && <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd} />}
  </Fragment>

  <div
    class="min-h-screen bg-white product-container"
    id="product-container"
    data-product-id={product.id}
    data-product-slug={product.slug}
    data-product-name={product.name}
    data-product-price={String(discountedPrice)}
    data-product-original-price={String(product.price)}
    data-product-image={serializedProductImageUrl}
    data-product-discount-type={product.discountType || ""}
    data-product-discount-percentage={String(product.discountPercentage || 0)}
    data-product-discount-amount={String(product.discountAmount || 0)}
    data-product-free-delivery={product.freeDelivery.toString()}
    data-product-has-variants={product.hasVariants.toString()}
    data-fb-product-details={JSON.stringify({
      id: product.id,
      slug: product.slug,
      name: product.name,
      discountedPrice: discountedPrice,
    })}
    data-fb-category-details={JSON.stringify(productCategoryAnalytics)}
    data-fb-variants-details={JSON.stringify(buyerVariants.slice(0, 1))}
  >
    <WidgetPlacementZone
      widgets={productWidgets}
      scope="product"
      scopeId={product.id}
      placementSlot="top"
      priority
    />

    <div class="lg:pt-2">
      <ProductBreadcrumbs product={product} category={productCategory} />
    </div>

    <WidgetPlacementZone
      widgets={productWidgets}
      scope="product"
      scopeId={product.id}
      placementSlot="before_content"
      itemClass="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-2"
    />

    <section
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 sm:py-4 lg:py-6"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-3 lg:gap-y-8">
        <ProductGallery product={product} images={images} />
        <ProductSummary
          product={product}
          category={productCategory}
          variants={buyerVariants}
          sizeOptions={sizeOptions}
          colorOptions={colorOptions}
          isVariantSpecificImagesEnabled={isVariantSpecificImagesEnabled}
          variantImageAxis={variantImageAxis}
          currencySymbol={currencySymbol}
          quickBuyNotice={quickBuyNotice}
        />
      </div>
    </section>

    <WidgetPlacementZone
      widgets={productWidgets}
      scope="product"
      scopeId={product.id}
      placementSlot="after_content"
      itemClass="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-2"
    />

    <RelatedProducts
      relatedProducts={relatedProducts}
      currencySymbol={currencySymbol}
    />

    <WidgetPlacementZone
      widgets={productWidgets}
      scope="product"
      scopeId={product.id}
      placementSlot="bottom"
      itemClass="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-2"
    />
  </div>
</Layout>

<script>
  // Defer the product controller to break the critical chain for pricing-engine.js.
  // The controller only needs to run after DOM is ready (init() does DOM queries).
  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      () => {
        import("@/components/product/scripts/product-controller").then((m) =>
          m.init(),
        );
      },
      { once: true },
    );
  } else {
    import("@/components/product/scripts/product-controller").then((m) =>
      m.init(),
    );
  }
</script>
<script>
  import type { Product, Category, ProductVariant } from "@/lib/api";

  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("product-container");
    if (!container) return;

    const productDataAttr = container.dataset.fbProductDetails;
    const categoryDataAttr = container.dataset.fbCategoryDetails;
    const variantsDataAttr = container.dataset.fbVariantsDetails;

    if (!productDataAttr || !categoryDataAttr || !variantsDataAttr) {
      console.error("FB ViewContent: Missing data attributes on container.");
      return;
    }

    try {
      const product: Product = JSON.parse(productDataAttr);
      const category: Category | null = JSON.parse(categoryDataAttr);
      const variants: ProductVariant[] = JSON.parse(variantsDataAttr);

      // DEFER DEPENDENCY CHAIN:
      // Dynamically load the analytics tracker only after the page has fully loaded
      // to remove it from the Lighthouse Critical Request Chain. We use the 'load'
      // event instead of a 'setTimeout' to avoid arbitrary delays and ensure data
      // isn't dropped for fast-bouncing visitors while remaining predictable for developers.
      const triggerAnalytics = () => {
        import("@/lib/analytics").then(({ trackFbViewContent }) => {
          trackFbViewContent({
            content_ids: [product.id],
            content_name: product.name,
            content_category: category?.name,
            content_type: "product",
            currency: window.__CURRENCY_CODE__ || "BDT",
            value: product.discountedPrice,
            contents: variants.map((v: ProductVariant) => ({
              id: v.id && v.id !== "default" ? v.id : product.id,
              quantity: 1,
              item_price: v.price || product.discountedPrice,
            })),
          });
        });
      };

      if (document.readyState === "complete") {
        setTimeout(triggerAnalytics, 1);
      } else {
        window.addEventListener("load", triggerAnalytics, { once: true });
      }
    } catch (error: unknown) {
      console.error("FB ViewContent: Error parsing data attributes:", error);
    }
  });
</script>

<style is:inline>
  .product-container {
    scroll-behavior: smooth;
  }
  button:focus-visible,
  a:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }
</style>
