---
import { presenceMarketCountries } from "@/lib/checkout/shipping-country";
import { getRuntimePresence } from "@/lib/api/runtime";
import { lowercaseHandleRedirect } from "@/lib/lowercase-route";
import {
  getCheckoutConfig,
  getLayoutData,
  takesOnlinePayment,
  getProductBySlugResult,
  getShippingMethods,
} from "@/lib/api";
import AppComponent from "@/components/apps/AppComponent.astro";
import AppSlot from "@/components/apps/AppSlot.astro";
import { appSkin, appSlotComponents, renderAppSkin } from "@/lib/extensions";
import { productPageData } from "@/lib/extensions/data";
import { placedProductModules, productModuleOf, type EmbedRender, type EmbedRenderers } from "@/lib/extensions/embeds";
import type { StorefrontProductPage } from "@scalius/shared/plugins/storefront-protocol";
import ThemeEditorMark from "@/components/ThemeEditorMark.astro";
import { THEME_EDITOR_MARKS, themeEditorModuleMark } from "@scalius/shared/theme-editor-bridge";
import TemplateSections from "@/components/homepage/TemplateSections.astro";
import { templateSectionData } from "@/lib/template-sections";
import { buildDeliveryFacts, productFulfilment, shippingMethodsForProfile, shippingMethodsForUnitPrice } from "@/lib/delivery-facts";
import { resolveProductPageCopy } from "@/components/product/lib/buyer-inputs";
import { formatMoney } from "@/lib/currency";
import { localizedPaths } from "@/lib/localized-paths";
import Layout from "@/layouts/Layout.astro";
import ProductBreadcrumbs from "@/components/product/ProductBreadcrumbs.astro";
import ProductGallery from "@/components/product/ProductGallery.astro";
import Container from "@/components/ui/Container.astro";
import ProductPageLayout from "@/components/product/ProductPageLayout.astro";
import ProductSectionNav from "@/components/product/ProductSectionNav.astro";
import ProductBuyBox from "@/components/product/ProductBuyBox.astro";
import RelatedProducts from "@/components/product/RelatedProducts.astro";
import RecentlyViewedRecord from "@/components/homepage/RecentlyViewedRecord.astro";
import StickyBuyBar from "@/components/product/StickyBuyBar.astro";
import ProductReviews from "@/components/product/reviews/ProductReviews.astro";
import ProductPageModule from "@/components/product/modules/ProductPageModule.astro";
import {
  KEY_ATTRIBUTES_MAX,
  compareSimilarProducts,
  descriptionInInfoColumn,
  featuresPlacement,
  productPageModules,
  publicSpecificationRows,
  type RenderedProductModule,
} from "@/components/product/lib/product-page-modules";
import { reviewStructuredData } from "@/lib/review-structured-data";
import { pickReviewCopy, readProductReviews } from "@/components/product/reviews/review-format";
import { pickReviewFormCopy } from "@/lib/account-reviews";
import { checkoutLanguageBaseCode } from "@scalius/shared/checkout-language";
import { readStoreShape, resolveRequestTheme } from "@/lib/storefront-theme-context";
import { resourceBindingContext } from "@/lib/setting-bindings";
import { resolveProductPageTheme } from "@/components/product/lib/product-page-theme";
import { storeContactLinks } from "@/lib/store-contact";
import { shopCopy } from "@/lib/storefront-shop-copy";
import { catalogCopy } from "@/lib/catalog-copy";
import { galleryStageRatio } from "@/components/product/lib/gallery-images";
import { productGalleryMainSlot } from "@/components/product/lib/gallery-images";
import { featuredGalleryItem, productGalleryItems } from "@/components/product/lib/gallery-media";
import { getProductImageUrl, hasProductImage, productImageSources } from "@/lib/product-media";
import { resolveMediaUrl } from "@/lib/media-url";
import { responsiveImageSources } from "@/lib/responsive-image";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { setRuntimeImageCdnPolicy } from "@/lib/api/runtime";
import {
  buildResourceCanonicalSeoUrl,
  getAbsoluteStorefrontSeoBaseUrl,
  buildAbsoluteStorefrontSeoUrl,
} from "@/lib/seo-base-url";
import {
  buildMerchantReturnPolicyJsonLd,
  buildOfferShippingDetails,
  buildProductGroupJsonLd,
  gtinJsonLdForVariant,
  physicalOfferShippingDetails,
  productSchemaDescription,
} from "@/lib/commerce-structured-data";
import {
  getBuyerStockSummary,
  isVariantAvailable,
  resolveBuyerVariants,
} from "@/lib/product-sellable-variants";
import {
  getBuyerVariantPricePresentation,
  getVariantDiscountedPrice,
} from "@/components/product/lib/pricing-engine";
import { initialVariantPresentation, resolveVariantImageForSelection } from "@/components/product/lib/variant-state-machine";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import {
  normalizeSavedProductCondition,
  PRODUCT_CONDITION_SCHEMA_URLS,
} from "@scalius/shared/product-condition";
import { resolveCatalogDiscoveryImageUrl } from "@scalius/shared/catalog-discovery-media";
import { DEFAULT_CURRENCY, getDecimalPlaces } from "@scalius/shared/currency";
import { resolvePriceIncrementMinor } from "@scalius/shared/currency-policy";
import { roundPriceToPrecision } from "@scalius/shared/price-utils";
import { htmlToPlainText } from "@scalius/shared/html-sanitize";
import RichTextStyles from "@/components/RichTextStyles.astro";

const { slug } = Astro.params;
// Handles are lowercase: a mis-cased link redirects to the one real URL.
const lowercaseRedirect = lowercaseHandleRedirect(Astro.url);
if (lowercaseRedirect) return lowercaseRedirect;
if (!slug) {
  return new Response(null, { status: 404 });
}

const layoutPromise = getLayoutData();
const productPromise = getProductBySlugResult(slug);
const shippingMethodsPromise = getShippingMethods();
const checkoutConfigPromise = getCheckoutConfig();

// Parallel fetch, one batch: layout, product, shipping and payment data.
const [layoutData, productResult, shippingMethods, checkoutConfig] = await Promise.all([
  layoutPromise,
  productPromise,
  shippingMethodsPromise,
  checkoutConfigPromise,
]);
setRuntimeImageCdnPolicy(layoutData?.media);
if (productResult.state === "not_found") {
  return new Response(null, { status: 404 });
}
if (productResult.state === "unavailable" || !layoutData) {
  const response = storefrontDataUnavailableResponse(
    "We could not load this product. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const productData = productResult.data;
const { product, category, media, variants, recommendations } = productData;

const requestTheme = await resolveRequestTheme(Astro, layoutData, resourceBindingContext(product, `/products/${product.slug}`, media));
// The theme editor's preview marks the page's parts so a click selects them.
const editorMarks = requestTheme.preview !== null;
const shop = shopCopy(requestTheme.language);
const productWords = catalogCopy(requestTheme.language).product;
const templateData = await templateSectionData("product", requestTheme);
const productTemplate = requestTheme.resolved.pages.templates.product;

// Theme -> Layout -> Product page: the gallery, the buy box's look and the
// modules below the fold, in the template's order.
const resolvedTheme = resolveProductPageTheme(
  requestTheme,
  product,
  readStoreShape(layoutData.storeShape),
);
const themeLayout = resolvedTheme.layout;
const productPageLayout = themeLayout.productPage;
const buyBoxLook = themeLayout.buyBox.look;
const factsColumn = buyBoxLook.facts === "column";
// Call and WhatsApp links and the EMI line show only when the buy box's settings ask for them.
const contactLinks = themeLayout.buyBox.whatsapp
  ? storeContactLinks(layoutData.business).filter((link) => link.kind !== "email")
  : [];
const buyBoxShowsEmi = themeLayout.buyBox.emi;

const similarProducts = compareSimilarProducts({ id: product.id, categoryId: category?.id ?? product.categoryId ?? null }, recommendations);
const storePolicies = layoutData.policies ?? [];
const sticky = resolvedTheme.blocks.product.sticky;
const detailsInBuyBox = descriptionInInfoColumn(buyBoxLook);
const specificationRows = publicSpecificationRows(product.attributes ?? []);
const keySpecificationRows = specificationRows.filter((row) => row.keySpec).slice(0, KEY_ATTRIBUTES_MAX);
const currencySymbol = layoutData.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData.currency?.code ?? DEFAULT_CURRENCY.code;
const configuredCurrencyDecimalPlaces = layoutData.currency?.decimalPlaces;
const currencyDecimalPlaces =
  typeof configuredCurrencyDecimalPlaces === "number" &&
  Number.isInteger(configuredCurrencyDecimalPlaces) &&
  configuredCurrencyDecimalPlaces >= 0 &&
  configuredCurrencyDecimalPlaces <= 6
    ? configuredCurrencyDecimalPlaces
    : getDecimalPlaces(currencyCode);
// Server renders have no page globals: prices use the store's increment explicitly.
const currencyPriceIncrement = resolvePriceIncrementMinor(currencyCode, layoutData.currency?.priceIncrementMinor);
const formatMetadataPrice = (price: number) =>
  roundPriceToPrecision(price, currencyDecimalPlaces).toFixed(
    currencyDecimalPlaces,
  );
const buyerVariantResolution = resolveBuyerVariants(variants);
const buyerVariants = buyerVariantResolution.variants;
const buyerStockSummary = getBuyerStockSummary(buyerVariants);
// One page per product: a `?variant=` link is this page from the edge cache
// (the query never reaches the render), and the buy box's pre-paint script
// picks that SKU in the browser. The server states the opening choice.
const buyerInitialPresentation = initialVariantPresentation(
  product.options ?? [],
  buyerVariants,
);
const buyerPricingVariants = buyerInitialPresentation.pricingVariants;
// The opening choice's own photo is the gallery's first paint (Dawn's
// "selected or first available variant" featured media), so the selected
// swatch and the photo agree before any script runs.
const initialVariantMediaId = resolveVariantImageForSelection(
  buyerVariants,
  buyerInitialPresentation.selection,
);
const buyerPricePresentation = getBuyerVariantPricePresentation(
  {
    basePrice: product.price,
    discountType: product.discountType,
    discountPercentage: product.discountPercentage,
    discountAmount: product.discountAmount,
    currencyDecimalPlaces,
    currencyCode,
    priceIncrementMinor: currencyPriceIncrement,
  },
  buyerPricingVariants,
);
const buyerDisplayedPrice = buyerPricePresentation.pricing.finalPrice;
const fbViewVariants = buyerPricePresentation.isStartingAt
  ? []
  : buyerVariants.slice(0, 1).map((variant) => ({
      ...variant,
      price: buyerDisplayedPrice,
    }));

const pageMetaDescription = product.metaDescription?.trim() || "";

const productCategory = category ?? null;
const productCategoryUrl = productCategory
  ? buildResourceCanonicalSeoUrl(
      "category",
      `/categories/${productCategory.slug}`,
      productCategory.canonicalPath,
    )
  : null;

const productOptions = product.options ?? [];

const pageTitle = product.metaTitle || product.name;
const pageDescription = pageMetaDescription;
// Product-page copy in the store's checkout language (buttons, buyer inputs).
const productPageCopy = resolveProductPageCopy(layoutData.storefrontCopy);
// Reviews read the same language (the summary, the module and its dates).
const reviewCopy = pickReviewCopy(productPageCopy);
const reviewFormCopy = pickReviewFormCopy(productPageCopy, productPageCopy);
const reviewLanguage = checkoutLanguageBaseCode(layoutData.storefrontCopy?.languageCode);
const quickBuyNoticeByError: Record<string, string> = {
  customization_required: productPageCopy.customizationNeededText,
  customization_invalid: productPageCopy.customizationInvalidText,
  customization_unavailable: productPageCopy.customizationUnavailableText,
  product_unavailable: productWords.quickBuy.productUnavailable,
  variant_required: productWords.quickBuy.variantRequired,
  variant_not_found: productWords.quickBuy.variantNotFound,
  out_of_stock: productWords.quickBuy.outOfStock,
  invalid_quantity: productWords.quickBuy.invalidQuantity,
  quantity_unavailable: productWords.quickBuy.quantityUnavailable,
  price_changed: productWords.quickBuy.priceChanged,
  purchase_option_unavailable: productWords.quickBuy.purchaseOptionUnavailable,
  validation_unavailable: productWords.quickBuy.validationUnavailable,
  processing_failed: productWords.quickBuy.processingFailed,
};
const quickBuyNotice =
  quickBuyNoticeByError[Astro.url.searchParams.get("error") ?? ""] ?? null;

// --- SEO: per SEO-01, SEO-02, OG-01, OG-05 ---
const storefrontUrl = getAbsoluteStorefrontSeoBaseUrl();
const canonicalUrl = buildResourceCanonicalSeoUrl(
  "product",
  `/products/${product.slug}`,
  product.canonicalPath,
);
// Its URL in each language (MARKETS-DESIGN D9): the hreflang alternates.
const productPaths = localizedPaths(product, (handle) => `/products/${handle}`);

// Shared product-image representation is first; remaining image associations
// and video posters are included in structured data without ever treating a
// video content URL as an image.
const productImageCandidates = [
  product.imageUrl,
  ...media.map((item) => (item.kind === "image" ? item.url : item.posterUrl)),
].filter((url): url is string => hasProductImage(url));
const primaryImageUrl = productImageCandidates[0] ?? null;
// The gallery's own order and featured item (lib/gallery-media): the LCP
// preload names exactly the file the first paint shows, with the srcset and
// sizes of its slot. A video first paints its poster (in the photo's slot),
// never the video.
const galleryItems = productGalleryItems(product, media, buyerVariants);
const initialGalleryMedia = featuredGalleryItem(galleryItems, initialVariantMediaId);
// The photo box adapts to the photo the page paints first (its stored size,
// within bounds), so a square photo never sits in a tall box with bands.
const galleryLayout = {
  ...productPageLayout,
  stageRatio: galleryStageRatio(productPageLayout, requestTheme.theme.tokens.imageRatio, initialGalleryMedia?.aspectRatio ?? null),
};
const galleryMainSlot = productGalleryMainSlot(productPageLayout, galleryItems.length > 1);
const initialGalleryPreload =
  initialGalleryMedia?.kind === "video"
    ? initialGalleryMedia.posterUrl
      ? responsiveImageSources(initialGalleryMedia.posterUrl, galleryMainSlot)
      : null
    : initialGalleryMedia
      ? responsiveImageSources(initialGalleryMedia.url, galleryMainSlot)
      : primaryImageUrl
        ? productImageSources(primaryImageUrl, galleryMainSlot)
        : null;
const serializedProductImageUrl = getProductImageUrl(primaryImageUrl, 640);
const schemaImageUrls = storefrontUrl
  ? Array.from(
      new Set(
        productImageCandidates.flatMap((candidate) => {
          const resolved = resolveCatalogDiscoveryImageUrl(
            candidate,
            storefrontUrl,
            { resolveImageUrl: resolveMediaUrl },
          );
          return resolved ? [resolved] : [];
        }),
      ),
    )
  : [];
const ogImageUrl = schemaImageUrls[0] ?? null;

// Description for OG and JSON-LD -- strip HTML (per research constraint)
const seoDescription = (
  htmlToPlainText(pageMetaDescription || product.description || product.name)
)
  .slice(0, 200);

const sellerSchemaName =
  layoutData.business?.companyName?.trim() ||
  layoutData.business?.legalName?.trim() ||
  null;

// Brand from the published brand record only (never a "Brand" attribute; none is omitted)
const brandName = product.brand?.name?.trim() || null;
const productCondition = normalizeSavedProductCondition(
  product.productCondition,
);
const productConditionSchemaUrl = productCondition
  ? PRODUCT_CONDITION_SCHEMA_URLS[productCondition]
  : null;

// Primary SKU
const primarySku = buyerVariants[0]?.sku || product.id;

function normalizedVariantOption(
  value: string | null | undefined,
): string | null {
  const normalized = value?.trim();
  return normalized ? normalized : null;
}

const PRODUCT_OPTION_SCHEMA_URLS = {
  size: "https://schema.org/size",
  color: "https://schema.org/color",
  material: "https://schema.org/material",
  pattern: "https://schema.org/pattern",
} as const;

function mappedVariantSchemaProps(
  variant: (typeof buyerVariants)[number],
): Record<string, string> {
  const props: Record<string, string> = {};
  for (const option of variant.selectedOptions) {
    const schema = option.standardMapping;
    if (schema === "none" || props[schema]) continue;
    props[schema] = option.value;
  }

  return props;
}

function buildVariantProductUrl(
  variant: (typeof buyerVariants)[number],
): string | null {
  if (!canonicalUrl) return null;

  const url = new URL(canonicalUrl);
  url.searchParams.set("variant", variant.id);
  return url.toString();
}

function getVariantSchemaName(variant: (typeof buyerVariants)[number]): string {
  const options = variant.selectedOptions.map(
    (option) => `${option.name}: ${option.value}`,
  );
  return options.length > 0
    ? `${product.name} - ${options.join(" / ")}`
    : product.name;
}

function getVariantSchemaPrice(
  variant: (typeof buyerVariants)[number],
): number {
  return getVariantDiscountedPrice(
    variant.price,
    product.price,
    variant.discountType,
    variant.discountPercentage,
    variant.discountAmount,
    product.discountType,
    product.discountPercentage,
    product.discountAmount,
    currencyDecimalPlaces,
    currencyCode,
    currencyPriceIncrement,
  );
}

function getVariantSchemaImages(
  variant: (typeof buyerVariants)[number],
): string[] {
  if (!storefrontUrl || !variant.imageUrl) return schemaImageUrls;
  const resolved = resolveCatalogDiscoveryImageUrl(
    variant.imageUrl,
    storefrontUrl,
    { resolveImageUrl: resolveMediaUrl },
  );
  return resolved
    ? Array.from(new Set([resolved, ...schemaImageUrls]))
    : schemaImageUrls;
}

const productGroupVariesBy = productOptions
  .flatMap((option) =>
    option.standardMapping === "none"
      ? []
      : [PRODUCT_OPTION_SCHEMA_URLS[option.standardMapping]],
  )
  .filter((value, index, values) => values.indexOf(value) === index);
const shouldEmitProductGroupJsonLd =
  buyerVariantResolution.mode === "optioned" &&
  buyerVariants.length > 0;

// The countries the page's market sells to: delivery facts and Offer
// shippingDetails claim only those a shipping zone serves (MARKETS-DESIGN step 3b).
const pageCountries = presenceMarketCountries(layoutData.markets, getRuntimePresence());
// What this product pays behind each option: its shipping profile's rates.
const productShippingMethods = shippingMethodsForProfile(shippingMethods, product.shippingProfileId);
const offerShippingDetails = buildOfferShippingDetails({
  // One unit at its lowest price, as the feeds state it: a free-over it reaches ships it free.
  shippingMethods: shippingMethodsForUnitPrice(productShippingMethods, buyerDisplayedPrice),
  currencyCode,
  freeDelivery: product.freeDelivery,
  countries: pageCountries,
});
// What the page sells decides what it may say about delivery: services and
// digital items claim no delivery rates and no Offer shippingDetails.
const pageFulfilment = productFulfilment(product, buyerVariants);
// Delivery fees, cash on delivery and returns, stated under the buy buttons.
const deliveryFacts = buildDeliveryFacts({
  shippingMethods: productShippingMethods,
  checkoutConfig,
  returnPolicy: layoutData.seo?.returnPolicy,
  freeDelivery: product.freeDelivery,
  fulfilment: pageFulfilment,
  payAtServiceText: productPageCopy.payAtServiceText,
  pickupAvailableText: productPageCopy.pickupAvailableText,
  formatMoney: (amount) => formatMoney(amount, { code: currencyCode, symbol: currencySymbol }),
  countries: pageCountries,
});
const fulfilmentBadge =
  pageFulfilment === "service" ? productPageCopy.noDeliveryNeededBadgeText : null;
// Digital items and gift cards are paid online, never in cash: on a store
// whose checkout takes only cash on delivery the page says so instead of
// starting a purchase checkout must refuse. A product with a physical or
// service SKU stays buyable; a cart that also holds a digital item is refused cash at checkout.
const onlinePaymentUnavailable =
  productFulfilment(product, buyerVariants) === "digital" && !takesOnlinePayment(checkoutConfig);
const merchantReturnPolicyJsonLd = buildMerchantReturnPolicyJsonLd({
  settings: layoutData.seo?.returnPolicy,
  storefrontUrl,
  fallbackCountry: layoutData.business?.country,
});

function withOfferCommerceDetails<T extends Record<string, unknown>>(
  offer: T,
  offerVariants: typeof buyerVariants,
): T {
  // Services, digital items and gift cards are never shipped.
  const shippingDetails = physicalOfferShippingDetails(offerShippingDetails, product, offerVariants);
  return {
    ...offer,
    ...(sellerSchemaName
      ? { seller: { "@type": "Organization", name: sellerSchemaName } }
      : {}),
    ...(shippingDetails.length > 0
      ? { shippingDetails }
      : {}),
    ...(merchantReturnPolicyJsonLd
      ? { hasMerchantReturnPolicy: merchantReturnPolicyJsonLd }
      : {}),
  } as T;
}

const primarySchemaVariant = buyerVariants[0] ?? null;

// An app skin of the product page's main part (`apps.skins["product_main"]`):
// drawn from the page's projection around the store's own buy form, else
// the core breadcrumbs, gallery and buy box. The reviews and related
// products it places replace the template's modules of the same. The
// projection is built once and shared by the core buy box, skins and component blocks.
const productPath = product.canonicalPath?.startsWith("/") ? product.canonicalPath : `/products/${product.slug}`;
let pageProjection: StorefrontProductPage | null = null;
const productPageProjection = (): StorefrontProductPage => pageProjection ??= productPageData({
  product,
  media,
  variants: buyerVariants,
  options: productOptions,
  url: productPath,
  breadcrumbs: [
    { title: catalogCopy(requestTheme.language).breadcrumb.home, url: "/" },
    ...(productCategory ? [{ title: productCategory.name, url: productCategory.canonicalPath || `/categories/${encodeURIComponent(productCategory.slug)}` }] : []),
    { title: product.name, url: productPath },
  ],
  price: { current: buyerDisplayedPrice, regular: buyerPricePresentation.pricing.originalPrice, from: buyerPricePresentation.isStartingAt },
  variantPrice: getVariantSchemaPrice,
  page: { currencyCode, currencySymbol },
});
const productMainSkin = await appSkin(Astro.locals, Astro.url, "product_main");
const productMainMarkup = productMainSkin
  ? await renderAppSkin(Astro.locals, Astro.url, productMainSkin, { data: productPageProjection() })
  : null;
const skinEmbeds = productMainMarkup?.embeds ?? new Set<string>();

// Modules the product has data for, in the template's order (a module with
// nothing to show is left out); the description stays in the buy box on
// classic and Dawn, but a skin's buy form draws no details, so with a skin
// the details module carries them. Every module reads data this page already has.
const pageModules = productPageModules(resolvedTheme.blocks.product.below, product, {
  look: productMainMarkup ? { ...buyBoxLook, details: "below" } : buyBoxLook,
  hasRelated: recommendations.products.length > 0,
  similar: similarProducts.length,
  policies: storePolicies.length,
});
const featuresAt = featuresPlacement(pageModules, buyBoxLook);
// A module the skin places draws there and not again below.
const placedModules = productMainMarkup ? placedProductModules(productMainMarkup.parts) : new Set<RenderedProductModule>();
// The details module draws the description, except below a skin (the skin
// draws it itself) unless the skin places the module, which is then the
// store's whole details module. With nothing to draw it goes.
const detailsDescription = !productMainMarkup || placedModules.has("description");
const detailsContent = (detailsDescription && Boolean(product.description))
  || (product.additionalInfo?.length ?? 0) > 0 || (featuresAt === "description" && (product.features?.length ?? 0) > 0);
// Every module the page draws, below or where the skin placed it.
const drawnModules = pageModules.filter((module) => module !== "description" || detailsContent);
const shownModules = drawnModules.filter((module) => !placedModules.has(module)
  && !(module === "reviews" && skinEmbeds.has("reviews")) && !(module === "related" && skinEmbeds.has("recommendations")));
// The anchor bar links only modules the page draws.
const detailAnchorIds: Record<string, string> = {
  "about-bullets": "about",
  "key-attributes": "highlights",
  "spec-table": "specifications",
  description: "description",
  "content-blocks": "content",
};
const detailAnchorId = drawnModules.map((module) => detailAnchorIds[module]).find(Boolean) ?? null;
const exploreAnchorId = drawnModules.includes("related") && recommendations.products.length > 0 ? "related-products" : null;
const reviewsAnchorId = drawnModules.includes("reviews") && readProductReviews(product.reviews) ? "reviews" : null;
const appsBelow = (await appSlotComponents(Astro.locals, Astro.url, "product.below")).length > 0;
const buyBox = {
  summary: {
    product,
    category: productCategory,
    variants: buyerVariants,
    options: productOptions,
    currencySymbol,
    currencyCode,
    currencyDecimalPlaces,
    priceIncrementMinor: currencyPriceIncrement,
    quickBuyNotice,
    onlinePaymentUnavailable,
    actionCopy: productPageCopy,
    fulfilmentBadge,
    look: buyBoxLook,
    stockWords: shop.product.stock,
    soldOutCopy: { note: shop.product.soldOutNote, similar: shop.product.seeSimilar },
    details: detailsInBuyBox,
    detailsFeatures: featuresAt === "description",
  },
  reviewCopy,
  features: { shown: featuresAt === "buy-box", title: productPageCopy.productKeyFeaturesText },
  emi: buyBoxShowsEmi,
  contactLinks,
  contactCopy: shop.product.contact,
  blockData: productPageProjection,
  fulfilment: pageFulfilment,
  deliveryFacts,
  canPurchaseAny: buyerStockSummary.canPurchaseAny,
};
// One of the template's modules, below the fold or where a skin places it.
const moduleProps = (module: RenderedProductModule) => ({
  module,
  mark: editorMarks ? themeEditorModuleMark(module) : null,
  product,
  description: detailsDescription,
  detailsFeatures: featuresAt === "description",
  specificationRows,
  keySpecificationRows,
  similarProducts,
  policies: storePolicies,
  recommendations,
  currencySymbol,
  currencyCode,
  copy: productPageCopy,
  words: productWords,
  reviews: { copy: reviewCopy, formCopy: reviewFormCopy, language: reviewLanguage, storeName: sellerSchemaName },
});
// What a product_main skin's embeds render: the store's own buy box (the
// skin owns the description), gallery, reviews, related products and the
// template's modules it places.
const productGalleryProps = {
  product,
  media,
  initialProductMediaId: initialVariantMediaId,
  variants: buyerVariants,
  layout: galleryLayout,
  playVideoLabel: productPageCopy.productPlayVideoText,
  zoomLabel: shop.product.zoomPhoto,
  zoomOfLabel: shop.product.zoomPhotoOf,
  showAllLabel: shop.product.showAllPhotos,
  stepLabels: { previous: shop.product.previousPhoto, next: shop.product.nextPhoto },
  positionLabel: shop.product.photoOf,
};
const productEmbeds: EmbedRenderers = {
  "buy_form": ({ data }) => ({
    component: ProductBuyBox as EmbedRender["component"],
    props: { ...buyBox, summary: { ...buyBox.summary, details: false, title: data.title !== "false" } },
  }),
  gallery: () => ({ component: ProductGallery as EmbedRender["component"], props: productGalleryProps }),
  reviews: () => ({
    component: ProductReviews as EmbedRender["component"],
    props: { product, copy: reviewCopy, formCopy: reviewFormCopy, language: reviewLanguage, storeName: sellerSchemaName },
  }),
  recommendations: () => recommendations.products.length > 0
    ? { component: RelatedProducts as EmbedRender["component"], props: { recommendations, currencySymbol, currencyCode } }
    : null,
  // A placed details module draws whenever it has something, even where the
  // template lists none: the skin that places it draws no description itself.
  "product_module": ({ data }) => {
    const module = productModuleOf(data.name);
    return module && (drawnModules.includes(module) || (module === "description" && detailsContent))
      ? { component: ProductPageModule as EmbedRender["component"], props: moduleProps(module) }
      : null;
  },
};

// Product JSON-LD -- per SEO-01 (merchant listing spec). The description is
// stated once (plain text, capped), never per variant.
const schemaDescription = productSchemaDescription(product.description, product.name);
// Rating and reviews join the Product or ProductGroup root, from the same
// `product.reviews` the summary and the module render (none at 0 or when off).
// Review items are stated only where the page shows them (the `reviews`
// module); the rating stays with the summary under the title.
const pageReviewSchema = reviewStructuredData(product);
const reviewSchema = pageReviewSchema && !shownModules.includes("reviews") && !skinEmbeds.has("reviews")
  ? { aggregateRating: pageReviewSchema.aggregateRating }
  : pageReviewSchema;
const productJsonLd =
  !product.noIndex && canonicalUrl
    ? serializeJsonForInlineScript(
        shouldEmitProductGroupJsonLd
          ? buildProductGroupJsonLd({
              name: product.name,
              url: canonicalUrl,
              description: schemaDescription,
              images: schemaImageUrls,
              productGroupID: product.id,
              brandName,
              variesBy: productGroupVariesBy,
              rootFacts: reviewSchema,
              variants: buyerVariants.map((variant) => {
                const variantUrl = buildVariantProductUrl(variant) ?? canonicalUrl;
                return {
                  name: getVariantSchemaName(variant),
                  url: variantUrl,
                  image: getVariantSchemaImages(variant)[0] ?? null,
                  sku: normalizedVariantOption(variant.sku) || variant.id,
                  properties: {
                    ...gtinJsonLdForVariant(variant.barcode, variant.barcodeType),
                    ...mappedVariantSchemaProps(variant),
                  },
                  offer: withOfferCommerceDetails({
                    "@type": "Offer",
                    url: variantUrl,
                    priceCurrency: currencyCode,
                    price: formatMetadataPrice(getVariantSchemaPrice(variant)),
                    ...(productConditionSchemaUrl
                      ? { itemCondition: productConditionSchemaUrl }
                      : {}),
                    availability: isVariantAvailable(variant)
                      ? "https://schema.org/InStock"
                      : "https://schema.org/OutOfStock",
                  }, [variant]),
                };
              }),
            })
          : {
              "@context": "https://schema.org",
              "@type": "Product",
              name: product.name,
              url: canonicalUrl,
              description: schemaDescription,
              ...(schemaImageUrls.length > 0 ? { image: schemaImageUrls } : {}),
              sku: primarySku,
              ...gtinJsonLdForVariant(
                primarySchemaVariant?.barcode,
                primarySchemaVariant?.barcodeType,
              ),
              ...(brandName
                ? { brand: { "@type": "Brand", name: brandName } }
                : {}),
              ...reviewSchema,
              offers: withOfferCommerceDetails({
                "@type": "Offer",
                url: canonicalUrl,
                priceCurrency: currencyCode,
                price: formatMetadataPrice(buyerDisplayedPrice),
                ...(productConditionSchemaUrl
                  ? { itemCondition: productConditionSchemaUrl }
                  : {}),
                availability: buyerStockSummary.canPurchaseAny
                  ? "https://schema.org/InStock"
                  : "https://schema.org/OutOfStock",
              }, buyerVariants),
            },
      )
    : null;

// BreadcrumbList JSON-LD -- per SEO-02
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: catalogCopy(requestTheme.language).breadcrumb.home, item: buildAbsoluteStorefrontSeoUrl("/") },
  ...(productCategory && productCategoryUrl
    ? [
        {
          "@type": "ListItem",
          position: 2,
          name: productCategory.name,
          item: productCategoryUrl,
        },
      ]
    : []),
  {
    "@type": "ListItem",
    position: productCategory ? 3 : 2,
    name: product.name,
    item: canonicalUrl,
  },
];
const breadcrumbJsonLd =
  !product.noIndex &&
  storefrontUrl &&
  canonicalUrl
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbItems,
      })
    : null;

const productCategoryAnalytics = productCategory
  ? {
      id: productCategory.id,
      name: productCategory.name,
      slug: productCategory.slug,
    }
  : null;
---

<Layout
  title={pageTitle}
  description={seoDescription || pageDescription}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  localizedPaths={productPaths}
  ogImage={ogImageUrl ?? undefined}
  ogType="product"
  ogPrice={formatMetadataPrice(buyerDisplayedPrice)}
  ogCurrency={currencyCode}
  noindex={product.noIndex === true}
>
  <Fragment slot="head">
    <RichTextStyles />
  </Fragment>

  <Fragment slot="preload">
    {
      initialGalleryPreload && (!productMainMarkup || skinEmbeds.has("gallery")) && (
        <link
          rel="preload"
          as="image"
          href={initialGalleryPreload.srcset ? undefined : initialGalleryPreload.src}
          imagesrcset={initialGalleryPreload.srcset}
          imagesizes={initialGalleryPreload.sizes}
          fetchpriority="high"
        />
      )
    }
  </Fragment>

  <TemplateSections
    template={productTemplate}
    region="before"
    data={templateData}
    deliveryFacts={deliveryFacts}
    currencySymbol={currencySymbol}
    currencyCode={currencyCode}
    preview={editorMarks}
    languageCode={layoutData.storefrontCopy?.languageCode}
  />

  <div
    class="min-h-screen bg-background product-container"
    id="product-container"
    data-product-id={product.id}
    data-product-slug={product.slug}
    data-product-name={product.name}
    data-product-price={String(buyerDisplayedPrice)}
    data-product-original-price={String(product.price)}
    data-product-image={serializedProductImageUrl}
    data-product-image-media-id={product.imageMediaId ?? undefined}
    data-product-discount-type={product.discountType || ""}
    data-product-discount-percentage={String(product.discountPercentage || 0)}
    data-product-discount-amount={String(product.discountAmount || 0)}
    data-currency-decimal-places={String(currencyDecimalPlaces)}
    data-product-free-delivery={product.freeDelivery.toString()}
    data-product-has-variants={product.hasVariants.toString()}
    data-fb-product-details={JSON.stringify({
      id: product.id,
      slug: product.slug,
      name: product.name,
      discountedPrice: buyerDisplayedPrice,
    })}
    data-fb-category-details={JSON.stringify(productCategoryAnalytics)}
    data-fb-variants-details={JSON.stringify(fbViewVariants)}
  >
    {productMainMarkup ? (
      <div data-product-main="skin" data-theme-section-id={editorMarks ? THEME_EDITOR_MARKS.productMain : undefined}>
        <AppComponent markup={productMainMarkup} embeds={productEmbeds} />
      </div>
    ) : (
      <Fragment>
        <div class="lg:pt-2">
          <ProductBreadcrumbs product={product} category={productCategory} />
        </div>

        <Container
          as="section"
          class="py-2 sm:py-4 lg:py-6"
          style={factsColumn ? "max-inline-size: 87.5rem" : undefined}
          data-theme-section-id={editorMarks ? THEME_EDITOR_MARKS.productMain : undefined}
        >
          <ProductPageLayout gallery={productPageLayout.gallery} factsColumn={factsColumn}>
            <ProductGallery {...productGalleryProps} />
            <ProductBuyBox {...buyBox} />
          </ProductPageLayout>
        </Container>
      </Fragment>
    )}

    <StickyBuyBar
      productName={product.name}
      action={buyerStockSummary.canPurchaseAny && product.customizationUnavailable !== true && !onlinePaymentUnavailable
        ? { label: productPageCopy.addToCartText, disabled: false }
        : { label: productPageCopy.unavailableText, disabled: true }}
      price={formatMoney(buyerDisplayedPrice, { code: currencyCode, symbol: currencySymbol })}
      phone={sticky.phoneBottom === "buy-bar"}
      desktop={sticky.desktop === "product-bar"}
    />

    <ProductSectionNav
      detailsId={detailAnchorId}
      exploreId={exploreAnchorId}
      reviewsId={reviewsAnchorId}
      phone={sticky.phoneTop === "anchor-bar"}
      desktop={sticky.desktop === "anchor-bar"}
    />

    {/* The template's modules below the fold, in its order (each a preview mark in the theme editor). */}
    {shownModules.map((module) => <ProductPageModule {...moduleProps(module)} />)}

    {/* Installed apps' blocks after the template's modules. */}
    <ThemeEditorMark id={editorMarks && appsBelow ? THEME_EDITOR_MARKS.productApps : null}>
      <AppSlot name="product.below" data={productPageProjection} />
    </ThemeEditorMark>
  </div>

  <TemplateSections
    template={productTemplate}
    region="after"
    data={templateData}
    deliveryFacts={deliveryFacts}
    currencySymbol={currencySymbol}
    currencyCode={currencyCode}
    preview={editorMarks}
    languageCode={layoutData.storefrontCopy?.languageCode}
  />

  <RecentlyViewedRecord
    id={product.id}
    slug={product.slug}
    name={product.name}
    image={hasProductImage(primaryImageUrl) ? getProductImageUrl(primaryImageUrl, 320) : null}
  />

  {/* Product discovery data stays server-rendered but follows visible buyer
      content so it cannot delay parser discovery of the product UI. */}
  {
    productJsonLd && (
      <script is:inline type="application/ld+json" set:html={productJsonLd} />
    )
  }
  {
    breadcrumbJsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={breadcrumbJsonLd}
      />
    )
  }
</Layout>

<script>
  import { init } from "@/components/product/scripts/product-controller";
  import { installStickyColumns } from "@/components/product/scripts/sticky-column";

  // Astro's bundled module scripts are deferred, so the product DOM is ready
  // without leaving visible option controls temporarily inert.
  init();
  // The buy column beside a long gallery (core stacked/grid, or a skin's own).
  installStickyColumns();
</script>
<script>
  import type { Product, Category, ProductVariant } from "@/lib/api";
  import { scheduleNonCriticalAnalytics } from "@/lib/non-critical-analytics";

  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("product-container");
    if (!container) return;

    const productDataAttr = container.dataset.fbProductDetails;
    const categoryDataAttr = container.dataset.fbCategoryDetails;
    const variantsDataAttr = container.dataset.fbVariantsDetails;

    if (!productDataAttr || !categoryDataAttr || !variantsDataAttr) {
      console.error("FB ViewContent: Missing data attributes on container.");
      return;
    }

    try {
      const product: Product = JSON.parse(productDataAttr);
      const category: Category | null = JSON.parse(categoryDataAttr);
      const variants: ProductVariant[] = JSON.parse(variantsDataAttr);

      const triggerAnalytics = () => {
        import("@/lib/analytics").then(({ trackFbViewContent }) => {
          trackFbViewContent({
            content_ids: [product.id],
            content_name: product.name,
            content_category: category?.name,
            content_type: "product",
            currency: window.__CURRENCY_CODE__ || "BDT",
            value: product.discountedPrice,
            contents:
              variants.length > 0
                ? variants.map((v: ProductVariant) => ({
                    id: v.id && v.id !== "default" ? v.id : product.id,
                    quantity: 1,
                    item_price: v.price || product.discountedPrice,
                  }))
                : [
                    {
                      id: product.id,
                      quantity: 1,
                      item_price: product.discountedPrice,
                    },
                  ],
          });
        });
      };

      scheduleNonCriticalAnalytics(triggerAnalytics);
    } catch (error: unknown) {
      console.error("FB ViewContent: Error parsing data attributes:", error);
    }
  });
</script>

<style is:inline>
  .product-container {
    scroll-behavior: smooth;
  }
</style>
