---
import { env as cfEnv } from "cloudflare:workers";
import {
  THEME_PREVIEW_HANDOFF_ACCEPTED,
  THEME_PREVIEW_HANDOFF_FAILED,
  THEME_PREVIEW_HANDOFF_READY,
  THEME_PREVIEW_HANDOFF_TOKEN,
} from "@scalius/shared/theme-preview-handoff";

import {
  normalizeThemePreviewDashboardOrigin,
  normalizeThemePreviewDevice,
  normalizeThemePreviewRoutePath,
} from "@/lib/theme-preview-route";

export const prerender = false;

const dashboardOrigin = normalizeThemePreviewDashboardOrigin(cfEnv.DASHBOARD_URL);
const routePath = normalizeThemePreviewRoutePath(Astro.url.searchParams.get("path"));
const device = normalizeThemePreviewDevice(Astro.url.searchParams.get("device"));

Astro.response.headers.set("Cache-Control", "private, no-cache, no-store, must-revalidate");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
if (!dashboardOrigin) Astro.response.status = 503;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Opening storefront draft preview</title>
    <style>
      :root { color-scheme: light dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 1.25rem; background: #f4f4f5; color: #18181b; }
      main { width: min(100%, 27rem); border: 1px solid #d4d4d8; border-radius: .8rem; background: #fff; padding: 1.25rem; box-shadow: 0 10px 32px rgba(0,0,0,.08); }
      h1 { margin: 0; font-size: 1.05rem; }
      p { margin: .5rem 0 0; color: #52525b; font-size: .875rem; line-height: 1.45; }
      @media (prefers-color-scheme: dark) { body { background: #111113; color: #f4f4f5; } main { border-color: #34343a; background: #18181b; } p { color: #a1a1aa; } }
    </style>
  </head>
  <body>
    <main
      data-theme-preview-handoff
      data-dashboard-origin={dashboardOrigin}
      data-route-path={routePath}
      data-device={device}
      data-ready-type={THEME_PREVIEW_HANDOFF_READY}
      data-token-type={THEME_PREVIEW_HANDOFF_TOKEN}
      data-accepted-type={THEME_PREVIEW_HANDOFF_ACCEPTED}
      data-failed-type={THEME_PREVIEW_HANDOFF_FAILED}
    >
      <h1>{dashboardOrigin ? "Opening saved draft preview…" : "Draft preview unavailable"}</h1>
      <p data-handoff-status>
        {dashboardOrigin
          ? "Securely connecting this storefront to the dashboard."
          : "The trusted dashboard origin is not configured."}
      </p>
    </main>
    {dashboardOrigin && (
      <script>
        import {
          isThemePreviewHandoffMessage,
          isThemePreviewToken,
          THEME_PREVIEW_HANDOFF_ACCEPTED,
          THEME_PREVIEW_HANDOFF_FAILED,
          THEME_PREVIEW_HANDOFF_READY,
          THEME_PREVIEW_HANDOFF_TOKEN,
        } from "@scalius/shared/theme-preview-handoff";

        const root = document.querySelector<HTMLElement>("[data-theme-preview-handoff]");
        const status = document.querySelector<HTMLElement>("[data-handoff-status]");
        const dashboardOrigin = root?.dataset.dashboardOrigin ?? "";
        const routePath = root?.dataset.routePath ?? "/";
        const device = root?.dataset.device ?? "full";
        const opener = window.opener;
        let finished = false;

        const setFailure = (message: string) => {
          finished = true;
          window.clearInterval(readyInterval);
          window.clearTimeout(timeout);
          window.removeEventListener("message", receiveToken);
          if (status) status.textContent = message;
        };

        const announceReady = () => {
          if (finished || !opener || !dashboardOrigin) return;
          opener.postMessage({ type: THEME_PREVIEW_HANDOFF_READY }, dashboardOrigin);
        };

        async function receiveToken(event: MessageEvent) {
          if (
            finished ||
            event.origin !== dashboardOrigin ||
            event.source !== opener ||
            !isThemePreviewHandoffMessage(event.data, THEME_PREVIEW_HANDOFF_TOKEN) ||
            !isThemePreviewToken(event.data.token)
          ) {
            return;
          }
          finished = true;
          window.clearInterval(readyInterval);
          window.clearTimeout(timeout);
          try {
            const response = await fetch("/theme-preview/session", {
              method: "POST",
              headers: { "Accept": "application/json", "Content-Type": "application/json" },
              credentials: "same-origin",
              body: JSON.stringify({ token: event.data.token }),
            });
            if (!response.ok) throw new Error("Preview session was rejected");
            opener?.postMessage({ type: THEME_PREVIEW_HANDOFF_ACCEPTED }, dashboardOrigin);
            window.removeEventListener("message", receiveToken);
            try { window.opener = null; } catch { /* WindowProxy may be immutable. */ }
            const destination = new URL("/theme-preview", window.location.origin);
            destination.searchParams.set("path", routePath);
            destination.searchParams.set("device", device);
            window.location.replace(destination);
          } catch {
            opener?.postMessage({ type: THEME_PREVIEW_HANDOFF_FAILED }, dashboardOrigin);
            setFailure("The saved draft could not be opened. Return to Theme settings and try again.");
          }
        }

        window.addEventListener("message", receiveToken);
        const readyInterval = window.setInterval(announceReady, 250);
        const timeout = window.setTimeout(() => {
          setFailure("The dashboard connection timed out. Return to Theme settings and try again.");
        }, 15_000);
        announceReady();
      </script>
    )}
  </body>
</html>
