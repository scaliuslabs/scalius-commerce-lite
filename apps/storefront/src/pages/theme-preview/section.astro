---
// One homepage section of the saved theme draft, rendered by the same
// components as the homepage (HomepageSections with `only`): the theme
// editor's bridge swaps it into the framed page after a settings change.
// Preview-only: it answers 401 without a valid preview cookie, is private
// and never stored, and states the page layout it was rendered for, so the
// bridge reloads the whole page when a change moved anything else.
export const partial = true;
export const prerender = false;

import { presenceMarketCountries } from "@/lib/checkout/shipping-country";
import { getRuntimePresence } from "@/lib/api/runtime";
import HomepageSections from "@/components/homepage/HomepageSections.astro";
import { getCheckoutConfig, getLayoutData, getShippingMethods, getThemePreviewHomepageSections } from "@/lib/api";
import { buildDeliveryFacts } from "@/lib/delivery-facts";
import { formatMoney } from "@/lib/currency";
import { EMPTY_HOMEPAGE_SECTION_DATA, homepageContent, homepageLeadSection } from "@/lib/homepage-sections";
import { resolveRequestTheme } from "@/lib/storefront-theme-context";
import { clearThemePreviewCookieHeader, readThemePreviewCookie } from "@/lib/theme-preview-cookie";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import { homeSectionsShowDeliveryFacts, storefrontLandingSlugSchema } from "@scalius/shared/storefront-theme";

const PRIVATE = {
  "Cache-Control": "private, no-cache, no-store, must-revalidate",
  "Referrer-Policy": "no-referrer",
  "X-Robots-Tag": "noindex, nofollow, noarchive",
};
for (const [name, value] of Object.entries(PRIVATE)) Astro.response.headers.set(name, value);

const refuse = (status: number, extra: Record<string, string> = {}) =>
  new Response(null, { status, headers: { ...PRIVATE, ...extra } });

if (Astro.request.method !== "GET") return refuse(405, { Allow: "GET" });
const token = readThemePreviewCookie(Astro.request.headers.get("cookie"));
if (!token) return refuse(401);
const sectionId = Astro.url.searchParams.get("id") ?? "";
const pageSlug = Astro.url.searchParams.get("page") ?? undefined;
if (pageSlug && !storefrontLandingSlugSchema.safeParse(pageSlug).success) return refuse(400);
if (!/^[a-z0-9][a-z0-9_-]{0,39}$/.test(sectionId)) return refuse(400);

const layoutData = await getLayoutData();
if (!layoutData) return refuse(503);
const requestTheme = await resolveRequestTheme(Astro, layoutData);
if (!requestTheme.preview) return refuse(401, { "Set-Cookie": clearThemePreviewCookieHeader() });

const homeSections = pageSlug ? requestTheme.resolved.pages.landing[pageSlug]?.sections ?? [] : requestTheme.resolved.pages.home;
// A section the draft no longer has: the bridge loads the page again.
if (!homeSections.some((section) => section.id === sectionId)) return refuse(404);

const sectionData = (await getThemePreviewHomepageSections(token, pageSlug)) ?? EMPTY_HOMEPAGE_SECTION_DATA;
const currencySymbol = layoutData.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData.currency?.code ?? DEFAULT_CURRENCY.code;
const showsDeliveryFacts = homeSectionsShowDeliveryFacts(homeSections);
const [shippingMethods, checkoutConfig] = showsDeliveryFacts
  ? await Promise.all([getShippingMethods(), getCheckoutConfig()])
  : [null, null];
const deliveryFacts = showsDeliveryFacts
  ? buildDeliveryFacts({
      shippingMethods,
      checkoutConfig,
      returnPolicy: layoutData.seo?.returnPolicy,
      formatMoney: (amount) => formatMoney(amount, { code: currencyCode, symbol: currencySymbol }),
      countries: presenceMarketCountries(layoutData.markets, getRuntimePresence()),
    })
  : [];
const content = homepageContent(sectionData, deliveryFacts);
const leadSection = homepageLeadSection(homeSections, content);
---

<HomepageSections
  sections={homeSections}
  content={content}
  leadSectionId={leadSection?.id ?? null}
  currencySymbol={currencySymbol}
  currencyCode={currencyCode}
  only={sectionId}
  languageCode={layoutData.storefrontCopy?.languageCode}
/>
