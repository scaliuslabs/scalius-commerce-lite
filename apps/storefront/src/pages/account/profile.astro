---
// Account → Profile, after Shopify's customer accounts: the name, email and
// phone in one section with an inline edit dialog for the name, and the
// address book (MARKETS-DESIGN D7): each saved address as a card, the
// default first and marked Default, with Edit, Remove and Make default.
// Every edit is a plain POST handled here (Post/Redirect/Get), so it works
// without JavaScript; with it, the thana and area lists follow the city and
// another country's fields follow its rules. Only an outcome flag enters a URL.
import AppBlocks from "@/components/apps/AppBlocks.astro";
import { getAppBlocks } from "@/lib/api/app-blocks";
import { layoutHasAppBlocks } from "@/lib/app-surfaces";
import Layout from "@/layouts/Layout.astro";
import AccountShell from "@/components/account/AccountShell.astro";
import AccountDialog from "@/components/account/AccountDialog.astro";
import AccountAddressForm from "@/components/account/AccountAddressForm.astro";
import { getLayoutData } from "@/lib/api";
import { getAreas, getCities, getZones } from "@/lib/api/shipping";
import type { LocationData } from "@/lib/api/types";
import {
  changeAccountAddresses,
  readAccountAddresses,
  readAccountCustomer,
  readAccountMarketing,
  readAccountSummaryForRequest,
  saveAccountMarketing,
  saveAccountProfile,
  type AddressBookResult,
  type ProfileSaveResult,
} from "@/lib/account-server";
import {
  ACCOUNT_MARKETING_ANCHOR,
  ACCOUNT_MARKETING_INTENT,
  accountMarketingLocation,
  accountMarketingOn,
  readAccountMarketingFlag,
  readAccountMarketingForm,
} from "@/lib/account-marketing";
import { newsletterCopy, newsletterLanguage } from "@/lib/newsletter-copy";
import {
  addressBookInput,
  addressDraftOf,
  addressErrors,
  emptyAddressDraft,
  nameError,
  profileSavedText,
  readProfileForm,
  readProfileSavedFlag,
  type AddressDraft,
  type AddressDraftField,
  type ProfileForm,
} from "@/lib/account-profile";
import { ACCOUNT_OFFLINE_MESSAGE, formatAddressLines } from "@/lib/account-format";
import { defaultShippingCountry, isLocationCountry, storeShippingCountries } from "@/lib/checkout/shipping-country";
import { accountPill, accountUi as ui } from "@/lib/account-ui";
import { PRIVATE_NO_STORE_CACHE_CONTROL } from "@/lib/cache-policy";
import { formatBdMobile } from "@scalius/shared/phone-input";
import { shouldRejectCrossOriginCookieRequest } from "@scalius/shared/request-origin-guard";

export const prerender = false;

const MAX_FORM_BYTES = 16 * 1024;
const noStore = { "Cache-Control": PRIVATE_NO_STORE_CACHE_CONTROL };
Astro.response.headers.set("Cache-Control", PRIVATE_NO_STORE_CACHE_CONTROL);

let posted: ProfileForm | null = null;
let fieldErrors: Partial<Record<AddressDraftField | "name", string>> = {};
let formMessage: string | null = null;
let marketingFailure: "invalid" | "unavailable" | null = null;

// A Bangladesh form lists the cities, its city's thanas and its thana's areas (another country lists none).
const locationsFor = async (draft: Pick<AddressDraft, "countryCode" | "city" | "zone">) => {
  if (!isLocationCountry(draft.countryCode)) return { cities: [] as LocationData[], zones: [] as LocationData[], areas: [] as LocationData[] };
  const [cities, zones, areas] = await Promise.all([
    getCities(),
    draft.city ? getZones(draft.city) : Promise.resolve([] as LocationData[]),
    draft.zone ? getAreas(draft.zone) : Promise.resolve([] as LocationData[]),
  ]);
  return { cities, zones, areas };
};

if (Astro.request.method === "POST") {
  if (shouldRejectCrossOriginCookieRequest(Astro.request)) return new Response(null, { status: 403, headers: noStore });
  const declared = Number(Astro.request.headers.get("content-length") ?? "0");
  const form = declared > MAX_FORM_BYTES ? null : await Astro.request.formData().catch(() => null);
  // News and offers: only the channels the buyer changed go to the API.
  if (form?.get("intent") === ACCOUNT_MARKETING_INTENT) {
    const update = readAccountMarketingForm(form);
    if (Object.keys(update).length === 0) {
      return new Response(null, { status: 303, headers: { Location: accountMarketingLocation("saved"), ...noStore } });
    }
    const saved = await saveAccountMarketing(Astro.request, { ...update, language: newsletterLanguage(form.get("language")) });
    if (saved.ok) {
      const location = accountMarketingLocation(saved.confirmationRequested ? "confirm" : "saved");
      return new Response(null, { status: 303, headers: { Location: location, ...noStore } });
    }
    if (saved.reason === "signed_out") return new Response(null, { status: 303, headers: { Location: "/account/profile", ...noStore } });
    // Answered at the News and offers section below.
    marketingFailure = saved.reason;
  }
  posted = form && !marketingFailure ? readProfileForm(form) : null;
  let saved: ProfileSaveResult | AddressBookResult | null = null;
  if (marketingFailure) {
    // Nothing else was posted.
  } else if (posted?.intent === "name") {
    const error = nameError(posted.name);
    if (error) fieldErrors = { name: error };
    else saved = await saveAccountProfile(Astro.request, { name: posted.name });
  } else if (posted?.intent === "address") {
    const locations = await locationsFor(posted.draft);
    if (!locations.cities || !locations.zones || !locations.areas) {
      formMessage = ACCOUNT_OFFLINE_MESSAGE;
    } else {
      fieldErrors = addressErrors(posted.draft, { cities: locations.cities, zones: locations.zones, areas: locations.areas });
      if (Object.keys(fieldErrors).length === 0) {
        saved = await changeAccountAddresses(Astro.request, {
          action: "save",
          addressId: posted.draft.addressId || undefined,
          body: addressBookInput(posted.draft),
        });
      }
    }
  } else if ((posted?.intent === "remove-address" || posted?.intent === "default-address" || posted?.intent === "default-billing-address") && posted.draft.addressId) {
    saved = await changeAccountAddresses(Astro.request, {
      action: posted.intent === "remove-address" ? "delete" : posted.intent === "default-address" ? "default" : "default_billing",
      addressId: posted.draft.addressId,
    });
  } else {
    formMessage = "Something went wrong. Try again.";
  }
  if (saved?.ok) {
    const flag = posted!.intent === "remove-address" ? "removed"
      : posted!.intent === "default-address" ? "default"
        : posted!.intent === "default-billing-address" ? "billing" : posted!.intent!;
    return new Response(null, { status: 303, headers: { Location: `/account/profile?saved=${flag}`, ...noStore } });
  }
  if (saved && !saved.ok) {
    if (saved.reason === "signed_out") return new Response(null, { status: 303, headers: { Location: "/account/profile", ...noStore } });
    formMessage = saved.reason === "invalid" && saved.message ? saved.message : ACCOUNT_OFFLINE_MESSAGE;
  }
  Astro.response.status = marketingFailure
    ? (marketingFailure === "invalid" ? 422 : 503)
    : formMessage === ACCOUNT_OFFLINE_MESSAGE ? 503 : 422;
}

const [layoutData, read, summary, marketingRead, addressesRead] = await Promise.all([
  getLayoutData(),
  readAccountCustomer(Astro.request),
  readAccountSummaryForRequest(Astro.request),
  readAccountMarketing(Astro.request),
  readAccountAddresses(Astro.request),
]);
// Apps' account blocks: read only when the layout says an active app draws one.
const appBlocks = layoutHasAppBlocks(layoutData, "account") ? await getAppBlocks("account") : [];
// News and offers speaks the store's language (the rest of the account is English today).
const marketingLanguage = newsletterLanguage(layoutData?.storefrontCopy?.languageCode);
const marketingCopy = newsletterCopy(marketingLanguage).account;
const marketing = marketingRead.ok ? marketingRead.data : null;
const marketingFlag = posted || marketingFailure ? null : readAccountMarketingFlag(Astro.url.searchParams);
if (!read.ok && read.reason === "unavailable") Astro.response.status = 503;
const customer = read.ok ? read.data : null;
const savedFlag = posted ? null : readProfileSavedFlag(Astro.url.searchParams);
// The countries the store sells to: a country field only when there are several.
const countries = storeShippingCountries(layoutData?.markets);
const newAddressCountry = defaultShippingCountry(layoutData?.markets, null, countries);
const addresses = addressesRead.ok ? addressesRead.data : null;
const addressFailed = posted?.intent === "address";
const removeFailed = posted?.intent === "remove-address" || posted?.intent === "default-address" || posted?.intent === "default-billing-address";
// The form that failed (posted again with its errors); every other form starts from its saved address.
const failedAddressId = addressFailed ? posted!.draft.addressId : null;
const forms = customer && addresses
  ? await Promise.all([
      ...addresses.map(async (address) => {
        const draft = failedAddressId === address.id ? posted!.draft : addressDraftOf(address);
        return { key: address.id, address, draft, failed: failedAddressId === address.id, locations: await locationsFor(draft) };
      }),
      (async () => {
        const draft = addressFailed && !failedAddressId ? posted!.draft : emptyAddressDraft(newAddressCountry);
        return { key: "new", address: null, draft, failed: addressFailed && !failedAddressId, locations: await locationsFor(draft) };
      })(),
    ])
  : [];
const addForm = forms.find((form) => form.key === "new") ?? null;
const nameFailed = posted?.intent === "name";
const nameValue = nameFailed ? posted!.name : customer?.name ?? "";
const errorId = (key: string) => (fieldErrors[key as keyof typeof fieldErrors] ? `${key}Error` : undefined);
const offline = (locations: { cities: LocationData[] | null; zones: LocationData[] | null; areas: LocationData[] | null }) => ({
  cities: locations.cities ?? [],
  zones: locations.zones ?? [],
  areas: locations.areas ?? [],
});
const row = "flex items-start justify-between gap-4 py-4 first:pt-0 last:pb-0";
---

<Layout title="Profile" layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <AccountShell
    current="profile"
    summary={summary}
    state={read.ok ? "ok" : read.reason}
    title="Profile"
    signedOut={{ title: "Sign in to see your profile", body: "Save your delivery details for faster checkout." }}
    unavailable={{ text: ACCOUNT_OFFLINE_MESSAGE, retryHref: "/account/profile" }}
  >
    {customer && (
      <div class="grid gap-6">
        {savedFlag && <p role="status" class={ui.notice}>{profileSavedText(savedFlag)}</p>}

        <section class={ui.card} aria-labelledby="profileDetailsHeading">
          <h2 id="profileDetailsHeading" class={`${ui.cardTitle} flex min-h-12 items-center border-b border-border px-4 sm:px-5`}>Your details</h2>
          <div class={`${ui.cardBody} divide-y divide-border`}>
            <div class={row}>
              <div class="min-w-0">
                <p class={ui.muted}>Name</p>
                <p class="mt-0.5 break-words font-medium text-foreground">{customer.name}</p>
              </div>
              {!nameFailed && <button type="button" popovertarget="editName" class={ui.textButton}>Edit</button>}
            </div>
            {nameFailed && (
              <AccountDialog id="editName" title="Edit name" inline>
                  <form method="post" action="/account/profile" class="space-y-4" novalidate>
                    <input type="hidden" name="intent" value="name" />
                    <div>
                      <label for="fieldName" class={ui.label}>Full name</label>
                      <input id="fieldName" name="name" type="text" autocomplete="name" required maxlength="120" value={nameValue} aria-invalid={fieldErrors.name ? "true" : undefined} aria-describedby={errorId("name")} class={ui.field} autofocus />
                      {fieldErrors.name && <p id="nameError" class={ui.fieldError}>{fieldErrors.name}</p>}
                    </div>
                    {formMessage && <p role="alert" class="text-sm text-destructive">{formMessage}</p>}
                    <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                      <a href="/account/profile" data-astro-prefetch="false" class={ui.secondaryButton}>Cancel</a>
                      <button type="submit" class={ui.primaryButton}>Save</button>
                    </div>
                  </form>
              </AccountDialog>
            )}
            <div class={row}>
              <div class="min-w-0">
                <p class={ui.muted}>Email</p>
                <p class="mt-0.5 break-all text-foreground">{customer.email || "Not added"}</p>
              </div>
            </div>
            <div class={row}>
              <div class="min-w-0">
                <p class={ui.muted}>Phone</p>
                <p class="mt-0.5 text-foreground tabular-nums">{customer.phone ? formatBdMobile(customer.phone) : "Not added"}</p>
              </div>
            </div>
          </div>
        </section>

        <section class={ui.card} aria-labelledby="addressesHeading">
          <div class="flex min-h-12 items-center justify-between gap-3 border-b border-border px-4 sm:px-5">
            <h2 id="addressesHeading" class={ui.cardTitle}>Addresses</h2>
            {addresses && addresses.length > 0 && !addForm?.failed && (
              <button type="button" popovertarget="addAddress" class={ui.textButton}>Add address</button>
            )}
          </div>
          <div class={ui.cardBody}>
            {removeFailed && formMessage && <p role="alert" class={`${ui.errorNotice} mb-4`}>{formMessage}</p>}
            {!addresses ? (
              <p class={ui.muted}>{ACCOUNT_OFFLINE_MESSAGE}</p>
            ) : addresses.length === 0 && !addForm?.failed ? (
              <div class="py-4 text-center">
                <p class="font-medium text-foreground">No saved address</p>
                <p class="mt-1 text-sm text-muted-foreground">Add one and checkout fills it in for you.</p>
                <button type="button" popovertarget="addAddress" class={`${ui.secondaryButton} mt-4`}>Add address</button>
              </div>
            ) : (
              <div class="grid gap-3 sm:grid-cols-2">
                {addresses.map((address) => (
                  <article class="rounded-lg border border-border p-4" aria-label={address.isDefault ? "Default address" : "Address"}>
                    {(address.isDefault || address.isDefaultBilling) && (
                      <div class="flex flex-wrap gap-1.5">
                        {address.isDefault && <span class={accountPill("neutral")}>Default</span>}
                        {address.isDefaultBilling && <span class={accountPill("neutral")}>Default billing</span>}
                      </div>
                    )}
                    <div class:list={["space-y-0.5 break-words text-sm text-foreground", (address.isDefault || address.isDefaultBilling) && "mt-3"]}>
                      <p class="font-medium">{address.name ?? customer.name}</p>
                      {address.company && <p>{address.company}</p>}
                      {formatAddressLines(address).map((line) => <p>{line}</p>)}
                      {(address.phone ?? customer.phone) && <p class="tabular-nums text-muted-foreground">{formatBdMobile((address.phone ?? customer.phone)!)}</p>}
                    </div>
                    {failedAddressId !== address.id && (
                      <div class="mt-3 flex flex-wrap gap-x-4">
                        <button type="button" popovertarget={`editAddress-${address.id}`} class={ui.textButton}>Edit</button>
                        <button type="button" popovertarget={`removeAddress-${address.id}`} class="inline-flex min-h-11 items-center text-sm font-medium text-destructive hover:underline">Remove</button>
                        {!address.isDefault && (
                          <form method="post" action="/account/profile">
                            <input type="hidden" name="intent" value="default-address" />
                            <input type="hidden" name="addressId" value={address.id} />
                            <button type="submit" class={ui.textButton}>Make default</button>
                          </form>
                        )}
                        {!address.isDefaultBilling && (
                          <form method="post" action="/account/profile">
                            <input type="hidden" name="intent" value="default-billing-address" />
                            <input type="hidden" name="addressId" value={address.id} />
                            <button type="submit" class={ui.textButton}>Use for billing</button>
                          </form>
                        )}
                      </div>
                    )}
                  </article>
                ))}
              </div>
            )}

            {forms.map((form) => (
              <AccountAddressForm
                dialogId={form.address ? `editAddress-${form.address.id}` : "addAddress"}
                title={form.address ? "Edit address" : "Add address"}
                draft={form.draft}
                countries={countries}
                locations={offline(form.locations)}
                failed={form.failed}
                errors={form.failed ? fieldErrors : {}}
                message={form.failed ? formMessage : null}
                offerDefault={form.address ? !form.address.isDefault : (addresses?.length ?? 0) > 0}
              />
            ))}

            {addresses?.map((address) => (
              <AccountDialog id={`removeAddress-${address.id}`} title="Remove this address?">
                <p class="text-sm text-muted-foreground">
                  {address.isDefault && addresses.length > 1
                    ? "Your most recently changed other address becomes the default."
                    : "Checkout will ask for your delivery address again next time."}
                </p>
                <form method="post" action="/account/profile" class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                  <input type="hidden" name="intent" value="remove-address" />
                  <input type="hidden" name="addressId" value={address.id} />
                  <button type="button" popovertarget={`removeAddress-${address.id}`} popovertargetaction="hide" class={ui.secondaryButton}>Cancel</button>
                  <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-destructive px-5 text-sm font-medium text-destructive-foreground hover:bg-destructive/90">Remove address</button>
                </form>
              </AccountDialog>
            ))}
          </div>
        </section>

        <section id={ACCOUNT_MARKETING_ANCHOR} class={ui.card} aria-labelledby="marketingHeading" lang={marketingLanguage} data-account-marketing>
          <h2 id="marketingHeading" class={`${ui.cardTitle} flex min-h-12 items-center border-b border-border px-4 sm:px-5`}>{marketingCopy.heading}</h2>
          <div class={ui.cardBody}>
            {marketingFlag && (
              <p role="status" class={`${ui.notice} mb-4`}>{marketingFlag === "confirm" ? marketingCopy.confirmRequested : marketingCopy.saved}</p>
            )}
            {marketingFailure && <p role="alert" class={`${ui.errorNotice} mb-4`}>{marketingCopy.failed}</p>}
            <p class={ui.muted}>{marketingCopy.text}</p>
            {marketing ? (
              <form method="post" action="/account/profile" class="mt-4 space-y-4">
                <input type="hidden" name="intent" value={ACCOUNT_MARKETING_INTENT} />
                <input type="hidden" name="language" value={marketingLanguage} />
                <fieldset class="divide-y divide-border">
                  <legend class="sr-only">{marketingCopy.heading}</legend>
                  {marketing.map((entry) => {
                    const on = accountMarketingOn(entry);
                    const id = `marketing-${entry.channel}`;
                    const hintId = `${id}-hint`;
                    const hint = !entry.available
                      ? (entry.channel === "email" ? marketingCopy.needsEmail : marketingCopy.needsPhone)
                      : entry.status === "pending" ? marketingCopy.pending : null;
                    return (
                      <div class="py-3 first:pt-0 last:pb-0">
                        {entry.available && <input type="hidden" name={`was_${entry.channel}`} value={on ? "on" : "off"} />}
                        <label for={id} class:list={["flex min-h-11 items-center gap-3", entry.available ? "cursor-pointer" : "cursor-not-allowed opacity-60"]}>
                          <input
                            id={id}
                            type="checkbox"
                            name="channel"
                            value={entry.channel}
                            checked={on && entry.available}
                            disabled={!entry.available}
                            aria-describedby={hint ? hintId : undefined}
                            class="size-5 shrink-0 accent-primary"
                          />
                          <span class="font-medium text-foreground">{marketingCopy.channelLabel[entry.channel]}</span>
                        </label>
                        {hint && <p id={hintId} class={`${ui.muted} ps-8`}>{hint}</p>}
                      </div>
                    );
                  })}
                </fieldset>
                <button type="submit" class={ui.primaryButton}>{marketingCopy.save}</button>
              </form>
            ) : (
              <p class={`${ui.muted} mt-4`}>{ACCOUNT_OFFLINE_MESSAGE}</p>
            )}
          </div>
        </section>

        {!nameFailed && (
          <AccountDialog id="editName" title="Edit name">
            <form method="post" action="/account/profile" class="space-y-4" novalidate>
              <input type="hidden" name="intent" value="name" />
              <div>
                <label for="fieldName" class={ui.label}>Full name</label>
                <input id="fieldName" name="name" type="text" autocomplete="name" required maxlength="120" value={nameValue} class={ui.field} />
              </div>
              <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                <button type="button" popovertarget="editName" popovertargetaction="hide" class={ui.secondaryButton}>Cancel</button>
                <button type="submit" class={ui.primaryButton}>Save</button>
              </div>
            </form>
          </AccountDialog>
        )}
      </div>
    )}
    <AppBlocks blocks={appBlocks} target="customer-account.profile.block.render" class="mt-8" />
  </AccountShell>
</Layout>

<script>
  import { getAreas, getZones } from "@/lib/api/shipping";
  import { enhanceLocationSelects } from "@/lib/checkout/location-select";
  import { enhanceShippingCountry } from "@/lib/checkout/country-address";

  // The same search-or-scroll pickers as checkout; without JavaScript the
  // server answers "choose a thana" with the new city's list. Another
  // country's fields follow its rules.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-address-form]")) {
    const root = form.querySelector<HTMLElement>("[data-location-fields]");
    if (root) {
      enhanceLocationSelects(root, {
        load: (level, parentId) => (level === "zones" ? getZones(parentId) : getAreas(parentId)),
      });
    }
    enhanceShippingCountry(form);
  }
</script>
