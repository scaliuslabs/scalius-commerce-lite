---
// One conversation of the account Inbox: the store's replies on the left, the
// buyer's messages on the right, system lines centered, and a reply form.
// Server-rendered from the session cookie and marked read when shown, so it
// works without JavaScript; the reply form is a plain POST that JavaScript
// upgrades to an in-place send.
import Layout from "@/layouts/Layout.astro";
import ConversationReplyForm from "@/components/conversation/ConversationReplyForm.astro";
import AccountShell from "@/components/account/AccountShell.astro";
import { getLayoutData } from "@/lib/api";
import {
  CONVERSATION_COPY as copy,
  conversationStatusLabel,
  conversationTitle,
  isConversationId,
  readBeforeSeq,
  readConversationStatusFlag,
  renderConversationMessages,
} from "@/lib/account-inbox";
import {
  attachmentUrlFor,
  markConversationRead,
  readConversation,
  type ConversationTarget,
} from "@/lib/account-inbox-server";
import { readAccountSummaryForRequest } from "@/lib/account-server";
import { accountUi as ui } from "@/lib/account-ui";
import { PRIVATE_NO_STORE_CACHE_CONTROL } from "@/lib/cache-policy";

const conversationId = isConversationId(Astro.params.id) ? Astro.params.id : null;
const target: ConversationTarget | null = conversationId ? { kind: "thread", conversationId } : null;
const beforeSeq = readBeforeSeq(Astro.url.searchParams.get("before"));
const [layoutData, read, summary] = await Promise.all([
  getLayoutData(),
  target ? readConversation(Astro.request, target, beforeSeq) : Promise.resolve(null),
  readAccountSummaryForRequest(Astro.request),
]);
Astro.response.headers.set("Cache-Control", PRIVATE_NO_STORE_CACHE_CONTROL);
const thread = read?.ok ? read.data : null;
const failure = thread ? null : read && !read.ok ? read.reason : "no_access";
if (failure === "no_access") Astro.response.status = 404;
if (failure === "unavailable") Astro.response.status = 503;
// Viewing the latest page marks the thread read up to its last message.
if (target && thread && !beforeSeq) await markConversationRead(Astro.request, target, thread);

const threadHref = conversationId ? `/account/inbox/${encodeURIComponent(conversationId)}` : "/account/inbox";
const earliestSeq = thread?.messages.reduce((min, message) => Math.min(min, message.seq), Number.MAX_SAFE_INTEGER) ?? 0;
const earlierHref = thread?.hasMore && earliestSeq > 1
  ? `${threadHref}?${new URLSearchParams({ before: String(earliestSeq) })}`
  : null;
const messagesHtml = target && thread
  ? renderConversationMessages(thread.messages, { attachmentUrl: attachmentUrlFor(target, thread), readSeq: thread.readSeq })
  : "";
const orderHref = thread?.orderId ? `/account/orders/${encodeURIComponent(thread.orderId)}` : null;
const shellState = failure === "signed_out" ? "signed_out" : failure === "unavailable" ? "unavailable" : "ok";
const title = thread ? conversationTitle(thread) : copy.notFound;
---

<Layout title={copy.inboxTitle} layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <AccountShell
    current="inbox"
    summary={summary}
    state={shellState}
    title={title}
    back={{ href: "/account/inbox", label: copy.backToInbox }}
    signedOut={{ title: copy.signInTitle, body: copy.signInBody, action: copy.signIn }}
    unavailable={{ text: copy.unavailable, retryHref: threadHref, retryText: copy.retry }}
  >
    {failure === "no_access" && (
      <div class={ui.empty} role="alert">
        <p class={ui.emptyBody}>This conversation isn't in your inbox.</p>
        <a href="/account/inbox" data-astro-prefetch="false" class={`${ui.primaryButton} mt-6`}>{copy.backToInbox}</a>
      </div>
    )}

    {thread && conversationId && (
      <div id="conversation">
        <div class="-mt-4 mb-6">
          <p class="text-sm text-muted-foreground">
            {conversationStatusLabel(thread.status)}
            {orderHref && <> · <a href={orderHref} data-astro-prefetch="false" class="font-medium text-primary hover:underline">{copy.viewOrder}</a></>}
          </p>
        </div>

        <div class={`${ui.card} ${ui.cardBody}`}>
          {earlierHref && (
            <div class="mb-4 text-center">
              <a href={earlierHref} data-astro-prefetch="false" class="inline-flex min-h-11 items-center text-sm font-medium text-primary hover:underline">{copy.earlierMessages}</a>
            </div>
          )}
          <ol id="conversationMessages" class="space-y-4" aria-label="Messages" hidden={thread.messages.length === 0} set:html={messagesHtml} />
          {beforeSeq ? (
            <div class="mt-4 text-center">
              <a href={threadHref} data-astro-prefetch="false" class="inline-flex min-h-11 items-center text-sm font-medium text-primary hover:underline">{copy.latestMessages}</a>
            </div>
          ) : (
            <ConversationReplyForm
              action={`/api/conversations/${encodeURIComponent(conversationId)}/messages`}
              returnTo={threadHref}
              messagesTargetId="conversationMessages"
              idPrefix="conversationReply"
              status={readConversationStatusFlag(Astro.url)}
              label="Reply"
              placeholder="Write a reply"
              note={thread.status === "closed" ? copy.closedNote : null}
            />
          )}
        </div>
      </div>
    )}
  </AccountShell>
</Layout>
