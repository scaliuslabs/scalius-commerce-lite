---
// Account Inbox: the buyer's conversations with the store (store threads and
// the threads of orders the account owns), newest first, with unread dots, and
// "Message the store" for verified accounts. Server-rendered from the session
// cookie, so it works without JavaScript; the form is a plain POST.
import Layout from "@/layouts/Layout.astro";
import AccountShell from "@/components/account/AccountShell.astro";
import { getLayoutData } from "@/lib/api";
import {
  CONVERSATION_COPY as copy,
  CONVERSATION_LIMITS,
  conversationStatusMessage,
  newClientMessageKey,
  readConversationStatusFlag,
  readInboxCursor,
  renderInboxItems,
} from "@/lib/account-inbox";
import { readInbox } from "@/lib/account-inbox-server";
import { readAccountSummaryForRequest } from "@/lib/account-server";
import { accountUi as ui } from "@/lib/account-ui";
import { PRIVATE_NO_STORE_CACHE_CONTROL } from "@/lib/cache-policy";

const cursor = readInboxCursor(Astro.url.searchParams.get("cursor"));
const [layoutData, inbox, summary] = await Promise.all([
  getLayoutData(),
  readInbox(Astro.request, cursor),
  readAccountSummaryForRequest(Astro.request),
]);
const flag = readConversationStatusFlag(Astro.url);
const status = flag ? conversationStatusMessage(flag) : null;
const startFailed = Boolean(flag && status?.tone === "error");
const clientMessageKey = newClientMessageKey();
Astro.response.headers.set("Cache-Control", PRIVATE_NO_STORE_CACHE_CONTROL);
if (!inbox.ok && inbox.reason === "unavailable") Astro.response.status = 503;

const items = inbox.ok ? inbox.data.items : [];
const olderHref = inbox.ok && inbox.data.nextCursor
  ? `/account/inbox?${new URLSearchParams({ cursor: inbox.data.nextCursor })}`
  : null;
const shellState = inbox.ok ? "ok" : inbox.reason === "signed_out" ? "signed_out" : "unavailable";
---

<Layout title={copy.inboxTitle} layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <AccountShell
    current="inbox"
    summary={summary}
    state={shellState}
    title={copy.inboxTitle}
    signedOut={{ title: copy.signInTitle, body: copy.signInBody, action: copy.signIn }}
    unavailable={{ text: copy.unavailable, retryHref: "/account/inbox", retryText: copy.retry }}
  >
    {inbox.ok && (
      <div class="space-y-6">

        {status && (
          <p role="status" class:list={["text-sm", status.tone === "error" ? "text-destructive" : "text-primary"]}>{status.text}</p>
        )}

        <details class={`group ${ui.card}`} open={startFailed || (items.length === 0 && !cursor && inbox.data.canStartStoreConversation)}>
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-5 py-3 text-base font-semibold text-foreground">
            {copy.startTitle}
            <svg aria-hidden="true" class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <div class="border-t border-border px-5 pb-5 pt-4">
            {inbox.data.canStartStoreConversation ? (
              <form method="post" action="/api/conversations/store" class="space-y-4">
                <p class="text-sm text-muted-foreground">{copy.startIntro}</p>
                <input type="hidden" name="clientMessageKey" value={clientMessageKey} />
                <div>
                  <label for="storeThreadSubject" class={ui.label}>{copy.subjectLabel}</label>
                  <input id="storeThreadSubject" name="subject" type="text" required maxlength={CONVERSATION_LIMITS.subjectLength} autocomplete="off" class={ui.field} />
                </div>
                <div>
                  <label for="storeThreadBody" class={ui.label}>{copy.messageLabel}</label>
                  <textarea id="storeThreadBody" name="body" required rows="4" maxlength={CONVERSATION_LIMITS.bodyLength} class={`${ui.field} min-h-28`}></textarea>
                </div>
                <div class="flex justify-end">
                  <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">{copy.startSubmit}</button>
                </div>
              </form>
            ) : (
              <p class="text-sm text-muted-foreground">
                {copy.startNeedsVerification}{" "}
                <a href="/account" data-astro-prefetch="false" class="font-medium text-primary hover:underline">{copy.startNeedsVerificationLink}</a>
              </p>
            )}
          </div>
        </details>

        {items.length > 0 ? (
          <ul class="space-y-3" aria-label="Conversations" set:html={renderInboxItems(items)} />
        ) : (
          <div class={ui.empty}>
            <h2 class={ui.emptyTitle}>No messages yet</h2>
            <p class={ui.emptyBody}>{copy.inboxEmpty}</p>
            <a href="/account" data-astro-prefetch="false" class={`${ui.secondaryButton} mt-6`}>Go to your orders</a>
          </div>
        )}

        {olderHref && (
          <div class="text-center">
            <a href={olderHref} data-astro-prefetch="false" class="inline-flex min-h-11 items-center rounded-lg border border-border px-6 text-sm font-medium text-foreground hover:bg-muted">{copy.olderConversations}</a>
          </div>
        )}
      </div>
    )}
  </AccountShell>
</Layout>
