---
// "Show message": a POST-only page that reveals one line's delivery message
// (fields: messageId, returnTo) to the signed-in account that owns its order
// (rules/orders/buyer-line-delivery-message.md). Like the licence key page:
// the text exists only in this no-store response, never in a URL, a log, a
// cache or analytics, so the page renders without the storefront Layout and
// no merchant analytics or third-party script runs beside it. The text is
// drawn as text (Astro escapes it), never HTML; the link is a plain external
// link that sends no referrer and gets no handle on this page. A GET goes to
// the account.
import "@/styles/global.css";
import { shouldRejectCrossOriginCookieRequest } from "@scalius/shared/request-origin-guard";
import { downloadCopy, downloadStatusText, isDigitalId, safeDownloadReturnPath } from "@/lib/account-downloads";
import { getLayoutData } from "@/lib/api";
import { pageLanguage } from "@/lib/store-time-zone";
import {
  PRIVATE_HEADERS,
  privateRedirect,
  readSmallForm,
  revealDeliveryMessage,
  type DeliveryMessageResult,
} from "@/lib/account-downloads-server";

export const prerender = false;

if (Astro.request.method !== "POST") return privateRedirect("/account");
if (shouldRejectCrossOriginCookieRequest(Astro.request)) {
  return new Response("Forbidden", { status: 403, headers: { "Content-Type": "text/plain; charset=utf-8", ...PRIVATE_HEADERS } });
}

// The store's language for the page's words (the layout read only; no layout scripts run here).
const [form] = await Promise.all([readSmallForm(Astro.request), getLayoutData().catch(() => null)]);
const copy = downloadCopy();
const returnTo = safeDownloadReturnPath(form?.get("returnTo")) ?? "/account";
const messageId = form?.get("messageId");
const result: DeliveryMessageResult = isDigitalId(messageId)
  ? await revealDeliveryMessage(Astro.request, messageId)
  : { ok: false, flag: "missing" };

for (const [name, value] of Object.entries(PRIVATE_HEADERS)) Astro.response.headers.set(name, value);
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
if (!result.ok) {
  Astro.response.status = result.flag === "rate" ? 429 : result.flag === "unavailable" ? 503 : result.flag === "signin" ? 401 : 404;
}
const errorText = result.ok
  ? ""
  : result.flag === "rate" || result.flag === "signin"
    ? downloadStatusText(result.flag, result.retryAfterSeconds)
    : copy.messageUnavailable;
---

<!doctype html>
<html lang={pageLanguage()}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>{copy.messagePageTitle}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <main class="mx-auto flex min-h-screen w-full max-w-lg items-center px-4 py-10">
      <section class="w-full rounded-xl border border-border bg-card p-5 sm:p-7" aria-labelledby="deliveryMessageTitle">
        <h1 id="deliveryMessageTitle" class="text-2xl font-semibold tracking-tight">{copy.messagePageTitle}</h1>
        {result.ok ? (
          <>
            <p class="mt-2 text-sm text-muted-foreground">{copy.messagePageIntro}</p>
            <output
              id="deliveryMessageText"
              aria-labelledby="deliveryMessageTitle"
              class="mt-5 block select-all whitespace-pre-wrap break-words rounded-lg border border-border bg-muted/40 px-3 py-3 font-mono text-sm"
            >{result.text}</output>
            {result.link && (
              <p class="mt-4 text-sm">
                <a
                  href={result.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  referrerpolicy="no-referrer"
                  data-astro-prefetch="false"
                  data-delivery-message-link
                  class="font-medium text-primary underline break-all"
                >{copy.messageLink}</a>
                <span class="block break-all text-muted-foreground">{result.link}</span>
                <span class="block text-muted-foreground">{copy.messageLinkNote}</span>
              </p>
            )}
            <div class="mt-5 flex flex-wrap gap-3">
              <button
                type="button"
                hidden
                data-copy-delivery-message
                data-copied-text={copy.copiedKey}
                class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary-hover"
              >{copy.copyMessage}</button>
              <a href={returnTo} data-astro-prefetch="false" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-5 text-sm font-medium hover:bg-muted">{copy.back}</a>
            </div>
          </>
        ) : (
          <>
            <p class="mt-3 text-sm text-foreground" role="alert">{errorText}</p>
            <div class="mt-5">
              <a href={returnTo} data-astro-prefetch="false" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary-hover">{copy.back}</a>
            </div>
          </>
        )}
      </section>
    </main>
  </body>
</html>

<script>
  // Copy is an enhancement: without JavaScript the message is selectable text.
  const button = document.querySelector<HTMLButtonElement>("[data-copy-delivery-message]");
  const value = document.getElementById("deliveryMessageText");
  if (button && value && navigator.clipboard) {
    const label = button.textContent ?? "";
    button.hidden = false;
    button.addEventListener("click", () => {
      void navigator.clipboard.writeText(value.textContent ?? "").then(() => {
        button.textContent = button.dataset.copiedText ?? label;
        window.setTimeout(() => { button.textContent = label; }, 2000);
      }).catch(() => undefined);
    });
  }
</script>
