---
// Account › Warranties (Wave B §5.3): every warranty on items the account
// received, active first, with the time left, the dates, the terms, the
// latest claim (its thread is in the Inbox) and, while one can be made,
// "Make a claim" with the claim form in place. Server-rendered from the
// session cookie, so it works without JavaScript; `?claim=<warranty id>` opens
// that warranty's form (the order page links here), and a refused plain post
// comes back with the outcome flag. Ids and a flag only in the URL.
import Layout from "@/layouts/Layout.astro";
import AccountShell from "@/components/account/AccountShell.astro";
import WarrantyClaimForm from "@/components/warranty/WarrantyClaimForm.astro";
import { getActiveCheckoutLanguage, getLayoutData } from "@/lib/api";
import { getCheckoutLanguagePreset } from "@scalius/shared/checkout-language";
import {
  canClaimWarranty,
  pickWarrantyCopy,
  readWarrantyClaimNotice,
  warrantyClaimStatusText,
  warrantyClaimThreadHref,
  warrantyDatesText,
  warrantySummaryText,
  warrantyTimeLeftText,
  type BuyerWarranty,
} from "@/lib/account-warranties";
import { readAccountWarranties } from "@/lib/account-warranties-server";
import { readAccountSummaryForRequest } from "@/lib/account-server";
import { accountPill, accountUi as ui } from "@/lib/account-ui";
import { PRIVATE_NO_STORE_CACHE_CONTROL } from "@/lib/cache-policy";
import { formatCheckoutLanguageText } from "@scalius/shared/checkout-language-format";

export const prerender = false;

const [layoutData, language, warranties, summary] = await Promise.all([
  getLayoutData(),
  getActiveCheckoutLanguage().catch(() => null),
  readAccountWarranties(Astro.request),
  readAccountSummaryForRequest(Astro.request),
]);
Astro.response.headers.set("Cache-Control", PRIVATE_NO_STORE_CACHE_CONTROL);
if (!warranties.ok && warranties.reason !== "signed_out") Astro.response.status = 503;
const copy = pickWarrantyCopy(language?.languageData, getCheckoutLanguagePreset(language?.code));
const shellState = warranties.ok ? "ok" : warranties.reason === "signed_out" ? "signed_out" : "unavailable";
const list = warranties.ok ? warranties.data : [];
const active = list.filter((warranty) => warranty.state === "active");
const ended = list.filter((warranty) => warranty.state !== "active");
const notice = readWarrantyClaimNotice(Astro.url);
const now = Date.now();
const sections: Array<{ id: string; title: string; items: BuyerWarranty[] }> = [
  { id: "warrantiesActive", title: copy.warrantiesActiveTitleText, items: active },
  { id: "warrantiesEnded", title: copy.warrantiesExpiredTitleText, items: ended },
].filter((section) => section.items.length > 0);
---

<Layout title={copy.warrantiesTitleText} layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <AccountShell
    current="warranties"
    summary={summary}
    state={shellState}
    title={copy.warrantiesTitleText}
    intro={copy.warrantiesIntroText}
    signedOut={{ title: copy.warrantiesSignInTitleText, body: copy.warrantiesIntroText, action: copy.warrantiesSignInText }}
    unavailable={{ text: copy.warrantiesUnavailableText, retryHref: "/account/warranties", retryText: copy.warrantiesRetryText }}
  >
    {warranties.ok && (
      list.length === 0 ? (
        <div class={ui.empty}>
          <p class={ui.emptyBody}>{copy.warrantiesNoneText}</p>
          <a href="/account" data-astro-prefetch="false" class={`${ui.secondaryButton} mt-6`}>Go to your orders</a>
        </div>
      ) : (
        <div class="space-y-8">
          {sections.map((section) => (
            <section aria-labelledby={section.id}>
              <h2 id={section.id} class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted-foreground">{section.title}</h2>
              <ul class="space-y-4">
                {section.items.map((warranty) => {
                  const record = { ...warranty, voided: warranty.state === "voided" };
                  const left = warranty.state === "active" ? warrantyTimeLeftText(warranty.expiresAt, now, copy) : "";
                  const headingId = `warranty-${warranty.warrantyId}-title`;
                  const orderHref = `/account/orders/${encodeURIComponent(warranty.orderId)}`;
                  const isNoticed = notice?.warrantyId === warranty.warrantyId;
                  return (
                    <li id={`warranty-${warranty.warrantyId}`} class={`${ui.card} ${ui.cardBody} scroll-mt-24`}>
                      <article aria-labelledby={headingId}>
                        <div class="flex items-start gap-3">
                          {warranty.imageUrl && (
                            <img src={warranty.imageUrl} alt="" width="56" height="56" loading="lazy" decoding="async" class="size-14 shrink-0 rounded-lg border border-border object-cover" />
                          )}
                          <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1">
                              <h3 id={headingId} class="min-w-0 text-base font-semibold text-foreground">
                                {warranty.productName ?? warranty.policyName}
                                {warranty.variantLabel && <span class="font-normal text-muted-foreground"> · {warranty.variantLabel}</span>}
                              </h3>
                              {left
                                ? <span class={accountPill("success")}>{left}</span>
                                : <span class={accountPill(warranty.state === "voided" ? "danger" : "neutral")}>{warranty.state === "voided" ? copy.warrantyVoidText : copy.warrantiesExpiredTitleText}</span>}
                            </div>
                            <p class="mt-1 text-sm text-foreground">{warrantySummaryText(warranty, copy)}</p>
                            <p class="text-sm text-muted-foreground">
                              {warrantyDatesText(record, now, copy)} · <a href={orderHref} data-astro-prefetch="false" class="hover:underline">{formatCheckoutLanguageText(copy.warrantyOrderText, { order: warranty.orderNumber })}</a>
                            </p>
                          </div>
                        </div>

                        {warranty.claim && (
                          <p class="mt-3 flex flex-wrap items-center gap-x-3 text-sm">
                            <span class="text-muted-foreground">{warrantyClaimStatusText(warranty.claim.status, copy)}</span>
                            <a href={warrantyClaimThreadHref(warranty.claim, { kind: "account" })} data-astro-prefetch="false" class={ui.textButton}>{copy.warrantyViewClaimText}</a>
                          </p>
                        )}

                        <WarrantyClaimForm
                          canClaim={canClaimWarranty(record, now)}
                          warrantyId={warranty.warrantyId}
                          access={{ kind: "account" }}
                          copy={copy}
                          returnTo="/account/warranties"
                          open={isNoticed}
                          flag={isNoticed ? notice.flag : null}
                          class="mt-2"
                        />

                        {warranty.terms && (
                          <details class="group mt-2 border-t border-border pt-1">
                            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between text-sm font-medium text-foreground [&::-webkit-details-marker]:hidden">
                              {copy.warrantyTermsText}
                              <svg aria-hidden="true" class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                            </summary>
                            <p class="pb-2 text-sm font-medium text-foreground">{warranty.policyName}</p>
                            <p class="whitespace-pre-line pb-2 text-sm leading-relaxed text-muted-foreground">{warranty.terms}</p>
                          </details>
                        )}
                      </article>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      )
    )}
  </AccountShell>
</Layout>
