        const subtotal = totalAmount - shipping + discount;
        summary.innerHTML = `
          <dl class="space-y-2">
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Subtotal</dt><dd class="font-medium text-foreground">${escapeHtml(formatMoney(subtotal))}</dd></div>
