          <dl class="space-y-2">
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Subtotal</dt><dd class="font-medium text-foreground">${savedAmount(savedMoneySummary.subtotalMinor)}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Shipping</dt><dd class="font-medium text-foreground">${savedAmount(savedMoneySummary.shippingMinor)}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Discount</dt><dd class="font-medium text-primary">${savedMoneySummary.discountMinor > 0 ? "−" : ""}${savedAmount(savedMoneySummary.discountMinor)}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">${escapeHtml(savedMoneySummary.taxLabel)}${savedMoneySummary.pricesIncludeTax ? " (included)" : ""}</dt><dd class="font-medium text-foreground">${savedAmount(savedMoneySummary.taxMinor)}</dd></div>
            <div class="flex justify-between gap-4 border-t border-border pt-2"><dt class="font-semibold text-foreground">Total</dt><dd class="font-semibold text-foreground">${savedAmount(savedMoneySummary.totalMinor)}</dd></div>
          </dl>
          <p class="mt-3 text-xs text-muted-foreground">Amounts saved in ${escapeHtml(savedMoneySummary.currencyCode)} when this order was placed.${savedMoneySummary.pricesIncludeTax ? ` ${escapeHtml(savedMoneySummary.taxLabel)} is already included in the prices above.` : ""}</p>
        `;
      } else {
        const discount = Number.isFinite(order.discountAmount) ? order.discountAmount ?? 0 : 0;
        const shipping = Number.isFinite(order.shippingCharge) ? order.shippingCharge : 0;
