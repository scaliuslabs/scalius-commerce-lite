---
import Layout from "@/layouts/Layout.astro";
import StoreContact from "@/components/StoreContact.astro";
import { getLayoutData } from "@/lib/api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";

const layoutData = await getLayoutData();
const orderId = Astro.params.id ?? "";
const accountPrefetch = getStorefrontPrefetchAttribute("/account", Astro.url);
const card = "rounded-xl border border-border bg-card p-5";
const heading = "mb-4 text-base font-semibold text-foreground";
---

<Layout title="Order" layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <section class="container mx-auto max-w-5xl px-4 py-8" data-order-detail-page data-order-id={orderId}>
    <div id="orderLoading" class="flex min-h-[360px] items-center justify-center">
      <p class="text-sm text-muted-foreground">Loading your order…</p>
    </div>

    <div id="orderUnauthenticated" class="hidden">
      <div class="mx-auto max-w-md py-16 text-center">
        <h1 class="mb-6 text-2xl font-semibold text-foreground">Sign in to see this order</h1>
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          <button type="button" onclick="window.dispatchEvent(new CustomEvent('open-auth-modal'))" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/90">Sign in</button>
          <a href={`/track-order?${new URLSearchParams({ order: orderId })}`} data-astro-prefetch="false" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-5 text-sm font-medium text-foreground hover:bg-muted">Track this order instead</a>
        </div>
      </div>
    </div>

    <div id="orderError" class="hidden">
      <div class="mx-auto max-w-md py-16 text-center" role="alert">
        <h1 id="orderErrorTitle" class="mb-2 text-2xl font-semibold text-foreground"></h1>
        <p id="orderErrorMessage" class="mb-6 text-muted-foreground"></p>
        <div class="flex flex-col justify-center gap-3 sm:flex-row">
          <button type="button" id="orderRetry" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/90">Retry</button>
          <a href="/account" data-astro-prefetch={accountPrefetch} class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-5 text-sm font-medium text-foreground hover:bg-muted">Back to your orders</a>
        </div>
      </div>
    </div>

    <div id="orderContent" class="hidden space-y-6">
      <div>
        <a href="/account" data-astro-prefetch={accountPrefetch} class="mb-3 inline-flex min-h-11 items-center gap-1 text-sm font-medium text-muted-foreground hover:text-foreground">
          <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
          Account
        </a>
        <div class="flex flex-wrap items-center gap-3">
          <h1 id="orderTitle" class="break-all text-2xl font-semibold text-foreground sm:text-3xl"></h1>
          <span id="orderStatus" class="rounded-md bg-muted px-2 py-0.5 text-sm font-medium text-foreground"></span>
        </div>
        <p id="orderSubtitle" class="mt-1 text-sm text-muted-foreground"></p>
      </div>

      <div id="orderPaymentReturnNotice" role="status" class="hidden rounded-xl border border-border bg-muted/30 p-4 text-sm text-foreground"></div>
      <div id="orderRefundNotice" role="status" class="hidden rounded-xl border border-border bg-muted/30 p-4 text-sm text-foreground"></div>

      <section class={card} aria-label="Order status">
        <div id="orderProgress"></div>
        <p id="orderExpectedDelivery" class="mt-3 hidden text-sm text-muted-foreground"></p>
        <h2 class="mb-3 mt-6 text-sm font-semibold text-foreground">Updates</h2>
        <ol id="orderTimeline" class="space-y-3 border-l border-border pl-4"></ol>
      </section>

      <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <section class={card} aria-labelledby="summaryHeading">
          <div class="mb-4 flex items-center justify-between gap-3">
            <h2 id="summaryHeading" class="text-base font-semibold text-foreground">Order summary</h2>
            <button type="button" id="orderBuyAgain" class="min-h-11 whitespace-nowrap text-sm font-medium text-primary hover:underline disabled:cursor-not-allowed disabled:text-muted-foreground disabled:no-underline">Buy again</button>
          </div>
          <p id="orderBuyAgainMessage" role="status" class="mb-4 text-sm text-muted-foreground empty:hidden"></p>
          <ul id="orderItems" class="divide-y divide-border"></ul>
          <dl id="orderSummary" class="mt-4 space-y-2 border-t border-border pt-4 text-sm"></dl>
        </section>

        <div class="space-y-6">
          <section class={card} aria-labelledby="deliveryHeading">
            <h2 id="deliveryHeading" class={heading}>Shipping address</h2>
            <div id="orderAddress" class="space-y-0.5 break-words text-sm text-muted-foreground"></div>
            <div id="orderShipments" class="mt-4 space-y-3"></div>
          </section>

          <section class={card} aria-labelledby="paymentHeading">
            <h2 id="paymentHeading" class={heading}>Payment</h2>
            <div id="orderPayment" class="space-y-1 text-sm"></div>
            <div id="orderPaymentRecovery" class="mt-4 hidden space-y-3 rounded-lg border border-border p-4">
              <div>
                <h3 id="orderPaymentRecoveryTitle" class="text-sm font-semibold text-foreground"></h3>
                <p id="orderPaymentRecoveryDescription" class="mt-1 text-sm text-muted-foreground"></p>
              </div>
              <div id="orderPaymentRecoveryMethods" class="grid gap-2" role="radiogroup" aria-label="Payment method"></div>
              <div id="accountStripeSection" class="hidden space-y-2">
                <div id="accountStripeCardElement" class="rounded-lg border border-input bg-background p-3"></div>
                <p id="accountStripeError" class="hidden text-sm text-destructive"></p>
              </div>
              <p id="orderPaymentRecoveryMessage" role="status" class="hidden text-sm"></p>
              <button type="button" id="orderPaymentRecoveryButton" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60"></button>
            </div>
          </section>

          <section class={card} aria-labelledby="helpHeading">
            <h2 id="helpHeading" class="text-base font-semibold text-foreground">Order help</h2>
            <p id="orderSupportIntro" class="mt-1 text-sm text-muted-foreground"></p>
            <div id="orderSupportActions" class="mt-4 grid gap-2"></div>
            <div id="orderSupportRequests" class="mt-4 space-y-3 empty:hidden"></div>
            <div id="orderSupportForm" class="mt-4 hidden rounded-lg border border-border p-4">
              <h3 id="orderSupportFormTitle" class="text-sm font-semibold text-foreground"></h3>
              <fieldset class="mt-3">
                <legend class="text-sm font-medium text-foreground">Reason</legend>
                <div id="orderSupportReasons" class="mt-1"></div>
              </fieldset>
              <label class="mt-3 block text-sm font-medium text-foreground" for="orderSupportMessage">Note (required for Other)</label>
              <textarea id="orderSupportMessage" class="mt-1.5 min-h-20 w-full rounded-lg border border-input bg-background px-3 py-2 text-sm text-foreground outline-none focus:border-primary focus:ring-2 focus:ring-primary/20" maxlength="1000"></textarea>
              <p id="orderSupportFormError" role="alert" class="mt-2 hidden text-sm text-destructive"></p>
              <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:justify-end">
                <button type="button" id="orderSupportCancel" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-4 text-sm font-medium text-foreground hover:bg-muted">Cancel</button>
                <button type="button" id="orderSupportSubmit" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60">Submit request</button>
              </div>
            </div>
            <StoreContact layoutData={layoutData} class="mt-4 text-sm text-muted-foreground" />
          </section>
        </div>
      </div>
    </div>
  </section>

<script>
  import { bindOrderDetailPage, loadOrderDetail } from "@/lib/account-order-detail";

  type DetailWindow = Window & { __scaliusOrderDetailBound?: boolean };
  const detailWindow = window as DetailWindow;
  const start = () => {
    bindOrderDetailPage();
    void loadOrderDetail();
  };

  if (!detailWindow.__scaliusOrderDetailBound) {
    detailWindow.__scaliusOrderDetailBound = true;
    document.addEventListener("astro:page-load", start);
    // Signing in from this page shows the order right here.
    window.addEventListener("customer-login", () => void loadOrderDetail());
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
</script>
</Layout>
