---
// "Show key": a POST-only page that reveals one licence key (fields: keyId,
// orderId on receipt pages, returnTo). The plaintext exists only in this
// no-store response: never in a URL, a log, a cache or analytics. That is why
// the page renders without the storefront Layout, so no merchant analytics or
// third-party script runs next to the key. A GET goes to the Downloads page.
import "@/styles/global.css";
import { shouldRejectCrossOriginCookieRequest } from "@scalius/shared/request-origin-guard";
import { DOWNLOAD_COPY as copy, downloadStatusText, isDigitalId } from "@/lib/account-downloads";
import {
  PRIVATE_HEADERS,
  formAccess,
  formReturnPath,
  privateRedirect,
  readSmallForm,
  revealLicenceKey,
  type RevealResult,
} from "@/lib/account-downloads-server";

export const prerender = false;

if (Astro.request.method !== "POST") return privateRedirect("/account/downloads");
if (shouldRejectCrossOriginCookieRequest(Astro.request)) {
  return new Response("Forbidden", { status: 403, headers: { "Content-Type": "text/plain; charset=utf-8", ...PRIVATE_HEADERS } });
}

const form = await readSmallForm(Astro.request);
const access = formAccess(form);
const returnTo = formReturnPath(form, access);
const keyId = form?.get("keyId");
const result: RevealResult = access && isDigitalId(keyId)
  ? await revealLicenceKey(Astro.request, access, keyId)
  : { ok: false, flag: "missing" };

for (const [name, value] of Object.entries(PRIVATE_HEADERS)) Astro.response.headers.set(name, value);
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
if (!result.ok) {
  Astro.response.status = result.flag === "rate" ? 429 : result.flag === "unavailable" ? 503 : result.flag === "signin" ? 401 : 404;
}
const errorText = result.ok
  ? ""
  : result.flag === "rate" || result.flag === "signin" || result.flag === "missing"
    ? downloadStatusText(result.flag)
    : copy.keyUnavailable;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>{copy.keyPageTitle}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <main class="mx-auto flex min-h-screen w-full max-w-lg items-center px-4 py-10">
      <section class="w-full rounded-xl border border-border bg-card p-5 sm:p-7" aria-labelledby="licenceKeyTitle">
        <h1 id="licenceKeyTitle" class="text-2xl font-semibold tracking-tight">{copy.keyPageTitle}</h1>
        {result.ok ? (
          <>
            <p class="mt-2 text-sm text-muted-foreground">{copy.keyPageIntro}</p>
            <p class="mt-5 text-sm font-medium" id="licenceKeyLabel">{copy.keyLabel}</p>
            <output
              id="licenceKeyValue"
              aria-labelledby="licenceKeyLabel"
              class="mt-1.5 block select-all break-all rounded-lg border border-border bg-muted/40 px-3 py-3 font-mono text-base"
            >{result.key}</output>
            <div class="mt-5 flex flex-wrap gap-3">
              <button
                type="button"
                hidden
                data-copy-licence-key
                data-copied-text={copy.copiedKey}
                class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/90"
              >{copy.copyKey}</button>
              <a href={returnTo} data-astro-prefetch="false" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border px-5 text-sm font-medium hover:bg-muted">{copy.back}</a>
            </div>
          </>
        ) : (
          <>
            <p class="mt-3 text-sm text-foreground" role="alert">{errorText}</p>
            <div class="mt-5">
              <a href={returnTo} data-astro-prefetch="false" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/90">{copy.back}</a>
            </div>
          </>
        )}
      </section>
    </main>
  </body>
</html>

<script>
  // Copy is an enhancement: without JavaScript the key is selectable text.
  const button = document.querySelector<HTMLButtonElement>("[data-copy-licence-key]");
  const value = document.getElementById("licenceKeyValue");
  if (button && value && navigator.clipboard) {
    const label = button.textContent ?? "";
    button.hidden = false;
    button.addEventListener("click", () => {
      void navigator.clipboard.writeText(value.textContent?.trim() ?? "").then(() => {
        button.textContent = button.dataset.copiedText ?? label;
        window.setTimeout(() => { button.textContent = label; }, 2000);
      }).catch(() => undefined);
    });
  }
</script>
