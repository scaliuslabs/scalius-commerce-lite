---
// Account Downloads: every file and licence key the account's orders
// delivered, newest first. Server-rendered from the session cookie, so it works
// without JavaScript: Download and Show key are plain POST forms carrying ids
// only. A refused download comes back here with `?download=<flag>` and the
// file's anchor.
import Layout from "@/layouts/Layout.astro";
import AccountTabs from "@/components/account/AccountTabs.astro";
import { getLayoutData } from "@/lib/api";
import {
  DOWNLOAD_COPY as copy,
  downloadStatusText,
  readDownloadNotice,
  renderDownloadLines,
} from "@/lib/account-downloads";
import { readAccountDownloads } from "@/lib/account-downloads-server";
import { readAccountSummaryForRequest } from "@/lib/account-tabs-server";

export const prerender = false;

const [layoutData, downloads, summary] = await Promise.all([
  getLayoutData(),
  readAccountDownloads(Astro.request),
  readAccountSummaryForRequest(Astro.request),
]);
const notice = readDownloadNotice(Astro.url.search);
Astro.response.headers.set("Cache-Control", "private, no-store");
if (!downloads.ok && downloads.reason !== "signed_out") Astro.response.status = 503;
const lines = downloads.ok ? downloads.data : [];
const listMarkup = downloads.ok ? renderDownloadLines(lines, { returnTo: "/account/downloads" }) : "";
---

<Layout title={copy.pageTitle} layoutData={layoutData}>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <section class="container mx-auto max-w-3xl px-4 py-8" data-account-downloads>
    <AccountTabs current="downloads" summary={summary} />

    {!downloads.ok && downloads.reason === "signed_out" && (
      <div class="mx-auto max-w-md py-12 text-center">
        <h1 class="mb-2 text-2xl font-semibold text-foreground">{copy.signInTitle}</h1>
        <p class="mb-6 text-muted-foreground">{copy.signInBody}</p>
        <button type="button" onclick="window.dispatchEvent(new CustomEvent('open-auth-modal'))" class="inline-flex min-h-11 items-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground hover:bg-primary/90">{copy.signIn}</button>
      </div>
    )}

    {!downloads.ok && downloads.reason !== "signed_out" && (
      <div class="mx-auto max-w-md py-12 text-center" role="alert">
        <h1 class="mb-2 text-2xl font-semibold text-foreground">{copy.pageTitle}</h1>
        <p class="mb-6 text-foreground">{copy.unavailable}</p>
        <a href="/account/downloads" data-astro-prefetch="false" class="inline-flex min-h-11 items-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground hover:bg-primary/90">{copy.retry}</a>
      </div>
    )}

    {downloads.ok && (
      <div class="space-y-6">
        <div>
          <h1 class="text-2xl font-semibold text-foreground sm:text-3xl">{copy.pageTitle}</h1>
          <p class="mt-1 text-sm text-muted-foreground">{copy.pageIntro}</p>
        </div>

        {notice && (
          <p role="status" class="rounded-xl border border-border bg-muted/30 p-4 text-sm font-medium text-destructive">{downloadStatusText(notice.flag)}</p>
        )}

        {lines.length > 0 ? (
          <ul class="space-y-4" aria-label={copy.pageTitle} set:html={listMarkup} />
        ) : (
          <div class="rounded-xl border border-dashed border-border p-10 text-center">
            <p class="text-sm text-muted-foreground">{copy.empty}</p>
          </div>
        )}
      </div>
    )}
  </section>
</Layout>

<script>
  // Signing in from the prompt above shows the downloads.
  type DownloadsWindow = Window & { __scaliusDownloadsLoginBound?: boolean };
  const downloadsWindow = window as DownloadsWindow;
  if (!downloadsWindow.__scaliusDownloadsLoginBound) {
    downloadsWindow.__scaliusDownloadsLoginBound = true;
    window.addEventListener("customer-login", () => {
      if (document.querySelector("[data-account-downloads]")) window.location.reload();
    });
  }
</script>
