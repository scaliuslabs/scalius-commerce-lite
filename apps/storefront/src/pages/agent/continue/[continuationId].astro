---
import "@/styles/global.css";
import { readAgentContinuationCookie } from "@/lib/agent-continuation-cookie";

export const prerender = false;

const continuationId = Astro.params.continuationId?.trim() ?? "";
const validContinuationId = /^acn_[A-Za-z0-9_-]{20}$/.test(continuationId)
  && readAgentContinuationCookie(Astro.request.headers.get("cookie"), continuationId) === continuationId;

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
Astro.response.headers.set(
  "Content-Security-Policy",
  "default-src 'self'; script-src 'self' https://js.stripe.com; connect-src 'self' https://api.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; form-action 'self' https://*.sslcommerz.com https://*.polar.sh; frame-ancestors 'none'; base-uri 'none'",
);

if (!validContinuationId) Astro.response.status = 404;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>{validContinuationId ? "Secure storefront step" : "Continuation unavailable"}</title>
  </head>
  <body class="min-h-screen bg-muted/30 text-foreground">
    <main
      id="agentContinuationRoot"
      data-continuation-id={validContinuationId ? continuationId : undefined}
      class="mx-auto flex min-h-screen w-full max-w-xl items-center px-4 py-10"
    >
      <section class="w-full rounded-xl border border-border bg-background p-5 shadow-sm sm:p-7" aria-labelledby="continuation-title">
        <p class="text-sm font-medium uppercase tracking-wide text-muted-foreground">Secure storefront</p>
        <h1 id="continuation-title" class="mt-2 text-2xl font-semibold tracking-tight">
          {validContinuationId ? "Complete this private step" : "This continuation is unavailable"}
        </h1>
        {validContinuationId ? (
          <>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">
              Verification and payment details stay in this protected storefront tab and are never returned to the agent.
            </p>
            <div id="continuationStatus" class="mt-5 rounded-lg border border-border bg-muted/20 p-4" role="status" aria-live="polite">
              <p class="font-medium">Loading the secure workflow…</p>
            </div>

            <section id="customerAuthStep" class="mt-5 hidden space-y-5" aria-labelledby="customer-auth-title">
              <h2 id="customer-auth-title" class="text-lg font-semibold">Authorize your customer account</h2>
              <form id="customerAuthRequestForm" class="space-y-4">
                <label class="block text-sm font-medium">
                  Account action
                  <select id="customerIntent" class="mt-1 w-full rounded-lg border border-border bg-background px-3 py-2.5">
                    <option value="sign_in">Sign in</option>
                    <option value="sign_up">Create account</option>
                  </select>
                </label>
                <label class="block text-sm font-medium">
                  Verification method
                  <select id="customerMethod" class="mt-1 w-full rounded-lg border border-border bg-background px-3 py-2.5">
                    <option value="phone">Phone</option>
                    <option value="email">Email</option>
                  </select>
                </label>
                <label class="block text-sm font-medium">
                  Delivery channel
                  <select id="customerChannel" class="mt-1 w-full rounded-lg border border-border bg-background px-3 py-2.5">
                    <option value="sms">SMS</option>
                    <option value="whatsapp">WhatsApp</option>
                    <option value="email">Email</option>
                  </select>
                </label>
                <label class="block text-sm font-medium">
                  Phone number or email
                  <input id="customerIdentifier" required autocomplete="username" class="mt-1 w-full rounded-lg border border-border bg-background px-3 py-2.5" />
                </label>
                <label class="block text-sm font-medium">
                  Name
                  <input id="customerName" autocomplete="name" maxlength="100" class="mt-1 w-full rounded-lg border border-border bg-background px-3 py-2.5" />
                </label>
                <label class="block text-sm font-medium">
                  Phone for account profile
                  <input id="customerPhone" autocomplete="tel" maxlength="32" class="mt-1 w-full rounded-lg border border-border bg-background px-3 py-2.5" />
                </label>
                <label class="block text-sm font-medium">
                  Email for account profile
                  <input id="customerEmail" type="email" autocomplete="email" maxlength="254" class="mt-1 w-full rounded-lg border border-border bg-background px-3 py-2.5" />
                </label>
                <button type="submit" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-primary px-4 py-2.5 font-semibold text-primary-foreground disabled:opacity-60">
                  Send verification code
                </button>
              </form>
              <form id="customerAuthVerifyForm" class="hidden space-y-4">
                <label class="block text-sm font-medium">
                  Verification code
                  <input id="customerVerificationCode" required inputmode="numeric" autocomplete="one-time-code" maxlength="12" class="mt-1 w-full rounded-lg border border-border bg-background px-3 py-2.5 tracking-widest" />
                </label>
                <button type="submit" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-primary px-4 py-2.5 font-semibold text-primary-foreground disabled:opacity-60">
                  Verify and authorize
                </button>
              </form>
            </section>

            <section id="paymentStep" class="mt-5 hidden space-y-4" aria-labelledby="payment-title">
              <h2 id="payment-title" class="text-lg font-semibold">Complete payment</h2>
              <p class="text-sm text-muted-foreground">Payment details are handled only by this page and the configured gateway.</p>
              <div id="stripeCardSection" class="hidden space-y-3">
                <div id="stripeCardElement" class="rounded-lg border border-border bg-background p-3"></div>
                <p id="stripeCardError" class="text-sm text-destructive" aria-live="polite"></p>
              </div>
              <button id="startPaymentButton" type="button" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-primary px-4 py-2.5 font-semibold text-primary-foreground disabled:opacity-60">
                Continue to payment
              </button>
            </section>

            <section id="recoveryStep" class="mt-5 hidden space-y-5" aria-labelledby="recovery-title">
              <h2 id="recovery-title" class="text-lg font-semibold">Verify order access</h2>
              <form id="recoveryRequestForm" class="space-y-4">
                <label class="block text-sm font-medium">
                  Delivery channel
                  <select id="recoveryChannel" class="mt-1 w-full rounded-lg border border-border bg-background px-3 py-2.5">
                    <option value="email">Email</option>
                    <option value="sms">SMS</option>
                    <option value="whatsapp">WhatsApp</option>
                  </select>
                </label>
                <button type="submit" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-primary px-4 py-2.5 font-semibold text-primary-foreground disabled:opacity-60">
                  Send verification code
                </button>
              </form>
              <form id="recoveryVerifyForm" class="hidden space-y-4">
                <label class="block text-sm font-medium">
                  Verification code
                  <input id="recoveryVerificationCode" required inputmode="numeric" autocomplete="one-time-code" maxlength="12" class="mt-1 w-full rounded-lg border border-border bg-background px-3 py-2.5 tracking-widest" />
                </label>
                <button type="submit" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-primary px-4 py-2.5 font-semibold text-primary-foreground disabled:opacity-60">
                  Verify order access
                </button>
              </form>
            </section>
          </>
        ) : (
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            The continuation reference is invalid or incomplete. Return to the agent and start the secure step again.
          </p>
        )}
        <div class="mt-6 border-t border-border pt-4">
          <a class="text-sm font-medium text-primary underline-offset-4 hover:underline" href="/">Return to the storefront</a>
        </div>
      </section>
    </main>
  </body>
</html>

<script>
  import { normalizeHostedCheckoutUrl } from "@/lib/checkout/redirect-url";

  type ContinuationKind = "customer_auth" | "payment" | "payment_recovery";
  type JsonRecord = Record<string, unknown>;
  interface StripeCardElement {
    mount(selector: string): void;
    on(event: string, handler: (event: { error?: { message?: string } }) => void): void;
  }
  interface StripeInstance {
    elements(): { create(type: "card"): StripeCardElement };
    confirmCardPayment(secret: string, input: { payment_method: { card: StripeCardElement } }): Promise<{
      error?: { message?: string };
      paymentIntent?: { status?: string };
    }>;
  }
  type SecureWindow = Window & { Stripe?: (key: string) => StripeInstance };

  const root = document.getElementById("agentContinuationRoot") as HTMLElement | null;
  const continuationId = root?.dataset.continuationId ?? "";
  const endpoint = `/api/agent-continuations/${encodeURIComponent(continuationId)}`;
  const statusElement = document.getElementById("continuationStatus") as HTMLElement | null;
  let customerRequest: JsonRecord | null = null;
  let recoveryChannel = "email";
  let stripe: StripeInstance | null = null;
  let stripeCard: StripeCardElement | null = null;
  let stripeSecret: string | null = null;

  function asRecord(value: unknown): JsonRecord | null {
    return typeof value === "object" && value !== null && !Array.isArray(value) ? value as JsonRecord : null;
  }

  function messageFrom(payload: unknown, fallback: string): string {
    const record = asRecord(payload);
    if (typeof record?.error === "string") return record.error;
    const error = asRecord(record?.error);
    if (typeof error?.message === "string") return error.message;
    const data = asRecord(record?.data);
    return typeof data?.message === "string" ? data.message : fallback;
  }

  function setStatus(message: string, tone: "neutral" | "success" | "error" = "neutral"): void {
    if (!statusElement) return;
    statusElement.className = `mt-5 rounded-lg border p-4 ${tone === "error" ? "border-destructive/40 bg-destructive/5 text-destructive" : tone === "success" ? "border-emerald-500/40 bg-emerald-500/5 text-emerald-800" : "border-border bg-muted/20"}`;
    statusElement.textContent = message;
  }

  function show(id: string): void {
    document.getElementById(id)?.classList.remove("hidden");
  }

  function setFormBusy(form: HTMLFormElement, busy: boolean): void {
    for (const control of form.querySelectorAll("button, input, select")) {
      (control as HTMLButtonElement | HTMLInputElement | HTMLSelectElement).disabled = busy;
    }
  }

  async function call(action = "", body?: JsonRecord): Promise<JsonRecord> {
    const response = await fetch(`${endpoint}${action}`, {
      method: body ? "POST" : "GET",
      headers: body ? { "Content-Type": "application/json" } : undefined,
      body: body ? JSON.stringify(body) : undefined,
      cache: "no-store",
      credentials: "same-origin",
      referrerPolicy: "no-referrer",
    });
    const payload = await response.json().catch(() => null);
    if (!response.ok) throw new Error(messageFrom(payload, "This secure step could not continue."));
    const data = asRecord(asRecord(payload)?.data);
    if (!data) throw new Error("The secure service returned an invalid response.");
    return data;
  }

  async function loadStripe(): Promise<void> {
    const secureWindow = window as SecureWindow;
    if (secureWindow.Stripe) return;
    await new Promise<void>((resolve, reject) => {
      const script = document.createElement("script");
      script.src = "https://js.stripe.com/v3/";
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error("The secure card form could not load."));
      document.head.appendChild(script);
    });
  }

  async function confirmStripePayment(button: HTMLButtonElement): Promise<void> {
    if (!stripe || !stripeCard || !stripeSecret) return;
    button.disabled = true;
    setStatus("Confirming payment…");
    try {
      const result = await stripe.confirmCardPayment(stripeSecret, { payment_method: { card: stripeCard } });
      if (result.error) throw new Error(result.error.message || "Payment was not completed.");
      if (result.paymentIntent?.status !== "succeeded" && result.paymentIntent?.status !== "requires_capture") {
        throw new Error("The payment gateway has not confirmed payment.");
      }
      const reconciliation = await call("/payment/reconcile", {});
      const reconciliationStatus = typeof reconciliation.status === "string" ? reconciliation.status : "scheduled";
      setStatus(
        reconciliationStatus === "settled"
          ? "Payment confirmed. You may return to the agent."
          : "Payment confirmed and settlement is processing. You may return to the agent.",
        "success",
      );
      button.classList.add("hidden");
    } catch (error) {
      setStatus(error instanceof Error ? error.message : "Payment was not completed.", "error");
      button.disabled = false;
    }
  }

  async function startPayment(button: HTMLButtonElement): Promise<void> {
    if (stripe && stripeCard && stripeSecret) return confirmStripePayment(button);
    button.disabled = true;
    setStatus("Preparing the payment gateway…");
    try {
      const session = await call("/payment/start", {});
      if (session.status === "processing") {
        setStatus("Payment setup is already processing. Wait a moment, then try again.");
        button.disabled = false;
        return;
      }
      const hosted = asRecord(session.hosted);
      const gatewayUrl = normalizeHostedCheckoutUrl(typeof hosted?.gatewayUrl === "string" ? hosted.gatewayUrl : null);
      if (gatewayUrl) {
        window.location.assign(gatewayUrl);
        return;
      }
      const stripePayload = asRecord(session.stripe);
      const secret = typeof stripePayload?.clientSecret === "string" ? stripePayload.clientSecret : "";
      const publishableKey = typeof stripePayload?.publishableKey === "string" ? stripePayload.publishableKey : "";
      if (!secret || !publishableKey) throw new Error("The payment gateway returned an incomplete session.");
      await loadStripe();
      const secureWindow = window as SecureWindow;
      if (!secureWindow.Stripe) throw new Error("The secure card form is unavailable.");
      stripe = secureWindow.Stripe(publishableKey);
      stripeCard = stripe.elements().create("card");
      stripeCard.mount("#stripeCardElement");
      stripeCard.on("change", (event) => {
        const target = document.getElementById("stripeCardError");
        if (target) target.textContent = event.error?.message ?? "";
      });
      stripeSecret = secret;
      show("stripeCardSection");
      button.textContent = "Confirm card payment";
      button.disabled = false;
      setStatus("Enter your card details, then confirm payment.");
    } catch (error) {
      setStatus(error instanceof Error ? error.message : "Payment could not be prepared.", "error");
      button.disabled = false;
    }
  }

  document.getElementById("customerAuthRequestForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const method = (document.getElementById("customerMethod") as HTMLSelectElement).value;
    const identifier = (document.getElementById("customerIdentifier") as HTMLInputElement).value.trim();
    const name = (document.getElementById("customerName") as HTMLInputElement).value.trim();
    const phoneInput = (document.getElementById("customerPhone") as HTMLInputElement).value.trim();
    const emailInput = (document.getElementById("customerEmail") as HTMLInputElement).value.trim();
    customerRequest = {
      method,
      channel: (document.getElementById("customerChannel") as HTMLSelectElement).value,
      intent: (document.getElementById("customerIntent") as HTMLSelectElement).value,
      identifier,
      ...(name ? { name } : {}),
      ...(method === "phone" || phoneInput ? { phone: method === "phone" ? identifier : phoneInput } : {}),
      ...(method === "email" || emailInput ? { email: method === "email" ? identifier : emailInput } : {}),
    };
    setFormBusy(form, true);
    try {
      const result = await call("/customer/send-otp", customerRequest);
      setStatus(typeof result.message === "string" ? result.message : "Verification code sent.", "success");
      show("customerAuthVerifyForm");
    } catch (error) {
      setStatus(error instanceof Error ? error.message : "Verification could not be sent.", "error");
    } finally {
      setFormBusy(form, false);
    }
  });

  document.getElementById("customerAuthVerifyForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    if (!customerRequest) return;
    setFormBusy(form, true);
    try {
      await call("/customer/verify-otp", {
        ...customerRequest,
        code: (document.getElementById("customerVerificationCode") as HTMLInputElement).value.trim(),
      });
      setStatus("Customer account authorized. You may close this tab and return to the agent.", "success");
      document.getElementById("customerAuthStep")?.classList.add("hidden");
    } catch (error) {
      setStatus(error instanceof Error ? error.message : "Verification failed.", "error");
    } finally {
      setFormBusy(form, false);
    }
  });

  document.getElementById("recoveryRequestForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    recoveryChannel = (document.getElementById("recoveryChannel") as HTMLSelectElement).value;
    setFormBusy(form, true);
    try {
      const result = await call("/recovery/send-otp", { channel: recoveryChannel });
      setStatus(typeof result.message === "string" ? result.message : "Verification code sent.", "success");
      show("recoveryVerifyForm");
    } catch (error) {
      setStatus(error instanceof Error ? error.message : "Verification could not be sent.", "error");
    } finally {
      setFormBusy(form, false);
    }
  });

  document.getElementById("recoveryVerifyForm")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    setFormBusy(form, true);
    try {
      await call("/recovery/verify-otp", {
        channel: recoveryChannel,
        code: (document.getElementById("recoveryVerificationCode") as HTMLInputElement).value.trim(),
      });
      setStatus("Order access verified. You may close this tab and return to the agent.", "success");
      document.getElementById("recoveryStep")?.classList.add("hidden");
    } catch (error) {
      setStatus(error instanceof Error ? error.message : "Verification failed.", "error");
    } finally {
      setFormBusy(form, false);
    }
  });

  document.getElementById("startPaymentButton")?.addEventListener("click", (event) => {
    void startPayment(event.currentTarget as HTMLButtonElement);
  });

  document.getElementById("customerMethod")?.addEventListener("change", (event) => {
    const method = (event.currentTarget as HTMLSelectElement).value;
    const channel = document.getElementById("customerChannel") as HTMLSelectElement | null;
    if (!channel) return;
    if (method === "email") channel.value = "email";
    else if (channel.value === "email") channel.value = "sms";
  });

  async function bootstrap(): Promise<void> {
    if (!continuationId) return;
    try {
      const continuation = await call();
      if (continuation.status === "complete") {
        setStatus("This secure step is complete. You may close this tab and return to the agent.", "success");
        return;
      }
      if (continuation.status === "expired" || continuation.status === "failed") {
        throw new Error("This secure step is no longer active. Ask the agent to start it again.");
      }
      const kind = continuation.kind as ContinuationKind;
      if (kind === "customer_auth") show("customerAuthStep");
      else if (kind === "payment") show("paymentStep");
      else if (kind === "payment_recovery") show("recoveryStep");
      else throw new Error("This secure step has an unsupported purpose.");
      setStatus("This protected step is ready.");
    } catch (error) {
      setStatus(error instanceof Error ? error.message : "This secure step is unavailable.", "error");
    }
  }

  void bootstrap();
</script>
