---
import ErrorPageState from "@/components/ErrorPageState.astro";
import "../styles/global.css";

const retryHref = `${Astro.url.pathname}${Astro.url.search}`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Page unavailable</title>
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground">
    <ErrorPageState
      code="500"
      title="Page unavailable"
      message="We couldn't load this page. Please try again in a moment."
      primaryHref={retryHref}
      primaryLabel="Try again"
      secondaryHref="/"
      secondaryLabel="Go to home"
      fullHeight
    />
  </body>
</html>
