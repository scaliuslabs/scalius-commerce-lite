---
// src/pages/search/index.astro
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import CategoryFilters from "@/components/CategoryFilters";
import CatalogPagination from "@/components/catalog/CatalogPagination.astro";
import AppliedCatalogFilters from "@/components/catalog/AppliedCatalogFilters.astro";
import CatalogEmptyState from "@/components/catalog/CatalogEmptyState.astro";
import {
  getAllProducts,
  getLayoutData,
  type Product,
  type ProductListOptions,
  type PaginatedResponse,
  type ProductFacet,
  type LayoutData,
} from "@/lib/api";
import { SlidersHorizontal, X, Search } from "lucide-react";
import { setRuntimeImageCdnPolicy } from "@/lib/api/runtime-env";
import {
  buildProductListPaginationHref,
  resolveProductListQueryState,
} from "@/lib/product-list-query";
import { buildAbsoluteStorefrontSeoUrl } from "@/lib/seo-base-url";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";

const initialQueryState = resolveProductListQueryState({
  url: Astro.url,
  allowUnknownAttributes: true,
});
if (initialQueryState.redirectPath) {
  return Astro.redirect(initialQueryState.redirectPath);
}

let productsResponse: PaginatedResponse<Product> | null = null;
let layoutData: LayoutData | null = null;
const productListOptions: ProductListOptions = initialQueryState.options;

try {
  [layoutData, productsResponse] = await Promise.all([
    getLayoutData(),
    getAllProducts(productListOptions),
  ]);
  setRuntimeImageCdnPolicy(layoutData?.media);
} catch (e: unknown) {
  console.error("Error fetching shop/search data:", e);
}

if (!layoutData || !productsResponse) {
  const response = storefrontDataUnavailableResponse(
    "We could not load the product list. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const facets: ProductFacet[] = productsResponse.facets ?? [];
const queryState = resolveProductListQueryState({ url: Astro.url, facets });
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);
const query = queryState.query;
const sortBy = queryState.sortBy;
const currentFilters = queryState.currentFilters;

const products = productsResponse?.data || [];
const pagination = productsResponse?.pagination || {
  total: 0,
  totalPages: 0,
  page: 1,
};

const pageTitle = query ? `Search results for "${query}"` : "All products";
const resultCountLabel = `${pagination.total} ${pagination.total === 1 ? "result" : "results"}`;
const productCountLabel = `${pagination.total} ${pagination.total === 1 ? "product" : "products"}`;
const pageDescription = query
  ? `Found ${productCountLabel} for "${query}".`
  : "Explore our full collection of products.";
const productListPathname = Astro.url.pathname;
const canonicalFilterState = JSON.stringify(currentFilters);

function getPaginationUrl(pageNum: number) {
  return buildProductListPaginationHref({
    pathname: productListPathname,
    currentFilters,
    page: pageNum,
  });
}

const activeFilterCount = Object.keys(currentFilters)
  .filter(
    (key) =>
      key !== "page" && key !== "sortBy" && currentFilters[key],
  )
  .reduce(
    (count, key) =>
      count +
      (Array.isArray(currentFilters[key]) ? currentFilters[key].length : 1),
    0,
  );
const canonicalUrl = buildAbsoluteStorefrontSeoUrl("/search");
const shouldNoindexSearchPage =
  Boolean(query) ||
  pagination.page > 1 ||
  sortBy !== "newest" ||
  activeFilterCount > 0;

import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;

// Include product name for richer analytics data
const analyticsProductData = products.map((p) => ({
  id: p.id,
  name: p.name,
  price: p.discountedPrice,
}));
---

<Layout
  title={pageTitle}
  description={pageDescription}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
>
  {
    shouldNoindexSearchPage && (
      <meta slot="head" name="robots" content="noindex,follow" />
    )
  }
  <div
    class="min-h-screen bg-gray-50"
    data-search-query={query}
    data-products-for-analytics={JSON.stringify(analyticsProductData)}
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
      <div class="mb-5 py-3 sm:mb-6 sm:py-4">
        <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">
          {query ? "Search results" : "All products"}
        </h1>
        {
          query && (
            <p class="mt-1.5 text-sm text-gray-600 sm:text-base">
              <span class="font-semibold text-gray-900">{resultCountLabel}</span>{" "}
              for <span class="font-medium text-gray-800">“{query}”</span>
            </p>
          )
        }
      </div>

      <div class="sticky top-[calc(var(--header-height,3.5rem)+0.5rem)] z-30 -mx-1 mb-4 grid grid-cols-2 gap-2 rounded-xl bg-gray-50/95 p-1 backdrop-blur lg:hidden">
        <button
          type="button"
          id="mobile-filter-toggle"
          aria-controls="filter-section"
          aria-expanded="false"
          class="relative flex min-h-11 items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm font-semibold text-gray-800 shadow-sm"
        >
          <SlidersHorizontal className="w-4 h-4" />
          <span>Filters</span>
          {
            activeFilterCount > 0 && (
              <span class="absolute -top-1 -right-1 bg-destructive text-destructive-foreground text-xs rounded-full h-5 w-5 flex items-center justify-center">
                {activeFilterCount}
              </span>
            )
          }
        </button>

        <label class="relative block">
          <span class="sr-only">Sort products</span>
          <select
            id="sortByMobile"
            name="sortBy"
            data-catalog-sort
            data-list-pathname={productListPathname}
            data-current-filters={canonicalFilterState}
            class="min-h-11 w-full rounded-lg border-gray-200 bg-white py-2.5 pl-3 pr-8 text-sm font-semibold text-gray-800 shadow-sm focus:border-primary focus:ring-2 focus:ring-primary"
          >
            <option value="newest" selected={sortBy === "newest"}>Latest</option
            >
            <option value="price-asc" selected={sortBy === "price-asc"}
              >Price: Low to High</option
            >
            <option value="price-desc" selected={sortBy === "price-desc"}
              >Price: High to Low</option
            >
            <option value="name-asc" selected={sortBy === "name-asc"}
              >Name: A to Z</option
            >
            <option value="name-desc" selected={sortBy === "name-desc"}
              >Name: Z to A</option
            >
            <option value="discount" selected={sortBy === "discount"}
              >Biggest discount</option
            >
          </select>
        </label>
      </div>

      <div class="flex flex-col lg:flex-row gap-6">
        <aside
          id="filter-section"
          aria-labelledby="mobile-filter-title"
          class="fixed inset-0 z-60 hidden bg-black/50 lg:static lg:z-0 lg:block lg:w-80 lg:shrink-0 lg:bg-transparent"
        >
          <div
            class="flex h-full w-full flex-col bg-white lg:sticky lg:top-[calc(var(--header-height,4rem)+1rem)] lg:max-h-[calc(100dvh-var(--header-height,4rem)-2rem)] lg:w-full lg:overflow-hidden lg:rounded-lg lg:border lg:border-gray-100 lg:shadow-sm"
          >
            <div
              class="flex justify-between items-center lg:hidden p-4 border-b bg-white"
            >
              <h3 id="mobile-filter-title" class="font-semibold text-lg">
                Filters
              </h3>
              <button
                type="button"
                id="mobile-filter-close"
                aria-label="Close filters"
                class="inline-flex h-11 w-11 items-center justify-center rounded-lg hover:bg-gray-100"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form id="filterForm" method="get" class="grow overflow-y-auto">
              <input type="hidden" name="page" value="1" />
              <!-- Hidden sortBy field to maintain sort state -->
              <input type="hidden" name="sortBy" value={sortBy} />

              <div class="p-4 lg:p-6">
                <div class="relative mb-6">
                  <Search
                    className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400"
                  />
                  <input
                    type="search"
                    name="q"
                    placeholder="Search products..."
                    value={query}
                    class="w-full rounded-lg border-gray-300 pl-9 pr-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-primary"
                  />
                </div>

                <CategoryFilters
                  client:load
                  facets={facets}
                  currentFilters={currentFilters}
                  priceRange={productsResponse.priceRange}
                />
              </div>
            </form>
          </div>
        </aside>

        <div class="flex-1 min-w-0">
          <div
            class="mb-6 hidden items-center justify-between gap-4 rounded-lg border border-gray-100 bg-white p-4 shadow-sm lg:flex"
          >
            <p class="text-sm font-medium text-gray-700">
              Showing <span class="font-bold text-primary"
                >{products.length}</span
              > of{" "}
              <span class="font-bold text-primary">{pagination.total}</span>{" "}
              {pagination.total === 1 ? "product" : "products"}
            </p>

            <div class="flex items-center gap-3">
              <label
                for="sortByDesktop"
                class="text-sm font-medium text-gray-700 whitespace-nowrap"
              >
                Sort by:
              </label>
              <select
                id="sortByDesktop"
                name="sortBy"
                data-catalog-sort
                data-list-pathname={productListPathname}
                data-current-filters={canonicalFilterState}
                class="rounded-lg border-gray-300 text-sm focus:ring-2 focus:ring-primary focus:border-primary min-w-[140px]"
              >
                <option value="newest" selected={sortBy === "newest"}>
                  Latest
                </option>
                <option value="price-asc" selected={sortBy === "price-asc"}>
                  Price: Low to High
                </option>
                <option value="price-desc" selected={sortBy === "price-desc"}>
                  Price: High to Low
                </option>
                <option value="name-asc" selected={sortBy === "name-asc"}>
                  Name: A to Z
                </option>
                <option value="name-desc" selected={sortBy === "name-desc"}>
                  Name: Z to A
                </option>
                <option value="discount" selected={sortBy === "discount"}>
                  Biggest discount
                </option>
              </select>
            </div>
          </div>

          {!query && (
            <p class="mb-3 text-sm text-gray-600 lg:hidden">
              <span class="font-semibold text-gray-900">{pagination.total}</span>{
                " "
              }
              {pagination.total === 1 ? "product" : "products"}
            </p>
          )}

          <AppliedCatalogFilters
            facets={facets}
            currentFilters={currentFilters}
            pathname={productListPathname}
            currencySymbol={currencySymbol}
          />

          {
            products.length === 0 && (
              <CatalogEmptyState
                title={query || activeFilterCount > 0 ? "No matching products" : "No products yet"}
                description={query || activeFilterCount > 0
                  ? "Try a different search or remove some filters."
                  : "This store does not have any products available yet."}
                actionHref={query || activeFilterCount > 0 ? "/search" : "/"}
                actionLabel={query || activeFilterCount > 0 ? "Clear search and filters" : "Back to home"}
              />
            )
          }

          {
            products.length > 0 && (
              <Fragment>
                <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 mb-8">
                  {products.map((product) => (
                    <ProductCard
                      product={product}
                      currencySymbol={currencySymbol}
                      currencyCode={currencyCode}
                    />
                  ))}
                </div>

                <CatalogPagination
                  page={pagination.page}
                  totalPages={pagination.totalPages}
                  getPageUrl={getPaginationUrl}
                />
              </Fragment>
            )
          }
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { setupCatalogFilterDialog } from "@/lib/catalog-filter-dialog";
  import { setupCatalogSorts } from "@/lib/catalog-sort";

  document.addEventListener("DOMContentLoaded", () => {
    setupCatalogFilterDialog();
    setupCatalogSorts();
  });

  document.addEventListener("astro:page-load", () => {
    setupCatalogFilterDialog();
    setupCatalogSorts();
  });
</script>

<script>
  import { trackStorefrontSearchResults } from "@/lib/analytics";

  type ProductAnalyticsData = {
    id: string;
    name: string;
    price: number;
  };

  function trackSearchResults() {
    const productListElement = document.querySelector<HTMLElement>(
      "[data-products-for-analytics]",
    );
    if (
      !productListElement ||
      productListElement.dataset.searchTracked === "true"
    )
      return;

    try {
      const productsData: ProductAnalyticsData[] = JSON.parse(
        productListElement.dataset.productsForAnalytics || "[]",
      );
      const searchQuery = productListElement.dataset.searchQuery || "";

      const tracked = trackStorefrontSearchResults({
        searchQuery,
        products: productsData,
        currency: window.__CURRENCY_CODE__ || "BDT",
      });

      if (tracked) productListElement.dataset.searchTracked = "true";
    } catch (error: unknown) {
      console.error("Failed to track search event:", error);
    }
  }

  document.addEventListener("DOMContentLoaded", trackSearchResults);
  document.addEventListener("astro:page-load", trackSearchResults);
</script>
