---
// src/pages/search/index.astro
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import ProductGrid from "@/components/cards/ProductGrid.astro";
import CatalogListingPage from "@/components/catalog/CatalogListingPage.astro";
import {
  getAllCategories,
  getAllProducts,
  getLayoutData,
  getProductRecommendations,
  type Category,
  type Product,
  type PaginatedResponse,
  type LayoutData,
  type ProductRecommendations,
} from "@/lib/api";
import { recommendationTitle } from "@/lib/recommendations";
import { setRuntimeImageCdnPolicy } from "@/lib/api/runtime";
import {
  buildProductListHref,
  countActiveProductListFilters,
  isIndexableProductListView,
  isMissingProductListPage,
  productListCanonicalUrl,
  resolveProductListQueryState,
} from "@/lib/product-list-query";
import { buildAbsoluteStorefrontSeoUrl } from "@/lib/seo-base-url";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";

const initialQueryState = resolveProductListQueryState({
  url: Astro.url,
  allowUnknownAttributes: true,
  rankByRelevance: true,
});
if (initialQueryState.redirectPath) {
  return Astro.redirect(initialQueryState.redirectPath);
}

let productsResponse: PaginatedResponse<Product> | null = null;
let layoutData: LayoutData | null = null;

try {
  [layoutData, productsResponse] = await Promise.all([
    getLayoutData(),
    getAllProducts(initialQueryState.options),
  ]);
  setRuntimeImageCdnPolicy(layoutData?.media);
} catch (e: unknown) {
  console.error("Error fetching shop/search data:", e);
}

if (!layoutData || !productsResponse) {
  const response = storefrontDataUnavailableResponse(
    "We could not load the product list. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const facets = productsResponse.facets ?? [];
const queryState = resolveProductListQueryState({ url: Astro.url, facets, rankByRelevance: true });
if (queryState.redirectPath) return Astro.redirect(queryState.redirectPath);
const { query, currentFilters } = queryState;
const correctedQuery = productsResponse.correctedQuery ?? null;
const products = productsResponse.data;
const pagination = productsResponse.pagination;
if (isMissingProductListPage(pagination)) return new Response(null, { status: 404 });
const activeFilterCount = countActiveProductListFilters(currentFilters);
const refinements = activeFilterCount - (query ? 1 : 0);

// Nothing matched: help instead of a dead end (Baymard) with the store's
// popular products (or its newest, titled as such) and categories.
let suggestions: ProductRecommendations | null = null;
let categories: Category[] = [];
if (products.length === 0) {
  const [storeRecommendations, allCategories] = await Promise.all([
    getProductRecommendations([], 8).catch(() => null),
    getAllCategories().catch(() => null),
  ]);
  suggestions = storeRecommendations?.products.length ? storeRecommendations : null;
  categories = (allCategories ?? []).slice(0, 12);
}

const resultCountLabel = `${pagination.total} ${pagination.total === 1 ? "result" : "results"}`;
const pageTitle = `${query ? `Search results for "${query}"` : "All products"}${
  pagination.page > 1 ? ` – Page ${pagination.page}` : ""
}`;
const pageDescription = query
  ? `${resultCountLabel} for "${correctedQuery ?? query}".`
  : "Explore our full collection of products.";
// Internal search results are never indexed; the plain listing stays self-canonical.
const canonicalUrl = isIndexableProductListView(currentFilters)
  ? productListCanonicalUrl(buildAbsoluteStorefrontSeoUrl("/search"), pagination.page)
  : null;
const searchOnlyHref = buildProductListHref({ pathname: "/search", currentFilters: query ? { q: query } : {} });

const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;

// Include product name for richer analytics data
const analyticsProductData = products.map((p) => ({
  id: p.id,
  name: p.name,
  price: p.discountedPrice,
}));
---

<Layout
  title={pageTitle}
  description={pageDescription}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
  noindex
>
  <CatalogListingPage
    kind="search"
    data={{
      "data-search-query": query,
      "data-products-for-analytics": JSON.stringify(analyticsProductData),
    }}
    listing={{
      products,
      pagination,
      facets,
      priceRange: productsResponse.priceRange,
      queryState,
      pathname: "/search",
      resetPath: searchOnlyHref,
      searchLabel: "Search products",
      countEndpoint: "/products",
      currencySymbol,
      currencyCode,
      listingName: "all products",
    }}
  >
      <div slot="intro" class="mb-5 py-3 sm:mb-6 sm:py-4">
        <h1 class="text-2xl font-bold text-foreground sm:text-3xl">
          {query ? "Search results" : "All products"}
        </h1>
        {query && products.length > 0 && (
          <p class="mt-1.5 text-sm text-muted-foreground sm:text-base" aria-live="polite">
            {correctedQuery ? (
              <Fragment>
                No results for “{query}”. Showing{" "}
                <span class="font-semibold text-foreground">{resultCountLabel}</span> for{" "}
                <span class="font-semibold text-foreground">“{correctedQuery}”</span> instead.
              </Fragment>
            ) : (
              <Fragment>
                <span class="font-semibold text-foreground">{resultCountLabel}</span> for{" "}
                <span class="font-medium text-foreground">“{query}”</span>
              </Fragment>
            )}
          </p>
        )}
      </div>

        <div slot="empty" data-catalog-empty-state>
          <section class="rounded-xl border border-border bg-background px-5 py-8 sm:px-8">
            <h2 class="text-lg font-semibold text-foreground">
              {query ? `No results for “${query}”` : "No matching products"}
            </h2>
            <p class="mt-2 max-w-xl text-sm leading-6 text-muted-foreground">
              {refinements > 0
                ? "Try removing a filter or widening the price range."
                : query
                  ? "Check the spelling, use fewer words, or try a more general word."
                  : "This store does not have any products available yet."}
            </p>
            {refinements > 0 && (
              <a
                href={searchOnlyHref}
                class="mt-4 inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
              >
                {query ? `Show all results for “${query}”` : "Remove filters"}
              </a>
            )}
            {categories.length > 0 && (
              <nav aria-labelledby="search-browse-categories" class="mt-6">
                <h3 id="search-browse-categories" class="text-sm font-semibold text-foreground">Browse categories</h3>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {categories.map((category) => (
                    <li>
                      <a
                        href={`/categories/${category.slug}`}
                        class="inline-flex min-h-11 items-center rounded-full border border-border bg-background px-4 text-sm font-medium text-foreground transition-colors hover:bg-muted"
                      >
                        {category.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
          </section>
          {suggestions && (
            <section aria-labelledby="search-suggestions" class="mt-8">
              <div class="mb-4 flex items-baseline justify-between gap-4">
                <h2 id="search-suggestions" class="text-lg font-semibold text-foreground">{recommendationTitle(suggestions.reason)}</h2>
                <a href="/search" class="text-sm font-medium text-primary hover:underline">Browse all products</a>
              </div>
              <ProductGrid>
                {suggestions.products.map((product) => (
                  <ProductCard
                    product={product}
                    currencySymbol={currencySymbol}
                    currencyCode={currencyCode}
                    headingLevel="h3"
                  />
                ))}
              </ProductGrid>
            </section>
          )}
        </div>
  </CatalogListingPage>
</Layout>

<script>
  import { scheduleNonCriticalAnalytics } from "@/lib/non-critical-analytics";

  type ProductAnalyticsData = {
    id: string;
    name: string;
    price: number;
  };

  async function trackSearchResults() {
    const productListElement = document.querySelector<HTMLElement>(
      "[data-products-for-analytics]",
    );
    if (
      !productListElement ||
      productListElement.dataset.searchTracked === "true"
    )
      return;

    try {
      const productsData: ProductAnalyticsData[] = JSON.parse(
        productListElement.dataset.productsForAnalytics || "[]",
      );
      const searchQuery = productListElement.dataset.searchQuery || "";

      const { trackStorefrontSearchResults } = await import("@/lib/analytics");
      const tracked = trackStorefrontSearchResults({
        searchQuery,
        products: productsData,
        currency: window.__CURRENCY_CODE__ || "BDT",
      });

      if (tracked) productListElement.dataset.searchTracked = "true";
    } catch (error: unknown) {
      console.error("Failed to track search event:", error);
    }
  }

  const scheduleSearchResults = () => {
    scheduleNonCriticalAnalytics(() => void trackSearchResults());
  };
  document.addEventListener("DOMContentLoaded", scheduleSearchResults);
  document.addEventListener("astro:page-load", scheduleSearchResults);
</script>
