---
// src/pages/search/index.astro
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import CategoryFilters from "@/components/CategoryFilters";
import {
  getAllProducts,
  getFilterableAttributes,
  getLayoutData,
  type Product,
  type ProductListOptions,
  type PaginatedResponse,
  type FilterableAttribute,
  type LayoutData,
} from "@/lib/api";
import {
  SlidersHorizontal,
  X,
  ChevronLeft,
  ChevronRight,
  ArrowLeft,
  Search,
} from "lucide-react";
import { setRuntimeImageCdnPolicy } from "@/lib/api/runtime-env";
import {
  PRODUCT_LIST_NAVIGATION_PARAMS,
  buildProductListPaginationHref,
  hasDynamicProductListFilterParams,
  resolveProductListQueryState,
} from "@/lib/product-list-query";
import { buildAbsoluteStorefrontSeoUrl } from "@/lib/seo-base-url";
import { storefrontDataUnavailableResponse } from "@/lib/storefront-unavailable-response";

const params = Astro.url.searchParams;
const hasDynamicFilters = hasDynamicProductListFilterParams(params);
let queryState = resolveProductListQueryState({ url: Astro.url });
if (!hasDynamicFilters && queryState.redirectPath) {
  return Astro.redirect(queryState.redirectPath);
}
let query = queryState.query;
let sortBy = queryState.sortBy;
let currentFilters = queryState.currentFilters;

let productsResponse: PaginatedResponse<Product> | null = null;
let attributes: FilterableAttribute[] = [];
let layoutData: LayoutData | null = null;
let error: string | null = null;
let productListOptions: ProductListOptions = queryState.options;

try {
  const layoutPromise = getLayoutData();
  const attributesPromise = getFilterableAttributes({ searchQuery: query });

  if (hasDynamicFilters) {
    attributes = (await attributesPromise) || [];
    queryState = resolveProductListQueryState({
      url: Astro.url,
      attributes,
    });
    if (queryState.redirectPath) {
      void layoutPromise.catch((layoutError) => {
        console.error(
          "Layout fetch failed before search filter redirect:",
          layoutError,
        );
      });
      return Astro.redirect(queryState.redirectPath);
    }
    query = queryState.query;
    sortBy = queryState.sortBy;
    currentFilters = queryState.currentFilters;
    productListOptions = queryState.options;
    const productsPromise = getAllProducts(productListOptions);

    const [fetchedLayoutData, fetchedProducts] = await Promise.all([
      layoutPromise,
      productsPromise,
    ]);
    layoutData = fetchedLayoutData;
    setRuntimeImageCdnPolicy(layoutData?.media);
    productsResponse = fetchedProducts;
  } else {
    const productsPromise = getAllProducts(productListOptions);

    // Parallel fetch: layout + products + attributes
    const [fetchedLayoutData, fetchedProducts, fetchedAttributes] = await Promise.all([
      layoutPromise,
      productsPromise,
      attributesPromise,
    ]);
    layoutData = fetchedLayoutData;
    setRuntimeImageCdnPolicy(layoutData?.media);
    productsResponse = fetchedProducts;
    attributes = fetchedAttributes || [];
  }
} catch (e: unknown) {
  console.error("Error fetching shop/search data:", e);
  error = "An error occurred while fetching products. Please try again.";
}

if (!layoutData || !productsResponse) {
  const response = storefrontDataUnavailableResponse(
    "We could not load the product list. Please try again shortly.",
  );
  response.headers.set("X-Storefront-Data-State", "unavailable");
  return response;
}

const products = productsResponse?.data || [];
const pagination = productsResponse?.pagination || {
  total: 0,
  totalPages: 0,
  page: 1,
};

const pageTitle = query ? `Search results for "${query}"` : "Shop All Products";
const pageDescription = query
  ? `Found ${pagination.total} products for "${query}".`
  : "Explore our full collection of products.";
const productListPathname = Astro.url.pathname;
const canonicalFilterState = JSON.stringify(currentFilters);

function getPaginationUrl(pageNum: number) {
  return buildProductListPaginationHref({
    pathname: productListPathname,
    currentFilters,
    page: pageNum,
  });
}

function generatePaginationLinks(
  currentPage: number,
  totalPages: number
): (number | "...")[] {
  if (totalPages <= 7)
    return Array.from({ length: totalPages }, (_, i) => i + 1);
  if (currentPage <= 4) return [1, 2, 3, 4, 5, "...", totalPages];
  if (currentPage >= totalPages - 3)
    return [
      1,
      "...",
      totalPages - 4,
      totalPages - 3,
      totalPages - 2,
      totalPages - 1,
      totalPages,
    ];
  return [
    1,
    "...",
    currentPage - 1,
    currentPage,
    currentPage + 1,
    "...",
    totalPages,
  ];
}

const activeFilterCount = Object.keys(currentFilters).filter(
  (key) => !PRODUCT_LIST_NAVIGATION_PARAMS.includes(key as typeof PRODUCT_LIST_NAVIGATION_PARAMS[number]) && currentFilters[key]
).length;
const canonicalUrl = buildAbsoluteStorefrontSeoUrl("/search");
const shouldNoindexSearchPage = Boolean(query) || pagination.page > 1 || sortBy !== "newest" || activeFilterCount > 0;

import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;

// Include product name for richer analytics data
const analyticsProductData = products.map((p) => ({
  id: p.id,
  name: p.name,
  price: p.discountedPrice,
}));
---

<Layout
  title={pageTitle}
  description={pageDescription}
  layoutData={layoutData}
  canonicalUrl={canonicalUrl ?? undefined}
>
  {shouldNoindexSearchPage && <meta slot="head" name="robots" content="noindex,follow" />}
  <div
    class="min-h-screen bg-gray-50"
    data-search-query={query}
    data-products-for-analytics={JSON.stringify(analyticsProductData)}
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
      <div
        class="text-center mb-6 bg-white rounded-lg p-6 shadow-sm border border-gray-100"
      >
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900">
          {query ? "Search Results" : "Explore Our Products"}
        </h1>
        {
          query && (
            <p class="mt-2 text-base sm:text-lg text-gray-600">
              <span class="font-semibold text-primary">{pagination.total}</span>{" "}
              results for{" "}
              <span class="font-medium text-gray-800">"{query}"</span>
            </p>
          )
        }
      </div>

      <div class="flex flex-col lg:flex-row gap-6">
        <button
          id="mobile-filter-toggle"
          class="lg:hidden flex items-center justify-center gap-2 w-full py-3 px-4 bg-primary text-primary-foreground rounded-lg shadow-sm font-medium mb-4 relative"
        >
          <SlidersHorizontal className="w-4 h-4" />
          <span>Filters</span>
          {
            activeFilterCount > 0 && (
              <span class="absolute -top-1 -right-1 bg-destructive text-destructive-foreground text-xs rounded-full h-5 w-5 flex items-center justify-center">
                {activeFilterCount}
              </span>
            )
          }
        </button>

        <aside
          id="filter-section"
          class="fixed inset-0 bg-black/50 z-50 hidden lg:static lg:block lg:bg-transparent lg:z-auto lg:w-80 lg:shrink-0"
        >
          <div
            class="bg-white h-full w-4/5 max-w-sm lg:w-full flex flex-col lg:rounded-lg lg:shadow-sm lg:border lg:border-gray-100"
          >
            <div
              class="flex justify-between items-center lg:hidden p-4 border-b bg-white"
            >
              <h3 class="font-semibold text-lg">Filters</h3>
              <button
                id="mobile-filter-close"
                class="p-1 hover:bg-gray-100 rounded"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form
              id="filterForm"
              method="get"
              class="grow overflow-y-auto"
            >
              <input type="hidden" name="page" value="1" />
              <!-- Hidden sortBy field to maintain sort state -->
              <input type="hidden" name="sortBy" value={sortBy} />

              <div class="p-4 lg:p-6">
                <div class="relative mb-6">
                  <Search
                    className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400"
                  />
                  <input
                    type="search"
                    name="q"
                    placeholder="Search products..."
                    value={query}
                    class="w-full rounded-lg border-gray-300 pl-9 pr-4 py-2.5 text-sm focus:ring-2 focus:ring-primary focus:border-primary"
                  />
                </div>

                <CategoryFilters
                  client:load
                  attributes={attributes}
                  currentFilters={currentFilters}
                  priceRange={productsResponse.priceRange}
                />
              </div>
            </form>
          </div>
        </aside>

        <div class="flex-1 min-w-0">
          <div
            class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 p-4 bg-white rounded-lg shadow-sm border border-gray-100"
          >
            <p class="text-sm font-medium text-gray-700">
              Showing <span class="font-bold text-primary"
                >{products.length}</span
              > of{" "}
              <span class="font-bold text-primary">{pagination.total}</span> products
            </p>

            <div class="flex items-center gap-3">
              <label
                for="sortBy"
                class="text-sm font-medium text-gray-700 whitespace-nowrap"
              >
                Sort by:
              </label>
              <select
                id="sortBy"
                name="sortBy"
                data-list-pathname={productListPathname}
                data-current-filters={canonicalFilterState}
                class="rounded-lg border-gray-300 text-sm focus:ring-2 focus:ring-primary focus:border-primary min-w-[140px]"
              >
                <option value="newest" selected={sortBy === "newest"}>
                  Latest
                </option>
                <option value="price-asc" selected={sortBy === "price-asc"}>
                  Price: Low to High
                </option>
                <option value="price-desc" selected={sortBy === "price-desc"}>
                  Price: High to Low
                </option>
              </select>
            </div>
          </div>

          {
            error && (
              <div class="bg-destructive/10 border border-destructive/20 text-destructive p-4 rounded-lg mb-6">
                {error}
              </div>
            )
          }

          {
            products.length === 0 && !error && (
              <div class="flex flex-col items-center justify-center py-16 px-4 bg-white rounded-lg shadow-sm border border-gray-100 text-center">
                <Search className="w-16 h-16 text-gray-400 mb-4" />
                <h3 class="text-xl font-bold text-gray-900 mb-2">
                  No products found
                </h3>
                <p class="text-gray-500 mb-6 max-w-md">
                  Try adjusting your search terms or filters to find what you're
                  looking for.
                </p>
                <a
                  href="/search"
                  class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors"
                >
                  <ArrowLeft className="w-4 h-4" />
                  Reset All Filters
                </a>
              </div>
            )
          }

          {
            products.length > 0 && (
              <Fragment>
                <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 mb-8">
                  {products.map((product) => (
                    <ProductCard product={product} currencySymbol={currencySymbol} />
                  ))}
                </div>

                {pagination.totalPages > 1 && (
                  <nav
                    class="flex items-center justify-center mt-8 mb-20 lg:mb-8"
                    aria-label="Pagination"
                  >
                    <div class="flex items-center space-x-1 bg-white rounded-lg shadow-sm border border-gray-100 p-2">
                      <a
                        href={
                          pagination.page > 1
                            ? getPaginationUrl(pagination.page - 1)
                            : "#"
                        }
                        class:list={[
                          "inline-flex h-9 w-9 items-center justify-center rounded-md border text-sm transition-colors",
                          pagination.page > 1
                            ? "border-gray-200 hover:bg-gray-50 text-gray-700"
                            : "border-gray-100 text-gray-300 cursor-not-allowed",
                        ]}
                        aria-disabled={pagination.page <= 1}
                      >
                        <ChevronLeft className="h-4 w-4" />
                      </a>

                      {generatePaginationLinks(
                        pagination.page,
                        pagination.totalPages
                      ).map((pageNum) =>
                        typeof pageNum === "number" ? (
                          <a
                            href={getPaginationUrl(pageNum)}
                            class:list={[
                              "inline-flex h-9 min-w-9 items-center justify-center rounded-md border text-sm font-medium transition-colors",
                              pagination.page === pageNum
                                ? "border-primary bg-primary text-primary-foreground shadow-sm"
                                : "border-gray-200 hover:bg-gray-50 text-gray-700",
                            ]}
                            aria-current={
                              pagination.page === pageNum ? "page" : undefined
                            }
                          >
                            {pageNum}
                          </a>
                        ) : (
                          <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-gray-400">
                            ...
                          </span>
                        )
                      )}

                      <a
                        href={
                          pagination.page < pagination.totalPages
                            ? getPaginationUrl(pagination.page + 1)
                            : "#"
                        }
                        class:list={[
                          "inline-flex h-9 w-9 items-center justify-center rounded-md border text-sm transition-colors",
                          pagination.page < pagination.totalPages
                            ? "border-gray-200 hover:bg-gray-50 text-gray-700"
                            : "border-gray-100 text-gray-300 cursor-not-allowed",
                        ]}
                        aria-disabled={pagination.page >= pagination.totalPages}
                      >
                        <ChevronRight className="h-4 w-4" />
                      </a>
                    </div>
                  </nav>
                )}
              </Fragment>
            )
          }
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { buildProductListHref } from "@/lib/product-list-query";
  import { normalizeSearchQuery } from "@/lib/search-query";

  function readCanonicalFilters(select: HTMLSelectElement): Record<string, string> {
    try {
      const parsed = JSON.parse(select.dataset.currentFilters || "{}");
      if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return {};
      return Object.fromEntries(
        Object.entries(parsed).filter(
          ([, value]) => typeof value === "string",
        ),
      ) as Record<string, string>;
    } catch {
      return {};
    }
  }

  function setupFilterInteractivity() {
    const toggleBtn = document.getElementById("mobile-filter-toggle");
    const closeBtn = document.getElementById("mobile-filter-close");
    const filterSection = document.getElementById("filter-section");

    if (!filterSection || !toggleBtn || !closeBtn) return;

    const openFilters = () => {
      filterSection.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    };

    const closeFilters = () => {
      filterSection.classList.add("hidden");
      document.body.style.overflow = "";
    };

    toggleBtn.addEventListener("click", openFilters);
    closeBtn.addEventListener("click", closeFilters);

    filterSection.addEventListener("click", (e) => {
      if (e.target === filterSection) {
        closeFilters();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !filterSection.classList.contains("hidden")) {
        closeFilters();
      }
    });
  }

  function setupSortFunctionality() {
    // FIX: Safely get and type-check the select element
    const sortSelect = document.getElementById("sortBy");
    if (!(sortSelect instanceof HTMLSelectElement)) return;

    sortSelect.addEventListener("change", () => {
      const currentFilters = readCanonicalFilters(sortSelect);
      const query = normalizeSearchQuery(currentFilters.q);
      if (query) currentFilters.q = query;
      else delete currentFilters.q;

      window.location.href = buildProductListHref({
        pathname: sortSelect.dataset.listPathname || window.location.pathname,
        currentFilters,
        overrides: {
          sortBy: sortSelect.value,
          page: 1,
        },
      });
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    setupFilterInteractivity();
    setupSortFunctionality();
  });

  document.addEventListener("astro:page-load", () => {
    setupFilterInteractivity();
    setupSortFunctionality();
  });
</script>

<script>
  import { trackStorefrontSearchResults } from "@/lib/analytics";

  type ProductAnalyticsData = {
    id: string;
    name: string;
    price: number;
  };

  function trackSearchResults() {
    const productListElement = document.querySelector<HTMLElement>(
      "[data-products-for-analytics]"
    );
    if (!productListElement || productListElement.dataset.searchTracked === "true")
      return;

    try {
      const productsData: ProductAnalyticsData[] = JSON.parse(
        productListElement.dataset.productsForAnalytics || "[]"
      );
      const searchQuery = productListElement.dataset.searchQuery || "";

      const tracked = trackStorefrontSearchResults({
        searchQuery,
        products: productsData,
        currency: window.__CURRENCY_CODE__ || "BDT",
      });

      if (tracked) productListElement.dataset.searchTracked = "true";
    } catch (error: unknown) {
      console.error("Failed to track search event:", error);
    }
  }

  document.addEventListener("DOMContentLoaded", trackSearchResults);
  document.addEventListener("astro:page-load", trackSearchResults);
</script>
