---
import ErrorPageState from "@/components/ErrorPageState.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import ProductGrid from "@/components/cards/ProductGrid.astro";
import Layout from "@/layouts/Layout.astro";
import { getLayoutData, getProductRecommendations } from "@/lib/api";
import { getUrlRedirect } from "@/lib/api/navigation";
import { recommendationTitle } from "@/lib/recommendations";
import { serverPagePath } from "@/lib/server-presence";

// An old address (a renamed product's handle) leads to its new one: looked up
// here only, in the same read batch as the suggestions, so pages that exist
// never pay for it. Otherwise a way back into the catalog: the store's popular
// products, or its newest when there is not enough order history.
const [layoutData, suggestions, redirectTo] = await Promise.all([
  getLayoutData().catch(() => null),
  getProductRecommendations([], 4).catch(() => null),
  Astro.request.method === "GET" || Astro.request.method === "HEAD" ? getUrlRedirect(Astro.url.pathname) : Promise.resolve(null),
]);
if (redirectTo) {
  return Astro.redirect(`${serverPagePath(redirectTo)}${Astro.url.search}`, 301);
}
const products = suggestions?.products ?? [];
---

<Layout title="Page not found" noindex layoutData={layoutData}>
  <ErrorPageState
    code="404"
    title="Page not found"
    message="That link may be out of date. Continue shopping or search for what you need."
    primaryHref="/"
    primaryLabel="Continue shopping"
    secondaryHref="/search"
    secondaryLabel="Search products"
  />
  {suggestions && products.length > 0 && (
    <section aria-labelledby="not-found-suggestions" class="mx-auto w-full max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
      <h2 id="not-found-suggestions" class="mb-4 text-lg font-semibold text-foreground">
        {recommendationTitle(suggestions.reason)}
      </h2>
      <ProductGrid>
        {products.map((product) => (
          <ProductCard
            product={product}
            currencySymbol={layoutData?.currency?.symbol}
            currencyCode={layoutData?.currency?.code}
          />
        ))}
      </ProductGrid>
    </section>
  )}
</Layout>
