---
import ErrorPageState from "@/components/ErrorPageState.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found" noindex>
  <ErrorPageState
    code="404"
    title="Page not found"
    message="That link may be out of date. Continue shopping or search for what you need."
    primaryHref="/"
    primaryLabel="Continue shopping"
    secondaryHref="/search"
    secondaryLabel="Search products"
  />
</Layout>
