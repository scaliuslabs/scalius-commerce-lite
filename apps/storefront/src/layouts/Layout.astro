---
// src/layouts/Layout.astro
import { DEFAULT_STORE_TIME_ZONE } from "@scalius/shared/commerce-time";
import { storeRegion, storeTimeZone } from "@/lib/store-time-zone";
import { DEFAULT_STORE_REGION, textDirection } from "@scalius/shared/locale-format";
import "../styles/global.css";
import Header from "../components/header/header.astro";
import Footer from "../components/Footer.astro";
import SidebarNav from "../components/header/SidebarNav.astro";
import ThemeFonts from "../components/ThemeFonts.astro";
import ThemePreviewBar from "../components/ThemePreviewBar.astro";
import { getLayoutData, type LayoutData } from "@/lib/api";
import { resolveRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import { themePaint } from "@/lib/theme-paint";
import type { AnalyticsConfig } from "@/lib/api";
import { mediaImageUrl } from "@/lib/media-url";
import {
  getRuntimeApiUrl,
  getRuntimeDashboardUrl,
  getRuntimeMediaUrl,
  setRuntimeImageCdnPolicy,
} from "@/lib/api/runtime";
import {
  getAbsoluteStorefrontSeoBaseUrl,
  toAbsoluteStorefrontSeoUrl,
} from "@/lib/seo-base-url";
import {
  buildMerchantReturnPolicyJsonLd,
  buildOnlineStoreJsonLd,
} from "@/lib/commerce-structured-data";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { appServiceGlobals } from "@/lib/app-services";
import { themePreviewBridgeScript } from "@/lib/theme-preview-bridge";
import { showsThemePreviewBar, themePreviewBarCopy } from "@/lib/theme-preview-bar";
import { THEME_EDITOR_MARKS, themeEditorOrigin } from "@scalius/shared/theme-editor-bridge";
import {
  buildDocumentTitle,
  resolveStoreDisplayName,
  resolveStoreName,
  resolveStorePhone,
  resolveStoreShareImage,
  resolveStoreSocialLinks,
} from "@/lib/store-identity";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import { resolvePriceIncrementMinor } from "@scalius/shared/currency-policy";
import {
  appendClearThemePreviewCookies,
} from "@/lib/theme-preview-cookie";
import { requestBypassesPublicStorefrontCache } from "@/lib/cache-policy";
import { buildPrivateSessionPrefetchGuardScript } from "@/lib/private-session-prefetch-guard";
import { AD_CLICK_ID_SCRIPT, STALE_ASSET_RECOVERY_SCRIPT } from "@/lib/inline-boot-scripts";
import { optimizeAnalyticsScriptDelivery } from "@/lib/analytics-script-delivery";
import { appComponentsRenderOn, appScriptsForPage, storefrontAppPage } from "@/lib/app-scripts";
import { readStorefrontExtensions } from "@scalius/shared/plugins/storefront-components";
import { setExtensionPage } from "@/lib/extensions";
import { themeAppStylesheets } from "@/lib/extensions/stylesheets";
import {
  buildPartytownBootstrap,
  partytownForwardFor,
} from "@/lib/partytown-config";
import { partytownLoaderPath } from "virtual:scalius/partytown";
import { getRuntimePresence } from "@/lib/api/runtime";
import { defaultLocale, hreflangAlternates, marketOfPresence, presenceCountry, stripPresencePath } from "@scalius/shared/markets";
import { hasSeveralMarkets, hasSeveralPresences, languageOptions, pageMarket, selectedMarketCountry } from "@/lib/market-selector";
import LanguageSelector from "../components/markets/LanguageSelector.astro";
import MarketSelector from "../components/markets/MarketSelector.astro";
import MarketSuggestion from "../components/markets/MarketSuggestion.astro";
import type { LocalizedPaths } from "@/lib/localized-paths";
import type { HomepageHeaderLead } from "@/lib/homepage-sections";

interface Props {
  title: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  pageLead?: HomepageHeaderLead;
  /**
   * Keeps the `sidebar` navigation style's column off focused transactional
   * pages (order status, payment recovery). Pages without the header
   * (cart, checkout) never show it.
   */
  hideNavigationSidebar?: boolean;
  /** Pre-fetched layout data for parallel loading optimization */
  layoutData?: LayoutData | null;
  // SEO props — per CAN-01, CAN-02, OG-01 through OG-05, SEO-05, SEO-06
  canonicalUrl?: string;
  ogImage?: string;
  /** Share image used only when neither the page nor the store sets one. */
  fallbackOgImage?: string;
  ogType?: "website" | "product" | "article";
  ogPrice?: string;
  ogCurrency?: string;
  noindex?: boolean;
  documentLanguage?: string;
  /**
   * A page with localized URL handles (MARKETS-DESIGN D9): its path in each
   * language (`byLocale`) and its source path (`source`, every other
   * language), so each hreflang alternate names the page's own URL there.
   */
  localizedPaths?: LocalizedPaths | null;
  /**
   * False leaves the store's analytics and pixels off this page: a page
   * opened from a link that carries a token in its URL (the newsletter's
   * confirm and unsubscribe pages), so no third party reads the token.
   */
  analytics?: boolean;
  /** A private section-library document: no buyer chrome or actions. */
  libraryPreview?: boolean;
}

const {
  title,
  description = "",
  hideHeader = false,
  hideFooter = false,
  pageLead,
  hideNavigationSidebar = false,
  layoutData: providedLayoutData,
  canonicalUrl,
  ogImage,
  fallbackOgImage,
  ogType = "website",
  ogPrice,
  ogCurrency,
  noindex,
  documentLanguage = "en",
  localizedPaths = null,
  analytics = true,
  libraryPreview = false,
} = Astro.props;

// Use provided layout data when pages load it in parallel; otherwise fetch here.
const layoutData = providedLayoutData ?? (await getLayoutData());
setRuntimeImageCdnPolicy(layoutData?.media);

const {
  theme: storefrontTheme,
  resolved: resolvedTheme,
  layout: themeLayout,
  brand: themeBrand,
  previewToken: themePreviewToken,
  preview: themePreview,
  language: themeLanguage,
} = await resolveRequestTheme(Astro, layoutData);
const chromeCopy = storefrontCopy(themeLanguage).chrome;
const isThemePreview = themePreview !== null;
// The stylesheets of the apps the theme names (their slots and sections): immutable, cached files.
// None on a buyer's page, where app components never render.
const appStylesheets = appComponentsRenderOn(storefrontAppPage(Astro.url.pathname))
  ? themeAppStylesheets(storefrontTheme, readStorefrontExtensions(layoutData?.appExtensions))
  : [];
// The theme editor's bridge, only under a valid preview: buyers never get it.
const themeEditorBridge = isThemePreview && !libraryPreview
  ? themePreviewBridgeScript(themeEditorOrigin(getRuntimeDashboardUrl()))
  : "";
// The merchant browsing the storefront under a live preview is told so, and can leave it.
const themePreviewBar = showsThemePreviewBar(isThemePreview, Astro.request)
  ? themePreviewBarCopy(layoutData?.storefrontCopy?.languageCode)
  : null;
if (themePreviewToken) {
  Astro.response.headers.set(
    "Cache-Control",
    "private, no-cache, no-store, must-revalidate",
  );
  if (!themePreview) {
    appendClearThemePreviewCookies(Astro.response.headers);
  }
}

const analyticsScripts: AnalyticsConfig[] = isThemePreview || !analytics
  ? []
  : (layoutData?.analytics || []).map(optimizeAnalyticsScriptDelivery);
const tiktokPixelEnabled = analyticsScripts.some((script) => {
  const type = script.type.trim().toLowerCase();
  return (
    type === "tiktok_pixel" ||
    /(?:analytics\.tiktok\.com|TiktokAnalyticsObject|\bttq\.(?:load|page|track)\s*\()/i.test(
      script.config,
    )
  );
});
const navigationData = layoutData?.navigation || [];
// The theme's navigation source renders the menu, the category tree or both.
const categoryTree = layoutData?.categoryTree ?? null;
// The menu's column beside the content (computers) and the bottom tab bar
// (phones) both belong to the header, so pages without it show neither.
const showNavigationSidebar =
  !hideHeader &&
  !hideNavigationSidebar &&
  themeLayout.navigation === "sidebar" &&
  (navigationData.length > 0 || (categoryTree?.nodes.length ?? 0) > 0);
const showMobileTabs = !hideHeader && themeLayout.mobileNavigation === "tabs";

// The theme's brand images (the draft's under a preview): the tab icon, the
// header logo that also stands in for a missing share image and schema logo.
const brandLogoUrl = themeBrand.logo?.url ?? "";
const faviconUrl = themeBrand.favicon?.url
  ? mediaImageUrl(themeBrand.favicon.url, 160)
  : "/favicon.svg";

// --- SEO: store name, Organization JSON-LD, WebSite JSON-LD (per SEO-05, SEO-06) ---
const businessInfo = layoutData?.business;
// Schema identity comes only from Business settings; titles, the header,
// footer and Open Graph fall back to the Store URL host so they are never blank.
const storeSchemaName = resolveStoreName(businessInfo);
const storefrontUrl = getAbsoluteStorefrontSeoBaseUrl();
const storeDisplayName = resolveStoreDisplayName(businessInfo, storefrontUrl);
const documentTitle = buildDocumentTitle(title, storeDisplayName);
const storePhone = resolveStorePhone(businessInfo);
const storeSocial = resolveStoreSocialLinks(businessInfo?.socialLinks, storePhone);
// Markets (MARKETS-DESIGN D4): a page under a subfolder presence (`/en-in`)
// is in that presence's language; root pages keep today's language rule.
const marketPresence = getRuntimePresence();
const marketMatrix = layoutData?.markets ?? { markets: [] };
const presenceEntry = marketPresence ? marketOfPresence(marketMatrix, marketPresence) : null;
// Root pages: the store default language once the store sells at more than
// one URL (hreflang names it); a single-presence store keeps today's rule.
const pageLanguage = presenceEntry?.presence.locale
  ?? (hasSeveralPresences(marketMatrix) ? defaultLocale(marketMatrix) : null)
  ?? documentLanguage;
// App components draw after this, in the page's language; no app JSON-LD on a noindex page.
setExtensionPage(Astro.locals, { language: pageLanguage, storeName: storeDisplayName ?? "", noIndex: noindex === true });
// The page's country: the store's (the backup market's). Numbers and dates are
// written as there; Open Graph names the presence's country, else the store's.
const pageRegion = storeRegion();
const ogLocale = presenceEntry
  ? `${presenceEntry.presence.locale}_${presenceCountry(presenceEntry.presence.value) ?? pageRegion}`
  : `${pageLanguage}_${pageRegion}`;
// hreflang, the market selector and the geo suggestion exist only while the
// store sells at more than one URL, so a single-presence store's HTML is unchanged.
const severalPresences = hasSeveralPresences(marketMatrix);
const canonicalLocation = canonicalUrl ? new URL(canonicalUrl) : null;
const hreflangLinks = severalPresences && canonicalLocation && storefrontUrl && !noindex && !isThemePreview
  ? hreflangAlternates(
    marketMatrix,
    `${stripPresencePath(canonicalLocation.pathname, marketPresence)}${canonicalLocation.search}`,
    storefrontUrl,
    localizedPaths ? (locale) => localizedPaths.byLocale[locale] ?? localizedPaths.source : undefined,
  )
  : [];
const marketReturnTo = `${stripPresencePath(Astro.url.pathname, marketPresence)}${Astro.url.search}`;
// The footer's localization forms (Dawn): country/region with more than one
// market, language when the page's market has two languages (`/bn`).
const currentMarket = severalPresences ? pageMarket(marketMatrix, marketPresence) : null;
const languageMarket = currentMarket && languageOptions(currentMarket).length > 1 ? currentMarket : null;
const languageCountry = languageMarket ? selectedMarketCountry(marketMatrix, marketPresence) : null;
// The site's own URL in WebSite JSON-LD: the presence's home on a presence page.
const siteUrl = storefrontUrl && marketPresence ? `${storefrontUrl}/${marketPresence}` : storefrontUrl;
const merchantReturnPolicyJsonLd = buildMerchantReturnPolicyJsonLd({
  settings: layoutData?.seo?.returnPolicy,
  storefrontUrl,
  fallbackCountry: businessInfo?.country,
});

// Organization JSON-LD — only emit when we have a logo (per SEO-05): the theme's logo.
const logoUrl = brandLogoUrl
  ? toAbsoluteStorefrontSeoUrl(mediaImageUrl(brandLogoUrl, 480))
  : null;

const onlineStoreJsonLd =
  storefrontUrl && logoUrl
    ? buildOnlineStoreJsonLd({
        storefrontUrl,
        logoUrl,
        business: businessInfo,
        social: storeSocial,
        returnPolicy: merchantReturnPolicyJsonLd,
      })
    : null;
const orgJsonLd = onlineStoreJsonLd
  ? serializeJsonForInlineScript(onlineStoreJsonLd)
  : null;

// WebSite JSON-LD with SearchAction for Google Sitelinks Search Box (per SEO-06)
const websiteJsonLd =
  siteUrl && storeSchemaName
    ? serializeJsonForInlineScript({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: storeSchemaName,
        url: siteUrl,
        potentialAction: {
          "@type": "SearchAction",
          target: {
            "@type": "EntryPoint",
            urlTemplate: `${siteUrl}/search?q={search_term_string}`,
          },
          "query-input": "required name=search_term_string",
        },
      })
    : null;

// Every page shares an image: its own, else the store social image from
// Preferences, else the page's fallback (first banner/content image), else
// the theme's logo.
const socialImage = layoutData?.seo?.socialImage;
const absoluteOgImageUrl = toAbsoluteStorefrontSeoUrl(
  ogImage ||
    (socialImage ? resolveStoreShareImage({ socialImage }) : null) ||
    fallbackOgImage ||
    resolveStoreShareImage({ logo: brandLogoUrl }) ||
    undefined,
);

const currencySymbol = layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol;
const currencyCode = layoutData?.currency?.code ?? DEFAULT_CURRENCY.code;
const currencyDecimalPlaces =
  layoutData?.currency?.decimalPlaces ?? DEFAULT_CURRENCY.decimalPlaces;
// The store's price increment: client pricing rounds percentage prices to it as checkout does.
const currencyPriceIncrement = resolvePriceIncrementMinor(currencyCode, layoutData?.currency?.priceIncrementMinor);

// CSS comes only from shared enum constants and schema-validated hex colours
// (plus the fluid grid steps derived from the density constants, widened for
// portrait photos). Body data attributes carry the tokens CSS selects on.
// The theme editor's paint route returns the same three for an unsaved document.
const paint = themePaint(storefrontTheme, resolvedTheme);
const storefrontRouteKind = Astro.url.pathname.startsWith("/products/")
  ? "product"
  : "standard";

// Partytown loads only when an enabled script actually runs in it.
const partytownBootstrap = analyticsScripts.some((script) => script.usePartytown)
  ? buildPartytownBootstrap(
      partytownForwardFor(analyticsScripts),
      partytownLoaderPath,
    )
  : null;

const headScripts = analyticsScripts.filter(
  (script) => script.location === "head",
);
const bodyStartScripts = analyticsScripts.filter(
  (script) => script.location === "body_start",
);
const bodyEndScripts = analyticsScripts.filter(
  (script) => script.location === "body_end",
);
// Approved scripts of active apps that name this kind of page (or "all"):
// async from their https URLs, never inline or in Partytown. The middleware
// adds their origins to this page's CSP from the same two inputs. A theme
// preview, like analytics, loads none.
const appScripts = isThemePreview
  ? []
  : appScriptsForPage(layoutData?.appScripts, storefrontAppPage(Astro.url.pathname));
const appHeadScripts = appScripts.filter((script) => script.placement === "head");
const appBodyScripts = appScripts.filter((script) => script.placement === "body-end");

// Public API and media origins come from the per-request context seeded by
// the middleware from the layout payload. No Worker vars, no build-time values.
const publicApiUrl = getRuntimeApiUrl() ?? "";
const mediaSettings = layoutData?.media;
// Dashboard media settings own the canonical CDN; the platform media URL is
// the fallback when the merchant has not configured one.
const configuredCdnBase =
  mediaSettings?.canonicalCdnUrl?.trim() || getRuntimeMediaUrl() || "";
const cdnDomainUrl = configuredCdnBase
  .replace(/^https?:\/\//, "")
  .replace(/\/$/, "");
const imageCdnAliases = (mediaSettings?.canonicalHostAliases ?? [])
  .map((host) =>
    host
      .replace(/^https?:\/\//, "")
      .replace(/\/$/, "")
      .toLowerCase(),
  )
  .filter(Boolean);

const apiOrigin = publicApiUrl ? new URL(publicApiUrl).origin : null;
const cdnDomain = cdnDomainUrl || null;
// Runtime API URL, CDN domain, and currency for client-side JS (the
// per-request platform context is not available to Vite client bundles).
const runtimeGlobalsScript = [
  `window.__API_BASE_URL__=${serializeJsonForInlineScript(publicApiUrl)};`,
  `window.__CDN_DOMAIN__=${serializeJsonForInlineScript(cdnDomainUrl || "")};`,
  `window.__IMAGE_CDN_BASE_URL__=${serializeJsonForInlineScript(cdnDomainUrl || "")};`,
  `window.__IMAGE_CDN_CANONICAL_HOST_ALIASES__=${serializeJsonForInlineScript(imageCdnAliases)};`,
  `window.__CURRENCY_SYMBOL__=${serializeJsonForInlineScript(currencySymbol)};`,
  `window.__CURRENCY_CODE__=${serializeJsonForInlineScript(currencyCode)};`,
  `window.__CURRENCY_DECIMAL_PLACES__=${serializeJsonForInlineScript(currencyDecimalPlaces)};`,
  `window.__CURRENCY_PRICE_INCREMENT__=${serializeJsonForInlineScript(currencyPriceIncrement)};`,
  `window.__META_CAPI_BROWSER_EVENTS_ENABLED__=${serializeJsonForInlineScript(!isThemePreview && analytics && layoutData?.metaCapi?.browserEventsEnabled === true)};`,
  `window.__TIKTOK_PIXEL_ENABLED__=${serializeJsonForInlineScript(tiktokPixelEnabled)};`,
  // Buyer services of active apps: written only when an app provides one, so a
  // store without apps ships none of this and the islands stay unloaded.
  ...appServiceGlobals(layoutData?.appServices),
].join("");
const privateSessionPrefetchGuardScript =
  buildPrivateSessionPrefetchGuardScript(
    requestBypassesPublicStorefrontCache(Astro.request.headers),
  );
const reactRefreshPreamble = import.meta.env.DEV
  ? `import RefreshRuntime from "/@react-refresh";
if (!window.$RefreshReg$) {
  RefreshRuntime.injectIntoGlobalHook(window);
  window.$RefreshReg$ = () => {};
  window.$RefreshSig$ = () => (type) => type;
}`
  : "";
// Browser scripts format buyer dates in the store's zone (lib/store-time-zone);
// the default zone needs no attribute.
const pageStoreTimeZone = storeTimeZone();
---

<!doctype html>
<html
  data-library-preview={libraryPreview ? "" : undefined}
  lang={pageLanguage}
  dir={textDirection(pageLanguage) === "rtl" ? "rtl" : undefined}
  data-market-presence={marketPresence ?? undefined}
  data-store-region={pageRegion === DEFAULT_STORE_REGION ? undefined : pageRegion}
  data-store-time-zone={pageStoreTimeZone === DEFAULT_STORE_TIME_ZONE ? undefined : pageStoreTimeZone}
  data-theme-preview={isThemePreview ? "true" : undefined}
  data-mobile-nav={showMobileTabs ? "tabs" : undefined}
>
  <head>
    <meta charset="UTF-8" />

    {/* Preconnect: warm up DNS + TLS for API and CDN origins early */}
    {apiOrigin && <link rel="dns-prefetch" href={apiOrigin} />}
    {/* Public pages do not call the API during their critical render. Keep DNS
        warm without opening an otherwise unused connection ahead of LCP. */}
    {cdnDomain && <link rel="dns-prefetch" href={`https://${cdnDomain}`} />}
    {
      cdnDomain && (
        <link rel="preconnect" href={`https://${cdnDomain}`} crossorigin />
      )
    }

    {/* Resource hints must precede large inline paint CSS so their requests can
        overlap the rest of the streamed HTML. Keep metadata in the normal head
        slot below. */}
    <slot name="preload" />

    {/* The Style's self-hosted fonts: the heading's Latin face preloads after
        the page's LCP image hints; every face swaps over a metric-matched
        fallback, so text never shifts. */}
    <ThemeFonts fonts={paint.fonts} preview={isThemePreview} />

    {/* Without JavaScript the phone menu and search buttons and the drawers'
        close buttons do nothing; each renders a <noscript> link in its place
        (the drawer's :target, /search, "#"), so the dead buttons are hidden
        instead of shown twice. Astro never evaluates expressions inside
        <style>, so this rule stays static. */}
    <noscript><style is:inline>#mobile-menu-toggle,#mobile-search-toggle,[data-drawer-close]{display:none!important}</style></noscript>

    <script is:inline set:html={runtimeGlobalsScript} />
    {partytownBootstrap && <script is:inline set:html={partytownBootstrap} />}

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}

    {/* Canonical URL — per CAN-01, CAN-02 */}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {/* Localized versions: every active presence and x-default (only with several presences). */}
    {hreflangLinks.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}

    {/* Open Graph tags — per OG-01 through OG-05 */}
    {storeDisplayName && <meta property="og:site_name" content={storeDisplayName} />}
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      absoluteOgImageUrl && (
        <meta property="og:image" content={absoluteOgImageUrl} />
      )
    }
    {absoluteOgImageUrl && <meta property="og:image:alt" content={title} />}
    {ogPrice && <meta property="og:price:amount" content={ogPrice} />}
    {ogCurrency && <meta property="og:price:currency" content={ogCurrency} />}

    {/* Twitter Card — per OG-04 */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {
      absoluteOgImageUrl && (
        <meta name="twitter:image" content={absoluteOgImageUrl} />
      )
    }
    {absoluteOgImageUrl && <meta name="twitter:image:alt" content={title} />}

    {
      /* Robots — public pages can be excluded from indexing while links remain crawlable. */
    }
    {
      (noindex || isThemePreview) && (
        <meta name="robots" content="noindex,follow" />
      )
    }

    {headScripts.map((script) => <Fragment set:html={script.config} />)}
    {appHeadScripts.map((script) => <script is:inline async src={script.src} data-app-script={script.pluginId}></script>)}

    <style set:html={paint.css} data-theme-tokens={isThemePreview ? "" : undefined} />
    {appStylesheets.map((href) => <link rel="stylesheet" href={href} data-app-stylesheet />)}

    <slot name="head" />
  </head>
  <body
    class="flex flex-col min-h-screen site-root"
    {...paint.attributes}
    data-storefront-route={storefrontRouteKind}
  >
    {bodyStartScripts.map((script) => <Fragment set:html={script.config} />)}

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:inset-s-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-background focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-foreground focus:shadow-lg"
    >
      {chromeCopy.skipToContent}
    </a>

    {themePreviewBar && <ThemePreviewBar copy={themePreviewBar} />}
    {severalPresences && !isThemePreview && <MarketSuggestion language={pageLanguage} returnTo={marketReturnTo} />}

    <div class="site-wrapper grow">
      {
        !hideHeader && (
          <Header
            pageLead={pageLead}
            navigation={navigationData}
            categoryTree={categoryTree}
            storeName={storeDisplayName}
            storePhone={storePhone}
            social={storeSocial}
            variant={themeLayout.header}
            navigationStyle={themeLayout.navigation}
            mobileNavigation={showMobileTabs ? "tabs" : "drawer"}
          />
        )
      }
      {/* With the sidebar, <main> is the content column: full-bleed sections
          span the column, never the sidebar. */}
      <div class="site-shell" data-site-shell={showNavigationSidebar ? "sidebar" : undefined}>
        {showNavigationSidebar && <SidebarNav navigation={navigationData} categoryTree={categoryTree} />}
        <main id="main-content" tabindex="-1" class="w-full h-full mb-3 focus:outline-none">
          <slot />
        </main>
      </div>
    </div>

    {
      !hideFooter && (
        <div data-theme-section-id={isThemePreview ? THEME_EDITOR_MARKS.footer : undefined}>
          <Footer
            menus={layoutData?.footerMenus ?? []}
            storeName={storeDisplayName}
            storePhone={storePhone}
            social={storeSocial}
            policies={layoutData?.policies ?? []}
            variant={themeLayout.footer}
            business={businessInfo}
            languageCode={layoutData?.storefrontCopy?.languageCode}
          />
          {hasSeveralMarkets(marketMatrix) && (
            <MarketSelector
              matrix={marketMatrix}
              presence={marketPresence}
              currencyCode={layoutData?.currency?.shopCode ?? currencyCode}
              language={pageLanguage}
              returnTo={marketReturnTo}
            />
          )}
          {languageMarket && languageCountry && (
            <LanguageSelector
              market={languageMarket}
              presence={marketPresence}
              country={languageCountry}
              language={pageLanguage}
              returnTo={marketReturnTo}
            />
          )}
        </div>
      )
    }

    {/* Google accepts JSON-LD in body. Keep it in initial SSR HTML while
        placing machine-only bytes after buyer-visible content. */}
    {
      orgJsonLd && (
        <script is:inline type="application/ld+json" set:html={orgJsonLd} />
      )
    }
    {
      websiteJsonLd && (
        <script is:inline type="application/ld+json" set:html={websiteJsonLd} />
      )
    }

    {/* These scripts must precede deferred Astro modules and DOMContentLoaded,
        but keeping them after visible HTML lets the parser discover the buyer
        UI first. The guard is installed before click IDs can create a private
        session signal. */}
    <script is:inline set:html={privateSessionPrefetchGuardScript} />
    {!libraryPreview && <script is:inline set:html={AD_CLICK_ID_SCRIPT} />}

    {/* Stale-asset recovery, installed before deferred module execution. */}
    <script is:inline set:html={STALE_ASSET_RECOVERY_SCRIPT} />

    {bodyEndScripts.map((script) => <Fragment set:html={script.config} />)}
    {appBodyScripts.map((script) => <script is:inline async src={script.src} data-app-script={script.pluginId}></script>)}

    {themeEditorBridge && <script is:inline set:html={themeEditorBridge} />}

    {
      reactRefreshPreamble && (
        <script is:inline type="module" set:html={reactRefreshPreamble} />
      )
    }

    <script>
      import { installLazyGlobalUi } from "@/scripts/lazy-global-ui";
      import { installStorefrontActions } from "@/scripts/storefront-actions";
      import { installStorefrontChrome } from "@/scripts/storefront-chrome";
      if (!document.documentElement.hasAttribute("data-library-preview")) {
        installLazyGlobalUi();
        installStorefrontActions();
        installStorefrontChrome();
      }
    </script>
  </body>
</html>

