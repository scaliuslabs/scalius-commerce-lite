---
// Star Tech's compare: each spec card's "Add to Compare" link toggles the
// product in a list kept in this browser (at most four; the oldest leaves),
// and a floating "Compare (n)" link opens /compare with them. Without
// JavaScript every "Add to Compare" is a plain link to the comparison of
// that product. Rendered by each card that offers Compare and by the
// compare page; Astro ships the script once per page.
---

<script>
  const KEY = "scalius:compare";
  const MAX = 4;
  const ID = /^[A-Za-z0-9_-]{1,80}$/;

  function read(): string[] {
    try {
      const value = JSON.parse(localStorage.getItem(KEY) ?? "[]");
      return Array.isArray(value) ? value.filter((id) => typeof id === "string" && ID.test(id)).slice(-MAX) : [];
    } catch {
      return [];
    }
  }

  function write(ids: string[]) {
    try {
      localStorage.setItem(KEY, JSON.stringify(ids));
    } catch {
      // Private mode: the list lives for this page only.
    }
  }

  let ids = read();
  let tray: HTMLAnchorElement | null = null;

  function sync() {
    for (const toggle of document.querySelectorAll<HTMLAnchorElement>("[data-compare-toggle]")) {
      const on = ids.includes(toggle.dataset.compareToggle ?? "");
      toggle.setAttribute("aria-pressed", String(on));
      const label = toggle.querySelector("[data-compare-label]");
      if (label) label.textContent = on ? "Added to Compare" : "Add to Compare";
    }
    if (ids.length === 0 || location.pathname === "/compare") {
      tray?.remove();
      tray = null;
      return;
    }
    if (!tray) {
      tray = document.createElement("a");
      tray.className = "compare-tray";
      tray.rel = "nofollow";
      document.body.append(tray);
    }
    tray.href = `/compare?ids=${ids.map(encodeURIComponent).join(",")}`;
    tray.textContent = `Compare (${ids.length})`;
  }

  // The comparison page's own list becomes the tray's list.
  if (location.pathname === "/compare") {
    const shown = (new URLSearchParams(location.search).get("ids") ?? "")
      .split(",").map((id) => id.trim()).filter((id) => ID.test(id)).slice(0, MAX);
    ids = [...new Set(shown)];
    write(ids);
  }

  document.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const toggle = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("[data-compare-toggle]") : null;
    const id = toggle?.dataset.compareToggle;
    if (!id || !ID.test(id)) return;
    event.preventDefault();
    ids = ids.includes(id) ? ids.filter((each) => each !== id) : [...ids, id].slice(-MAX);
    write(ids);
    sync();
  });

  addEventListener("storage", (event) => {
    if (event.key !== KEY) return;
    ids = read();
    sync();
  });

  sync();
</script>

<style is:global>
  .compare-tray {
    position: fixed;
    right: 1rem;
    /* Above a phone's bottom tab bar (56-61px). */
    bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.125rem;
    border-radius: 0.375rem;
    background: var(--foreground);
    color: var(--background);
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: 0 6px 20px color-mix(in oklab, var(--foreground) 30%, transparent);
  }

  @media (min-width: 64rem) {
    .compare-tray {
      bottom: 1.5rem;
    }
  }

  .compare-tray:focus-visible {
    outline: 3px solid var(--ring);
    outline-offset: 2px;
  }
</style>
