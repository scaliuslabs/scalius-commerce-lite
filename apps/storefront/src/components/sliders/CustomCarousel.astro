---
// Optimized carousel component for best performance and LCP
import { heroImageCandidate, type StorefrontHeroLayout } from "@/lib/homepage-hero";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import {
  HERO_SLIDE_DEFAULT_FOCAL_POINT,
  HERO_SLIDE_PRESENTATION,
  getHeroSlideObjectPosition,
  type HeroSlide,
} from "@scalius/shared/hero-slider";

interface Props {
  images: HeroSlide[];
  height: number;
  type: "desktop" | "mobile";
  autoRotate?: boolean;
  interval?: number;
  /** The first slide is the page's LCP (high fetch priority, sync decode). */
  priority?: boolean;
  /** The hero layout the banner sits in (its image `sizes`). */
  layout?: StorefrontHeroLayout;
  /**
   * The frame's CSS height when it is not the fixed `height` in px: a
   * full-bleed or full-screen hero follows the viewport (vw / svh values
   * that never change after the first paint, so nothing shifts).
   */
  frameHeight?: string;
  /** Rounded corners (a contained banner); edge-to-edge heroes are square. */
  rounded?: boolean;
}

// Slides advance every 6 s (WCAG 2.2.2 needs a pause control, provided below).
const {
  images,
  height,
  type,
  autoRotate = true,
  interval = 6000,
  priority = true,
  layout = "contained-banners",
  frameHeight,
  rounded = true,
} = Astro.props;
const corner = rounded ? " rounded-xl" : "";
const canRotate = autoRotate && images.length > 1;
const presentation = HERO_SLIDE_PRESENTATION[type];
const transparentPixel =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==";

// Ensure we have at least one image
if (images.length === 0) return;
---

<div
  class={`${type}-carousel relative w-full overflow-hidden${corner}`}
  style={`height: ${frameHeight ?? `${height}px`};`}
  role="region"
  aria-roledescription="carousel"
  aria-label="Featured"
  data-carousel-type={type}
  data-auto-rotate={canRotate}
  data-interval={interval}
>
  <div class="carousel-container relative w-full h-full">
    {/* Slides */}
    <div class="slides-container w-full h-full relative">
      {
        images.map((image: Props["images"][0], index: number) => {
          const SlideFrame = image.link ? "a" : "div";
          const isExternal = image.link?.startsWith("https://");
          // Alt text describes the artwork; heading and button are optional overlay copy.
          const headline = image.heading?.trim();
          const buttonLabel = image.link ? image.buttonLabel?.trim() : "";
          const focalPoint = image.focalPoint ?? HERO_SLIDE_DEFAULT_FOCAL_POINT;
          // Every rendition with the rendered width, built by the same helper
          // as the LCP preload in pages/index.astro, so the browser picks one
          // candidate for both. The <source> media keeps the other viewport's
          // banner (display:none) from downloading at all.
          const candidate = heroImageCandidate(image.url, type, layout);
          const source = candidate.srcset ?? candidate.src;
          return (
            <div
              class={`slide absolute inset-0 transition-opacity duration-500 ${index === 0 ? "opacity-100" : "opacity-0 pointer-events-none"}`}
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${images.length}`}
              aria-hidden={index === 0 ? undefined : "true"}
              inert={index === 0 ? undefined : true}
              data-slide-index={index}
            >
              <SlideFrame
                href={image.link || undefined}
                data-astro-prefetch={getStorefrontPrefetchAttribute(image.link, Astro.url)}
                class={`slide-link group relative block h-full w-full${corner} ${image.link ? "cursor-pointer" : "cursor-default"}`}
                aria-label={image.link && !headline && !image.title ? `Slide ${index + 1}` : undefined}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
              >
                <picture class="block h-full w-full">
                  <source
                    media={candidate.media}
                    srcset={index === 0 ? source : undefined}
                    data-srcset={index === 0 ? undefined : source}
                    sizes={candidate.srcset ? candidate.sizes : undefined}
                  />
                  <img
                    src={transparentPixel}
                    alt={image.title}
                    width={presentation.width}
                    height={height}
                    class="h-full w-full object-cover"
                    style={`object-position: ${getHeroSlideObjectPosition(focalPoint)};`}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 && priority ? "high" : "auto"}
                    decoding={index === 0 && priority ? "sync" : "async"}
                  />
                </picture>

                {(headline || buttonLabel) && (
                  <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/80 via-black/55 to-transparent px-5 pb-12 pt-20 text-white md:px-10 md:pb-14">
                    {headline && <p class="max-w-xl text-xl font-bold leading-tight [text-shadow:0_1px_3px_rgb(0_0_0/0.6)] md:text-4xl">{headline}</p>}
                    {buttonLabel && (
                      <span class="mt-3 inline-flex min-h-11 items-center rounded-full bg-white px-5 text-sm font-semibold text-neutral-900 transition-transform group-hover:scale-[1.03]">
                        {buttonLabel}
                      </span>
                    )}
                  </div>
                )}
              </SlideFrame>
            </div>
          );
        })
      }
    </div>

    {
      canRotate && (
        <button
          type="button"
          class="absolute bottom-0 right-2 z-20 flex h-11 w-11 items-center justify-center rounded-full text-white"
          aria-label="Pause slideshow"
          data-carousel-pause
        >
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-black/50">
            <svg data-icon-pause viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z" /></svg>
            <svg data-icon-play viewBox="0 0 24 24" class="hidden h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          </span>
        </button>
      )
    }

    {/* Navigation dots - Enhanced visibility */}
    {
      images.length > 1 && (
        <div class="absolute bottom-0 left-1/2 z-10 flex -translate-x-1/2">
          {images.map((_: Props["images"][0], index: number) => (
            <button
              type="button"
              class="group flex h-11 w-11 items-center justify-center rounded-full"
              aria-label={`Go to slide ${index + 1}`}
              aria-current={index === 0 ? "true" : undefined}
              data-nav-index={index}
            >
              <span
                data-nav-indicator
                class={`block h-3 w-3 rounded-full transition-all ${
                  index === 0
                    ? "bg-white scale-110 ring-2 ring-white/30"
                    : "bg-white/70 group-hover:bg-white group-hover:scale-110"
                } shadow-[0_0_5px_rgba(0,0,0,0.5)] group-hover:shadow-[0_0_8px_rgba(255,255,255,0.5)]`}
              />
            </button>
          ))}
        </div>
      )
    }

    {/* Arrows on wider screens; phones swipe or use the dots, so nothing covers the headline. */}
    {
      images.length > 1 && (
        <>
          <button
            type="button"
            class="nav-button absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 hidden md:flex items-center justify-center rounded-full bg-background/85 text-foreground z-10 hover:bg-background transition-colors shadow-lg backdrop-blur-sm"
            aria-label="Previous slide"
            data-nav="prev"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 19.5L8.25 12l7.5-7.5"
              />
            </svg>
          </button>
          <button
            type="button"
            class="nav-button absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 hidden md:flex items-center justify-center rounded-full bg-background/85 text-foreground z-10 hover:bg-background transition-colors shadow-lg backdrop-blur-sm"
            aria-label="Next slide"
            data-nav="next"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.25 4.5l7.5 7.5-7.5 7.5"
              />
            </svg>
          </button>
        </>
      )
    }
  </div>
</div>

<script>
  // Encapsulate script in an IIFE to avoid polluting the global scope
  (() => {
    class CarouselController {
      carousel: HTMLElement;
      slides: HTMLElement[];
      navDots!: HTMLElement[];
      currentIndex: number = 0;
      autoRotate: boolean;
      interval: number;
      timer: ReturnType<typeof setInterval> | null = null;
      initialTimer: ReturnType<typeof setTimeout> | null = null;
      warmTimer: ReturnType<typeof setTimeout> | null = null;
      resizeObserver: ResizeObserver | null = null;
      slideLoads = new Map<number, Promise<void>>();
      disposed: boolean = false;
      isHovering: boolean = false;
      hasFocus: boolean = false;
      isPaused: boolean = false;
      pauseButton: HTMLButtonElement | null = null;
      touchStartX: number = 0;
      touchEndX: number = 0;
      isSwiping: boolean = false;
      isTransitioning: boolean = false; // Flag to prevent rapid transitions
      transitionDuration: number = 500; // Match this with CSS transition duration

      constructor(carousel: HTMLElement) {
        this.carousel = carousel;
        this.autoRotate =
          carousel.dataset.autoRotate === "true" &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        this.interval = parseInt(carousel.dataset.interval || "3000");

        // Get all slides
        this.slides = Array.from(
          carousel.querySelectorAll("[data-slide-index]"),
        );
        if (this.slides.length <= 1) return; // No need for controls with only one slide

        // Get navigation dots
        this.navDots = Array.from(
          carousel.querySelectorAll("[data-nav-index]"),
        );

        this.initEventListeners();

        if (this.autoRotate && "ResizeObserver" in window) {
          this.resizeObserver = new ResizeObserver(() => {
            this.syncAutoRotation();
          });
          this.resizeObserver.observe(this.carousel);
        }
        this.syncAutoRotation();
      }

      initEventListeners() {
        // Navigation dot clicks
        this.navDots.forEach((dot, index) => {
          dot.addEventListener("click", (e) => {
            e.preventDefault();
            if (!this.isTransitioning) {
              void this.goToSlide(index);
            }
          });
        });

        // Previous/Next buttons
        const prevButton = this.carousel.querySelector('[data-nav="prev"]');
        const nextButton = this.carousel.querySelector('[data-nav="next"]');

        if (prevButton) {
          prevButton.addEventListener("click", (e) => {
            e.preventDefault();
            if (!this.isTransitioning) {
              void this.goToPrevSlide();
            }
          });
        }

        if (nextButton) {
          nextButton.addEventListener("click", (e) => {
            e.preventDefault();
            if (!this.isTransitioning) {
              void this.goToNextSlide();
            }
          });
        }

        // Buyer-controlled pause (WCAG 2.2.2); focus inside also pauses.
        this.pauseButton = this.carousel.querySelector<HTMLButtonElement>(
          "[data-carousel-pause]",
        );
        this.pauseButton?.addEventListener("click", () => {
          this.isPaused = !this.isPaused;
          this.pauseButton!.setAttribute(
            "aria-label",
            this.isPaused ? "Play slideshow" : "Pause slideshow",
          );
          this.pauseButton!
            .querySelector("[data-icon-pause]")
            ?.classList.toggle("hidden", this.isPaused);
          this.pauseButton!
            .querySelector("[data-icon-play]")
            ?.classList.toggle("hidden", !this.isPaused);
          this.syncAutoRotation();
        });
        this.carousel.addEventListener("focusin", () => {
          this.hasFocus = true;
          this.stopAutoRotation();
        });
        this.carousel.addEventListener("focusout", (event) => {
          if (this.carousel.contains(event.relatedTarget as Node | null)) return;
          this.hasFocus = false;
          this.syncAutoRotation();
        });

        // Pause auto-rotation on hover
        this.carousel.addEventListener("mouseenter", () => {
          this.isHovering = true;
          this.stopAutoRotation();
        });

        this.carousel.addEventListener("mouseleave", () => {
          this.isHovering = false;
          this.syncAutoRotation();
        });

        // Touch events for swipe functionality
        this.carousel.addEventListener(
          "touchstart",
          (e) => {
            if (this.isTransitioning) return;

            this.touchStartX = e.changedTouches[0].screenX;
            this.isSwiping = true;

            // Pause auto-rotation during swipe
            this.stopAutoRotation();
          },
          { passive: true },
        );

        this.carousel.addEventListener(
          "touchmove",
          (e) => {
            if (!this.isSwiping) return;
            this.touchEndX = e.changedTouches[0].screenX;
          },
          { passive: true },
        );

        this.carousel.addEventListener(
          "touchend",
          () => {
            if (!this.isSwiping || this.isTransitioning) return;

            const swipeDistance = this.touchEndX - this.touchStartX;
            const threshold = 50; // Minimum swipe distance

            if (swipeDistance > threshold) {
              // Swipe right - go to previous slide
              void this.goToPrevSlide();
            } else if (swipeDistance < -threshold) {
              // Swipe left - go to next slide
              void this.goToNextSlide();
            }

            this.isSwiping = false;

            // Resume auto-rotation after swipe
            this.syncAutoRotation();
          },
          { passive: true },
        );

        // Listen for transition end to reset the transition flag
        this.slides.forEach((slide) => {
          slide.addEventListener("transitionend", () => {
            if (slide.classList.contains("opacity-100")) {
              this.isTransitioning = false;
            }
          });
        });
      }

      startAutoRotation() {
        this.stopAutoRotation();
        if (
          this.disposed ||
          !this.autoRotate ||
          this.isPaused ||
          this.hasFocus ||
          this.isHovering ||
          this.isSwiping ||
          !this.isVisible()
        )
          return;

        this.scheduleNextWarm();

        const rotate = () => {
          if (!this.isHovering && !this.isSwiping && !this.isTransitioning) {
            void this.goToNextSlide();
          }
        };
        // Give the first campaign enough reading time and keep the initial page
        // visually stable while Core Web Vitals settle.
        this.initialTimer = setTimeout(() => {
          this.initialTimer = null;
          rotate();
          if (!this.disposed) this.timer = setInterval(rotate, this.interval);
        }, Math.max(8_000, this.interval));
      }

      stopAutoRotation() {
        if (this.timer) clearInterval(this.timer);
        if (this.initialTimer) clearTimeout(this.initialTimer);
        if (this.warmTimer) clearTimeout(this.warmTimer);
        this.timer = null;
        this.initialTimer = null;
        this.warmTimer = null;
      }

      syncAutoRotation() {
        if (
          this.autoRotate &&
          !this.isPaused &&
          !this.hasFocus &&
          this.isVisible() &&
          !this.isHovering &&
          !this.isSwiping
        ) {
          if (!this.timer && !this.initialTimer) this.startAutoRotation();
        } else {
          this.stopAutoRotation();
        }
      }

      isVisible() {
        return (
          this.carousel.getClientRects().length > 0 &&
          this.carousel.clientWidth > 0
        );
      }

      scheduleNextWarm() {
        if (this.warmTimer) clearTimeout(this.warmTimer);
        if (this.disposed || !this.isVisible()) return;
        // The first slide remains visible for at least eight seconds. Keep the
        // hidden follow-up request out of the critical load window while still
        // leaving enough time for a seamless automatic transition.
        const delay = Math.max(6_000, this.interval - 2_000);
        this.warmTimer = setTimeout(() => {
          this.warmTimer = null;
          const nextIndex = (this.currentIndex + 1) % this.slides.length;
          void this.prepareSlide(nextIndex);
        }, delay);
      }

      async prepareSlide(index: number) {
        const existingLoad = this.slideLoads.get(index);
        if (existingLoad) return existingLoad;
        const slide = this.slides[index];
        const source = slide?.querySelector<HTMLSourceElement>(
          "source[data-srcset]",
        );
        const nextSource = source?.dataset.srcset;
        if (!source || !nextSource) return;
        const image = slide.querySelector<HTMLImageElement>("img");
        if (!image) return;

        const pendingLoad = new Promise<void>((resolve) => {
          let settled = false;
          let timeout: ReturnType<typeof setTimeout> | null = null;
          const finish = () => {
            if (settled) return;
            settled = true;
            if (timeout) clearTimeout(timeout);
            image.removeEventListener("load", finish);
            image.removeEventListener("error", finish);
            resolve();
          };
          image.addEventListener("load", finish, { once: true });
          image.addEventListener("error", finish, { once: true });
          source.srcset = nextSource;
          delete source.dataset.srcset;
          image.loading = "eager";
          if (image.complete && image.naturalWidth > 1) finish();
          if (!settled) timeout = setTimeout(finish, 5000);
        });
        this.slideLoads.set(index, pendingLoad);
        await pendingLoad;
      }

      async goToSlide(index: number) {
        // Don't do anything if we're trying to go to the current slide
        if (index === this.currentIndex || this.isTransitioning) return;

        // Set transitioning flag
        this.isTransitioning = true;
        await this.prepareSlide(index);
        if (this.disposed || !this.isVisible()) {
          this.isTransitioning = false;
          return;
        }

        // Hide current slide; hidden slides leave the tab order (WCAG 2.4.3).
        const previousSlide = this.slides[this.currentIndex];
        previousSlide.classList.remove("opacity-100");
        previousSlide.classList.add("opacity-0", "pointer-events-none");
        previousSlide.inert = true;
        previousSlide.setAttribute("aria-hidden", "true");

        // Update nav dots
        if (this.navDots[this.currentIndex]) {
          const currentDot = this.navDots[this.currentIndex];
          const currentIndicator = currentDot.querySelector(
            "[data-nav-indicator]",
          );
          currentDot.removeAttribute("aria-current");
          currentIndicator?.classList.remove(
            "bg-white",
            "scale-110",
            "ring-2",
            "ring-white/30",
          );
          currentIndicator?.classList.add("bg-white/70");
        }

        // Show new slide
        this.currentIndex = index;
        const nextSlide = this.slides[this.currentIndex];
        nextSlide.classList.remove("opacity-0", "pointer-events-none");
        nextSlide.classList.add("opacity-100");
        nextSlide.inert = false;
        nextSlide.removeAttribute("aria-hidden");

        // Update nav dots
        if (this.navDots[this.currentIndex]) {
          const nextDot = this.navDots[this.currentIndex];
          const nextIndicator = nextDot.querySelector("[data-nav-indicator]");
          nextDot.setAttribute("aria-current", "true");
          nextIndicator?.classList.remove("bg-white/70");
          nextIndicator?.classList.add(
            "bg-white",
            "scale-110",
            "ring-2",
            "ring-white/30",
          );
        }

        this.scheduleNextWarm();

        // Set a fallback timeout to reset the transition flag in case the transitionend event doesn't fire
        setTimeout(() => {
          this.isTransitioning = false;
        }, this.transitionDuration + 50);
      }

      async goToNextSlide() {
        const nextIndex = (this.currentIndex + 1) % this.slides.length;
        await this.goToSlide(nextIndex);
      }

      async goToPrevSlide() {
        const prevIndex =
          (this.currentIndex - 1 + this.slides.length) % this.slides.length;
        await this.goToSlide(prevIndex);
      }

      dispose() {
        this.disposed = true;
        this.stopAutoRotation();
        this.resizeObserver?.disconnect();
        this.resizeObserver = null;
      }
    }

    type CarouselElement = HTMLElement & {
      __carouselController?: CarouselController;
    };
    type CarouselDocument = Document & {
      __scaliusCarouselLifecycleBound?: boolean;
    };

    // Initialize carousels immediately
    const initCarousels = () => {
      const carousels = document.querySelectorAll("[data-carousel-type]");
      carousels.forEach((carousel) => {
        if (carousel instanceof HTMLElement) {
          const carouselElement = carousel as CarouselElement;
          // Prevent re-initialization
          if (!carouselElement.__carouselController) {
            carouselElement.__carouselController = new CarouselController(
              carousel,
            );
          }
        }
      });
    };

    const carouselDocument = document as CarouselDocument;
    if (!carouselDocument.__scaliusCarouselLifecycleBound) {
      carouselDocument.__scaliusCarouselLifecycleBound = true;
      if (document.readyState !== "loading") {
        initCarousels();
      } else {
        document.addEventListener("DOMContentLoaded", initCarousels, {
          once: true,
        });
      }
      document.addEventListener("astro:page-load", initCarousels);
      document.addEventListener("astro:before-swap", () => {
        document
          .querySelectorAll<CarouselElement>("[data-carousel-type]")
          .forEach((carousel) => {
            carousel.__carouselController?.dispose();
            delete carousel.__carouselController;
          });
      });
    } else {
      initCarousels();
    }
  })();
</script>

<style>
  /* Ensure smooth transitions */
  .slide {
    will-change: opacity;
    transition: opacity 0.5s ease;
  }

  /* Prevent layout shifts */
  .carousel-container {
    contain: layout;
  }

  /* Fix for jumpy navigation buttons */
  .nav-button {
    transform: translateY(-50%);
    opacity: 0.95;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
    box-shadow:
      0 0 10px rgba(0, 0, 0, 0.2),
      0 0 5px rgba(255, 255, 255, 0.1);
  }

  .nav-button:hover {
    opacity: 1;
  }

  /* The dot buttons keep a 44px hit area (WCAG 2.5.8) that stays invisible:
     only the dot itself is drawn, with its own shadow for contrast. */
  [data-nav-index] {
    background: transparent;
    box-shadow: none;
  }

  /* The slide link fills a rounded overflow-hidden frame, so an outside ring
     would be clipped away (WCAG 2.4.7). Draw it inside instead: a white ring
     at the edge plus a dark inner ring, visible on any photo. Outlines and
     the ::after layer paint above the image; an inset box-shadow would not. */
  /* Scoped through the carousel root: the slide frame is a dynamic a/div tag. */
  [data-carousel-type] :global(.slide-link:focus-visible) {
    outline: 2px solid #fff;
    outline-offset: -2px;
  }

  [data-carousel-type] :global(.slide-link:focus-visible::after) {
    content: "";
    position: absolute;
    inset: 2px;
    z-index: 1;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px rgb(0 0 0 / 0.85);
    pointer-events: none;
  }
</style>
