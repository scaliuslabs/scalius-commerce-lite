---
// Optimized carousel component for best performance and LCP
import { getOptimizedImageUrl } from "@/lib/image-optimizer";
import {
  HERO_SLIDE_DEFAULT_FOCAL_POINT,
  HERO_SLIDE_PRESENTATION,
  getHeroSlideImageTransform,
  getHeroSlideObjectPosition,
  type HeroSlideFocalPoint,
} from "@scalius/shared/hero-slider";

interface Props {
  images: {
    url: string;
    title?: string;
    link: string;
    id?: string;
    focalPoint?: HeroSlideFocalPoint;
  }[];
  height: number;
  type: "desktop" | "mobile";
  autoRotate?: boolean;
  interval?: number;
}

const {
  images,
  height,
  type,
  autoRotate = true,
  interval = 3000,
} = Astro.props;
const presentation = HERO_SLIDE_PRESENTATION[type];
const viewportMedia =
  type === "desktop" ? "(min-width: 768px)" : "(max-width: 767px)";
const transparentPixel =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==";

// Ensure we have at least one image
if (images.length === 0) return;
---

<div
  class={`${type}-carousel relative w-full overflow-hidden rounded-xl`}
  style={`height: ${height}px;`}
  data-carousel-type={type}
  data-auto-rotate={autoRotate}
  data-interval={interval}
>
  <div class="carousel-container relative w-full h-full">
    {/* Slides */}
    <div class="slides-container w-full h-full relative">
      {
        images.map((image: Props["images"][0], index: number) => {
          const SlideFrame = image.link ? "a" : "div";
          const isExternal = image.link?.startsWith("https://");
          const focalPoint = image.focalPoint ?? HERO_SLIDE_DEFAULT_FOCAL_POINT;
          const source = getOptimizedImageUrl(image.url, {
            ...getHeroSlideImageTransform(type, focalPoint, {
              quality: index === 0 ? (type === "desktop" ? 90 : 85) : 80,
            }),
          });
          return (
            <div
              class={`slide absolute inset-0 transition-opacity duration-500 ${index === 0 ? "opacity-100" : "opacity-0 pointer-events-none"}`}
              data-slide-index={index}
            >
              <SlideFrame
                href={image.link || undefined}
                class={`slide-link group block h-full w-full ${image.link ? "cursor-pointer" : "cursor-default"}`}
                aria-label={
                  image.link ? image.title || `Slide ${index + 1}` : undefined
                }
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
              >
                <picture class="block h-full w-full">
                  <source
                    media={viewportMedia}
                    srcset={index === 0 ? source : undefined}
                    data-srcset={index === 0 ? undefined : source}
                  />
                  <img
                    src={transparentPixel}
                    alt={image.title || `Slide ${index + 1}`}
                    width={presentation.width}
                    height={height}
                    class="h-full w-full object-cover"
                    style={`object-position: ${getHeroSlideObjectPosition(focalPoint)};`}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding={index === 0 ? "sync" : "async"}
                  />
                </picture>

                {image.link && (
                  <div class="absolute inset-0 bg-black/0 transition-colors duration-300 group-hover:bg-black/20" />
                )}
              </SlideFrame>
            </div>
          );
        })
      }
    </div>

    {/* Navigation dots - Enhanced visibility */}
    {
      images.length > 1 && (
        <div class="absolute bottom-0 left-0 right-0 flex justify-center z-10">
          {images.map((_: Props["images"][0], index: number) => (
            <button
              type="button"
              class="group flex h-11 w-11 items-center justify-center rounded-full"
              aria-label={`Go to slide ${index + 1}`}
              aria-current={index === 0 ? "true" : undefined}
              data-nav-index={index}
            >
              <span
                data-nav-indicator
                class={`block h-3 w-3 rounded-full transition-all ${
                  index === 0
                    ? "bg-white scale-110 ring-2 ring-white/30"
                    : "bg-white/70 group-hover:bg-white group-hover:scale-110"
                } shadow-[0_0_5px_rgba(0,0,0,0.5)] group-hover:shadow-[0_0_8px_rgba(255,255,255,0.5)]`}
              />
            </button>
          ))}
        </div>
      )
    }

    {/* Navigation arrows - Fixed for both desktop and mobile */}
    {
      images.length > 1 && (
        <>
          <button
            type="button"
            class="nav-button absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-white/80 text-gray-800 z-10 hover:bg-white transition-colors shadow-lg backdrop-blur-sm border border-white/20"
            aria-label="Previous slide"
            data-nav="prev"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 19.5L8.25 12l7.5-7.5"
              />
            </svg>
          </button>
          <button
            type="button"
            class="nav-button absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-white/80 text-gray-800 z-10 hover:bg-white transition-colors shadow-lg backdrop-blur-sm border border-white/20"
            aria-label="Next slide"
            data-nav="next"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.25 4.5l7.5 7.5-7.5 7.5"
              />
            </svg>
          </button>
        </>
      )
    }
  </div>
</div>

<script>
  // Encapsulate script in an IIFE to avoid polluting the global scope
  (() => {
    class CarouselController {
      carousel: HTMLElement;
      slides: HTMLElement[];
      navDots!: HTMLElement[];
      currentIndex: number = 0;
      autoRotate: boolean;
      interval: number;
      timer: ReturnType<typeof setInterval> | null = null;
      initialTimer: ReturnType<typeof setTimeout> | null = null;
      warmTimer: ReturnType<typeof setTimeout> | null = null;
      resizeObserver: ResizeObserver | null = null;
      slideLoads = new Map<number, Promise<void>>();
      disposed: boolean = false;
      isHovering: boolean = false;
      touchStartX: number = 0;
      touchEndX: number = 0;
      isSwiping: boolean = false;
      isTransitioning: boolean = false; // Flag to prevent rapid transitions
      transitionDuration: number = 500; // Match this with CSS transition duration

      constructor(carousel: HTMLElement) {
        this.carousel = carousel;
        this.autoRotate =
          carousel.dataset.autoRotate === "true" &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        this.interval = parseInt(carousel.dataset.interval || "3000");

        // Get all slides
        this.slides = Array.from(
          carousel.querySelectorAll("[data-slide-index]"),
        );
        if (this.slides.length <= 1) return; // No need for controls with only one slide

        // Get navigation dots
        this.navDots = Array.from(
          carousel.querySelectorAll("[data-nav-index]"),
        );

        this.initEventListeners();

        if (this.autoRotate && "ResizeObserver" in window) {
          this.resizeObserver = new ResizeObserver(() => {
            this.syncAutoRotation();
          });
          this.resizeObserver.observe(this.carousel);
        }
        this.syncAutoRotation();
      }

      initEventListeners() {
        // Navigation dot clicks
        this.navDots.forEach((dot, index) => {
          dot.addEventListener("click", (e) => {
            e.preventDefault();
            if (!this.isTransitioning) {
              void this.goToSlide(index);
            }
          });
        });

        // Previous/Next buttons
        const prevButton = this.carousel.querySelector('[data-nav="prev"]');
        const nextButton = this.carousel.querySelector('[data-nav="next"]');

        if (prevButton) {
          prevButton.addEventListener("click", (e) => {
            e.preventDefault();
            if (!this.isTransitioning) {
              void this.goToPrevSlide();
            }
          });
        }

        if (nextButton) {
          nextButton.addEventListener("click", (e) => {
            e.preventDefault();
            if (!this.isTransitioning) {
              void this.goToNextSlide();
            }
          });
        }

        // Pause auto-rotation on hover
        this.carousel.addEventListener("mouseenter", () => {
          this.isHovering = true;
          this.stopAutoRotation();
        });

        this.carousel.addEventListener("mouseleave", () => {
          this.isHovering = false;
          this.syncAutoRotation();
        });

        // Touch events for swipe functionality
        this.carousel.addEventListener(
          "touchstart",
          (e) => {
            if (this.isTransitioning) return;

            this.touchStartX = e.changedTouches[0].screenX;
            this.isSwiping = true;

            // Pause auto-rotation during swipe
            this.stopAutoRotation();
          },
          { passive: true },
        );

        this.carousel.addEventListener(
          "touchmove",
          (e) => {
            if (!this.isSwiping) return;
            this.touchEndX = e.changedTouches[0].screenX;
          },
          { passive: true },
        );

        this.carousel.addEventListener(
          "touchend",
          () => {
            if (!this.isSwiping || this.isTransitioning) return;

            const swipeDistance = this.touchEndX - this.touchStartX;
            const threshold = 50; // Minimum swipe distance

            if (swipeDistance > threshold) {
              // Swipe right - go to previous slide
              void this.goToPrevSlide();
            } else if (swipeDistance < -threshold) {
              // Swipe left - go to next slide
              void this.goToNextSlide();
            }

            this.isSwiping = false;

            // Resume auto-rotation after swipe
            this.syncAutoRotation();
          },
          { passive: true },
        );

        // Listen for transition end to reset the transition flag
        this.slides.forEach((slide) => {
          slide.addEventListener("transitionend", () => {
            if (slide.classList.contains("opacity-100")) {
              this.isTransitioning = false;
            }
          });
        });
      }

      startAutoRotation() {
        this.stopAutoRotation();
        if (
          this.disposed ||
          !this.autoRotate ||
          this.isHovering ||
          this.isSwiping ||
          !this.isVisible()
        )
          return;

        this.scheduleNextWarm();

        const rotate = () => {
          if (!this.isHovering && !this.isSwiping && !this.isTransitioning) {
            void this.goToNextSlide();
          }
        };
        // Give the first campaign enough reading time and keep the initial page
        // visually stable while Core Web Vitals settle.
        this.initialTimer = setTimeout(() => {
          this.initialTimer = null;
          rotate();
          if (!this.disposed) this.timer = setInterval(rotate, this.interval);
        }, Math.max(8_000, this.interval));
      }

      stopAutoRotation() {
        if (this.timer) clearInterval(this.timer);
        if (this.initialTimer) clearTimeout(this.initialTimer);
        if (this.warmTimer) clearTimeout(this.warmTimer);
        this.timer = null;
        this.initialTimer = null;
        this.warmTimer = null;
      }

      syncAutoRotation() {
        if (
          this.autoRotate &&
          this.isVisible() &&
          !this.isHovering &&
          !this.isSwiping
        ) {
          if (!this.timer && !this.initialTimer) this.startAutoRotation();
        } else {
          this.stopAutoRotation();
        }
      }

      isVisible() {
        return (
          this.carousel.getClientRects().length > 0 &&
          this.carousel.clientWidth > 0
        );
      }

      scheduleNextWarm() {
        if (this.warmTimer) clearTimeout(this.warmTimer);
        if (this.disposed || !this.isVisible()) return;
        const delay = Math.max(250, this.interval - 1000);
        this.warmTimer = setTimeout(() => {
          this.warmTimer = null;
          const nextIndex = (this.currentIndex + 1) % this.slides.length;
          void this.prepareSlide(nextIndex);
        }, delay);
      }

      async prepareSlide(index: number) {
        const existingLoad = this.slideLoads.get(index);
        if (existingLoad) return existingLoad;
        const slide = this.slides[index];
        const source = slide?.querySelector<HTMLSourceElement>(
          "source[data-srcset]",
        );
        const nextSource = source?.dataset.srcset;
        if (!source || !nextSource) return;
        const image = slide.querySelector<HTMLImageElement>("img");
        if (!image) return;

        const pendingLoad = new Promise<void>((resolve) => {
          let settled = false;
          let timeout: ReturnType<typeof setTimeout> | null = null;
          const finish = () => {
            if (settled) return;
            settled = true;
            if (timeout) clearTimeout(timeout);
            image.removeEventListener("load", finish);
            image.removeEventListener("error", finish);
            resolve();
          };
          image.addEventListener("load", finish, { once: true });
          image.addEventListener("error", finish, { once: true });
          source.srcset = nextSource;
          delete source.dataset.srcset;
          image.loading = "eager";
          if (image.complete && image.naturalWidth > 1) finish();
          if (!settled) timeout = setTimeout(finish, 5000);
        });
        this.slideLoads.set(index, pendingLoad);
        await pendingLoad;
      }

      async goToSlide(index: number) {
        // Don't do anything if we're trying to go to the current slide
        if (index === this.currentIndex || this.isTransitioning) return;

        // Set transitioning flag
        this.isTransitioning = true;
        await this.prepareSlide(index);
        if (this.disposed || !this.isVisible()) {
          this.isTransitioning = false;
          return;
        }

        // Hide current slide
        this.slides[this.currentIndex].classList.remove("opacity-100");
        this.slides[this.currentIndex].classList.add(
          "opacity-0",
          "pointer-events-none",
        );

        // Update nav dots
        if (this.navDots[this.currentIndex]) {
          const currentDot = this.navDots[this.currentIndex];
          const currentIndicator = currentDot.querySelector(
            "[data-nav-indicator]",
          );
          currentDot.removeAttribute("aria-current");
          currentIndicator?.classList.remove(
            "bg-white",
            "scale-110",
            "ring-2",
            "ring-white/30",
          );
          currentIndicator?.classList.add("bg-white/70");
        }

        // Show new slide
        this.currentIndex = index;
        this.slides[this.currentIndex].classList.remove(
          "opacity-0",
          "pointer-events-none",
        );
        this.slides[this.currentIndex].classList.add("opacity-100");

        // Update nav dots
        if (this.navDots[this.currentIndex]) {
          const nextDot = this.navDots[this.currentIndex];
          const nextIndicator = nextDot.querySelector("[data-nav-indicator]");
          nextDot.setAttribute("aria-current", "true");
          nextIndicator?.classList.remove("bg-white/70");
          nextIndicator?.classList.add(
            "bg-white",
            "scale-110",
            "ring-2",
            "ring-white/30",
          );
        }

        this.scheduleNextWarm();

        // Set a fallback timeout to reset the transition flag in case the transitionend event doesn't fire
        setTimeout(() => {
          this.isTransitioning = false;
        }, this.transitionDuration + 50);
      }

      async goToNextSlide() {
        const nextIndex = (this.currentIndex + 1) % this.slides.length;
        await this.goToSlide(nextIndex);
      }

      async goToPrevSlide() {
        const prevIndex =
          (this.currentIndex - 1 + this.slides.length) % this.slides.length;
        await this.goToSlide(prevIndex);
      }

      dispose() {
        this.disposed = true;
        this.stopAutoRotation();
        this.resizeObserver?.disconnect();
        this.resizeObserver = null;
      }
    }

    type CarouselElement = HTMLElement & {
      __carouselController?: CarouselController;
    };
    type CarouselDocument = Document & {
      __scaliusCarouselLifecycleBound?: boolean;
    };

    // Initialize carousels immediately
    const initCarousels = () => {
      const carousels = document.querySelectorAll("[data-carousel-type]");
      carousels.forEach((carousel) => {
        if (carousel instanceof HTMLElement) {
          const carouselElement = carousel as CarouselElement;
          // Prevent re-initialization
          if (!carouselElement.__carouselController) {
            carouselElement.__carouselController = new CarouselController(
              carousel,
            );
          }
        }
      });
    };

    const carouselDocument = document as CarouselDocument;
    if (!carouselDocument.__scaliusCarouselLifecycleBound) {
      carouselDocument.__scaliusCarouselLifecycleBound = true;
      if (document.readyState !== "loading") {
        initCarousels();
      } else {
        document.addEventListener("DOMContentLoaded", initCarousels, {
          once: true,
        });
      }
      document.addEventListener("astro:page-load", initCarousels);
      document.addEventListener("astro:before-swap", () => {
        document
          .querySelectorAll<CarouselElement>("[data-carousel-type]")
          .forEach((carousel) => {
            carousel.__carouselController?.dispose();
            delete carousel.__carouselController;
          });
      });
    } else {
      initCarousels();
    }
  })();
</script>

<style>
  /* Ensure smooth transitions */
  .slide {
    will-change: opacity;
    transition: opacity 0.5s ease;
  }

  /* Prevent layout shifts */
  .carousel-container {
    contain: layout;
  }

  /* Fix for jumpy navigation buttons */
  .nav-button {
    transform: translateY(-50%);
    opacity: 0.95;
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
    box-shadow:
      0 0 10px rgba(0, 0, 0, 0.2),
      0 0 5px rgba(255, 255, 255, 0.1);
  }

  .nav-button:hover {
    opacity: 1;
  }

  /* Ensure buttons are visible on all backgrounds */
  [data-nav-index] {
    box-shadow:
      0 0 5px rgba(0, 0, 0, 0.3),
      0 0 3px rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
  }

  /* Enhance title visibility */
  .slide-link h2 {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
  }
</style>
