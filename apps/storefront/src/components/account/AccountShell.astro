---
// The one account layout, after Shopify's customer accounts: a top nav
// (Orders, Profile, Inbox and the sections the account uses) with Sign out at
// its end, then the page heading and the page. Every account page renders
// through it at one width, so switching pages never moves the nav. Signed out,
// it shows only the sign-in prompt; unreachable, a retry. Colours, radius and
// fonts come from the active theme's tokens.
//
// Sign out is a plain POST (works without JavaScript); with it, the browser's
// cart and checkout state are cleared first (shared devices).
import { ACCOUNT_CONTAINER, accountUi as ui } from "@/lib/account-ui";
import { accountNavTabs, type AccountSection, type AccountSummary } from "@/lib/account-tabs";
import { getLayoutData } from "@/lib/api";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { continueWithLabel, readSignInApps, signInAppHref, signInErrorMessage, signInLanguage } from "@/lib/sign-in-apps";
import { accountCopy } from "@/lib/account-copy";

export interface Props {
  current: AccountSection;
  /** A bounded account task, never applied to signed-out/error pages. */
  layout?: "page" | "workspace";
  summary: AccountSummary | null;
  state?: "ok" | "signed_out" | "unavailable";
  /** The page heading; omit when the page renders its own. */
  title?: string | null;
  intro?: string | null;
  back?: { href: string; label: string } | null;
  signedOut?: { title: string; body?: string | null; action?: string };
  unavailable?: { text: string; retryHref: string; retryText?: string };
}

// The page's language: the layout read has run by the time the shell renders.
const words = accountCopy().shell;
const {
  current,
  layout = "page",
  summary,
  state = "ok",
  title = null,
  intro = null,
  back = null,
  signedOut = { title: words.signInTitle, body: words.signInBody },
  unavailable = { text: words.unavailable, retryHref: "/account" },
} = Astro.props;
// What the store offers keeps Reviews and Downloads in the strip on every account page.
const storeFacts = await currentRequestTheme(Astro.locals).then(({ resolved }) => resolved.facts).catch(() => null);
const tabs = accountNavTabs(current, summary, {
  hasReviews: storeFacts?.hasReviews === true,
  hasDigitalLines: storeFacts?.hasDigitalLines === true,
});
const workspace = layout === "workspace" && state === "ok";
// Signed out: "Continue with <app>" for each sign-in app (plain links, no JavaScript needed),
// and the fixed message a failed attempt came back with. The layout is read once per request.
const signedOutLayout = state === "signed_out" ? await getLayoutData().catch(() => null) : null;
const signInWords = signInLanguage(signedOutLayout?.storefrontCopy?.languageCode);
const signInAppList = readSignInApps(signedOutLayout?.appServices?.signIn);
const signInError = state === "signed_out" ? signInErrorMessage(Astro.url.searchParams.get("sign_in_error"), signInWords) : null;
const tab = "relative inline-flex min-h-12 shrink-0 items-center gap-2 whitespace-nowrap px-3 text-sm font-medium transition-colors after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:rounded-full";
---

<div class={workspace ? "mx-auto flex w-full max-w-5xl flex-col px-4 pb-4 pt-3 sm:px-6" : ACCOUNT_CONTAINER} data-account-shell data-account-state={state} data-account-workspace={workspace ? "true" : undefined}>
  {state !== "signed_out" && (
    <nav aria-label={words.nav} class={workspace ? "mb-3 shrink-0 border-b border-border" : "mb-6 border-b border-border sm:mb-8"}>
      <div class="-mx-4 flex items-center overflow-x-auto px-4 [scrollbar-width:none] sm:mx-0 sm:px-0 [&::-webkit-scrollbar]:hidden" data-account-nav>
        {tabs.map((item) => (
          <a
            href={item.href}
            aria-current={item.key === current ? "page" : undefined}
            data-astro-prefetch="false"
            class:list={[tab, item.key === current ? "text-foreground after:bg-primary" : "text-muted-foreground after:bg-transparent hover:text-foreground"]}
          >
            {item.label}
            {item.badge && (
              <span class="inline-flex min-w-5 items-center justify-center rounded-full bg-primary px-1.5 text-xs font-semibold tabular-nums text-primary-foreground">{item.badge}<span class="sr-only"> {item.badgeLabel}</span></span>
            )}
          </a>
        ))}
        <form method="post" action="/api/auth/logout" class="ms-auto shrink-0 ps-2" data-account-sign-out>
          <button type="submit" class="inline-flex min-h-12 items-center gap-2 whitespace-nowrap px-3 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            {words.signOut}
          </button>
        </form>
      </div>
    </nav>
  )}

  {state === "signed_out" && (
    <div class="mx-auto max-w-md py-16 text-center">
      <h1 class="text-2xl font-semibold text-foreground">{signedOut.title}</h1>
      {signedOut.body && <p class="mt-2 text-muted-foreground">{signedOut.body}</p>}
      {signInError && <p role="alert" data-sign-in-error class={`${ui.errorNotice} mt-6 text-start`}>{signInError}</p>}
      <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
        <button type="button" onclick="window.dispatchEvent(new CustomEvent('open-auth-modal'))" class={`${ui.primaryButton} px-6`}>{signedOut.action ?? words.signIn}</button>
        <slot name="signed-out" />
      </div>
      {signInAppList.length > 0 && (
        <ul class="mx-auto mt-4 flex max-w-xs flex-col gap-2" data-sign-in-apps>
          {signInAppList.map((app) => (
            <li>
              <a href={signInAppHref(app, { locale: signInWords })} data-astro-prefetch="false" rel="nofollow" class={`${ui.secondaryButton} w-full`}>{continueWithLabel(app.name, signInWords)}</a>
            </li>
          ))}
        </ul>
      )}
    </div>
  )}

  {state === "unavailable" && (
    <div class="mx-auto max-w-md py-12 text-center" role="alert">
      {title && <h1 class="text-2xl font-semibold text-foreground">{title}</h1>}
      <p class="mb-6 mt-2 text-foreground">{unavailable.text}</p>
      <a href={unavailable.retryHref} data-astro-prefetch="false" class={`${ui.primaryButton} px-6`}>{unavailable.retryText ?? words.retry}</a>
    </div>
  )}

  {state === "ok" && (
    <>
      {(title || back) && (
        <header class={workspace ? "mb-3 flex shrink-0 flex-wrap items-center gap-x-3" : "mb-6 flex flex-wrap items-end justify-between gap-x-4 gap-y-3"}>
          <div class={workspace ? "flex min-w-0 items-center gap-2" : "min-w-0"}>
            {back && (
              <a href={back.href} data-astro-prefetch="false" aria-label={workspace ? back.label : undefined} class={workspace ? "-ms-2 inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground" : "-ms-1 mb-1 inline-flex min-h-11 items-center gap-1 px-1 text-sm font-medium text-muted-foreground hover:text-foreground"}>
                <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                {!workspace && back.label}
              </a>
            )}
            {title && <h1 id="accountHeading" tabindex="-1" class={workspace ? "line-clamp-2 break-words text-xl font-semibold text-foreground focus:outline-none sm:text-2xl" : "break-words text-2xl font-semibold text-foreground focus:outline-none sm:text-3xl"}>{title}</h1>}
            {intro && <p class="mt-1 text-sm text-muted-foreground">{intro}</p>}
          </div>
          <slot name="actions" />
        </header>
      )}
      {workspace ? <div class="flex min-h-0 flex-1 flex-col"><slot /></div> : <slot />}
    </>
  )}
</div>

<style>
  @media (min-height: 34rem) {
    [data-account-workspace="true"][data-workspace-ready] {
      height: calc(100vh - var(--account-workspace-top, 9rem) - var(--account-workspace-bottom, 0px) - 1rem);
      height: calc(100dvh - var(--account-workspace-top, 9rem) - var(--account-workspace-bottom, 0px) - 1rem);
      min-height: 32rem;
    }
  }
  @media (max-width: 63.999rem) {
    /* Consume MobileTabBar's existing reservation, including its safe area. */
    :global(html[data-mobile-nav="tabs"]) [data-account-workspace="true"] {
      --account-workspace-bottom: var(--mobile-tabs-reserve, 0px);
    }
  }
</style>
<script is:inline>
  (() => {
    const shell = document.querySelector('[data-account-workspace="true"]');
    if (!shell) return;
    let frame = 0;
    const measure = () => {
      frame = 0;
      const top = Math.max(0, shell.getBoundingClientRect().top + window.scrollY);
      const value = `${top}px`;
      if (shell.style.getPropertyValue('--account-workspace-top') !== value) shell.style.setProperty('--account-workspace-top', value);
      shell.setAttribute('data-workspace-ready', '');
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(measure); };
    const observer = new ResizeObserver(schedule);
    observer.observe(document.body);
    window.addEventListener('resize', schedule, { passive: true });
    document.addEventListener('astro:before-swap', () => { observer.disconnect(); cancelAnimationFrame(frame); window.removeEventListener('resize', schedule); }, { once: true });
    measure();
  })();
</script>

<script>
  import { signOutCustomer } from "@/lib/customer-sign-out";
  import { pagePath } from "@/lib/presence-url";

  const shell = document.querySelector<HTMLElement>("[data-account-shell]");
  // The current tab in view on a phone, without moving the page.
  const strip = shell?.querySelector<HTMLElement>("[data-account-nav]");
  const currentTab = strip?.querySelector<HTMLElement>("[aria-current=page]");
  if (strip && currentTab && currentTab.offsetLeft + currentTab.offsetWidth > strip.clientWidth) {
    strip.scrollLeft = currentTab.offsetLeft - 16;
  }
  shell?.querySelectorAll<HTMLFormElement>("form[data-account-sign-out]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void signOutCustomer().finally(() => window.location.assign(pagePath("/")));
    });
  });
  // Signing in from the prompt shows the page for the account.
  window.addEventListener("customer-login", () => {
    if (shell?.dataset.accountState === "signed_out") window.location.reload();
  });
</script>
