---
// The theme's chrome on a buyer's private page (`privatePages.chrome: theme`):
// an app skin's checked markup, made inert (lib/extensions `privateChromeMarkup`).
// Unlike AppComponent it names no app file base, loads no app runtime and
// draws none of the skin's slots: a free region holds the inert markup only,
// never a host control (the store's search sits beside it, in its own slot).
import type { AppMarkup } from "@/lib/extensions";

interface Props {
  markup: AppMarkup;
}

const { markup } = Astro.props;
---

{markup.parts.map((part) => part.kind === "html" && <Fragment set:html={part.html} />)}
