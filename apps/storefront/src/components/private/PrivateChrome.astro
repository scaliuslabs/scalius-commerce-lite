---
// A theme's header or footer on one of the buyer's own pages (a skin with
// `buyerPages: true`, lib/extensions `buyerPageChrome`): its markup rebuilt
// inert, inside a declarative shadow root, inside a frame the store owns.
// The frame (`BUYER_CHROME_FRAME_STYLE`, its own style attribute) is the
// boundary: nothing the theme paints shows outside it, and nothing in the
// shadow tree can select it. The browser keeps the theme's text, ids,
// `popovertarget` and ARIA references inside the shadow root and the page's
// out; the shadow root's style (lib/private-pages/chrome-style.ts) holds the
// theme's checked sheet in its layer under the store's guard. The host carries
// only the page's colour scheme and sign-in hint (the inline script after it
// copies them from `<html>`), and has no child of its own. No app runtime,
// island or file base: nothing of the app runs here.
import type { BuyerChrome } from "@/lib/extensions";
import { BUYER_CHROME_FRAME_STYLE, buyerChromeShadowStyle } from "@/lib/private-pages/chrome-style";
import { BUYER_CHROME_STATE_SCRIPT } from "@/lib/inline-boot-scripts";
import baseHref from "@/styles/buyer-chrome.css?url";

interface Props {
  target: "header" | "footer";
  chrome: BuyerChrome;
}

const { target, chrome } = Astro.props;
const style = buyerChromeShadowStyle(baseHref, chrome.sheet);
---

<div data-buyer-chrome-frame={target} style={BUYER_CHROME_FRAME_STYLE[target]}><scalius-chrome data-chrome={target}><template shadowrootmode="open"><style is:inline set:html={style}></style><Fragment set:html={chrome.html} /></template></scalius-chrome><script is:inline set:html={BUYER_CHROME_STATE_SCRIPT}></script></div>

<script>
  import { installBuyerChrome } from "@/scripts/buyer-chrome";

  installBuyerChrome();
</script>
