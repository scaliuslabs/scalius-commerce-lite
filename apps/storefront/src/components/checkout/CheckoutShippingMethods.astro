---
// Delivery options. The list follows the checkout path and the chosen
// address, so the browser renders it (`enhanceShippingMethods`); the server
// ships every active rate only so pickup can be offered without an address.
import type { ShippingMethod } from "@/lib/api";
import { serializeJsonForInlineScript } from "@/lib/safe-json";

interface Props {
  shippingMethods: ShippingMethod[];
  shippingMethodLabel: string;
  pickupLocationLabel: string;
  /** The page shows a Delivery/Pickup switch: each path lists only its own rates. */
  modeSwitch: boolean;
  freeText: string;
  freeOverText: string;
  waivedShippingFeeText: string;
  pickupFromText: string;
  pickupHoursText: string;
  chooseAddressText: string;
  noDeliveryText: string;
  failedText: string;
  retryText: string;
  loadingText: string;
  feeChangedText: string;
  replacedText: string;
  replacedSameFeeText: string;
  goneText: string;
}

const { shippingMethods, shippingMethodLabel, pickupLocationLabel, modeSwitch, ...copy } = Astro.props;
---

<div
  data-shipping-methods
  data-mode-switch={modeSwitch ? "true" : "false"}
  data-delivery-legend-text={shippingMethodLabel}
  data-pickup-legend-text={pickupLocationLabel}
  data-free-text={copy.freeText}
  data-free-over-text={copy.freeOverText}
  data-waived-text={copy.waivedShippingFeeText}
  data-pickup-from-text={copy.pickupFromText}
  data-pickup-hours-text={copy.pickupHoursText}
  data-choose-address-text={copy.chooseAddressText}
  data-no-delivery-text={copy.noDeliveryText}
  data-failed-text={copy.failedText}
  data-retry-text={copy.retryText}
  data-loading-text={copy.loadingText}
  data-fee-changed-text={copy.feeChangedText}
  data-replaced-text={copy.replacedText}
  data-replaced-same-fee-text={copy.replacedSameFeeText}
  data-gone-text={copy.goneText}
>
  <script is:inline type="application/json" data-shipping-rates set:html={serializeJsonForInlineScript(shippingMethods)} />
  <fieldset id="shippingMethods" class="rounded-lg" aria-describedby="shippingMethodNotice shippingMethodNote shippingMethodError">
    <legend class="mb-2 block text-sm font-medium text-foreground" data-shipping-legend>{shippingMethodLabel}</legend>
    <p id="shippingMethodNote" class="mb-2 hidden text-sm text-muted-foreground" role="status" data-shipping-note></p>
    <p id="shippingMethodNotice" class="mb-2 hidden rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive" role="alert" data-shipping-notice></p>
    {/* The same stand-in `enhanceShippingMethods` shows until an address is chosen. */}
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2" data-shipping-options>
      <p class="flex min-h-[4.25rem] items-center rounded-lg border border-dashed border-border px-3 text-sm text-muted-foreground">{copy.chooseAddressText}</p>
    </div>
  </fieldset>
  <p id="shippingMethodError" class="mt-1 hidden text-sm font-medium text-destructive" role="alert"></p>
</div>
