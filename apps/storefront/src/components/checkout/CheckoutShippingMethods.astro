---
// Server-rendered delivery options. The cart page script keeps the selected
// method in `window.lastShippingEventDetail` and, when a cart item waives
// delivery, shows "Free" with the waived fee (`enhanceShippingMethods`).
import type { ShippingMethod } from "@/lib/api";
import { formatMoney } from "@/lib/currency";
import { formatCheckoutLanguageText } from "@scalius/shared/checkout-language-format";

interface Props {
  shippingMethods: ShippingMethod[];
  shippingMethodLabel: string;
  freeText: string;
  noShippingMethodsText: string;
  waivedShippingFeeText: string;
  pickupFromText: string;
}

const {
  shippingMethods,
  shippingMethodLabel,
  freeText,
  noShippingMethodsText,
  waivedShippingFeeText,
  pickupFromText,
} = Astro.props;

const methods = shippingMethods.map((method) => ({
  ...method,
  feeLabel: method.fee === 0 ? freeText : formatMoney(method.fee),
  pickup: method.kind === "pickup" && method.pickupAddress
    ? [formatCheckoutLanguageText(pickupFromText, { address: method.pickupAddress }), method.pickupHours]
        .filter(Boolean).join(" · ")
    : null,
}));
const single = methods.length === 1 ? methods[0] : null;
const waivedText = (feeLabel: string) =>
  formatCheckoutLanguageText(waivedShippingFeeText, { fee: feeLabel });
---

<div
  data-shipping-methods
  data-free-text={freeText}
>
  {
    methods.length === 0 ? (
      <>
        <p class="mb-1 block text-sm font-medium text-foreground">{shippingMethodLabel}</p>
        <p class="text-sm text-muted-foreground">{noShippingMethodsText}</p>
      </>
    ) : single ? (
      <>
        <p class="mb-2 block text-sm font-medium text-foreground">{shippingMethodLabel}</p>
        <input
          type="hidden"
          name="shippingLocation"
          value={single.id}
          data-fee={single.fee}
          data-name={single.name}
        />
        <div class="rounded-lg border border-border bg-background px-3 py-2.5">
          <div class="flex items-start justify-between gap-3">
            <span class="text-sm font-medium text-foreground">{single.name}</span>
            <span class="whitespace-nowrap text-sm font-semibold text-foreground" data-fee-label={single.feeLabel}>
              {single.feeLabel}
            </span>
          </div>
          {single.description && <p class="mt-0.5 text-sm text-muted-foreground">{single.description}</p>}
          {single.pickup && <p class="mt-0.5 text-sm text-foreground">{single.pickup}</p>}
          <p class="mt-0.5 hidden text-sm text-muted-foreground" data-waived-note>{waivedText(single.feeLabel)}</p>
        </div>
      </>
    ) : (
      <fieldset id="shippingMethods" aria-describedby="shippingMethodError" class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        <legend class="mb-2 block text-sm font-medium text-foreground">
          {shippingMethodLabel}
        </legend>
        {methods.map((method, index) => (
          <label class="flex min-h-11 cursor-pointer gap-3 rounded-lg border border-border bg-background p-3 transition-colors hover:bg-muted/50 has-[:checked]:border-primary has-[:checked]:ring-1 has-[:checked]:ring-primary has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-ring">
            <input
              type="radio"
              name="shippingLocation"
              value={method.id}
              checked={index === 0}
              data-fee={method.fee}
              data-name={method.name}
              class="mt-0.5 h-4 w-4 shrink-0 accent-primary"
            />
            <span class="min-w-0 flex-1">
              <span class="flex items-start justify-between gap-2">
                <span class="text-sm font-medium leading-snug text-foreground">{method.name}</span>
                <span class="whitespace-nowrap text-sm font-semibold text-foreground" data-fee-label={method.feeLabel}>
                  {method.feeLabel}
                </span>
              </span>
              {method.description && <span class="mt-0.5 block text-sm text-muted-foreground">{method.description}</span>}
              {method.pickup && <span class="mt-0.5 block text-sm text-foreground">{method.pickup}</span>}
              <span class="mt-0.5 hidden text-sm text-muted-foreground" data-waived-note>{waivedText(method.feeLabel)}</span>
            </span>
          </label>
        ))}
      </fieldset>
    )
  }
  <p id="shippingMethodError" class="mt-1 hidden text-sm font-medium text-destructive" role="alert"></p>
</div>
