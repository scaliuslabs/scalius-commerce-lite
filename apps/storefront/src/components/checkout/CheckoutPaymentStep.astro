---
// The checkout's payment step: the order summary, the gift card, the payment
// methods (drawn by lib/checkout from the authoritative quote) and the Pay
// button, as the theme's `checkout` block lays them out. `summary: top`
// keeps the summary folded above the payment at every width, as on phones;
// `paymentChoices: tiles` asks lib/checkout/payment-choices.ts for tiles.
// What the buyer must see and do (the errors, the totals, the methods, the
// Pay button, the store apps' typed targets) is the same in every layout.
// The checkout page draws it for the buyer; the theme editor's sample
// checkout (`sample`) draws it from fixed sample data, with no buyer's
// session and no redirect to the cart.
import { CHECKOUT_FIRST_PAINT_SCRIPT, GIFT_CARD_EARLY_APPLY_SCRIPT } from "@/lib/inline-boot-scripts";
import CheckoutProgress from "@/components/CheckoutProgress.astro";
import type { CheckoutLanguageData } from "@/lib/api";
import type { GiftCardCheckoutCopy } from "@/lib/checkout/gift-cards";
import { PAYMENT_CHOICE_DETAILS_ID } from "@/lib/checkout/payment-choices";
import type { StorefrontCheckoutBlock } from "@scalius/shared/storefront-theme";

interface Props {
  copy: CheckoutLanguageData["languageData"];
  giftCopy: GiftCardCheckoutCopy;
  block: StorefrontCheckoutBlock;
  sample?: boolean;
}

const { copy, giftCopy, block, sample = false } = Astro.props;
const top = block.summary === "top";
const tiles = block.paymentChoices === "tiles";
---

  <div id="checkoutPageRoot" data-checkout-state={sample ? "loading" : "missing"} data-checkout-sample={sample ? "true" : undefined} class={top ? "group mx-auto w-full max-w-2xl px-4 py-5 sm:px-6 sm:py-7" : "group mx-auto w-full max-w-6xl px-4 py-5 sm:px-6 sm:py-7"}>
    {!sample && <script is:inline set:html={CHECKOUT_FIRST_PAINT_SCRIPT} />}
    <div class="group-data-[checkout-state=missing]:hidden group-data-[checkout-state=redirect]:hidden">
      <CheckoutProgress current="payment" copy={copy} />
    </div>

    {/* No checkout to pay for: the cart's own empty state, with the way back to the shop. */}
    <section class="hidden group-data-[checkout-state=missing]:block mx-auto max-w-lg rounded-xl border border-border bg-card px-4 py-10 text-center" aria-labelledby="checkoutEmptyHeading">
      <svg class="mx-auto h-12 w-12 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <h1 id="checkoutEmptyHeading" class="mt-3 text-lg font-semibold text-foreground">{copy.emptyCartText}</h1>
      <p class="mt-1 text-sm text-muted-foreground">{copy.emptyCartDescriptionText}</p>
      <a
        href="/"
        class="mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >{copy.continueShoppingText}</a>
    </section>

    <div class={top
      ? "grid items-start gap-5 group-data-[checkout-state=missing]:hidden group-data-[checkout-state=redirect]:hidden"
      : "grid items-start gap-5 lg:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)] lg:gap-10 group-data-[checkout-state=missing]:hidden group-data-[checkout-state=redirect]:hidden"}>
      <aside
        id="orderSummary"
        class={top ? "order-1 overflow-hidden rounded-xl border border-border bg-card" : "order-1 overflow-hidden rounded-xl border border-border bg-card lg:order-2 lg:sticky lg:top-6"}
        aria-label={copy.orderSummaryText}
        aria-busy="true"
      >
        <button
          id="orderSummaryToggle"
          type="button"
          class={top ? "flex min-h-12 w-full items-center justify-between gap-3 px-4 py-3 text-start" : "flex min-h-12 w-full items-center justify-between gap-3 px-4 py-3 text-start lg:hidden"}
          aria-expanded="false"
          aria-controls="summaryPanel"
        >
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-foreground">
            {copy.orderSummaryText}
            <svg id="orderSummaryChevron" class="h-4 w-4 transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" aria-hidden="true">
              <path d="m5 7.5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
            </svg>
          </span>
          <span id="orderSummaryToggleTotal" class="text-sm font-semibold tabular-nums text-foreground"></span>
        </button>
        <div id="summaryPanel" class={top ? "hidden border-t border-border p-4" : "hidden border-t border-border p-4 lg:block lg:border-t-0"}>
          <h2 class={top ? "sr-only" : "mb-3 hidden text-sm font-semibold text-foreground lg:block"}>{copy.orderSummaryText}</h2>
          <div class="space-y-2 text-sm text-muted-foreground" id="summaryDetails">
            {/* Shown until the script draws the reviewed summary (at once) and then the page's quote. */}
            <div class="h-12 animate-pulse rounded-lg bg-muted/60" aria-hidden="true"></div>
            <div class="h-4 animate-pulse rounded bg-muted/60" aria-hidden="true"></div>
            <div class="h-4 animate-pulse rounded bg-muted/60" aria-hidden="true"></div>
          </div>
          {/* Store apps' blocks under the order summary (they fold with it on phones); hidden until one lands. */}
          <div data-buyer-ui-target="checkout.summary.after" class="mt-4 space-y-3" hidden></div>
        </div>
      </aside>

      <section class={top ? "order-2 min-w-0" : "order-2 min-w-0 lg:order-1"} aria-labelledby="paymentHeading">
        <div class="mb-5">
          <h1 id="paymentHeading" class="text-2xl font-semibold tracking-tight text-foreground">{copy.paymentPageTitle}</h1>
        </div>

        <div
          id="errorMsg"
          class="mb-4 hidden rounded-lg border border-destructive bg-destructive px-4 py-3 text-sm text-destructive-foreground"
          role="alert"
          aria-live="assertive"
        ></div>

        <a
          id="checkoutRecoveryAction"
          href="/cart"
          hidden
          class="mb-4 inline-flex min-h-11 w-fit items-center justify-center rounded-lg border border-border bg-background px-4 py-2 text-sm font-semibold text-foreground shadow-sm transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          {copy.returnToCartText}
        </a>

        {/* Gift card: a POST form, so the code never enters a URL even before
            the script runs; the script applies it in place (apply handle only). */}
        <section id="giftCardSection" class="mb-5 rounded-xl border border-border bg-card p-4" aria-labelledby="giftCardHeading">
          <h2 id="giftCardHeading" class="text-sm font-semibold text-foreground">{giftCopy.giftCardTitleText}</h2>
          <form id="giftCardForm" method="post" action="/api/gift-cards/apply" class="mt-3 flex gap-2" novalidate>
            <label for="giftCardCode" class="sr-only">{giftCopy.giftCardCodeLabelText}</label>
            <input
              id="giftCardCode"
              name="code"
              type="text"
              inputmode="text"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              maxlength="32"
              placeholder="XXXX-XXXX-XXXX-XXXX"
              aria-describedby="giftCardMessage"
              class="block h-11 min-w-0 flex-1 rounded-lg border border-input bg-background px-3 font-mono text-base uppercase tracking-wide text-foreground placeholder:normal-case placeholder:tracking-normal placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/30 aria-[invalid=true]:border-destructive disabled:opacity-60"
            />
            <button
              id="giftCardApply"
              type="submit"
              class="inline-flex h-11 shrink-0 items-center justify-center rounded-lg border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            >{giftCopy.giftCardApplyText}</button>
          </form>
          {/* Apply pressed before the page script has loaded: kept for it, never
              posted (that post can only drop the card). The script applies it
              as soon as the total is ready (buyer QA M4). */}
          <script is:inline set:html={GIFT_CARD_EARLY_APPLY_SCRIPT} data-applying={giftCopy.giftCardApplyingText} />
          <p id="giftCardMessage" class="mt-2 hidden text-sm" role="status" aria-live="polite"></p>
          <ul id="giftCardChips" class="mt-3 flex flex-wrap gap-2 empty:hidden" aria-label={giftCopy.giftCardTitleText}></ul>
        </section>

        <div
          id="paymentMethods"
          class={tiles ? "grid gap-2 sm:grid-cols-2" : "space-y-2"}
          data-payment-choices={tiles ? "tiles" : undefined}
          role="radiogroup"
          aria-label={copy.paymentMethodsText}
          aria-busy="true"
        >
          <div class="h-16 animate-pulse rounded-xl border border-border bg-muted/50" aria-hidden="true"></div>
          <div class="h-16 animate-pulse rounded-xl border border-border bg-muted/50" aria-hidden="true"></div>
          <span class="sr-only" role="status">{copy.loadingPaymentMethodsText}</span>
        </div>
        {tiles && <div id={PAYMENT_CHOICE_DETAILS_ID} class="mt-3 space-y-3 empty:hidden"></div>}
        <div data-buyer-ui-target="checkout.payment.after" class="mt-4"></div>
        <div data-buyer-ui-target="checkout.actions.before" class="mt-4"></div>

        <div id="paymentActionParking" class="hidden">
          <div
            id="testModeNotice"
            class="hidden rounded-lg border border-border bg-muted px-3 py-2 text-xs font-medium text-foreground"
            role="status"
          >
            {copy.testModeNoticeText}
          </div>

          <div id="stripeSection" class="hidden space-y-2">
            <h3 class="text-sm font-semibold text-foreground">{copy.cardDetailsText}</h3>
            <div id="stripeCardElement" class="min-h-12 rounded-lg border border-input bg-background p-3"></div>
            <div id="stripeError" class="hidden text-xs font-medium text-foreground" role="alert" aria-live="polite"></div>
          </div>

          <div id="paymentActionHost" class="hidden space-y-3">
            <p id="hostedRedirectNote" class="hidden text-xs leading-5 text-muted-foreground"></p>

            <button
              id="payButton"
              class="min-h-12 w-full rounded-lg bg-primary px-4 py-3 text-base font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
              disabled
            >
              <span id="payButtonText">{copy.selectPaymentMethodText}</span>
            </button>
          </div>
        </div>
      </section>
    </div>
  </div>
