---
// Records a product view for the homepage's "Recently viewed" row, in this
// browser only (lib/recently-viewed.ts). Nothing leaves the browser.
import { recentlyViewedRecordScript } from "@/lib/recently-viewed";

interface Props {
  /** The product id, so the row can later be checked against the public catalogue. */
  id: string;
  slug: string;
  name: string;
  /** A card-sized photo URL, or null. */
  image: string | null;
}

const { id, slug, name, image } = Astro.props;
---

<script is:inline set:html={recentlyViewedRecordScript({ id, slug, name, image })} />
