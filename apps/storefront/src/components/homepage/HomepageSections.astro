---
// The homepage body: the resolved theme's sections, in order, each through
// its own component in this folder. A section without data renders nothing
// (lib/homepage-sections.ts decides), consecutive two-up / four-up banners
// share one row, and only the lead section loads its first photos eagerly
// (a leading hero is also preloaded by pages/index.astro).
import type { StorefrontSection } from "@scalius/shared/storefront-theme";
import {
  homepageCollectionsFallback,
  homepageMedia,
  homepageRenderUnits,
  homepageSectionProducts,
  type HomepageContent,
} from "@/lib/homepage-sections";
import Hero from "@/components/hero.astro";
import UspStrip from "./UspStrip.astro";
import CategoryTiles from "./CategoryTiles.astro";
import CollectionsSection from "./CollectionsSection.astro";
import ProductRail from "./ProductRail.astro";
import ProductGridSection from "./ProductGridSection.astro";
import DealBlock from "./DealBlock.astro";
import Lookbook from "./Lookbook.astro";
import BannerRow from "./BannerRow.astro";
import EditorialSection from "./EditorialSection.astro";
import FaqSection from "./FaqSection.astro";
import UtilityCards from "./UtilityCards.astro";
import EndlessGrid from "./EndlessGrid.astro";
import SeoText from "./SeoText.astro";

interface Props {
  sections: StorefrontSection[];
  content: HomepageContent;
  /** `homepageLeadSection(...)`: the section whose photos lead the page. */
  leadSectionId: string | null;
  currencySymbol: string;
  currencyCode: string;
}

const { sections, content, leadSectionId, currencySymbol, currencyCode } = Astro.props;
const units = homepageRenderUnits(sections, content);
const money = { currencySymbol, currencyCode };
---

<div class="flex flex-col">
  {units.map((unit) => {
    if (unit.kind === "banners") {
      return (
        <BannerRow
          layout={unit.layout}
          banners={unit.sections.map((section) => ({ section, photo: homepageMedia(content, section.settings.mediaId) }))}
          aboveFold={unit.sections.some((section) => section.id === leadSectionId)}
          grouped
        />
      );
    }
    const { section } = unit;
    const lead = section.id === leadSectionId;
    const list = homepageSectionProducts(section, content);
    const headingId = `home-${section.id}-title`;
    return (
      <div class="contents" data-home-section={section.type} data-section-id={section.id}>
        {section.type === "hero" && (
          <section class="w-full">
            <Hero
              hero={content.hero}
              priority
              layout={section.settings.layout}
              sideBanners={(section.settings.sideBanners ?? []).flatMap((banner) => {
                const asset = homepageMedia(content, banner.mediaId);
                return asset ? [{ asset, alt: banner.alt, href: banner.href }] : [];
              })}
              panelFacts={content.deliveryFacts}
            />
          </section>
        )}

        {section.type === "usp-strip" && <UspStrip section={section} deliveryFacts={content.deliveryFacts} />}

        {section.type === "category-tiles" && <CategoryTiles section={section} rail={content.categoryRail} />}

        {section.type === "collections" && (
          <CollectionsSection
            collections={content.collections}
            fallbackProducts={homepageCollectionsFallback(content)}
            lead={lead}
            {...money}
          />
        )}

        {section.type === "product-rail" && list && (
          <ProductRail title={list.title} href={list.href} products={list.products} aboveFold={lead} headingId={headingId} {...money} />
        )}

        {section.type === "product-grid" && list && (
          <ProductGridSection
            title={list.title}
            href={list.href}
            products={list.products}
            maxColumns={section.settings.columns}
            aboveFold={lead}
            headingId={headingId}
            {...money}
          />
        )}

        {section.type === "deal-block" && list && (
          <DealBlock section={section} title={list.title} href={list.href} products={list.products} aboveFold={lead} {...money} />
        )}

        {section.type === "lookbook" && list && (
          <Lookbook
            section={section}
            title={list.title}
            href={list.href}
            products={list.products}
            photo={homepageMedia(content, section.settings.mediaId)}
            aboveFold={lead}
            {...money}
          />
        )}

        {section.type === "banner" && (
          <BannerRow layout="full" banners={[{ section, photo: homepageMedia(content, section.settings.mediaId) }]} aboveFold={lead} />
        )}

        {section.type === "editorial" && (
          <EditorialSection
            section={section}
            photo={section.settings.layout === "image-with-text" ? homepageMedia(content, section.settings.mediaId) : null}
            aboveFold={lead}
          />
        )}

        {section.type === "faq" && <FaqSection section={section} />}

        {section.type === "utility-cards" && <UtilityCards section={section} />}

        {section.type === "endless-grid" && list && (
          <EndlessGrid section={section} title={section.settings.title.trim() || "More to explore"} products={list.products} aboveFold={lead} {...money} />
        )}

        {section.type === "seo-text" && <SeoText section={section} />}
      </div>
    );
  })}
</div>

<style is:global>
  /* New sections space themselves by the density (theme-foundation.css
     --theme-section-gap): half above, half below. */
  .home-section {
    padding-block: calc(var(--theme-section-gap, 2.5rem) / 2);
  }
</style>
