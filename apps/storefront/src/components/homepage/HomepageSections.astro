---
// The homepage body: the resolved theme's sections, in order, each through
// its own component in this folder. A section without data renders nothing
// (lib/homepage-sections.ts decides), consecutive two-up / four-up banners
// share one row, and only the lead section loads its first photos eagerly
// (a leading hero is also preloaded by pages/index.astro).
//
// A theme editor preview (never a buyer's page) marks each section root
// with `data-theme-section-id` and the list's root with its region
// (`data-theme-region`), so the editor's bridge moves, hides and swaps
// units in place; `only` renders the one unit holding a section, which the
// preview-only render route returns. App sections (`type: "app"`) are units
// like any other: what their app drew, marked the same way, never the lead.
import type { StorefrontSection } from "@scalius/shared/storefront-theme";
import {
  dealEndsAt,
  homepageAppSurface,
  homepageCategoryTiles,
  homepageCategoryTilesTitle,
  homepageCollections,
  homepageCollectionsFallback,
  homepageHero,
  homepageMedia,
  homepageMetaobject,
  homepageMosaicTiles,
  homepagePhoneSections,
  homepageRenderUnits,
  homepageSectionProducts,
  homepageSectionTabs,
  homepageShopByCards,
  type HomepageContent,
} from "@/lib/homepage-sections";
import Hero from "@/components/hero.astro";
import UspStrip from "./UspStrip.astro";
import CategoryTiles from "./CategoryTiles.astro";
import CollectionsSection from "./CollectionsSection.astro";
import ProductRail from "./ProductRail.astro";
import ProductGridSection from "./ProductGridSection.astro";
import DealBlock from "./DealBlock.astro";
import Lookbook from "./Lookbook.astro";
import BannerRow from "./BannerRow.astro";
import EditorialSection from "./EditorialSection.astro";
import FaqSection from "./FaqSection.astro";
import MetaobjectsSection from "./MetaobjectsSection.astro";
import UtilityCards from "./UtilityCards.astro";
import EndlessGrid from "./EndlessGrid.astro";
import SeoText from "./SeoText.astro";
import ProductTabs from "./ProductTabs.astro";
import ShopByCards from "./ShopByCards.astro";
import BannerMosaic from "./BannerMosaic.astro";
import BrandWall from "./BrandWall.astro";
import RecentlyViewed from "./RecentlyViewed.astro";
import AppSection from "./AppSection.astro";
import NewsletterSection from "./NewsletterSection.astro";
import { newsletterLanguage } from "@/lib/newsletter-copy";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";

interface Props {
  sections: StorefrontSection[];
  content: HomepageContent;
  /** `homepageLeadSection(...)`: the section whose photos lead the page. */
  leadSectionId: string | null;
  currencySymbol: string;
  currencyCode: string;
  /** A theme editor preview: mark sections for the editor's bridge. */
  previewMarks?: boolean;
  /** The preview region this list is (`page`, or a template's `before` and `after`). */
  region?: "page" | "before" | "after";
  /** Render only the unit holding this section (the preview section route). */
  only?: string;
  /** The store's language (the layout's `storefrontCopy.languageCode`) for the storefront's own words. */
  languageCode?: string | null;
}

const { sections, content: stored, leadSectionId, currencySymbol, currencyCode, previewMarks = false, region = "page", only, languageCode } = Astro.props;
const language = newsletterLanguage(languageCode);
// The storefront's own words (default titles, "View more") follow the request's language.
const { language: storeLanguage } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(storeLanguage).home;
const content: HomepageContent = { ...stored, language: storeLanguage };
const units = homepageRenderUnits(sections, content);
const phoneSections = homepagePhoneSections(sections, content);
const phoneHeroAfterCategories = phoneSections !== sections;
const phoneRank = new Map(phoneSections.map((section, index) => [section.id, index]));
const phoneUnits = [...units].sort((left, right) => {
  const first = (unit: typeof left) => unit.kind === "banners" ? unit.sections[0]!.id : unit.section.id;
  return phoneRank.get(first(left))! - phoneRank.get(first(right))!;
});
const phoneOrder = new Map(phoneUnits.map((unit, index) => [unit, index]));
const money = { currencySymbol, currencyCode };
const unitIds = (unit: (typeof units)[number]) => unit.kind === "banners" ? unit.sections.map((section) => section.id) : [unit.section.id];
const shown = only ? units.filter((unit) => unitIds(unit).includes(only)) : units;
const marks = previewMarks || Boolean(only);
const root = only
  ? { "data-theme-preview-unit": "" }
  : { class: "flex flex-col", "data-home-phone-reorder": phoneHeroAfterCategories ? "" : undefined, "data-theme-region": previewMarks ? region : undefined };
---

<div {...root}>
  {shown.map((unit) => {
    const wrapper = {
      class: "contents home-render-unit",
      "data-home-render-unit": "",
      "data-phone-order": phoneOrder.get(unit),
      style: `--phone-order:${phoneOrder.get(unit)}`,
    };
    if (unit.kind === "banners") {
      return (
        <div {...wrapper}>
          <BannerRow
            layout={unit.layout}
            banners={unit.sections.map((section) => ({ section, photo: homepageMedia(content, section.settings.mediaId) }))}
            aboveFold={unit.sections.some((section) => section.id === leadSectionId)}
            grouped
            previewMarks={marks}
          />
        </div>
      );
    }
    const { section } = unit;
    const lead = section.id === leadSectionId;
    const list = homepageSectionProducts(section, content);
    const appSurface = homepageAppSurface(section, content);
    const metaobject = homepageMetaobject(section, content);
    const headingId = `home-${section.id}-title`;
    return (
      <div {...wrapper} data-home-section={section.type} data-section-id={section.id} data-theme-section-id={marks ? section.id : undefined}>
        {section.type === "hero" && (
          <section class:list={["w-full", section.settings.layout === "wide-editorial" && "md:mb-5"]}>
            <Hero
              hero={homepageHero(section, content)}
              priority={lead}
              phonePriority={lead && !phoneHeroAfterCategories}
              layout={section.settings.layout}
              phoneHeight={section.settings.phoneHeight ?? "screen"}
              sideBanners={(section.settings.sideBanners ?? []).flatMap((banner) => {
                const asset = homepageMedia(content, banner.mediaId);
                return asset ? [{ asset, alt: banner.alt, href: banner.href }] : [];
              })}
            />
          </section>
        )}

        {section.type === "usp-strip" && <UspStrip section={section} deliveryFacts={content.deliveryFacts} />}

        {section.type === "category-tiles" && (
          <CategoryTiles
            section={section}
            title={homepageCategoryTilesTitle(section, storeLanguage)}
            categories={homepageCategoryTiles(section, content)}
          />
        )}

        {section.type === "collections" && (
          <CollectionsSection
            section={section}
            collections={homepageCollections(section, content)}
            fallbackProducts={homepageCollectionsFallback(section, content)}
            lead={lead}
            {...money}
          />
        )}

        {section.type === "product-rail" && list && (
          <ProductRail title={list.title} href={list.href} products={list.products} aboveFold={lead} headingId={headingId} {...money} />
        )}

        {section.type === "product-grid" && list && (
          <ProductGridSection
            title={list.title}
            href={list.href}
            products={list.products}
            maxColumns={section.settings.columns}
            aboveFold={lead}
            headingId={headingId}
            {...money}
          />
        )}

        {section.type === "deal-block" && list && (
          <DealBlock
            section={section}
            title={list.title}
            href={list.href}
            products={list.products}
            aboveFold={lead}
            endsAt={dealEndsAt(section, content)}
            {...money}
          />
        )}

        {section.type === "product-tabs" && (
          <ProductTabs
            sectionId={section.id}
            title={section.settings.title}
            tabs={homepageSectionTabs(section, content)}
            aboveFold={lead}
            {...money}
          />
        )}

        {section.type === "shop-by" && (
          <ShopByCards sectionId={section.id} title={section.settings.title} cards={homepageShopByCards(section, content)} aboveFold={lead} />
        )}

        {section.type === "banner-mosaic" && <BannerMosaic tiles={homepageMosaicTiles(section, content)} aboveFold={lead} />}

        {section.type === "brand-wall" && <BrandWall section={section} brands={content.brands} />}

        {section.type === "recently-viewed" && <RecentlyViewed section={section} />}

        {section.type === "lookbook" && list && (
          <Lookbook
            section={section}
            title={list.title}
            href={list.href}
            products={list.products}
            photo={homepageMedia(content, section.settings.mediaId)}
            aboveFold={lead}
            {...money}
          />
        )}

        {section.type === "banner" && (
          <BannerRow layout="full" banners={[{ section, photo: homepageMedia(content, section.settings.mediaId) }]} aboveFold={lead} />
        )}

        {section.type === "editorial" && (
          <EditorialSection
            section={section}
            photo={section.settings.layout === "image-with-text" ? homepageMedia(content, section.settings.mediaId) : null}
            aboveFold={lead}
          />
        )}

        {section.type === "faq" && <FaqSection section={section} />}

        {section.type === "metaobjects" && metaobject && (
          <MetaobjectsSection section={section} metaobject={metaobject} media={content.media} {...money} {language} />
        )}

        {section.type === "utility-cards" && <UtilityCards section={section} />}

        {section.type === "endless-grid" && list && (
          <EndlessGrid section={section} title={section.settings.title.trim() || copy.moreToExplore} products={list.products} aboveFold={lead} {...money} />
        )}

        {section.type === "seo-text" && <SeoText section={section} />}

        {section.type === "newsletter" && <NewsletterSection section={section} language={language} />}

        {section.type === "app" && appSurface && <AppSection section={section} surface={appSurface} />}
      </div>
    );
  })}
</div>

{phoneHeroAfterCategories && !only && (
  <script is:inline>
    (() => {
      const root = document.querySelector("[data-home-phone-reorder]");
      if (!root) return;
      const hero = root.querySelector(':scope > [data-home-section="hero"]');
      const categories = root.querySelector(':scope > [data-home-section="category-tiles"]');
      if (!hero || !categories) return;
      const desktopNext = hero.nextElementSibling;
      const phone = matchMedia("(max-width: 767px)");
      const sync = () => {
        if (phone.matches) categories.after(hero);
        else root.insertBefore(hero, desktopNext);
      };
      sync();
      phone.addEventListener("change", sync);
    })();
  </script>
)}

<style is:global>
  @media (max-width: 767px) {
    [data-home-phone-reorder] > .home-render-unit { display: block; order: var(--phone-order); }
  }
  /* New sections space themselves by the density (theme-foundation.css
     --theme-section-gap): half above, half below. */
  .home-section {
    padding-block: calc(var(--theme-section-gap, 2.5rem) / 2);
  }
</style>
