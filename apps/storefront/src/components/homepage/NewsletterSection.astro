---
// The newsletter section (Dawn's email signup, Fabrilife's band): the
// merchant's heading and text (else the storefront's own, in the store's
// language) over the signup form, on the muted surface so it reads as a band
// in every template. The form posts without JavaScript (NewsletterForm).
import type { StorefrontSectionOf } from "@scalius/shared/storefront-theme";
import NewsletterForm from "@/components/newsletter/NewsletterForm.astro";
import type { NewsletterLanguage } from "@/lib/newsletter-copy";
import { newsletterFormModel } from "@/lib/newsletter-form";
import Container from "@/components/ui/Container.astro";

interface Props {
  section: StorefrontSectionOf<"newsletter">;
  language: NewsletterLanguage;
}

const { section, language } = Astro.props;
const model = newsletterFormModel(section.settings, language);
const headingId = `home-${section.id}-title`;
---

<section class="home-section w-full" aria-labelledby={headingId} data-newsletter-section>
  <Container>
    <div class="rounded-xl bg-muted px-4 py-8 text-foreground sm:px-8 md:py-10">
      <div class="mx-auto max-w-2xl">
        <h2 id={headingId} class="section-heading text-center text-foreground [overflow-wrap:anywhere]">{model.heading}</h2>
        <p class="mt-2 whitespace-pre-line text-center text-sm text-muted-foreground [overflow-wrap:anywhere] md:text-base">{model.text}</p>
        <NewsletterForm model={model} idPrefix={`home-${section.id}-newsletter`} class="mt-5" />
      </div>
    </div>
  </Container>
</section>
