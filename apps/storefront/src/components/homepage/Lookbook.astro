---
// A lookbook (Fabrilife: a ~400x400 lifestyle photo with its caption beside
// a 4x2 grid of the list's products whose last tile is "View more"). On
// phones the photo sits above a two-column grid. Without its photo it is
// the product grid alone.
import type { Product } from "@/lib/api";
import type { HomepageMediaAsset } from "@/lib/api/storefront";
import type { StorefrontSectionOf } from "@scalius/shared/storefront-theme";
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import ProductCard from "@/components/cards/ProductCard.astro";
import { ArrowRight } from "lucide-react";

interface Props {
  section: StorefrontSectionOf<"lookbook">;
  title: string;
  href: string | null;
  products: Product[];
  photo: HomepageMediaAsset | null;
  currencySymbol: string;
  currencyCode: string;
  aboveFold: boolean;
}

const { section, title, href, products, photo, currencySymbol, currencyCode, aboveFold } = Astro.props;
const headingId = `home-${section.id}-title`;
// Eight tiles at most: with more to see, the eighth is "View more".
const viewMore = Boolean(href) && products.length >= 8;
const shown = products.slice(0, viewMore ? 7 : 8);
---

<section class="home-section w-full" aria-labelledby={headingId}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class:list={["grid gap-4 md:gap-6", photo && "lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]"]}>
      {photo && (
        <figure class="relative overflow-hidden rounded-lg bg-muted">
          <img
            src={mediaImageUrl(photo.url, 960)}
            srcset={mediaImageSrcSet(photo.url)}
            sizes="(max-width: 1023px) calc(100vw - 2rem), 40vw"
            alt={photo.alt}
            width={photo.width ?? 800}
            height={photo.height ?? 800}
            loading={aboveFold ? "eager" : "lazy"}
            decoding="async"
            class="aspect-square h-full w-full object-cover lg:aspect-auto"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/75 via-black/40 to-transparent p-4 pt-16 md:p-6 md:pt-20">
            <h2 id={headingId} class="section-heading text-white [overflow-wrap:anywhere]">{title}</h2>
          </figcaption>
        </figure>
      )}
      <div class="min-w-0">
        {!photo && <h2 id={headingId} class="section-heading mb-3 text-foreground md:mb-5">{title}</h2>}
        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-4 md:gap-3">
          {shown.map((product, index) => (
            <li class="min-w-0">
              <ProductCard product={product} currencySymbol={currencySymbol} currencyCode={currencyCode} index={index} aboveFold={aboveFold} />
            </li>
          ))}
          {viewMore && (
            <li class="min-w-0">
              <a href={href!} class="flex h-full min-h-40 flex-col items-center justify-center gap-2 rounded-lg border border-border bg-muted p-4 text-center text-sm font-semibold text-foreground transition-colors hover:border-primary">
                View more
                <ArrowRight className="h-4 w-4" />
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>
  </div>
</section>
