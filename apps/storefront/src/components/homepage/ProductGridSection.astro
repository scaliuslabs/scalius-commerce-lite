---
// A product grid section in the store's card and density: a titled grid with
// one "View all" link (SectionHeader). `maxColumns` caps the fluid grid on
// computers, so a 4x2 section is 4 across even where the density fits 6.
// A homepage grid collection (`collection`) adds its subtitle and shows at
// most six cards on a phone, with its "View all" link, so four collections
// do not become four thousand pixels of scrolling.
import type { Product } from "@/lib/api";
import ProductCard from "@/components/cards/ProductCard.astro";
import ProductGrid from "@/components/cards/ProductGrid.astro";
import Container from "@/components/ui/Container.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";

interface Props {
  title: string;
  products: Product[];
  href: string | null;
  hrefLabel?: string;
  currencySymbol?: string;
  currencyCode?: string;
  aboveFold?: boolean;
  headingId?: string;
  /** A homepage grid collection. */
  collection?: { subtitle: string };
  /** Most columns on a computer (the section's `columns` setting). */
  maxColumns?: number;
}

const {
  title,
  products,
  href,
  hrefLabel,
  currencySymbol = DEFAULT_CURRENCY.symbol,
  currencyCode = DEFAULT_CURRENCY.code,
  aboveFold = false,
  headingId,
  collection,
  maxColumns,
} = Astro.props;
// One or two products fill two capped columns, not a row of empty tracks.
const sparse = products.length <= 2;
---

{products.length > 0 && (
  <section class="home-section w-full" aria-labelledby={headingId}>
    <Container>
      <SectionHeader id={headingId} title={title} subtitle={collection?.subtitle || null} href={href} linkLabel={hrefLabel} />
      <div class:list={[maxColumns && !sparse && "home-grid-capped", collection && "home-grid-phone-cap"]} style={maxColumns && !sparse ? `--home-grid-columns: ${maxColumns};` : undefined}>
        <ProductGrid sparse={sparse}>
          {products.map((product, index) => (
            <ProductCard product={product} currencySymbol={currencySymbol} currencyCode={currencyCode} index={index} aboveFold={aboveFold} maxColumns={maxColumns} />
          ))}
        </ProductGrid>
      </div>
    </Container>
  </section>
)}

<style>
  /* At most N columns: each column is at least the density's minimum card
     width and at least 1/N of the row, so auto-fill never makes more. */
  .home-grid-capped :global(.product-grid) {
    grid-template-columns: repeat(
      auto-fill,
      minmax(
        max(
          min(var(--card-min), 100%),
          calc((100% - (var(--home-grid-columns) - 1) * var(--theme-grid-gap-desktop, 1.5rem)) / var(--home-grid-columns))
        ),
        1fr
      )
    );
  }

  @media (max-width: 39.99rem) {
    .home-grid-phone-cap :global(.product-grid > :nth-child(n + 7)) {
      display: none;
    }
  }
</style>
