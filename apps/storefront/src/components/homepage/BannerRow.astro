---
// Campaign banners: one full-width banner, or a row of consecutive two-up or
// four-up banners that share it (a short run spreads over the row: one
// banner is full width, three share a three-column row). A banner with a
// photo shows its words on a dark band (HeroCopy), so white text keeps AA
// contrast over any photo; one without a photo is a colour banner on the
// theme's secondary colour. Photos have a fixed ratio, so nothing shifts
// while they load.
import type { StorefrontSectionOf } from "@scalius/shared/storefront-theme";
import type { HomepageMediaAsset } from "@/lib/api/storefront";
import { bannerRowLayout } from "@/lib/homepage-sections";
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import Container from "@/components/ui/Container.astro";
import HeroCopy from "@/components/sliders/HeroCopy.astro";

interface Props {
  layout: "full" | "two-up" | "four-up";
  banners: Array<{ section: StorefrontSectionOf<"banner">; photo: HomepageMediaAsset | null }>;
  /** The row leads the page: its photos load eagerly. */
  aboveFold: boolean;
  /** A row of grouped banners: each banner carries its own section marker. */
  grouped?: boolean;
  /** A theme editor preview: grouped banners carry the editor's section mark too. */
  previewMarks?: boolean;
}

const { layout: requested, banners, aboveFold, grouped = false, previewMarks = false } = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).home;
const layout = requested === "full" ? "full" : bannerRowLayout(requested, banners.length);
const RATIO = {
  full: "aspect-[4/3] sm:aspect-[16/7] lg:aspect-[18/5]",
  "two-up": "aspect-[4/3] sm:aspect-[16/9]",
  "three-up": "aspect-[4/3] sm:aspect-[4/5]",
  "four-up": "aspect-[4/5]",
} as const;
const SIZES = {
  full: "(max-width: 1279px) calc(100vw - 2rem), 1216px",
  "two-up": "(max-width: 639px) calc(100vw - 2rem), (max-width: 1279px) 50vw, 600px",
  "three-up": "(max-width: 639px) calc(100vw - 2rem), (max-width: 1279px) 33vw, 400px",
  "four-up": "(max-width: 1023px) 50vw, 300px",
} as const;
const columns = {
  full: "",
  "two-up": "sm:grid-cols-2",
  "three-up": "sm:grid-cols-3",
  "four-up": "grid-cols-2 lg:grid-cols-4",
}[layout];
---

<section class="home-section w-full" aria-label={banners.length > 1 ? copy.promotions : undefined}>
  <Container>
    <div class:list={["grid gap-3 md:gap-4", columns]}>
      {banners.map(({ section, photo }) => {
        const { heading, text, cta } = section.settings;
        const title = heading.trim();
        const body = text.trim();
        const Frame = cta ? "a" : "div";
        // A linked banner is named by its own words (heading, text, button),
        // so the name always holds the visible text (WCAG 2.5.3).
        const headingId = `home-${section.id}-title`;
        const external = cta?.href.startsWith("https://");
        return (
          <Frame
            href={cta?.href}
            data-astro-prefetch={cta ? getStorefrontPrefetchAttribute(cta.href, Astro.url) : undefined}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class:list={[
              "group relative block overflow-hidden rounded-xl",
              photo ? `${RATIO[layout]} bg-muted` : "flex min-h-40 flex-col justify-center bg-secondary p-6 md:min-h-56 md:p-10",
            ]}
            data-home-section={grouped ? "banner" : undefined}
            data-section-id={grouped ? section.id : undefined}
            data-theme-section-id={grouped && previewMarks ? section.id : undefined}
          >
            {photo && (
              <img
                src={mediaImageUrl(photo.url, 960)}
                srcset={mediaImageSrcSet(photo.url)}
                sizes={SIZES[layout]}
                alt={title ? "" : photo.alt}
                width={photo.width ?? 1600}
                height={photo.height ?? 600}
                loading={aboveFold ? "eager" : "lazy"}
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              />
            )}
            <HeroCopy
              previewFields={previewMarks}
              heading={title}
              text={body}
              buttonLabel={cta?.label}
              tone={photo ? "band" : "plain"}
              size={layout === "four-up" || layout === "three-up" ? "md" : "lg"}
              headingId={headingId}
              headingLevel="h2"
            />
          </Frame>
        );
      })}
    </div>
  </Container>
</section>
