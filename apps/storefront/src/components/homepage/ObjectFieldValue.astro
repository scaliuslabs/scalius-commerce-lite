---
// One object field value (lib/object-fields.ts made the parts):
// escaped text that keeps its line breaks, an https or store link, a colour
// swatch beside its code, or photos. List values read as a comma list;
// photo lists sit side by side. Never set:html.
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import { objectFieldIsPhotos, type ObjectFieldView } from "@/lib/object-fields";

interface Props {
  view: ObjectFieldView;
  /** The entry's title, the photos' text when a photo has none. */
  title: string;
}

const { view, title } = Astro.props;
const photos = objectFieldIsPhotos(view);
---

{photos ? (
  <span class="flex flex-wrap gap-2">
    {view.parts.map((part) => part.kind === "image" && (
      <img
        src={mediaImageUrl(part.asset.url, 480)}
        srcset={mediaImageSrcSet(part.asset.url)}
        sizes="(max-width: 639px) 45vw, 240px"
        alt={part.asset.alt || title}
        width={part.asset.width ?? 480}
        height={part.asset.height ?? 480}
        loading="lazy"
        decoding="async"
        class="h-32 w-auto max-w-full rounded-lg bg-muted object-cover"
      />
    ))}
  </span>
) : (
  <span class="whitespace-pre-line [overflow-wrap:anywhere]">{view.parts.map((part, index) => (
    <Fragment>
      {index > 0 && ", "}
      {part.kind === "text" && part.text}
      {part.kind === "link" && (
        <a
          href={part.href}
          target={part.external ? "_blank" : undefined}
          rel={part.external ? "noopener noreferrer" : undefined}
          class="inline-block py-0.5 text-foreground underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
        >{part.label}</a>
      )}
      {part.kind === "color" && (
        <span class="inline-flex items-center gap-2">
          <span class="inline-block size-4 shrink-0 rounded-full border border-border" style={`background-color:${part.value}`} aria-hidden="true"></span>
          <span>{part.value}</span>
        </span>
      )}
      {part.kind === "image" && (
        <img
          src={mediaImageUrl(part.asset.url, 480)}
          srcset={mediaImageSrcSet(part.asset.url)}
          sizes="(max-width: 639px) 45vw, 240px"
          alt={part.asset.alt || title}
          width={part.asset.width ?? 480}
          height={part.asset.height ?? 480}
          loading="lazy"
          decoding="async"
          class="my-1 block h-32 w-auto max-w-full rounded-lg bg-muted object-cover"
        />
      )}
    </Fragment>
  ))}</span>
)}
