---
// The categories the section names (its `categoryIds`, in order; only
// published ones arrive) under its title, as tiles.
// - photo / photo-grid: portrait photos with captions. A scrolling row on
//   phones (the next tile peeks in), a grid from 640px.
// - icons: an icon grid, 3 across on phones.
// - round / round-small / round-row: round images (round-row is one scrolling
//   row on phones).
// - quad: cards of four labelled images in a 2x2 grid.
// - square: a square gallery.
// Grids use the widest column count that leaves no stranded row
// (balancedColumns), so twelve tiles are 6 or 4 across, never 8 + 4. A
// category without a photo shows CategoryMonogram in the same box; photo
// tiles where no category has a photo are name cards instead of a wall of
// empty frames.
import type { StorefrontSectionOf } from "@scalius/shared/storefront-theme";
import type { HomepageCategory } from "@/lib/api/storefront";
import { balancedColumns } from "@/lib/homepage-sections";
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import Container from "@/components/ui/Container.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import CategoryMonogram from "./CategoryMonogram.astro";

interface Props {
  section: StorefrontSectionOf<"category_tiles">;
  /** `homepageCategoryTilesTitle(section)`. */
  title: string;
  /** `homepageCategoryTiles(section, content)`: the section's categories, in its order. */
  categories: HomepageCategory[];
}

const { section, title, categories } = Astro.props;
const style = section.settings.style;
const photo = style === "photo" || style === "photo-grid";
const round = style === "round" || style === "round-small" || style === "round-row";
const compactRound = style === "round-small";
const headingId = `home-${section.id}-title`;
const hrefOf = (category: (typeof categories)[number]) =>
  category.canonicalPath || `/categories/${encodeURIComponent(category.slug)}`;
const count = categories.length;
// Columns per width step: phone, 640px, 1024px.
const columns = (phone: number, tablet: number, desktop: number) =>
  `--cols-phone:${balancedColumns(count, phone)};--cols-tablet:${balancedColumns(count, tablet)};--cols-desktop:${balancedColumns(count, desktop)};`;
const quads = Array.from({ length: Math.ceil(count / 4) }, (_, index) => categories.slice(index * 4, index * 4 + 4));
const shown = photo ? count >= 1 : count >= 2;
const named = photo && categories.every((category) => !category.imageUrl);
---

{shown && (
  <section class="home-section w-full" aria-labelledby={headingId}>
    <Container>
      <SectionHeader id={headingId} title={title} />

      {named && (
        <ul class="cat-names" style={columns(2, 3, 4)}>
          {categories.map((category) => (
            <li>
              <a href={hrefOf(category)} class="cat-name">
                <span class="cat-name-text">{category.name}</span>
                <svg aria-hidden="true" data-dir-icon viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </li>
          ))}
        </ul>
      )}

      {photo && !named && (
        <ul
          class="cat-photos"
          style={columns(3, style === "photo-grid" ? 3 : 3, style === "photo-grid" ? 4 : 5)}
          data-heritage-departments={style === "photo-grid" ? "" : undefined}
        >
          {categories.map((category) => (
            <li>
              <a href={hrefOf(category)} class="group cat-photo">
                {category.imageUrl ? (
                  <img
                    src={mediaImageUrl(category.imageUrl, 480)}
                    srcset={mediaImageSrcSet(category.imageUrl)}
                    sizes="(max-width: 639px) min(42vw, 176px), (max-width: 1023px) 30vw, 20vw"
                    alt=""
                    width="520"
                    height="620"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.025] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  />
                ) : (
                  <CategoryMonogram name={category.name} />
                )}
                <span class="cat-photo-scrim" aria-hidden="true"></span>
                <span class="cat-photo-name">{category.name}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {style === "icons" && (
        <ul class="cat-icons" style={columns(3, 6, 8)}>
          {categories.map((category) => (
            <li>
              <a href={hrefOf(category)} class="cat-icon-tile">
                <span class="cat-icon-box" aria-hidden="true">
                  {category.imageUrl ? (
                    <img src={mediaImageUrl(category.imageUrl, 160)} srcset={mediaImageSrcSet(category.imageUrl)} sizes="56px" alt="" width="56" height="56" loading="lazy" decoding="async" class="h-full w-full object-contain" />
                  ) : (
                    <CategoryMonogram name={category.name} />
                  )}
                </span>
                <span class="cat-label">{category.name}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {round && (
        <ul class:list={["cat-round", style === "round-row" && "cat-round-row"]} style={columns(3, 4, 8)}>
          {categories.map((category) => (
            <li>
              <a href={hrefOf(category)} class="group cat-round-tile">
                <span class:list={["cat-round-photo", compactRound && "cat-round-small"]} aria-hidden="true">
                  {category.imageUrl ? (
                    <img src={mediaImageUrl(category.imageUrl, compactRound ? 160 : 320)} srcset={mediaImageSrcSet(category.imageUrl)} sizes={compactRound ? "56px" : "(max-width: 639px) 30vw, 112px"} alt="" width={compactRound ? "56" : "112"} height={compactRound ? "56" : "112"} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                  ) : (
                    <CategoryMonogram name={category.name} />
                  )}
                </span>
                <span class="cat-label">{category.name}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {style === "square" && (
        <ul class="cat-square" style={columns(3, 4, 7)}>
          {categories.map((category) => (
            <li>
              <a href={hrefOf(category)} class="group block h-full">
                <span class="cat-square-photo" aria-hidden="true">
                  {category.imageUrl ? (
                    <img src={mediaImageUrl(category.imageUrl, 320)} srcset={mediaImageSrcSet(category.imageUrl)} sizes="(max-width: 639px) 30vw, (max-width: 1023px) 23vw, 14vw" alt="" width="320" height="320" loading="lazy" decoding="async" class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100" />
                  ) : (
                    <CategoryMonogram name={category.name} />
                  )}
                </span>
                <span class="cat-label cat-label-start">{category.name}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {style === "quad" && (
        <ul class="cat-quads" style={`--cols-desktop:${balancedColumns(quads.length, 4, 1)};`}>
          {quads.map((group) => (
            <li class="cat-quad">
              <ul class="grid grid-cols-2 gap-3">
                {group.map((category) => (
                  <li>
                    <a href={hrefOf(category)} class="group block">
                      <span class="cat-square-photo cat-quad-photo" aria-hidden="true">
                        {category.imageUrl ? (
                          <img src={mediaImageUrl(category.imageUrl, 320)} srcset={mediaImageSrcSet(category.imageUrl)} sizes="(max-width: 639px) 45vw, (max-width: 1023px) 23vw, 150px" alt="" width="150" height="150" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100" />
                        ) : (
                          <CategoryMonogram name={category.name} />
                        )}
                      </span>
                      <span class="cat-label cat-label-start">{category.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      )}
    </Container>
  </section>
)}

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cat-label {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-block-start: 0.5rem;
    color: var(--foreground);
    font-size: var(--theme-text-sm, 0.875rem);
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .cat-label-start {
    text-align: start;
  }

  /* Photo tiles: a scrolling row on phones, a balanced grid from 640px. */
  .cat-photos {
    display: flex;
    gap: 0.75rem;
    margin-inline: calc(var(--theme-gutter-phone, 1rem) * -1);
    padding-inline: var(--theme-gutter-phone, 1rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .cat-photos::-webkit-scrollbar { display: none; }

  .cat-photos > li {
    flex: 0 0 42vw;
    max-inline-size: 11rem;
    scroll-snap-align: start;
  }

  .cat-photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--muted);
  }

  .cat-photo-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.7), rgb(0 0 0 / 0.05) 60%, transparent);
  }

  .cat-photo-name {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: 0.75rem;
    color: #fff;
    font-size: var(--theme-text-sm, 0.875rem);
    font-weight: 600;
    line-height: 1.25;
    overflow-wrap: break-word;
  }

  @media (min-width: 40rem) {
    .cat-photos {
      display: grid;
      grid-template-columns: repeat(var(--cols-tablet), minmax(0, 1fr));
      gap: 1rem;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }

    .cat-photos > li { max-inline-size: none; }
    .cat-photo-name { font-size: var(--theme-text-base, 1rem); padding: 1rem; }
  }

  @media (min-width: 64rem) {
    .cat-photos { grid-template-columns: repeat(var(--cols-desktop), minmax(0, 1fr)); }
  }

  /* Name cards: photo tiles when no category has a photo. */
  .cat-names {
    display: grid;
    grid-template-columns: repeat(var(--cols-phone), minmax(0, 1fr));
    gap: 0.5rem;
  }

  .cat-name {
    display: flex;
    block-size: 100%;
    min-block-size: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border: var(--theme-surface-border, 1px solid var(--border));
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--theme-surface-shadow, none);
    color: var(--foreground);
    font-size: var(--theme-text-sm, 0.875rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .cat-name-text { min-inline-size: 0; overflow-wrap: break-word; }
  .cat-name svg { flex: none; color: var(--muted-foreground); }

  @media (hover: hover) {
    .cat-name:hover { border-color: var(--primary); }
    .cat-name:hover svg { color: var(--foreground); }
  }

  @media (min-width: 40rem) {
    .cat-names { grid-template-columns: repeat(var(--cols-tablet), minmax(0, 1fr)); gap: 0.75rem; }
    .cat-name { min-block-size: 4.5rem; padding-inline: 1.25rem; font-size: var(--theme-text-base, 1rem); }
  }

  @media (min-width: 64rem) {
    .cat-names { grid-template-columns: repeat(var(--cols-desktop), minmax(0, 1fr)); }
  }

  /* Icon tiles: 3 across on phones so names fit whole. */
  .cat-icons {
    display: grid;
    grid-template-columns: repeat(var(--cols-phone), minmax(0, 1fr));
    gap: 0.5rem;
  }

  .cat-icon-tile {
    display: flex;
    block-size: 100%;
    flex-direction: column;
    align-items: center;
    padding: 0.75rem 0.5rem;
    border: var(--theme-surface-border, 1px solid var(--border));
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--theme-surface-shadow, none);
    text-align: center;
  }

  .cat-icon-box {
    display: block;
    overflow: hidden;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: var(--radius);
    background: var(--muted);
  }

  @media (hover: hover) {
    .cat-icon-tile:hover { border-color: var(--primary); }
  }

  @media (min-width: 40rem) {
    .cat-icons { grid-template-columns: repeat(var(--cols-tablet), minmax(0, 1fr)); gap: 0.75rem; }
    .cat-icon-box { inline-size: 3.5rem; block-size: 3.5rem; }
  }

  @media (min-width: 64rem) {
    .cat-icons { grid-template-columns: repeat(var(--cols-desktop), minmax(0, 1fr)); }
  }

  /* Round tiles. */
  .cat-round {
    display: grid;
    grid-template-columns: repeat(var(--cols-phone), minmax(0, 1fr));
    gap: 1rem 0.75rem;
  }

  .cat-round-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cat-round-photo {
    display: block;
    overflow: hidden;
    inline-size: 100%;
    max-inline-size: 7rem;
    aspect-ratio: 1;
    border-radius: 9999px;
    background: var(--muted);
    box-shadow: 0 0 0 1px var(--border);
    transition: box-shadow var(--theme-duration-fast, 150ms) ease-out;
  }

  .cat-round-small {
    inline-size: 3.5rem;
    block-size: 3.5rem;
  }

  @media (hover: hover) {
    .cat-round-tile:hover .cat-round-photo { box-shadow: 0 0 0 2px var(--primary); }
  }

  /* Target's row: one scrolling row on phones. */
  .cat-round-row {
    display: flex;
    margin-inline: calc(var(--theme-gutter-phone, 1rem) * -1);
    padding-inline: var(--theme-gutter-phone, 1rem);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .cat-round-row::-webkit-scrollbar { display: none; }
  .cat-round-row > li { flex: 0 0 30%; }

  @media (min-width: 40rem) {
    .cat-round,
    .cat-round-row {
      display: grid;
      grid-template-columns: repeat(var(--cols-tablet), minmax(0, 1fr));
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }

  @media (min-width: 64rem) {
    .cat-round,
    .cat-round-row { grid-template-columns: repeat(var(--cols-desktop), minmax(0, 1fr)); }
  }

  /* Square gallery and quad cards. */
  .cat-square {
    display: grid;
    grid-template-columns: repeat(var(--cols-phone), minmax(0, 1fr));
    gap: 1.25rem 0.75rem;
  }

  .cat-square-photo {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: var(--muted);
  }

  @media (min-width: 40rem) {
    .cat-square { grid-template-columns: repeat(var(--cols-tablet), minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .cat-square { grid-template-columns: repeat(var(--cols-desktop), minmax(0, 1fr)); column-gap: 1rem; }
  }

  .cat-quads {
    display: grid;
    gap: 0.75rem;
  }

  .cat-quad {
    padding: var(--theme-surface-pad-phone, 0.75rem);
    border: var(--theme-surface-border, 1px solid var(--border));
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--theme-surface-shadow, none);
  }

  @media (min-width: 40rem) {
    .cat-quads { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  }

  @media (min-width: 64rem) {
    .cat-quads { grid-template-columns: repeat(var(--cols-desktop), minmax(0, 1fr)); }
    .cat-quad { padding: var(--theme-surface-pad-desktop, 1rem); }
  }
</style>
