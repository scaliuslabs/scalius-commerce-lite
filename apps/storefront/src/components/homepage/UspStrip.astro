---
// A strip of short promises (delivery, cash on delivery, returns, or the
// merchant's own points).
// - icons: 2-4 items in one bordered row, two across on phones. The live
//   delivery facts need two to be a strip (one is shown by the product page
//   and checkout); the merchant's own items may be one, centred inline.
// - ticker: the same points as one still, wrapping line (nothing moves, so
//   there is nothing to pause or chase; WCAG 2.2.2).
import Icon from "@/components/icons/Icon.astro";
import type { LucideIconName } from "@/components/icons/lucide-icons";
import Container from "@/components/ui/Container.astro";
import type { StorefrontSectionOf } from "@scalius/shared/storefront-theme";
import type { DeliveryFact } from "@/lib/delivery-facts";
import { HOME_USP_MIN_FACTS } from "@/lib/homepage-sections";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";

interface Props {
  section: StorefrontSectionOf<"usp-strip">;
  deliveryFacts: DeliveryFact[];
}

const { section, deliveryFacts } = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).home;
const { style, source } = section.settings;
const ICONS: Record<DeliveryFact["kind"], LucideIconName> = { delivery: "truck", pickup: "store", cod: "banknote", returns: "rotate-ccw" };
const items: Array<{ title: string; detail: string; icon: LucideIconName; href?: string }> = source.kind === "delivery-facts"
  ? (deliveryFacts.length >= HOME_USP_MIN_FACTS ? deliveryFacts.map((fact) => ({ title: fact.title, detail: fact.detail, icon: ICONS[fact.kind], href: fact.href })) : [])
  : source.items.map((item) => ({ title: item.title, detail: item.detail, icon: "badge-check" as const }));
---

{style === "icons" && items.length === 1 && (
  <section class="home-section w-full" aria-label={copy.whyShop}>
    <Container>
      <p class="usp-single">
        <Icon name={items[0]!.icon} class="size-4" aria-hidden="true" />
        <span><strong>{items[0]!.title}</strong>{items[0]!.detail && ` ${items[0]!.detail}`}</span>
      </p>
    </Container>
  </section>
)}

{style === "icons" && items.length > 1 && (
  <section class="home-section w-full" aria-label={copy.whyShop}>
    <Container>
      <ul class="usp-grid" data-count={items.length}>
        {items.map((item) => {
          const content = (
            <>
              <span class="usp-icon" aria-hidden="true"><Icon name={item.icon} class="size-4" /></span>
              <span class="min-w-0 [overflow-wrap:break-word]">
                <span class="usp-title">{item.title}</span>
                {item.detail && <span class="usp-detail">{item.detail}</span>}
              </span>
            </>
          );
          return (
            <li>
              {item.href ? (
                <a href={item.href} data-astro-prefetch={getStorefrontPrefetchAttribute(item.href, Astro.url)} class="usp-item usp-link">{content}</a>
              ) : (
                <div class="usp-item">{content}</div>
              )}
            </li>
          );
        })}
      </ul>
    </Container>
  </section>
)}

{style === "ticker" && source.kind === "custom" && source.items.length > 0 && (
  <section class="home-section w-full" aria-label={copy.notices}>
    <Container>
      <ul class="usp-still">
        {source.items.map((item) => <li>{[item.title, item.detail].filter(Boolean).join(": ")}</li>)}
      </ul>
    </Container>
  </section>
)}

{style === "ticker" && source.kind === "delivery-facts" && deliveryFacts.length > 0 && (
  <section class="home-section w-full" aria-label={copy.notices}>
    <Container>
      <ul class="usp-still">
        {deliveryFacts.map((fact) => <li>{[fact.title, fact.detail].filter(Boolean).join(": ")}</li>)}
      </ul>
    </Container>
  </section>
)}

<style>
  .usp-grid,
  .usp-still,
  .usp-single {
    margin: 0;
    padding: 0;
    list-style: none;
    border: var(--theme-surface-border, 1px solid var(--border));
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--theme-surface-shadow, none);
  }

  /* One pixel gap on a border-coloured ground draws the dividers, whatever
     the arrangement (two across on a phone, one row on a computer). */
  .usp-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    background: var(--border);
  }

  .usp-grid > li {
    background: var(--card);
  }

  /* An odd last item spans the row rather than leaving a hole. */
  .usp-grid > li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .usp-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    block-size: 100%;
    padding: 0.75rem;
    color: var(--foreground);
  }

  .usp-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: 9999px;
    background: var(--muted);
  }

  .usp-title {
    display: block;
    font-size: var(--theme-text-sm, 0.875rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .usp-detail {
    display: block;
    color: var(--muted-foreground);
    font-size: var(--theme-text-sm, 0.875rem);
    line-height: 1.4;
  }

  @media (hover: hover) {
    .usp-link:hover { background: color-mix(in oklab, var(--muted) 50%, var(--card)); }
  }

  @media (min-width: 40rem) {
    .usp-grid[data-count="3"] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .usp-grid[data-count="3"] > li:last-child:nth-child(odd) { grid-column: auto; }

    .usp-item {
      align-items: center;
      gap: 0.75rem;
      min-block-size: 4.5rem;
      padding: 0.75rem 1rem;
    }

    .usp-icon {
      inline-size: 2.25rem;
      block-size: 2.25rem;
    }
  }

  @media (min-width: 64rem) {
    .usp-grid[data-count="4"] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .usp-single,
  .usp-still {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 1.5rem;
    padding: 0.625rem 1rem;
    color: var(--foreground);
    font-size: var(--theme-text-sm, 0.875rem);
    text-align: center;
  }

  .usp-single { gap: 0.5rem; }
  .usp-single strong { font-weight: 600; }
</style>
