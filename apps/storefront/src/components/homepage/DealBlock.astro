---
// A deal block (title, "Shop all", then the cards). The deal counts only to
// the end of the running promotion the merchant picked (`dealEndsAt`). More
// than 48 hours out it says when the deal ends ("Ends 31 Dec"); in the last
// 48 hours it counts down. A small script keeps that true after the cached
// page was rendered and removes the line at the end: the page never claims a
// deal is running once it has ended, and without script there is no line at
// all. The line's box is laid out (invisible) from the first paint, so
// showing it shifts nothing.
import type { Product } from "@/lib/api";
import type { HomepageMediaAsset } from "@/lib/api/storefront";
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import type { StorefrontSectionOf } from "@scalius/shared/storefront-theme";
import ProductRail from "./ProductRail.astro";
import Container from "@/components/ui/Container.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import ProductCard from "@/components/cards/ProductCard.astro";
import ProductGrid from "@/components/cards/ProductGrid.astro";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import { dateLocale, formatDateTime } from "@scalius/shared/locale-format";

interface Props {
  section: StorefrontSectionOf<"deal_block">;
  title: string;
  href: string | null;
  products: Product[];
  currencySymbol: string;
  currencyCode: string;
  aboveFold: boolean;
  /** The running promotion's end (`dealEndsAt`), or null for no countdown. */
  endsAt: string | null;
  photo?: HomepageMediaAsset | null;
}

const { section, title, href, products, currencySymbol, currencyCode, aboveFold, endsAt, photo } = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).home;
const headingId = `home-${section.id}-title`;
const DAY_MS = 86_400_000;
// What the line says when the page was rendered; the script replaces it
// before showing it (and again every second inside the last 48 hours).
function lineAt(end: string, now: number): { label: string; clock: string | null } {
  const left = Math.max(0, Math.floor((Date.parse(end) - now) / 1000));
  if (left * 1000 > 2 * DAY_MS) {
    const date = formatDateTime(Date.parse(end), dateLocale(language), { day: "numeric", month: "short", timeZone: "UTC" });
    return { label: copy.endsOn(date), clock: null };
  }
  const pad = (value: number) => String(value).padStart(2, "0");
  return { label: copy.endsIn, clock: `${pad(Math.floor(left / 3600))}:${pad(Math.floor((left % 3600) / 60))}:${pad(left % 60)}` };
}
const line = endsAt ? lineAt(endsAt, Date.now()) : null;
---

<section class="home-section w-full" aria-labelledby={headingId} data-deal-block>
  <Container>
    <div class="deal-surface">
      {photo && <img src={mediaImageUrl(photo.url, 1280)} srcset={mediaImageSrcSet(photo.url)} sizes="100vw" width={photo.width ?? 1280} height={photo.height ?? 720} alt="" loading={aboveFold ? "eager" : "lazy"} decoding="async" class="deal-image" />}
      <SectionHeader id={headingId} title={title} href={href} linkLabel={copy.shopAll} />
      {endsAt && line && (
        <p
          class="deal-line invisible"
          data-deal-countdown
          data-ends-at={endsAt}
          data-label-in={copy.endsIn}
          data-label-on={copy.endsOn("%DATE%")}
          data-locale={dateLocale(language)}
        >
          <span data-deal-label>{line.label}</span>
          <time datetime={endsAt} class="deal-clock" data-deal-remaining hidden={line.clock === null}>{line.clock ?? ""}</time>
        </p>
      )}
      {products.length >= 4 ? (
        <ProductRail title={title} href={null} products={products} currencySymbol={currencySymbol} currencyCode={currencyCode} aboveFold={aboveFold} bare />
      ) : (
        <ProductGrid>
          {products.map((product, index) => (
            <ProductCard product={product} currencySymbol={currencySymbol} currencyCode={currencyCode} index={index} aboveFold={aboveFold} />
          ))}
        </ProductGrid>
      )}
    </div>
  </Container>
</section>

<script>
  // One timer for every deal line on the page; paused while the tab is hidden.
  // Each tick reads the lines again, so a section the theme editor drew
  // again (astro:page-load) keeps counting.
  import { formatDateTime } from "@scalius/shared/locale-format";
  const DAY_MS = 86_400_000;
  const pad = (value: number) => String(value).padStart(2, "0");
  let timer = 0;
  function updateDealCountdowns() {
    const lines = document.querySelectorAll<HTMLElement>("[data-deal-countdown]");
    if (lines.length === 0) {
      window.clearInterval(timer);
      timer = 0;
      return;
    }
    const now = Date.now();
    lines.forEach((line) => {
      const end = Date.parse(line.dataset.endsAt ?? "");
      const leftMs = end - now;
      if (!(leftMs > 0)) {
        line.remove();
        return;
      }
      const label = line.querySelector("[data-deal-label]");
      const clock = line.querySelector<HTMLElement>("[data-deal-remaining]");
      if (leftMs > 2 * DAY_MS) {
        const date = formatDateTime(end, line.dataset.locale || "en", { day: "numeric", month: "short" });
        if (label) label.textContent = (line.dataset.labelOn ?? "").replace("%DATE%", date);
        if (clock) clock.hidden = true;
      } else {
        const left = Math.floor(leftMs / 1000);
        if (label) label.textContent = line.dataset.labelIn ?? "";
        if (clock) {
          clock.hidden = false;
          clock.textContent = `${pad(Math.floor(left / 3600))}:${pad(Math.floor((left % 3600) / 60))}:${pad(left % 60)}`;
        }
      }
      line.classList.remove("invisible");
    });
  }
  function startDealCountdowns() {
    updateDealCountdowns();
    if (!timer && !document.hidden && document.querySelector("[data-deal-countdown]")) timer = window.setInterval(updateDealCountdowns, 1000);
  }
  document.addEventListener("visibilitychange", () => {
    window.clearInterval(timer);
    timer = 0;
    if (!document.hidden) startDealCountdowns();
  });
  document.addEventListener("astro:page-load", startDealCountdowns);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startDealCountdowns, { once: true });
  } else {
    startDealCountdowns();
  }
</script>

<style>
  .deal-surface {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--theme-surface-pad-phone, 0.75rem);
    border: var(--theme-surface-border, 1px solid var(--border));
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--theme-surface-shadow, none);
  }

  .deal-image { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; opacity: 0.06; }

  @media (min-width: 64rem) {
    .deal-surface {
    position: relative;
    isolation: isolate;
    overflow: hidden; padding: var(--theme-surface-pad-desktop, 1.25rem); }
  }

  .deal-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: -0.5rem 0 0.75rem;
    color: var(--muted-foreground);
    font-size: var(--theme-text-sm, 0.875rem);
  }

  .deal-clock {
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .deal-clock[hidden] { display: none; }
</style>
