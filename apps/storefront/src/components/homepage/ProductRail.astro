---
// A horizontal product rail: CSS scroll-snap, so it scrolls by touch,
// trackpad and keyboard with no script. The arrows are a small
// progressive enhancement (from 1024px; phones swipe).
// - `collection`: a homepage carousel collection (72% of a phone, then 3, 4
//   and 5 across).
// - `shelf`: a section rail: 2.2 cards on a phone so the next card peeks in,
//   then exactly 3, 4 and 5 across inside the container. Fewer than 4 cards
//   are not a rail: they render as a static grid.
import type { Product } from "@/lib/api";
import ProductCard from "@/components/cards/ProductCard.astro";
import ProductGrid from "@/components/cards/ProductGrid.astro";
import Container from "@/components/ui/Container.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Icon from "@/components/icons/Icon.astro";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";

interface Props {
  title: string;
  /** Where the whole list lives ("View all"); none for lists no listing shows. */
  href: string | null;
  hrefLabel?: string;
  products: Product[];
  currencySymbol?: string;
  currencyCode?: string;
  /** The rail starts in the first viewport (first photos load eagerly). */
  aboveFold?: boolean;
  width?: "collection" | "shelf";
  /** Unique within the page: the heading's id. */
  headingId?: string;
  /** Only the scrolling track (inside a section that draws its own title, a deal block). */
  bare?: boolean;
}

const {
  title,
  href,
  hrefLabel,
  products,
  currencySymbol = DEFAULT_CURRENCY.symbol,
  currencyCode = DEFAULT_CURRENCY.code,
  aboveFold = false,
  width = "shelf",
  headingId,
  bare = false,
} = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).home;
const shelf = width === "shelf";
const itemClass = shelf
  ? "home-shelf-item shrink-0 snap-start"
  : "w-[72%] shrink-0 snap-start sm:w-[calc((100%_-_2rem)/3)] lg:w-[calc((100%_-_3rem)/4)] xl:w-[calc((100%_-_4rem)/5)]";
---

{bare && (
  <div class="home-rail-track flex snap-x snap-mandatory gap-3 overflow-x-auto py-2 [scrollbar-width:none] md:gap-4 [&::-webkit-scrollbar]:hidden">
    {products.map((product, index) => (
      <div class={itemClass}>
        <ProductCard product={product} currencySymbol={currencySymbol} currencyCode={currencyCode} context="shelf" index={index} aboveFold={aboveFold} />
      </div>
    ))}
  </div>
)}

{!bare && shelf && products.length > 0 && products.length < 4 && (
  <section class="home-section w-full" aria-labelledby={headingId}>
    <Container>
      <SectionHeader id={headingId} title={title} href={href} linkLabel={hrefLabel} />
      <ProductGrid>
        {products.map((product, index) => (
          <ProductCard product={product} currencySymbol={currencySymbol} currencyCode={currencyCode} index={index} aboveFold={aboveFold} />
        ))}
      </ProductGrid>
    </Container>
  </section>
)}

{
  !bare && products.length >= (shelf ? 4 : 1) && (
    <section class="home-section w-full overflow-hidden" aria-labelledby={headingId} data-product-rail>
      <Container>
        <SectionHeader id={headingId} title={title} href={href} linkLabel={hrefLabel}>
          <Fragment slot="actions">
            {products.length > 1 && (
              <div class="hidden items-center gap-2 lg:flex">
                <button type="button" data-rail-direction="previous" class="home-rail-arrow" aria-label={copy.previousProducts(title)}>
                  <Icon name="chevron-left" class="h-4 w-4" />
                </button>
                <button type="button" data-rail-direction="next" class="home-rail-arrow" aria-label={copy.nextProducts(title)}>
                  <Icon name="chevron-right" class="h-4 w-4" />
                </button>
              </div>
            )}
          </Fragment>
        </SectionHeader>

        <div class="-mx-4 px-4 sm:mx-0 sm:px-0">
          <div
            data-product-rail-track
            class="home-rail-track flex snap-x snap-mandatory gap-3 overflow-x-auto py-2 [scrollbar-width:none] md:gap-4 [&::-webkit-scrollbar]:hidden"
          >
            {products.map((product, index) => (
              <div class={itemClass}>
                <ProductCard
                  product={product}
                  currencySymbol={currencySymbol}
                  currencyCode={currencyCode}
                  context={shelf ? "shelf" : "rail"}
                  index={index}
                  aboveFold={aboveFold}
                />
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )
}

<script>
  function initializeProductRails() {
    document.querySelectorAll<HTMLElement>("[data-product-rail]").forEach((rail) => {
      if (rail.dataset.ready === "true") return;
      rail.dataset.ready = "true";
      const track = rail.querySelector<HTMLElement>("[data-product-rail-track]");
      if (!track) return;
      rail.querySelectorAll<HTMLButtonElement>("[data-rail-direction]").forEach((button) => {
        button.addEventListener("click", () => {
          // "Next" scrolls toward the line's end: leftward on a right-to-left page.
          const forward = getComputedStyle(track).direction === "rtl" ? -1 : 1;
          const direction = (button.dataset.railDirection === "previous" ? -1 : 1) * forward;
          track.scrollBy({
            left: direction * Math.max(240, track.clientWidth * 0.8),
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "auto"
              : "smooth",
          });
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initializeProductRails);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeProductRails, { once: true });
  } else {
    initializeProductRails();
  }
</script>

<style>
  /* Cards across: 2.2 on a phone (the next one peeks in), then exactly 3, 4
     and 5 inside the container. SHELF_CARD_SIZES (lib/product-card-layout.ts)
     follows these widths. */
  .home-rail-track {
    --rail-gap: 0.75rem;
  }

  @media (min-width: 48rem) {
    .home-rail-track { --rail-gap: 1rem; }
  }

  .home-shelf-item {
    width: 44%;
  }

  @media (min-width: 40rem) {
    .home-shelf-item { width: calc((100% - 2 * var(--rail-gap)) / 3); }
  }

  @media (min-width: 64rem) {
    .home-shelf-item { width: calc((100% - 3 * var(--rail-gap)) / 4); }
  }

  @media (min-width: 80rem) {
    .home-shelf-item { width: calc((100% - 4 * var(--rail-gap)) / 5); }
  }

  .home-rail-arrow {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background: var(--background);
    color: var(--foreground);
    cursor: pointer;
    transition: border-color var(--theme-duration-fast, 150ms) ease-out;
  }

  @media (hover: hover) {
    .home-rail-arrow:hover { border-color: var(--foreground); }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-rail-arrow { transition: none; }
  }
</style>
