---
// "Just for you" (Daraz): the newest products in the store's grid, then a
// "Load more" that is a real link to the next page of the full listing
// (/search?page=n, crawlable and working without script). With script, it
// fetches that page and appends its cards here instead, skipping cards
// already shown, until the listing runs out.
import type { Product } from "@/lib/api";
import type { StorefrontSectionOf } from "@scalius/shared/storefront-theme";
import ProductCard from "@/components/cards/ProductCard.astro";
import ProductGrid from "@/components/cards/ProductGrid.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";

import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import Container from "@/components/ui/Container.astro";

interface Props {
  section: StorefrontSectionOf<"endless_grid">;
  title: string;
  products: Product[];
  currencySymbol: string;
  currencyCode: string;
  aboveFold: boolean;
}

const { section, title, products, currencySymbol, currencyCode, aboveFold } = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).home;
const headingId = `home-${section.id}-title`;
/** The listing's page size (lib/product-list-query.ts). */
const LISTING_PAGE_SIZE = 20;
const nextPage = Math.floor(products.length / LISTING_PAGE_SIZE) + 1;
const nextHref = nextPage > 1 ? `/search?page=${nextPage}` : "/search";
---

<section class="home-section w-full" aria-labelledby={headingId} data-endless-grid>
  <Container>
    <SectionHeader id={headingId} title={title} />
    <ProductGrid>
      {products.map((product, index) => (
        <ProductCard product={product} currencySymbol={currencySymbol} currencyCode={currencyCode} index={index} aboveFold={aboveFold} />
      ))}
    </ProductGrid>
    <div class="mt-5 flex justify-center">
      <a
        href={nextHref}
        data-endless-more
        class="inline-flex min-h-11 min-w-48 items-center justify-center rounded-full border border-border bg-card px-6 text-sm font-semibold text-foreground transition-colors hover:border-primary"
      >
        {copy.loadMore}
      </a>
    </div>
  </Container>
</section>

<script>
  import { setupEndlessGrids } from "./endless-grid";

  document.addEventListener("astro:page-load", setupEndlessGrids);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupEndlessGrids, { once: true });
  } else {
    setupEndlessGrids();
  }
</script>
