---
// A section an installed app draws (`type: "app"`): drawn here by the app's
// storefront module (docs/STOREFRONT-COMPONENTS.md) from its settings, the
// images they name and the product cards of its product settings, priced in
// the page's market. HomepageSections renders it only when there is
// something to show; a component that draws nothing, fails or is late
// renders nothing.
import AppComponent from "@/components/apps/AppComponent.astro";
import OrderForm from "@/components/checkout/OrderForm.astro";
import type { StorefrontAppSection } from "@scalius/shared/storefront-theme";
import { resolvePluginSettingBindings } from "@scalius/shared/storefront-theme/bindings";
import { storefrontSettingNeeds } from "@scalius/shared/plugins/storefront-components";
import { bindingResourceMedia } from "@/lib/setting-bindings";
import type { HomepageAppSurface } from "@/lib/app-surfaces";
import { appMarkup, requestExtensions, type AppMarkup } from "@/lib/extensions";
import { orderFormEmbed, type EmbedRender } from "@/lib/extensions/embeds";
import { componentSectionSettings, productCardData, sectionObjectsOf, storefrontImageOf } from "@/lib/extensions/data";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { productCardModel, type ProductCardProduct } from "@/components/cards/card-model";
import { getLayoutData } from "@/lib/api/storefront";
import type { HomepageMediaAsset } from "@/lib/api/storefront";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";

interface Props {
  section: StorefrontAppSection;
  surface: HomepageAppSurface;
  headerLead?: boolean;
  sourceMedia?: readonly HomepageMediaAsset[];
}

const { section, surface, headerLead = false, sourceMedia = [] } = Astro.props;
const { component } = surface;
const libraryPreview = (Astro.locals as { sectionLibraryPreview?: boolean }).sectionLibraryPreview === true;
let html: string | null = null;
let markup: AppMarkup | null = null;
let preview = false;
/** The products the component was given (id to handle): its order-form embeds may name only these. */
const embedProducts = new Map<string, string>();
const { byId, host } = await requestExtensions(Astro.locals, Astro.url);
const extension = byId.get(component.pluginId);
const schema = extension?.sectionSettings[component.type];
if (extension && schema && extension.sections.includes(component.type)) {
  const [{ resolved, preview: themePreview, bindingContext }, layoutData] = await Promise.all([currentRequestTheme(Astro.locals), getLayoutData()]);
  preview = themePreview !== null;
  const currency = { symbol: layoutData?.currency?.symbol ?? DEFAULT_CURRENCY.symbol, code: layoutData?.currency?.code ?? DEFAULT_CURRENCY.code };
  const media = new Map([...component.media, ...sourceMedia, ...bindingResourceMedia(bindingContext.resource)].flatMap((asset) => {
    const image = storefrontImageOf(asset);
    return image ? [[asset.id, image] as const] : [];
  }));
  const products = new Map(component.lists.map((list) => [list.source, list.products.map((product) => {
    const card = product as ProductCardProduct;
    embedProducts.set(card.id, card.slug);
    const model = productCardModel(card, {
      currencySymbol: currency.symbol,
      currencyCode: currency.code,
      // The app decides whether to show the second photo.
      hoverImage: true,
      ratings: resolved.facts.hasReviews,
    });
    return productCardData(card, model, { currencyCode: currency.code, currencySymbol: currency.symbol });
  })]));
  const values = resolvePluginSettingBindings(schema, { ...component.values, ...section.settings.values }, section.bindings, { ...bindingContext, mediaIds: new Set(media.keys()) });
  for (const field of schema) {
    if (!["image", "product", "products"].includes(field.type)) continue;
    const needs = storefrontSettingNeeds([field], values);
    if (needs.mediaIds.some((id) => !media.has(id)) || needs.products.some(({ source }) => !(products.get(source)?.length))) values[field.key] = component.values[field.key] ?? null;
  }
  html = await host.render(extension, {
    kind: "section",
    type: component.type,
    instanceId: section.id,
    ...(component.objects ? { objects: sectionObjectsOf(component.objects, { currencyCode: currency.code, currencySymbol: currency.symbol }) } : {}),
    settings: componentSectionSettings(schema, values, media, products),
  });
  markup = appMarkup(extension, "section", html);
}
---

{/* Public guard for a header that used this declared lead before the app rendered. */}
{headerLead && !html?.trim() && <template data-scalius-lead-empty></template>}
{/* Only the isolated library reports a failed module; a valid empty string
    still means the app intentionally has nothing to display. */}
{libraryPreview && html === null && <template data-library-render-failed></template>}
{markup && <AppComponent markup={markup} embeds={{ "order_form": orderFormEmbed(OrderForm as EmbedRender["component"], embedProducts, { instanceId: section.id, preview }) }} />}
