---
import { getOptimizedImageUrl, getResponsiveSrcSet } from "@/lib/image-optimizer";
import type { HomepageData } from "@/lib/api/storefront";

type CategoryRail = HomepageData["presentation"]["categoryRail"];

interface Props {
  rail: CategoryRail;
}

const { rail } = Astro.props;
const categories = rail.enabled ? rail.categories : [];
---

{categories.length > 0 && (
  <section class="w-full py-3 md:py-7" aria-labelledby="homepage-category-rail-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-3 flex items-end justify-between md:mb-4">
        <h2 id="homepage-category-rail-title" class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">
          {rail.title}
        </h2>
        <span class="hidden text-xs text-muted-foreground sm:block">Explore by department</span>
      </div>

      <div class="homepage-category-scroll -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-1 sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0 md:grid-cols-5">
        {categories.map((category) => {
          const href = category.canonicalPath || `/categories/${encodeURIComponent(category.slug)}`;
          const src = category.imageUrl
            ? getOptimizedImageUrl(category.imageUrl, {
                width: 520,
                height: 620,
                fit: "cover",
                gravity: "center",
                quality: 84,
                format: "auto",
              })
            : null;
          const srcset = category.imageUrl
            ? getResponsiveSrcSet(category.imageUrl, [240, 360, 520], {
                height: 620,
                fit: "cover",
                gravity: "center",
                quality: 84,
                format: "auto",
              })
            : null;

          return (
            <a
              href={href}
              class="group relative block aspect-[4/5] w-[42vw] max-w-44 shrink-0 snap-start overflow-hidden rounded-xl bg-muted sm:w-auto sm:max-w-none"
              aria-label={`Browse ${category.name}`}
            >
              {src ? (
                <img
                  src={src}
                  srcset={srcset || undefined}
                  sizes="(max-width: 639px) 42vw, (max-width: 767px) 33vw, 20vw"
                  alt=""
                  width="520"
                  height="620"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.025] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                />
              ) : (
                <div class="h-full w-full bg-gradient-to-br from-muted to-accent" aria-hidden="true"></div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/5 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-3 md:p-4">
                <span class="text-sm font-semibold leading-tight text-white drop-shadow-sm md:text-base">
                  {category.name}
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .homepage-category-scroll {
    scrollbar-width: none;
  }

  .homepage-category-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
