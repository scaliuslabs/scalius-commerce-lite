---
// The collections the section names (its `collectionIds`), each in its own
// presentation (grid or carousel), in the section's order; only active ones
// with products arrive. Without one the section shows the newest products
// instead, so a store with products never has a blank homepage. A
// carousel's cards are large, or Apple Gadgets' compact shelf
// (`carousel: compact`).
import type { StorefrontSectionOf } from "@scalius/shared/storefront-theme";
import type { CollectionWithProducts, Product } from "@/lib/api";
import { collectionShowsProducts } from "@/lib/homepage-sections";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import ProductGridSection from "./ProductGridSection.astro";
import ProductRail from "./ProductRail.astro";

interface Props {
  section: StorefrontSectionOf<"collections">;
  /** `homepageCollections(section, content)`: the section's collections that show products. */
  collections: CollectionWithProducts[];
  fallbackProducts: Product[];
  currencySymbol: string;
  currencyCode: string;
  /** The section leads the page: the first collection that shows products loads its first row eagerly. */
  lead: boolean;
}

const { section, collections, fallbackProducts, currencySymbol, currencyCode, lead } = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).home;
const RAIL_WIDTH = { large: "collection", compact: "shelf" } as const satisfies Record<typeof section.settings.carousel, "collection" | "shelf">;
const railWidth = RAIL_WIDTH[section.settings.carousel];
// Only the first collection that shows products can sit above the fold.
const firstShownCollectionId = collections.find(collectionShowsProducts)?.id;

function gridProducts(collection: CollectionWithProducts): Product[] {
  const products = collection.products ?? [];
  const featured = collection.featuredProduct;
  return (featured ? [featured, ...products.filter((product) => product.id !== featured.id)] : products)
    .slice(0, collection.config?.maxProducts || 8);
}

const collectionHref = (collection: CollectionWithProducts) => `/collections/${encodeURIComponent(collection.id)}`;
---

{collections.map((collection) => (
  <Fragment>
    {collection.presentation === "grid" && (
      <ProductGridSection
        title={collection.config?.title || collection.name}
        products={gridProducts(collection)}
        href={collectionHref(collection)}
        collection={{ subtitle: collection.config?.subtitle || "" }}
        headingId={`home-collection-${collection.id}-title`}
        currencySymbol={currencySymbol}
        currencyCode={currencyCode}
        aboveFold={lead && collection.id === firstShownCollectionId}
      />
    )}
    {collection.presentation === "carousel" && (
      <ProductRail
        width={railWidth}
        headingId={`home-collection-${collection.id}-title`}
        title={collection.config?.title || collection.name}
        products={collection.products ?? []}
        href={collectionHref(collection)}
        currencySymbol={currencySymbol}
        currencyCode={currencyCode}
        aboveFold={lead && collection.id === firstShownCollectionId}
      />
    )}
  </Fragment>
))}

{fallbackProducts.length > 0 && (
  <ProductGridSection
    title={section.settings.title || copy.newArrivals}
    headingId="home-products-title"
    products={fallbackProducts}
    href="/search"
    currencySymbol={currencySymbol}
    currencyCode={currencyCode}
    aboveFold={lead && !firstShownCollectionId}
  />
)}
