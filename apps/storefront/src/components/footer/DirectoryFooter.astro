---
// directory (Daraz, Amazon): customer care first, then a dense directory of
// the store's footer menus (each link and its children) for large
// catalogues. Capped at about 60 curated links: Daraz ships 431, which is
// heavy; the fit rule only offers it with 8 or more top categories.
import type { FooterModel } from "./footer-model";
import { directoryLinks } from "./footer-model";
import { ltr } from "@/lib/bidi";
import { mediaImageUrl } from "@/lib/media-url";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import { formatCount } from "@/lib/store-time-zone";

interface Props {
  model: FooterModel;
  marketplace?: boolean;
}

const { model, marketplace = false } = Astro.props;
const { brandName, tagline, phoneHref, chatHref, storePhone, storeEmail, logo } = model;
const directory = directoryLinks(model.menus);
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).chrome;
---

<div class="directory-footer" data-marketplace={marketplace ? "" : undefined}>
  <section class="directory-care" aria-labelledby="footer-care-title">
    <h2 id="footer-care-title" class="footer-heading">{brandName || copy.footer.contactUs}</h2>
    {tagline && <p>{tagline}</p>}
    <ul class="directory-care-links">
      {
        phoneHref && (
          <li>
            <a href={phoneHref} data-footer-contact>
              {copy.footer.call(ltr(storePhone))}
            </a>
          </li>
        )
      }
      {
        chatHref && (
          <li>
            <a href={chatHref} target="_blank" rel="noopener noreferrer">
              {copy.footer.whatsapp}
            </a>
          </li>
        )
      }
      {
        storeEmail && (
          <li>
            <a href={`mailto:${storeEmail}`}>{storeEmail}</a>
          </li>
        )
      }
    </ul>
  </section>

  {
    directory.length > 0 && (
      <nav class="directory-links" aria-label={copy.footer.storeDirectory}>
        {directory.map((menu) => {
          const compact = !marketplace && menu.links.length > 8;
          const visible = compact ? menu.links.slice(0, 4) : menu.links;
          const more = compact ? menu.links.slice(4) : [];
          return (
            <section>
              <h2 class="footer-heading">{menu.title}</h2>
              <ul>
                {visible.map((link) => (
                  <li>
                    <a href={link.href} {...(link.openInNewTab ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                      {link.title}
                    </a>
                  </li>
                ))}
              </ul>
              {compact && (
                <details class="directory-more">
                  <summary>
                    <span class="when-closed">{copy.footer.showMoreLinks(formatCount(more.length), menu.title)}</span>
                    <span class="when-open">{copy.footer.hideExtraLinks(menu.title)}</span>
                  </summary>
                  <ul>
                    {more.map((link) => (
                      <li>
                        <a href={link.href} {...(link.openInNewTab ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                          {link.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          );
        })}
      </nav>
    )
  }
  {marketplace && (logo.src || brandName) && (
    <div class="directory-identity" data-footer-identity>
      {logo.src ? (
        <img src={mediaImageUrl(logo.src, 320)} alt={brandName || copy.home} width="160" height="48" loading="lazy" decoding="async" />
      ) : (
        <span>{brandName}</span>
      )}
    </div>
  )}
</div>

<style is:global>
  /* Global, written as Astro scoped it: each `:not(.\#)` (always true) carries
     the weight of the scope attribute it replaces, so the cascade is unchanged
     and no element carries data-astro-cid-* (it repeated on every element). */
  .directory-footer:not(.\#) {
    display: grid;
    gap: 1.75rem;
    padding-block: 0.75rem 0.5rem;
  }

  @media (min-width: 64rem) {
    .directory-footer:not(.\#) {
      grid-template-columns: minmax(14rem, 1fr) minmax(0, 3fr);
      gap: 3rem;
    }
  }

  /* .footer-heading is shared by every footer: the root class stands for the scope here (same weight). */
  .directory-footer .footer-heading {
    margin-bottom: 0.625rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .directory-care:not(.\#) {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.875rem;
  }

  .directory-care-links:not(.\#) a:not(.\#),
  .directory-links:not(.\#) a:not(.\#) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    overflow-wrap: anywhere;
  }

  /* A dense directory on computers (28px rows); phones keep 44px targets. */
  @media (min-width: 40rem) {
    .directory-care-links:not(.\#) a:not(.\#),
    .directory-links:not(.\#) a:not(.\#) {
      min-height: 1.75rem;
    }
  }

  .directory-links:not(.\#) {
    columns: 11rem;
    column-gap: 2rem;
  }

  .directory-links:not(.\#) section:not(.\#) {
    break-inside: avoid;
    margin-bottom: 1.25rem;
  }

  .directory-more:not(.\#) summary:not(.\#) {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 700;
    list-style: none;
  }

  .directory-more:not(.\#) summary:not(.\#)::-webkit-details-marker,
  .directory-more[open]:not(.\#) .when-closed:not(.\#),
  .directory-more:not([open]):not(.\#) .when-open:not(.\#) {
    display: none;
  }

  .directory-more:not(.\#) summary:focus-visible:not(.\#) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .directory-footer:not(.\#) a:hover:not(.\#) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .directory-footer:not(.\#) a:focus-visible:not(.\#) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .directory-footer[data-marketplace]:not(.\#) {
    gap: 1.5rem;
    padding: 0;
  }

  .directory-footer[data-marketplace]:not(.\#) .directory-links:not(.\#) {
    columns: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  .directory-footer[data-marketplace]:not(.\#) .directory-links:not(.\#) section:not(.\#) {
    margin: 0;
  }

  .directory-footer[data-marketplace]:not(.\#) .footer-heading:not(.\#) {
    margin-bottom: 0.375rem;
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .directory-footer[data-marketplace]:not(.\#) .directory-links:not(.\#) a:not(.\#),
  .directory-footer[data-marketplace]:not(.\#) .directory-care-links:not(.\#) a:not(.\#) {
    width: 100%;
    min-height: 2.75rem;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  .directory-footer[data-marketplace]:not(.\#) .directory-identity:not(.\#) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .directory-footer[data-marketplace]:not(.\#) .directory-identity:not(.\#) img:not(.\#) {
    width: auto;
    max-width: 10rem;
    height: auto;
    max-height: 3rem;
    object-fit: contain;
  }

  @media (min-width: 40rem) {
    .directory-footer[data-marketplace]:not(.\#) .directory-links:not(.\#) {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }

    .directory-footer[data-marketplace]:not(.\#) .directory-links:not(.\#) a:not(.\#),
    .directory-footer[data-marketplace]:not(.\#) .directory-care-links:not(.\#) a:not(.\#) {
      min-height: 1.75rem;
    }
  }

  @media (min-width: 64rem) {
    .directory-footer[data-marketplace]:not(.\#) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      gap: 2.5rem;
    }

    .directory-footer[data-marketplace]:not(.\#) .directory-identity:not(.\#) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const wideDirectory = window.matchMedia("(min-width: 40rem)");
  const syncDirectoryMenus = () => {
    document.querySelectorAll<HTMLDetailsElement>(".directory-footer:not([data-marketplace]) .directory-more").forEach((menu) => {
      menu.open = wideDirectory.matches;
    });
  };
  syncDirectoryMenus();
  wideDirectory.addEventListener("change", syncDirectoryMenus);
</script>
