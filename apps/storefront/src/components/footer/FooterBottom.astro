---
// The row under every footer: policies (unless the variant lists them
// above), copyright, "Track your order" when no menu carries it, and the
// social links (the merchant's icon, else the network's built-in glyph by
// host, else the first letter of the label).
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { TRACK_ORDER_PATH } from "@/lib/footer-links";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import { socialGlyph, socialGlyphMarkup } from "./social-icons";
import type { FooterModel } from "./footer-model";

interface Props {
  model: FooterModel;
  showPolicies?: boolean;
  marketplace?: boolean;
}

const { model, showPolicies = true, marketplace = false } = Astro.props;
const { policyLinks, copyrightName, trackOrderInBottomRow, social } = model;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).chrome;
const year = new Date().getFullYear();
const rights = copyrightName ? copy.footer.rights(year, copyrightName) : copy.footer.rightsNoName(year);
---

<div class:list={[marketplace ? "py-6" : "mt-6 pt-5 border-t border-border"]}>
  <div class:list={["flex flex-col sm:flex-row items-center gap-6", marketplace ? "justify-center" : "justify-between"]}>
    <div class="flex flex-col items-center gap-2 text-sm sm:items-start">
      {
        showPolicies && policyLinks.length > 0 && (
          <nav aria-label={copy.footer.storePolicies}>
            <ul class="flex flex-wrap justify-center gap-x-4 gap-y-1 sm:justify-start">
              {policyLinks.map((link) => (
                <li>
                  <a href={link.href} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline sm:min-h-0">
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <span class="text-center sm:text-start">{rights}</span>
      {trackOrderInBottomRow && (
        <a href={TRACK_ORDER_PATH} class="inline-flex min-h-11 items-center underline underline-offset-4 sm:min-h-0">
          {copy.footer.trackOrder}
        </a>
      )}
    </div>

    {
      social.length > 0 && (
        <ul class="flex items-center justify-center gap-3 flex-wrap">
          {social.map((item) => {
            const href = item.url;
            const glyph = socialGlyph(item.url, item.label);
            const displayTitle = item.label || (glyph ? glyph.charAt(0).toUpperCase() + glyph.slice(1) : copy.footer.social);

            return (
              <li>
                <a
                  href={href}
                  data-astro-prefetch={getStorefrontPrefetchAttribute(href, Astro.url)}
                  class="footer-social"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={displayTitle}
                  title={displayTitle}
                >
                  {item.optimizedIconUrl ? (
                    <img src={item.optimizedIconUrl} alt="" aria-hidden="true" class="w-5 h-5 object-contain" loading="lazy" />
                  ) : glyph ? (
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={socialGlyphMarkup(glyph)} />
                  ) : (
                    <span aria-hidden="true" class="font-bold text-sm uppercase">
                      {displayTitle.charAt(0)}
                    </span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</div>

<style is:global>
  .footer-social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--secondary-foreground) 10%, transparent);
    transition: background-color 150ms ease;
  }

  .footer-social:hover {
    background: color-mix(in srgb, var(--secondary-foreground) 16%, transparent);
  }

  .footer-social:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .footer-social svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
