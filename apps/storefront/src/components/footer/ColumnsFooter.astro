---
// minimal-columns and product-widgets (product lists wait for product data
// in the layout read, so both render the columns): the logo, tagline and
// call line, the about text, then one group per footer menu (FooterMenus:
// columns on computers, accordions on phones).
import RichTextStyles from "../RichTextStyles.astro";
import FooterMenus from "./FooterMenus.astro";
import { mediaImageUrl } from "@/lib/media-url";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import type { FooterModel } from "./footer-model";

interface Props {
  model: FooterModel;
}

const {
  logo,
  brandName,
  tagline,
  phoneHref,
  chatHref,
  storePhone,
  storeEmail,
  storeAddress,
  about,
  menus,
} = Astro.props.model;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).chrome;
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
  <div class="lg:col-span-4">
    {/* No logo and no store name: no empty link to tab onto. */}
    {(logo.src || brandName) && (
      <a href="/" class="inline-block">
        {
          logo.src ? (
            <img
              src={mediaImageUrl(logo.src, 480)}
              alt={brandName || copy.home}
              width={344}
              height={256}
              loading="lazy"
              decoding="async"
              class="h-12 sm:h-14 w-auto object-contain"
            />
          ) : (
            <span class="text-lg font-bold">{brandName}</span>
          )
        }
      </a>
    )}
    {
      tagline && (
        <p class="mt-3 text-base font-medium leading-relaxed max-w-md">
          {tagline}
        </p>
      )
    }

    {
      (phoneHref || chatHref || storeEmail || storeAddress) && (
        <ul class="mt-3 flex flex-col gap-1 text-base" data-footer-contact>
          {phoneHref && (
            <li>
              {copy.footer.callUs}{" "}
              <a href={phoneHref} class="font-semibold underline underline-offset-4">
                <bdi dir="ltr">{storePhone}</bdi>
              </a>
            </li>
          )}
          {chatHref && (
            <li>
              <a href={chatHref} target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-4">{copy.footer.whatsapp}</a>
            </li>
          )}
          {storeEmail && (
            <li>
              <a href={`mailto:${storeEmail}`} class="underline underline-offset-4">{storeEmail}</a>
            </li>
          )}
          {storeAddress && <li><address class="not-italic">{storeAddress}</address></li>}
        </ul>
      )
    }

    {/* The footer's about text: plain paragraphs, escaped. */}
    {about.length > 0 && <RichTextStyles />}
    {
      about.length > 0 && (
        <div
          class="mt-2 text-base text-inherit leading-relaxed max-w-md prose prose-base [&_*]:text-inherit prose-p:my-1 prose-p:leading-relaxed prose-a:underline prose-pre:bg-transparent"
          data-footer-about
        >
          {about.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
        </div>
      )
    }
  </div>

  <div class="lg:col-span-8">
    <FooterMenus menus={menus} />
  </div>
</div>
