---
// newsletter-grey (Fabrilife): on the muted surface, centred. The logo, the
// newsletter signup (the same form as the homepage section, posting to the
// store's signup endpoint; left out on a homepage that shows that section),
// the links grouped under their headings (menus and policies: columns on
// computers, accordions on phones), the hotline with WhatsApp, and the
// tagline as the sub-footer line.
import NewsletterForm from "@/components/newsletter/NewsletterForm.astro";
import FooterMenus from "./FooterMenus.astro";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import { mediaImageUrl } from "@/lib/media-url";
import type { NewsletterFormModel } from "@/lib/newsletter-form";
import type { FooterModel } from "./footer-model";

interface Props {
  model: FooterModel;
  /** The signup form, or null where the page already has one. */
  signup: NewsletterFormModel | null;
}

const { model, signup } = Astro.props;
const { logo, brandName, tagline, phoneHref, chatHref, storePhone, menus, policyLinks } = model;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).chrome;
const groups = [
  ...menus,
  ...(policyLinks.length > 0 ? [{ title: copy.footer.policies, links: policyLinks }] : []),
];
---

<div class="newsletter-footer">
  {
    (logo.src || brandName) && (
      <a href="/" class="newsletter-logo">
        {logo.src ? (
          <img src={mediaImageUrl(logo.src, 480)} alt={brandName || copy.home} width={344} height={256} loading="lazy" decoding="async" />
        ) : (
          <span>{brandName}</span>
        )}
      </a>
    )
  }

  {
    signup && (
      <section class="newsletter-signup" aria-labelledby="footer-newsletter-title" data-footer-newsletter>
        <h2 id="footer-newsletter-title">{signup.heading}</h2>
        <p>{signup.text}</p>
        <NewsletterForm model={signup} idPrefix="footer-newsletter" class="mt-3" />
      </section>
    )
  }

  <div class="newsletter-menus">
    <FooterMenus menus={groups} label={copy.footer.footerLinks} />
  </div>

  {
    (phoneHref || chatHref) && (
      <div class="newsletter-hotline" data-footer-contact>
        <p>{copy.footer.hotline}</p>
        <div>
          {phoneHref && (
            <a href={phoneHref} class="newsletter-phone">
              <bdi dir="ltr">{storePhone}</bdi>
            </a>
          )}
          {chatHref && (
            <a href={chatHref} target="_blank" rel="noopener noreferrer" class="newsletter-chat">
              {copy.footer.whatsapp}
            </a>
          )}
        </div>
      </div>
    )
  }

  {tagline && <p class="newsletter-tagline">{tagline}</p>}
</div>

<style>
  .newsletter-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1rem 0.25rem;
    text-align: center;
  }

  .newsletter-logo img {
    width: auto;
    height: 2.5rem;
    object-fit: contain;
  }

  .newsletter-logo span {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .newsletter-menus {
    width: 100%;
    text-align: start;
  }

  .newsletter-phone,
  .newsletter-chat {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .newsletter-chat:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .newsletter-hotline p {
    font-size: 0.875rem;
  }

  .newsletter-hotline div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 1.25rem;
  }

  .newsletter-phone {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .newsletter-chat {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .newsletter-tagline {
    max-width: 40rem;
    font-size: 0.875rem;
  }

  .newsletter-signup {
    width: 100%;
    max-width: 40rem;
  }

  .newsletter-signup h2 {
    font-size: 1.125rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .newsletter-signup > p {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .newsletter-footer a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
