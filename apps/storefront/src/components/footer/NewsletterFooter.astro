---
// newsletter-grey (Fabrilife): on the muted surface, centred. The logo, one
// band of links (menus and policies), the hotline ("For any help, call us")
// with WhatsApp, and the tagline as the sub-footer line. The newsletter
// field joins when the store has a subscription endpoint; until then it is
// left out rather than shown as a form that goes nowhere.
import { mediaImageUrl } from "@/lib/media-url";
import type { FooterModel } from "./footer-model";

interface Props {
  model: FooterModel;
}

const { model } = Astro.props;
const { logo, brandName, tagline, phoneHref, chatHref, storePhone, flatLinks } = model;
---

<div class="newsletter-footer">
  {
    (logo.src || brandName) && (
      <a href="/" class="newsletter-logo">
        {logo.src ? (
          <img src={mediaImageUrl(logo.src, 480)} alt={brandName || "Home"} width={344} height={256} loading="lazy" decoding="async" />
        ) : (
          <span>{brandName}</span>
        )}
      </a>
    )
  }

  {
    flatLinks.length > 0 && (
      <nav aria-label="Footer">
        <ul class="newsletter-links">
          {flatLinks.map((link) => (
            <li>
              <a href={link.href}>{link.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    (phoneHref || chatHref) && (
      <div class="newsletter-hotline" data-footer-contact>
        <p>For any help, call us</p>
        <div>
          {phoneHref && (
            <a href={phoneHref} class="newsletter-phone">
              {storePhone}
            </a>
          )}
          {chatHref && (
            <a href={chatHref} target="_blank" rel="noopener noreferrer" class="newsletter-chat">
              WhatsApp
            </a>
          )}
        </div>
      </div>
    )
  }

  {tagline && <p class="newsletter-tagline">{tagline}</p>}
</div>

<style>
  .newsletter-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1rem 0.25rem;
    text-align: center;
  }

  .newsletter-logo img {
    width: auto;
    height: 2.5rem;
    object-fit: contain;
  }

  .newsletter-logo span {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .newsletter-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1.25rem;
    max-width: 56rem;
  }

  .newsletter-links li {
    min-width: 0;
    max-width: 100%;
  }

  .newsletter-links a,
  .newsletter-phone,
  .newsletter-chat {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .newsletter-links a:hover,
  .newsletter-chat:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .newsletter-hotline p {
    font-size: 0.875rem;
  }

  .newsletter-hotline div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 1.25rem;
  }

  .newsletter-phone {
    font-size: 1.375rem;
    font-weight: 700;
  }

  .newsletter-chat {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .newsletter-tagline {
    max-width: 40rem;
    font-size: 0.875rem;
  }

  .newsletter-footer a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
