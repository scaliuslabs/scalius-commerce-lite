---
/**
 * The core consent banner (lead decision D6). Code-owned and theme-tokened:
 * the page's own background, text, border and primary colours. It is fixed
 * to the bottom, so showing it shifts nothing (CLS), and its text is small
 * so it never becomes the page's largest paint. The head boot script decides
 * on first paint whether it shows (`html[data-consent-banner]`); the runtime
 * script below wires the buttons. Without JavaScript no tag runs at all, so
 * the banner stays hidden and the defaults apply.
 *
 * The "Your privacy choices" link sits after the footer: it reopens the
 * banner with the buyer's current choices.
 */
import type { ConsentRegime } from "@scalius/shared/tracking-consent";
import { consentCopy } from "./consent-copy";
import { CONSENT_BANNER_ID, CONSENT_RUNTIME_SCRIPT } from "./consent-scripts";
import type { StorefrontLanguage } from "@/lib/storefront-copy";

interface Props {
  regime: ConsentRegime;
  language: StorefrontLanguage;
}

const { regime, language } = Astro.props;
const copy = consentCopy(language);
const optIn = regime === "opt_in";
---

<div id={CONSENT_BANNER_ID} class="consent-banner" role="region" aria-label={copy.region} data-regime={regime}>
  <p class="consent-text">{optIn ? copy.optInText : copy.noticeText}</p>
  <div class="consent-actions">
    {optIn ? (
      <>
        <button type="button" class="consent-button consent-primary" data-consent-action="accept">{copy.accept}</button>
        <button type="button" class="consent-button" data-consent-action="reject">{copy.reject}</button>
      </>
    ) : (
      <>
        <button type="button" class="consent-button consent-primary" data-consent-action="ok">{copy.ok}</button>
        <button type="button" class="consent-button" data-consent-action="reject">{copy.reject}</button>
      </>
    )}
    <button
      type="button"
      class="consent-button consent-link"
      data-consent-action="manage"
      data-consent-manage
      aria-expanded="false"
      aria-controls="scalius-consent-choices"
    >{copy.manage}</button>
  </div>
  <fieldset id="scalius-consent-choices" class="consent-choices" tabindex="-1" hidden>
    <legend class="consent-legend">{copy.choices}</legend>
    <label class="consent-choice">
      <input type="checkbox" checked disabled />
      <span><strong>{copy.necessary}</strong> {copy.necessaryHint}</span>
    </label>
    <label class="consent-choice">
      <input type="checkbox" name="analytics" />
      <span><strong>{copy.analytics}</strong> {copy.analyticsHint}</span>
    </label>
    <label class="consent-choice">
      <input type="checkbox" name="marketing" />
      <span><strong>{copy.marketing}</strong> {copy.marketingHint}</span>
    </label>
    <label class="consent-choice">
      <input type="checkbox" name="saleOfData" />
      <span><strong>{copy.saleOfData}</strong> {copy.saleOfDataHint}</span>
    </label>
    <button type="button" class="consent-button consent-primary" data-consent-action="save">{copy.save}</button>
  </fieldset>
</div>
<p class="consent-open"><button type="button" class="consent-link" data-consent-action="open" hidden>{copy.privacyChoices}</button></p>
<script is:inline set:html={CONSENT_RUNTIME_SCRIPT} />

<style is:inline>
  .consent-banner {
    display: none;
    position: fixed;
    inset-inline: 0.75rem;
    inset-block-end: calc(0.75rem + var(--safe-area-inset-bottom, 0px));
    z-index: 70;
    max-inline-size: 34rem;
    margin-inline: auto;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius, 0.4rem);
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.16);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  html[data-consent-banner] .consent-banner { display: block; }
  .consent-text { margin: 0 0 0.625rem; }
  .consent-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .consent-button {
    min-block-size: 2.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius, 0.4rem);
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .consent-primary { background: var(--primary); border-color: var(--primary); color: var(--primary-foreground); }
  .consent-link { border: 0; background: none; padding-inline: 0.25rem; color: inherit; font: inherit; text-decoration: underline; cursor: pointer; }
  .consent-button:focus-visible, .consent-link:focus-visible, .consent-choice input:focus-visible { outline: 2px solid var(--ring, currentColor); outline-offset: 2px; }
  .consent-choices { margin: 0.75rem 0 0; padding: 0; border: 0; display: grid; gap: 0.5rem; }
  .consent-choices[hidden] { display: none; }
  .consent-legend { font-weight: 600; margin-block-end: 0.25rem; }
  .consent-choice { display: flex; gap: 0.5rem; align-items: flex-start; }
  .consent-choice input { margin-block-start: 0.2rem; inline-size: 1rem; block-size: 1rem; accent-color: var(--primary); }
  /* No space at all until the runtime reveals the link (in flow at the page's end). */
  .consent-open { margin: 0; text-align: center; font-size: 0.75rem; line-height: 1; }
  .consent-open .consent-link { margin-block: 0.5rem 1rem; color: var(--muted-foreground, inherit); }
  @media (prefers-reduced-motion: no-preference) { .consent-banner { transition: opacity 0.15s ease; } }
</style>
