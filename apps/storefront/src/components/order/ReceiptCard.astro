---
// One of the receipt's cards (ReceiptCards.astro): the order and its totals,
// where it goes, or what was bought.
import { checkoutText } from "@/lib/checkout-text";
import LineExtras from "@/components/order/LineExtras.astro";
import type { CheckoutConfig } from "@/lib/api/checkout";
import type { CheckoutLanguageData } from "@/lib/api";
import { formatOrderSuccessPaymentMethod, isDigitalLinePreparing, receiptGiftCardTenderLabel } from "@/lib/order-success-state";
import type { OrderReceiptView, ReceiptOrder, ReceiptSuccessView } from "@/lib/order-receipt-view";
import { getProductImageUrl } from "@/lib/product-media";
import { isFreeOrderLine, resolveSavedOrderLineMoney } from "@scalius/shared/order-money-presentation";
import { presentedLineTotalMinor } from "@/lib/order-line-discounts";
import { orderLineGroupStatusText, orderLinePropertyRows } from "@/lib/order-line-groups";
import type { StorefrontReceiptSection } from "@scalius/shared/storefront-theme";

interface Props {
  section: StorefrontReceiptSection;
  order: ReceiptOrder;
  orderId: string;
  copy: CheckoutLanguageData["languageData"];
  orderSuccessView: ReceiptSuccessView;
  gateways: CheckoutConfig["gateways"];
  view: OrderReceiptView;
}

const { section, order, orderId, copy, orderSuccessView, gateways, view } = Astro.props;
const checkoutConfig = { gateways };
const {
  orderNumber, orderPlacedAt, receiptPaymentTerms, receiptMoney, receiptDiscounts, formatReceiptAmount, formatReceiptMinor,
  showsReceiptDeliveryRow, receiptDeliveryRow, receiptDeliveryDetails, savedMoneySummary, receiptGiftCardTenders,
  visibleBalanceDue, receiptPayment, deliveryBlock, deliveryLocality, showOrderLineGroupHeadings, orderLineGroups, showsLineDiscounts,
  customerPhone, quantityText, appAnswers,
} = view;
---

{section === "order" ? (
  <div
    class="order-success-print-card order-success-print-order rounded-xl border border-border bg-background p-4 sm:p-6"
  >
    <h2 class="text-lg font-medium mb-4 flex items-center">
      <svg
        class="w-5 h-5 me-2 text-muted-foreground"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
        ></path>
      </svg>
      {copy.orderReceiptOrderDetailsText}
    </h2>
    <div class="space-y-4">
      <div class="flex justify-between">
        <span class="text-muted-foreground">{copy.orderReceiptOrderNumberText}</span>
        <span class="break-all text-end font-medium">{orderNumber}</span>
      </div>
      {orderPlacedAt && <div class="flex justify-between gap-4">
        <span class="text-muted-foreground">{copy.orderReceiptPlacedText}</span>
        <span class="text-end font-medium">{orderPlacedAt}</span>
      </div>}
      <div class="flex justify-between">
        <span class="text-muted-foreground">{copy.orderReceiptStatusText}</span>
        <span
          class={`rounded-full px-2 py-0.5 text-sm font-medium ${orderSuccessView.orderBadgeClass}`}
          >{orderSuccessView.orderStatusLabel}</span
        >
      </div>
      <div class="flex justify-between">
        <span class="text-muted-foreground">{copy.orderReceiptPaymentText}</span>
        <span class="text-end font-medium">{formatOrderSuccessPaymentMethod(order.paymentMethod, copy, order, checkoutConfig.gateways)}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-muted-foreground">{copy.orderReceiptPaymentStatusText}</span>
        <span
          class={`rounded-full px-2 py-0.5 text-sm font-medium ${orderSuccessView.paymentBadgeClass}`}
          >{orderSuccessView.paymentStatusLabel}</span
        >
      </div>
      {receiptPaymentTerms && <p class="text-end text-sm font-medium" data-payment-terms>{receiptPaymentTerms}</p>}
      {receiptMoney && receiptDiscounts && (
        <div class="space-y-3 border-t border-border pt-4">
          <div class="flex justify-between gap-4">
            <span class="text-muted-foreground">{copy.subtotalText}</span>
            <span class="font-medium">{formatReceiptAmount(receiptMoney.subtotal)}</span>
          </div>
          {showsReceiptDeliveryRow && receiptDeliveryRow && <div class="flex justify-between gap-4">
            <span class="text-muted-foreground">{receiptDeliveryRow.label}</span>
            <span class="text-end font-medium">
              {receiptDeliveryRow.struck && <s class="me-1.5 font-normal text-muted-foreground">{receiptDeliveryRow.struck}</s>}
              {receiptDeliveryRow.value}
              {receiptDeliveryRow.codes && (
                <span class="ms-1 font-normal text-muted-foreground">({receiptDeliveryRow.codes})</span>
              )}
            </span>
          </div>}
          {receiptDeliveryDetails && <p class="text-xs leading-relaxed text-muted-foreground">{receiptDeliveryDetails}</p>}
          {receiptDiscounts.lines.map((line) => (
            <div class="flex justify-between gap-4">
              <span class="text-muted-foreground">{line.label}</span>
              <span class="shrink-0 whitespace-nowrap font-medium text-foreground">−{formatReceiptAmount(line.amount)}</span>
            </div>
          ))}
          {savedMoneySummary && receiptMoney.tax > 0 && <div class="flex justify-between gap-4">
            <span class="text-muted-foreground">{savedMoneySummary.taxLabel}{savedMoneySummary.pricesIncludeTax ? ` (${copy.includedText})` : ""}</span>
            <span class="font-medium">{formatReceiptAmount(receiptMoney.tax)}</span>
          </div>}
          <div class="flex justify-between gap-4 border-t border-border pt-3">
            <span class="font-semibold text-foreground">{copy.totalText}</span>
            <span class="font-semibold text-foreground">{formatReceiptAmount(receiptMoney.total)}</span>
          </div>
        </div>
      )}
      {receiptGiftCardTenders.map((tender) => (
        <div class="flex justify-between gap-4" data-receipt-gift-card>
          <span class="text-muted-foreground">{receiptGiftCardTenderLabel(tender, copy)}</span>
          <span class="shrink-0 whitespace-nowrap font-medium text-foreground">−{formatReceiptAmount(tender.amount)}</span>
        </div>
      ))}
      {
        order.paidAmount > 0 && visibleBalanceDue > 0 && receiptGiftCardTenders.length === 0 && (
          <div class="flex justify-between">
            <span class="text-muted-foreground">{copy.orderReceiptPaidText}</span>
            <span class="font-medium text-foreground">
              {formatReceiptAmount(order.paidAmount)}
            </span>
          </div>
        )
      }
      {
        visibleBalanceDue > 0 && (
          <div class="flex justify-between">
            <span class="text-muted-foreground">{receiptPayment?.balanceLabel ?? copy.orderReceiptBalanceDueText}</span>
            <span class="font-medium">
              {formatReceiptAmount(visibleBalanceDue)}
            </span>
          </div>
        )
      }
    </div>
  </div>
) : section === "delivery" ? (
  <div
    class="order-success-print-card order-success-print-shipping rounded-xl border border-border bg-background p-4 sm:p-6"
  >
    <h2 class="text-lg font-medium mb-4 flex items-center">
      <svg
        class="w-5 h-5 me-2 text-muted-foreground"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
        ></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      {deliveryBlock?.mode === "pickup" ? deliveryBlock.heading : copy.orderReceiptDeliveryDetailsText}
    </h2>
    <div class="space-y-1 text-sm">
      <p class="font-medium text-foreground">{order.customerName}</p>
      {deliveryBlock?.mode === "ship" && deliveryBlock.address && <p class="text-muted-foreground">{deliveryBlock.address}</p>}
      {deliveryLocality && <p class="text-muted-foreground">{deliveryLocality}</p>}
      {deliveryBlock?.mode === "pickup" && (
        <>
          {deliveryBlock.location && <p class="text-foreground">{deliveryBlock.location}</p>}
          {deliveryBlock.hours && <p class="text-muted-foreground">{deliveryBlock.hoursLabel}: {deliveryBlock.hours}</p>}
          {deliveryBlock.notReady && <p class="text-muted-foreground">{deliveryBlock.notReady}</p>}
        </>
      )}
      {deliveryBlock?.mode === "none" && <p class="text-muted-foreground">{deliveryBlock.text}</p>}
      {customerPhone && <p class="text-muted-foreground">{customerPhone}</p>}
      {order.customerEmail && <p class="break-all text-muted-foreground">{order.customerEmail}</p>}
    </div>
    {order.notes && (
      <div class="mt-3 border-t border-border pt-3 text-sm">
        <p class="font-medium text-foreground">{copy.orderReceiptNoteText}</p>
        <p class="whitespace-pre-line break-words text-muted-foreground">{order.notes}</p>
      </div>
    )}
    {appAnswers.map((group) => (
      <div class="mt-3 border-t border-border pt-3 text-sm" data-receipt-app-answers={group.appId}>
        <p class="font-medium text-foreground">{group.appName}</p>
        {group.entries.map((entry) => (
          <p class="break-words text-muted-foreground"><span>{entry.label}</span>: <span class="text-foreground">{entry.value}</span></p>
        ))}
      </div>
    ))}
  </div>
) : (
  <div
    class="order-success-print-card order-success-print-items rounded-xl border border-border bg-background p-4 sm:p-6"
  >
    <h2 class="text-lg font-medium mb-4 flex items-center">
      <svg
        class="w-5 h-5 me-2 text-muted-foreground"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
      </svg>
      {copy.orderReceiptItemsText}
    </h2>
    <div class={showOrderLineGroupHeadings ? "space-y-6" : undefined} data-receipt-lines>
    {orderLineGroups.map((group) => (
    <div data-order-line-group={group.type}>
      {showOrderLineGroupHeadings && (
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-b border-border pb-2">
          <h3 class="text-sm font-semibold text-foreground">{group.heading}</h3>
          {orderLineGroupStatusText(group) && <p class="text-sm text-muted-foreground">{orderLineGroupStatusText(group)}</p>}
        </div>
      )}
    <div class="space-y-4">
      {
        group.items.map((item) => {
          const savedLine = resolveSavedOrderLineMoney(item, savedMoneySummary);
          const propertyRows = orderLinePropertyRows(
            item.properties,
            (property) => savedMoneySummary ? formatReceiptMinor(property.priceMinor) : formatReceiptAmount(property.price),
            copy,
          );
          const preparing = Boolean(order && isDigitalLinePreparing(item, order));
          return (
            <div class="order-success-print-item border-b border-border pb-3 last:border-0 last:pb-0">
            <div class="flex items-center justify-between gap-3">
              <div class="flex min-w-0 items-center gap-3">
                {item.productImage ? (
                  <img
                    src={getProductImageUrl(item.productImage, 96)}
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                    class="h-12 w-12 shrink-0 rounded-lg border border-border object-cover"
                  />
                ) : (
                  // Same box without a photo, so every line's name starts at one edge.
                  <span aria-hidden="true" class="h-12 w-12 shrink-0 rounded-lg border border-border bg-muted" />
                )}
                <div class="min-w-0">
                <p class="font-medium">
                  {item.productName || copy.orderReceiptProductUnavailableText}
                </p>
                {item.variantLabel && (
                  <p class="text-xs text-muted-foreground mt-1">
                    {item.variantLabel}
                  </p>
                )}
                {propertyRows.length > 0 && (
                  <ul class="mt-1 space-y-0.5 text-xs text-muted-foreground">
                    {propertyRows.map((row) => (
                      <li class="break-words">
                        <span class="text-foreground">{row.label}:</span> {row.value}{row.surcharge && ` (${row.surcharge})`}
                      </li>
                    ))}
                  </ul>
                )}
                <p class="text-sm text-muted-foreground mt-1">
                  {checkoutText(copy.orderReceiptQuantityText, { quantity: quantityText(item.quantity) })} × {savedLine
                    ? formatReceiptMinor(savedLine.unitPriceMinor)
                    : formatReceiptAmount(item.price)}
                </p>
                {savedLine && savedMoneySummary && showsLineDiscounts && savedLine.discountMinor > 0 && (
                  <p class="mt-1 text-xs text-muted-foreground">
                    {checkoutText(copy.orderReceiptItemDiscountText, {
                      amount: formatReceiptMinor(savedLine.discountMinor),
                    })}
                  </p>
                )}
                </div>
              </div>
              <div class="shrink-0 text-end">
                {savedLine && savedMoneySummary && <p class="text-xs text-muted-foreground">{copy.orderReceiptLineTotalText}</p>}
                <p class="font-medium">
                  {savedLine && savedMoneySummary && isFreeOrderLine(savedLine) && (
                    <s class="me-1.5 text-muted-foreground">{formatReceiptMinor(savedLine.grossSubtotalMinor)}</s>
                  )}
                  {savedLine && savedMoneySummary
                    ? formatReceiptMinor(presentedLineTotalMinor(savedLine, showsLineDiscounts))
                    : formatReceiptAmount(item.quantity * item.price)}
                </p>
              </div>
            </div>
            {/* Downloads, gift cards and the review form get the line's full
                width (under its text from sm up), not the column beside the total. */}
            {(item.extras || preparing) && (
              <div class="sm:ps-[3.75rem]">
                <LineExtras line={item} context={{ orderId, access: "receipt" }} />
                {preparing && (
                  <p class="mt-3 flex items-center gap-2 rounded-lg border border-dashed border-border bg-muted/40 p-3 text-sm text-foreground" data-download-preparing data-later-text={copy.orderReceiptDownloadLaterText}>
                    <span class="size-4 shrink-0 animate-spin rounded-full border-2 border-muted-foreground/30 border-t-foreground motion-reduce:animate-none" aria-hidden="true" data-download-preparing-spinner></span>
                    <span class="min-w-0 flex-1" role="status" data-download-preparing-text>{copy.orderReceiptDownloadPreparingText}</span>
                    {/* Without JavaScript the buyer checks again; with it the page does. */}
                    <a href={`${Astro.url.pathname}${Astro.url.search}`} class="shrink-0 font-medium underline underline-offset-2">{copy.orderReceiptRefreshText}</a>
                  </p>
                )}
              </div>
            )}
            </div>
          );
        })
      }
    </div>
    </div>
    ))}
    </div>
  </div>
)}
