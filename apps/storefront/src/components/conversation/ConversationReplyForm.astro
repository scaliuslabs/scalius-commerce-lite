---
// The message form of a conversation. Without JavaScript it is a plain
// multipart POST to a same-origin proxy that uploads the images, posts the
// message and redirects back (Post/Redirect/Get). With JavaScript the same form
// is sent with fetch and new rows merge into the existing thread
// (conversation-form.ts). The message text only ever travels in the POST body.
import {
  conversationCopy,
  CONVERSATION_LIMITS,
  conversationStatusMessage,
  newClientMessageKey,
  type ConversationStatusFlag,
} from "@/lib/account-inbox";
import ConversationCartShare from "./ConversationCartShare.astro";
import { pageLanguage } from "@/lib/store-time-zone";

interface Props {
  variant?: "stack" | "dock";
  /** Same-origin proxy endpoint under /api/conversations/. */
  action: string;
  /** Explicit private display acknowledgment route, independent of message posting. */
  readAction?: string;
  /** The page to return to after a no-JS post (validated again by the proxy). */
  returnTo: string;
  /** Id of the message list the enhanced post appends to. */
  messagesTargetId: string;
  conversationId?: string;
  readSeq?: number;
  lastShownSeq?: number;
  /** Unique prefix for element ids on the page. */
  idPrefix: string;
  /** Outcome of the last no-JS post, from the page URL. */
  status?: ConversationStatusFlag | null;
  label?: string;
  placeholder?: string;
  note?: string | null;
  attachLabel?: string;
  attachHint?: string;
  submitLabel?: string;
  /** Overrides the message for `status` (a form with its own outcome words, like the warranty claim form). */
  statusMessage?: { tone: "success" | "error"; text: string } | null;
}

// The page's language: the form's words, and the language its enhanced answers are written in.
const copy = conversationCopy();
const language = pageLanguage();
const {
  variant = "stack",
  action,
  readAction,
  returnTo,
  messagesTargetId,
  conversationId,
  readSeq = 0,
  lastShownSeq = 0,
  idPrefix,
  status = null,
  label = copy.messageLabel,
  placeholder = copy.writeMessage,
  note = null,
  attachLabel = copy.attachLabel,
  attachHint = copy.attachHint,
  submitLabel = copy.send,
  statusMessage = status ? conversationStatusMessage(status) : null,
} = Astro.props;
const clientMessageKey = newClientMessageKey();
const dock = variant === "dock";
const accept = "image/jpeg,image/png,image/webp";
---

{readAction && lastShownSeq > readSeq && (
  <noscript>
    <form method="post" action={readAction} class="mt-3">
      <input type="hidden" name="seq" value={lastShownSeq} />
      <input type="hidden" name="returnTo" value={returnTo} />
      <button type="submit" class="min-h-11 text-sm font-medium text-primary underline">{copy.markRead}</button>
    </form>
  </noscript>
)}

{readAction && <div class={dock ? "flex flex-wrap items-center gap-2 empty:hidden" : "mt-3 flex flex-wrap items-center gap-3"} data-conversation-live-controls>
  <p class="text-xs text-muted-foreground empty:hidden" role="status" data-conversation-live-status></p>
  <button type="button" hidden data-conversation-new class="min-h-11 rounded-lg border border-border px-4 text-sm font-medium text-primary">{copy.newMessages}</button>
  <a href={returnTo} hidden data-conversation-reload data-astro-prefetch="false" class="min-h-11 items-center text-sm font-medium text-primary underline">{copy.reloadConversation}</a>
</div>}

{readAction && action.startsWith("/api/conversations/") && <ConversationCartShare compact={dock} endpoint={action.replace(/\/messages(?=\?|$)/, "/cart-share")} idPrefix={`${idPrefix}Cart`} />}

<form
  method="post"
  action={action}
  enctype="multipart/form-data"
  class={dock ? "conversation-dock-form mt-2 flex flex-wrap items-end gap-2" : "mt-4 space-y-3"}
  data-conversation-form
  data-conversation-dock={dock ? "true" : undefined}
  data-messages-target={messagesTargetId}
  data-conversation-id={conversationId}
  data-read-seq={readSeq}
  data-read-action={readAction}
>
  <input type="hidden" name="clientMessageKey" value={clientMessageKey} />
  <input type="hidden" name="returnTo" value={returnTo} />
  <input type="hidden" name="language" value={language} />
  <p data-conversation-closed hidden={!note} class={dock ? "order-first w-full text-sm text-muted-foreground" : "text-sm text-muted-foreground"}>{note ?? copy.closedNote}</p>
  <div class={dock ? "contents" : undefined}>
    <label for={`${idPrefix}Body`} class={dock ? "sr-only" : "mb-1.5 block text-sm font-medium text-foreground"}>{label}</label>
    <textarea
      id={`${idPrefix}Body`}
      name="body"
      required
      rows={dock ? 1 : 2}
      maxlength={CONVERSATION_LIMITS.bodyLength}
      placeholder={placeholder}
      class:list={["resize-none rounded-lg border border-input bg-background px-3 py-2.5 text-base leading-relaxed text-foreground outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/20 sm:text-sm", dock ? "order-2 min-h-11 max-h-40 min-w-0 flex-1 [field-sizing:content]" : "min-h-20 max-h-48 w-full"]}
    ></textarea>
  </div>
  <div class={dock ? "contents" : undefined}>
    <label for={`${idPrefix}Images`} class="sr-only">{attachLabel}</label>
    {dock && <label for={`${idPrefix}Images`} data-attach-trigger title={attachLabel} class="order-1 inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-border text-foreground hover:bg-muted">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m21 11-8.5 8.5a6 6 0 0 1-8.5-8.5L14 1.5a4 4 0 0 1 5.7 5.7L10.5 16.5a2 2 0 0 1-2.8-2.8L16 5.5" /></svg>
    </label>}
    <input
      id={`${idPrefix}Images`}
      name="images"
      type="file"
      multiple
      accept={accept}
      aria-describedby={`${idPrefix}ImagesHint`}
      class="order-5 block w-full text-sm text-muted-foreground file:me-3 file:min-h-11 file:rounded-lg file:border file:border-border file:bg-background file:px-4 file:text-sm file:font-medium file:text-foreground hover:file:bg-muted"
    />
    <p id={`${idPrefix}ImagesHint`} data-attachment-hint class={dock ? "order-6 w-full text-xs text-muted-foreground" : "mt-1 text-xs text-muted-foreground"}>{attachHint}</p>
    <div class={dock ? "order-5 flex w-full flex-wrap gap-2 empty:hidden" : "mt-2 flex flex-wrap gap-2 empty:hidden"} data-conversation-previews></div>
  </div>
  <p
    role="status"
    aria-live="polite"
    data-conversation-status
    class:list={["text-sm empty:hidden", dock && "order-4 w-full", statusMessage?.tone === "error" ? "text-destructive" : "text-primary"]}
  >{statusMessage?.text ?? ""}</p>
  <div class={dock ? "order-3 shrink-0" : "flex justify-end"}>
    <button
      type="submit"
      data-idle-label={submitLabel}
      data-busy-label={copy.sending}
      class="inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60"
    >{submitLabel}</button>
  </div>
</form>

<script>
  import { bindConversationForms } from "./conversation-form";
  import { bindConversationLive, stopConversationLive } from "./conversation-live";
  import { bindConversationCartShares, stopConversationCartShares } from "./cart-share";

  function bind() {
    document.querySelectorAll<HTMLFormElement>("form[data-conversation-form]").forEach((form) => {
      const list = document.getElementById(form.dataset.messagesTarget ?? "");
      if (!list || !form.dataset.readAction) return;
      list.dataset.liveSrc = new URL(form.action).pathname + new URL(form.action).search;
      list.dataset.readSrc = form.dataset.readAction ?? "";
      list.dataset.conversationId = form.dataset.conversationId ?? "";
      list.dataset.readSeq = form.dataset.readSeq ?? "0";
    });
    bindConversationForms();
    bindConversationLive();
    bindConversationCartShares();
  }

  type ConversationWindow = Window & { __scaliusConversationFormsBound?: boolean };
  const conversationWindow = window as ConversationWindow;
  if (!conversationWindow.__scaliusConversationFormsBound) {
    conversationWindow.__scaliusConversationFormsBound = true;
    document.addEventListener("astro:page-load", bind);
    document.addEventListener("astro:before-swap", stopConversationLive);
    document.addEventListener("astro:before-swap", stopConversationCartShares);
    window.addEventListener("pagehide", stopConversationLive);
    window.addEventListener("pagehide", stopConversationCartShares);
    window.addEventListener("pageshow", (event) => { if (event.persisted) bind(); });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bind, { once: true });
  } else {
    bind();
  }
</script>

<style>
  .conversation-dock-form [data-attach-trigger] { display: none; }
  .conversation-dock-form[data-enhanced] [data-attach-trigger] { display: inline-flex; }
  .conversation-dock-form[data-enhanced] input[type="file"] { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .conversation-dock-form[data-enhanced]:has(input[type="file"]:focus-visible) [data-attach-trigger] { outline: 2px solid currentColor; outline-offset: 2px; }
  .conversation-dock-form[data-enhanced] [data-attachment-hint] { display: none; }
  .conversation-dock-form:has([data-conversation-previews]:not(:empty)) [data-attachment-hint],
  .conversation-dock-form:has([data-conversation-status]:not(:empty)) [data-attachment-hint] { display: block; }
</style>
