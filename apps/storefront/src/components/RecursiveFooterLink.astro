---
// src/components/recursive-footer-link.astro
// A footer menu, to any depth. Every link repeats on every page, so its look
// lives once in the rules below (zero specificity, Tailwind's own values: the
// footers' own rules still win where they did) instead of a dozen utility
// classes and an underline <span> per link.
import type { FooterMenuLink } from "@/lib/api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";

interface Props {
  links: FooterMenuLink[];
  depth?: number;
}

const { links = [], depth = 0 } = Astro.props;

// Increased indentation for deeper levels
const paddingLeft = depth > 0 ? `${depth * 12}px` : "0";
---

<ul class="space-y-2">
  {
    Array.isArray(links) &&
      links.map((link) => (
        <li>
          {link.href ? (
          <a href={link.href} data-astro-prefetch={getStorefrontPrefetchAttribute(link.href, Astro.url)} target={link.openInNewTab ? "_blank" : undefined} rel={link.openInNewTab ? "noopener noreferrer" : undefined} class="footer-link font-medium" style={depth > 0 ? `padding-left: ${paddingLeft}` : undefined}>
            {depth > 0 && <span class="footer-link-dot" />}
            <span class="footer-link-label">{link.title}</span>
          </a>
          ) : (
          <span class="inline-flex items-center gap-2 text-base font-medium" style={`padding-left: ${paddingLeft}`}>
            {depth > 0 && (
              <span class="w-1.5 h-1.5 bg-current rounded-full shrink-0" />
            )}
            <span>{link.title}</span>
          </span>
          )}

          {/* Recursive rendering for nested links */}
          {link.subMenu && link.subMenu.length > 0 && (
            <div class="mt-2 border-s border-primary-foreground/10 ms-1">
              <Astro.self links={link.subMenu} depth={depth + 1} />
            </div>
          )}
        </li>
      ))
  }
</ul>

<style is:global>
  /* The former `inline-flex items-center gap-2 text-base font-medium group`. */
  :where(.footer-link) {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    gap: calc(var(--spacing) * 2);
    font-size: var(--text-base);
    line-height: var(--tw-leading, var(--text-base--line-height));
  }

  /* A nested link's bullet (`w-1.5 h-1.5 bg-current rounded-full shrink-0`). */
  :where(.footer-link-dot) {
    flex-shrink: 0;
    width: calc(var(--spacing) * 1.5);
    height: calc(var(--spacing) * 1.5);
    border-radius: 2147483647px;
    background-color: currentColor;
  }

  /* The label's underline grows on hover and keyboard focus. */
  :where(.footer-link-label) {
    position: relative;
  }

  :where(.footer-link-label)::after {
    content: "";
    position: absolute;
    bottom: calc(var(--spacing) * -0.5);
    inset-inline-start: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition-property: all;
    transition-timing-function: var(--tw-ease, var(--default-transition-timing-function));
    --tw-duration: 0.3s;
    transition-duration: 0.3s;
  }

  :where(.footer-link:focus-visible .footer-link-label)::after {
    width: 100%;
  }

  @media (hover: hover) {
    :where(.footer-link:hover .footer-link-label)::after {
      width: 100%;
    }
  }
</style>
