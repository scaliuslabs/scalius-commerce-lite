---
// src/components/recursive-footer-link.astro
import type { FooterMenuLink } from "@/lib/api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";

interface Props {
  links: FooterMenuLink[];
  depth?: number;
}

const { links = [], depth = 0 } = Astro.props;

// Increased indentation for deeper levels
const paddingLeft = depth > 0 ? `${depth * 12}px` : "0";
---

<ul class="space-y-2">
  {
    Array.isArray(links) &&
      links.map((link) => (
        <li>
          {link.href ? (
          <a href={link.href} data-astro-prefetch={getStorefrontPrefetchAttribute(link.href, Astro.url)} target={link.openInNewTab ? "_blank" : undefined} rel={link.openInNewTab ? "noopener noreferrer" : undefined} class="inline-flex items-center gap-2 text-base font-medium group" style={`padding-left: ${paddingLeft}`}>
            {depth > 0 && (
              <span class="w-1.5 h-1.5 bg-current rounded-full shrink-0" />
            )}
            <span class="relative">
              {link.title}
              <span class="absolute -bottom-0.5 left-0 w-0 h-px bg-current transition-all duration-300 group-hover:w-full group-focus-visible:w-full" />
            </span>
          </a>
          ) : (
          <span class="inline-flex items-center gap-2 text-base font-medium" style={`padding-left: ${paddingLeft}`}>
            {depth > 0 && (
              <span class="w-1.5 h-1.5 bg-current rounded-full shrink-0" />
            )}
            <span>{link.title}</span>
          </span>
          )}

          {/* Recursive rendering for nested links */}
          {link.subMenu && link.subMenu.length > 0 && (
            <div class="mt-2 border-l border-primary-foreground/10 ml-1">
              <Astro.self links={link.subMenu} depth={depth + 1} />
            </div>
          )}
        </li>
      ))
  }
</ul>
