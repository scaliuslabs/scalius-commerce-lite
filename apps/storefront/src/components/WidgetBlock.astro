---
import type { ApiWidget } from "@/lib/api";
import {
  optimizeCssImageUrls,
  optimizeRichContentImages,
} from "@/lib/rich-content-media";
import { scopeCss } from "@scalius/shared/css-scope";

interface Props {
  widget: ApiWidget;
  class?: string;
}

const { widget, class: className = "" } = Astro.props;
const scopeClass = `sw-${widget.id}`;
const html = optimizeRichContentImages(widget.htmlContent || "");
const css = scopeCss(
  optimizeCssImageUrls(widget.cssContent || ""),
  scopeClass,
);
---

<div class:list={["widget-container cms-widget-frame", scopeClass, className]}>
  {widget.cssContent && <style set:html={css} />}
  <div set:html={html} />
</div>
