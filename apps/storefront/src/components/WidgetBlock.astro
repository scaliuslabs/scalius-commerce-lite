---
import type { ApiWidget } from "@/lib/api";
import { prepareWidgetContent } from "@/lib/widget-content";

interface Props {
  widget: ApiWidget;
  class?: string;
  priority?: boolean;
}

const { widget, class: className = "", priority = false } = Astro.props;
const { scopeClass, html, css } = prepareWidgetContent(widget, { priority });
---

<div class:list={["widget-container cms-widget-frame", scopeClass, className]} data-widget-id={widget.id}>
  {css && <style set:html={css} />}
  <div set:html={html} />
</div>
