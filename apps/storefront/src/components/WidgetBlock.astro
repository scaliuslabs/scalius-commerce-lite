---
import type { ApiWidget } from "@/lib/api";
import {
  optimizeCssImageUrls,
  optimizeRichContentImages,
} from "@/lib/rich-content-media";
import { sanitizeCssForStyleElement } from "@scalius/shared/css-sanitize";
import { scopeCss } from "@scalius/shared/css-scope";

interface Props {
  widget: ApiWidget;
  class?: string;
  priority?: boolean;
}

const { widget, class: className = "", priority = false } = Astro.props;
const scopeClass = `sw-${widget.id}`;
const html = optimizeRichContentImages(widget.htmlContent || "", { priority });
const css = scopeCss(
  optimizeCssImageUrls(sanitizeCssForStyleElement(widget.cssContent)),
  scopeClass,
);
---

<div class:list={["widget-container cms-widget-frame", scopeClass, className]}>
  {css && <style set:html={css} />}
  <div set:html={html} />
</div>
