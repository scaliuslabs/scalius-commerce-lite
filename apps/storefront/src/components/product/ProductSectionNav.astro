---
// The product page's anchor bar (theme `product.sticky`: `phoneTop` and
// `desktop` `anchor-bar`): Top, Details, Similar and Reviews stay pinned
// under the header while the product's real below-fold sections pass
// underneath (Amazon and Daraz on phones, Star Tech on computers). Every
// link remains a native anchor; the script only marks the current section.
import { catalogCopy } from "@/lib/catalog-copy";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import Icon from "@/components/icons/Icon.astro";

interface Props {
  detailsId?: string | null;
  exploreId?: string | null;
  reviewsId?: string | null;
  /** Pinned on phones and tablets (below 64rem). */
  phone?: boolean;
  /** Pinned on computers (from 64rem). */
  desktop?: boolean;
}

const { detailsId = null, exploreId = null, reviewsId = null, phone = true, desktop = false } = Astro.props;
const copy = catalogCopy((await currentRequestTheme(Astro.locals)).language).product;
const links = [
  detailsId && { id: detailsId, label: copy.details },
  exploreId && { id: exploreId, label: copy.similar },
  reviewsId && { id: reviewsId, label: copy.reviews },
].filter((link): link is { id: string; label: string } => Boolean(link));
---

{links.length > 0 && (phone || desktop) && (
  <nav
    data-product-topbar
    data-product-section-nav
    data-section-nav-phone={phone ? "" : undefined}
    data-section-nav-desktop={desktop ? "" : undefined}
    aria-label={copy.sections}
    class:list={[
      "sticky top-[var(--header-height,0px)] z-[var(--scalius-z-content-bar,40)] h-[52px] border-b border-border bg-background shadow-[0_3px_8px_-5px_rgb(0_0_0/0.35)]",
      phone && desktop ? "flex" : phone ? "flex lg:hidden" : "hidden lg:flex",
    ]}
  >
    <a href="#product-container" class="flex w-[72px] shrink-0 flex-col items-center justify-center bg-muted/50 text-sm leading-tight text-foreground">
      <Icon name="chevron-up" class="h-4 w-4" aria-hidden="true" />
      {copy.top}
    </a>
    {links.map((link, index) => (
      <a
        href={`#${link.id}`}
        data-section-anchor={link.id}
        aria-current={index === 0 ? "location" : undefined}
        class="flex min-w-0 flex-1 items-center justify-center border-b-4 border-transparent px-1 pt-1 text-base font-medium text-foreground"
      >{link.label}</a>
    ))}
  </nav>
)}

<style is:global>
  [data-product-section-nav] [data-section-anchor][aria-current="location"] {
    border-bottom-color: var(--primary);
    color: var(--primary);
  }
  /* Sections land below the pinned bar (and the header above it). */
  @media (max-width: 63.999rem) {
    #product-container:has([data-section-nav-phone]) :is([data-product-module], #reviews, #related-products) {
      scroll-margin-top: 0.5rem;
    }
  }
  @media (min-width: 64rem) {
    [data-product-section-nav][data-section-nav-desktop] {
      /* The first label lines up with the page container's content edge. */
      padding-inline: max(0px, calc((100% - var(--theme-container-width, 80rem)) / 2 + var(--theme-gutter-desktop, 2rem) - 1.25rem));
    }
    [data-product-section-nav][data-section-nav-desktop] > a {
      flex: 0 0 auto;
      padding-inline: 1.25rem;
    }
    #product-container:has([data-section-nav-desktop]) :is([data-product-module], #reviews, #related-products) {
      scroll-margin-top: 0.5rem;
    }
  }
</style>

<script>
  let cleanup: (() => void) | null = null;

  function bind() {
    cleanup?.();
    const nav = document.querySelector<HTMLElement>("[data-product-section-nav]");
    if (!nav) return;
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>("[data-section-anchor]"));
    let frame = 0;
    const update = () => {
      const boundary = nav.getBoundingClientRect().bottom + 12;
      let active = links[0];
      for (const link of links) {
        const section = document.getElementById(link.dataset.sectionAnchor ?? "");
        if (section && section.getBoundingClientRect().top <= boundary) active = link;
      }
      for (const link of links) {
        if (link === active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };
    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => { frame = 0; update(); });
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("hashchange", schedule);
    cleanup = () => {
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("hashchange", schedule);
      cancelAnimationFrame(frame);
    };
    update();
  }

  bind();
  document.addEventListener("astro:page-load", bind);
</script>
