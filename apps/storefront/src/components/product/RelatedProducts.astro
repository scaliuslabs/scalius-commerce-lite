---
import { Truck } from "lucide-react";
import type { Product } from "@/lib/api";
import { formatDiscountBadge } from "./lib/pricing-engine";
import { getProductImageSrcSet, getProductImageUrl } from "@/lib/product-media";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import { formatMoney } from "@/lib/currency";

interface Props {
  relatedProducts: Product[];
  currencySymbol?: string;
}

const { relatedProducts, currencySymbol = DEFAULT_CURRENCY.symbol } = Astro.props;

const formatPrice = (price: number) => formatMoney(price, { symbol: currencySymbol });
---

{
  relatedProducts.length > 0 && (
    <section
      class="storefront-deferred-region bg-muted/50 py-6 mt-4"
      id="related-products"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-lg font-bold text-foreground mb-4">
          You might also like
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-4 gap-y-6">
          {relatedProducts.map((relatedProduct) => (
            <a href={`/products/${relatedProduct.slug}`} class="group">
              <div class="aspect-square w-full overflow-hidden rounded-lg bg-muted shadow-sm border border-border group-hover:shadow-md transition-all duration-300 relative">
                <img
                  src={getProductImageUrl(relatedProduct.imageUrl, 320)}
                  srcset={getProductImageSrcSet(relatedProduct.imageUrl)}
                  sizes="(max-width: 639px) calc(50vw - 1.5rem), (max-width: 1023px) 33vw, (max-width: 1279px) 25vw, 20vw"
                  alt={relatedProduct.imageAlt || relatedProduct.name}
                  width={300}
                  height={300}
                  class="h-full w-full object-contain object-center group-hover:scale-105 transition-all duration-300"
                  loading="lazy"
                  decoding="async"
                />
                {formatDiscountBadge(
                  relatedProduct.discountType,
                  relatedProduct.discountPercentage,
                  relatedProduct.discountAmount
                ) && (
                  <div class="absolute top-2 left-2 rounded-full bg-destructive/10 px-1.5 py-0.5 text-xs font-medium text-destructive shadow-xs">
                    {formatDiscountBadge(
                      relatedProduct.discountType,
                      relatedProduct.discountPercentage,
                      relatedProduct.discountAmount
                    )}
                  </div>
                )}
              </div>
              <div class="mt-2 flex flex-col">
                <h3 class="text-sm font-medium text-foreground line-clamp-2 group-hover:text-primary transition-colors min-h-[2.5em]">
                  {relatedProduct.name}
                </h3>
                <p class="mt-1 flex items-center gap-1.5">
                  <span class="font-medium text-foreground text-sm">
                    <span class="sr-only">{relatedProduct.discountedPrice < relatedProduct.price ? "Sale price " : "Price "}</span>
                    {formatPrice(relatedProduct.discountedPrice)}
                  </span>
                  {relatedProduct.discountedPrice < relatedProduct.price && (
                    <span class="text-xs text-muted-foreground">
                      <span class="sr-only">Regular price </span>
                      <s>{formatPrice(relatedProduct.price)}</s>
                    </span>
                  )}
                </p>
                {relatedProduct.freeDelivery && (
                  <p class="mt-1 text-xs text-primary font-medium flex items-center">
                    <Truck className="h-3 w-3 mr-0.5" /> Free Delivery
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
