---
// The buy form's stock part (`data-buy-part="stock"`): the chosen SKU's
// stock line, which product-controller.ts keeps current, and the fulfilment
// badge beside it. Drawn in the form (ProductSummary.astro) or where a
// product_main skin placed it (`<BuyFormPart name="stock" />`).
import Icon from "@/components/icons/Icon.astro";

interface Props {
  available: boolean;
  tone: string;
  text: string;
  fulfilmentBadge: string | null;
  class?: string;
}

const { available, tone, text, fulfilmentBadge, class: className } = Astro.props;
---

<div class:list={["flex flex-wrap items-center gap-2", className]} data-buy-part="stock">
  <div id="product-stock-badge" data-sx-buy="stock-badge" class:list={["flex shrink-0 items-center whitespace-nowrap rounded-full border border-current px-2 py-0.5 text-sm", available ? "text-primary" : "text-destructive"]} data-stock-tone={tone} aria-live="polite">
    <Icon name="circle" class="me-1 h-2 w-2 fill-current" aria-hidden="true" /><span id="product-stock-text" data-sx-buy="stock-text" class="font-medium">{text}</span>
  </div>
  {fulfilmentBadge ? <span class="flex shrink-0 items-center whitespace-nowrap rounded-full border border-border bg-muted px-2 py-0.5 text-sm font-medium text-foreground" data-fulfilment-badge>{fulfilmentBadge}</span> : null}
</div>
