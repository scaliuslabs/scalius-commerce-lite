---
import { ChevronRight } from "lucide-react";
import type { Product } from "@/lib/api";

interface Props {
  product: Product;
  category: Product["category"] | null;
}

const { product, category } = Astro.props;
---

<nav
  class="mx-auto max-w-7xl px-3 py-1 sm:px-6 sm:py-1.5 lg:px-8 lg:py-2"
  aria-label="Breadcrumb"
>
  <ol
    class="flex items-center space-x-1 overflow-hidden text-ellipsis whitespace-nowrap text-[11px] sm:text-xs lg:space-x-1.5"
  >
    <li>
      <a
        href="/"
        class="text-muted-foreground hover:text-primary transition-colors duration-200 font-medium"
        >Home</a
      >
    </li>
    <li class="flex items-center">
      <ChevronRight className="h-3 w-3 text-muted-foreground" />
    </li>
    {
      category && (
        <>
          <li>
            <a
              href={`/categories/${category.slug}`}
              class="text-muted-foreground hover:text-primary transition-colors duration-200 font-medium"
            >
              {category.name}
            </a>
          </li>
          <li class="flex items-center">
            <ChevronRight className="h-3 w-3 text-muted-foreground" />
          </li>
        </>
      )
    }
    <li class="text-foreground font-semibold truncate">{product.name}</li>
  </ol>
</nav>
