---
import Icon from "@/components/icons/Icon.astro";
import ProductDetails from "./ProductDetails.astro";
import ProductBuyerInputs from "./ProductBuyerInputs.astro";
import type { Product, ProductOptionDefinition, ProductVariant } from "@/lib/api";
import {
  getBuyerVariantPricePresentation,
  getVariantDiscountedPrice,
  formatDiscountBadge,
  type ProductPricing,
} from "./lib/pricing-engine";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { DEFAULT_CURRENCY, formatMoney } from "@scalius/shared/currency";
import { ENGLISH_CHECKOUT_LANGUAGE_DATA, type CheckoutLanguageData } from "@scalius/shared/checkout-language";
import { formatCheckoutLanguageText } from "@scalius/shared/checkout-language-format";
import { getBuyerStockSummary, isVariantAvailable } from "@/lib/product-sellable-variants";
import {
  getVariantOptionAvailabilityMap,
  initialVariantPresentation,
  pricedVariantForOption,
  shouldShowStartingVariantPrice,
  type VariantOptionAvailability,
} from "./lib/variant-state-machine";
import {
  getProductActionsPresentation,
  type ProductActionCopy,
} from "./lib/product-actions";
import { describeBuyGetOffer, describeBundleTiers } from "./lib/product-offers";
import { moneyPlaces, pickBuyerInputCopy } from "./lib/buyer-inputs";
import { specificationValue } from "./lib/product-page-modules";
import type { StorefrontBuyBoxLook } from "@scalius/shared/storefront-theme";

interface Props {
  product: Product;
  category: Product["category"] | null;
  variants: ProductVariant[];
  options: ProductOptionDefinition[];
  currencySymbol?: string;
  currencyDecimalPlaces?: number;
  currencyCode?: string;
  /** The store's price increment (server renders have no page globals). */
  priceIncrementMinor?: number;
  initialVariant?: ProductVariant | null;
  initialUnavailableVariant?: ProductVariant | null;
  quickBuyNotice?: string | null;
  /** Product-page copy from the active checkout language (buttons, buyer inputs). */
  actionCopy?: Partial<ProductActionCopy & CheckoutLanguageData>;
  /** A fulfilment badge beside the stock badge ("No delivery needed" for services). */
  fulfilmentBadge?: string | null;
  /** The template's buy-box look; null keeps today's classic buy box untouched. */
  look?: StorefrontBuyBoxLook | null;
  /** Grocery purchase actions use a quantity + cart row over the direct-buy button. */
  essentials?: boolean;
  /** The description tabs sit in the buy box (classic, Dawn); false moves them below the fold. */
  details?: boolean;
  /** The key features show in the buy box or in "About this item": the tabs leave them out. */
  detailsFeatures?: boolean;
}

const {
  product,
  variants,
  options,
  currencySymbol = DEFAULT_CURRENCY.symbol,
  currencyDecimalPlaces = DEFAULT_CURRENCY.decimalPlaces,
  currencyCode = DEFAULT_CURRENCY.code,
  priceIncrementMinor,
  initialVariant = null,
  initialUnavailableVariant = null,
  quickBuyNotice = null,
  actionCopy: providedCopy = {},
  fulfilmentBadge = null,
  look = null,
  essentials = false,
  details = true,
  detailsFeatures = true,
} = Astro.props;

// A template's buy box: its reference type scale and buttons as CSS custom
// properties read by the scoped rules below (none on classic).
const lookStyle = look
  ? [
      `--bb-title-phone: ${look.title.size.phone}px`,
      `--bb-title-desktop: ${look.title.size.desktop}px`,
      `--bb-title-weight: ${look.title.weight}`,
      `--bb-price-phone: ${look.price.size.phone}px`,
      `--bb-price-desktop: ${look.price.size.desktop}px`,
      `--bb-price-weight: ${look.price.weight}`,
      `--bb-cta-height: ${look.cta.height}px`,
      `--bb-cta-max: ${look.cta.maxWidth === null ? "none" : `${look.cta.maxWidth}px`}`,
    ].join("; ")
  : undefined;
const factsColumn = look?.facts === "column";
const factPills = look?.factPills === true;
const plainDetails = details && look?.card === true;
const savedFacts = (product.attributes ?? []).filter((row) => row.name.trim() && row.value.trim() && row.name.trim().toLowerCase() !== "brand");
const savedBrand = product.brand?.name?.trim();
const compactFacts = factsColumn
  ? [
      ...(savedBrand ? [{ name: "Brand", value: savedBrand, unit: null }] : []),
      ...savedFacts.filter((row) => row.keySpec),
      ...savedFacts.filter((row) => !row.keySpec),
    ].slice(0, 5)
  : [];

const pageCopy: CheckoutLanguageData = { ...ENGLISH_CHECKOUT_LANGUAGE_DATA, ...providedCopy };
const actionCopy: ProductActionCopy = pageCopy;
const formatPrice = (price: number) => formatMoney(price, { code: currencyCode, symbol: currencySymbol });

// A link to a sold-out combination still shows that combination, marked sold out.
const {
  selection: initialSelection,
  selectedVariant: initialSelectedVariant,
  stockVariant,
  pricingVariants,
} = initialVariantPresentation(options, variants, initialVariant, initialUnavailableVariant);
// A product code must identify the same SKU after every buyer choice.
const stableSku = options.length === 0 && variants.length === 1 ? initialSelectedVariant?.sku.trim() : null;
const buyerStockSummary = getBuyerStockSummary(stockVariant ? [stockVariant] : variants);
const stockActionPresentation = getProductActionsPresentation({
  productName: product.name,
  anyVariantAvailable: getBuyerStockSummary(variants).canPurchaseAny,
  chosenVariantSoldOut: Boolean(stockVariant && !buyerStockSummary.canPurchaseAny),
  copy: actionCopy,
});
// A broken buyer-input setup means the product can't be bought at all.
const customizationUnavailable = product.customizationUnavailable === true;
const actionPresentation = customizationUnavailable
  ? {
      addToCart: { ...stockActionPresentation.addToCart, disabled: true },
      buyNow: { ...stockActionPresentation.buyNow, disabled: true },
    }
  : stockActionPresentation;
// The buy area is always a real form posting to /buy/<slug> (safe before
// hydration and without JavaScript); buyer inputs add their fields to it.
const buyerInputFields = customizationUnavailable ? [] : (product.customization?.fields ?? []);
const buyFormId = "product-buy-form";
const hasBuyerInputs = buyerInputFields.length > 0;
// Without JavaScript the option buttons cannot choose a SKU; a plain select of
// the buyer's purchasable combinations does, in the same form.
const noScriptVariants = options.length > 0
  ? variants
      .filter((variant) => isVariantAvailable(variant))
      .map((variant) => ({
        id: variant.id,
        label: variant.selectedOptions.map((option) => option.value).join(" / "),
      }))
      .filter((variant) => variant.label)
  : [];
const buyerInputCopy = pickBuyerInputCopy(pageCopy);
const stockAvailable = buyerStockSummary.tone === "available";

const productPricing: ProductPricing = {
  basePrice: product.price,
  discountType: product.discountType,
  discountPercentage: product.discountPercentage,
  discountAmount: product.discountAmount,
  currencyDecimalPlaces,
  currencyCode,
  priceIncrementMinor,
};
const pricePresentation = getBuyerVariantPricePresentation(productPricing, pricingVariants);
// "From" only when the buyer's choices really are priced differently.
const showsStartingPrice =
  shouldShowStartingVariantPrice(options.length > 0, stockVariant) && pricePresentation.isStartingAt;
const pricing = pricePresentation.pricing;
// Quantity tiers beside the price, worded from the tier alone ("Buy 2, save
// 10%", "Buy 3 for ৳600") so they hold for every SKU; checkout prices them.
const bundleTiers = describeBundleTiers(product.bundles ?? [], pageCopy, formatPrice);
const bundleListLabel = bundleTiers.map((tier) => [tier.label, tier.text].filter(Boolean).join(": ")).join("; ");
const discountBadge = pricing.hasDiscount
  ? formatDiscountBadge(pricing.originalPrice, pricing.finalPrice)
  : null;

const variantsJson = serializeJsonForInlineScript(variants.map((variant) => {
  const variantPrice = variant.price ?? product.price;
  const discountedPrice = getVariantDiscountedPrice(
    variant.price,
    product.price,
    variant.discountType,
    variant.discountPercentage,
    variant.discountAmount,
    product.discountType,
    product.discountPercentage,
    product.discountAmount,
    currencyDecimalPlaces,
    currencyCode,
    priceIncrementMinor,
  );
  return {
    id: variant.id,
    imageId: variant.imageId,
    imageUrl: variant.imageUrl,
    imageMediaId: variant.imageMediaId,
    selectedOptions: variant.selectedOptions.map((option) => ({
      optionDefinitionId: option.optionDefinitionId,
      optionValueId: option.optionValueId,
      name: option.name,
      value: option.value,
    })),
    price: variantPrice,
    stock: variant.stock,
    reservedStock: variant.reservedStock,
    trackInventory: variant.trackInventory,
    lowStockThreshold: variant.lowStockThreshold,
    availabilityBand: variant.availabilityBand,
    discountedPrice,
    discountType: variant.discountType || product.discountType || "percentage",
    discountPercentage: variant.discountPercentage ?? product.discountPercentage ?? 0,
    discountAmount: variant.discountAmount ?? product.discountAmount ?? 0,
    fulfillmentKind: variant.fulfillmentKind,
  };
}));
const optionsJson = serializeJsonForInlineScript(options.map((option) => ({
  id: option.id,
  name: option.name,
  values: option.values.map((value) => ({ id: value.id })),
})));
const unavailableLabel = initialUnavailableVariant?.selectedOptions
  .map((option) => `${option.name} ${option.value}`)
  .join(" / ");
const offers = (product.offers ?? []).map((offer) => ({
  ...offer,
  text: describeBuyGetOffer(offer, actionCopy, formatPrice),
}));

function optionAriaLabel(
  option: ProductOptionDefinition,
  value: string,
  availability: VariantOptionAvailability,
) {
  if (availability === "sold_out") return `${option.name}: ${value}. Out of stock.`;
  if (availability === "incompatible") return `${option.name}: ${value}. Not available with the current selection.`;
  return `${option.name}: ${value}`;
}
---

<div
  class="lg:col-span-5 xl:col-span-6"
  data-product-summary
  data-buy-box-look={look ? "" : undefined}
  data-cta-shape={look?.cta.shape}
  data-cta-layout={look?.cta.layout}
  data-cta-phone-layout={look?.cta.phoneLayout}
  data-cta-first={look?.cta.first}
  data-quantity-inline={look?.cta.inlineQuantity ? "" : undefined}
  data-price-tone={look?.price.tone}
  data-buy-box-card={look?.card ? "" : undefined}
  data-facts-column={factsColumn ? "" : undefined}
  data-fact-pills={factPills ? "" : undefined}
  data-essentials-buy-box={essentials ? "" : undefined}
  style={lookStyle}
>
  <div class="buy-box-body flex h-full flex-col">
    <div
      id="product-actions"
      data-add-to-cart-text={actionCopy.addToCartText}
      data-buy-now-text={actionCopy.buyNowText}
      data-unavailable-text={actionCopy.unavailableText}
      data-choose-option-text={actionCopy.chooseOptionText}
      data-quantity-limit-text={actionCopy.quantityLimitText}
    >
    <div class="buy-box-main">
    <div class="mb-2 border-b border-border pb-2">
      <div class="buy-box-title">
        <h1 class="mb-1 text-lg font-semibold leading-tight text-foreground lg:mb-2 lg:text-3xl">{product.name}</h1>
        <slot name="after-title" />
      </div>
      {quickBuyNotice ? <div class="mb-2 rounded-md border border-destructive/25 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive" role="alert">{quickBuyNotice}</div> : null}
      <div class="buy-box-main-price flex flex-wrap items-center gap-x-2 gap-y-1">
        <div class="buy-box-price-fact">
          {factPills && <span class="text-muted-foreground">Price:</span>}
          <p class="product-price whitespace-nowrap text-xl font-semibold text-foreground lg:text-3xl" aria-live="polite" data-from-template={actionCopy.fromPriceText}>
            {showsStartingPrice
              ? formatCheckoutLanguageText(actionCopy.fromPriceText, { price: formatPrice(pricing.finalPrice) })
              : formatPrice(pricing.finalPrice)}
          </p>
        </div>
        <div class="buy-box-regular-fact">
          {factPills && <span class="text-muted-foreground">Regular Price:</span>}
          <s class:list={["product-original-price whitespace-nowrap text-sm text-muted-foreground", { hidden: !pricing.hasDiscount }]}>
            {formatPrice(pricing.originalPrice)}
          </s>
        </div>
        <span class:list={["discount-badge whitespace-nowrap rounded-md bg-primary/10 px-1.5 py-0.5 text-sm font-medium text-primary", { hidden: !discountBadge }]}>{discountBadge ?? ""}</span>
        {factPills && (
          <div id="product-stock-badge" class:list={["buy-box-fact-pill", stockAvailable ? "text-primary" : "text-destructive"]} data-stock-tone={buyerStockSummary.tone} aria-live="polite">
            <span class="text-muted-foreground">Status:</span><span id="product-stock-text" class="font-semibold">{buyerStockSummary.text}</span>
          </div>
        )}
        {factPills && fulfilmentBadge && <span class="buy-box-fact-pill" data-fulfilment-badge>{fulfilmentBadge}</span>}
        {factPills && stableSku && <div class="buy-box-fact-pill"><span class="text-muted-foreground">Product Code:</span><span class="font-semibold">{stableSku}</span></div>}
        {factPills && savedBrand && <div class="buy-box-fact-pill"><span class="text-muted-foreground">Brand:</span><span class="font-semibold">{savedBrand}</span></div>}
      </div>
      {bundleTiers.length > 0 ? (
        <ul class="mt-2 flex flex-wrap gap-1.5" data-product-bundles aria-label={bundleListLabel}>
          {bundleTiers.map((tier) => (
            <li class="inline-flex min-h-8 items-center gap-1.5 rounded-md border border-primary/30 bg-primary/5 px-2.5 py-1 text-sm text-foreground" data-bundle-quantity={tier.quantity}>
              {tier.label ? <span class="font-semibold text-primary">{tier.label}</span> : null}
              <span>{tier.text}</span>
            </li>
          ))}
        </ul>
      ) : null}
      <slot name="after-price" />
      {!factsColumn && !factPills && (
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <div id="product-stock-badge" class:list={["flex shrink-0 items-center whitespace-nowrap rounded-full border border-current px-2 py-0.5 text-sm", stockAvailable ? "text-primary" : "text-destructive"]} data-stock-tone={buyerStockSummary.tone} aria-live="polite">
            <Icon name="circle" class="me-1 h-2 w-2 fill-current" aria-hidden="true" /><span id="product-stock-text" class="font-medium">{buyerStockSummary.text}</span>
          </div>
          {fulfilmentBadge ? <span class="flex shrink-0 items-center whitespace-nowrap rounded-full border border-border bg-muted px-2 py-0.5 text-sm font-medium text-foreground" data-fulfilment-badge>{fulfilmentBadge}</span> : null}
        </div>
      )}
      {offers.length > 0 && (
        <ul class="mt-2 space-y-1" data-product-offers>
          {offers.map((offer) => (
            <li class="flex items-start gap-1.5 text-sm text-foreground" data-offer-ends={offer.endsAtEpochSeconds ?? ""}>
              <Icon name="tag" class="mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
              <span>
                <span class="font-medium">{offer.title}:</span> {offer.text.before}{offer.products.length === 1 && offer.products[0]!.slug !== product.slug
                  ? <a href={`/products/${encodeURIComponent(offer.products[0]!.slug)}`} class="font-medium text-primary underline underline-offset-2">{offer.text.item}</a>
                  : offer.text.item}{offer.text.after}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <script is:inline type="application/json" id="product-variants-data" set:html={variantsJson} />
    <script is:inline type="application/json" id="product-options-data" set:html={optionsJson} />

    <div class="space-y-3 pt-1 lg:pt-2">
      <div id="variant-unavailable-query-notice" class:list={["rounded-md border border-destructive/25 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive", { hidden: !initialUnavailableVariant }]} role="alert">
        {initialUnavailableVariant ? `${unavailableLabel}: ${buyerStockSummary.text}` : ""}
      </div>

      {options.length > 0 && <div class="variant-option-panels">
        {options.map((option) => {
          const availability = getVariantOptionAvailabilityMap(variants, option.id, option.values.map((value) => value.id), initialSelection);
          const optionPrices = new Map(option.values.flatMap((value) => {
            const variant = factsColumn
              ? pricedVariantForOption(variants, initialSelection, option.id, value.id, options.length)
              : null;
            return variant ? [[value.id, getVariantDiscountedPrice(
              variant.price,
              product.price,
              variant.discountType,
              variant.discountPercentage,
              variant.discountAmount,
              product.discountType,
              product.discountPercentage,
              product.discountAmount,
              currencyDecimalPlaces,
              currencyCode,
              priceIncrementMinor,
            )] as const] : [];
          }));
          return (
            <div class="variant-option-panel">
              <fieldset class="variant-option-selector" data-option-definition-id={option.id} aria-describedby={`product-option-${option.id}-missing`}>
                <legend class="mb-1 text-sm font-medium text-foreground">{option.name}</legend>
                <div class="variant-option-values flex flex-wrap gap-1.5" data-option-overflow={option.values.length > 8 ? "" : undefined}>
                  {option.values.map((value) => {
                    const selected = initialSelection[option.id] === value.id;
                    const status = availability.get(value.id) ?? "sold_out";
                    const optionPrice = optionPrices.has(value.id)
                      ? formatPrice(optionPrices.get(value.id)!)
                      : null;
                    return (
                      <button
                        type="button"
                        class:list={[
                          "variant-option-btn cursor-pointer",
                          {
                            "border-primary bg-primary text-primary-foreground": selected && status !== "sold_out",
                            "border-input bg-background text-foreground": !selected && status === "available",
                            "border-dashed border-muted-foreground bg-muted text-foreground": !selected && status === "incompatible",
                            "cursor-not-allowed border-input bg-background text-muted-foreground line-through": status === "sold_out",
                            "ring-2 ring-destructive": selected && status === "sold_out",
                          },
                        ]}
                        data-option-definition-id={option.id}
                        data-option-value-id={value.id}
                        data-option-value={value.value}
                        data-option-availability={status}
                        aria-pressed={selected ? "true" : "false"}
                        aria-label={`${optionAriaLabel(option, value.value, status)}${optionPrice ? ` ${optionPrice}.` : ""}`}
                        aria-disabled={status === "sold_out" ? "true" : undefined}
                      >
                        <span>{value.value}</span>
                        {factsColumn && <span data-option-price hidden={!optionPrice}>{optionPrice ?? ""}</span>}
                      </button>
                    );
                  })}
                </div>
                <p id={`product-option-${option.id}-missing`} class="option-missing-message mt-1 hidden text-sm font-medium text-destructive" role="alert"></p>
              </fieldset>
            </div>
          );
        })}
      </div>}

      {compactFacts.length > 0 && (
        <dl class="hidden space-y-1 pt-1 text-sm leading-5 lg:block" data-product-compact-facts>
          {compactFacts.map((row) => (
            <div class="grid grid-cols-[minmax(0,10rem)_minmax(0,1fr)] gap-x-3">
              <dt class="min-w-0 break-words font-semibold text-foreground">{row.name}</dt>
              <dd class="min-w-0 break-words text-foreground">{specificationValue(row)}</dd>
            </div>
          ))}
        </dl>
      )}

      {customizationUnavailable ? (
        <p id="product-customization-unavailable" class="rounded-md border border-destructive/25 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive" role="alert">{pageCopy.customizationUnavailableText}</p>
      ) : null}

      {hasBuyerInputs ? (
        <ProductBuyerInputs
          formId={buyFormId}
          slug={product.slug}
          fields={buyerInputFields}
          copy={buyerInputCopy}
          variantId={initialSelectedVariant?.id ?? null}
          currencyPlaces={moneyPlaces(currencyDecimalPlaces, currencyCode)}
          formatMoney={formatPrice}
        />
      ) : (
        <form id={buyFormId} method="post" action={`/buy/${encodeURIComponent(product.slug)}`} data-product-buy-form>
          <input type="hidden" name="variant" value={initialSelectedVariant?.id ?? ""} />
        </form>
      )}

      {noScriptVariants.length > 0 ? (
        <noscript>
          <style is:inline>.variant-option-panels{display:none}</style>
          <label for="product-variant-noscript" class="mb-1 block text-sm font-medium text-foreground">{options.map((option) => option.name).join(" / ")}</label>
          <select id="product-variant-noscript" name="variant" form={buyFormId} class="block h-11 w-full rounded-lg border border-input bg-background px-3 text-base text-foreground">
            {noScriptVariants.map((variant) => (
              <option value={variant.id} selected={variant.id === initialSelectedVariant?.id}>{variant.label}</option>
            ))}
          </select>
        </noscript>
      ) : null}

    </div>
    </div>
      <div class="buy-box-purchase">
      {factsColumn && (
        <p class="purchase-price product-price text-2xl text-foreground" aria-live="polite" data-from-template={actionCopy.fromPriceText}>
          {showsStartingPrice
            ? formatCheckoutLanguageText(actionCopy.fromPriceText, { price: formatPrice(pricing.finalPrice) })
            : formatPrice(pricing.finalPrice)}
        </p>
      )}
      {factsColumn && (
        <div class="flex flex-wrap items-center gap-2">
          <div id="product-stock-badge" class:list={["flex shrink-0 items-center whitespace-nowrap rounded-full border border-current px-2 py-0.5 text-sm", stockAvailable ? "text-primary" : "text-destructive"]} data-stock-tone={buyerStockSummary.tone} aria-live="polite">
            <Icon name="circle" class="me-1 h-2 w-2 fill-current" aria-hidden="true" /><span id="product-stock-text" class="font-medium">{buyerStockSummary.text}</span>
          </div>
          {fulfilmentBadge ? <span class="flex shrink-0 items-center whitespace-nowrap rounded-full border border-border bg-muted px-2 py-0.5 text-sm font-medium text-foreground" data-fulfilment-badge>{fulfilmentBadge}</span> : null}
        </div>
      )}
      <div>
        <label for="quantity" class:list={["mb-1 block text-sm font-medium text-foreground", look?.cta.inlineQuantity && "lg:sr-only"]}>{actionCopy.quantityLabelText}</label>
        <div class="flex items-center">
          <button type="button" id="quantity-minus" class="inline-flex h-11 w-11 items-center justify-center rounded-s-md border border-input bg-background text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring lg:h-10 lg:w-10" aria-label="Decrease quantity"><Icon name="minus" class="h-4 w-4" aria-hidden="true" /></button>
          <input type="text" inputmode="numeric" pattern="[0-9]*" id="quantity" name="quantity" value="1" form={buyFormId} aria-describedby="quantity-message" class="h-11 w-14 border-y border-input bg-background text-center text-base font-medium tabular-nums text-foreground focus:outline-2 focus:-outline-offset-2 focus:outline-ring lg:h-10" />
          <button type="button" id="quantity-plus" class="inline-flex h-11 w-11 items-center justify-center rounded-e-md border border-input bg-background text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring lg:h-10 lg:w-10" aria-label="Increase quantity"><Icon name="plus" class="h-4 w-4" aria-hidden="true" /></button>
        </div>
        <p id="quantity-message" class="mt-1 hidden text-sm text-muted-foreground" role="status"></p>
      </div>

      <p id="variant-availability-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>
      <div class="buy-box-ctas flex gap-2 pt-1">
        <button type="submit" form={buyFormId} data-action="add-to-cart" disabled={actionPresentation.addToCart.disabled} class="flex min-h-11 flex-1 items-center justify-center rounded-lg border border-primary bg-background px-2 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:border-border disabled:bg-muted disabled:text-muted-foreground" aria-label={actionPresentation.addToCart.ariaLabel}>
          {look?.cta.showBuyNow !== false && <Icon name="shopping-cart" class="me-1.5 h-4 w-4" aria-hidden="true" />}<span data-action-label="add-to-cart">{actionPresentation.addToCart.label}</span>
        </button>
        {look?.cta.showBuyNow !== false && (
          <button type="submit" form={buyFormId} data-action="buy-now" disabled={actionPresentation.buyNow.disabled} hidden={actionPresentation.buyNow.disabled} class="flex min-h-11 flex-1 items-center justify-center rounded-lg border border-primary bg-primary px-2 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:border-border disabled:bg-muted disabled:text-muted-foreground" aria-label={actionPresentation.buyNow.ariaLabel}>
            <span data-action-label="buy-now">{actionPresentation.buyNow.label}</span>
          </button>
        )}
      </div>
      {factsColumn && (
        <aside class="buy-box-facts">
          <slot name="after-actions" />
        </aside>
      )}
      </div>
    </div>
    {!factsColumn && (
      <slot name="after-actions" />
    )}
    {details && !plainDetails && <ProductDetails product={product} copy={pageCopy} features={detailsFeatures} />}
  </div>
  {plainDetails && <ProductDetails product={product} copy={pageCopy} features={detailsFeatures} plain />}
</div>

