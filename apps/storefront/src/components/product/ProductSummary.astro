---
import { checkoutText } from "@/lib/checkout-text";
import Icon from "@/components/icons/Icon.astro";
import ProductDetails from "./ProductDetails.astro";
import ProductPurchaseOptions from "./ProductPurchaseOptions.astro";
import BuyFormActions from "./buy-form/BuyFormActions.astro";
import BuyFormOptions, { type BuyFormOptionGroup } from "./buy-form/BuyFormOptions.astro";
import BuyFormPrice from "./buy-form/BuyFormPrice.astro";
import BuyFormQuantity from "./buy-form/BuyFormQuantity.astro";
import BuyFormInputs from "./buy-form/BuyFormInputs.astro";
import BuyFormStatus from "./buy-form/BuyFormStatus.astro";
import BuyFormStock from "./buy-form/BuyFormStock.astro";
import { mediaImageUrl } from "@/lib/media-url";
import { BUY_FORM_PLACED_PART } from "./lib/buy-scope";
import type { Product, ProductOptionDefinition, ProductVariant } from "@/lib/api";
import {
  getBuyerVariantPricePresentation,
  getVariantDiscountedPrice,
  formatDiscountBadge,
  type ProductPricing,
} from "./lib/pricing-engine";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import { VARIANT_PREPAINT_SCRIPT } from "@/lib/inline-boot-scripts";
import { DEFAULT_CURRENCY, formatMoney } from "@/lib/currency";
import { ENGLISH_CHECKOUT_LANGUAGE_DATA, type CheckoutLanguageData } from "@scalius/shared/checkout-language";

import { getBuyerStockSummary, isVariantAvailable } from "@/lib/product-sellable-variants";
import {
  getVariantOptionAvailabilityMap,
  initialVariantPresentation,
  pricedVariantForOption,
  shouldShowStartingVariantPrice,
  type VariantOptionAvailability,
} from "./lib/variant-state-machine";
import {
  getProductActionsPresentation,
  type ProductActionCopy,
} from "./lib/product-actions";
import { describeBuyGetOffer, describeBundleTiers } from "./lib/product-offers";
import { pickBuyerInputCopy, productBuyerInputFields } from "./lib/buyer-inputs";
import { moneyPlaces } from "./lib/line-price";
import { BUY_FORM_ID, BUY_FORM_VARIANT_FIELDS } from "./lib/buy-form";
import { catalogCopy } from "@/lib/catalog-copy";
import { shopCopy } from "@/lib/storefront-shop-copy";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { getLayoutData } from "@/lib/api/storefront";
import { getRuntime } from "@/lib/api/runtime";
import type { StorefrontBuyBoxLook } from "@scalius/shared/storefront-theme";
import type { StorefrontBuyFormOptionLayout, StorefrontBuyFormPart, StorefrontProductPage } from "@scalius/shared/plugins/storefront-protocol";
import { specificationText } from "@/lib/specification-text";

const CLASSIC_LOOK: StorefrontBuyBoxLook = { cta: { layout: "row" }, facts: "list", features: "none", details: "buy-box" };

interface Props {
  product: Product;
  /** The same public facts a product_main skin draws. */
  projection?: StorefrontProductPage;
  category: Product["category"] | null;
  variants: ProductVariant[];
  options: ProductOptionDefinition[];
  currencySymbol?: string;
  currencyDecimalPlaces?: number;
  currencyCode?: string;
  /** The store's price increment (server renders have no page globals). */
  priceIncrementMinor?: number;
  quickBuyNotice?: string | null;
  /**
   * What the page sells is paid only online (digital items, gift cards) and
   * checkout takes no online payment: the buttons are off and a note says why.
   */
  onlinePaymentUnavailable?: boolean;
  /** Product-page copy from the active checkout language (buttons, buyer inputs). */
  actionCopy?: Partial<ProductActionCopy & CheckoutLanguageData>;
  /** A fulfilment badge beside the stock badge ("No delivery needed" for services). */
  fulfilmentBadge?: string | null;
  /** The buy box's arrangement (buttons, facts column, key features, description). */
  look?: StorefrontBuyBoxLook;
  /** The stock line's words (the store's language); sold out is the checkout language's. */
  stockWords?: { inStock: string; lowStock: string };
  /** The sold-out view's words: a note and a link to similar items. */
  soldOutCopy?: { note: string; similar: string };
  /** The description tabs sit in the buy box (classic, Dawn); false moves them below the fold. */
  details?: boolean;
  /** The key features show in the buy box or in "About this item": the tabs leave them out. */
  detailsFeatures?: boolean;
  /** False leaves out the product title (a product_main skin that draws its own `<h1>`). */
  title?: boolean;
  /**
   * False leaves out the option buttons: a product_main skin's own SKU
   * controls choose every buyable SKU (the host checked that,
   * lib/extensions/purchase-controls.ts). The no-JavaScript picker stays.
   */
  nativeOptions?: boolean;
  /** How the option controls draw (`buttons`, `select`, `swatches`): a skin's `optionsLayout`, or its options part's `layout`. */
  optionsLayout?: StorefrontBuyFormOptionLayout;
  /**
   * False leaves out Add to cart and Buy now: a product_main skin's own buy
   * buttons buy every buyable SKU (the host checked that,
   * lib/extensions/purchase-controls.ts).
   */
  nativeActions?: boolean;
  /** The parts a product_main skin draws apart from the form (`<BuyFormPart />`): left out here. */
  placed?: readonly StorefrontBuyFormPart[];
  /** Draw only this part, where the skin placed it, in a host-only wrapper (lib/buy-scope.ts). */
  only?: StorefrontBuyFormPart;
}

const {
  product,
  projection,
  category,
  variants,
  options,
  currencySymbol = DEFAULT_CURRENCY.symbol,
  currencyDecimalPlaces = DEFAULT_CURRENCY.decimalPlaces,
  currencyCode = DEFAULT_CURRENCY.code,
  priceIncrementMinor,
  quickBuyNotice = null,
  onlinePaymentUnavailable = false,
  actionCopy: providedCopy = {},
  fulfilmentBadge = null,
  look = CLASSIC_LOOK,
  stockWords: givenStockWords,
  soldOutCopy: givenSoldOutCopy,
  details = true,
  detailsFeatures = true,
  title = true,
  nativeOptions = true,
  optionsLayout = "buttons",
  nativeActions = true,
  placed = [],
  only,
} = Astro.props;

const { language } = await currentRequestTheme(Astro.locals);
const catalogWords = catalogCopy(language).product;
// The store's words unless the page passed its own.
const shopWords = shopCopy(language).product;
const stockWords = givenStockWords ?? shopWords.stock;
const soldOutCopy = givenSoldOutCopy ?? { note: shopWords.soldOutNote, similar: shopWords.seeSimilar };
const factsColumn = look.facts === "column";
const savedFacts = (product.attributes ?? []).filter((row) => row.name.trim() && row.value.trim() && row.name.trim().toLowerCase() !== "brand");
const savedBrand = product.brand?.name?.trim();
const compactFacts = factsColumn
  ? [
      ...(savedBrand ? [{ name: catalogWords.brand, value: savedBrand, unit: null }] : []),
      ...savedFacts.filter((row) => row.keySpec),
      ...savedFacts.filter((row) => !row.keySpec),
    ].slice(0, 5)
  : [];

const pageCopy: CheckoutLanguageData = { ...ENGLISH_CHECKOUT_LANGUAGE_DATA, ...providedCopy };
const actionCopy: ProductActionCopy = pageCopy;
const formatPrice = (price: number) => formatMoney(price, { code: currencyCode, symbol: currencySymbol });

// The opening choice. A `?variant=` link is the same cached page: the
// pre-paint script below holds the choice-dependent parts until
// product-controller.ts selects that SKU (a sold-out one shows, marked).
const {
  selection: initialSelection,
  selectedVariant: initialSelectedVariant,
  stockVariant,
  pricingVariants,
} = initialVariantPresentation(options, variants);
// A product code must identify the same SKU after every buyer choice.
const stableSku = options.length === 0 && variants.length === 1 ? initialSelectedVariant?.sku.trim() : null;
const buyerStockSummary = getBuyerStockSummary(stockVariant ? [stockVariant] : variants);
const stockActionPresentation = getProductActionsPresentation({
  productName: product.name,
  anyVariantAvailable: getBuyerStockSummary(variants).canPurchaseAny,
  chosenVariantSoldOut: Boolean(stockVariant && !buyerStockSummary.canPurchaseAny),
  copy: actionCopy,
});
// A broken buyer-input setup means the product can't be bought at all.
const customizationUnavailable = product.customizationUnavailable === true;
// Nothing here can be bought: a note says why, and the buttons stay off.
const purchaseBlocked = customizationUnavailable || onlinePaymentUnavailable;
const actionPresentation = purchaseBlocked
  ? {
      addToCart: { ...stockActionPresentation.addToCart, disabled: true },
      buyNow: { ...stockActionPresentation.buyNow, disabled: true },
    }
  : stockActionPresentation;
// The buy area is always a real form posting to /buy/<slug> (safe before
// hydration and without JavaScript); buyer inputs add their fields to it:
// the product's own, then the active apps' line inputs shown on it (the
// layout read the page already made; none on a gift card).
const layout = getRuntime() ? await getLayoutData() : null;
const buyerInputFields = productBuyerInputFields(product, layout?.lineInputs);
const buyFormId = BUY_FORM_ID;
const hasBuyerInputs = buyerInputFields.length > 0;
// Without JavaScript the option buttons cannot choose a SKU; a plain select of
// the buyer's purchasable combinations does, in the same form.
const noScriptVariants = options.length > 0
  ? variants
      .filter((variant) => isVariantAvailable(variant))
      .map((variant) => ({
        id: variant.id,
        label: variant.selectedOptions.map((option) => option.value).join(" / "),
      }))
      .filter((variant) => variant.label)
  : [];
const buyerInputCopy = pickBuyerInputCopy(pageCopy);
// The apps' ways to buy (a subscription, a protection plan), from the same
// layout read; none on a gift card (money), or while nothing can be bought.
const purchaseOptions = purchaseBlocked || product.isGiftCard ? [] : (layout?.purchaseOptions ?? []);
const stockAvailable = buyerStockSummary.tone === "available";
// A price on each option value only when the values are priced differently.
const onlyWhenDifferent = (prices: Map<string, number>) => new Set(prices.values()).size > 1 ? prices : new Map<string, number>();
const stockLabel = (text: string) => text === "In Stock" ? stockWords.inStock : text === "Low Stock" ? stockWords.lowStock : pageCopy.unavailableText;
// Nothing is buyable: no quantity to choose, and a way to keep shopping instead of a dead end.
const allSoldOut = variants.length > 0 && !buyerStockSummary.canPurchaseAny;
const similarHref = category?.slug ? `/categories/${encodeURIComponent(category.slug)}` : "/search";

const productPricing: ProductPricing = {
  basePrice: product.price,
  discountType: product.discountType,
  discountPercentage: product.discountPercentage,
  discountAmount: product.discountAmount,
  currencyDecimalPlaces,
  currencyCode,
  priceIncrementMinor,
};
const pricePresentation = getBuyerVariantPricePresentation(productPricing, pricingVariants);
// "From" only when the buyer's choices really are priced differently.
const showsStartingPrice =
  shouldShowStartingVariantPrice(options.length > 0, stockVariant) && pricePresentation.isStartingAt;
const pricing = pricePresentation.pricing;
const openingPrice = projection?.product.price.formatted ?? formatPrice(pricing.finalPrice);
const openingRegularPrice = projection?.product.compareAt?.formatted ?? formatPrice(pricing.originalPrice);
// Quantity tiers beside the price, worded from the tier alone ("Buy 2, save
// 10%", "Buy 3 for ৳600") so they hold for every SKU; checkout prices them.
const bundleTiers = describeBundleTiers(product.bundles ?? [], pageCopy, formatPrice);
const bundleListLabel = bundleTiers.map((tier) => [tier.label, tier.text].filter(Boolean).join(": ")).join("; ");
const discountBadge = pricing.hasDiscount
  ? formatDiscountBadge(pricing.originalPrice, pricing.finalPrice)
  : null;

const variantsJson = serializeJsonForInlineScript(variants.map((variant) => {
  const variantPrice = variant.price ?? product.price;
  const discountedPrice = getVariantDiscountedPrice(
    variant.price,
    product.price,
    variant.discountType,
    variant.discountPercentage,
    variant.discountAmount,
    product.discountType,
    product.discountPercentage,
    product.discountAmount,
    currencyDecimalPlaces,
    currencyCode,
    priceIncrementMinor,
  );
  return {
    id: variant.id,
    imageId: variant.imageId,
    imageUrl: variant.imageUrl,
    imageMediaId: variant.imageMediaId,
    selectedOptions: variant.selectedOptions.map((option) => ({
      optionDefinitionId: option.optionDefinitionId,
      optionValueId: option.optionValueId,
      name: option.name,
      value: option.value,
    })),
    price: variantPrice,
    stock: variant.stock,
    reservedStock: variant.reservedStock,
    trackInventory: variant.trackInventory,
    lowStockThreshold: variant.lowStockThreshold,
    availabilityBand: variant.availabilityBand,
    discountedPrice,
    discountType: variant.discountType || product.discountType || "percentage",
    discountPercentage: variant.discountPercentage ?? product.discountPercentage ?? 0,
    discountAmount: variant.discountAmount ?? product.discountAmount ?? 0,
    fulfillmentKind: variant.fulfillmentKind,
  };
}));
const optionsJson = serializeJsonForInlineScript(options.map((option) => ({
  id: option.id,
  name: option.name,
  values: option.values.map((value) => ({ id: value.id })),
})));
// The option buttons, one group per axis (the facts column prices each value
// when the values are priced differently).
const optionGroups: BuyFormOptionGroup[] = options.map((option) => {
  const availability = getVariantOptionAvailabilityMap(variants, option.id, option.values.map((value) => value.id), initialSelection);
  const pricedOptions = new Map(option.values.flatMap((value) => {
    const variant = factsColumn
      ? pricedVariantForOption(variants, initialSelection, option.id, value.id, options.length)
      : null;
    return variant ? [[value.id, getVariantDiscountedPrice(
      variant.price,
      product.price,
      variant.discountType,
      variant.discountPercentage,
      variant.discountAmount,
      product.discountType,
      product.discountPercentage,
      product.discountAmount,
      currencyDecimalPlaces,
      currencyCode,
      priceIncrementMinor,
    )] as const] : [];
  }));
  // A price on each value only when the values are priced differently.
  const optionPrices = onlyWhenDifferent(pricedOptions);
  return {
    id: option.id,
    name: option.name,
    overflow: option.values.length > 8,
    values: option.values.map((value) => {
      const status = availability.get(value.id) ?? "sold_out";
      const price = optionPrices.has(value.id) ? formatPrice(optionPrices.get(value.id)!) : null;
      return {
        id: value.id,
        value: value.value,
        selected: initialSelection[option.id] === value.id,
        status,
        price,
        ariaLabel: `${optionAriaLabel(option, value.value, status)}${price ? ` ${price}.` : ""}`,
        // The merchant's swatch (Products): its image's small rendition, else its colour; none: a word.
        swatch: optionsLayout === "swatches" && value.swatch && (value.swatch.color || value.swatch.imageUrl)
          ? { color: value.swatch.color, imageUrl: value.swatch.imageUrl ? mediaImageUrl(value.swatch.imageUrl, 96) || null : null }
          : null,
      };
    }),
  };
});
// Which parts this render draws: the whole form less the parts a skin placed
// apart, or (`only`) one placed part. Options and actions only while shown.
const placedParts = new Set(placed);
const partHasContent = (part: StorefrontBuyFormPart) =>
  part === "options" ? options.length > 0 && nativeOptions
    : part === "purchase_options" ? purchaseOptions.length > 0
    : part !== "warranty";
// The form and its buyer inputs, wherever they are drawn.
const formInputs = {
  formId: buyFormId,
  slug: product.slug,
  variantId: initialSelectedVariant?.id ?? "",
  inputs: hasBuyerInputs
    ? { fields: buyerInputFields, copy: buyerInputCopy, currencyPlaces: moneyPlaces(currencyDecimalPlaces, currencyCode), formatMoney: formatPrice }
    : null,
};
const stockProps = { available: stockAvailable, tone: buyerStockSummary.tone, text: stockLabel(buyerStockSummary.text), fulfilmentBadge };
const purchaseOptionsCopy = { legend: catalogWords.purchaseOptions, oneTime: catalogWords.oneTimePurchase, price: catalogWords.purchaseOptionPrice, none: catalogWords.purchaseOptionNone };
const showPart = (part: StorefrontBuyFormPart) => (only ? only === part : !placedParts.has(part)) && partHasContent(part);
const offers = (product.offers ?? []).map((offer) => ({
  ...offer,
  text: describeBuyGetOffer(offer, actionCopy, formatPrice),
}));

function optionAriaLabel(
  option: ProductOptionDefinition,
  value: string,
  availability: VariantOptionAvailability,
) {
  const label = availability === "sold_out"
    ? catalogWords.optionSoldOut
    : availability === "incompatible" ? catalogWords.optionUnavailable : catalogWords.optionValue;
  return label(option.name, value);
}
---

{only ? (
  showPart(only) && (
    <div {...{ [BUY_FORM_PLACED_PART]: only }}>
      {only === "price" && (
        <BuyFormPrice
          price={showsStartingPrice ? checkoutText(actionCopy.fromPriceText, { price: openingPrice }) : openingPrice}
          regularPrice={openingRegularPrice}
          hasDiscount={pricing.hasDiscount}
          discountBadge={discountBadge}
          fromTemplate={actionCopy.fromPriceText}
        />
      )}
      {only === "options" && <BuyFormOptions groups={optionGroups} pricedValues={factsColumn} layout={optionsLayout} />}
      {only === "quantity" && (
        <BuyFormQuantity formId={buyFormId} hidden={allSoldOut} label={actionCopy.quantityLabelText} decrease={catalogWords.decreaseQuantity} increase={catalogWords.increaseQuantity} />
      )}
      {only === "actions" && <BuyFormActions formId={buyFormId} actions={actionPresentation} off={!nativeActions} />}
      {only === "inputs" && <BuyFormInputs {...formInputs} />}
      {only === "purchase_options" && <ProductPurchaseOptions formId={buyFormId} options={purchaseOptions} copy={purchaseOptionsCopy} />}
      {only === "stock" && <BuyFormStock {...stockProps} />}
      {only === "status" && <BuyFormStatus />}
    </div>
  )
) : (
<div
  data-product-summary
  data-sx-product-summary
  data-sticky-column
  data-cta-layout={look.cta.layout}
  data-facts-column={factsColumn ? "" : undefined}
>
  {/* Before first paint: a `?variant=` link holds the choice-dependent parts
      (VARIANT_PREPAINT_SCRIPT) until product-controller.ts selects its SKU. */}
  <script is:inline set:html={VARIANT_PREPAINT_SCRIPT} />
  <div class="buy-box-body flex h-full flex-col">
    <div
      id="product-actions"
      data-sx-buy="actions"
      data-add-to-cart-text={actionCopy.addToCartText}
      data-buy-now-text={actionCopy.buyNowText}
      data-unavailable-text={actionCopy.unavailableText}
      data-combination-unavailable-text={catalogWords.combinationUnavailable}
      data-choose-option-text={actionCopy.chooseOptionText}
      data-quantity-limit-text={actionCopy.quantityLimitText}
      data-cart-add-failed-text={pageCopy.quickBuyFailedText}
      data-stock-in-text={stockWords.inStock}
      data-stock-low-text={stockWords.lowStock}
      data-option-value-text={catalogWords.optionValue("{option}", "{value}")}
      data-option-sold-out-text={catalogWords.optionSoldOut("{option}", "{value}")}
      data-option-unavailable-text={catalogWords.optionUnavailable("{option}", "{value}")}
      data-option-selected-text={catalogWords.optionSelected("{value}")}
      data-update-cart-text={hasBuyerInputs ? buyerInputCopy.updateCartItemText : undefined}
    >
    <div class="buy-box-main">
    <div class="mb-2 border-b border-border pb-2">
      <div class="buy-box-title">
        {title && <h1 class="mb-1 text-lg font-semibold leading-tight text-foreground lg:mb-2 lg:text-3xl">{projection?.product.title ?? product.name}</h1>}
        <slot name="after-title" />
      </div>
      {quickBuyNotice ? <div class="mb-2 rounded-md border border-destructive/25 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive" role="alert">{quickBuyNotice}</div> : null}
      {showPart("price") && (
        <BuyFormPrice
          price={showsStartingPrice ? checkoutText(actionCopy.fromPriceText, { price: openingPrice }) : openingPrice}
          regularPrice={openingRegularPrice}
          hasDiscount={pricing.hasDiscount}
          discountBadge={discountBadge}
          fromTemplate={actionCopy.fromPriceText}
        />
      )}
      {bundleTiers.length > 0 ? (
        <ul class="mt-2 flex flex-wrap gap-1.5" data-product-bundles aria-label={bundleListLabel}>
          {bundleTiers.map((tier) => (
            <li class="inline-flex min-h-8 items-center gap-1.5 rounded-md border border-primary/30 bg-primary/5 px-2.5 py-1 text-sm text-foreground" data-bundle-quantity={tier.quantity}>
              {tier.label ? <span class="font-semibold text-primary">{tier.label}</span> : null}
              <span>{tier.text}</span>
            </li>
          ))}
        </ul>
      ) : null}
      <slot name="after-price" />
      {!factsColumn && showPart("stock") && <BuyFormStock {...stockProps} class="mt-2" />}
      {offers.length > 0 && (
        <ul class="mt-2 space-y-1" data-product-offers>
          {offers.map((offer) => (
            <li class="flex items-start gap-1.5 text-sm text-foreground" data-sx-buy="offer" data-offer-ends={offer.endsAtEpochSeconds ?? ""}>
              <Icon name="tag" class="mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
              <span>
                <span class="font-medium">{offer.title}:</span> {offer.text.before}{offer.products.length === 1 && offer.products[0]!.slug !== product.slug
                  ? <a href={`/products/${encodeURIComponent(offer.products[0]!.slug)}`} class="font-medium text-primary underline underline-offset-2">{offer.text.item}</a>
                  : offer.text.item}{offer.text.after}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <script is:inline type="application/json" id="product-variants-data" data-sx-buy="variants" set:html={variantsJson} />
    <script is:inline type="application/json" id="product-options-data" data-sx-buy="options" set:html={optionsJson} />

    <div class="space-y-3 pt-1 lg:pt-2">
      <div id="variant-unavailable-query-notice" data-sx-buy="unavailable-notice" class="hidden rounded-md border border-destructive/25 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive" role="alert"></div>

      {showPart("options") && <BuyFormOptions groups={optionGroups} pricedValues={factsColumn} layout={optionsLayout} />}

      {compactFacts.length > 0 && (
        <dl class="hidden space-y-1 pt-1 text-sm leading-5 lg:block" data-product-compact-facts>
          {compactFacts.map((row) => (
            <div class="grid grid-cols-[minmax(0,10rem)_minmax(0,1fr)] gap-x-3">
              <dt class="min-w-0 break-words font-semibold text-foreground">{row.name}</dt>
              <dd class="min-w-0 break-words text-foreground">{specificationText(row)}</dd>
            </div>
          ))}
        </dl>
      )}

      {customizationUnavailable ? (
        <p id="product-customization-unavailable" data-purchase-blocked data-sx-buy="blocked" class="rounded-md border border-destructive/25 bg-destructive/10 px-3 py-2 text-sm font-medium text-destructive" role="alert">{pageCopy.customizationUnavailableText}</p>
      ) : onlinePaymentUnavailable ? (
        <p id="product-online-payment-unavailable" data-purchase-blocked data-sx-buy="blocked" class="rounded-md border border-border bg-muted px-3 py-2 text-sm font-medium text-foreground" role="status">{pageCopy.onlinePaymentRequiredText}</p>
      ) : null}

      {showPart("inputs") && <BuyFormInputs {...formInputs} />}

      {showPart("purchase_options") && <ProductPurchaseOptions formId={buyFormId} options={purchaseOptions} copy={purchaseOptionsCopy} />}

      {noScriptVariants.length > 0 ? (
        <noscript>
          <style is:inline>.variant-option-panels{display:none}</style>
          <label for="product-variant-noscript" class="mb-1 block text-sm font-medium text-foreground">{options.map((option) => option.name).join(" / ")}</label>
          <select id="product-variant-noscript" name={BUY_FORM_VARIANT_FIELDS.picker} form={buyFormId} class="block h-11 w-full rounded-lg border border-input bg-background px-3 text-base text-foreground">
            {noScriptVariants.map((variant) => (
              <option value={variant.id} selected={variant.id === initialSelectedVariant?.id}>{variant.label}</option>
            ))}
          </select>
        </noscript>
      ) : null}

    </div>
    </div>
      <div class="buy-box-purchase">
      {factsColumn && (
        <p data-sx-buy="price" class="purchase-price product-price text-2xl text-foreground" aria-live="polite" data-from-template={actionCopy.fromPriceText}>
          {showsStartingPrice
            ? checkoutText(actionCopy.fromPriceText, { price: formatPrice(pricing.finalPrice) })
            : formatPrice(pricing.finalPrice)}
        </p>
      )}
      {factsColumn && showPart("stock") && <BuyFormStock {...stockProps} />}
      {showPart("quantity") && (
        <BuyFormQuantity formId={buyFormId} hidden={allSoldOut} label={actionCopy.quantityLabelText} decrease={catalogWords.decreaseQuantity} increase={catalogWords.increaseQuantity} />
      )}

      {/* The purchase's messages: the choice for screen readers, and a refused add's problem (product-controller.ts). */}
      {showPart("status") && <BuyFormStatus />}
      {showPart("actions") && <BuyFormActions formId={buyFormId} actions={actionPresentation} off={!nativeActions} />}
      {allSoldOut && (
        <div class="space-y-2" data-product-sold-out>
          <p class="text-sm text-muted-foreground">{soldOutCopy.note}</p>
          <a href={similarHref} class="flex min-h-12 items-center justify-center rounded-[var(--theme-button-radius,var(--radius))] border border-primary bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">{soldOutCopy.similar}</a>
        </div>
      )}
      {factsColumn && (
        <aside class="buy-box-facts">
          <slot name="after-actions" />
        </aside>
      )}
      </div>
    </div>
    {!factsColumn && (
      <slot name="after-actions" />
    )}
    {details && <ProductDetails product={product} features={detailsFeatures} />}
  </div>
</div>
)}

<style is:global>
  /* A `?variant=` link before product-controller.ts selects its SKU: the
     parts that depend on the choice keep their space and stay unpainted. */
  html[data-variant-pending] :is(.product-price, .product-original-price, .discount-badge, #product-stock-badge, .variant-option-values, [data-sticky-buy-price], [data-sx-warranty-rows]) {
    visibility: hidden;
  }

  /* An option value's button, once here instead of the same utilities on
     every value: Tailwind's values at zero specificity (every rule that won
     over them still wins). Its state colours stay utility classes, which
     product-controller.ts swaps. */
  :where(.variant-option-btn) {
    display: flex;
    height: calc(var(--spacing) * 11);
    min-width: calc(var(--spacing) * 11);
    align-items: center;
    justify-content: center;
    border-radius: calc(var(--radius) - 2px);
    border-style: var(--tw-border-style);
    border-width: 1px;
    padding-inline: calc(var(--spacing) * 3);
    font-size: var(--text-sm);
    line-height: var(--tw-leading, var(--text-sm--line-height));
    --tw-font-weight: var(--font-weight-medium);
    font-weight: var(--font-weight-medium);
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, --tw-gradient-from, --tw-gradient-via, --tw-gradient-to;
    transition-timing-function: var(--tw-ease, var(--default-transition-timing-function));
    transition-duration: var(--tw-duration, var(--default-transition-duration));
  }

  @media (hover: hover) {
    :where(.variant-option-btn):hover {
      border-color: var(--primary);
    }
  }

  :where(.variant-option-btn):focus-visible {
    outline-style: var(--tw-outline-style);
    outline-width: 2px;
    outline-offset: 2px;
    outline-color: var(--ring);
  }

  @media (min-width: 64rem) {
    :where(.variant-option-btn) {
      height: calc(var(--spacing) * 10);
    }
  }
</style>

<style is:global>
  /* Global, written as Astro scoped it: each `:not(.\#)` (always true) carries
     the weight of the scope attribute it replaces, so the cascade is unchanged
     and no element carries data-astro-cid-* (it repeated on every element). */
  /* The buy box has two arrangements. Settings choose how the buttons sit
     (side by side, or stacked and full width). The marketplace box adds a
     purchase column from 80rem; below that it reads as the classic box. */
  .buy-box-price-fact:not(.\#),
  .buy-box-regular-fact:not(.\#) {
    display: contents;
  }
  .buy-box-purchase:not(.\#) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  /* The status takes room only while it shows a problem (its screen reader line takes none). */
  [data-buy-part="status"][data-state="idle"]:not(.\#) {
    display: contents;
  }
  .buy-box-ctas:not(.\#) > button:not(.\#) {
    font-size: var(--theme-text-sm, 0.875rem);
  }
  [data-cta-layout="stack"]:not(.\#) .buy-box-ctas:not(.\#) {
    flex-direction: column;
  }
  .variant-option-panels:not(.\#) > *:not(.\#) + *:not(.\#) {
    margin-top: 0.75rem;
  }
  [data-product-summary][data-facts-column] .purchase-price:not(.\#) {
    display: none;
  }
  [data-option-price]:not([hidden]):not(.\#) {
    font-size: 0.75rem;
    font-weight: 700;
  }
  /* Keep the variant selectors in the detail column while the existing form,
     quantity buttons, purchase buttons and delivery facts share one card. */
  @media (min-width: 80rem) {
    [data-product-summary][data-facts-column] #product-actions:not(.\#) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 17.5rem;
      gap: 1.5rem;
      align-items: start;
    }
    [data-product-summary][data-facts-column] .buy-box-purchase:not(.\#) {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem;
    }
    [data-product-summary][data-facts-column] .purchase-price:not(.\#) {
      display: block;
      color: var(--foreground);
      font-size: var(--theme-text-2xl, 1.5rem);
      font-weight: 700;
    }
    [data-product-summary][data-facts-column] .variant-option-btn:not(.\#) {
      flex-direction: column;
      align-items: flex-start;
      height: auto;
      min-height: 2.75rem;
      text-align: start;
    }
    [data-product-summary][data-facts-column] .buy-box-ctas:not(.\#) {
      flex-direction: column;
    }
    [data-product-summary][data-facts-column] .buy-box-ctas:not(.\#) > [data-action="add-to-cart"]:not(.\#) {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--accent-foreground);
    }
    [data-product-summary][data-facts-column] .buy-box-ctas:not(.\#) > button:disabled:not(.\#) {
      border-color: var(--border);
      background: var(--muted);
      color: var(--muted-foreground);
    }
  }
</style>
