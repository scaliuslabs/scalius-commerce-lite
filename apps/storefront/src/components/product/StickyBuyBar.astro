---
// The buy bar (theme `product.sticky`): while the buy buttons are out of
// view (on a phone, below the fold too), a bar keeps the price and "Add to
// cart" in reach. On phones it is
// pinned to the bottom (`phoneBottom: buy-bar`, thumb reach); on computers
// it is Target's product bar pinned under the header (`desktop:
// product-bar`). It drives the real buttons, so options, stock and cart
// rules stay in one place. One bar serves both screens.
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";

interface Props {
  productName: string;
  /** The buy button's words and state as the page renders them (the store's language), kept current by the script. */
  action: { label: string; disabled: boolean };
  /** The price as the page shows it. */
  price: string;
  /** Pinned to the bottom on phones and tablets (below 64rem). */
  phone?: boolean;
  /** Pinned under the header on computers (from 64rem). */
  desktop?: boolean;
}

const { productName, action, price, phone = true, desktop = false } = Astro.props;
const screens = phone && desktop ? "all" : desktop ? "desktop" : "phone";
// Before the buyer has reached a product's options, the bar takes them there instead of adding a choice they have not seen.
const { language } = await currentRequestTheme(Astro.locals);
const chooseLabel = storefrontCopy(language).card.chooseOptions;
---

{(phone || desktop) && (
  <div
    data-product-topbar="desktop"
    data-sticky-buy
    data-sticky-buy-screens={screens}
    class:list={[
      "invisible fixed inset-x-0 z-[var(--scalius-z-content-bar,40)] translate-y-full bg-background/95 px-4 backdrop-blur transition-transform duration-200 motion-reduce:transition-none",
      phone
        ? "bottom-0 border-t border-border pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] shadow-[0_-8px_24px_-16px_rgb(0_0_0/0.4)]"
        : "max-lg:hidden",
      desktop
        ? "lg:top-[var(--header-height,0px)] lg:bottom-auto lg:translate-y-0 lg:border-t-0 lg:border-b lg:border-border lg:py-2 lg:shadow-[0_8px_24px_-16px_rgb(0_0_0/0.4)]"
        : "lg:hidden",
    ]}
    inert
  >
    <div class="mx-auto flex max-w-7xl items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class:list={["truncate text-sm text-muted-foreground", desktop && "lg:text-base lg:font-semibold lg:text-foreground"]}>{productName}</p>
        <p class="flex min-w-0 items-baseline gap-2">
          <span data-sticky-buy-price class="shrink-0 text-base font-semibold text-foreground">{price}</span>
          {/* The choice the bar would add ("Red / S"), named while it adds. */}
          <span data-sticky-buy-variant class="truncate text-sm text-muted-foreground" hidden></span>
        </p>
      </div>
      <button
        type="button"
        data-sticky-buy-action
        data-choose-label={chooseLabel}
        class="flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground hover:bg-primary/90 disabled:bg-muted disabled:text-muted-foreground"
        disabled={action.disabled}
      >
        {action.label}
      </button>
    </div>
  </div>
)}

<style is:global>
  /*
   * While a phone bar is on the page, the page ends above it and focus
   * scrolls clear of it, shown or not (a reserve that arrived with the bar
   * grew the page under a buyer already at its end). The script writes the
   * bar's measured height to --sticky-buy-reserve; the fallback is its
   * drawn height: 1px border, 0.5rem top padding, a 2.75rem row, and
   * max(0.5rem, safe-area inset) bottom padding. The phone tab bar, when the
   * store draws one, takes the bar's place while it hides: the larger wins.
   */
  @media (max-width: 63.999rem) {
    html[data-sticky-buy-reserve] {
      --sticky-buy-bar: var(--sticky-buy-reserve, calc(1px + 3.25rem + max(0.5rem, env(safe-area-inset-bottom, 0px))));
      --sticky-buy-room: var(--sticky-buy-bar);
      scroll-padding-bottom: calc(var(--sticky-buy-room) + 0.5rem);
    }
    html[data-sticky-buy-reserve][data-mobile-nav="tabs"]:has(#mobile-tab-bar) {
      --sticky-buy-room: max(var(--sticky-buy-bar), var(--mobile-tabs-reserve));
    }
    html[data-sticky-buy-reserve] body {
      padding-bottom: var(--sticky-buy-room);
    }
  }
</style>

<script>
  import { bindStickyBuyBar } from "./scripts/sticky-buy-bar";

  const bind = () => {
    const bar = document.querySelector<HTMLElement>("[data-sticky-buy]");
    if (bar) bindStickyBuyBar(bar, document);
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
