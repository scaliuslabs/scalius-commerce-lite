---
import Icon from "@/components/icons/Icon.astro";
import RichContent from "@/components/RichContent.astro";
import type { Product } from "@/lib/api";

interface Props {
  product: Product;
  /** False when the buy box or "About this item" already lists the key features. */
  features?: boolean;
}

// The warranty has one home: the buy box's warranty row (WarrantyRow.astro).
const { product, features: showFeatures = true } = Astro.props;
const features = showFeatures ? (product.features ?? []) : [];

const tabs = [];

if (product.description || features.length > 0) {
  tabs.push({ id: "description", label: "Description" });
}

if (product.additionalInfo && product.additionalInfo.length > 0) {
  product.additionalInfo.forEach((section) => {
    tabs.push({ id: section.id, label: section.title });
  });
}

const hasManyTabs = tabs.length > 4;
// One panel needs no tab bar: its heading says what it is.
const tabbed = tabs.length > 1;
---

{
  tabs.length > 0 && (
    <div
      id="product-details"
      class="mt-1.5 border-t border-border pt-1.5 lg:mt-2 lg:pt-2"
    >
      <div class="product-details-tabs" data-product-details-tabs>
        {!tabbed && <h2 id="details-tab-description" class="mb-2 mt-2 text-base font-semibold text-foreground">{tabs[0]!.label}</h2>}
        {tabbed && <div
          class="product-details-tab-rail relative sticky z-40 border-b border-border bg-background"
        >
          {hasManyTabs && (
            <button
              type="button"
              id="scroll-left"
              class="absolute inset-s-0 top-0 bottom-0 z-10 w-10 bg-linear-to-r from-background via-background to-transparent flex items-center justify-center opacity-0 transition-opacity duration-200 hover:opacity-100"
              aria-label="Scroll left"
            >
              <Icon name="chevron-left" class="h-5 w-5 text-muted-foreground" />
            </button>
          )}

          <nav
            id="tab-nav"
            class="-mb-px flex space-x-3 overflow-x-auto overscroll-x-contain px-1.5 sm:space-x-4 md:space-x-6 md:px-0"
            role="tablist"
            aria-label="Product information"
            style="scrollbar-width: none; -ms-overflow-style: none;"
          >
            {tabs.map((tab, index) => (
              <button
                type="button"
                id={`details-tab-${tab.id}`}
                role="tab"
                data-tab-id={tab.id}
                data-tab-anchor={`details-panel-${tab.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`details-panel-${tab.id}`}
                tabindex={index === 0 ? 0 : -1}
                class:list={[
                  "flex min-h-11 shrink-0 items-center whitespace-nowrap border-b-2 px-1.5 py-2.5 text-sm font-medium transition-colors duration-150 md:px-1 md:py-3",
                  index === 0
                    ? "border-primary text-primary"
                    : "border-transparent text-muted-foreground hover:text-foreground hover:border-muted-foreground",
                ]}
              >
                {tab.label}
              </button>
            ))}
          </nav>

          {hasManyTabs && (
            <button
              type="button"
              id="scroll-right"
              class="absolute inset-e-0 top-0 bottom-0 z-10 w-10 bg-linear-to-l from-background via-background to-transparent flex items-center justify-center opacity-0 transition-opacity duration-200 hover:opacity-100"
              aria-label="Scroll right"
            >
              <Icon name="chevron-right" class="h-5 w-5 text-muted-foreground" />
            </button>
          )}

          {hasManyTabs && (
            <>
              <div
                id="fade-left"
                class="pointer-events-none absolute inset-s-0 top-0 bottom-0 w-12 bg-linear-to-r from-background to-transparent opacity-0 transition-opacity duration-200"
              />
              <div
                id="fade-right"
                class="pointer-events-none absolute inset-e-0 top-0 bottom-0 w-12 bg-linear-to-l from-background to-transparent opacity-0 transition-opacity duration-200"
              />
            </>
          )}
        </div>}

        <div class="mt-3 lg:mt-4">
          {(product.description || features.length > 0) && (
            <div
              id="details-panel-description"
              role={tabbed ? "tabpanel" : undefined}
              aria-labelledby={tabbed ? "details-tab-description" : undefined}
              data-tab-panel="description"
              class="tab-panel"
            >
              {features.length > 0 && (
                <div class="mb-6">
                  <p class="mb-3 text-sm font-semibold text-foreground">
                    Key features
                  </p>
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2">
                    {features.map((feature) => (
                      <li class="flex items-start">
                        <Icon name="check" class="h-4 w-4 text-primary me-2 shrink-0 mt-0.5" />
                        <span class="text-sm text-foreground">{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {product.description && (
                <div class="prose prose-sm max-w-none text-foreground">
                  <RichContent content={product.description} />
                </div>
              )}
            </div>
          )}

          {product.additionalInfo && product.additionalInfo.length > 0 && (
            <>
              {product.additionalInfo.map((section) => (
                <div
                  id={`details-panel-${section.id}`}
                  role="tabpanel"
                  aria-labelledby={`details-tab-${section.id}`}
                  data-tab-panel={section.id}
                  class="tab-panel hidden"
                >
                  <div class="prose prose-sm max-w-none text-foreground">
                    <RichContent content={section.content} />
                  </div>
                </div>
              ))}
            </>
          )}
        </div>
      </div>
    </div>
  )
}

<script src="./scripts/product-tabs.ts"></script>

<style>
  /* Tab panel animation - GPU accelerated */
  .tab-panel {
    animation: fadeIn 0.2s ease-in-out;
    scroll-margin-top: calc(var(--header-height, 3.5rem) + 3.25rem);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Ensure tab navigation has proper overflow */
  #tab-nav {
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }

  .product-details-tab-rail {
    top: calc(var(--header-height, 3.5rem) - 1px);
  }

  #tab-nav::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  /* Optimize button transitions */
  [role="tab"] {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  /* Prevent layout shift for scroll buttons */
  #scroll-left,
  #scroll-right,
  #fade-left,
  #fade-right {
    pointer-events: none;
  }

  #scroll-left:not([style*="opacity: 0"]),
  #scroll-right:not([style*="opacity: 0"]) {
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-panel {
      animation: none;
    }

    #tab-nav,
    [role="tab"] {
      scroll-behavior: auto;
      transition-duration: 0.01ms;
    }
  }
</style>
