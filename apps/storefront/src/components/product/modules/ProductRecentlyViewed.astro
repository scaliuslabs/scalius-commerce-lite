---
// "Recently viewed" under a product (Apple Gadgets, Aarong): this browser's
// own list (lib/recently-viewed.ts), without the product on screen. The
// cached page carries only an empty, hidden module; the inline script after
// it fills the row from localStorage as the parser reaches it, so nothing
// shifts. Without JavaScript, on a first visit or with storage blocked, it
// stays hidden. The page makes no server read; when the browser is idle one
// public read of product ids drops products that are no longer public
// (lib/recently-viewed-client.ts).
import { recentlyViewedRenderScript } from "@/lib/recently-viewed";

interface Props {
  title: string;
  /** The product on screen, left out of the row. */
  slug: string;
}

const { title, slug } = Astro.props;
const rootId = "recently-viewed";
const headingId = `${rootId}-heading`;
---

<section
  id={rootId}
  class="product-module mx-auto max-w-7xl border-t border-border px-3 py-6 sm:px-6 lg:px-8 lg:py-10"
  data-product-module={rootId}
  data-recently-viewed
  aria-labelledby={headingId}
  hidden
>
  <h2 id={headingId} class="mb-4 text-xl font-bold leading-tight text-foreground lg:text-2xl">{title}</h2>
  <ul data-h-rail class="-mx-1 flex snap-x snap-mandatory gap-3 overflow-x-auto px-1 py-1 [scrollbar-width:none] md:gap-4 [&::-webkit-scrollbar]:hidden" data-recently-viewed-list></ul>
</section>
<script is:inline set:html={recentlyViewedRenderScript(rootId, slug)} />

<script>
  import { scheduleRecentlyViewedCheck } from "@/lib/recently-viewed-client";

  // After the row has painted, drop products that are no longer public.
  scheduleRecentlyViewedCheck();
  document.addEventListener("astro:page-load", scheduleRecentlyViewedCheck);
</script>
