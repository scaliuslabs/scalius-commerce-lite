---
// "Frequently bought together" (Amazon's bundle strip): this item and the
// products customers bought with it (product-page-modules
// `frequentlyBoughtTogether`, real co-purchases only), their photos joined
// by "+", each with its price, and the total when every price is fixed.
// Each other item links to its own page, where its options are chosen.
import type { Product } from "@/lib/api";
import { formatMoney } from "@/lib/currency";
import { getProductImageSrcSet, getProductImageUrl, hasProductImage } from "@/lib/product-media";
import { isUnrenderedMediaOriginal } from "@scalius/shared/media-variants";
import ProductModule from "./ProductModule.astro";

interface Props {
  title: string;
  /** This product as the page shows it: its photo, name and displayed price. */
  current: { name: string; imageUrl: string | null; price: number; startingAt: boolean };
  products: Product[];
  currencySymbol: string;
  currencyCode: string;
}

const { title, current, products, currencySymbol, currencyCode } = Astro.props;
const money = (amount: number) => formatMoney(amount, { symbol: currencySymbol, code: currencyCode });
const photo = (url: string | null | undefined) =>
  hasProductImage(url) && !isUnrenderedMediaOriginal(url!) ? { src: getProductImageUrl(url, 240), srcset: getProductImageSrcSet(url) } : null;
const items = [
  { key: "current", name: current.name, href: null, image: photo(current.imageUrl), price: current.price, varies: current.startingAt },
  ...products.map((product) => ({
    key: product.id,
    name: product.name,
    href: `/products/${encodeURIComponent(product.slug)}`,
    image: photo(product.imageUrl),
    price: product.discountedPrice,
    varies: product.priceVaries === true,
  })),
];
const total = items.every((item) => !item.varies && item.price > 0)
  ? items.reduce((sum, item) => sum + item.price, 0)
  : null;
---

<ProductModule id="bought-together" title={title}>
  <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:gap-10">
    <ol class="flex items-center gap-2 sm:gap-3" aria-label={title}>
      {items.map((item, index) => (
        <Fragment>
          {index > 0 && <li aria-hidden="true" class="text-xl font-semibold text-muted-foreground">+</li>}
          <li class="w-24 shrink-0 sm:w-32">
            {item.href ? (
              <a href={item.href} class="block aspect-square overflow-hidden rounded-[var(--radius)] border border-border bg-card" aria-label={item.name}>
                {item.image && <img src={item.image.src} srcset={item.image.srcset} sizes="128px" alt="" width="128" height="128" loading="lazy" decoding="async" class="h-full w-full object-contain" />}
              </a>
            ) : (
              <span class="block aspect-square overflow-hidden rounded-[var(--radius)] border border-border bg-card">
                {item.image && <img src={item.image.src} srcset={item.image.srcset} sizes="128px" alt="" width="128" height="128" loading="lazy" decoding="async" class="h-full w-full object-contain" />}
              </span>
            )}
          </li>
        </Fragment>
      ))}
    </ol>
    <div class="min-w-0 flex-1">
      <ul class="space-y-2 text-sm text-foreground">
        {items.map((item) => (
          <li class="flex flex-wrap items-baseline gap-x-2">
            {item.href ? (
              <a href={item.href} class="min-w-0 font-medium hover:underline [overflow-wrap:anywhere]">{item.name}</a>
            ) : (
              <span class="min-w-0 [overflow-wrap:anywhere]"><span class="font-semibold">This item:</span> {item.name}</span>
            )}
            <span class="font-semibold tabular-nums">{item.varies ? "From " : ""}{money(item.price)}</span>
          </li>
        ))}
      </ul>
      {total !== null && (
        <p class="mt-3 text-base text-foreground" data-bought-together-total>
          Total for all {items.length}: <span class="font-bold tabular-nums">{money(total)}</span>
        </p>
      )}
    </div>
  </div>
</ProductModule>
