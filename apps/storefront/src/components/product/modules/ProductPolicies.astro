---
// The store's policies on the product page (Dawn's collapsible rows, Apple
// Gadgets' policy links): the published pages from Settings -> Policies,
// already in the layout data, linked in their order. Without any published
// policy page the module is left out.
import ProductModule from "./ProductModule.astro";

interface Props {
  title: string;
  policies: ReadonlyArray<{ title: string; path: string }>;
}

const { title, policies } = Astro.props;
---

<ProductModule id="policies" title={title}>
  {/* One list, not a grid: four links never leave an orphan row. */}
  <ul class="max-w-xl divide-y divide-border overflow-hidden rounded-[var(--radius)] border border-border bg-card">
    {policies.map((policy) => (
      <li>
        <a
          href={policy.path}
          class="flex min-h-11 items-center justify-between gap-3 px-4 py-2 text-sm font-medium text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring"
        >
          <span class="[overflow-wrap:anywhere]">{policy.title}</span>
          <span aria-hidden="true" class="text-muted-foreground">›</span>
        </a>
      </li>
    ))}
  </ul>
</ProductModule>
