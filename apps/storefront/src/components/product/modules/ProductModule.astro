---
// One module below the product fold (Theme -> Product page -> modules): the
// page's container, a rule above and a heading, like the reviews module.
import Container from "@/components/ui/Container.astro";
interface Props {
  /** The module id (`resolved.blocks.product.below`), also the anchor. */
  id: string;
  title?: string | null;
}

const { id, title = null } = Astro.props;
const headingId = `${id}-heading`;
---

<Container>
<section
  id={id}
  class="product-module border-t border-border py-6 lg:py-10"
  data-product-module={id}
  aria-labelledby={title ? headingId : undefined}
>
  {title && <h2 id={headingId} class="mb-4 text-xl font-bold leading-tight text-foreground lg:text-2xl">{title}</h2>}
  <slot />
</section>
</Container>

<style>
  /* The description's tabs bring their own rule; the module's is enough. */
  [data-product-module="description"] :global(#product-details) {
    margin-top: 0;
    border-top: 0;
    padding-top: 0;
  }
</style>
