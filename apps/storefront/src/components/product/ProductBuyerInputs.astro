---
// Buyer inputs (engraving, gift wrap, a fit choice) above quantity and the
// buy buttons. It is a real form: before the product script loads, or with
// JavaScript off, "Buy now" posts it to `/buy/<slug>` in the body (never the
// URL). The product controller takes over the same form once it runs.
import type { ProductCustomizationField } from "@/lib/api";
import { serializeJsonForInlineScript } from "@/lib/safe-json";
import {
  BUYER_INPUT_FIELD_PREFIX,
  counterText,
  surchargeText,
  type BuyerInputCopy,
} from "./lib/buyer-inputs";

interface Props {
  formId: string;
  slug: string;
  fields: ProductCustomizationField[];
  copy: BuyerInputCopy;
  /** The SKU the page opens on; empty when the buyer must still choose one. */
  variantId: string | null;
  currencyPlaces: number;
  formatMoney: (amount: number) => string;
}

const { formId, slug, fields, copy, variantId, currencyPlaces, formatMoney } = Astro.props;

const schemaJson = serializeJsonForInlineScript(fields);
const copyJson = serializeJsonForInlineScript(copy);
const controlClass =
  "block w-full rounded-lg border border-input bg-background px-3 text-base text-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/30 aria-[invalid=true]:border-destructive";
const pillClass = "whitespace-nowrap rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary";
const id = (key: string, part: string) => `product-input-${key}${part ? `-${part}` : ""}`;
const describedBy = (field: ProductCustomizationField) =>
  [
    field.help ? id(field.key, "help") : null,
    (field.type === "text" || field.type === "textarea") && field.maxLength ? id(field.key, "counter") : null,
    id(field.key, "error"),
  ].filter(Boolean).join(" ");
---

<form
  id={formId}
  method="post"
  action={`/buy/${encodeURIComponent(slug)}`}
  class="space-y-3"
  data-buyer-inputs
>
  <input type="hidden" name="variant" value={variantId ?? ""} data-buyer-inputs-variant />
  <script is:inline type="application/json" id="product-customization-data" set:html={schemaJson} />
  <script is:inline type="application/json" id="product-customization-copy" set:html={copyJson} />

  {fields.map((field) => {
    const name = `${BUYER_INPUT_FIELD_PREFIX}${field.key}`;
    const surcharge = surchargeText(copy, field.priceMinor, currencyPlaces, formatMoney);
    const optional = field.required ? null : copy.customizationOptionalText;

    if (field.type === "checkbox") {
      return (
        <div data-buyer-input={field.key} data-buyer-input-type="checkbox">
          <label
            for={id(field.key, "")}
            class="flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-input bg-background px-3 py-2 has-[:checked]:border-primary has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ring/30"
          >
            <input
              id={id(field.key, "")}
              type="checkbox"
              name={name}
              value="true"
              required={field.required}
              aria-describedby={describedBy(field)}
              class="size-5 shrink-0 accent-primary"
            />
            <span class="min-w-0 flex-1 text-sm font-medium text-foreground">{field.label}</span>
            {surcharge && <span class={pillClass}>{surcharge}</span>}
          </label>
          {field.help && <p id={id(field.key, "help")} class="mt-1 text-sm text-muted-foreground">{field.help}</p>}
          <p id={id(field.key, "error")} class="mt-1 hidden text-sm font-medium text-destructive" data-buyer-input-error role="alert"></p>
        </div>
      );
    }

    return (
      <div data-buyer-input={field.key} data-buyer-input-type={field.type}>
        <div class="mb-1 flex items-center justify-between gap-2">
          <label for={id(field.key, "")} class="text-sm font-medium text-foreground">
            {field.label}
            {optional && <span class="font-normal text-muted-foreground"> ({optional})</span>}
          </label>
          {surcharge && <span class={pillClass}>{surcharge}</span>}
        </div>
        {field.type === "select" ? (
          <select
            id={id(field.key, "")}
            name={name}
            required={field.required}
            aria-describedby={describedBy(field)}
            class={`${controlClass} h-11`}
          >
            <option value="">{copy.customizationChoosePlaceholderText}</option>
            {field.options.map((option) => {
              const optionSurcharge = surchargeText(copy, option.priceMinor, currencyPlaces, formatMoney);
              return (
                <option value={option.value}>
                  {optionSurcharge ? `${option.label} ${optionSurcharge}` : option.label}
                </option>
              );
            })}
          </select>
        ) : field.type === "textarea" ? (
          <textarea
            id={id(field.key, "")}
            name={name}
            rows="3"
            maxlength={field.maxLength ?? undefined}
            required={field.required}
            autocomplete="off"
            aria-describedby={describedBy(field)}
            data-buyer-input-max={field.maxLength ?? undefined}
            class={`${controlClass} min-h-24 py-2`}
          ></textarea>
        ) : (
          <input
            id={id(field.key, "")}
            type="text"
            name={name}
            maxlength={field.maxLength ?? undefined}
            required={field.required}
            autocomplete="off"
            aria-describedby={describedBy(field)}
            data-buyer-input-max={field.maxLength ?? undefined}
            class={`${controlClass} h-11`}
          />
        )}
        <div class="mt-1 flex items-start justify-between gap-3">
          <div class="min-w-0">
            {field.help && <p id={id(field.key, "help")} class="text-sm text-muted-foreground">{field.help}</p>}
            <p id={id(field.key, "error")} class="hidden text-sm font-medium text-destructive" data-buyer-input-error role="alert"></p>
          </div>
          {(field.type === "text" || field.type === "textarea") && field.maxLength ? (
            <span id={id(field.key, "counter")} class="shrink-0 text-xs tabular-nums text-muted-foreground" data-buyer-input-counter>
              {counterText(copy, "", field.maxLength)}
            </span>
          ) : null}
        </div>
      </div>
    );
  })}
</form>
