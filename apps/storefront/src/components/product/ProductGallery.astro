---
import type { Product, ProductMedia } from "@/lib/api";
import { GALLERY_CONFIG } from "./config";
import Icon from "@/components/icons/Icon.astro";
import { productImageSources, resolveProductImageUrl } from "@/lib/product-media";
import { responsiveImageSources } from "@/lib/responsive-image";
import {
  GALLERY_IMAGE_WIDTHS,
  boundedStageRatio,
  productGalleryMainSlot,
  productGalleryThumbnailSlot,
  GALLERY_EAGER_THUMBNAILS,
  type ProductGalleryLayout,
} from "./lib/gallery-images";
import { featuredGalleryItem, productGalleryItems } from "./lib/gallery-media";
import { mediaImageUrl } from "@scalius/shared/media-variants";
import VideoFacade from "./VideoFacade.astro";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { catalogCopy } from "@/lib/catalog-copy";
import { formatPageNumber } from "@/lib/store-time-zone";

interface Props {
  product: Product;
  media: ProductMedia[];
  /** Theme -> Layout -> Product page: gallery placement and thumbnails. */
  layout?: ProductGalleryLayout;
  /** "Play video: {title}" in the store's language. */
  playVideoLabel?: string;
  /** The words of the computer zoom button, and of the stacked list's "show all" control. */
  zoomLabel?: string;
  /** One photo's zoom button in the stacked and grid lists ("Zoom photo 2 of 4"). */
  zoomOfLabel?: (position: number | string, total: number | string) => string;
  showAllLabel?: (count: number) => string;
  /** The computer's previous and next photo buttons. */
  stepLabels?: { previous: string; next: string };
  /** The phone gallery's position, read out as it changes ("Photo 2 of 5"). */
  positionLabel?: (position: number | string, total: number | string) => string;
}

const {
  product,
  media,
  layout = { gallery: "beside", thumbnails: "beside", stageRatio: 1, thumbnailSize: null },
  playVideoLabel = "Play video: {title}",
  zoomLabel = "Zoom photo",
  zoomOfLabel = (position: number | string, total: number | string) => `Zoom photo ${position} of ${total}`,
  showAllLabel = (count: number) => `Show all photos (${count})`,
  stepLabels = { previous: "Previous photo", next: "Next photo" },
  positionLabel = (position: number | string, total: number | string) => `Photo ${position} of ${total}`,
} = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const words = catalogCopy(language).product;
// Positions in the page's digits (Bangla digits on a Bangla page).
const count = (value: number) => formatPageNumber(value, language);
const thumbnails = layout.thumbnails;
const desktopThumb = GALLERY_CONFIG.thumbnails.desktop;
const mobileThumb = GALLERY_CONFIG.thumbnails.mobile;

const galleryMedia = productGalleryItems(product, media);
// One page per product: a `?variant=` link's SKU photo is selected in the
// browser (product-controller.ts), the page's cached first paint is the primary.
const featuredMedia = featuredGalleryItem(galleryMedia, null);
const hasMultipleMedia = galleryMedia.length > 1;
const mainSlot = productGalleryMainSlot(layout, hasMultipleMedia);
// Both rails share one slot, so the hidden rail's thumbnail names the
// visible one's file (an eager thumbnail downloads once).
const thumbnailSlot = productGalleryThumbnailSlot(layout);
// Client switches rebuild src/srcset/sizes from these URLs with the same
// helper (responsiveImageSources) and the same slot.
const productFallbackUrl = resolveProductImageUrl(product.imageUrl);

const galleryItems = galleryMedia.map((item) => {
  const thumbSource = item.kind === "video" ? item.posterUrl : item.url;
  return {
    item,
    altText: item.altText,
    duration: item.duration,
    /** Image: the CDN URL the slots derive from. Video: the video file. */
    url: item.url,
    /** Video: the poster's CDN URL; the main slot sizes it like a photo. */
    posterUrl: item.posterUrl,
    thumbs: thumbSource ? productImageSources(thumbSource, thumbnailSlot) : null,
  };
});
const galleryImages = galleryItems.filter(({ item }) => item.kind === "image");
// Phones swipe between the photos of every gallery (the strip stays for
// direct picks), with the position shown on the photo and read out.
const mobileSwipe = galleryImages.length > 1;

const initialMedia =
  galleryItems.find(({ item }) => item.id === featuredMedia?.id) ?? null;
const videoFirst = initialMedia?.item.kind === "video";
const initialImage =
  initialMedia?.item.kind === "image"
    ? initialMedia
    : (galleryItems.find(({ item }) => item.kind === "image") ?? null);
const initialImageUrl = initialImage?.url ?? productFallbackUrl;
const initialImageSources = responsiveImageSources(initialImageUrl, mainSlot);
const initialImageAlt =
  initialImage?.altText ?? product.imageAlt?.trim() ?? product.name;
const initialImageIndex = galleryImages.findIndex(({ item }) => item.id === featuredMedia?.id);
// The video stage holds one facade: the featured video, else the first one
// (a thumbnail swaps its file and poster in). No video, no stage.
const stageVideo = videoFirst
  ? initialMedia
  : (galleryItems.find(({ item }) => item.kind === "video") ?? null);
const posterSources = (posterUrl: string | null) =>
  posterUrl ? responsiveImageSources(posterUrl, mainSlot) : null;
// When the video comes first its poster is the first paint: the photo
// stages stay hidden, so their photo must not download at high priority.
const mainImageLoading = videoFirst ? "lazy" : "eager";
const mainImagePriority = videoFirst ? "low" : "high";
// The stage's ratio (the page adapts it to the first photo, or the variant
// states it) set inline; a square stage keeps the classes alone.
const ratioStyle = (ratio: number) => (ratio === 1 ? undefined : `aspect-ratio: ${ratio};`);
const stageStyle = ratioStyle(layout.stageRatio);
const railStyle = layout.thumbnailSize === null ? "" : ` --gallery-thumb: ${layout.thumbnailSize}px;`;
// Stacked (Dawn) and grid (Target): every photo in the wide column on
// computers, the featured one first; phones keep the stage and the strip.
const listMedia =
  layout.gallery === "beside"
    ? []
    : initialMedia
      ? [initialMedia, ...galleryItems.filter((entry) => entry !== initialMedia)]
      : [];
const listImages = listMedia.filter((entry) => entry.item.kind === "image");
const playLabel = (title: string) => playVideoLabel.replace("{title}", title);
// A long list shows its first photos; the rest open with one control (no script).
const LIST_VISIBLE = 6;
const listHidden = Math.max(0, listMedia.length - LIST_VISIBLE);
---

<div
  id="product-gallery"
  data-product-gallery
  data-initial-product-media-id={featuredMedia?.id ?? undefined}
  data-main-sizes={mainSlot.sizes}
  data-fallback-url={productFallbackUrl}
  data-fallback-media-id={product.imageMediaId ?? undefined}
  data-fallback-alt={product.imageAlt?.trim() || product.name}
  data-thumbnails={thumbnails}
  data-gallery={layout.gallery}
  data-phone-thumbnails={layout.phoneSideThumbnails ? "beside" : undefined}
  data-mobile-swipe={mobileSwipe ? "" : undefined}
  class="group/gallery relative w-full lg:col-span-7 xl:col-span-6"
>
  <div
    class:list={[
      "gallery-layout flex flex-col gap-2 lg:sticky lg:gap-5",
      !hasMultipleMedia
        ? "lg:block"
        : layout.thumbnailSize === null || thumbnails === "below"
          ? "lg:grid lg:grid-cols-[80px_1fr] xl:grid-cols-[100px_1fr]"
          : "lg:grid lg:grid-cols-[var(--gallery-thumb)_1fr] lg:gap-3",
    ]}
    style={`top: 5rem; --gallery-mobile-max-height: ${GALLERY_CONFIG.mainImage.maxHeightMobile};${railStyle}`}
  >
    <div
      class:list={[
        "relative z-10 min-w-0 flex-1",
        hasMultipleMedia && "lg:col-start-2 lg:row-start-1",
      ]}
    >
      <div class="gallery-stage-row flex items-stretch gap-2">
        <div class="group/main relative flex-1">
          <button
            type="button"
            data-image-stage="mobile"
            data-mobile-image-trigger
            class:list={[
              "mobile-media-stage relative aspect-square w-full cursor-zoom-in overflow-hidden rounded-lg bg-muted text-start transition-transform duration-200 active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground lg:hidden motion-reduce:transition-none",
              mobileSwipe && "touch-pan-y",
              videoFirst && "hidden",
            ]}
            style={stageStyle}
            aria-label={zoomLabel}
          >
            <img
              data-mobile-main-image
              src={initialImageSources.src}
              srcset={initialImageSources.srcset}
              sizes={initialImageSources.sizes}
              alt={initialImageAlt}
              width="600"
              height="600"
              class="h-full w-full object-contain object-center"
              loading={mainImageLoading}
              fetchpriority={mainImagePriority}
              decoding="sync"
            />
            <span
              class="pointer-events-none absolute inset-e-3 bottom-3 flex items-center gap-1 rounded-full bg-black/40 p-2 text-xs font-medium text-white opacity-0 backdrop-blur-md transition-opacity duration-300 group-hover/main:opacity-100 motion-reduce:transition-none"
            >
              <Icon name="maximize-2" class="h-3 w-3" />
              {words.zoom}
            </span>
          </button>

          <div
            data-image-stage="desktop"
            class:list={[
              "relative hidden aspect-square w-full cursor-zoom-in overflow-hidden rounded-xl bg-muted lg:block",
              videoFirst && "lg:!hidden",
            ]}
            style={stageStyle}
          >
            <div
              data-desktop-image-zoom
              class="group relative aspect-square w-full cursor-crosshair overflow-hidden rounded-xl border border-border bg-background"
              style={`contain: layout style;${stageStyle ? ` ${stageStyle}` : ""}`}
            >
              {/* Same src/srcset/sizes as the mobile image: the browser picks
                  one candidate and fetches it once for both. */}
              <img
                data-desktop-main-image
                src={initialImageSources.src}
                srcset={initialImageSources.srcset}
                sizes={initialImageSources.sizes}
                alt={initialImageAlt}
                width={GALLERY_IMAGE_WIDTHS.main}
                height={GALLERY_IMAGE_WIDTHS.main}
                class="h-full w-full object-contain object-center transition-opacity duration-150 motion-reduce:transition-none"
                loading={mainImageLoading}
                fetchpriority={mainImagePriority}
                decoding="async"
              />
              <div
                data-desktop-zoom-layer
                class="pointer-events-none absolute inset-0 bg-background bg-no-repeat opacity-0 transition-opacity duration-150 motion-reduce:transition-none"
                aria-hidden="true"
              >
              </div>
              {/* Previous and next photo, for a mouse or keyboard on the main photo. */}
              {hasMultipleMedia && (["previous", "next"] as const).map((step) => (
                <button
                  type="button"
                  data-gallery-step={step === "previous" ? "-1" : "1"}
                  class:list={[
                    "gallery-step absolute top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-background/90 text-foreground shadow-sm ring-1 ring-border backdrop-blur transition-opacity hover:bg-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground motion-reduce:transition-none",
                    step === "previous" ? "inset-s-3" : "inset-e-3",
                  ]}
                  aria-label={step === "previous" ? stepLabels.previous : stepLabels.next}
                >
                  <Icon name={step === "previous" ? "chevron-left" : "chevron-right"} class="h-5 w-5" aria-hidden="true" />
                </button>
              ))}
              {/* The keyboard (and touch) way in to the zoom view: hover alone reached nobody else. */}
              <button
                type="button"
                data-zoom-trigger
                class="gallery-zoom-trigger absolute inset-e-3 bottom-3 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-background/90 text-foreground shadow-sm ring-1 ring-border backdrop-blur transition-colors hover:bg-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground motion-reduce:transition-none"
                aria-label={zoomLabel}
              >
                <Icon name="maximize-2" class="h-4 w-4" aria-hidden="true" />
              </button>
            </div>
          </div>

          {stageVideo && (
            <div
              data-video-stage
              class:list={[
                "mobile-media-stage relative aspect-square w-full overflow-hidden rounded-lg bg-muted lg:rounded-xl",
                !videoFirst && "hidden",
              ]}
              style={stageStyle}
            >
              <VideoFacade
                src={stageVideo.url}
                title={stageVideo.altText}
                label={playLabel(stageVideo.altText)}
                labelTemplate={playVideoLabel}
                poster={posterSources(stageVideo.posterUrl)}
                eager={videoFirst}
                duration={stageVideo.duration}
                gallery
              />
            </div>
          )}
          {mobileSwipe && (
            <div data-gallery-position class:list={["pointer-events-none absolute inset-x-0 bottom-3 z-10 flex justify-center lg:hidden", initialImageIndex < 0 && "hidden"]} hidden={initialImageIndex < 0}>
              {galleryImages.length <= 9 ? (
                <div class="flex items-center gap-1.5 rounded-full bg-background/85 px-2 py-1 shadow-sm" aria-hidden="true">
                  {galleryImages.map(({ item }, index) => (
                    <span data-gallery-dot data-product-media-id={item.id} class:list={["h-1.5 w-1.5 rounded-full", index === initialImageIndex ? "bg-foreground" : "bg-muted-foreground/40"]} />
                  ))}
                </div>
              ) : (
                <span data-gallery-position-count class="rounded-full bg-background/85 px-2 py-1 text-xs font-medium text-foreground shadow-sm" aria-hidden="true">{count(initialImageIndex + 1)} / {count(galleryImages.length)}</span>
              )}
              <span data-gallery-position-label data-template={positionLabel("{position}", "{total}")} class="sr-only" role="status" aria-live="polite">{positionLabel(count(initialImageIndex + 1), count(galleryImages.length))}</span>
            </div>
          )}
        </div>

        {
          hasMultipleMedia && (
            <div class="gallery-mobile-rail relative w-[18vw] max-w-[80px] shrink-0 lg:hidden">
              <button
                type="button"
                data-scroll-control="mobile-up"
                class="pointer-events-none absolute -top-1 inset-s-0 inset-e-0 z-10 flex h-11 items-start justify-center opacity-0 transition-opacity duration-300 focus-visible:outline-2 focus-visible:outline-foreground motion-reduce:transition-none"
                aria-label="Scroll product media up"
                tabindex="-1"
              >
                <span class="rounded-full border border-border bg-background p-0.5 text-muted-foreground shadow-xs">
                  <Icon name="chevron-up" class="h-3 w-3" />
                </span>
              </button>

              <div
                data-thumbnail-rail="mobile"
                class="scrollbar-hide absolute inset-0 overflow-y-auto pb-2 snap-y snap-mandatory touch-pan-y"
                aria-label="Product media"
              >
                <div class="flex flex-col gap-2 pt-0.5">
                  {galleryItems.map((itemData, index) => (
                    <button
                      type="button"
                      class="thumbnail-btn group"
                      data-gallery-thumbnail
                      data-product-media-id={itemData.item.id}
                      data-media-id={itemData.item.mediaId}
                      data-media-kind={itemData.item.kind}
                      data-media-url={itemData.url}
                      data-poster-url={itemData.posterUrl ?? undefined}
                      data-video-duration={itemData.duration ?? undefined}
                      data-alt-text={itemData.altText}
                      aria-label={
                        itemData.item.kind === "video"
                          ? `Play video ${index + 1}: ${itemData.altText}`
                          : `View image ${index + 1}: ${itemData.altText}`
                      }
                      aria-current={
                        itemData.item.id === featuredMedia?.id
                          ? "true"
                          : "false"
                      }
                      tabindex={itemData.item.id === featuredMedia?.id ? 0 : -1}
                    >
                      {itemData.thumbs ? (
                        <img
                          src={itemData.thumbs.src}
                          srcset={itemData.thumbs.srcset}
                          sizes={itemData.thumbs.sizes}
                          alt=""
                          width={mobileThumb.imageSize}
                          height={mobileThumb.imageSize}
                          class="h-full w-full object-contain object-center"
                          loading={index < GALLERY_EAGER_THUMBNAILS ? "eager" : "lazy"}
                          decoding="async"
                          fetchpriority="low"
                        />
                      ) : (
                        <span
                          class="flex h-full w-full items-center justify-center bg-muted text-muted-foreground"
                          aria-hidden="true"
                        >
                          <Icon name="video" class="h-5 w-5" />
                        </span>
                      )}
                      {itemData.item.kind === "video" && (
                        <>
                          <span
                            class="absolute inset-0 flex items-center justify-center bg-black/12 text-white"
                            aria-hidden="true"
                          >
                            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-black/65 shadow-sm">
                              <Icon name="play" class="ms-0.5 h-4 w-4 fill-current" />
                            </span>
                          </span>
                          <span class="absolute bottom-1 inset-s-1 rounded bg-black/70 px-1 py-0.5 text-[9px] font-semibold leading-none text-white">
                            Video
                            {itemData.duration ? ` · ${itemData.duration}` : ""}
                          </span>
                        </>
                      )}
                      <span
                        data-thumb-ring
                        class:list={[
                          "thumb-ring",
                          itemData.item.id === featuredMedia?.id &&
                            "!border-foreground",
                        ]}
                        aria-hidden="true"
                      />
                    </button>
                  ))}
                </div>
              </div>

              <button
                type="button"
                data-scroll-control="mobile-down"
                class="pointer-events-none absolute bottom-0 inset-s-0 inset-e-0 z-10 flex h-11 items-end justify-center pb-1 opacity-0 transition-opacity duration-300 focus-visible:outline-2 focus-visible:outline-foreground motion-reduce:transition-none"
                aria-label="Scroll product media down"
                tabindex="-1"
              >
                <span class="rounded-full border border-border bg-background p-0.5 text-muted-foreground shadow-xs">
                  <Icon name="chevron-down" class="h-3 w-3" />
                </span>
              </button>
            </div>
          )
        }
      </div>
    </div>

    {
      hasMultipleMedia && (
        <div class="gallery-desktop-rail relative hidden h-full w-full lg:col-start-1 lg:row-start-1 lg:block">
          <button
            type="button"
            data-scroll-control="desktop-up"
            class="pointer-events-none absolute -top-1 inset-s-0 inset-e-0 z-10 flex h-11 items-start justify-center opacity-0 transition-opacity duration-300 focus-visible:outline-2 focus-visible:outline-foreground motion-reduce:transition-none"
            aria-label="Scroll product media up"
            tabindex="-1"
          >
            <span class="rounded-full border border-border bg-background p-0.5 text-muted-foreground shadow-xs">
              <Icon name="chevron-up" class="h-4 w-4" />
            </span>
          </button>

          <div
            data-thumbnail-rail="desktop"
            class="custom-scrollbar absolute inset-0 flex flex-col gap-3 overflow-y-auto scroll-smooth pe-1 pb-4 snap-y snap-mandatory motion-reduce:scroll-auto"
            aria-label="Product media"
          >
            {galleryItems.map((itemData, index) => (
              <button
                type="button"
                class="thumbnail-btn group"
                data-gallery-thumbnail
                data-product-media-id={itemData.item.id}
                data-media-id={itemData.item.mediaId}
                data-media-kind={itemData.item.kind}
                data-media-url={itemData.url}
                data-poster-url={itemData.posterUrl ?? undefined}
                data-video-duration={itemData.duration ?? undefined}
                data-alt-text={itemData.altText}
                aria-label={
                  itemData.item.kind === "video"
                    ? `Play video ${index + 1}: ${itemData.altText}`
                    : `View image ${index + 1}: ${itemData.altText}`
                }
                aria-current={
                  itemData.item.id === featuredMedia?.id ? "true" : "false"
                }
                tabindex={itemData.item.id === featuredMedia?.id ? 0 : -1}
              >
                {itemData.thumbs ? (
                  <img
                    src={itemData.thumbs.src}
                    srcset={itemData.thumbs.srcset}
                    sizes={itemData.thumbs.sizes}
                    alt=""
                    width={desktopThumb.imageSize}
                    height={desktopThumb.imageSize}
                    class="h-full w-full object-contain object-center transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                    loading={index < GALLERY_EAGER_THUMBNAILS ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority="low"
                  />
                ) : (
                  <span
                    class="flex h-full w-full items-center justify-center bg-muted text-muted-foreground"
                    aria-hidden="true"
                  >
                    <Icon name="video" class="h-5 w-5" />
                  </span>
                )}
                {itemData.item.kind === "video" && (
                  <>
                    <span
                      class="absolute inset-0 flex items-center justify-center bg-black/12 text-white"
                      aria-hidden="true"
                    >
                      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-black/65 shadow-sm">
                        <Icon name="play" class="ms-0.5 h-4 w-4 fill-current" />
                      </span>
                    </span>
                    <span class="absolute bottom-1 inset-s-1 rounded bg-black/70 px-1.5 py-0.5 text-[10px] font-semibold leading-none text-white">
                      Video{itemData.duration ? ` · ${itemData.duration}` : ""}
                    </span>
                  </>
                )}
                <span
                  data-thumb-ring
                  class:list={[
                    "thumb-ring",
                    itemData.item.id === featuredMedia?.id && "!border-foreground",
                  ]}
                  aria-hidden="true"
                />
              </button>
            ))}
          </div>

          <button
            type="button"
            data-scroll-control="desktop-down"
            class="pointer-events-none absolute bottom-0 inset-s-0 inset-e-0 z-10 flex h-11 items-end justify-center pb-1 opacity-0 transition-opacity duration-300 focus-visible:outline-2 focus-visible:outline-foreground motion-reduce:transition-none"
            aria-label="Scroll product media down"
            tabindex="-1"
          >
            <span class="rounded-full border border-border bg-background p-0.5 text-muted-foreground shadow-xs">
              <Icon name="chevron-down" class="h-4 w-4" />
            </span>
          </button>
        </div>
      )
    }
  </div>

  {listMedia.length > 0 && listHidden > 0 && (
    <input type="checkbox" id="gallery-show-all" class="gallery-show-all peer sr-only" aria-label={showAllLabel(listMedia.length)} />
  )}
  {listMedia.length > 0 && (
    <ul class="gallery-list hidden gap-2 lg:grid" aria-label="Product media">
      {/* Stacked: each photo in its own (bounded) ratio, as Dawn stacks them;
          the two-across grid keeps one ratio so its rows line up. */}
      {listMedia.map((entry, index) => {
        const sources = entry.item.kind === "image"
          ? responsiveImageSources(entry.url, mainSlot)
          : null;
        return (
          <li
            class:list={["relative aspect-square w-full overflow-hidden rounded-xl bg-muted", index >= LIST_VISIBLE && "gallery-extra"]}
            style={layout.gallery === "stacked" && entry.item.aspectRatio !== null ? ratioStyle(boundedStageRatio(entry.item.aspectRatio)) : stageStyle}
          >
            {sources ? (
              <img
                src={sources.src}
                srcset={sources.srcset}
                sizes={sources.sizes}
                alt={entry.altText}
                width={GALLERY_IMAGE_WIDTHS.main}
                height={GALLERY_IMAGE_WIDTHS.main}
                class="h-full w-full object-contain object-center"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : undefined}
                decoding="async"
              />
            ) : (
              <VideoFacade
                src={entry.url}
                title={entry.altText}
                label={playLabel(entry.altText)}
                poster={posterSources(entry.posterUrl)}
                eager={index === 0}
                duration={entry.duration}
              />
            )}
            {sources && (
              <button
                type="button"
                data-zoom-trigger
                data-zoom-url={mediaImageUrl(entry.url, GALLERY_IMAGE_WIDTHS.zoom) || entry.url}
                data-zoom-alt={entry.altText}
                class="gallery-zoom-trigger absolute inset-e-3 bottom-3 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-background/90 text-foreground shadow-sm ring-1 ring-border backdrop-blur transition-colors hover:bg-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground motion-reduce:transition-none"
                aria-label={zoomOfLabel(count(listImages.indexOf(entry) + 1), count(listImages.length))}
              >
                <Icon name="maximize-2" class="h-4 w-4" aria-hidden="true" />
              </button>
            )}
          </li>
        );
      })}
    </ul>
  )}
  {listMedia.length > 0 && listHidden > 0 && (
    <label for="gallery-show-all" class="gallery-show-all-label hidden min-h-11 cursor-pointer items-center justify-center rounded-lg border border-border bg-background px-4 text-sm font-semibold text-foreground lg:flex">
      {showAllLabel(listMedia.length)}
    </label>
  )}

  <div
    data-mobile-zoom-modal
    class="pointer-events-none fixed inset-0 z-100 flex touch-none flex-col bg-black/98 opacity-0 backdrop-blur-2xl transition-all duration-300 motion-reduce:transition-none"
    role="dialog"
    aria-modal="true"
    aria-label={words.imageZoom}
    aria-hidden="true"
    inert
  >
    <div class="absolute top-0 inset-e-0 inset-s-0 z-20 flex justify-end p-4">
      <button
        type="button"
        data-close-mobile-zoom
        class="rounded-full bg-white/10 p-2.5 text-white backdrop-blur-md transition-colors active:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white motion-reduce:transition-none"
        aria-label={words.closeZoom}
        tabindex="-1"
      >
        <Icon name="x" class="h-6 w-6" />
      </button>
    </div>
    <div
      data-panzoom-container
      class="relative flex h-full w-full flex-1 items-center justify-center overflow-hidden"
    >
      <img
        data-fullscreen-image
        alt={words.zoomedView(initialImageAlt)}
        data-zoomed-view={words.zoomedView("{name}")}
        data-zoomed-image={words.zoomedImage}
        width={GALLERY_IMAGE_WIDTHS.zoom}
        height={GALLERY_IMAGE_WIDTHS.zoom}
        loading="lazy"
        decoding="async"
        class="max-h-full max-w-full origin-center object-contain transition-transform duration-100 ease-out will-change-transform motion-reduce:transition-none"
      />
    </div>
    <div
      class="pointer-events-none absolute inset-e-0 bottom-8 inset-s-0 text-center text-xs text-white/50"
    >
      {words.zoomHint}
    </div>
  </div>
</div>

<style is:global>
  /* The thumbnail button and its selection ring, once here instead of the
     same utility strings on every thumbnail of both rails: Tailwind's values
     at zero specificity, so every rule that won over the utilities still
     wins. The ring's `!border-foreground` stays a class (the media
     controller toggles it). */
  :where(.thumbnail-btn) {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    min-height: calc(var(--spacing) * 11);
    flex-shrink: 0;
    overflow: hidden;
    border-radius: calc(var(--radius) + 1px);
    border-style: var(--tw-border-style);
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--background);
    scroll-snap-align: start;
    transition-property: all;
    transition-timing-function: var(--tw-ease, var(--default-transition-timing-function));
    --tw-duration: 0.2s;
    transition-duration: 0.2s;
  }

  :where(.thumbnail-btn):focus-visible {
    outline-style: var(--tw-outline-style);
    outline-width: 2px;
    outline-offset: 2px;
    outline-color: var(--foreground);
  }

  :where(.thumbnail-btn):active {
    --tw-scale-x: 95%;
    --tw-scale-y: 95%;
    --tw-scale-z: 95%;
    scale: var(--tw-scale-x) var(--tw-scale-y);
  }

  :where(.thumb-ring) {
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: calc(var(--radius) + 1px);
    border-style: var(--tw-border-style);
    border-width: 2px;
    border-color: #0000;
    transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, --tw-gradient-from, --tw-gradient-via, --tw-gradient-to;
    transition-timing-function: var(--tw-ease, var(--default-transition-timing-function));
    --tw-duration: 0.2s;
    transition-duration: 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    :where(.thumbnail-btn, .thumb-ring) {
      transition-property: none;
    }
  }
</style>

<style is:global>
  /* Global, written as Astro scoped it: each `:not(.\#)` (always true) carries
     the weight of the scope attribute it replaces, so the cascade is unchanged
     and no element carries data-astro-cid-* (it repeated on every element). */
  [data-gallery-position][hidden]:not(.\#) { display: none; }
  /* No `contain` on #product-gallery: layout/paint containment makes it the
     containing block and stacking context of the fixed zoom dialog below,
     which then opened inside the photo box under the header on phones. */
  .thumbnail-btn:not(.\#) {
    contain: layout style paint;
  }
  .thumbnail-btn:not(.\#) img:not(.\#) {
    contain: strict;
  }
  .custom-scrollbar:not(.\#)::-webkit-scrollbar {
    width: 3px;
  }
  .custom-scrollbar:not(.\#)::-webkit-scrollbar-track {
    background: transparent;
  }
  /* The thumbnail rail's scrollbar in the theme's own neutrals. */
  .custom-scrollbar:not(.\#)::-webkit-scrollbar-thumb {
    background-color: var(--border);
    border-radius: 20px;
  }
  .custom-scrollbar:hover:not(.\#)::-webkit-scrollbar-thumb {
    background-color: var(--muted-foreground);
  }
  .thumbnail-btn:not(.\#) .thumb-ring.\!border-foreground:not(.\#) {
    border-color: var(--foreground) !important;
  }

  /* Phones and tablets use a strip unless the merchant keeps the side rail. */
  @media (max-width: 1023px) {
    .gallery-stage-row:not(.\#) {
      flex-direction: column;
    }
    .gallery-mobile-rail:not(.\#) {
      width: 100%;
      max-width: none;
      height: 4.5rem;
    }
    [data-thumbnail-rail="mobile"]:not(.\#) {
      overflow-x: auto;
      overflow-y: hidden;
      touch-action: pan-x;
      scroll-snap-type: x mandatory;
    }
    [data-thumbnail-rail="mobile"]:not(.\#) > div:not(.\#) {
      flex-direction: row;
      height: 100%;
    }
    .gallery-mobile-rail:not(.\#) .thumbnail-btn:not(.\#) {
      width: 4.25rem;
      height: 4.25rem;
    }
    .gallery-mobile-rail:not(.\#) [data-scroll-control]:not(.\#) {
      display: none;
    }
    [data-phone-thumbnails="beside"]:not(.\#) .gallery-stage-row:not(.\#) {
      flex-direction: row;
    }
    [data-phone-thumbnails="beside"]:not(.\#) .gallery-mobile-rail:not(.\#) {
      order: -1;
      width: 48px;
      max-width: 48px;
      height: auto;
      align-self: stretch;
    }
    [data-phone-thumbnails="beside"]:not(.\#) [data-thumbnail-rail="mobile"]:not(.\#) {
      overflow-x: hidden;
      overflow-y: auto;
      touch-action: pan-y;
      scroll-snap-type: y mandatory;
    }
    [data-phone-thumbnails="beside"]:not(.\#) [data-thumbnail-rail="mobile"]:not(.\#) > div:not(.\#) {
      flex-direction: column;
      height: auto;
    }
    [data-phone-thumbnails="beside"]:not(.\#) .gallery-mobile-rail:not(.\#) .thumbnail-btn:not(.\#) {
      width: 48px;
      height: 48px;
    }
  }
  /* Computers, thumbnails below the photo: one horizontal strip. */
  [data-thumbnails="below"]:not(.\#) [data-thumbnail-rail="desktop"]:not(.\#) {
    overflow-x: auto;
    overflow-y: hidden;
    touch-action: pan-x;
    scroll-snap-type: x mandatory;
  }
  [data-thumbnails="below"]:not(.\#) .gallery-desktop-rail:not(.\#) [data-scroll-control]:not(.\#) {
    display: none;
  }
  @media (min-width: 64rem) {
    [data-thumbnails="below"]:not(.\#) .gallery-layout:not(.\#) {
      display: flex;
      flex-direction: column;
    }
    [data-thumbnails="below"]:not(.\#) .gallery-desktop-rail:not(.\#) {
      order: 2;
      height: calc(var(--gallery-thumb, 5.5rem) + 0.5rem);
    }
    [data-thumbnails="below"]:not(.\#) [data-thumbnail-rail="desktop"]:not(.\#) {
      flex-direction: row;
    }
    [data-thumbnails="below"]:not(.\#) .gallery-desktop-rail:not(.\#) .thumbnail-btn:not(.\#) {
      width: var(--gallery-thumb, 5.5rem);
      height: var(--gallery-thumb, 5.5rem);
    }
    /* Stacked and grid: the list replaces the stage and the rail. */
    [data-gallery="stacked"]:not(.\#) .gallery-layout:not(.\#),
    [data-gallery="grid"]:not(.\#) .gallery-layout:not(.\#) {
      display: none;
    }
    [data-gallery="grid"]:not(.\#) .gallery-list:not(.\#) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    [data-gallery="grid"]:not(.\#) .gallery-list:not(.\#) > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .gallery-list:not(.\#) .gallery-extra:not(.\#) {
      display: none;
    }
    .gallery-show-all:checked:not(.\#) ~ .gallery-list:not(.\#) .gallery-extra:not(.\#) {
      display: block;
    }
    .gallery-show-all:checked:not(.\#) ~ .gallery-show-all-label:not(.\#) {
      display: none;
    }
    .gallery-show-all:focus-visible:not(.\#) ~ .gallery-show-all-label:not(.\#) {
      outline: 2px solid var(--ring);
      outline-offset: 2px;
    }
    .gallery-list:not(.\#) + .gallery-show-all-label:not(.\#) {
      margin-top: 0.5rem;
    }
  }
  @media (max-width: 1023px) {
    .mobile-media-stage:not(.\#) {
      max-height: var(--gallery-mobile-max-height);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .thumbnail-btn:not(.\#),
    .thumbnail-btn:not(.\#) img:not(.\#) {
      scroll-behavior: auto;
      animation: none;
    }
  }
</style>

<script>
  import { initProductMediaGallery } from "./scripts/product-media-controller";

  const init = () => initProductMediaGallery();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
</script>
