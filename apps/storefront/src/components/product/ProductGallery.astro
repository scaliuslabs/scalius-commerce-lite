---
import type { Product, ProductMedia } from "@/lib/api";
import { GALLERY_CONFIG } from "./config";
import {
  ChevronDown,
  ChevronUp,
  Maximize2,
  Play,
  Video,
  X,
} from "lucide-react";
import {
  getProductImageUrl,
  hasProductImage,
  PRODUCT_IMAGE_FALLBACK,
} from "@/lib/product-media";
import type { ResolvedStorefrontThemeLayout } from "@scalius/shared/storefront-theme";

interface Props {
  product: Product;
  media: ProductMedia[];
  /** Theme -> Layout -> Product page: thumbnails beside or below the main photo. */
  thumbnails?: ResolvedStorefrontThemeLayout["productPage"]["thumbnails"];
}

const { product, media, thumbnails = "beside" } = Astro.props;
const desktopThumb = GALLERY_CONFIG.thumbnails.desktop;
const mobileThumb = GALLERY_CONFIG.thumbnails.mobile;
const imageWidths = GALLERY_CONFIG.imageWidths;

const galleryMedia = media
  .filter((item) =>
    item.kind === "video" ? Boolean(item.url) : hasProductImage(item.url),
  )
  .sort(
    (left, right) =>
      left.sortOrder - right.sortOrder || left.id.localeCompare(right.id),
  );
const featuredMedia =
  galleryMedia.find((item) => item.isPrimary) ?? galleryMedia[0] ?? null;
const productFallbackUrl = hasProductImage(product.imageUrl)
  ? product.imageUrl!
  : PRODUCT_IMAGE_FALLBACK;
const productFallbackMainUrl = getProductImageUrl(productFallbackUrl, imageWidths.display);
const productFallbackMobileUrl = getProductImageUrl(productFallbackUrl, imageWidths.mobileDisplay);
const productFallbackZoomUrl = getProductImageUrl(productFallbackUrl, imageWidths.zoom);

function formatDuration(durationMs: number | null): string | null {
  if (!durationMs || durationMs <= 0) return null;
  const totalSeconds = Math.round(durationMs / 1_000);
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = String(totalSeconds % 60).padStart(2, "0");
  return `${minutes}:${seconds}`;
}

const optimizedMedia = galleryMedia.map((item) => {
  const altText =
    item.altText?.trim() || product.imageAlt?.trim() || product.name;
  if (item.kind === "video") {
    return {
      item,
      altText,
      duration: formatDuration(item.durationMs),
      thumbUrl: item.posterUrl
        ? getProductImageUrl(item.posterUrl, imageWidths.preview)
        : null,
      mainUrl: item.url,
      mobileUrl: item.url,
      zoomUrl: null,
      posterUrl: item.posterUrl
        ? getProductImageUrl(item.posterUrl, imageWidths.display)
        : null,
    };
  }

  return {
    item,
    altText,
    duration: null,
    thumbUrl: getProductImageUrl(item.url, imageWidths.preview),
    mainUrl: getProductImageUrl(item.url, imageWidths.display),
    mobileUrl: getProductImageUrl(item.url, imageWidths.mobileDisplay),
    zoomUrl: getProductImageUrl(item.url, imageWidths.zoom),
    posterUrl: null,
  };
});

const initialMedia =
  optimizedMedia.find(({ item }) => item.id === featuredMedia?.id) ?? null;
const initialImage =
  initialMedia?.item.kind === "image"
    ? initialMedia
    : (optimizedMedia.find(({ item }) => item.kind === "image") ?? null);
const initialImageUrl = initialImage?.mainUrl ?? productFallbackMainUrl;
const initialMobileImageUrl =
  initialImage?.mobileUrl ?? productFallbackMobileUrl;
const initialImageZoomUrl = initialImage?.zoomUrl ?? productFallbackZoomUrl;
const initialImageAlt =
  initialImage?.altText ?? product.imageAlt?.trim() ?? product.name;
const hasMultipleMedia = optimizedMedia.length > 1;
---

<div
  id="product-gallery"
  data-product-gallery
  data-initial-product-media-id={featuredMedia?.id ?? undefined}
  data-fallback-url={productFallbackMainUrl}
  data-fallback-mobile-url={productFallbackMobileUrl}
  data-fallback-zoom-url={productFallbackZoomUrl}
  data-fallback-media-id={product.imageMediaId ?? undefined}
  data-fallback-alt={product.imageAlt?.trim() || product.name}
  data-thumbnails={thumbnails}
  class="group/gallery relative w-full lg:col-span-7 xl:col-span-6"
>
  <div
    class:list={[
      "gallery-layout flex flex-col gap-2 lg:sticky lg:gap-5",
      hasMultipleMedia
        ? "lg:grid lg:grid-cols-[80px_1fr] xl:grid-cols-[100px_1fr]"
        : "lg:block",
    ]}
    style={`top: 5rem; --gallery-mobile-max-height: ${GALLERY_CONFIG.mainImage.maxHeightMobile};`}
  >
    <div
      class:list={[
        "relative z-10 min-w-0 flex-1",
        hasMultipleMedia && "lg:col-start-2 lg:row-start-1",
      ]}
    >
      <div class="gallery-stage-row flex items-stretch gap-2">
        <div class="group/main relative flex-1">
          <button
            type="button"
            data-image-stage="mobile"
            data-mobile-image-trigger
            class:list={[
              "mobile-media-stage relative aspect-square w-full cursor-zoom-in overflow-hidden rounded-lg bg-muted text-left transition-transform duration-200 active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground lg:hidden motion-reduce:transition-none",
              initialMedia?.item.kind === "video" && "hidden",
            ]}
            aria-label="Open product image zoom"
          >
            <img
              data-mobile-main-image
              src={initialMobileImageUrl}
              data-zoom-url={initialImageZoomUrl}
              alt={initialImageAlt}
              width="600"
              height="600"
              class="h-full w-full object-contain object-center"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
            <span
              class="pointer-events-none absolute right-3 bottom-3 flex items-center gap-1 rounded-full bg-black/40 p-2 text-xs font-medium text-white opacity-0 backdrop-blur-md transition-opacity duration-300 group-hover/main:opacity-100 motion-reduce:transition-none"
            >
              <Maximize2 className="h-3 w-3" />
              Zoom
            </span>
          </button>

          <div
            data-image-stage="desktop"
            class:list={[
              "relative hidden aspect-square w-full cursor-zoom-in overflow-hidden rounded-xl bg-muted lg:block",
              initialMedia?.item.kind === "video" && "lg:!hidden",
            ]}
          >
            <div
              data-desktop-image-zoom
              class="group relative aspect-square w-full cursor-crosshair overflow-hidden rounded-xl border border-border bg-background"
              style="contain: layout style;"
            >
              <img
                data-desktop-main-image
                src={initialImageUrl}
                alt={initialImageAlt}
                width={imageWidths.display}
                height={imageWidths.display}
                class="h-full w-full object-contain object-center transition-opacity duration-150 motion-reduce:transition-none"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
              <div
                data-desktop-zoom-layer
                class="pointer-events-none absolute inset-0 bg-background bg-no-repeat opacity-0 transition-opacity duration-150 motion-reduce:transition-none"
                aria-hidden="true"
              >
              </div>
              <div
                class="pointer-events-none absolute right-3 bottom-3 rounded-full bg-white/80 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground opacity-0 shadow-sm backdrop-blur transition-opacity group-hover:opacity-100 motion-reduce:transition-none"
              >
                Zoom
              </div>
            </div>
          </div>

          <div
            data-video-stage
            class:list={[
              "mobile-media-stage relative aspect-square w-full overflow-hidden rounded-lg bg-muted lg:rounded-xl",
              initialMedia?.item.kind !== "video" && "hidden",
            ]}
          >
            <div
              data-video-placeholder
              class:list={[
                "pointer-events-none absolute inset-0 z-0 flex flex-col items-center justify-center gap-2 bg-muted text-muted-foreground",
                initialMedia?.posterUrl && "hidden",
              ]}
            >
              <span
                class="flex h-12 w-12 items-center justify-center rounded-full border border-border bg-background shadow-sm"
                aria-hidden="true"
              >
                <Play className="ml-0.5 h-5 w-5 fill-current" />
              </span>
              <span class="text-sm font-medium">Product video</span>
            </div>
            <media-theme-microvideo
              data-product-video-player
              class="relative z-10 block h-full w-full overflow-hidden bg-transparent"
              style="--media-primary-color: rgb(255 255 255 / 0.96); --media-secondary-color: rgb(0 0 0 / 0.82);"
            >
              <video
                data-product-video
                slot="media"
                controls
                playsinline
                preload={initialMedia?.item.kind === "video"
                  ? "metadata"
                  : "none"}
                src={initialMedia?.item.kind === "video"
                  ? initialMedia.mainUrl
                  : undefined}
                poster={initialMedia?.item.kind === "video"
                  ? (initialMedia.posterUrl ?? undefined)
                  : undefined}
                class="h-full w-full bg-transparent object-contain"
                aria-label={initialMedia?.item.kind === "video"
                  ? initialMedia.altText
                  : "Product video"}></video>
            </media-theme-microvideo>
          </div>
        </div>

        {
          hasMultipleMedia && (
            <div class="gallery-mobile-rail relative w-[18vw] max-w-[80px] shrink-0 lg:hidden">
              <button
                type="button"
                data-scroll-control="mobile-up"
                class="pointer-events-none absolute -top-1 left-0 right-0 z-10 flex h-11 items-start justify-center opacity-0 transition-opacity duration-300 focus-visible:outline-2 focus-visible:outline-foreground motion-reduce:transition-none"
                aria-label="Scroll product media up"
                tabindex="-1"
              >
                <span class="rounded-full border border-border bg-background p-0.5 text-muted-foreground shadow-xs">
                  <ChevronUp className="h-3 w-3" />
                </span>
              </button>

              <div
                data-thumbnail-rail="mobile"
                class="scrollbar-hide absolute inset-0 overflow-y-auto pb-2 snap-y snap-mandatory touch-pan-y"
                aria-label="Product media"
              >
                <div class="flex flex-col gap-2 pt-0.5">
                  {optimizedMedia.map((itemData, index) => (
                    <button
                      type="button"
                      class="thumbnail-btn snap-start group relative aspect-square w-full min-h-11 shrink-0 overflow-hidden rounded-lg border border-border bg-background transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground active:scale-95 motion-reduce:transition-none"
                      data-gallery-thumbnail
                      data-product-media-id={itemData.item.id}
                      data-media-id={itemData.item.mediaId}
                      data-media-kind={itemData.item.kind}
                      data-media-url={itemData.mainUrl}
                      data-mobile-media-url={itemData.mobileUrl}
                      data-preview-url={
                        itemData.item.kind === "image"
                          ? itemData.thumbUrl
                          : undefined
                      }
                      data-poster-url={itemData.posterUrl ?? undefined}
                      data-zoom-url={itemData.zoomUrl ?? undefined}
                      data-alt-text={itemData.altText}
                      aria-label={
                        itemData.item.kind === "video"
                          ? `Play video ${index + 1}: ${itemData.altText}`
                          : `View image ${index + 1}: ${itemData.altText}`
                      }
                      aria-current={
                        itemData.item.id === featuredMedia?.id
                          ? "true"
                          : "false"
                      }
                      tabindex={itemData.item.id === featuredMedia?.id ? 0 : -1}
                    >
                      {itemData.thumbUrl ? (
                        <img
                          src={itemData.thumbUrl}
                          alt=""
                          width={mobileThumb.imageSize}
                          height={mobileThumb.imageSize}
                          class="h-full w-full object-contain object-center"
                          loading="lazy"
                          decoding="async"
                          fetchpriority="low"
                        />
                      ) : (
                        <span
                          class="flex h-full w-full items-center justify-center bg-muted text-muted-foreground"
                          aria-hidden="true"
                        >
                          <Video className="h-5 w-5" />
                        </span>
                      )}
                      {itemData.item.kind === "video" && (
                        <>
                          <span
                            class="absolute inset-0 flex items-center justify-center bg-black/12 text-white"
                            aria-hidden="true"
                          >
                            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-black/65 shadow-sm">
                              <Play className="ml-0.5 h-4 w-4 fill-current" />
                            </span>
                          </span>
                          <span class="absolute bottom-1 left-1 rounded bg-black/70 px-1 py-0.5 text-[9px] font-semibold leading-none text-white">
                            Video
                            {itemData.duration ? ` · ${itemData.duration}` : ""}
                          </span>
                        </>
                      )}
                      <span
                        data-thumb-ring
                        class:list={[
                          "thumb-ring pointer-events-none absolute inset-0 rounded-lg border-2 border-transparent transition-colors duration-200 motion-reduce:transition-none",
                          itemData.item.id === featuredMedia?.id &&
                            "!border-foreground",
                        ]}
                        aria-hidden="true"
                      />
                    </button>
                  ))}
                </div>
              </div>

              <button
                type="button"
                data-scroll-control="mobile-down"
                class="pointer-events-none absolute bottom-0 left-0 right-0 z-10 flex h-11 items-end justify-center pb-1 opacity-0 transition-opacity duration-300 focus-visible:outline-2 focus-visible:outline-foreground motion-reduce:transition-none"
                aria-label="Scroll product media down"
                tabindex="-1"
              >
                <span class="rounded-full border border-border bg-background p-0.5 text-muted-foreground shadow-xs">
                  <ChevronDown className="h-3 w-3" />
                </span>
              </button>
            </div>
          )
        }
      </div>
    </div>

    {
      hasMultipleMedia && (
        <div class="gallery-desktop-rail relative hidden h-full w-full lg:col-start-1 lg:row-start-1 lg:block">
          <button
            type="button"
            data-scroll-control="desktop-up"
            class="pointer-events-none absolute -top-1 left-0 right-0 z-10 flex h-11 items-start justify-center opacity-0 transition-opacity duration-300 focus-visible:outline-2 focus-visible:outline-foreground motion-reduce:transition-none"
            aria-label="Scroll product media up"
            tabindex="-1"
          >
            <span class="rounded-full border border-border bg-background p-0.5 text-muted-foreground shadow-xs">
              <ChevronUp className="h-4 w-4" />
            </span>
          </button>

          <div
            data-thumbnail-rail="desktop"
            class="custom-scrollbar absolute inset-0 flex flex-col gap-3 overflow-y-auto scroll-smooth pr-1 pb-4 snap-y snap-mandatory motion-reduce:scroll-auto"
            aria-label="Product media"
          >
            {optimizedMedia.map((itemData, index) => (
              <button
                type="button"
                class="thumbnail-btn snap-start group relative aspect-square w-full min-h-11 shrink-0 overflow-hidden rounded-lg border border-border bg-background transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground active:scale-95 motion-reduce:transition-none"
                data-gallery-thumbnail
                data-product-media-id={itemData.item.id}
                data-media-id={itemData.item.mediaId}
                data-media-kind={itemData.item.kind}
                data-media-url={itemData.mainUrl}
                data-mobile-media-url={itemData.mobileUrl}
                data-preview-url={
                  itemData.item.kind === "image" ? itemData.thumbUrl : undefined
                }
                data-poster-url={itemData.posterUrl ?? undefined}
                data-zoom-url={itemData.zoomUrl ?? undefined}
                data-alt-text={itemData.altText}
                aria-label={
                  itemData.item.kind === "video"
                    ? `Play video ${index + 1}: ${itemData.altText}`
                    : `View image ${index + 1}: ${itemData.altText}`
                }
                aria-current={
                  itemData.item.id === featuredMedia?.id ? "true" : "false"
                }
                tabindex={itemData.item.id === featuredMedia?.id ? 0 : -1}
              >
                {itemData.thumbUrl ? (
                  <img
                    src={itemData.thumbUrl}
                    alt=""
                    width={desktopThumb.imageSize}
                    height={desktopThumb.imageSize}
                    class="h-full w-full object-contain object-center transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  />
                ) : (
                  <span
                    class="flex h-full w-full items-center justify-center bg-muted text-muted-foreground"
                    aria-hidden="true"
                  >
                    <Video className="h-5 w-5" />
                  </span>
                )}
                {itemData.item.kind === "video" && (
                  <>
                    <span
                      class="absolute inset-0 flex items-center justify-center bg-black/12 text-white"
                      aria-hidden="true"
                    >
                      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-black/65 shadow-sm">
                        <Play className="ml-0.5 h-4 w-4 fill-current" />
                      </span>
                    </span>
                    <span class="absolute bottom-1 left-1 rounded bg-black/70 px-1.5 py-0.5 text-[10px] font-semibold leading-none text-white">
                      Video{itemData.duration ? ` · ${itemData.duration}` : ""}
                    </span>
                  </>
                )}
                <span
                  data-thumb-ring
                  class:list={[
                    "thumb-ring pointer-events-none absolute inset-0 rounded-lg border-2 border-transparent transition-colors duration-200 motion-reduce:transition-none",
                    itemData.item.id === featuredMedia?.id && "!border-foreground",
                  ]}
                  aria-hidden="true"
                />
              </button>
            ))}
          </div>

          <button
            type="button"
            data-scroll-control="desktop-down"
            class="pointer-events-none absolute bottom-0 left-0 right-0 z-10 flex h-11 items-end justify-center pb-1 opacity-0 transition-opacity duration-300 focus-visible:outline-2 focus-visible:outline-foreground motion-reduce:transition-none"
            aria-label="Scroll product media down"
            tabindex="-1"
          >
            <span class="rounded-full border border-border bg-background p-0.5 text-muted-foreground shadow-xs">
              <ChevronDown className="h-4 w-4" />
            </span>
          </button>
        </div>
      )
    }
  </div>

  <div
    data-mobile-zoom-modal
    class="pointer-events-none fixed inset-0 z-100 flex touch-none flex-col bg-black/98 opacity-0 backdrop-blur-2xl transition-all duration-300 motion-reduce:transition-none"
    role="dialog"
    aria-modal="true"
    aria-label="Product image zoom"
    aria-hidden="true"
    inert
  >
    <div class="absolute top-0 right-0 left-0 z-20 flex justify-end p-4">
      <button
        type="button"
        data-close-mobile-zoom
        class="rounded-full bg-white/10 p-2.5 text-white backdrop-blur-md transition-colors active:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white motion-reduce:transition-none"
        aria-label="Close image zoom"
        tabindex="-1"
      >
        <X className="h-6 w-6" />
      </button>
    </div>
    <div
      data-panzoom-container
      class="relative flex h-full w-full flex-1 items-center justify-center overflow-hidden"
    >
      <img
        data-fullscreen-image
        data-zoom-src={initialImageZoomUrl}
        alt={`${initialImageAlt} — zoomed view`}
        width={imageWidths.zoom}
        height={imageWidths.zoom}
        loading="lazy"
        decoding="async"
        class="max-h-full max-w-full origin-center object-contain transition-transform duration-100 ease-out will-change-transform motion-reduce:transition-none"
      />
    </div>
    <div
      class="pointer-events-none absolute right-0 bottom-8 left-0 text-center text-xs text-white/50"
    >
      Double tap to zoom • Drag to pan
    </div>
  </div>
</div>

<style>
  #product-gallery {
    contain: layout style;
  }
  .thumbnail-btn {
    contain: layout style paint;
  }
  .thumbnail-btn img {
    contain: strict;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 3px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 20px;
  }
  .custom-scrollbar:hover::-webkit-scrollbar-thumb {
    background-color: #94a3b8;
  }
  .thumbnail-btn .thumb-ring.\!border-foreground {
    border-color: var(--foreground) !important;
  }

  /* Thumbnails below the main photo: one horizontal strip on every screen. */
  [data-thumbnails="below"] .gallery-stage-row {
    flex-direction: column;
  }
  [data-thumbnails="below"] .gallery-mobile-rail {
    width: 100%;
    max-width: none;
    height: 4.5rem;
  }
  [data-thumbnails="below"] [data-thumbnail-rail] {
    overflow-x: auto;
    overflow-y: hidden;
    touch-action: pan-x;
    scroll-snap-type: x mandatory;
  }
  [data-thumbnails="below"] [data-thumbnail-rail="mobile"] > div {
    flex-direction: row;
    height: 100%;
  }
  [data-thumbnails="below"] .gallery-mobile-rail .thumbnail-btn {
    width: 4.25rem;
    height: 4.25rem;
  }
  [data-thumbnails="below"] [data-scroll-control] {
    display: none;
  }
  @media (min-width: 64rem) {
    [data-thumbnails="below"] .gallery-layout {
      display: flex;
      flex-direction: column;
    }
    [data-thumbnails="below"] .gallery-desktop-rail {
      order: 2;
      height: 6rem;
    }
    [data-thumbnails="below"] [data-thumbnail-rail="desktop"] {
      flex-direction: row;
    }
    [data-thumbnails="below"] .gallery-desktop-rail .thumbnail-btn {
      width: 5.5rem;
      height: 5.5rem;
    }
  }
  @media (max-width: 1023px) {
    .mobile-media-stage {
      max-height: var(--gallery-mobile-max-height);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .thumbnail-btn,
    .thumbnail-btn img {
      scroll-behavior: auto;
      animation: none;
    }
  }
</style>

<script>
  import { initProductMediaGallery } from "./scripts/product-media-controller";

  const init = () => initProductMediaGallery();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
  document.addEventListener("astro:page-load", init);
</script>
