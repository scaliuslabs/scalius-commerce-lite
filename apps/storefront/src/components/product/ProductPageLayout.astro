---
// The product page's photo + details grid (Theme -> Layout -> Product page).
// `beside` puts the gallery next to the details from 64rem (today's 12
// columns). `stacked` (Dawn) and `grid` (Target) keep every photo in the
// wide column and the details in a sticky column beside it (345px, 400–480px),
// so the buy box starts at the top of the first screen and stays in view; a
// column taller than the window scrolls until its end shows, then stays. A buy box with a
// delivery column takes the space beside the gallery from 80rem.
import type { ResolvedStorefrontThemeLayout } from "@scalius/shared/storefront-theme";

interface Props {
  gallery: ResolvedStorefrontThemeLayout["productPage"]["gallery"];
  /** The buy box carries a purchase column at the right (from 80rem). */
  factsColumn?: boolean;
}

const { gallery, factsColumn = false } = Astro.props;
---

<div
  class="product-layout grid grid-cols-1 gap-x-10 gap-y-2 lg:grid-cols-12 lg:gap-y-8"
  data-gallery={gallery}
  data-facts-column={factsColumn ? "" : undefined}
>
  <slot />
</div>

<style>
  @media (min-width: 64rem) {
    .product-layout[data-gallery="stacked"],
    .product-layout[data-gallery="grid"] {
      grid-template-columns: minmax(0, 1fr) var(--product-info-column);
      align-items: start;
    }
    .product-layout[data-gallery="stacked"] {
      --product-info-column: 345px;
    }
    .product-layout[data-gallery="grid"] {
      --product-info-column: 400px;
    }
    .product-layout[data-gallery="stacked"] > :global([data-product-gallery]),
    .product-layout[data-gallery="stacked"] > :global([data-product-summary]),
    .product-layout[data-gallery="grid"] > :global([data-product-gallery]),
    .product-layout[data-gallery="grid"] > :global([data-product-summary]) {
      grid-column: auto;
    }
    .product-layout[data-gallery="stacked"] > :global([data-product-summary]),
    .product-layout[data-gallery="grid"] > :global([data-product-summary]) {
      /* Start-aligned so the grid does not stretch the column to the photos' height (sticky needs room to travel).
         A column taller than the window scrolls until its end shows (sticky-column.ts). */
      align-self: start;
      position: sticky;
      top: calc(var(--header-height, 4rem) + 1rem + var(--sticky-column-shift, 0px));
    }
  }
  @media (min-width: 80rem) {
    .product-layout[data-gallery="grid"] {
      --product-info-column: 480px;
    }
    .product-layout[data-gallery="beside"][data-facts-column] > :global([data-product-gallery]) {
      position: sticky;
      top: calc(var(--header-height, 0px) + 1rem);
      align-self: start;
    }
    .product-layout[data-gallery="beside"][data-facts-column] > :global([data-product-gallery] .gallery-layout) {
      position: static;
    }
    .product-layout[data-gallery="beside"][data-facts-column] {
      grid-template-columns: minmax(0, 35%) minmax(0, 1fr);
      column-gap: 1.5rem;
    }
    .product-layout[data-gallery="beside"][data-facts-column] > :global([data-product-gallery]) {
      grid-column: 1;
      grid-row: 1;
    }
    .product-layout[data-gallery="beside"][data-facts-column] > :global([data-product-summary]) {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
