---
// src/components/hero.astro
// The homepage hero in its layout, from the section's own slides
// (lib/homepage-hero resolveHomepageHero): phones show each slide's phone
// image, else its computer image around the phone focal point. Every layout
// shows each slide's heading, supporting text and button (HeroCopy).
// - contained-banners: a contained carousel (the theme's container), with up
//   to two side banners beside it when the section names them.
// - full-bleed: edge to edge at 2.6:1 on computers, 5:3 on phones.
// - full-screen: 70% of the first screen on phones, tall on computers.
// - split: the first two banners side by side on computers.
// - wide-editorial: a contained, low campaign banner with the copy in a
//   panel beside the photo.
// Only the first banner is the LCP image: high priority, and preloaded by
// pages/index.astro from heroLeadCandidates() when the hero leads.
import CustomCarousel from "./sliders/CustomCarousel.astro";
import HeroPicture from "./sliders/HeroPicture.astro";
import Container from "@/components/ui/Container.astro";
import { HERO_SLIDE_PRESENTATION } from "@scalius/shared/hero-slider";
import type { ResolvedHomepageHero, StorefrontHeroLayout } from "@/lib/homepage-hero";
import type { HomepageMediaAsset } from "@/lib/api/storefront";
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";

export interface HeroSideBanner {
  asset: HomepageMediaAsset;
  alt: string;
  href: string | null;
}

interface Props {
  hero: ResolvedHomepageHero;
  /** The banner leads the page (the LCP): its first slide gets high priority. */
  priority?: boolean;
  /** Phones can show category tiles before this banner. */
  phonePriority?: boolean;
  layout?: StorefrontHeroLayout;
  /** full-screen on phones: 70% of the first screen, or a compact frame for photo-only banners. */
  phoneHeight?: "screen" | "compact";
  /** contained-banners: up to two images beside the banner. */
  sideBanners?: HeroSideBanner[];
}

const {
  hero,
  priority = true,
  phonePriority = priority,
  layout = "contained-banners",
  phoneHeight = "screen",
  sideBanners = [],
} = Astro.props;
const hasBanners = hero.desktop.length > 0 || hero.mobile.length > 0;
const sides = layout === "contained-banners" ? sideBanners.slice(0, 2) : [];

// Edge-to-edge frames follow the viewport: 2.6:1 on computers (1440x548)
// and 5:3 on phones (390x234); full-screen is 70% of the first screen on
// phones (svh never changes while scrolling, so nothing shifts).
const FRAME_HEIGHT = {
  "full-bleed": { desktop: "clamp(18rem, 38vw, 42rem)", mobile: "60vw" },
  "full-screen": {
    desktop: "clamp(26rem, calc(100svh - var(--header-height, 3.5rem)), 56vw)",
    mobile: "clamp(24rem, 70svh, 40rem)",
  },
  "wide-editorial": { desktop: "clamp(16rem, calc((100vw - 4rem) * 0.242), 22.5rem)", mobile: "min(24rem, 90vw)" },
} as const;
const frames = layout === "full-bleed" || layout === "full-screen" || layout === "wide-editorial" ? FRAME_HEIGHT[layout] : null;
// A photo-only phone banner needs no tall frame: 65svh, 23-35rem.
const compactPhone = layout === "full-screen"
  && phoneHeight === "compact"
  && hero.mobile.length > 0
  && hero.mobile.every((slide) => !slide.heading?.trim() && !slide.supportingText?.trim() && !(slide.link && slide.buttonLabel?.trim()));
const edgeToEdge = layout === "full-bleed" || layout === "full-screen";
// One carousel per viewport; CSS shows the one that fits.
const carousels = [
  { type: "desktop" as const, slides: hero.desktop, wrap: "hidden md:block relative", lead: priority, frameHeight: frames?.desktop },
  {
    type: "mobile" as const,
    slides: hero.mobile,
    wrap: "md:hidden relative",
    lead: phonePriority,
    frameHeight: compactPhone ? "clamp(23rem, 65svh, 35rem)" : frames?.mobile,
  },
].filter((each) => each.slides.length > 0);
const split = layout === "split" ? hero.desktop.slice(0, 2) : [];
---

{hasBanners && layout === "split" && (
  <div class="relative w-full" data-hero-layout="split">
    {split.length > 0 && (
      <div class:list={["hidden md:grid", split.length > 1 ? "grid-cols-2" : "grid-cols-1"]}>
        {split.map((slide, index) => (
          <HeroPicture slide={slide} viewport="desktop" layout="split" index={index} priority={priority} frameClass="hero-split-frame" />
        ))}
      </div>
    )}
    {hero.mobile[0] && (
      <div class="md:hidden">
        <HeroPicture slide={hero.mobile[0]} viewport="mobile" layout="split" index={0} priority={phonePriority} frameClass="hero-split-frame" />
      </div>
    )}
  </div>
)}

{hasBanners && layout === "wide-editorial" && (
  <Container data-hero-layout="wide-editorial">
    {carousels.map((each) => (
      <div class={each.wrap}>
        <CustomCarousel images={each.slides} height={HERO_SLIDE_PRESENTATION[each.type].height} type={each.type} priority={each.lead} layout={layout} frameHeight={each.frameHeight} overlay="editorial" />
      </div>
    ))}
  </Container>
)}

{hasBanners && edgeToEdge && (
  <div class="relative w-full" data-hero-layout={layout}>
    {carousels.map((each) => (
      <div class={each.wrap}>
        <CustomCarousel images={each.slides} height={HERO_SLIDE_PRESENTATION[each.type].height} type={each.type} priority={each.lead} layout={layout} frameHeight={each.frameHeight} rounded={false} />
      </div>
    ))}
  </div>
)}

{hasBanners && layout === "contained-banners" && (
  <div class="relative w-full" data-hero-layout={sides.length > 0 ? layout : undefined}>
    <Container class="pt-2 md:pt-4">
      <div class:list={["grid gap-3 md:gap-4", sides.length > 0 && "md:grid-cols-[minmax(0,1fr)_18.75rem]"]}>
        <div class="min-w-0">
          {carousels.map((each) => (
            <div class={each.wrap}>
              <CustomCarousel images={each.slides} height={HERO_SLIDE_PRESENTATION[each.type].height} type={each.type} priority={each.lead} />
            </div>
          ))}
        </div>

        {sides.length > 0 && (
          <div class="grid grid-cols-2 gap-3 md:grid-cols-1 md:grid-rows-2 md:gap-4" data-hero-side-banners>
            {sides.map(({ asset, alt, href }) => {
              const Frame = href ? "a" : "div";
              return (
                <Frame
                  href={href ?? undefined}
                  data-astro-prefetch={href ? getStorefrontPrefetchAttribute(href, Astro.url) : undefined}
                  class="relative block aspect-[5/4] overflow-hidden rounded-xl bg-muted md:aspect-auto md:h-full"
                >
                  <img
                    src={mediaImageUrl(asset.url, 640)}
                    srcset={mediaImageSrcSet(asset.url)}
                    sizes="(max-width: 767px) calc(50vw - 1.5rem), 300px"
                    alt={alt || asset.alt}
                    width={asset.width ?? 600}
                    height={asset.height ?? 480}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                </Frame>
              );
            })}
          </div>
        )}
      </div>
    </Container>
  </div>
)}

<style>
  /* A split banner: two portrait halves, never taller than the first
     screen below the header. */
  :global(.hero-split-frame) {
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - var(--header-height, 3.5rem));
    width: 100%;
  }
</style>
