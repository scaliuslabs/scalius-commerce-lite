---
// src/components/hero.astro
// Homepage banners per viewport; phones fall back to the desktop banners.
import CustomCarousel from "./sliders/CustomCarousel.astro";
import { HERO_SLIDE_PRESENTATION } from "@scalius/shared/hero-slider";
import type { ResolvedHomepageHero } from "@/lib/homepage-hero";

interface Props {
  hero: ResolvedHomepageHero;
}

const { hero } = Astro.props;
---

{
  (hero.desktop.length > 0 || hero.mobile.length > 0) && (
    <div class="relative w-full">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 md:pt-4">
        {hero.desktop.length > 0 && (
          <div class="hidden md:block relative">
            <CustomCarousel
              images={hero.desktop}
              height={HERO_SLIDE_PRESENTATION.desktop.height}
              type="desktop"
            />
          </div>
        )}
        {hero.mobile.length > 0 && (
          <div class="md:hidden relative">
            <CustomCarousel
              images={hero.mobile}
              height={HERO_SLIDE_PRESENTATION.mobile.height}
              type="mobile"
            />
          </div>
        )}
      </div>
    </div>
  )
}
