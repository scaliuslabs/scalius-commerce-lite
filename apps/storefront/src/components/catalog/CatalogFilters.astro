---
// Server-rendered listing filters: a plain GET form of native controls, so a
// tap or Space works the moment the HTML arrives (no hydration) and filtering
// works without JavaScript. `setupCatalogFilters()` adds instant apply on
// computers, the live "Show N products" count in the phone sheet and the
// filter drawer, "See more" in place, the price slider and the bar's
// dropdown behaviour.
//
// One form, placed by the listing's filter style (lib/catalog-listing):
// - `sidebar` (sidebar-dense, sidebar-comfortable): an open column of tight
//   rows (Amazon, Daraz, Star Tech; Apple Gadgets for comfortable);
// - `bar` (bar-dropdowns): on computers a one-line bar of facet dropdowns
//   over the grid (Dawn), the rest behind "More filters";
// - `drawer`: a panel behind a Filter button at every width (Target).
// On phones every placement is a bottom sheet. The measured column width,
// row pitch and label size arrive as CSS custom properties
// (`presentation.styleVars`, catalog-listing.css).
//
// Groups: the category tree (links with counts), availability, price, then
// the facets (brand first, then option axes and attributes in the category's
// spec order, same-name facets merged). Each group sends at most
// STOREFRONT_FILTER_VALUES_IN_HTML values; "See more" fetches the rest (or,
// without JavaScript, `?showAll=<slug>` renders them).
import type { BuyerPriceRange } from "@/lib/api";
import {
  PRODUCT_LIST_SHOW_ALL_PARAM,
  buildProductListHref,
  productListRangeKey,
  type ProductListFilterState,
  type ProductListSort,
} from "@/lib/product-list-query";
import {
  catalogApplyButton,
  showsCatalogPriceFilter,
  type CatalogFacetGroup,
  type CatalogRatingRow,
} from "@/lib/catalog-filters";
import {
  CATALOG_FACET_SEARCH_MIN_VALUES,
  catalogCategoryFacetLinks,
  catalogFacetAnchor,
  catalogFacetDisplay,
  type CatalogFilterPresentation,
} from "@/lib/catalog-listing";
import { formatMoney } from "@/lib/currency";
import { PRODUCT_LIST_MIN_RATING_PARAM } from "@/lib/product-list-query";
import { Search } from "lucide-react";

interface Props {
  groups: CatalogFacetGroup[];
  priceRange?: BuyerPriceRange;
  currentFilters: ProductListFilterState;
  query: string;
  sortBy: ProductListSort;
  defaultSort: ProductListSort;
  total: number;
  pathname: string;
  resetPath: string;
  searchLabel: string;
  countEndpoint: string;
  currencySymbol: string;
  currencyCode: string;
  presentation: CatalogFilterPresentation;
  /** Leave the category group out (the sub-category pills above the results carry it). */
  withoutCategories?: boolean;
  /** The Customer rating group's "N★ & up" rows (catalogRatingRows); empty hides the group. */
  ratingRows?: CatalogRatingRow[];
}

const {
  groups,
  priceRange,
  currentFilters,
  query,
  sortBy,
  defaultSort,
  total,
  pathname,
  resetPath,
  searchLabel,
  countEndpoint,
  currencySymbol,
  currencyCode,
  presentation,
  withoutCategories = false,
  ratingRows = [],
} = Astro.props;

const placement = presentation.placement;
const drawer = placement === "drawer";
const bar = placement === "bar";
const dense = presentation.style === "sidebar-dense";
const money = (amount: number) => formatMoney(amount, { symbol: currencySymbol, code: currencyCode });
const applyButton = catalogApplyButton(total);
const showPrice = showsCatalogPriceFilter(priceRange, currentFilters);
const single = (key: string) => {
  const value = currentFilters[key];
  return Array.isArray(value) ? value.at(-1) : value;
};
// The search itself is removed from its chip; "Clear all" clears refinements.
const hasActiveFilters = Object.keys(currentFilters).some((key) => !["page", "sortBy", "limit", "q", PRODUCT_LIST_SHOW_ALL_PARAM].includes(key));
const pageSize = single("limit");
const availability = [
  { name: "inStock", label: "Exclude out of stock" },
  { name: "hasDiscount", label: "On sale" },
  { name: "freeDelivery", label: "Free delivery" },
];
const availabilitySelected = availability.filter(({ name }) => single(name) === "true").length;
// The in-listing search is a comfortable, drawer and phone-sheet field; the
// dense column and the bar keep the header's search (Amazon, Daraz, Dawn).
const searchField = !dense && !bar;

type Section =
  | { kind: "availability"; key: string; name: string; selectedCount: number }
  | { kind: "rating"; key: string; name: string; selectedCount: number }
  | { kind: "price"; key: string; name: string; selectedCount: number }
  | { kind: "group"; key: string; name: string; selectedCount: number; group: CatalogFacetGroup };
const facetSections: Section[] = groups
  .filter((group) => !(withoutCategories && group.kind === "category"))
  .map((group) => ({ kind: "group", key: group.key, name: group.name, selectedCount: group.selectedCount, group }));
const availabilitySection: Section = { kind: "availability", key: "availability", name: "Availability", selectedCount: availabilitySelected };
const ratingSelected = ratingRows.some((row) => row.selected);
const rating: Section[] = ratingRows.length > 0
  ? [{ kind: "rating", key: "rating", name: "Customer rating", selectedCount: ratingSelected ? 1 : 0 }]
  : [];
const priceSection: Section | null = showPrice
  ? { kind: "price", key: "price", name: "Price", selectedCount: single("minPrice") || single("maxPrice") ? 1 : 0 }
  : null;
// The order follows the references:
// - dense column (Amazon, Daraz): availability, the customer rating (Amazon
//   lists "Customer Reviews" near the top), brand and the first specs as
//   tight checkbox rows, then price and the other specs, the category links
//   last (pills or the breadcrumb carry the tree above);
// - bar (Dawn): availability, price, the rating, then the facets;
// - comfortable column and drawer (Apple Gadgets, Fabrilife, Target): the
//   category links, price, availability, the rating, then the facets.
const categorySections = facetSections.filter((section) => section.kind === "group" && section.group.kind === "category");
const brandSections = facetSections.filter((section) => section.kind === "group" && section.group.facets[0]!.kind === "brand");
const specSections = facetSections.filter((section) => !categorySections.includes(section) && !brandSections.includes(section));
const price = priceSection ? [priceSection] : [];
const sections: Section[] = dense
  ? [availabilitySection, ...rating, ...brandSections, ...specSections.slice(0, 2), ...price, ...specSections.slice(2), ...categorySections]
  : bar
    ? [availabilitySection, ...price, ...rating, ...brandSections, ...specSections]
    : [...categorySections, ...price, availabilitySection, ...rating, ...brandSections, ...specSections];
// A column opens its first groups (and any in use) so the page does not
// start with a wall; a bar's dropdowns open on demand.
const OPEN_GROUPS = 6;
const isOpen = (section: Section, index: number) =>
  !bar && (section.selectedCount > 0 || (presentation.openByDefault ? index < OPEN_GROUPS : index < 2));
const barMore = bar ? Math.max(0, sections.length - presentation.barFacets) : 0;
// A selection behind "More filters" keeps those groups in the bar.
const barOpen = bar && sections.some((section, index) => index >= presentation.barFacets && section.selectedCount > 0);

const anchorOf = (section: Section) => section.kind === "group" ? catalogFacetAnchor(section.key) : `catalog-facet-${section.key}`;
const rangeBounds = [
  { bound: "min", label: "From" },
  { bound: "max", label: "To" },
] as const;
const showAllHref = (key: string | null) => `${buildProductListHref({
  pathname,
  currentFilters,
  overrides: { [PRODUCT_LIST_SHOW_ALL_PARAM]: key, page: null },
  defaultSort,
})}`;
const priceStep = priceRange && priceRange.max > 0 ? Math.max(1, 10 ** Math.max(0, Math.floor(Math.log10(priceRange.max)) - 2)) : 1;
const priceSlider = priceRange && priceRange.max > priceRange.min
  ? { min: Math.floor(priceRange.min / priceStep) * priceStep, max: Math.ceil(priceRange.max / priceStep) * priceStep }
  : null;
---

<form
  id="filterForm"
  method="get"
  action={pathname}
  autocomplete="off"
  data-catalog-filters
  data-count-endpoint={countEndpoint}
  data-catalog-apply={drawer ? "sheet" : undefined}
  data-placement={placement}
  data-filter-style={presentation.style}
  data-bar-open={barOpen ? "" : undefined}
  class="catalog-filter-form grow overflow-y-auto"
>
  {sortBy !== defaultSort && <input type="hidden" name="sortBy" value={sortBy} />}
  {pageSize && <input type="hidden" name="limit" value={pageSize} />}
  {!searchField && query && <input type="hidden" name="q" value={query} />}
  <div class="catalog-filter-groups">
    {searchField && (
      <div class="catalog-filter-search relative">
        <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
        <label for="catalog-filter-search" class="sr-only">{searchLabel}</label>
        <input
          id="catalog-filter-search"
          type="search"
          name="q"
          placeholder={`${searchLabel}…`}
          value={query}
          maxlength={120}
          enterkeyhint="search"
          class="w-full rounded-lg border border-border bg-background py-2 pl-9 pr-4 text-base text-foreground focus:border-primary focus:ring-2 focus:ring-primary lg:text-sm"
        />
      </div>
    )}

    {sections.map((section, index) => {
      const group = section.kind === "group" ? section.group : null;
      const display = group && group.kind === "values" ? catalogFacetDisplay({ ...group.facets[0]!, values: group.rows }) : null;
      const totalValues = group ? group.rows.length + group.more : 0;
      // The merchant's searchable list, or any long list (a brand's 300 values).
      const searchable = group?.kind === "values" && display !== null
        && (display.display === "search-list" || (display.display !== "swatch" && totalValues > CATALOG_FACET_SEARCH_MIN_VALUES));
      const rangeFacet = group?.kind === "range" ? group.facets[0]! : null;
      return (
        <details
          open={isOpen(section, index)}
          id={anchorOf(section)}
          data-catalog-dropdown={bar ? "" : undefined}
          data-bar-overflow={bar && index >= presentation.barFacets ? "" : undefined}
          class="catalog-facet group"
        >
          <summary class="catalog-facet-summary">
            <span class="min-w-0 truncate">{section.name}</span>
            {section.selectedCount > 0 && (
              <span class="catalog-facet-selected tabular-nums">
                <span aria-hidden="true">({section.selectedCount})</span>
                <span class="sr-only">, {section.selectedCount} selected</span>
              </span>
            )}
            <svg class="catalog-facet-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </summary>

          {section.kind === "availability" ? (
            <fieldset class="catalog-facet-body">
              <legend class="sr-only">Availability</legend>
              {availability.map(({ name, label }) => (
                <label class="catalog-facet-row">
                  <input type="checkbox" name={name} value="true" checked={single(name) === "true"} class="catalog-facet-check" />
                  <span class="catalog-facet-label">{label}</span>
                </label>
              ))}
            </fieldset>
          ) : section.kind === "rating" ? (
            <fieldset class="catalog-facet-body" data-catalog-rating-group>
              <legend class="sr-only">Customer rating</legend>
              {ratingRows.map(({ min, count, selected }) => (
                <label class="catalog-facet-row catalog-rating-row">
                  <input
                    type="radio"
                    name={PRODUCT_LIST_MIN_RATING_PARAM}
                    value={String(min)}
                    checked={selected}
                    disabled={count === 0 && !selected}
                    data-catalog-rating
                    class="catalog-facet-check"
                  />
                  <span class="catalog-facet-label catalog-rating-label">
                    <span class="sc-stars catalog-rating-stars" style={`--sc-fill:${min * 20}%`} aria-hidden="true"></span>
                    <span aria-hidden="true">&amp; up</span>
                    <span class="sr-only">{min} stars and up</span>
                  </span>
                  <span class="catalog-facet-count" data-catalog-facet-count>{count}</span>
                </label>
              ))}
              {ratingSelected && (
                // "Any rating" undoes the choice, in the form and without JavaScript.
                <label class="catalog-facet-row">
                  <input type="radio" name={PRODUCT_LIST_MIN_RATING_PARAM} value="" data-catalog-rating class="catalog-facet-check" />
                  <span class="catalog-facet-label">Any rating</span>
                </label>
              )}
            </fieldset>
          ) : section.kind === "price" ? (
            <fieldset class="catalog-facet-body" data-catalog-price>
              <legend class="sr-only">Price</legend>
              {priceSlider && (
                // Shown by JavaScript: two thumbs over one track, written into the fields below.
                <div class="catalog-price-slider" data-catalog-price-slider hidden>
                  <input type="range" aria-label="Minimum price" min={priceSlider.min} max={priceSlider.max} step={priceStep} value={single("minPrice") ?? priceSlider.min} data-catalog-price-thumb="min" />
                  <input type="range" aria-label="Maximum price" min={priceSlider.min} max={priceSlider.max} step={priceStep} value={single("maxPrice") ?? priceSlider.max} data-catalog-price-thumb="max" />
                </div>
              )}
              <div class="catalog-price-fields">
                {[
                  { name: "minPrice", label: "Min", placeholder: priceRange ? String(Math.floor(priceRange.min)) : "0" },
                  { name: "maxPrice", label: "Max", placeholder: priceRange ? String(Math.ceil(priceRange.max)) : "" },
                ].map(({ name, label, placeholder }) => (
                  <div class="relative min-w-0">
                    <label for={`catalog-${name}`} class="sr-only">{label} price</label>
                    <span class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-sm text-muted-foreground" aria-hidden="true">{currencySymbol}</span>
                    {/* Plain text with a decimal keypad: Bangla digits are read as Latin. */}
                    <input
                      id={`catalog-${name}`}
                      type="text"
                      inputmode="decimal"
                      name={name}
                      value={single(name) ?? ""}
                      placeholder={placeholder}
                      class="catalog-filter-input catalog-filter-input--lead"
                    />
                  </div>
                ))}
                {!drawer && (
                  <button type="submit" class="catalog-filter-go">Go<span class="sr-only"> (apply price)</span></button>
                )}
              </div>
              {priceRange && priceRange.max > 0 && (
                <p class="catalog-facet-note">Up to {money(priceRange.max)}</p>
              )}
            </fieldset>
          ) : rangeFacet ? (
            <fieldset class="catalog-facet-body" data-catalog-facet-display="range">
              <legend class="sr-only">{rangeFacet.unit ? `${rangeFacet.name} (${rangeFacet.unit})` : rangeFacet.name}</legend>
              <div class="catalog-price-fields">
                {rangeBounds.map(({ bound, label }) => {
                  const id = `${catalogFacetAnchor(rangeFacet.slug)}-${bound}`;
                  return (
                    <div class="min-w-0">
                      <label for={id} class="sr-only">{label}</label>
                      <input
                        id={id}
                        type="text"
                        inputmode="decimal"
                        name={productListRangeKey(rangeFacet.slug, bound)}
                        value={rangeFacet.applied?.[bound] ?? ""}
                        placeholder={rangeFacet.range ? String(rangeFacet.range[bound]) : label}
                        data-catalog-range={bound}
                        class="catalog-filter-input"
                      />
                    </div>
                  );
                })}
                {!drawer && (
                  <button type="submit" class="catalog-filter-go">Go<span class="sr-only"> (apply {rangeFacet.name})</span></button>
                )}
              </div>
              {rangeFacet.unit && <p class="catalog-facet-note">{rangeFacet.unit}</p>}
            </fieldset>
          ) : group && group.kind === "category" ? (
            <fieldset class="catalog-facet-body" data-catalog-facet-group data-facet-kind="category" data-facet-slugs={group.facets.map((facet) => facet.slug).join(" ")}>
              <legend class="sr-only">{group.name}</legend>
              <ul class="catalog-facet-links">
                {catalogCategoryFacetLinks({ values: group.rows }, currentFilters).map((link) => (
                  <li>
                    {link.href ? (
                      <a href={link.href} class="catalog-facet-row catalog-facet-link" data-catalog-facet-row>
                        <span class="catalog-facet-label" data-catalog-facet-label>{link.label}</span>
                        <span class="catalog-facet-count" data-catalog-facet-count>{link.count}</span>
                      </a>
                    ) : (
                      <span class="catalog-facet-row catalog-facet-link opacity-50" data-catalog-facet-row>
                        <span class="catalog-facet-label" data-catalog-facet-label>{link.label}</span>
                        <span class="catalog-facet-count" data-catalog-facet-count>0</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
              {(group.more > 0 || group.expanded) && (
                <a
                  href={showAllHref(group.expanded ? null : group.key)}
                  class="catalog-facet-more"
                  data-catalog-facet-more
                  data-more-label={`See more (${group.more})`}
                  data-less-label="See less"
                  aria-expanded={group.expanded ? "true" : "false"}
                >
                  {group.expanded ? "See less" : `See more (${group.more})`}
                </a>
              )}
            </fieldset>
          ) : group && display ? (
            <fieldset
              class="catalog-facet-body"
              data-catalog-facet-group
              data-facet-kind="values"
              data-catalog-facet-display={display.display}
              data-facet-slugs={group.facets.map((facet) => facet.slug).join(" ")}
              data-catalog-facet-list={searchable ? "" : undefined}
            >
              <legend class="sr-only">{group.name}</legend>
              {searchable && (
                // Shown by JavaScript (it fetches the values it searches).
                <div class="catalog-facet-search relative" data-catalog-facet-search hidden>
                  <Search className="pointer-events-none absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-muted-foreground" />
                  {/* No name: it narrows the list and is never submitted. */}
                  <input
                    type="search"
                    aria-label={`Search ${group.name}`}
                    placeholder={`Search ${group.name}`}
                    data-catalog-facet-query
                    class="catalog-filter-input catalog-filter-input--icon"
                  />
                  <p class="catalog-facet-note" data-catalog-facet-search-empty hidden>No matches</p>
                </div>
              )}
              <div class:list={["catalog-facet-values", display.display === "swatch" && "catalog-facet-values--swatch"]}>
                {group.rows.map(({ slug, value, label, count, selected }) => (
                  <label class:list={["catalog-facet-row", display.display === "swatch" && "catalog-swatch"]} data-catalog-facet-row>
                    <input
                      type="checkbox"
                      name={slug}
                      value={value}
                      checked={selected}
                      disabled={count === 0 && !selected}
                      data-catalog-facet
                      class={display.display === "swatch" ? "peer sr-only" : "catalog-facet-check"}
                    />
                    {display.display === "swatch" && (
                      // A value with no known colour keeps an empty (muted) swatch beside its label.
                      <span
                        class:list={["catalog-swatch-dot", !display.swatches.has(value) && "bg-muted"]}
                        style={display.swatches.has(value) ? `background:${display.swatches.get(value)}` : undefined}
                        data-catalog-swatch
                        aria-hidden="true"
                      ></span>
                    )}
                    <span class="catalog-facet-label" data-catalog-facet-label>{label}</span>
                    <span class="catalog-facet-count" data-catalog-facet-count>{count}</span>
                  </label>
                ))}
              </div>
              {(group.more > 0 || group.expanded) && (
                <a
                  href={showAllHref(group.expanded ? null : group.key)}
                  class="catalog-facet-more"
                  data-catalog-facet-more
                  data-more-label={`See more (${group.more})`}
                  data-less-label="See less"
                  aria-expanded={group.expanded ? "true" : "false"}
                >
                  {group.expanded ? "See less" : `See more (${group.more})`}
                </a>
              )}
            </fieldset>
          ) : null}
        </details>
      );
    })}

    {bar && barMore > 0 && (
      <button type="button" class="catalog-bar-more" data-catalog-bar-more aria-expanded={barOpen ? "true" : "false"}>
        More filters ({barMore})
      </button>
    )}

    {hasActiveFilters && !drawer && (
      <a href={resetPath} class="catalog-filter-clear">Clear all</a>
    )}
    {!drawer && (
      <noscript>
        <button type="submit" class="catalog-filter-clear">Apply filters</button>
      </noscript>
    )}
  </div>

  <div
    class:list={[
      "z-50 border-t border-border bg-background p-4 pb-[max(1rem,env(safe-area-inset-bottom))]",
      drawer ? "sticky bottom-0" : "fixed inset-x-0 bottom-0 lg:hidden",
    ]}
  >
    <div class:list={["grid gap-3", hasActiveFilters ? "grid-cols-2" : "grid-cols-1"]}>
      {hasActiveFilters && (
        <a
          href={resetPath}
          class="inline-flex h-12 items-center justify-center rounded-lg border border-border bg-background px-4 text-sm font-semibold text-foreground"
        >
          Clear all
        </a>
      )}
      <button
        type="submit"
        data-catalog-filter-apply
        aria-live="polite"
        disabled={applyButton.disabled}
        class="inline-flex h-12 items-center justify-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground disabled:cursor-not-allowed disabled:opacity-50"
      >
        {applyButton.label}
      </button>
    </div>
  </div>
</form>
