---
// Server-rendered listing filters: a plain GET form of native controls, so a
// tap or Space works the moment the HTML arrives (no hydration) and filtering
// works without JavaScript. `setupCatalogFilters()` adds instant apply in the
// desktop sidebar and the live "Show N products" count in the phone sheet
// and the filter drawer.
//
// `presentation` is where the form sits: the sidebar (a bottom sheet on
// phones) or a drawer at every width, whose apply bar stays inside it. Each
// facet renders by its display type (lib/catalog-listing): checkboxes,
// colour swatches, checkboxes with a search field for long lists, or a
// From/To pair of number fields (`<slug>.min`, `<slug>.max`) for a range.
// Values show their label and submit their URL value.
import type { BuyerPriceRange, ProductFacet } from "@/lib/api";
import {
  productListRangeKey,
  type ProductListFilterState,
  type ProductListSort,
} from "@/lib/product-list-query";
import {
  catalogApplyButton,
  showsCatalogPriceFilter,
  visibleCatalogFacets,
} from "@/lib/catalog-filters";
import { catalogFacetAnchor, catalogFacetDisplay } from "@/lib/catalog-listing";
import { formatMoney } from "@/lib/currency";
import { Search } from "lucide-react";

interface Props {
  facets: ProductFacet[];
  priceRange?: BuyerPriceRange;
  currentFilters: ProductListFilterState;
  query: string;
  sortBy: ProductListSort;
  defaultSort: ProductListSort;
  total: number;
  resetPath: string;
  searchLabel: string;
  countEndpoint: string;
  currencySymbol: string;
  currencyCode: string;
  presentation?: "sidebar" | "drawer";
  /** Give each facet group an id, so aspect chips can open the form at it. */
  facetAnchors?: boolean;
}

const {
  facets,
  priceRange,
  currentFilters,
  query,
  sortBy,
  defaultSort,
  total,
  resetPath,
  searchLabel,
  countEndpoint,
  currencySymbol,
  currencyCode,
  presentation = "sidebar",
  facetAnchors = false,
} = Astro.props;

const drawer = presentation === "drawer";
const money = (amount: number) => formatMoney(amount, { symbol: currencySymbol, code: currencyCode });
const shownFacets = visibleCatalogFacets(facets, currentFilters).map((facet) => ({
  ...facet,
  ...catalogFacetDisplay(facet),
}));
const applyButton = catalogApplyButton(total);
const showPrice = showsCatalogPriceFilter(priceRange, currentFilters);
const single = (key: string) => {
  const value = currentFilters[key];
  return Array.isArray(value) ? value.at(-1) : value;
};
// The search itself is removed from its chip; "Clear all" clears refinements.
const hasActiveFilters = Object.keys(currentFilters).some((key) => !["page", "sortBy", "limit", "q"].includes(key));
const pageSize = single("limit");
const switches = [
  { name: "hasDiscount", label: "On sale" },
  { name: "freeDelivery", label: "Free delivery" },
];
const section = "rounded-lg border border-border bg-background";
const summary =
  "flex min-h-11 cursor-pointer list-none items-center justify-between px-4 py-3 font-semibold text-foreground [&::-webkit-details-marker]:hidden";
const chevron = "h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180";
const priceInput =
  "h-11 w-full rounded-lg border border-border bg-background pl-7 pr-3 text-base text-foreground focus:border-primary focus:ring-2 focus:ring-primary lg:h-10 lg:text-sm";
const anchor = (slug: string) => (facetAnchors ? catalogFacetAnchor(slug) : undefined);
const rangeBounds = [
  { bound: "min", label: "From" },
  { bound: "max", label: "To" },
] as const;
---

<form
  id="filterForm"
  method="get"
  autocomplete="off"
  data-catalog-filters
  data-count-endpoint={countEndpoint}
  data-catalog-apply={drawer ? "sheet" : undefined}
  class="grow overflow-y-auto"
>
  {sortBy !== defaultSort && <input type="hidden" name="sortBy" value={sortBy} />}
  {pageSize && <input type="hidden" name="limit" value={pageSize} />}
  <div class:list={["space-y-3 p-4", drawer ? "lg:p-5" : "pb-28 lg:p-6 lg:pb-6"]}>
    <div class="relative mb-6">
      <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
      <label for="catalog-filter-search" class="sr-only">{searchLabel}</label>
      <input
        id="catalog-filter-search"
        type="search"
        name="q"
        placeholder={`${searchLabel}…`}
        value={query}
        maxlength={120}
        enterkeyhint="search"
        class="w-full rounded-lg border border-border bg-background py-2.5 pl-9 pr-4 text-base text-foreground focus:border-primary focus:ring-2 focus:ring-primary lg:text-sm"
      />
    </div>

    <details open class:list={["group", section]}>
      <summary class={summary}>
        Shopping options
        <svg class={chevron} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </summary>
      <div class="space-y-2 px-4 pb-4">
        {switches.map(({ name, label }) => (
          <label class="flex min-h-11 cursor-pointer items-center justify-between gap-3 rounded-lg bg-muted/50 px-3 py-2 text-sm font-medium text-foreground">
            {label}
            <input
              type="checkbox"
              role="switch"
              name={name}
              value="true"
              checked={single(name) === "true"}
              class="relative h-5 w-9 shrink-0 cursor-pointer appearance-none rounded-full bg-input transition-colors before:absolute before:left-0.5 before:top-0.5 before:h-4 before:w-4 before:rounded-full before:bg-background before:shadow before:transition-transform checked:bg-primary checked:before:translate-x-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 motion-reduce:transition-none motion-reduce:before:transition-none"
            />
          </label>
        ))}
      </div>
    </details>

    {showPrice && (
      <details open id={facetAnchors ? "catalog-facet-price" : undefined} class:list={["group", section]}>
        <summary class={summary}>
          Price
          <svg class={chevron} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="px-4 pb-4">
          {priceRange && priceRange.max > 0 && (
            <p class="mb-3 text-sm text-muted-foreground">The highest price is {money(priceRange.max)}</p>
          )}
          <div class="grid grid-cols-2 gap-3">
            {[
              { name: "minPrice", label: "From", placeholder: priceRange ? String(priceRange.min) : "0" },
              { name: "maxPrice", label: "To", placeholder: priceRange ? String(priceRange.max) : "" },
            ].map(({ name, label, placeholder }) => (
              <div>
                <label for={`catalog-${name}`} class="mb-1.5 block text-sm font-medium text-muted-foreground">{label}</label>
                <div class="relative">
                  <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-muted-foreground" aria-hidden="true">{currencySymbol}</span>
                  <input
                    id={`catalog-${name}`}
                    type="text"
                    inputmode="decimal"
                    name={name}
                    value={single(name) ?? ""}
                    placeholder={placeholder}
                    class={priceInput}
                  />
                </div>
              </div>
            ))}
          </div>
          {!drawer && (
            <button
              type="submit"
              class="mt-3 hidden min-h-10 w-full items-center justify-center rounded-lg border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted lg:inline-flex"
            >
              Apply price
            </button>
          )}
        </div>
      </details>
    )}

    {shownFacets.map((facet, index) => (
      <details open={index < 3 || facet.selectedCount > 0} id={anchor(facet.slug)} class:list={["group", section]}>
        <summary class={summary}>
          {facet.name}
          <svg class={chevron} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        {facet.display === "range" ? (
          <fieldset class="px-4 pb-4" data-catalog-facet-display="range">
            <legend class="sr-only">{facet.unit ? `${facet.name} (${facet.unit})` : facet.name}</legend>
            <div class="grid grid-cols-2 gap-3">
              {rangeBounds.map(({ bound, label }) => {
                const id = `${catalogFacetAnchor(facet.slug)}-${bound}`;
                return (
                  <div>
                    <label for={id} class="mb-1.5 block text-sm font-medium text-muted-foreground">{label}</label>
                    <div class="flex items-center gap-2">
                      {/* Plain text with a decimal keypad, like the price: Bangla digits are read as Latin. */}
                      <input
                        id={id}
                        type="text"
                        inputmode="decimal"
                        name={productListRangeKey(facet.slug, bound)}
                        value={facet.applied?.[bound] ?? ""}
                        placeholder={facet.range ? String(facet.range[bound]) : ""}
                        data-catalog-range={bound}
                        class="h-11 w-full min-w-0 rounded-lg border border-border bg-background px-3 text-base text-foreground focus:border-primary focus:ring-2 focus:ring-primary lg:h-10 lg:text-sm"
                      />
                      {facet.unit && <span class="shrink-0 text-sm text-muted-foreground" aria-hidden="true">{facet.unit}</span>}
                    </div>
                  </div>
                );
              })}
            </div>
            {!drawer && (
              <button
                type="submit"
                class="mt-3 hidden min-h-10 w-full items-center justify-center rounded-lg border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted lg:inline-flex"
              >
                Apply<span class="sr-only"> {facet.name}</span>
              </button>
            )}
          </fieldset>
        ) : facet.display === "swatch" ? (
          <fieldset class="px-4 pb-4" data-catalog-facet-display="swatch">
            <legend class="sr-only">{facet.name}</legend>
            <div class="flex flex-wrap gap-2">
              {[...facet.preview, ...facet.more].map(({ value, label, count, selected }) => (
                <label class="catalog-swatch relative inline-flex min-h-11 max-w-full cursor-pointer items-center gap-2 rounded-full border border-border bg-background py-1.5 pl-1.5 pr-3 text-sm text-foreground transition-colors hover:border-foreground/40 has-checked:border-foreground has-checked:ring-1 has-checked:ring-foreground has-focus-visible:ring-2 has-focus-visible:ring-ring has-disabled:cursor-not-allowed has-disabled:opacity-40">
                  <input
                    type="checkbox"
                    name={facet.slug}
                    value={value}
                    checked={selected}
                    disabled={count === 0 && !selected}
                    data-catalog-facet
                    class="peer sr-only"
                  />
                  {/* A value with no known colour keeps an empty (muted) swatch beside its label. */}
                  <span
                    class:list={["h-7 w-7 shrink-0 rounded-full border border-foreground/15", !facet.swatches.has(value) && "bg-muted"]}
                    style={facet.swatches.has(value) ? `background:${facet.swatches.get(value)}` : undefined}
                    aria-hidden="true"
                  ></span>
                  <span class="min-w-0 truncate font-medium">{label}</span>
                  <span class="tabular-nums text-muted-foreground" data-catalog-facet-count>{count}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ) : (
          <fieldset class="space-y-1 px-4 pb-4" data-catalog-facet-list={facet.display === "search-list" ? "" : undefined}>
            <legend class="sr-only">{facet.name}</legend>
            {facet.display === "search-list" && (
              // Shown by JavaScript: without it every value is listed (and
              // the rest folded), so the field would do nothing.
              <div class="relative mb-2" data-catalog-facet-search hidden>
                <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                {/* No name: it narrows the list and is never submitted. */}
                <input
                  type="search"
                  aria-label={`Search ${facet.name}`}
                  placeholder={`Search ${facet.name}`}
                  data-catalog-facet-query
                  class="h-11 w-full rounded-lg border border-border bg-background py-2 pl-9 pr-3 text-base text-foreground focus:border-primary focus:ring-2 focus:ring-primary lg:h-10 lg:text-sm"
                />
                <p class="px-2 pt-2 text-sm text-muted-foreground" data-catalog-facet-search-empty hidden>No matches</p>
              </div>
            )}
            {[facet.preview, facet.more].map((values, group) => {
              const options = values.map(({ value, label, count, selected }) => (
                <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-md px-2 text-sm transition-colors hover:bg-muted has-disabled:cursor-not-allowed has-disabled:opacity-40 has-disabled:hover:bg-transparent">
                  <input
                    type="checkbox"
                    name={facet.slug}
                    value={value}
                    checked={selected}
                    disabled={count === 0 && !selected}
                    data-catalog-facet
                    class="h-4 w-4 rounded border-border text-primary focus:ring-primary"
                  />
                  <span class="min-w-0 flex-1 truncate font-medium text-foreground">{label}</span>
                  <span class="tabular-nums text-sm text-muted-foreground" data-catalog-facet-count>{count}</span>
                </label>
              ));
              return group === 0 ? options : values.length > 0 && (
                <details open={values.some(({ selected }) => selected)} class="group/more">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center px-2 text-sm font-medium text-primary hover:underline [&::-webkit-details-marker]:hidden">
                    <span class="group-open/more:hidden">Show {values.length} more</span>
                    <span class="hidden group-open/more:inline">Show less</span>
                  </summary>
                  {options}
                </details>
              );
            })}
          </fieldset>
        )}
      </details>
    ))}

    {hasActiveFilters && !drawer && (
      <a
        href={resetPath}
        class="hidden min-h-10 w-full items-center justify-center rounded-lg border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted lg:flex"
      >
        Clear all
      </a>
    )}
    {!drawer && (
      <noscript>
        <button
          type="submit"
          class="hidden min-h-10 w-full items-center justify-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground lg:flex"
        >
          Apply filters
        </button>
      </noscript>
    )}
  </div>

  <div
    class:list={[
      "z-50 border-t border-border bg-background p-4 pb-[max(1rem,env(safe-area-inset-bottom))]",
      drawer ? "sticky bottom-0" : "fixed inset-x-0 bottom-0 lg:hidden",
    ]}
  >
    <div class:list={["grid gap-3", hasActiveFilters ? "grid-cols-2" : "grid-cols-1"]}>
      {hasActiveFilters && (
        <a
          href={resetPath}
          class="inline-flex h-12 items-center justify-center rounded-lg border border-border bg-background px-4 text-sm font-semibold text-foreground"
        >
          Clear all
        </a>
      )}
      <button
        type="submit"
        data-catalog-filter-apply
        aria-live="polite"
        disabled={applyButton.disabled}
        class="inline-flex h-12 items-center justify-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground disabled:cursor-not-allowed disabled:opacity-50"
      >
        {applyButton.label}
      </button>
    </div>
  </div>
</form>
