---
import { catalogCopy } from "@/lib/catalog-copy";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { formatCount } from "@/lib/store-time-zone";
import Icon from "@/components/icons/Icon.astro";

interface Props {
  page: number;
  totalPages: number;
  getPageUrl: (page: number) => string;
}

const { page, totalPages, getPageUrl } = Astro.props;
const copy = catalogCopy((await currentRequestTheme(Astro.locals)).language).paging;

function paginationItems(currentPage: number, pageCount: number): (number | "…")[] {
  if (pageCount <= 7) return Array.from({ length: pageCount }, (_, index) => index + 1);
  if (currentPage <= 4) return [1, 2, 3, 4, 5, "…", pageCount];
  if (currentPage >= pageCount - 3) {
    return [1, "…", pageCount - 4, pageCount - 3, pageCount - 2, pageCount - 1, pageCount];
  }
  return [1, "…", currentPage - 1, currentPage, currentPage + 1, "…", pageCount];
}
---

{totalPages > 1 && (
  <nav class="my-8 flex items-center justify-center" aria-label={copy.label} data-catalog-pagination>
    <div class="flex items-center gap-1">
      {page > 1 ? (
        <a
          href={getPageUrl(page - 1)}
          aria-label={copy.previous}
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border text-foreground transition-colors hover:bg-muted"
        >
          <Icon name="chevron-left" class="h-4 w-4" aria-hidden="true" />
        </a>
      ) : (
        <button
          type="button"
          disabled
          aria-label={copy.previous}
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border/60 text-muted-foreground/40"
        >
          <Icon name="chevron-left" class="h-4 w-4" aria-hidden="true" />
        </button>
      )}

      {paginationItems(page, totalPages).map((item) =>
        typeof item === "number" ? (
          <a
            href={getPageUrl(item)}
            aria-label={copy.page(formatCount(item))}
            aria-current={page === item ? "page" : undefined}
            class:list={[
              "inline-flex h-10 min-w-10 items-center justify-center rounded-md border text-sm font-medium transition-colors",
              page === item
                ? "border-primary bg-primary text-primary-foreground shadow-sm"
                : "border-border text-foreground hover:bg-muted max-[389px]:hidden",
            ]}
          >
            {formatCount(item)}
          </a>
        ) : (
          <span aria-hidden="true" class="inline-flex h-10 w-10 items-center justify-center text-sm text-muted-foreground max-[389px]:hidden">{item}</span>
        ),
      )}
      {/* Narrow phones (320-389px) cannot fit seven page links: they show "3 of 33" between the arrows. */}
      <span class="hidden items-center px-1 text-sm text-muted-foreground max-[389px]:inline-flex">{copy.of(formatCount(totalPages))}</span>

      {page < totalPages ? (
        <a
          href={getPageUrl(page + 1)}
          data-catalog-next
          aria-label={copy.next}
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border text-foreground transition-colors hover:bg-muted"
        >
          <Icon name="chevron-right" class="h-4 w-4" aria-hidden="true" />
        </a>
      ) : (
        <button
          type="button"
          disabled
          aria-label={copy.next}
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border/60 text-muted-foreground/40"
        >
          <Icon name="chevron-right" class="h-4 w-4" aria-hidden="true" />
        </button>
      )}
    </div>
  </nav>
)}
