---
// The body of every listing page (category, collection, brand, search): the
// category banner when the theme asks for it, the listing (CatalogListing,
// which opens with the compact title band), the short description where the
// merchant chose, and the guide below results. Pages keep their own data
// reads, SEO (canonical, robots, JSON-LD) and analytics; everything a buyer
// sees between the site header and footer is decided here, once.
//
// The default keeps products near the title band; a merchant can put a
// clamped short description above them when that helps explain the category.
// The collection template's own sections (`pages.templates.collection`) sit
// above and below the whole listing on category, collection and brand pages.
import type { ComponentProps } from "astro/types";
import RichContent from "@/components/RichContent.astro";
import Container from "@/components/ui/Container.astro";
import CatalogDescription from "./CatalogDescription.astro";
import CatalogListing from "./CatalogListing.astro";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { THEME_EDITOR_MARKS } from "@scalius/shared/theme-editor-bridge";
import { catalogCountText } from "@/lib/catalog-paging";
import { hasRenderableHtmlContent } from "@scalius/shared/html-sanitize";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import TemplateSections from "@/components/homepage/TemplateSections.astro";
import { getLayoutData } from "@/lib/api";
import { templateSectionData } from "@/lib/template-sections";

type ListingProps = ComponentProps<typeof CatalogListing>;

interface Props {
  kind: "category" | "collection" | "brand" | "search";
  listing: Omit<ListingProps, "band" | "pills">;
  hero: {
    title: string;
    /** Published ancestors (Home comes first); the title is the current page. */
    breadcrumb?: Array<{ label: string; href: string }>;
    /** Rich-text description; shown on the first page only (the page decides). */
    description?: string | null;
    /** The band's count line (defaults to "N products"). */
    countLabel?: string | null;
    /** Products in the listing. */
    count: number;
    /** `count` is a lower bound (the API counts to a cap): "1,000+ products". */
    countCapped?: boolean;
    /** The category banner (Apple Gadgets), shown when the toolbar has `category-banner`. */
    banner?: { src: string; srcset?: string; alt: string } | null;
    /** Links shown as pills above the results (a collection's categories). */
    links?: Array<{ label: string; href: string }>;
  };
  /** The merchant's guide below the listing (unfiltered views only; the page decides). */
  content?: { html: string; label: string } | null;
  /** `data-*` attributes on the page root (analytics reads them). */
  data?: Record<`data-${string}`, string | undefined>;
  /** Draws the collection template's sections (category, collection and brand pages; not search). */
  template?: boolean;
}

const { kind, listing, hero, content, data = {}, template } = Astro.props;
const requestTheme = await currentRequestTheme(Astro.locals);
const { resolved, preview } = requestTheme;
const collectionTemplate = template ? resolved.pages.templates.collection : null;
const templateData = template ? await templateSectionData("collection", requestTheme) : null;
const currency = template ? (await getLayoutData())?.currency ?? DEFAULT_CURRENCY : DEFAULT_CURRENCY;
const toolbar = new Set(resolved.blocks.listing.toolbar);
const banner = toolbar.has("category-banner") ? hero.banner : null;
const countLabel = hero.countLabel === undefined
  ? `${catalogCountText(hero.count, hero.countCapped)} ${hero.count === 1 && !hero.countCapped ? "product" : "products"}`
  : hero.countLabel;
const breadcrumb = kind === "search" ? null : [{ label: "Home", href: "/" }, ...(hero.breadcrumb ?? [])];
const description = hero.description && hasRenderableHtmlContent(hero.description) ? hero.description : null;
const guide = content && hasRenderableHtmlContent(content.html) ? content : null;
const { descriptionPlacement, surface, phoneBanner } = resolved.blocks.listing;
const descriptionAbove = descriptionPlacement === "above";
// The page behind the results (Dawn: the page colour). The side gutters are
// the container's: the cards line up with the header and the title.
const SURFACE_CLASS: Record<typeof surface, string> = { page: "bg-background", muted: "bg-muted/30" };
---

{collectionTemplate && (
  <TemplateSections template={collectionTemplate} region="before" data={templateData} currencySymbol={currency.symbol} currencyCode={currency.code} preview={preview !== null} />
)}
<div class:list={["min-h-screen", SURFACE_CLASS[surface]]} {...data} data-theme-section-id={preview ? THEME_EDITOR_MARKS.listing : undefined}>
  <Container class="pb-8 pt-1">
    {banner && (
      <img
        src={banner.src}
        srcset={banner.srcset}
        sizes="(max-width: 1279px) 100vw, 1216px"
        alt={banner.alt}
        width="1344"
        height="296"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        data-catalog-banner
        class:list={["mt-3 aspect-[3/1] w-full rounded-2xl bg-muted object-cover sm:aspect-[1344/296]", !phoneBanner && "hidden sm:block"]}
      />
    )}
    <slot name="intro" />
    <CatalogListing
      {...listing}
      kind={kind}
      band={{ title: hero.title, breadcrumb, countLabel }}
      pills={(hero.links ?? []).map((link) => ({ id: link.href, label: link.label, href: link.href }))}
    >
      {description && descriptionAbove && (
        <section slot="description" class="mb-4" aria-label={`About ${hero.title}`} data-catalog-content="above">
          <CatalogDescription content={description} name={hero.title} clamp />
        </section>
      )}
      <slot name="empty" slot="empty" />
    </CatalogListing>

    {((description && !descriptionAbove) || guide) && (
      <section
        class="mx-auto mt-10 max-w-4xl space-y-6 border-t border-border pt-8 sm:mt-12 sm:pt-10"
        aria-label={guide?.label ?? `About ${hero.title}`}
        data-catalog-content="below"
      >
        {description && !descriptionAbove && <CatalogDescription content={description} name={hero.title} />}
        {guide && (
          <RichContent
            content={guide.html}
            className="prose-sm sm:prose-base prose-headings:scroll-mt-24"
            processShortcodes={false}
          />
        )}
      </section>
    )}
  </Container>
</div>
{collectionTemplate && (
  <TemplateSections template={collectionTemplate} region="after" data={templateData} currencySymbol={currency.symbol} currencyCode={currency.code} preview={preview !== null} />
)}
