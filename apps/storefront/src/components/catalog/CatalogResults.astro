---
// A listing's products: the theme's card in the fluid grid, one product per
// row (list), or Chaldal's dense quick-add grid. The frame carries
// `data-catalog-results` for the paging script (appends the next page's
// cards) and the list styles; the grid/list toggle's stored choice is
// applied by an inline script as soon as the result grid has parsed.
import type { Product } from "@/lib/api";
import ProductCard from "@/components/cards/ProductCard.astro";
import ProductGrid from "@/components/cards/ProductGrid.astro";
import { buildStorefrontThemeTokens } from "@scalius/shared/storefront-theme";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import {
  productCardImageSizes,
  productGridFluidCss,
  productGridSpec,
  type ProductGridContext,
  type ProductGridPhoneLayout,
} from "@/lib/product-card-layout";
import { LIST_ROW_IMAGE_SIZES, quickGridSpec } from "@/lib/catalog-listing";
import { catalogViewStorageKey } from "@/lib/catalog-paging";

interface Props {
  products: Product[];
  results: "grid" | "list" | "quick";
  kind: "search" | "browse";
  phoneLayout: ProductGridPhoneLayout;
  context: ProductGridContext;
  /**
   * The filter column this page actually renders beside the grid (px; its
   * listing template can override the theme's filter style), for image sizes.
   */
  filterColumnPx?: number;
  /** A full-width search can fit one more card than the category sidebar. */
  maxColumns?: number;
  /** The grid/list toggle is on: restore the buyer's stored view. */
  restoreView: boolean;
  /** Mark the frame for the paging and toggle scripts (list and quick grids always are). */
  marked: boolean;
  currencySymbol: string;
  currencyCode: string;
}

const { products, results, kind, phoneLayout, context, filterColumnPx = 0, maxColumns: columns, restoreView, marked, currencySymbol, currencyCode } = Astro.props;
const { resolved, theme, layout } = await currentRequestTheme(Astro.locals);
// The page's own cap (a full-width search), else the listing's (Target's
// four roomy columns), else the card's: Star Tech's and the mall's tiles cap at four.
const maxColumns = columns
  ?? resolved.blocks.listing.maxColumns
  ?? (["spec", "mall"].includes(resolved.blocks.card.variant) ? 4 : undefined);
// Only a grid beside the filters loses their column.
const columnPx = context === "beside-filters" ? filterColumnPx : 0;

let sizes: string | undefined;
let style: string | undefined;
if (results === "list") {
  // The same cards may become a grid without a reload; keep their source
  // candidates sized for that wider photo when the buyer has the switch.
  sizes = restoreView ? undefined : LIST_ROW_IMAGE_SIZES;
} else if (results === "quick") {
  const grid = quickGridSpec(productGridSpec(layout.grid, theme.tokens.imageRatio));
  const fluid = productGridFluidCss(grid);
  sizes = restoreView ? LIST_ROW_IMAGE_SIZES : productCardImageSizes(grid, buildStorefrontThemeTokens(theme)["theme-container-width"]!, context, "grid", Infinity, columnPx);
  style = [
    `--theme-card-min-phone:${grid.cardMin.phone}`,
    `--theme-card-min-tablet:${grid.cardMin.tablet}`,
    `--theme-card-min-desktop:${grid.cardMin.desktop}`,
    `--theme-grid-gap-phone:${grid.gap.phone}`,
    `--theme-grid-gap-desktop:${grid.gap.desktop}`,
    `--grid-card-min-fluid:${fluid.cardMin}`,
    `--grid-gap-fluid:${fluid.gap}`,
  ].join(";");
}
// Merchant phone rows stay the default. A saved or clicked Grid choice
// removes that row marker so the buyer gets columns on phones too.
const gridPhoneLayout = results === "grid" ? phoneLayout : "grid";
const viewStorageKey = catalogViewStorageKey(kind);
const restoreScript = `(function(s){try{var f=s.previousElementSibling,v=localStorage.getItem(${JSON.stringify(viewStorageKey)});if(v==="grid"||v==="list"){f.setAttribute("data-catalog-results",v);if(v==="grid")f.querySelector(".product-grid").removeAttribute("data-phone-layout")}}catch(e){}})(document.currentScript)`;
---

<ProductGrid class="mb-8" phoneLayout={gridPhoneLayout} data-catalog-results={restoreView && results === "quick" ? "grid" : marked || results !== "grid" ? results : undefined} data-catalog-kind={kind} data-catalog-view-storage-key={restoreView ? viewStorageKey : undefined} data-catalog-grid-columns={maxColumns ? String(maxColumns) : undefined} data-catalog-card={["tech-rounded", "portrait", "spec", "mall"].includes(resolved.blocks.card.variant) ? resolved.blocks.card.variant : undefined} style={style}>
  {products.map((product, index) => (
    <ProductCard
      product={product}
      currencySymbol={currencySymbol}
      currencyCode={currencyCode}
      index={index}
      aboveFold
      context={context}
      filterColumnPx={columnPx}
      phoneLayout={restoreView ? "grid" : gridPhoneLayout}
      sizes={sizes}
      maxColumns={maxColumns}
      headingLevel="h2"
    />
  ))}
</ProductGrid>
{restoreView && <script is:inline set:html={restoreScript} />}
