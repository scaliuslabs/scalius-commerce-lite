---
// The applied filters as removable chips. A facet value reads by its label
// ("Brand: Samsung", not the URL value "samsung"); a range facet is one chip
// ("Display size: 13–15.6 in") that removes both of its bounds.
import type { ProductFacet } from "@/lib/api";
import {
  PRODUCT_LIST_MIN_RATING_PARAM,
  buildProductListHref,
  parseProductListRangeKey,
  productListRangeKey,
  type ProductListFilterState,
  type ProductListSort,
} from "@/lib/product-list-query";
import { formatMoney } from "@/lib/currency";
import { X } from "lucide-react";

interface Props {
  facets: ProductFacet[];
  currentFilters: ProductListFilterState;
  pathname: string;
  resetPath: string;
  defaultSort: ProductListSort;
  currencySymbol: string;
  currencyCode: string;
}

const { facets, currentFilters, pathname, resetPath, defaultSort, currencySymbol, currencyCode } =
  Astro.props;
const money = (amount: string) =>
  formatMoney(Number(amount), { symbol: currencySymbol, code: currencyCode });

const navigationKeys = new Set(["page", "sortBy", "limit", "showAll"]);
const priceKeys = new Set(["minPrice", "maxPrice"]);
const booleanLabels: Record<string, string> = {
  hasDiscount: "On sale",
  freeDelivery: "Free delivery",
  inStock: "In stock",
};
const facetsBySlug = new Map(facets.map((facet) => [facet.slug, facet]));
const valueLabel = (key: string, value: string) =>
  facetsBySlug.get(key)?.values.find((candidate) => candidate.value === value)?.label ?? value;
const single = (key: string) => {
  const value = currentFilters[key];
  return Array.isArray(value) ? value.at(-1) : value;
};

type AppliedFilter = {
  key: string;
  label: string;
  href: string;
};

function withoutFilterValue(key: string, value?: string): string {
  const nextFilters: ProductListFilterState = { ...currentFilters };
  delete nextFilters.page;

  if (value === undefined) {
    delete nextFilters[key];
  } else {
    const current = nextFilters[key];
    const remaining = (Array.isArray(current) ? current : [current]).filter(
      (candidate): candidate is string =>
        Boolean(candidate) && candidate !== value,
    );
    if (remaining.length > 0) nextFilters[key] = remaining;
    else delete nextFilters[key];
  }

  return buildProductListHref({ pathname, currentFilters: nextFilters, defaultSort });
}

/** One chip for a range facet's bounds; removing it removes both. */
function rangeFilter(facet: ProductFacet): AppliedFilter {
  const minKey = productListRangeKey(facet.slug, "min");
  const maxKey = productListRangeKey(facet.slug, "max");
  const min = single(minKey);
  const max = single(maxKey);
  const unit = facet.unit ? ` ${facet.unit}` : "";
  const bounds = min && max ? `${min}–${max}${unit}` : min ? `From ${min}${unit}` : `Up to ${max}${unit}`;
  const nextFilters = { ...currentFilters };
  delete nextFilters.page;
  delete nextFilters[minKey];
  delete nextFilters[maxKey];
  return {
    key: `range:${facet.slug}`,
    label: `${facet.name}: ${bounds}`,
    href: buildProductListHref({ pathname, currentFilters: nextFilters, defaultSort }),
  };
}

const appliedFilters: AppliedFilter[] = [];
const rangesShown = new Set<string>();

for (const [key, rawValue] of Object.entries(currentFilters)) {
  if (navigationKeys.has(key) || priceKeys.has(key)) continue;
  const range = parseProductListRangeKey(key);
  const rangeFacet = range ? facetsBySlug.get(range.slug) : undefined;
  if (range && rangeFacet?.display === "range") {
    if (!rangesShown.has(range.slug)) appliedFilters.push(rangeFilter(rangeFacet));
    rangesShown.add(range.slug);
    continue;
  }
  if (key === PRODUCT_LIST_MIN_RATING_PARAM) {
    const stars = single(key);
    if (stars) appliedFilters.push({ key: `${key}:${stars}`, label: `${stars}★ & up`, href: withoutFilterValue(key) });
    continue;
  }
  const values = Array.isArray(rawValue) ? rawValue : [rawValue];
  const groupLabel = booleanLabels[key] ?? facetsBySlug.get(key)?.name ?? key;

  for (const value of values) {
    if (!value) continue;
    appliedFilters.push({
      key: `${key}:${value}`,
      label:
        key === "q"
          ? `Search: “${value}”`
          : booleanLabels[key] ?? `${groupLabel}: ${valueLabel(key, value)}`,
      href: withoutFilterValue(
        key,
        key === "q" || booleanLabels[key] ? undefined : value,
      ),
    });
  }
}

const minPrice = single("minPrice");
const maxPrice = single("maxPrice");

if (minPrice || maxPrice) {
  const priceLabel =
    minPrice && maxPrice
      ? `${money(minPrice)}–${money(maxPrice)}`
      : minPrice
        ? `From ${money(minPrice)}`
        : `Up to ${money(maxPrice!)}`;
  const nextFilters = { ...currentFilters };
  delete nextFilters.page;
  delete nextFilters.minPrice;
  delete nextFilters.maxPrice;
  appliedFilters.unshift({
    key: "price",
    label: `Price: ${priceLabel}`,
    href: buildProductListHref({ pathname, currentFilters: nextFilters, defaultSort }),
  });
}
---

{
  appliedFilters.length > 0 && (
    <nav
      aria-label="Applied filters"
      class="mb-4 flex items-center gap-2 overflow-x-auto pb-1 lg:flex-wrap"
    >
      {appliedFilters.map((filter) => (
        <a
          href={filter.href}
          class="inline-flex min-h-9 shrink-0 items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:border-primary/40 hover:bg-muted"
          aria-label={`Remove ${filter.label} filter`}
        >
          <span>{filter.label}</span>
          <X className="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      ))}
      {appliedFilters.length > 1 && (
        <a
          href={resetPath}
          class="inline-flex min-h-9 shrink-0 items-center px-1 text-sm font-medium text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
        >
          Clear all
        </a>
      )}
    </nav>
  )
}
