---
// The shared product listing body for /search, categories, collections and
// brands, laid out by the theme's listing template (lib/catalog-listing.ts)
// or the listing's own `listing_template`.
//
// Top to bottom: the compact title band (breadcrumb, h1, result count and
// the view controls on one line), the phone bar (Filters, Sort), the
// sub-category pills, then the facets where the filter style places them
// (an open column beside the results, a dropdown bar above them, or a
// drawer) and the results (grid, list rows, shelves on the plain first
// page, Chaldal's quick-add grid). Filters are a GET form, so they work
// without JavaScript.
import "./catalog-listing.css";
import type { BuyerPriceRange, Product, ProductFacet, RatingFacetValue } from "@/lib/api";
import AppliedCatalogFilters from "./AppliedCatalogFilters.astro";
import CatalogAspectChips from "./CatalogAspectChips.astro";
import CatalogBandTools from "./CatalogBandTools.astro";
import CatalogBreadcrumb from "./CatalogBreadcrumb.astro";
import CatalogChipLinks from "./CatalogChipLinks.astro";
import CatalogFilters from "./CatalogFilters.astro";
import CatalogPaging from "./CatalogPaging.astro";
import CatalogResults from "./CatalogResults.astro";
import CatalogShelves from "./CatalogShelves.astro";
import CatalogViewSelect from "./CatalogViewSelect.astro";
import CatalogViewToggle from "./CatalogViewToggle.astro";
import { catalogViewStorageKey } from "@/lib/catalog-paging";
import {
  DEFAULT_PRODUCT_LIST_PAGE_SIZE,
  PRODUCT_LIST_SHOW_ALL_PARAM,
  buildProductListHref,
  countActiveProductListFilters,
  type ProductListQueryState,
} from "@/lib/product-list-query";
import {
  catalogFacetGroups,
  catalogFacetValueCounts,
  catalogRatingRows,
  showsCatalogPriceFilter,
  visibleCatalogFacets,
} from "@/lib/catalog-filters";
import {
  catalogAspectChips,
  catalogFacetValueChips,
  catalogCardContext,
  catalogCategoryFacetLinks,
  catalogListingControls,
  catalogListingPresentation,
  catalogPopularFilters,
  catalogQuickFilters,
  catalogShelves,
  type CatalogListingLink,
} from "@/lib/catalog-listing";
import { STOREFRONT_FILTER_VALUES_IN_HTML } from "@scalius/shared/storefront-theme";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { THEME_EDITOR_MARKS } from "@scalius/shared/theme-editor-bridge";
import Icon from "@/components/icons/Icon.astro";

export interface CatalogBand {
  title: string;
  /** Home, then the published ancestors (the current page is the h1). */
  breadcrumb?: Array<{ label: string; href: string }> | null;
  /** "3,780 products", or a search's own count line. */
  countLabel?: string | null;
}

interface Props {
  kind?: "category" | "collection" | "brand" | "search";
  products: Product[];
  /** Extra bounded child samples for a category shelf landing. */
  shelfProducts?: Product[];
  pagination: { page: number; totalPages: number; total: number; totalIsCapped?: boolean };
  facets: ProductFacet[];
  /** "N★ & up" rows of the listing's scope (the API's `ratingFacet`). */
  ratingFacet?: RatingFacetValue[];
  priceRange?: BuyerPriceRange;
  queryState: ProductListQueryState;
  pathname: string;
  resetPath: string;
  searchLabel: string;
  /** Label of the default "newest" order ("Latest", or "Featured" for curated collections). */
  newestLabel?: string;
  /** Product-list API path used for the live "Show N products" count and "See more". */
  countEndpoint: string;
  currencySymbol: string;
  currencyCode: string;
  /** The listing's name, for the shelf of products outside every sub-listing. */
  listingName?: string;
  /** Sub-listings: sub-category pills, and the shelves of the shelves layout. */
  subListings?: CatalogListingLink[];
  /** Links always shown as pills (a collection's categories). */
  pills?: CatalogListingLink[];
  /** The listing's own `listing_template` (category, collection or brand). */
  listingTemplate?: string | null;
  band: CatalogBand;
}

const {
  kind,
  products,
  shelfProducts = [],
  pagination,
  facets,
  ratingFacet = [],
  priceRange,
  queryState,
  pathname,
  resetPath,
  searchLabel,
  newestLabel = "Latest",
  countEndpoint,
  currencySymbol,
  currencyCode,
  listingName = "this listing",
  subListings = [],
  pills = [],
  listingTemplate = null,
  band,
} = Astro.props;
const { currentFilters, sortBy, defaultSort, query, limit } = queryState;
const { resolved, preview } = await currentRequestTheme(Astro.locals);
const listingPresentation = catalogListingPresentation(resolved, listingTemplate);
// The listing's page chrome (blocks.listing): band, phone bar, link style.
const { band: bandStyle, phoneBar, links } = resolved.blocks.listing;
// A search can spend the results width on products (Star Tech): a sidebar's
// facets move into the drawer; category pages keep the column.
const specSearch = kind === "search" && listingPresentation.filters.placement === "sidebar" && listingPresentation.filters.searchPlacement === "drawer";
const presentation = specSearch
  ? { ...listingPresentation, filters: { ...listingPresentation.filters, placement: "drawer" as const, columnPx: 0 } }
  : listingPresentation;
const specSearchShowsQuery = specSearch && Boolean(query) && resolved.blocks.header.variant === "spec-two-row";
const results = kind === "search" && query && resolved.blocks.listing.searchLayout !== "same"
  ? resolved.blocks.listing.searchLayout
  : presentation.results;
const piece = (name: Parameters<typeof presentation.toolbar.has>[0]) => presentation.toolbar.has(name);
const placement = presentation.filters.placement;
const drawer = placement === "drawer";
// Dawn's band: the title alone, then the count and controls over the facet bar.
const boutiqueBar = bandStyle === "inline" && placement === "bar";
// Target's phone row: a Filter pill, sort and the quick and popular chips.
const massRetailPhoneBar = phoneBar === "pill-row";

// Filters beyond the search itself (a search is undone by its chip).
const refinementCount = countActiveProductListFilters(currentFilters) - (query ? 1 : 0);
const shownFacets = visibleCatalogFacets(facets, currentFilters);
const filterFacets = shownFacets.filter((facet) => facet.kind !== "category");
const showsPrice = showsCatalogPriceFilter(priceRange, currentFilters);
// Reviews show only once the store has a published review (and reviews are on).
const hasReviews = resolved.facts.hasReviews;
const ratingRows = catalogRatingRows(ratingFacet, currentFilters, hasReviews);
// The small-catalogue rule: sort needs two results, filters eight and a
// facet (or the price) with two values; either stays while the buyer needs
// it to undo a refinement.
const controls = catalogListingControls({
  total: pagination.total,
  refinementCount,
  facetValueCounts: [
    ...catalogFacetValueCounts(shownFacets, showsPrice ? priceRange : undefined),
    ratingRows.filter(({ count }) => count > 0).length,
  ],
  storeShown: resolved.blocks.listing.filters.shown,
});
const showSort = controls.sort && piece("sort");
const showFilters = controls.filters;
// Fabrilife: a ruled rail.
const ruledRail = showFilters && placement === "sidebar" && presentation.filters.ruled;
// Star Tech: the breadcrumb above, the title band in the results column beside the facets.
const specRail = bandStyle === "beside-filters" && (placement === "sidebar" || specSearch);
// Amazon and Daraz: the phone's chip row, the facets in a split sheet.
const marketplacePhoneFilters = phoneBar === "split-sheet" && showFilters;
const sortOptions = [
  ...(defaultSort === "relevance" ? [{ value: "relevance", label: "Best match" }] : []),
  { value: "newest", label: newestLabel },
  { value: "price-asc", label: "Price: Low to High" },
  { value: "price-desc", label: "Price: High to Low" },
  { value: "name-asc", label: "Name: A to Z" },
  { value: "name-desc", label: "Name: Z to A" },
  { value: "discount", label: "Biggest discount" },
  // Amazon's "Avg. Customer Review": offered once the store has reviews.
  ...(hasReviews || sortBy === "rating" ? [{ value: "rating", label: "Top rated" }] : []),
];
const viewSelect = { pathname, defaultSort, currentFilters };
// More than one page, or a size the buyer chose: the page size helps.
const showPageSize = piece("per-page") && (pagination.total > limit || limit !== DEFAULT_PRODUCT_LIST_PAGE_SIZE);
const pageUrl = (page: number) =>
  buildProductListHref({ pathname, currentFilters, overrides: { page, [PRODUCT_LIST_SHOW_ALL_PARAM]: null }, defaultSort });

// Sub-category pills (Star Tech): the children that still hold products
// (the category facet names them), else every child; a collection's own
// category links always show.
const categoryFacet = shownFacets.find((facet) => facet.kind === "category");
const liveChildren = categoryFacet ? new Set(categoryFacet.values.filter(({ count }) => count > 0).map(({ value }) => value)) : null;
const childPills = piece("subcategory-pills") && subListings.length > 1
  ? subListings.filter((link) => !liveChildren || liveChildren.has(decodeURIComponent(link.href.split("/").at(-1) ?? "")))
  : [];
const showcaseTabs = links === "tabs" && kind !== "search";
const searchPills = specRail && kind === "search" && categoryFacet
  ? catalogCategoryFacetLinks(categoryFacet, currentFilters)
      .filter((link) => link.href)
      .slice(0, STOREFRONT_FILTER_VALUES_IN_HTML)
      .map((link) => ({ id: link.href, label: link.label, href: link.href }))
  : [];
const rawPillLinks = showcaseTabs && !piece("subcategory-pills") ? [] : pills.length > 0 ? pills : childPills.length > 1 ? childPills : searchPills;
const pillLinks = showcaseTabs && rawPillLinks.length > 1
  ? [{ id: "all", label: "All", href: pathname, active: true }, ...rawPillLinks]
  : rawPillLinks;
const pillLabel = pills.length > 0 || searchPills.length > 0 ? "Categories" : "Sub-categories";

const groups = catalogFacetGroups(shownFacets, {
  valuesInHtml: STOREFRONT_FILTER_VALUES_IN_HTML,
  showAll: typeof currentFilters[PRODUCT_LIST_SHOW_ALL_PARAM] === "string" ? currentFilters[PRODUCT_LIST_SHOW_ALL_PARAM] as string : null,
});
const aspectChips = piece("aspect-chips") && showFilters
  ? catalogAspectChips(filterFacets, {
      shown: showsPrice,
      applied: Boolean(currentFilters.minPrice || currentFilters.maxPrice),
    })
  : [];
const popularFilters = piece("popular-filter-chips") && products.length > 0
  ? catalogPopularFilters({ facets: filterFacets, currentFilters, pathname, defaultSort, total: pagination.total })
  : [];
const facetValueChips = piece("facet-value-chips")
  ? catalogFacetValueChips({ facets: filterFacets, currentFilters, pathname, defaultSort })
  : null;
// Aspect chips share the phone bar's line when there is one.
const phoneChips = aspectChips.length > 0 && showFilters;
const quickFilters = (drawer || marketplacePhoneFilters || massRetailPhoneBar) && showFilters ? catalogQuickFilters({ currentFilters, pathname, defaultSort }) : [];

// Shelves are a browse landing: the plain first page, never a filtered,
// sorted or later page (those list products in the grid).
const landing = pagination.page === 1 && refinementCount === 0 && !query && sortBy === defaultSort;
const shelves = presentation.shelves && landing
  ? catalogShelves({
      groups: subListings,
      items: shelfProducts.length > 0 ? shelfProducts : products,
      maxShelves: presentation.maxShelves,
      restTitle: `More from ${listingName}`,
    })
  : [];
const showViewToggle = piece("grid-list-toggle") && (products.length > 1 || (shelves.length > 0 && shelfProducts.length > 1));
const shelfViewStorageKey = catalogViewStorageKey(kind === "search" ? "search" : "browse");
const shelfRestoreScript = `(function(s){try{var f=s.previousElementSibling,v=localStorage.getItem(${JSON.stringify(shelfViewStorageKey)});if(v==="grid"||v==="list")f.setAttribute("data-catalog-results",v)}catch(e){}})(document.currentScript)`;
const phoneDefaultView = results === "list" || (results !== "quick" && presentation.phoneLayout === "list-row") ? "list" : "grid";
const showPhoneBar = showSort || showFilters || showViewToggle;
const paging = shelves.length > 0 ? "numbered" : presentation.paging;
const countLabel = piece("result-count") ? band.countLabel : null;
const breadcrumbVisible = piece("breadcrumb");
const visibleBreadcrumb = breadcrumbVisible && Boolean(band.breadcrumb?.length);
const bandTools = {
  drawerButton: drawer && showFilters,
  refinementCount,
  quickFilters,
  showPageSize,
  showSort,
  showViewToggle,
  limit,
  sortBy,
  sortOptions,
  viewSelect,
  results,
};
---

{specRail && band.breadcrumb && (
  <CatalogBreadcrumb crumbs={band.breadcrumb} current={band.title} hidden={!breadcrumbVisible} showCurrent={false} class="mb-3 py-3" />
)}

{!specRail && <div
  class="catalog-band"
  data-catalog-band
  data-placement={placement}
  data-boutique-bar={boutiqueBar ? "" : undefined}
>
  <div class="catalog-band-heading">
    {band.breadcrumb && <CatalogBreadcrumb crumbs={band.breadcrumb} current={band.title} hidden={!breadcrumbVisible} />}
    <h1 class="catalog-band-title">{band.title}</h1>
    {countLabel && (!boutiqueBar || !showPhoneBar) && <p class="catalog-band-count" aria-live="polite">{countLabel}</p>}
  </div>
  {!boutiqueBar && <CatalogBandTools {...bandTools} />}
</div>}

{specRail && <CatalogChipLinks label={pillLabel} links={pillLinks} class={specSearch ? "catalog-spec-pills catalog-spec-search-pills mb-2 pb-1" : "catalog-spec-pills mb-3 pb-1"} />}

{showPhoneBar && (
  <div
    class:list={[
      specSearch ? "z-30 mb-2 bg-background lg:hidden" : "sticky z-30 mb-3 bg-background/95 backdrop-blur lg:hidden",
      marketplacePhoneFilters ? "catalog-marketplace-phone-bar top-0" : "top-[calc(var(--header-height,3.5rem)+0.5rem)]",
      boutiqueBar && "catalog-boutique-phone-bar",
      massRetailPhoneBar && "catalog-mass-retail-phone-bar catalog-chip-row -mx-4 flex items-center gap-2 overflow-x-auto px-4 py-1",
      // eBay's phone row: Filters, sort and one chip per facet on one
      // scrolling line, so the results start one row higher.
      boutiqueBar ? "flex items-center gap-2" : !marketplacePhoneFilters && !massRetailPhoneBar && (phoneChips || showViewToggle)
        ? "catalog-chip-row -mx-4 flex items-center gap-2 overflow-x-auto px-4 py-1"
        : !marketplacePhoneFilters && !massRetailPhoneBar && ["-mx-1 grid gap-2 rounded-xl p-1", showFilters && showSort ? "grid-cols-2" : "grid-cols-1"],
    ]}
    data-catalog-phone-bar
  >
    {marketplacePhoneFilters ? (
      <Fragment>
        <div class="catalog-marketplace-phone-controls catalog-chip-row">
          <button
            type="button"
            id="mobile-filter-toggle"
            aria-controls="filter-section"
            aria-expanded="false"
            class="catalog-marketplace-filter-toggle relative flex min-h-11 shrink-0 items-center justify-center rounded-full border border-border bg-background px-3 py-2 text-sm font-semibold text-foreground shadow-sm"
          >
            <Icon name="sliders-horizontal" class="h-4 w-4" />
            <span class="sr-only">Filters</span>
            {refinementCount > 0 && (
              <span class="absolute -inset-e-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1 text-xs text-primary-foreground">
                {refinementCount}
              </span>
            )}
          </button>
          {showSort && <CatalogViewSelect id="sortByMobile" name="sortBy" variant="compact" options={sortOptions} selected={sortBy} {...viewSelect} />}
          {showViewToggle && <CatalogViewToggle defaultView={phoneDefaultView} mobile />}
          {quickFilters.map((link) => (
            <a
              href={link.href}
              aria-current={link.active ? "true" : undefined}
              class:list={["catalog-marketplace-quick-filter", link.active && "is-active"]}
            >{link.label}</a>
          ))}
          {phoneChips && <CatalogAspectChips chips={aspectChips} inline />}
        </div>
      </Fragment>
    ) : massRetailPhoneBar ? (
      <Fragment>
        {showFilters && (
          <button
            type="button"
            id="mobile-filter-toggle"
            aria-controls="filter-section"
            aria-expanded="false"
            class="relative inline-flex min-h-11 shrink-0 items-center justify-center gap-1.5 rounded-full border border-border bg-background px-3 text-sm font-semibold text-foreground"
          >
            <Icon name="sliders-horizontal" class="h-4 w-4" />
            <span>Filter</span>
            {refinementCount > 0 && (
              <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1 text-xs text-primary-foreground">
                {refinementCount}<span class="sr-only"> applied</span>
              </span>
            )}
          </button>
        )}
        {showSort && <CatalogViewSelect id="sortByMobile" name="sortBy" variant="compact" options={sortOptions} selected={sortBy} {...viewSelect} />}
        {showViewToggle && <CatalogViewToggle defaultView={phoneDefaultView} mobile />}
        <CatalogChipLinks label="Product filters" links={[...quickFilters, ...popularFilters]} inline />
      </Fragment>
    ) : (
      <Fragment>
        {showFilters && (
          <button
            type="button"
            id="mobile-filter-toggle"
            aria-controls="filter-section"
            aria-expanded="false"
            class:list={[
              "relative flex min-h-11 shrink-0 items-center justify-center gap-2 border border-border bg-background px-3 py-2 text-sm font-semibold text-foreground shadow-sm",
              phoneChips ? "rounded-full" : "rounded-lg",
              boutiqueBar && "catalog-boutique-filter-toggle",
            ]}
          >
            <Icon name="sliders-horizontal" class="h-4 w-4" />
            <span>Filters</span>
            {refinementCount > 0 && (
              <span class="absolute -inset-e-1 -top-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1 text-xs text-primary-foreground">
                {refinementCount}
              </span>
            )}
          </button>
        )}
        {showSort && <CatalogViewSelect id="sortByMobile" name="sortBy" variant="compact" options={sortOptions} selected={sortBy} {...viewSelect} />}
        {showViewToggle && <CatalogViewToggle defaultView={phoneDefaultView} mobile />}
        {phoneChips && <CatalogAspectChips chips={aspectChips} inline />}
        {countLabel && boutiqueBar && <p class="catalog-band-count ms-auto shrink-0">{countLabel}</p>}
      </Fragment>
    )}
  </div>
)}

{!specRail && <CatalogChipLinks label={pillLabel} links={pillLinks} class={showcaseTabs && pillLinks.length > 1 ? "catalog-showcase-tabs mb-3" : "mb-3 pb-1"} />}
{!phoneChips && <CatalogAspectChips chips={aspectChips} />}
<CatalogChipLinks label="Popular filters" links={popularFilters} class={massRetailPhoneBar ? "catalog-mass-retail-desktop-chips mb-3 pb-1" : "mb-3 pb-1"} />

<div class:list={["flex flex-col", placement === "sidebar" ? "gap-6 lg:flex-row" : "gap-3"]} data-catalog-layout={placement} data-catalog-kind={kind} data-catalog-rail={ruledRail ? "fashion" : undefined} data-catalog-boutique={boutiqueBar ? "" : undefined}>
  {showFilters && (
    <aside
      id="filter-section"
      data-theme-section-id={preview ? THEME_EDITOR_MARKS.listingFilters : undefined}
      aria-labelledby="mobile-filter-title"
      data-catalog-dialog={drawer ? "drawer" : undefined}
      data-marketplace-filter-rail={marketplacePhoneFilters ? "" : undefined}
      data-placement={placement}
      style={presentation.filters.styleVars || undefined}
      class:list={[
        "fixed inset-0 z-60 hidden bg-black/50",
        !drawer && "lg:static lg:z-auto lg:block lg:shrink-0 lg:bg-transparent",
      ]}
    >
      <div
        class:list={[
          "filter-sheet flex max-h-[88dvh] w-full flex-col rounded-t-2xl bg-background text-foreground",
          drawer
            ? "lg:h-full lg:max-h-none lg:w-[22.5rem] lg:max-w-[calc(100vw-3rem)] lg:rounded-none lg:shadow-xl"
            : "lg:max-h-none lg:rounded-none lg:bg-transparent",
        ]}
      >
        <div class:list={["flex items-center justify-between border-b border-border bg-background p-4", !drawer && "lg:hidden"]}>
          {/* A label, not a heading: on some layouts the filters come before the page title in the source. */}
          <p id="mobile-filter-title" class="text-lg font-semibold">Filters</p>
          <button
            type="button"
            id="mobile-filter-close"
            aria-label="Close filters"
            class="inline-flex h-11 w-11 items-center justify-center rounded-lg hover:bg-muted"
          >
            <Icon name="x" class="h-5 w-5" />
          </button>
        </div>
        <CatalogFilters
          groups={groups}
          priceRange={priceRange}
          currentFilters={currentFilters}
          query={query}
          sortBy={sortBy}
          defaultSort={defaultSort}
          total={pagination.total}
          totalIsCapped={pagination.totalIsCapped}
          pathname={pathname}
          resetPath={resetPath}
          searchLabel={searchLabel}
          countEndpoint={countEndpoint}
          currencySymbol={currencySymbol}
          currencyCode={currencyCode}
          presentation={presentation.filters}
          mobileFacetRail={marketplacePhoneFilters}
          withoutCategories={pillLinks.length > 0 && pills.length === 0 && searchPills.length === 0}
          ratingRows={ratingRows}
        />
      </div>
    </aside>
  )}

  {/* Dawn: the sort and the count end the filter line. */}
  {boutiqueBar && <CatalogBandTools {...bandTools} countLabel={showPhoneBar ? countLabel : null} class="catalog-boutique-tools" />}

  <div class="min-w-0 flex-1">
    {specRail && (
      <div class="catalog-band catalog-spec-results-band" data-catalog-band data-catalog-kind={kind} data-spec-search={specSearchShowsQuery ? "" : undefined} data-visible-breadcrumb={visibleBreadcrumb ? "" : undefined} data-placement={placement}>
        <div class="catalog-band-heading">
          <h1 class="catalog-band-title">{band.title}</h1>
          {countLabel && <p class="catalog-band-count" aria-live="polite">{countLabel}</p>}
        </div>
        <div class="catalog-band-tools">
          {drawer && showFilters && (
            <button type="button" data-catalog-filter-toggle aria-controls="filter-section" aria-expanded="false" class="inline-flex min-h-9 items-center gap-2 rounded-lg border border-border bg-background px-3 text-sm font-semibold text-foreground hover:bg-muted">
              <Icon name="sliders-horizontal" class="h-4 w-4" /> Filters
            </button>
          )}
          {showPageSize && <CatalogViewSelect id="pageSizeDesktop" name="limit" variant="labelled" selected={String(limit)} {...viewSelect} />}
          {showSort && <CatalogViewSelect id="sortByDesktop" name="sortBy" variant="labelled" options={sortOptions} selected={sortBy} {...viewSelect} />}
          {showViewToggle && <CatalogViewToggle defaultView={results === "list" ? "list" : "grid"} />}
        </div>
      </div>
    )}
    <slot name="description" />
    {piece("applied-chips") && <AppliedCatalogFilters
      facets={filterFacets}
      currentFilters={currentFilters}
      pathname={pathname}
      resetPath={resetPath}
      defaultSort={defaultSort}
      currencySymbol={currencySymbol}
      currencyCode={currencyCode}
      hideSearch={specSearchShowsQuery}
    />}

    {facetValueChips && (
      <div class="mb-4 flex items-center gap-2 overflow-x-auto pb-1 lg:flex-wrap">
        <span class="shrink-0 text-sm font-medium text-muted-foreground">{facetValueChips.label}</span>
        <CatalogChipLinks label={`${facetValueChips.label} choices`} links={facetValueChips.links} inline />
      </div>
    )}

    {products.length === 0 ? (
      <slot name="empty" />
    ) : shelves.length > 0 ? (
      <Fragment>
        <div class="product-grid-frame" data-catalog-results={showViewToggle ? "grid" : undefined} data-catalog-view-storage-key={showViewToggle ? shelfViewStorageKey : undefined} data-catalog-shelf-view={showViewToggle ? "" : undefined}>
          <CatalogShelves shelves={shelves} heritage={presentation.shelfSpacing === "airy"} currencySymbol={currencySymbol} currencyCode={currencyCode} />
        </div>
        {showViewToggle && <script is:inline set:html={shelfRestoreScript} />}
        <CatalogPaging mode="numbered" page={pagination.page} totalPages={pagination.totalPages} total={pagination.total} totalIsCapped={pagination.totalIsCapped} shown={products.length} limit={limit} getPageUrl={pageUrl} />
      </Fragment>
    ) : (
      <Fragment>
        {paging !== "numbered" && pagination.page > 1 && (
          <p class="mb-4">
            <a href={pageUrl(pagination.page - 1)} class="inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:underline">
              Show previous products
            </a>
          </p>
        )}
        <CatalogResults
          products={products}
          results={results}
          kind={kind === "search" ? "search" : "browse"}
          phoneLayout={presentation.phoneLayout}
          context={catalogCardContext(presentation, showFilters)}
          filterColumnPx={presentation.filters.columnPx}
          maxColumns={specSearch ? 5 : undefined}
          restoreView={showViewToggle}
          marked={showViewToggle || paging !== "numbered"}
          currencySymbol={currencySymbol}
          currencyCode={currencyCode}
        />
        <CatalogPaging
          mode={paging}
          page={pagination.page}
          totalPages={pagination.totalPages}
          total={pagination.total}
          totalIsCapped={pagination.totalIsCapped}
          shown={products.length}
          limit={limit}
          getPageUrl={pageUrl}
        />
      </Fragment>
    )}
  </div>
</div>

{showFilters && (
  <noscript>
    <style>
      #filter-section.hidden { display: block; position: static; background: transparent; margin-bottom: 1rem; }
      #filter-section .filter-sheet { max-height: none; }
      #filterForm > div:last-child { position: static; }
      #mobile-filter-toggle, [data-catalog-filter-toggle], #mobile-filter-close, [data-catalog-bar-more] { display: none !important; }
      .catalog-filter-form[data-placement="bar"] [data-bar-overflow] { display: block !important; }
    </style>
  </noscript>
)}

<script>
  import { setupCatalogFilterDialog } from "@/lib/catalog-filter-dialog";
  import { setupCatalogFilters } from "@/lib/catalog-filters";
  import { setupCatalogSorts } from "@/lib/catalog-sort";
  import { setupCatalogPaging, setupCatalogViewToggle } from "@/lib/catalog-paging";

  let railCleanup: (() => void) | undefined;
  let railNode: HTMLElement | null = null;
  const setupMarketplaceFacetRail = () => {
    const section = document.querySelector<HTMLElement>("#filter-section[data-marketplace-filter-rail]");
    if (section === railNode) return;
    railCleanup?.();
    railNode = section;
    if (!section) return;
    const facets = [...section.querySelectorAll<HTMLDetailsElement>("details[data-catalog-mobile-facet]")];
    if (facets.length === 0) return;
    const mobile = window.matchMedia("(max-width: 1023px)");
    const sync = () => {
      if (mobile.matches) {
        const active = facets.find((facet) => facet.dataset.selected === "true") ?? facets[0];
        facets.forEach((facet) => {
          facet.open = facet === active;
          facet.setAttribute("name", "catalog-mobile-facets");
        });
        section.setAttribute("data-mobile-facet-rail", "");
      } else {
        section.removeAttribute("data-mobile-facet-rail");
        facets.forEach((facet) => {
          facet.removeAttribute("name");
          facet.open = facet.dataset.initialOpen === "true";
        });
      }
    };
    const keepOneOpen = (event: MouseEvent) => {
      if (!mobile.matches || !(event.target instanceof Element)) return;
      const facet = event.target.closest("summary")?.parentElement;
      if (!(facet instanceof HTMLDetailsElement) || !facets.includes(facet)) return;
      event.preventDefault();
      facets.forEach((item) => { item.open = item === facet; });
    };
    sync();
    section.addEventListener("click", keepOneOpen);
    mobile.addEventListener("change", sync);
    railCleanup = () => {
      section.removeEventListener("click", keepOneOpen);
      mobile.removeEventListener("change", sync);
    };
  };

  const setupCatalog = () => {
    setupMarketplaceFacetRail();
    setupCatalogFilterDialog();
    setupCatalogFilters();
    setupCatalogSorts();
    setupCatalogPaging();
    setupCatalogViewToggle();
  };
  document.addEventListener("DOMContentLoaded", setupCatalog);
  document.addEventListener("astro:page-load", setupCatalog);
</script>
