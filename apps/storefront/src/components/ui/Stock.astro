---
// The one stock line (README.md): "In stock", "Only 3 left", "Sold out" or
// "Pre-order", the same on cards and the product page. The dot is
// decorative (the words say it); the words are ink, or muted when sold out.
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";

interface Props {
  state: "in-stock" | "low" | "sold-out" | "pre-order";
  /** Units left, for `low`. */
  count?: number;
  as?: "p" | "span";
  class?: string;
}

const { state, count = 0, as: Tag = "p", class: className } = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).stock;
const text = state === "in-stock"
  ? copy.inStock
  : state === "low" ? copy.low(Math.max(1, Math.floor(count)))
  : state === "sold-out" ? copy.soldOut : copy.preOrder;
---

<Tag class:list={["sf-stock", className]} data-state={state}><span class="sf-stock-dot" aria-hidden="true"></span>{text}</Tag>

<style is:global>
  .site-root .sf-stock {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    color: var(--foreground);
    font-size: var(--theme-text-sm, 0.875rem);
    line-height: 1.3;
  }

  .site-root .sf-stock-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: var(--theme-success, #15803d);
  }

  .site-root .sf-stock[data-state="low"] .sf-stock-dot {
    background: var(--theme-rating, #f59e0b);
  }

  .site-root .sf-stock[data-state="sold-out"] {
    color: var(--muted-foreground);
  }

  .site-root .sf-stock[data-state="sold-out"] .sf-stock-dot {
    background: var(--muted-foreground);
  }

  .site-root .sf-stock[data-state="pre-order"] .sf-stock-dot {
    background: var(--primary);
  }

  @media (forced-colors: active) {
    .site-root .sf-stock-dot {
      background: CanvasText;
    }
  }
</style>
