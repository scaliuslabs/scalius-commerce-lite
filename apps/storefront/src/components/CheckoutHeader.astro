---
// The cart and checkout header: the theme's logo (the request theme, so a
// draft preview shows its own) with the store name as its alt text, or the
// store name in text. On a private page drawn from parts it also holds the
// store's controls where the theme places them there (`privatePages.controls:
// header`): the light or dark switch and the market and language forms.
import type { LayoutData } from "@/lib/api";
import PrivateSchemeSwitch from "./header/PrivateSchemeSwitch.astro";
import PrivateLocalization from "./footer/PrivateLocalization.astro";
import type { FooterLocalizationModel } from "./footer/footer-localization";
import { mediaImageUrl } from "@/lib/media-url";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { resolveRequestTheme } from "@/lib/storefront-theme-context";
import { resolveStoreName } from "@/lib/store-identity";

interface Props {
  layoutData: LayoutData | null;
  copy: import("@scalius/shared/checkout-language").CheckoutLanguageData;
  /** The store's controls in this header (a private page whose theme places them here). */
  controls?: { localization: FooterLocalizationModel | null };
}

const { layoutData, copy, controls } = Astro.props;
const { theme, brand } = await resolveRequestTheme(Astro, layoutData);
const logoSrc = brand.logo?.url ?? "";
// Dark pages show the dark logo (CSS picks it: a hidden lazy image never loads).
const darkLogoSrc = brand.darkLogo?.url ?? "";
const darkFirst = theme.tokens.colorScheme === "dark";
const merchantName = resolveStoreName(layoutData?.business) || copy.pageTitle;
---

<header class="border-b border-border bg-background" data-private="core-header">
  <div class="mx-auto flex min-h-16 w-full max-w-6xl flex-wrap items-center justify-between gap-x-4 px-4 sm:min-h-18 sm:px-6">
    <a
      href="/"
      data-astro-prefetch={getStorefrontPrefetchAttribute("/", Astro.url)}
      class="inline-flex min-h-11 items-center rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
    >
      {
        logoSrc ? (
          <img
            src={mediaImageUrl(logoSrc, 320)}
            alt={merchantName}
            width="120"
            height="48"
            class:list={["h-8 w-auto max-w-40 object-contain sm:h-9 sm:max-w-48", darkLogoSrc && "dark:hidden"]}
            loading={darkLogoSrc && darkFirst ? "lazy" : undefined}
            decoding="async"
          />
        ) : (
          <span class:list={["text-base font-semibold text-foreground", darkLogoSrc && "dark:hidden"]}>{merchantName}</span>
        )
      }
      {
        darkLogoSrc && (
          <img
            src={mediaImageUrl(darkLogoSrc, 320)}
            alt={merchantName}
            width="120"
            height="48"
            class="hidden h-8 w-auto max-w-40 object-contain dark:block sm:h-9 sm:max-w-48"
            loading={darkFirst ? undefined : "lazy"}
            decoding="async"
          />
        )
      }
    </a>

    <div class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground" aria-label={copy.secureCheckoutText}>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <rect x="5" y="10" width="14" height="10" rx="2" stroke-width="1.75" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke-width="1.75" stroke-linecap="round" />
      </svg>
      <span>{copy.secureCheckoutText}</span>
    </div>
    {controls && <PrivateSchemeSwitch />}
    {controls?.localization && <div class="basis-full pb-2"><PrivateLocalization localization={controls.localization} /></div>}
  </div>
</header>
