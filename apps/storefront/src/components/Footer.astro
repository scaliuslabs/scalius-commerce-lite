---
// The store footer: the app footer skin the theme names
// (`apps.skins.footer`), else the theme's own footer (CoreFooter.astro). An
// app footer that is inactive, draws nothing, fails or is late gives way to
// the core footer.
import Skin from "@/components/apps/Skin.astro";
import { footerData } from "@/lib/extensions/data";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import CoreFooter from "./CoreFooter.astro";

type Props = import("astro/types").ComponentProps<typeof CoreFooter>;

const props = Astro.props;
const data = async () => footerData({
  theme: await currentRequestTheme(Astro.locals),
  storeName: props.storeName,
  storePhone: props.storePhone,
  menus: props.menus,
  policies: props.policies,
  business: props.business,
  social: props.social,
});
---

<Skin target="footer" data={data}>
  <CoreFooter {...props} />
</Skin>
