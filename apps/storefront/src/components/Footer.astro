---
// src/components/Footer.astro
// Footer component - receives data from Layout.astro
import type {
  FooterData,
  FooterMenu,
  SocialLink,
  FooterMenuLink,
} from "@/lib/api";
import RecursiveFooterLink from "./RecursiveFooterLink.astro";
import { mediaImageUrl } from "@/lib/media-url";
import { optimizeRichContentImages } from "@/lib/rich-content-media";
import { sanitizeHtml } from "@scalius/shared/html-sanitize";
import {
  applyStorefrontPrefetchPolicyToHtml,
  getStorefrontPrefetchAttribute,
} from "@/lib/prefetch-policy";
import { telHref, whatsappHref } from "@/lib/store-identity";
import { TRACK_ORDER_PATH, placeTrackOrderLink } from "@/lib/footer-links";
import type { StorefrontBusinessInfo } from "@/lib/commerce-structured-data";
import type { StorefrontFooterStyle } from "@scalius/shared/storefront-theme";

interface Props {
  footerData: FooterData;
  /** Business settings identity and the store's single social set. */
  storeName: string | null;
  storePhone: string | null;
  social: SocialLink[];
  /** Policy pages from Settings -> Policies. */
  policies: Array<{ title: string; path: string }>;
  /**
   * columns: logo, text and menu columns. compact: one band of links.
   * contact: menus plus a help block (call, WhatsApp, email, address).
   */
  variant: StorefrontFooterStyle;
  business: StorefrontBusinessInfo | null | undefined;
}

const {
  footerData,
  storeName,
  storePhone,
  social: storeSocial,
  policies,
  variant,
  business,
} = Astro.props;

const logo = footerData?.logo || { src: "", alt: "" };
const brandName = storeName || logo.alt || footerData?.copyrightText || "";
const phoneHref = telHref(storePhone);
const chatHref = whatsappHref(storePhone);
const storeEmail = business?.email?.trim() || null;
const storeAddress = [business?.addressLine1, business?.addressLine2, business?.city]
  .map((part) => part?.trim())
  .filter(Boolean)
  .join(", ");
const tagline = footerData?.tagline || "";
const description = footerData?.description || "";
const optimizedDescription = applyStorefrontPrefetchPolicyToHtml(
  optimizeRichContentImages(sanitizeHtml(description)),
  Astro.url,
);
const copyrightName = storeName || footerData?.copyrightText || "";
const rawMenus: FooterMenu[] = footerData?.menus || [];
const social = storeSocial.map((item) => ({
  ...item,
  optimizedIconUrl: item.iconUrl ? mediaImageUrl(item.iconUrl, 160) : null,
}));

/**
 * Convert flat menu structure to nested.
 */
function convertFlatMenuToNested(menu: FooterMenu): FooterMenuLink[] {
  // If menu already has nested links, use them
  if (menu.links && Array.isArray(menu.links) && menu.links.length > 0) {
    return menu.links;
  }

  // If no flat structure, return empty array
  if (!menu.items || !menu.rootIds) {
    return [];
  }

  const items = menu.items;
  const rootIds = menu.rootIds;

  // Recursively build nested structure from flat items
  function buildNestedLinks(itemIds: string[]): FooterMenuLink[] {
    return itemIds
      .map((id) => {
        const item = items[id];
        if (!item) return null;

        const link: FooterMenuLink = {
          id: item.id,
          title: item.title,
          href: item.href || "#",
          openInNewTab: item.openInNewTab,
        };

        // Recursively add children if any
        if (item.childIds && item.childIds.length > 0) {
          link.subMenu = buildNestedLinks(item.childIds);
        }

        return link;
      })
      .filter((link): link is FooterMenuLink => link !== null);
  }

  return buildNestedLinks(rootIds);
}

// Convert all menus to have nested links structure
// "Track your order" sits in the Help column when the store has one.
const { menus, inBottomRow: trackOrderInBottomRow } = placeTrackOrderLink(
  rawMenus.map((menu): FooterMenu & { links: FooterMenuLink[] } => ({
    ...menu,
    links: convertFlatMenuToNested(menu),
  })),
  "Track your order",
);

// Policy pages are always one tap away (payment gateways require visible
// privacy, terms and refund policies), unless a footer menu already links them.
const linkedHrefs = new Set(
  menus.flatMap((menu) => menu.links.map((link) => (link.href ?? "").replace(/\/+$/, ""))),
);
const policyLinks = policies
  .map((policy) => ({ title: policy.title, href: policy.path }))
  .filter((link) => !linkedHrefs.has(link.href));

// The compact footer lists every top-level link in one band.
const compactLinks = [
  ...menus.flatMap((menu) => menu.links.filter((link) => link.href)),
  ...policyLinks.map((link) => ({ title: link.title, href: link.href })),
];

const menuCount = menus.length;
let menuGridCols = "grid-cols-2"; // Default to 2 columns on mobile
if (menuCount >= 3) menuGridCols = "grid-cols-2 lg:grid-cols-3";
if (menuCount >= 4) menuGridCols = "grid-cols-2 lg:grid-cols-4";

---

<footer class="relative bg-primary text-primary-foreground overflow-hidden">
  <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 py-5 lg:py-6">
    {variant === "compact" ? (
      <div class="flex flex-col items-center gap-4 text-center lg:flex-row lg:justify-between lg:text-left">
        {brandName && (
          <a href="/" class="text-lg font-bold">{brandName}</a>
        )}
        {compactLinks.length > 0 && (
          <nav aria-label="Footer">
            <ul class="flex flex-wrap justify-center gap-x-5 gap-y-1">
              {compactLinks.map((link) => (
                <li>
                  <a href={link.href} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {phoneHref && (
          <a href={phoneHref} class="inline-flex min-h-11 items-center font-semibold underline underline-offset-4">
            {storePhone}
          </a>
        )}
      </div>
    ) : (
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 md:gap-5">
      <div class="lg:col-span-4">
        {/* No logo and no store name: no empty link to tab onto. */}
        {(logo.src || brandName) && (
          <a
            href="/"
            class="group inline-block transform transition-transform hover:scale-105 duration-300"
          >
            {
              logo.src ? (
                <img
                  src={mediaImageUrl(logo.src, 480)}
                  alt={brandName || "Home"}
                  width={344}
                  height={256}
                  loading="lazy"
                  decoding="async"
                  class="h-12 sm:h-14 w-auto object-contain drop-shadow-lg"
                />
              ) : (
                <span class="text-lg font-bold">{brandName}</span>
              )
            }
          </a>
        )}
        {
          tagline && (
            <p class="mt-3 text-base font-medium leading-relaxed max-w-md">
              {tagline}
            </p>
          )
        }

        {
          variant === "contact" ? (
            <div class="mt-4 space-y-3">
              <h2 class="text-base font-semibold">Need help ordering?</h2>
              <div class="flex flex-wrap gap-2">
                {phoneHref && (
                  <a href={phoneHref} class="inline-flex min-h-11 items-center rounded-lg bg-primary-foreground px-4 text-sm font-semibold text-primary">
                    Call {storePhone}
                  </a>
                )}
                {chatHref && (
                  <a href={chatHref} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center rounded-lg border border-primary-foreground/60 px-4 text-sm font-semibold">
                    Chat on WhatsApp
                  </a>
                )}
              </div>
              {storeEmail && (
                <p class="text-base">
                  <a href={`mailto:${storeEmail}`} class="underline underline-offset-4">{storeEmail}</a>
                </p>
              )}
              {storeAddress && <address class="text-base not-italic">{storeAddress}</address>}
            </div>
          ) : (
            phoneHref && (
              <p class="mt-3 text-base">
                Call us:{" "}
                <a href={phoneHref} class="font-semibold underline underline-offset-4">
                  {storePhone}
                </a>
              </p>
            )
          )
        }

        {/* Rich text description from API */}
        {
          description && (
            <div
              class="mt-2 text-base text-inherit leading-relaxed max-w-md prose prose-base [&_*]:text-inherit prose-p:my-1 prose-p:leading-relaxed prose-a:underline prose-pre:bg-transparent"
              set:html={optimizedDescription}
            />
          )
        }
      </div>

      <div class="lg:col-span-8">
        <div class={`grid ${menuGridCols} gap-8 sm:gap-10`}>
          {
            menus.map((menu) => (
              <div class="flex flex-col gap-4">
                <h2 class="text-sm font-bold tracking-widest uppercase">
                  {menu.title}
                </h2>

                <RecursiveFooterLink links={menu.links} />
              </div>
            ))
          }
        </div>
      </div>

    </div>
    )}

    <div class="mt-4 sm:mt-5 pt-4 sm:pt-5 border-t border-primary-foreground/20">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex flex-col items-center gap-2 text-sm sm:items-start">
          {
            variant !== "compact" && policyLinks.length > 0 && (
              <nav aria-label="Store policies">
                <ul class="flex flex-wrap justify-center gap-x-4 gap-y-1 sm:justify-start">
                  {policyLinks.map((link) => (
                    <li>
                      <a href={link.href} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline sm:min-h-0">
                        {link.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
          <span class="text-center sm:text-left">
            © {new Date().getFullYear()}{copyrightName && <> <span class="font-semibold">{copyrightName}</span></>}. All rights reserved.
          </span>
          {trackOrderInBottomRow && (
            <a href={TRACK_ORDER_PATH} class="inline-flex min-h-11 items-center underline underline-offset-4 sm:min-h-0">
              Track your order
            </a>
          )}
        </div>

        {
          social.length > 0 && (
            <div class="flex items-center justify-center gap-4 flex-wrap">
              {social.map((item) => {
                const displayTitle = item.label || item.platform || "Social";
                const href = item.url;

                return (
                  <a
                    href={href}
                    data-astro-prefetch={getStorefrontPrefetchAttribute(href, Astro.url)}
                    class="group transition-all duration-300"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={displayTitle}
                    title={displayTitle}
                  >
                    <div class="relative p-2.5 rounded-full bg-primary-foreground/10 backdrop-blur-sm group-hover:bg-primary-foreground/20 transform transition-all duration-300 group-hover:scale-105 group-hover:-translate-y-1">
                      {item.optimizedIconUrl ? (
                        <img
                          src={item.optimizedIconUrl}
                          alt=""
                          aria-hidden="true"
                          class="w-5 h-5 object-contain"
                          loading="lazy"
                        />
                      ) : (
                        <span aria-hidden="true" class="w-5 h-5 flex items-center justify-center font-bold text-sm uppercase">
                          {displayTitle.charAt(0).toUpperCase()}
                        </span>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          )
        }
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    /* Edge-to-edge: Add safe area padding using Chrome's optimized pattern */
    padding-bottom: var(--safe-area-max-inset-bottom);
    margin-bottom: calc(
      env(safe-area-inset-bottom, 0px) - var(--safe-area-max-inset-bottom)
    );
  }

  footer::after {
    content: "";
    position: absolute;
    bottom: calc(-100vh - env(safe-area-inset-bottom, 0px));
    left: 0;
    right: 0;
    height: 100vh;
    background-color: var(--primary);
    z-index: -20;
  }
</style>
