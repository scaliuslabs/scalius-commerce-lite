---
// The store footer: the app footer the theme names (`apps.footer`, an app's
// footer slot), else the theme's own footer (CoreFooter.astro). An app
// footer that is inactive, fails or is late gives way to the core footer.
import { storefrontExtensionBase } from "@scalius/shared/plugins/storefront-protocol";
import AppComponent from "@/components/apps/AppComponent.astro";
import { appSlot, requestExtensions } from "@/lib/extensions";
import { footerData } from "@/lib/extensions/data";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import CoreFooter from "./CoreFooter.astro";

type Props = import("astro/types").ComponentProps<typeof CoreFooter>;

const props = Astro.props;
const app = await appSlot(Astro.locals, Astro.url, "footer");
let html: string | null = null;
if (app) {
  const theme = await currentRequestTheme(Astro.locals);
  const { host } = await requestExtensions(Astro.locals, Astro.url);
  html = await host.render(app.extension, {
    kind: "slot",
    slot: "footer",
    component: app.component,
    settings: app.settings,
    data: footerData({
      theme,
      storeName: props.storeName,
      storePhone: props.storePhone,
      menus: props.menus,
      policies: props.policies,
      business: props.business,
      social: props.social,
    }),
  });
}
---

{html !== null && app
  ? <AppComponent html={html} pluginId={app.extension.pluginId} base={storefrontExtensionBase(app.extension.pluginId, app.extension.release)} />
  : <CoreFooter {...props} />}
