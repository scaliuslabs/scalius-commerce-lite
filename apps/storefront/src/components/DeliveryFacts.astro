---
import { Banknote, RotateCcw, Store, Truck } from "lucide-react";
import type { DeliveryFact } from "@/lib/delivery-facts";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";

interface Props {
  facts: DeliveryFact[];
  /** `strip` on the homepage, `list` under the product page buttons. */
  variant?: "strip" | "list";
}

const { facts, variant = "strip" } = Astro.props;
const ICONS = { delivery: Truck, pickup: Store, cod: Banknote, returns: RotateCcw } as const;
// Up to three facts sit side by side from small screens; four (delivery,
// pickup, cash on delivery, returns) stack until there is room for a row.
const columns = [
  "",
  "sm:grid-cols-1",
  "sm:grid-cols-2 sm:divide-x sm:divide-y-0",
  "sm:grid-cols-3 sm:divide-x sm:divide-y-0",
][facts.length] ?? "lg:grid-cols-4 lg:divide-x lg:divide-y-0";
---

{facts.length > 0 && (
  <section
    class={variant === "strip" ? "w-full py-4 md:py-8" : "mt-3"}
    aria-label="Delivery, payment and returns"
  >
    <div class={variant === "strip" ? "mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" : ""}>
      <ul
        class={variant === "strip"
          ? `grid divide-y divide-border rounded-xl border border-border bg-card ${columns}`
          : "divide-y divide-border rounded-lg border border-border bg-card"}
      >
        {facts.map((fact) => {
          const Icon = ICONS[fact.kind];
          const content = (
            <>
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-muted text-foreground">
                <Icon className="size-4" aria-hidden="true" />
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-foreground">{fact.title}</span>
                {fact.detail && (
                  <span class="block text-sm leading-relaxed text-muted-foreground">{fact.detail}</span>
                )}
              </span>
            </>
          );
          const rowClass = variant === "strip"
            ? "flex min-h-20 items-center gap-3 px-4 py-3 md:px-5"
            : "flex items-center gap-3 px-3 py-2.5";

          return (
            <li>
              {fact.href ? (
                <a
                  href={fact.href}
                  data-astro-prefetch={getStorefrontPrefetchAttribute(fact.href, Astro.url)}
                  class={`${rowClass} transition-colors hover:bg-muted/40`}
                >
                  {content}
                </a>
              ) : (
                <div class={rowClass}>{content}</div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}
