---
import type { StorefrontPageBlockId } from "@scalius/shared/storefront-theme";

interface Props {
  blocks: readonly { id: StorefrontPageBlockId; hidden: boolean }[];
  defaults: readonly StorefrontPageBlockId[];
}

const { blocks, defaults } = Astro.props;
const originalOrder = blocks.length === defaults.length && blocks.every((block, index) => !block.hidden && block.id === defaults[index]);
---

{originalOrder ? <slot name="original" /> : blocks.filter((block) => !block.hidden).map((block) => (
  <section data-theme-template-block={block.id} class="mx-auto w-full max-w-7xl px-3 py-4 sm:px-6 lg:px-8">
    <slot name={block.id} />
  </section>
))}
