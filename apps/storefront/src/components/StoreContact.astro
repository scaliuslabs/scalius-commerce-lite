---
// "Contact the store: 01711-000000 · WhatsApp · shop@example.com" from Business
// settings, or nothing when the store has no phone or email. Pages that can hit
// a dead end (no code channel, a declined request) show it.
import type { LayoutData } from "@/lib/api";
import { storeContactLinks } from "@/lib/store-contact";
import { ENGLISH_CHECKOUT_LANGUAGE_DATA } from "@scalius/shared/checkout-language";

interface Props {
  layoutData: LayoutData | null;
  hidden?: boolean;
  class?: string;
  id?: string;
  /** "Contact the store:" in the page's checkout language. */
  label?: string;
}

const {
  layoutData,
  hidden = false,
  class: className = "text-sm text-muted-foreground",
  id,
  label = ENGLISH_CHECKOUT_LANGUAGE_DATA.storeContactLabelText,
} = Astro.props;
const links = storeContactLinks(layoutData?.business);
---

{links.length > 0 && (
  <p id={id} data-store-contact hidden={hidden} class={className}>
    {label}{" "}
    {links.map((link, index) => (
      <>
        {index > 0 && " · "}
        <a
          href={link.href}
          data-store-contact-link={link.kind}
          class={`font-medium text-primary hover:underline${link.kind === "email" ? " break-all" : ""}`}
          {...(link.kind === "whatsapp" ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >{link.label}</a>
      </>
    ))}
  </p>
)}
