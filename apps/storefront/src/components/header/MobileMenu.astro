---
import { trimTrailingCharacter } from "@scalius/shared/text-scan";
// A menu drawer from the start edge: the phone menu (`mobile-menu`, the
// accordion tree or the drill-in levels) and, for the drill-in desktop menu,
// the computer's "All" drawer (`nav-drawer`, or the phone drawer itself when
// both use drill-in). drawer.ts owns the dialog behaviour; without
// JavaScript it opens as the URL's :target from the <noscript> links.
// The Marketplace drawer is 80vw on phones and 365px on computers; other
// themes retain their usual 90vw phone drawer. Each target appears once.
import type { NavigationItem, SocialLink } from "@/lib/api";
import Icon from "@/components/icons/Icon.astro";
import { mediaImageUrl } from "@/lib/media-url";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { telHref } from "@/lib/store-identity";
import { socialGlyph, socialGlyphMarkup } from "../footer/social-icons";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import { pageDigits } from "@/lib/checkout-text";
import NavTree from "./NavTree.astro";
import DrillDrawer from "./DrillDrawer.astro";

interface Props {
  navigation: NavigationItem[];
  /** The store's support phone (Business settings): the drawer's call card. */
  phone: string | null;
  social?: SocialLink[];
  /** Id base: `${id}-panel`, `${id}-overlay`, `${id}-close`. */
  id?: string;
  tree?: "accordion" | "drill";
  /** phone: below `lg` only; all: every width (the drill-in "All" drawer). */
  screens?: "phone" | "all";
  title?: string;
  /** The top level ends with "All categories" (/categories). */
  allCategories?: boolean;
}

const {
  navigation = [],
  phone,
  social = [],
  id = "mobile-menu",
  tree = "accordion",
  screens = "phone",
  title: titleProp,
  allCategories = false,
} = Astro.props;
const { language, theme } = await currentRequestTheme(Astro.locals);
// Below 23.75rem the phone menu carries the buyer's light or dark switch (the header bar has no room for it).
const schemeSwitch = id === "mobile-menu" && theme.tokens.colorSchemeToggle;
const copy = storefrontCopy(language).chrome;
const title = titleProp ?? copy.nav.menu;
const menuHasTrackOrder = (function has(list: NavigationItem[]): boolean {
  return list.some((item) => {
    const href = trimTrailingCharacter(item.href?.split(/[?#]/)[0] ?? "", "/");
    return href === "/track-order" || /^track (your )?order$/i.test(item.title.trim()) || has(item.subMenu ?? []);
  });
})(navigation);
const phoneHref = telHref(phone);
const phoneOnly = screens === "phone";
const navId = id === "mobile-menu" ? "mobile-nav-container" : `${id}-nav`;
---

<div
  id={`${id}-overlay`}
  class:list={[
    "pointer-events-none invisible fixed inset-0 z-60 bg-black/60 opacity-0 backdrop-blur-sm transition-opacity duration-300",
    phoneOnly && "lg:hidden",
  ]}
  aria-hidden="true"
  data-drawer-overlay={id}
>
</div>

<div
  id={`${id}-panel`}
  class:list={[
    "nav-drawer invisible fixed inset-s-0 top-0 z-70 flex h-dvh max-w-[365px] -translate-x-full rtl:translate-x-full transform flex-col border-e border-border bg-card text-foreground shadow-2xl transition-transform duration-300 ease-[cubic-bezier(0.19,1,0.22,1)]",
    "w-[90vw]",
    phoneOnly && "lg:hidden",
  ]}
  role="dialog"
  aria-modal="true"
  aria-label={phoneOnly ? copy.nav.mobileMenu : title}
  data-drawer={id}
  data-drawer-screens={screens}
>
  <div
    class="flex items-center justify-between px-5 py-3 border-b border-border shrink-0 bg-card shadow-[0_1px_2px_rgba(0,0,0,0.03)] z-10"
  >
    <h2 class="text-base font-bold tracking-tight text-foreground">{title}</h2>
    {/* JS-only; without JavaScript the layout's <noscript> rule hides every
        [data-drawer-close] and the link below clears the :target instead. */}
    <button
      id={`${id}-close`}
      type="button"
      class="-me-3 flex h-11 w-11 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground active:scale-95"
      aria-label={copy.header.closeMenu}
      data-drawer-close
    >
      <Icon name="x" class="h-5 w-5 stroke-[1.5]" />
    </button>
    <noscript>
      <a
        href="#"
        class="-me-3 flex h-11 w-11 items-center justify-center rounded-full text-muted-foreground"
        aria-label={copy.header.closeMenu}
      >
        <Icon name="x" class="h-5 w-5 stroke-[1.5]" />
      </a>
    </noscript>
  </div>

  <nav
    class:list={[
      "flex-1 overscroll-contain scrollbar-hide relative",
      tree === "drill" ? "flex min-h-0 flex-col" : "overflow-y-auto px-3 py-3",
    ]}
    id={navId}
    aria-label={phoneOnly ? copy.nav.mobileNavigation : title}
  >
    {
      tree === "drill" ? (
        <div class="min-h-0 flex-1">
          <DrillDrawer items={navigation} idPrefix={`${id}-d`} allCategories={allCategories} />
        </div>
      ) : (
        <NavTree
          items={navigation}
          idPrefix={id === "mobile-menu" ? "mobile-nav" : `${id}-tree`}
          variant="drawer"
          allCategories={allCategories}
        />
      )
    }

    {schemeSwitch && (
      <button
        type="button"
        class:list={["drawer-scheme mt-4 min-h-11 w-full items-center gap-3 border-t border-border px-3 pt-3 text-start text-sm font-semibold text-foreground transition-colors hover:text-primary", tree === "drill" && "mx-3 shrink-0"]}
        data-color-scheme-toggle
        data-sx-host-color-scheme-toggle
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-none stroke-current dark:hidden" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.1A8.5 8.5 0 1 1 9.9 3.5a6.6 6.6 0 0 0 10.6 10.6Z" /></svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="hidden size-5 fill-none stroke-current dark:block" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        {copy.header.darkColors}
      </button>
    )}

    {!menuHasTrackOrder && <a
      href="/track-order"
      data-astro-prefetch="false"
      class:list={[
        "mt-4 flex min-h-11 items-center border-t border-border px-3 pt-3 text-sm font-semibold text-foreground transition-colors hover:text-primary",
        tree === "drill" && "mx-3 shrink-0",
      ]}
    >
      {copy.nav.trackOrder}
    </a>}

    {
      social && social.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2 border-t border-border px-3 pt-4">
          {social.map((item) => {
            if (!item.url) return null;
            const glyph = socialGlyph(item.url, item.label);
            const displayTitle = item.label || (glyph ? glyph.charAt(0).toUpperCase() + glyph.slice(1) : copy.nav.social);
            const href = item.url.startsWith("http")
              ? item.url
              : `https://${item.url}`;

            return (
              <a
                href={href}
                data-astro-prefetch={getStorefrontPrefetchAttribute(
                  href,
                  Astro.url,
                )}
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-input bg-card text-muted-foreground transition-all hover:border-primary/50 hover:text-foreground hover:shadow-sm"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={displayTitle}
                title={displayTitle}
              >
                {item.iconUrl ? (
                  <img
                    data-mobile-header-image
                    data-deferred-src={mediaImageUrl(item.iconUrl, 160)}
                    alt=""
                    aria-hidden="true"
                    class="w-4 h-4 object-contain"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  />
                ) : glyph ? (
                  <svg class="h-5 w-5 fill-none stroke-current stroke-[1.6]" viewBox="0 0 24 24" aria-hidden="true" stroke-linecap="round" stroke-linejoin="round" set:html={socialGlyphMarkup(glyph)} />
                ) : (
                  <span
                    aria-hidden="true"
                    class="text-[10px] font-bold uppercase"
                  >
                    {displayTitle.charAt(0)}
                  </span>
                )}
              </a>
            );
          })}
        </div>
      )
    }

    <div class="h-4"></div>
  </nav>

  {
    phoneHref && (
      <div class="z-20 shrink-0 border-t border-border bg-muted p-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
        <a
          href={phoneHref}
          class="flex items-center gap-3 p-3 bg-card border border-border rounded-xl shadow-sm active:scale-[0.99] transition-all group hover:border-primary/50"
        >
          <div class="h-9 w-9 rounded-full bg-primary/10 text-primary-ink flex items-center justify-center shrink-0">
            <Icon name="phone" class="h-4.5 w-4.5 fill-current" />
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs text-muted-foreground font-semibold leading-none mb-1">
              {copy.nav.callSupport}
            </p>
            <p class="text-sm font-bold text-foreground tracking-tight truncate">
              <bdi dir="ltr">{pageDigits(phone)}</bdi>
            </p>
          </div>
          <Icon name="chevron-right" class="h-4 w-4 text-muted-foreground group-hover:text-foreground" />
        </a>
      </div>
    )
  }
</div>

<style>
  /* The drawer's light or dark switch: only where the header bar has no room for it (below 23.75rem). */
  .drawer-scheme {
    display: none;
  }

  @media (max-width: 23.74rem) {
    .drawer-scheme {
      display: flex;
    }
  }

  /* Without JavaScript the drawer opens as the URL's target (the <noscript>
     menu links) and closes through its <noscript> close link. */
  .nav-drawer:target {
    visibility: visible;
    translate: none;
  }

  [data-drawer-overlay]:has(+ .nav-drawer:target) {
    visibility: visible;
    opacity: 1;
  }
</style>
