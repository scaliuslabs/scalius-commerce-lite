---
// A menu drawer from the start edge: the phone menu (`mobile-menu`, the
// accordion tree or the drill-in levels) and, for the drill-in desktop menu,
// the computer's "All" drawer (`nav-drawer`, or the phone drawer itself when
// both use drill-in). drawer.ts owns the dialog behaviour; without
// JavaScript it opens as the URL's :target from the <noscript> links.
import type { NavigationItem, SocialLink } from "@/lib/api";
import { X, Phone, ChevronRight } from "lucide-react";
import { mediaImageUrl } from "@/lib/media-url";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { telHref } from "@/lib/store-identity";
import NavTree from "./NavTree.astro";
import DrillDrawer from "./DrillDrawer.astro";

interface Props {
  navigation: NavigationItem[];
  contact: { phone: string; text: string };
  social?: SocialLink[];
  /** Id base: `${id}-panel`, `${id}-overlay`, `${id}-close`. */
  id?: string;
  tree?: "accordion" | "drill";
  /** phone: below `lg` only; all: every width (the drill-in "All" drawer). */
  screens?: "phone" | "all";
  title?: string;
}

const {
  navigation = [],
  contact,
  social = [],
  id = "mobile-menu",
  tree = "accordion",
  screens = "phone",
  title = "Menu",
} = Astro.props;
const phoneHref = telHref(contact.phone);
const phoneOnly = screens === "phone";
const navId = id === "mobile-menu" ? "mobile-nav-container" : `${id}-nav`;
---

<div
  id={`${id}-overlay`}
  class:list={[
    "pointer-events-none invisible fixed inset-0 z-60 bg-black/60 opacity-0 backdrop-blur-sm transition-opacity duration-300",
    phoneOnly && "lg:hidden",
  ]}
  aria-hidden="true"
  data-drawer-overlay={id}
>
</div>

<div
  id={`${id}-panel`}
  class:list={[
    "nav-drawer invisible fixed left-0 top-0 z-70 flex h-dvh w-[90vw] max-w-[380px] -translate-x-full transform flex-col border-r border-border bg-card text-foreground shadow-2xl transition-transform duration-300 ease-[cubic-bezier(0.19,1,0.22,1)]",
    phoneOnly && "lg:hidden",
  ]}
  role="dialog"
  aria-modal="true"
  aria-label={phoneOnly ? "Mobile menu" : title}
  data-drawer={id}
  data-drawer-screens={screens}
>
  <div
    class="flex items-center justify-between px-5 py-3 border-b border-border shrink-0 bg-card shadow-[0_1px_2px_rgba(0,0,0,0.03)] z-10"
  >
    <h2 class="text-base font-bold tracking-tight text-foreground">{title}</h2>
    <button
      id={`${id}-close`}
      type="button"
      class="-mr-3 flex h-11 w-11 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground active:scale-95"
      aria-label="Close menu"
    >
      <X className="h-5 w-5 stroke-[1.5]" />
    </button>
    <noscript>
      <a
        href="#"
        class="-mr-3 flex h-11 w-11 items-center justify-center rounded-full text-muted-foreground"
        aria-label="Close menu"
      >
        <X className="h-5 w-5 stroke-[1.5]" />
      </a>
      <style>{`#${id}-close { display: none !important; }`}</style>
    </noscript>
  </div>

  <nav
    class:list={[
      "flex-1 overscroll-contain scrollbar-hide relative",
      tree === "drill" ? "flex min-h-0 flex-col" : "overflow-y-auto px-3 py-3",
    ]}
    id={navId}
    aria-label={phoneOnly ? "Mobile navigation" : title}
  >
    {
      tree === "drill" ? (
        <div class="min-h-0 flex-1">
          <DrillDrawer items={navigation} idPrefix={`${id}-drill`} />
        </div>
      ) : (
        <NavTree items={navigation} idPrefix={id === "mobile-menu" ? "mobile-nav" : `${id}-tree`} variant="drawer" />
      )
    }

    <a
      href="/track-order"
      data-astro-prefetch="false"
      class:list={[
        "mt-4 flex min-h-11 items-center border-t border-border px-3 pt-3 text-sm font-semibold text-foreground transition-colors hover:text-primary",
        tree === "drill" && "mx-3 shrink-0",
      ]}
    >
      Track your order
    </a>

    {
      social && social.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2 border-t border-border px-3 pt-4">
          {social.map((item) => {
            if (!item.url) return null;
            const displayTitle = item.label || item.platform || "Social";
            const href = item.url.startsWith("http")
              ? item.url
              : `https://${item.url}`;

            return (
              <a
                href={href}
                data-astro-prefetch={getStorefrontPrefetchAttribute(
                  href,
                  Astro.url,
                )}
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-input bg-card text-muted-foreground transition-all hover:border-primary/50 hover:text-foreground hover:shadow-sm"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={displayTitle}
                title={displayTitle}
              >
                {item.iconUrl ? (
                  <img
                    data-mobile-header-image
                    data-deferred-src={mediaImageUrl(item.iconUrl, 160)}
                    alt=""
                    aria-hidden="true"
                    class="w-4 h-4 object-contain"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                  />
                ) : (
                  <span
                    aria-hidden="true"
                    class="text-[10px] font-bold uppercase"
                  >
                    {displayTitle.charAt(0)}
                  </span>
                )}
              </a>
            );
          })}
        </div>
      )
    }

    <div class="h-4"></div>
  </nav>

  {
    phoneHref && (
      <div class="z-20 shrink-0 border-t border-border bg-muted p-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
        <a
          href={phoneHref}
          class="flex items-center gap-3 p-3 bg-card border border-border rounded-xl shadow-sm active:scale-[0.99] transition-all group hover:border-primary/50"
        >
          <div class="h-9 w-9 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
            <Phone className="h-4.5 w-4.5 fill-current" />
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs text-muted-foreground font-semibold leading-none mb-1">
              Call support
            </p>
            <p class="text-sm font-bold text-foreground tracking-tight truncate">
              {contact.phone}
            </p>
          </div>
          <ChevronRight className="h-4 w-4 text-muted-foreground group-hover:text-foreground" />
        </a>
      </div>
    )
  }
</div>

<style>
  /* Without JavaScript the drawer opens as the URL's target (the <noscript>
     menu links) and closes through its <noscript> close link. */
  .nav-drawer:target {
    visibility: visible;
    translate: none;
  }

  [data-drawer-overlay]:has(+ .nav-drawer:target) {
    visibility: visible;
    opacity: 1;
  }
</style>
