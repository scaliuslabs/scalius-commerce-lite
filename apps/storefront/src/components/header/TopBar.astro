---
// The bar above the header (theme block `topBar`; `none` is the only off
// switch). Every other variant carries the announcement's words and an
// optional link (its settings); a variant without words to show renders
// nothing rather than an empty strip, except the utility bar's own links.
// - announcement: the words centred on the action colour, in sentence case.
//   On a phone they wrap onto a second line instead of cutting off the
//   facts at the end (a delivery threshold is the point of the bar).
// - utility: computers only, 36px on the muted surface; the announcement at
//   the start, then the call and track-order links. Account lives in the
//   header, so it is not repeated here. Phones reach the same links in the
//   menu drawer.
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { telHref } from "@/lib/store-identity";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";

interface Props {
  variant: string;
  text: string;
  /** The announcement's link (a canonical navigation-safe href); null: plain words. */
  link: string | null;
  phone: string | null;
}

const { variant, text: rawText, link, phone } = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).chrome;
const text = rawText.trim();
const phoneHref = telHref(phone);
const external = Boolean(link?.startsWith("https://"));
const linkAttributes = link
  ? {
      href: link,
      "data-astro-prefetch": getStorefrontPrefetchAttribute(link, Astro.url),
      target: external ? "_blank" : undefined,
      rel: external ? "noopener noreferrer" : undefined,
      "data-top-bar-link": "",
    }
  : null;
---

{
  variant === "announcement" && text && (
    <div class="top-announcement" data-top-bar="announcement">
      <p>{linkAttributes ? <a {...linkAttributes}>{text}</a> : text}</p>
    </div>
  )
}

{
  variant === "utility" && (
    <div class="top-utility" data-top-bar="utility">
      <div class="top-utility-inner">
        <p class="top-utility-text">
          {linkAttributes && text ? <a {...linkAttributes}>{text}</a> : text}
        </p>
        <ul class="top-utility-links">
          {phoneHref && (
            <li>
              <a href={phoneHref}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
                <bdi dir="ltr">{phone}</bdi>
              </a>
            </li>
          )}
          <li>
            <a href="/track-order" data-astro-prefetch="false">{copy.topBar.trackOrder}</a>
          </li>
        </ul>
      </div>
    </div>
  )
}

<style>
  /* Sentence case, 14px, and room for two lines on a phone. */
  .top-announcement {
    position: relative;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0.375rem var(--theme-gutter-phone, 1rem);
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .top-announcement p {
    max-width: var(--theme-container-width, 80rem);
    font-size: var(--theme-text-sm, 0.875rem);
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
    text-wrap: balance;
  }

  .top-announcement a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .top-announcement a:hover {
    text-decoration: underline;
  }

  .top-announcement a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .top-utility {
    display: none;
    border-bottom: 1px solid var(--border);
    background: var(--muted);
    color: var(--foreground);
  }

  @media (min-width: 64rem) {
    .top-utility {
      display: block;
    }
  }

  .top-utility-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--theme-container-width, 80rem);
    height: 2.25rem;
    margin-inline: auto;
    padding-inline: var(--theme-gutter-desktop, 2rem);
    font-size: var(--theme-text-sm, 0.875rem);
  }

  .top-utility-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
  }

  .top-utility-links {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
  }

  .top-utility-links li + li {
    border-inline-start: 1px solid var(--border);
  }

  .top-utility-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.25rem;
    padding-inline: 0.75rem;
    color: inherit;
    white-space: nowrap;
  }

  .top-utility-text a {
    color: inherit;
  }

  .top-utility-text a:hover,
  .top-utility-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .top-utility-links a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .top-utility-links svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
