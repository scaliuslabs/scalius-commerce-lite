---
// The departments rail (desktop menu `departments-rail`, open "demand"): an
// "All departments" button in the menu row whose list of departments
// (fly-outs for their children) hangs over the page when pressed or hovered.
// It is never open by itself, so it never covers what the page starts with.
// It is a native <details>: it works without JavaScript, and nav-menus.ts adds
// hover, arrow keys and Escape. The "always" rail is the column beside the
// page: SidebarNav.astro.
import type { NavigationItem } from "@/lib/api";
import FlyoutList from "./FlyoutList.astro";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";

interface Props {
  navigation: NavigationItem[];
  /** The list ends with "All categories" (/categories). */
  allCategories?: boolean;
}

const { navigation, allCategories = false } = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).chrome;
---

<nav class="drail" aria-label={copy.nav.allDepartments} data-menu-root>
  <details class="drail-menu" data-menu="popup" data-menu-hover>
    <summary class="drail-tab">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      <span>{copy.nav.allDepartments}</span>
      <i class="nav-chevron drail-chevron" aria-hidden="true"></i>
    </summary>
    <div class="drail-panel" data-menu-panel>
      <FlyoutList items={navigation} mode="cascade" />
      {allCategories && <a class="drail-all" href="/categories">{copy.nav.allCategories}</a>}
    </div>
  </details>
</nav>

<style is:global>
  /* The tab sits at the start of its row, whatever the row's alignment. */
  .drail {
    display: none;
    flex-shrink: 0;
    margin-inline-end: auto;
  }

  @media (min-width: 64rem) {
    .drail {
      display: block;
    }
  }

  .drail-menu {
    position: relative;
  }

  /* A bordered button, not a slab: the row holds it with the store's own links. */
  .drail-tab {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 13rem;
    height: 2.5rem;
    padding-inline: 0.75rem;
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    border-radius: var(--radius);
    color: var(--nav-ink, var(--foreground));
    font-size: var(--theme-text-sm, 0.875rem);
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .drail-tab:hover,
  .drail-menu[open] .drail-tab {
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .drail-tab::-webkit-details-marker {
    display: none;
  }

  .drail-tab svg {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .drail-tab span {
    flex: 1;
  }

  .drail-chevron {
    transition: transform 200ms ease;
  }

  .drail-menu[open] .drail-chevron {
    transform: rotate(180deg);
  }

  .drail-tab:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 2px;
  }

  /* The list hangs from the button over the page, only while it is open. */
  .drail-panel {
    position: absolute;
    top: calc(100% + 0.25rem);
    inset-inline-start: 0;
    z-index: 60;
    width: 17rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--popover);
    color: var(--popover-foreground);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.25);
  }

  .drail-panel .fly-list {
    min-width: 0;
  }

  .drail-panel .fly-link {
    min-height: 2.1875rem;
  }

  .drail-all {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    margin: 0 0.375rem 0.375rem;
    padding-inline: 0.75rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .drail-all:hover,
  .drail-all:focus-visible {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .drail-chevron {
      transition: none;
    }
  }
</style>
