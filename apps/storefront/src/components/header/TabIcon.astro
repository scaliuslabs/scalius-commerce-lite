---
// The store's bottom bar icons (24px strokes): one per destination and a few for link tabs.
import type { STOREFRONT_MOBILE_TAB_ICONS } from "@scalius/shared/storefront-theme";

interface Props {
  name: (typeof STOREFRONT_MOBILE_TAB_ICONS)[number];
}

const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true">
  {name === "home" && <Fragment><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" /><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></Fragment>}
  {name === "categories" && <Fragment><rect width="7" height="7" x="3" y="3" rx="1.5" /><rect width="7" height="7" x="14" y="3" rx="1.5" /><rect width="7" height="7" x="14" y="14" rx="1.5" /><rect width="7" height="7" x="3" y="14" rx="1.5" /></Fragment>}
  {name === "offers" && <Fragment><path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z" /><circle cx="7.5" cy="7.5" r="1.5" /></Fragment>}
  {name === "search" && <Fragment><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></Fragment>}
  {name === "compare" && <Fragment><path d="M4 6h10M4 12h16M4 18h10M18 4v4M16 6h4" /></Fragment>}
  {name === "cart" && <Fragment><circle cx="8" cy="21" r="1" /><circle cx="19" cy="21" r="1" /><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" /></Fragment>}
  {name === "account" && <Fragment><circle cx="12" cy="8" r="4" /><path d="M20 21a8 8 0 0 0-16 0" /></Fragment>}
  {name === "link" && <Fragment><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></Fragment>}
  {name === "page" && <Fragment><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h5" /></Fragment>}
  {name === "news" && <Fragment><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9h4" /><path d="M10 6h8M10 10h8M10 14h5" /></Fragment>}
  {name === "support" && <Fragment><circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01" /></Fragment>}
  {name === "gift" && <Fragment><rect x="3" y="8" width="18" height="4" rx="1" /><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5" /></Fragment>}
  {name === "heart" && <Fragment><path d="M19 14c1.5-1.5 3-3.2 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.8 0-3 .5-4.5 2-1.5-1.5-2.7-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4 3 5.5l7 7z" /></Fragment>}
  {name === "star" && <Fragment><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.2-6.2 3.2L7 14.2 2 9.3l6.9-1z" /></Fragment>}
  {name === "chat" && <Fragment><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></Fragment>}
  {name === "bolt" && <Fragment><path d="M13 2 3 14h9l-1 8 10-12h-9z" /></Fragment>}
</svg>
