---
// The classic header (variant `mall-departments`, the default template):
// logo left, a centred search, and the account and cart pill with the
// running total; the menu row sits under it and folds into the bar on
// scroll. Kept pixel-identical to the version 3 classic header.
import SearchBar from "../../search/SearchBar.astro";
import { Phone, ShoppingCart, Menu, Search } from "lucide-react";
import type { HeaderData } from "@/lib/api";
import type { StorefrontNavigationRenderer } from "@scalius/shared/storefront-theme";
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import {
  getMobileHeaderLogoWidth,
  normalizeHeaderLogoWidth,
} from "@scalius/shared/brand-presentation";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { telHref } from "@/lib/store-identity";

interface Props {
  headerData: HeaderData;
  variantId: string;
  /** A menu row under the bar (slot `desktop-nav-full`). */
  menuRow: boolean;
  navigationStyle: StorefrontNavigationRenderer;
  /** On scroll the dropdown menu row folds into the bar (a copy, see nav-disclosure.ts). */
  condensedMenu: boolean;
  /** Phone bar icons the bottom tabs already carry ("account cart"). */
  phoneDrop: string;
}

const { headerData, variantId, menuRow, navigationStyle, condensedMenu, phoneDrop } = Astro.props;
const logoWidth = normalizeHeaderLogoWidth(headerData.logo.width);
const mobileLogoWidth = getMobileHeaderLogoWidth(logoWidth);
// Logos without renditions get a plain src (no stray `sizes`).
const logoSrcSet = mediaImageSrcSet(headerData.logo.src);
// Social links live in the footer and the phone menu, so the desktop header
// reaches My Account and the cart in a few tab stops (logo, search, call).
const phoneHref =
  headerData.contact.isEnabled !== false ? telHref(headerData.contact.phone) : null;
const expandedActionsLgWidth = 0;
const expandedActionsXlWidth = phoneHref ? 40 : 0;
---

<div
  id="main-header"
  data-header-style="classic"
  data-header-variant={variantId}
  data-navigation={navigationStyle}
  data-phone-drop={phoneDrop || undefined}
  data-header-condense={condensedMenu ? "" : undefined}
  class="sticky top-0 z-50 w-full bg-background/95 backdrop-blur-xl border-b border-border transition-[box-shadow,background-color,border-color] duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1)] group/header"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- ROW 1 -->
    <div
      class="header-row flex items-center justify-between gap-4 relative z-20"
    >
      <div class="flex items-center shrink-0 lg:hidden z-30 gap-2">
        <button
          id="mobile-menu-toggle"
          type="button"
          class="-ml-2 flex h-11 w-11 items-center justify-center rounded-full text-foreground transition-colors hover:bg-muted active:bg-accent"
          aria-label="Open menu"
          aria-haspopup="dialog"
          aria-controls="mobile-menu-panel"
          aria-expanded="false"
        >
          <Menu className="h-6 w-6 stroke-[1.5]" />
        </button>
        <noscript>
          <a
            href="#mobile-menu-panel"
            class="-ml-2 flex h-11 w-11 items-center justify-center rounded-full text-foreground"
            aria-label="Open menu"
          >
            <Menu className="h-6 w-6 stroke-[1.5]" />
          </a>
        </noscript>

        <button
          id="mobile-search-toggle"
          type="button"
          class="flex h-11 w-11 items-center justify-center rounded-full text-foreground transition-colors hover:bg-muted active:bg-accent"
          aria-label="Search"
          aria-haspopup="dialog"
        >
          <Search className="h-5 w-5 stroke-[1.5]" />
        </button>
      </div>

      <div
        class="header-logo absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 lg:static lg:translate-x-0 lg:translate-y-0 shrink-0 z-20 flex items-center justify-center lg:justify-start"
      >
        {/* The logo's alt text (the store name) is the link's name. */}
        <a href="/" class="block group">
          {
            headerData.logo.src ? (
              <img
                src={mediaImageUrl(headerData.logo.src, 320)}
                srcset={logoSrcSet}
                sizes={logoSrcSet ? `(min-width: 1024px) ${logoWidth}px, ${mobileLogoWidth}px` : undefined}
                alt={headerData.logo.alt}
                class="storefront-header-logo h-auto w-auto max-h-8 lg:max-h-10 object-contain transition-[max-height,transform] duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1)] group-hover:scale-[1.02] group-[.is-scrolled]/header:lg:max-h-9"
                style={`--header-logo-width: ${logoWidth}px; --header-logo-mobile-width: ${mobileLogoWidth}px;`}
                width={240}
                height={80}
                loading="eager"
                decoding="async"
              />
            ) : (
              <span class="font-bold text-xl tracking-tight transition-transform duration-300 group-hover:scale-[1.02]">
                {headerData.logo.alt}
              </span>
            )
          }
        </a>
      </div>

      <!-- 3. CENTER: Desktop Morphing Zone -->
      <div
        class="hidden lg:flex flex-1 items-center justify-center px-8 min-w-0 relative h-full z-10"
      >
        <div class="header-expanded-center absolute w-full max-w-lg">
          <SearchBar />
        </div>
        {/* Compact menu (classic header, shown on scroll) */}
        {
          condensedMenu && (
            <div class="header-compact-center absolute inset-x-0 flex w-full justify-center" data-nav-compact-from="desktop-nav"></div>
          )
        }
      </div>

      <div
        class="flex items-center justify-end gap-1 sm:gap-3 lg:gap-0 shrink-0 z-30 ml-auto lg:ml-0"
      >
        <div
          class="header-action-morph relative hidden h-10 shrink-0 overflow-hidden lg:block"
          style={`--header-actions-expanded-lg: ${expandedActionsLgWidth}px; --header-actions-expanded-xl: ${expandedActionsXlWidth}px; --header-actions-gap-lg: ${expandedActionsLgWidth > 0 ? 12 : 0}px; --header-actions-gap-xl: ${expandedActionsXlWidth > 0 ? 12 : 0}px;`}
        >
          <button
            id="scrolled-search-trigger"
            type="button"
            class="header-scroll-search absolute inset-y-0 right-0 flex h-10 w-10 items-center justify-center rounded-full text-muted-foreground hover:bg-muted hover:text-foreground"
            aria-label="Search"
            aria-haspopup="dialog"
          >
            <Search className="h-5 w-5 stroke-[1.5]" />
          </button>

          <div
            class="header-expanded-actions absolute inset-y-0 left-0 flex items-center gap-3"
          >
            {
              phoneHref && (
                <a
                  href={phoneHref}
                  class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-full border border-input bg-background text-muted-foreground transition-colors duration-200 hover:border-primary/50 hover:text-foreground xl:flex"
                  aria-label={`Call ${headerData.contact.phone}`}
                  title={headerData.contact.phone}
                >
                  <Phone className="h-4 w-4 stroke-[1.5]" />
                </a>
              )
            }
          </div>
        </div>

        <div
          data-header-action-group
          class="group relative flex h-11 shrink-0 items-center rounded-full bg-card-foreground py-1 pl-1 pr-1 text-card shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl lg:pr-1.5"
        >
          <a
            id="account-link"
            data-header-account
            href="/account"
            data-astro-prefetch={getStorefrontPrefetchAttribute(
              "/account",
              Astro.url,
            )}
            class="flex h-11 w-11 items-center justify-center rounded-full text-card/80 transition-colors duration-200 hover:bg-card/10 hover:text-card lg:mr-1"
            aria-label="My Account"
            title="My Account"
          >
            <svg
              class="h-4 w-4 lg:h-[18px] lg:w-[18px]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
              ></path>
            </svg>
          </a>

          <button
            type="button"
            id="cart-button"
            data-header-cart
            class="relative flex h-11 min-w-11 cursor-pointer items-center gap-2 rounded-full pl-1.5 active:scale-[0.98] lg:gap-3 lg:pl-2"
            aria-label="Open shopping cart"
            aria-haspopup="dialog"
          >
            <span
              id="cart-total-display"
              aria-hidden="true"
              class="hidden md:block text-[14px] font-bold tracking-tight whitespace-nowrap tabular-nums text-card"
            >
              0
            </span>

            <span class="hidden md:block h-5 w-px bg-card/20"></span>

            <div
              class="relative w-7 h-7 lg:w-8 lg:h-8 shrink-0 flex items-center justify-center bg-card/10 rounded-full hover:bg-card/20 transition-colors"
            >
              <ShoppingCart className="h-3.5 w-3.5 lg:h-4 lg:w-4 stroke-2" />
              <span
                id="cart-count"
                aria-hidden="true"
                class="absolute -top-1 -right-1 flex h-3.5 w-3.5 lg:h-4 lg:w-4 min-w-3.5 lg:min-w-4 items-center justify-center rounded-full bg-destructive text-destructive-foreground px-0.5 text-[9px] lg:text-[10px] font-bold ring-2 ring-card-foreground transition-all duration-300 scale-0 opacity-0 shadow-sm"
              >
                0
              </span>
            </div>
          </button>
        </div>
      </div>
    </div>

    {
      menuRow && (
        <div class="header-full-nav-row hidden border-t border-border lg:block">
          {/* The menu row is the mega panels' anchor (they span it). */}
          <div class="py-2 flex justify-center relative z-50">
            <slot name="desktop-nav-full" />
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .header-expanded-center,
  .header-compact-center {
    will-change: opacity, transform;
  }

  .header-expanded-center {
    visibility: visible;
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 160ms linear 40ms,
      transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1) 40ms,
      visibility 0s linear 40ms;
  }

  .header-compact-center {
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateY(0.5rem) scale(0.98);
    transition:
      opacity 160ms linear,
      transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1),
      visibility 0s linear 160ms;
  }

  #main-header[data-header-condense].is-scrolled .header-expanded-center {
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.5rem) scale(0.96);
    transition:
      opacity 160ms linear,
      transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1),
      visibility 0s linear 160ms;
  }

  #main-header[data-header-condense].is-scrolled .header-compact-center {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 160ms linear 40ms,
      transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1) 40ms,
      visibility 0s linear 40ms;
  }

  /* Row heights from header-variants HEADER_GEOMETRY. They ease with the
     same transition as the scroll reserve under the header (HeaderLayout),
     so the two sum to the same flow height in every frame. */
  .header-row {
    height: var(--hdr-phone-bar, 3.5rem);
    transition: height var(--hdr-condense-duration, 300ms) var(--hdr-condense-easing, ease);
  }

  @media (max-width: 63.99rem) {
    #main-header.is-scrolled .header-row {
      height: var(--hdr-phone-bar-condensed, 3rem);
    }
  }

  @media (min-width: 64rem) {
    .header-row {
      height: var(--hdr-classic-bar, 4.5rem);
    }

    #main-header.is-scrolled .header-row {
      height: var(--hdr-classic-bar-condensed, 4rem);
    }
  }

  .header-full-nav-row {
    box-sizing: border-box;
    overflow: visible;
    border-top-width: 1px;
    opacity: 1;
    transition:
      height var(--hdr-condense-duration, 300ms) var(--hdr-condense-easing, ease),
      opacity 120ms ease,
      border-color 120ms ease;
  }

  /* A row that folds has the height the scroll reserve holds: its border,
     its padding and a menu link (the same --nav-link-height DesktopNav
     paints with), never a measured number. */
  #main-header[data-header-condense] .header-full-nav-row {
    height: var(--hdr-classic-menu-row);
  }

  #main-header[data-header-condense].is-scrolled .header-full-nav-row {
    height: 0;
    overflow: hidden;
    border-top-width: 0;
    border-color: transparent;
    opacity: 0;
    transition-delay: 0ms, 0ms, 0ms;
  }

  .header-action-morph {
    width: var(--header-actions-expanded-lg);
    margin-right: var(--header-actions-gap-lg);
    transition:
      width 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
      margin-right 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .header-expanded-actions,
  .header-scroll-search {
    will-change: opacity, transform;
  }

  .header-expanded-actions {
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 160ms linear 40ms,
      transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1) 40ms,
      visibility 0s linear 40ms;
  }

  .header-scroll-search {
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateX(-0.5rem);
    transition:
      opacity 160ms linear,
      transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1),
      visibility 0s linear 160ms;
  }

  #main-header[data-header-condense].is-scrolled .header-action-morph {
    width: 2.5rem;
    margin-right: 0.75rem;
  }

  #main-header[data-header-condense].is-scrolled .header-expanded-actions {
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      opacity 160ms linear,
      transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1),
      visibility 0s linear 160ms;
  }

  #main-header[data-header-condense].is-scrolled .header-scroll-search {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 160ms linear 40ms,
      transform 200ms cubic-bezier(0.25, 0.1, 0.25, 1) 40ms,
      visibility 0s linear 40ms;
  }

  .storefront-header-logo {
    max-width: var(--header-logo-mobile-width);
  }

  @media (max-width: 21rem) {
    .storefront-header-logo {
      max-width: min(var(--header-logo-mobile-width), 5.75rem);
    }
  }

  @media (min-width: 64rem) {
    .storefront-header-logo {
      max-width: var(--header-logo-width);
    }
  }

  @media (min-width: 80rem) {
    .header-action-morph {
      width: var(--header-actions-expanded-xl);
      margin-right: var(--header-actions-gap-xl);
    }

    #main-header[data-header-condense].is-scrolled .header-action-morph {
      width: 2.5rem;
      margin-right: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-expanded-center,
    .header-compact-center,
    .header-action-morph,
    .header-expanded-actions,
    .header-scroll-search {
      transition: none;
    }
  }
</style>
