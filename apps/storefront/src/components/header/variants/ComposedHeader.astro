---
// The header, in one of three layouts (header-variants.ts) drawn from one
// spec: logo, search, account and cart, and the menu (slot "menu", in the
// main row or its own row). Tokens paint it: a toned row uses the header
// colours (`--theme-header-*`, an AA pair); the search field is always the
// card or muted surface. One icon set, one gap, one order everywhere:
// menu, logo, search, account, cart.
//
// Sticky: the whole header, or only the menu row when it has one of its own
// (`stickyMenuRow`): the top row scrolls away and the category bar stays;
// then #main-header is `display: contents` on computers and the menu row is
// the sticky part (HeaderLayout measures it).
import type { NavigationItem } from "@/lib/api";
import type {
  StorefrontHeaderRenderer,
  StorefrontNavigationRenderer,
} from "@scalius/shared/storefront-theme";
import { mediaImageSrcSet, mediaImageUrl } from "@/lib/media-url";
import {
  getMobileHeaderLogoWidth,
  normalizeHeaderLogoWidth,
} from "@scalius/shared/brand-presentation";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import HeaderSearch from "../HeaderSearch.astro";
import type { HeaderLogo, HeaderSpec } from "../header-variants";

interface Props {
  logo: HeaderLogo;
  variantId: string;
  spec: HeaderSpec;
  /** The coarse header facts (`resolved.layout.header`). */
  headerStyle: StorefrontHeaderRenderer;
  navigationStyle: StorefrontNavigationRenderer;
  /** Render the menu slot (a menu exists and belongs in the header). */
  hasMenu: boolean;
  /** The menu sits in its own row (the layout's, or a category bar that needs one). */
  menuPlacement: "inline" | "row";
  stickyMenuRow: boolean;
  /** Top-level menu items, for the department-scoped search. */
  departments: NavigationItem[];
  /** Phone bar icons the bottom tabs already carry ("account cart"). */
  phoneDrop: string;
}

const {
  logo,
  variantId,
  spec,
  headerStyle,
  navigationStyle,
  hasMenu,
  menuPlacement,
  stickyMenuRow,
  departments,
  phoneDrop,
} = Astro.props;

const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).chrome;
const logoWidth = normalizeHeaderLogoWidth(logo.width);
const mobileLogoWidth = getMobileHeaderLogoWidth(logoWidth);
const logoSrcSet = mediaImageSrcSet(logo.src);
const inlineMenu = hasMenu && menuPlacement === "inline";
const menuRow = hasMenu && menuPlacement === "row";
const accountPrefetch = getStorefrontPrefetchAttribute("/account", Astro.url);
// A search icon sits with the account and cart icons (one gap); a field has its own place.
const searchIcon = spec.search === "icon";
const iconsTogether = searchIcon && spec.layout !== "centered-logo";
const style = `--hdr-main: ${spec.mainHeight}rem; --hdr-menu: ${spec.menuHeight || 2.75}rem; --header-logo-width: ${logoWidth}px; --header-logo-mobile-width: ${mobileLogoWidth}px;`;
---

<div
  id="main-header"
  class="hdr group/header"
  data-header-style={headerStyle}
  data-header-variant={variantId}
  data-navigation={navigationStyle}
  data-hdr-search={spec.search}
  data-hdr-sticky={stickyMenuRow ? "menu-row" : "header"}
  data-phone-drop={phoneDrop || undefined}
  style={style}
>
  <div class="hdr-main" data-tone={spec.toneRow ? "tone" : "surface"}>
    <div class="hdr-inner hdr-bar">
      <div class="hdr-phone-start">
        <button
          id="mobile-menu-toggle"
          type="button"
          class="hdr-icon-button"
          aria-label={copy.header.openMenu}
          aria-haspopup="dialog"
          aria-controls="mobile-menu-panel"
          aria-expanded="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <noscript>
          <a href="#mobile-menu-panel" class="hdr-icon-button" aria-label={copy.header.openMenu}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
          </a>
        </noscript>
        {
          spec.phoneSearch === "none" && (
            <>
              <button id="mobile-search-toggle" type="button" class="hdr-icon-button" aria-label={copy.header.search} aria-haspopup="dialog">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-3.5-3.5" />
                </svg>
              </button>
              <noscript>
                <a href="/search" class="hdr-icon-button" aria-label={copy.header.search}>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-3.5-3.5" />
                  </svg>
                </a>
              </noscript>
            </>
          )
        }
      </div>

      <a href="/" class="hdr-logo">
        {
          logo.src ? (
            <img
              src={mediaImageUrl(logo.src, 320)}
              srcset={logoSrcSet}
              sizes={logoSrcSet ? `(min-width: 1024px) ${logoWidth}px, ${mobileLogoWidth}px` : undefined}
              alt={logo.alt}
              class="hdr-logo-image"
              width={240}
              height={80}
              loading="eager"
              decoding="async"
            />
          ) : (
            <span class="hdr-logo-text">{logo.alt}</span>
          )
        }
      </a>

      {inlineMenu && (
        <div class="hdr-inline-menu">
          <slot name="menu" />
        </div>
      )}

      {!iconsTogether && (
        <div class:list={["hdr-search", searchIcon && "hdr-search--icon"]}>
          <HeaderSearch shape={spec.search} id="header-search-input" departments={departments} />
        </div>
      )}

      <div class="hdr-actions">
        {iconsTogether && (
          <div class="hdr-search hdr-search--icon">
            <HeaderSearch shape="icon" id="header-search-input" />
          </div>
        )}
        <a
          id="account-link"
          href="/account"
          class="hdr-util"
          data-header-account
          data-astro-prefetch={accountPrefetch}
        >
          <span class="hdr-util-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M20 21a8 8 0 0 0-16 0" /></svg>
          </span>
          <span class="hdr-util-text">{copy.header.account}</span>
        </a>

        <button
          type="button"
          id="cart-button"
          class="hdr-util hdr-cart"
          data-header-cart
          aria-haspopup="dialog"
        >
          <span class="hdr-util-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <circle cx="8" cy="21" r="1" />
              <circle cx="19" cy="21" r="1" />
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />
            </svg>
            <span id="cart-count" class="hdr-cart-count scale-0 opacity-0"></span>
          </span>
          <span class="hdr-util-text">
            {spec.cartTotal ? (
              <>
                <small>{copy.header.cart}</small>
                <bdi dir="ltr"><strong id="cart-total-display" class="tabular-nums">0</strong></bdi>
              </>
            ) : (
              copy.header.cart
            )}
          </span>
        </button>
      </div>
    </div>
  </div>

  {
    spec.phoneSearch === "sticky" && (
      <div class="hdr-phone-search" data-tone={spec.toneRow ? "tone" : "surface"}>
        <HeaderSearch shape={spec.search === "icon" ? "field" : spec.search} id="header-search-input-phone" />
      </div>
    )
  }

  {menuRow && (
    <div class="hdr-menu-row" data-tone="surface">
      <div class="hdr-inner hdr-menu-inner">
        <slot name="menu" />
      </div>
    </div>
  )}
</div>

<slot name="phone-extras" />

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: var(--background);
    color: var(--foreground);
    transition: box-shadow 300ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .hdr.is-scrolled {
    box-shadow: 0 4px 12px -6px rgb(0 0 0 / 0.18);
  }

  .hdr-inner {
    width: 100%;
    max-width: var(--theme-container-width, 80rem);
    margin-inline: auto;
    padding-inline: var(--theme-gutter-phone, 1rem);
  }

  @media (min-width: 40rem) {
    .hdr-inner {
      padding-inline: var(--theme-gutter-tablet, 1.5rem);
    }
  }

  @media (min-width: 64rem) {
    .hdr-inner {
      padding-inline: var(--theme-gutter-desktop, 2rem);
    }
  }

  /* Toned rows: the header tone, and the ink every menu in them reads. */
  [data-tone="tone"] {
    --nav-ink: var(--theme-header-foreground);
    --nav-ink-muted: var(--theme-header-foreground);
    background: var(--theme-header-background);
    color: var(--theme-header-foreground);
  }

  [data-tone="surface"] {
    background: var(--background);
    color: var(--foreground);
  }

  /* Panels drop below freely but never widen the page (no JavaScript
     needed; nav-menus.ts also flips them at the viewport's end). */
  .hdr-main,
  .hdr-menu-row {
    overflow-x: clip;
  }

  .hdr-main {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
  }

  /* ── The bar: phones first ─────────────────────────────────────────── */

  .hdr-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    /* Heights from header-variants HEADER_GEOMETRY, easing with the same
       transition as the scroll reserve under the header. */
    height: var(--hdr-phone-bar, 3.5rem);
    transition: height var(--hdr-condense-duration, 300ms) var(--hdr-condense-easing, ease);
  }

  .hdr.is-scrolled .hdr-bar {
    height: var(--hdr-phone-bar-condensed, 3rem);
  }

  .hdr-phone-start {
    display: flex;
    align-items: center;
    margin-inline-start: -0.5rem;
  }

  .hdr-icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    color: inherit;
  }

  .hdr-icon-button:hover,
  .hdr-util:hover .hdr-util-icon {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .hdr svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hdr-logo {
    position: absolute;
    inset-inline-start: 50%;
    top: 50%;
    z-index: 1;
    display: flex;
    align-items: center;
    max-width: calc(100% - 12rem);
    transform: translate(-50%, -50%);
    color: inherit;
  }

  :root[dir="rtl"] .hdr-logo {
    transform: translate(50%, -50%);
  }

  .hdr-logo-image {
    width: auto;
    height: auto;
    max-height: 2rem;
    max-width: var(--header-logo-mobile-width);
    object-fit: contain;
  }

  @media (max-width: 21rem) {
    .hdr-logo-image {
      max-width: min(var(--header-logo-mobile-width), 5.75rem);
    }
  }

  .hdr-logo-text {
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .hdr-inline-menu,
  .hdr-search {
    display: none;
  }

  /* The words of a utility are its accessible name (WCAG 2.5.3: the name
     holds the visible text). The header shows the icon alone: the words stay
     in the page for assistive technology, visually hidden, never display:none. */
  .hdr-util-text {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hdr-actions {
    display: flex;
    align-items: center;
    gap: 0;
    margin-inline-start: auto;
    margin-inline-end: -0.5rem;
  }

  .hdr-util {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: inherit;
    text-align: start;
  }

  .hdr-util-icon {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    transition: background-color 150ms ease;
  }

  .hdr-util:focus-visible,
  .hdr-icon-button:focus-visible,
  .hdr-logo:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: var(--radius);
  }

  .hdr-cart-count {
    position: absolute;
    top: 0.25rem;
    inset-inline-end: 0.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.125rem;
    height: 1.125rem;
    padding-inline: 0.25rem;
    border-radius: 9999px;
    background: var(--destructive);
    color: var(--destructive-foreground);
    font-size: 0.625rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition:
      scale 200ms ease,
      opacity 200ms ease,
      transform 150ms ease;
  }

  /* Phones: a search row under the bar that folds away on scroll, so the
     sticky stack stays under 120px. */
  .hdr-phone-search {
    padding: 0 var(--theme-gutter-phone, 1rem) 0.5rem;
  }

  /* The sticky row is exactly the height the scroll reserve holds; it
     folds with the reserve's transition (hidden once folded). */
  .hdr > .hdr-phone-search {
    box-sizing: border-box;
    height: var(--hdr-phone-search-row, 3.25rem);
    transition:
      height var(--hdr-condense-duration, 300ms) var(--hdr-condense-easing, ease),
      padding-bottom var(--hdr-condense-duration, 300ms) var(--hdr-condense-easing, ease),
      visibility 0s linear;
  }

  .hdr.is-scrolled > .hdr-phone-search {
    height: 0;
    padding-bottom: 0;
    overflow: hidden;
    visibility: hidden;
    transition-delay: 0s, 0s, var(--hdr-condense-duration, 300ms);
  }

  @media (min-width: 64rem) {
    .hdr-phone-search,
    .hdr-phone-start {
      display: none;
    }
  }

  /* ── Computers ─────────────────────────────────────────────────────── */

  .hdr-menu-row {
    display: none;
  }

  @media (min-width: 64rem) {
    .hdr-bar,
    .hdr.is-scrolled .hdr-bar {
      height: var(--hdr-main);
      gap: 1.5rem;
    }

    .hdr-logo,
    :root[dir="rtl"] .hdr-logo {
      position: static;
      flex-shrink: 0;
      max-width: none;
      transform: none;
    }

    .hdr-logo-image {
      max-height: 2.75rem;
      max-width: var(--header-logo-width);
    }

    .hdr-inline-menu {
      display: flex;
      flex: 1 1 auto;
      min-width: 0;
      align-items: center;
    }

    .hdr-search {
      display: flex;
      flex: 1 1 36rem;
      min-width: 12rem;
      max-width: 45rem;
    }

    .hdr-search--icon {
      flex: 0 0 auto;
      min-width: 0;
    }

    /* Beside an inline menu the search is a fixed, modest field. */
    .hdr-inline-menu ~ .hdr-search:not(.hdr-search--icon) {
      flex: 0 1 19rem;
    }

    .hdr-actions {
      gap: 0.25rem;
      margin-inline-end: 0;
    }

    /* The centred logo: search at the start, the icons at the end. */
    .hdr[data-header-variant="centered-logo"] .hdr-bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    .hdr[data-header-variant="centered-logo"] .hdr-search {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      width: 100%;
      max-width: 19rem;
    }

    .hdr[data-header-variant="centered-logo"] .hdr-search--icon {
      width: auto;
    }

    .hdr[data-header-variant="centered-logo"] .hdr-logo {
      grid-column: 2;
      grid-row: 1;
    }

    .hdr[data-header-variant="centered-logo"] .hdr-actions {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }

    .hdr[data-header-variant="centered-logo"] .hdr-menu-inner {
      justify-content: center;
    }

    .hdr-menu-row {
      display: block;
      position: relative;
      z-index: 10;
      border-bottom: 1px solid var(--border);
    }

    .hdr-menu-inner {
      display: flex;
      align-items: center;
      min-height: var(--hdr-menu);
    }

    /* Only the menu row stays: the top row scrolls away. */
    .hdr[data-hdr-sticky="menu-row"] {
      display: contents;
    }

    .hdr[data-hdr-sticky="menu-row"] .hdr-menu-row {
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .hdr[data-hdr-sticky="menu-row"].is-scrolled .hdr-menu-row {
      box-shadow: 0 4px 12px -6px rgb(0 0 0 / 0.18);
    }

    /* A cart with its running total reads it beside the icon. */
    .hdr-cart:has(#cart-total-display) .hdr-util-text {
      position: static;
      inline-size: auto;
      block-size: auto;
      margin: 0;
      overflow: visible;
      clip-path: none;
      display: flex;
      flex-direction: column;
      padding-inline-end: 0.5rem;
      line-height: 1.15;
    }

    .hdr-cart:has(#cart-total-display) .hdr-util-text small {
      font-size: var(--theme-text-xs, 0.75rem);
    }

    .hdr-cart:has(#cart-total-display) .hdr-util-text strong {
      font-size: var(--theme-text-sm, 0.875rem);
      font-weight: 700;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr-cart-count {
      transition: none;
    }
  }
</style>
