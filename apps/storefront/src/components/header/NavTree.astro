---
// The header menu as an accordion tree, for the phone drawer and the desktop
// sidebar. A parent row is its link plus a disclosure button (or just the
// button when it has no link); the section holding the current page renders
// expanded, so the buyer sees where they are without any script.
import type { NavigationItem } from "@/lib/api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import {
  ariaCurrent,
  navigationChildren,
  navigationCurrent,
  navigationLinkAttributes,
} from "./navigation-state";

interface Props {
  items: NavigationItem[];
  /** Unique per rendered tree; prefixes every id inside. */
  idPrefix: string;
  variant: "drawer" | "sidebar";
  depth?: number;
}

const { items = [], idPrefix, variant, depth = 0 } = Astro.props;
const visible = items.filter((item) => item?.title);
---

<ul class:list={["nav-tree", `nav-tree--${variant}`, depth > 0 && "nav-tree--nested"]} data-depth={depth}>
  {
    visible.map((item, index) => {
      const id = `${idPrefix}-${index}`;
      const children = navigationChildren(item);
      const state = navigationCurrent(item, Astro.url);
      const expanded = children.length > 0 && state !== null;
      return (
        <li>
          <div class="nav-tree-row">
            {item.href ? (
              <a
                href={item.href}
                class="nav-tree-link"
                aria-current={ariaCurrent(state)}
                data-astro-prefetch={getStorefrontPrefetchAttribute(item.href, Astro.url)}
                {...navigationLinkAttributes(item)}
              >
                {item.title}
              </a>
            ) : (
              children.length === 0 && <span class="nav-tree-link">{item.title}</span>
            )}
            {children.length > 0 && (
              <button
                type="button"
                class:list={["nav-tree-toggle", !item.href && "nav-tree-link"]}
                aria-expanded={expanded ? "true" : "false"}
                aria-controls={`${id}-panel`}
                data-disclosure="tree"
              >
                {item.href ? <span class="sr-only">{item.title} submenu</span> : <span>{item.title}</span>}
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </button>
            )}
          </div>
          {children.length > 0 && (
            <div id={`${id}-panel`} class="nav-tree-panel" hidden={!expanded}>
              <Astro.self items={children} idPrefix={id} variant={variant} depth={depth + 1} />
            </div>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .nav-tree--nested {
    margin: 0.125rem 0 0.375rem 0.75rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--border);
  }

  .nav-tree-row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-tree-link {
    display: flex;
    flex: 1;
    align-items: center;
    min-width: 0;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius);
    color: inherit;
    text-align: start;
    overflow-wrap: anywhere;
  }

  .nav-tree-toggle {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    color: var(--muted-foreground);
  }

  .nav-tree-toggle.nav-tree-link {
    justify-content: space-between;
    width: auto;
    color: inherit;
  }

  .nav-tree-toggle svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms ease;
  }

  .nav-tree-toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .nav-tree .nav-tree-link:is(a, button):hover,
  .nav-tree .nav-tree-toggle:hover {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .nav-tree-link:focus-visible,
  .nav-tree-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .nav-tree-link[aria-current="page"] {
    font-weight: 600;
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .nav-tree-panel:not([hidden]) {
    animation: nav-tree-open 180ms ease-out;
  }

  @keyframes nav-tree-open {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  /* Drawer: large, thumb-friendly rows. */
  .nav-tree--drawer:not(.nav-tree--nested) > li > .nav-tree-row .nav-tree-link {
    min-height: 3rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: var(--theme-label-tracking, 0);
  }

  .nav-tree--drawer.nav-tree--nested .nav-tree-link {
    font-size: 0.9375rem;
  }

  :where(.nav-tree--drawer .nav-tree--nested .nav-tree--nested, .nav-tree--sidebar.nav-tree--nested) .nav-tree-link {
    color: var(--muted-foreground);
  }

  /* Sidebar: a quiet list; the current section reads at a glance. */
  .nav-tree--sidebar .nav-tree-link {
    font-size: 0.875rem;
  }

  .nav-tree--sidebar:not(.nav-tree--nested) > li > .nav-tree-row .nav-tree-link {
    font-weight: 500;
    letter-spacing: var(--theme-label-tracking, 0);
  }

  .nav-tree--sidebar .nav-tree-link[aria-current] {
    font-weight: 600;
    color: var(--foreground);
  }

  .nav-tree--sidebar .nav-tree-link[aria-current="page"] {
    color: var(--accent-foreground);
  }

  /* A mouse needs less than a thumb; touch keeps 44px (WCAG 2.5.5). */
  @media (pointer: fine) {
    .nav-tree--sidebar .nav-tree-link,
    .nav-tree--sidebar .nav-tree-toggle {
      min-height: 2.25rem;
      height: auto;
    }

    .nav-tree--sidebar .nav-tree-toggle:not(.nav-tree-link) {
      width: 2.25rem;
      align-self: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-tree-toggle svg {
      transition: none;
    }

    .nav-tree-panel:not([hidden]) {
      animation: none;
    }
  }
</style>
