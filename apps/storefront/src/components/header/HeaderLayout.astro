---
import SearchBar from "../search/SearchBar.astro";
import { Phone, ShoppingCart, Menu, Search, Check, Copy } from "lucide-react";
import type { HeaderData, SocialLink } from "@/lib/api";
import { getOptimizedImageUrl } from "@/lib/image-optimizer";
import {
  getMobileHeaderLogoWidth,
  normalizeHeaderLogoWidth,
} from "@scalius/shared/brand-presentation";

interface Props {
  headerData: HeaderData;
}

const { headerData } = Astro.props;
const logoWidth = normalizeHeaderLogoWidth(headerData.logo.width);
const mobileLogoWidth = getMobileHeaderLogoWidth(logoWidth);
const socialLinks = (headerData.social ?? []).filter(
  (item): item is SocialLink & { url: string } => Boolean(item.url),
);
const hasDesktopPhone =
  headerData.contact.isEnabled !== false && Boolean(headerData.contact.phone);
const desktopSocialWidth =
  socialLinks.length > 0
    ? socialLinks.length * 36 + (socialLinks.length - 1) * 4
    : 0;
const expandedActionsLgWidth = desktopSocialWidth;
const expandedActionsXlWidth =
  desktopSocialWidth +
  (desktopSocialWidth > 0 && hasDesktopPhone ? 12 : 0) +
  (hasDesktopPhone ? 40 : 0);
---

{
  headerData.topBar.isEnabled !== false &&
    headerData.topBar.text &&
    headerData.topBar.text.trim().length > 0 && (
      <div class="relative z-50 bg-primary text-primary-foreground overflow-hidden shrink-0 w-full h-8 sm:h-9 flex items-center justify-center border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 w-full">
          <p class="text-[10px] sm:text-xs font-medium text-center tracking-[0.15em] uppercase opacity-90 truncate">
            {headerData.topBar.text}
          </p>
        </div>
      </div>
    )
}

<div
  id="main-header"
  class="sticky top-0 z-50 w-full bg-background/95 backdrop-blur-xl border-b border-border transition-[box-shadow,background-color,border-color] duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1)] group/header"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- ROW 1 -->
    <div
      class="flex items-center justify-between h-14 lg:h-18 group-[.is-scrolled]/header:lg:h-16 gap-4 relative z-20 transition-[height] duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1)]"
    >
      <div class="flex items-center shrink-0 lg:hidden z-30 gap-2">
        <button
          id="mobile-menu-toggle"
          type="button"
          class="-ml-2 flex h-11 w-11 items-center justify-center rounded-full text-foreground transition-colors hover:bg-muted active:bg-accent"
          aria-label="Open menu"
          aria-controls="mobile-menu-panel"
          aria-expanded="false"
        >
          <Menu className="h-6 w-6 stroke-[1.5]" />
        </button>

        <button
          id="mobile-search-toggle"
          type="button"
          class="flex h-11 w-11 items-center justify-center rounded-full text-foreground transition-colors hover:bg-muted active:bg-accent"
          aria-label="Search"
        >
          <Search className="h-5 w-5 stroke-[1.5]" />
        </button>
      </div>

      <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 lg:static lg:translate-x-0 lg:translate-y-0 shrink-0 z-20 flex items-center justify-center lg:justify-start"
      >
        <a href="/" class="block group" aria-label="Go to homepage">
          {
            headerData.logo.src ? (
              <img
                src={getOptimizedImageUrl(headerData.logo.src, {
                  width: 240,
                  height: 80,
                  fit: "scale-down",
                })}
                alt={headerData.logo.alt}
                class="storefront-header-logo h-auto w-auto max-h-8 lg:max-h-10 object-contain transition-[max-height,transform] duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1)] group-hover:scale-[1.02] group-[.is-scrolled]/header:lg:max-h-9"
                style={`--header-logo-width: ${logoWidth}px; --header-logo-mobile-width: ${mobileLogoWidth}px;`}
                width={240}
                height={80}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <span class="font-bold text-xl tracking-tight transition-transform duration-300 group-hover:scale-[1.02]">
                {headerData.logo.alt}
              </span>
            )
          }
        </a>
      </div>

      <!-- 3. CENTER: Desktop Morphing Zone -->
      <div
        class="hidden lg:flex flex-1 items-center justify-center px-8 min-w-0 relative h-full z-10"
      >
        <div
          class="header-expanded-center absolute w-full max-w-lg"
        >
          <SearchBar />
        </div>
        <!-- Compact Nav (Visible on Scroll) -->
        <div
          class="header-compact-center absolute inset-x-0 flex w-full justify-center"
        >
          <slot name="desktop-nav-compact" />
        </div>
      </div>

      <div
        class="flex items-center justify-end gap-1 sm:gap-3 lg:gap-0 shrink-0 z-30 ml-auto lg:ml-0"
      >
        <div
          class="header-action-morph relative hidden h-10 shrink-0 overflow-hidden lg:block"
          style={`--header-actions-expanded-lg: ${expandedActionsLgWidth}px; --header-actions-expanded-xl: ${expandedActionsXlWidth}px; --header-actions-gap-lg: ${expandedActionsLgWidth > 0 ? 12 : 0}px; --header-actions-gap-xl: ${expandedActionsXlWidth > 0 ? 12 : 0}px;`}
        >
          <button
            id="scrolled-search-trigger"
            type="button"
            class="header-scroll-search absolute inset-y-0 right-0 flex h-10 w-10 items-center justify-center rounded-full text-muted-foreground hover:bg-muted hover:text-foreground"
            aria-label="Search"
          >
            <Search className="h-5 w-5 stroke-[1.5]" />
          </button>

          <div class="header-expanded-actions absolute inset-y-0 left-0 flex items-center gap-3">
            {
              socialLinks.length > 0 && (
                <div class="flex items-center gap-1">
                  {socialLinks.map((item) => {
                    const displayTitle =
                      item.label || item.platform || "Social";
                    const href = item.url.startsWith("http")
                      ? item.url
                      : `https://${item.url}`;

                    return (
                      <a
                        href={href}
                        class="group flex items-center justify-center h-9 w-9 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted transition-all duration-200"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={displayTitle}
                        title={displayTitle}
                      >
                        {item.iconUrl ? (
                          <img
                            src={getOptimizedImageUrl(item.iconUrl, {
                              width: 32,
                              height: 32,
                              fit: "contain",
                            })}
                            alt=""
                            aria-hidden="true"
                            class="w-4 h-4 object-contain"
                            loading="lazy"
                          />
                        ) : (
                          <span aria-hidden="true" class="w-4 h-4 flex items-center justify-center text-xs font-bold uppercase">
                            {displayTitle.charAt(0)}
                          </span>
                        )}
                      </a>
                    );
                  })}
                </div>
              )
            }

            {
              hasDesktopPhone && headerData.contact.phone && (
                <button
                  type="button"
                  id="desktop-phone-btn"
                  data-phone={headerData.contact.phone}
                  class="group relative hidden h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full border border-input bg-background text-muted-foreground transition-all duration-200 hover:border-primary/50 hover:text-foreground hover:shadow-sm active:scale-95 xl:flex"
                  aria-label="Copy phone number"
                  title={headerData.contact.phone}
                >
                  <div
                    class="absolute inset-0 flex items-center justify-center transition-transform duration-300 group-hover:-translate-y-full"
                    id="phone-icon-normal"
                  >
                    <Phone className="h-4 w-4 stroke-[1.5]" />
                  </div>
                  <div
                    class="absolute inset-0 flex items-center justify-center translate-y-full transition-transform duration-300 group-hover:translate-y-0"
                    id="phone-icon-hover"
                  >
                    <Copy className="h-4 w-4 stroke-2" />
                  </div>
                  <div
                    class="absolute inset-0 flex items-center justify-center translate-y-full transition-transform duration-200 text-primary bg-primary/10"
                    id="phone-icon-success"
                  >
                    <Check className="h-4 w-4 stroke-[2.5]" />
                  </div>
                </button>
              )
            }
          </div>
        </div>

        <div
          class="group relative flex h-11 shrink-0 items-center rounded-full bg-card-foreground py-1 pl-1 pr-1 text-card shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl lg:pr-1.5"
        >
          <a
            id="account-link"
            href="/account"
            class="flex h-11 w-11 items-center justify-center rounded-full text-card/80 transition-colors duration-200 hover:bg-card/10 hover:text-card lg:mr-1"
            aria-label="My Account"
            title="My Account"
          >
            <svg
              class="h-4 w-4 lg:h-[18px] lg:w-[18px]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
              ></path>
            </svg>
          </a>

          <button
            type="button"
            id="cart-button"
            class="relative flex h-11 min-w-11 cursor-pointer items-center gap-2 pl-1.5 outline-none active:scale-[0.98] lg:gap-3 lg:pl-2"
            aria-label="Open shopping cart"
          >
            <span
              id="cart-total-display"
              class="hidden md:block text-[14px] font-bold tracking-tight whitespace-nowrap tabular-nums text-card"
            >
              0
            </span>

            <span class="hidden md:block h-5 w-px bg-card/20"></span>

            <div
              class="relative w-7 h-7 lg:w-8 lg:h-8 shrink-0 flex items-center justify-center bg-card/10 rounded-full hover:bg-card/20 transition-colors"
            >
              <ShoppingCart className="h-3.5 w-3.5 lg:h-4 lg:w-4 stroke-2" />
              <span
                id="cart-count"
                class="absolute -top-1 -right-1 flex h-3.5 w-3.5 lg:h-4 lg:w-4 min-w-3.5 lg:min-w-4 items-center justify-center rounded-full bg-destructive text-destructive-foreground px-0.5 text-[9px] lg:text-[10px] font-bold ring-2 ring-card-foreground transition-all duration-300 scale-0 opacity-0 shadow-sm"
              >
                0
              </span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <div
      class="header-full-nav-row hidden border-t border-border lg:block"
    >
      <div class="py-2 flex justify-center relative z-50">
        <slot name="desktop-nav-full" />
      </div>
    </div>
  </div>
</div>

<style>
  .header-expanded-center,
  .header-compact-center {
    transition:
      opacity 120ms ease,
      transform 180ms cubic-bezier(0.25, 0.1, 0.25, 1),
      visibility 0s linear;
  }

  .header-expanded-center {
    visibility: visible;
    opacity: 1;
    transform: translateY(0) scale(1);
    transition-delay: 0ms, 0ms, 0ms;
  }

  .header-compact-center {
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateY(0.5rem) scale(0.98);
    transition-delay: 0ms, 0ms, 120ms;
  }

  #main-header.is-scrolled .header-expanded-center {
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.5rem) scale(0.96);
    transition-delay: 0ms, 0ms, 120ms;
  }

  #main-header.is-scrolled .header-compact-center {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    transform: translateY(0) scale(1);
    transition-delay: 0ms, 0ms, 0ms;
  }

  .header-full-nav-row {
    max-height: 3.5rem;
    overflow: visible;
    border-top-width: 1px;
    opacity: 1;
    transition:
      max-height 300ms cubic-bezier(0.25, 0.1, 0.25, 1),
      opacity 120ms ease,
      border-top-width 120ms ease,
      border-color 120ms ease;
  }

  #main-header.is-scrolled .header-full-nav-row {
    max-height: 0;
    overflow: hidden;
    border-top-width: 0;
    border-color: transparent;
    opacity: 0;
    transition-delay: 0ms, 0ms, 0ms, 0ms;
  }

  .header-action-morph {
    width: var(--header-actions-expanded-lg);
    margin-right: var(--header-actions-gap-lg);
    transition:
      width 240ms cubic-bezier(0.25, 0.1, 0.25, 1),
      margin-right 240ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .header-expanded-actions,
  .header-scroll-search {
    transition:
      opacity 120ms ease,
      transform 180ms cubic-bezier(0.25, 0.1, 0.25, 1),
      visibility 0s linear;
  }

  .header-expanded-actions {
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
    transition-delay: 0ms, 0ms, 0ms;
  }

  .header-scroll-search {
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateX(-0.5rem);
    transition-delay: 0ms, 0ms, 120ms;
  }

  #main-header.is-scrolled .header-action-morph {
    width: 2.5rem;
    margin-right: 0.75rem;
  }

  #main-header.is-scrolled .header-expanded-actions {
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateX(0.5rem);
    transition-delay: 0ms, 0ms, 120ms;
  }

  #main-header.is-scrolled .header-scroll-search {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
    transition-delay: 0ms, 0ms, 0ms;
  }

  .storefront-header-logo {
    max-width: var(--header-logo-mobile-width);
  }

  @media (min-width: 64rem) {
    .storefront-header-logo {
      max-width: var(--header-logo-width);
    }
  }

  @media (min-width: 80rem) {
    .header-action-morph {
      width: var(--header-actions-expanded-xl);
      margin-right: var(--header-actions-gap-xl);
    }

    #main-header.is-scrolled .header-action-morph {
      width: 2.5rem;
      margin-right: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-expanded-center,
    .header-compact-center,
    .header-full-nav-row,
    .header-action-morph,
    .header-expanded-actions,
    .header-scroll-search {
      transition: none;
    }
  }
</style>

<script>
  import { toast } from "sonner";
  import { shouldUseCompactHeader } from "./header-scroll-state";

  let isCompact = false;
  let scrollFrame: number | null = null;
  let headerResizeObserver: ResizeObserver | null = null;

  function updateHeaderHeight() {
    const header = document.getElementById("main-header");
    if (!header) return;
    const height = header.offsetHeight;
    document.documentElement.style.setProperty(
      "--header-height",
      `${height}px`,
    );
  }

  function observeHeaderHeight() {
    headerResizeObserver?.disconnect();
    const header = document.getElementById("main-header");
    if (!header || typeof ResizeObserver === "undefined") {
      updateHeaderHeight();
      return;
    }
    headerResizeObserver = new ResizeObserver(updateHeaderHeight);
    headerResizeObserver.observe(header);
    updateHeaderHeight();
  }

  function applyScrollState() {
    scrollFrame = null;
    const header = document.getElementById("main-header");
    if (!header) return;
    const nextCompact = shouldUseCompactHeader(window.scrollY, isCompact);
    if (nextCompact === isCompact) return;
    isCompact = nextCompact;
    header.classList.toggle("is-scrolled", isCompact);
    header.classList.toggle("shadow-md", isCompact);
  }

  function scheduleScrollState() {
    if (scrollFrame !== null) return;
    scrollFrame = window.requestAnimationFrame(applyScrollState);
  }

  const triggerSearch = (e: Event) => {
    e.preventDefault();
    document.dispatchEvent(new CustomEvent("open-search-palette"));
  };

  document
    .getElementById("mobile-search-toggle")
    ?.addEventListener("click", triggerSearch);
  document
    .getElementById("scrolled-search-trigger")
    ?.addEventListener("click", triggerSearch);

  const phoneBtn = document.getElementById("desktop-phone-btn");
  const iconSuccess = document.getElementById("phone-icon-success");
  if (phoneBtn && iconSuccess) {
    phoneBtn.addEventListener("click", async () => {
      const phone = phoneBtn.getAttribute("data-phone");
      if (!phone) return;
      try {
        await navigator.clipboard.writeText(phone);
        iconSuccess.classList.remove("translate-y-full");
        toast.success("Copied to clipboard", { duration: 2000 });
        setTimeout(() => iconSuccess.classList.add("translate-y-full"), 2000);
      } catch {
        window.location.href = `tel:${phone}`;
      }
    });
  }

  window.addEventListener("resize", updateHeaderHeight);
  window.addEventListener("scroll", scheduleScrollState, { passive: true });
  applyScrollState();
  observeHeaderHeight();

  document.addEventListener("astro:page-load", () => {
    isCompact = false;
    applyScrollState();
    observeHeaderHeight();
  });

  // Handle account icon click (check for cs_auth cookie)
  function checkCustomerSession() {
    const hasCookie = document.cookie
      .split(";")
      .some((c) => c.trim().startsWith("cs_auth=1"));
    const accountLink = document.getElementById("account-link");
    if (accountLink) {
      accountLink.onclick = (e) => {
        if (!hasCookie) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent("open-auth-modal"));
        }
      };
    }
  }
  checkCustomerSession();
  window.addEventListener("customer-login", checkCustomerSession);
  window.addEventListener("customer-logout", checkCustomerSession);
  document.addEventListener("astro:page-load", checkCustomerSession);
</script>
