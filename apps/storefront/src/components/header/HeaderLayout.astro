---
// The header block: one component per layout (variants/ComposedHeader.astro,
// from the spec in header-variants.ts). The menu arrives in slot "menu" and
// lands in the header's menu row or main row; phone extras (a shortcut row)
// in slot "phone-extras". The behaviour every layout shares lives here: the
// scroll state, the sticky height the page reads (--header-height), search
// openers and the account link.
import type { NavigationItem } from "@/lib/api";
import type {
  StorefrontHeaderRenderer,
  StorefrontNavigationRenderer,
} from "@scalius/shared/storefront-theme";
import ComposedHeader from "./variants/ComposedHeader.astro";
import type { HeaderLogo, HeaderSpec } from "./header-variants";

interface Props {
  logo: HeaderLogo;
  variantId: string;
  spec: HeaderSpec;
  headerStyle: StorefrontHeaderRenderer;
  navigationStyle: StorefrontNavigationRenderer;
  hasMenu: boolean;
  menuPlacement: "inline" | "row";
  stickyMenuRow: boolean;
  departments: NavigationItem[];
  phoneDrop: string;
}

const {
  logo,
  variantId,
  spec,
  headerStyle,
  navigationStyle,
  hasMenu,
  menuPlacement,
  stickyMenuRow,
  departments,
  phoneDrop,
} = Astro.props;
---

<ComposedHeader
  logo={logo}
  variantId={variantId}
  spec={spec}
  headerStyle={headerStyle}
  navigationStyle={navigationStyle}
  hasMenu={hasMenu}
  menuPlacement={menuPlacement}
  stickyMenuRow={stickyMenuRow}
  departments={departments}
  phoneDrop={phoneDrop}
>
  <slot name="menu" slot="menu" />
  <slot name="phone-extras" slot="phone-extras" />
</ComposedHeader>

<style is:global>
  /* The sticky header condenses on scroll, but the page under it must not
     move (CLS 0): while condensed it keeps its expanded height in the flow
     as a bottom margin. The reserve is the variant's data (header-variants
     headerCondense, set on #site-header), and it animates with the same
     transition as the heights it replaces, so the flow height is the same in
     every frame while the bar still eases. */
  #main-header {
    transition-property: margin-bottom, box-shadow, background-color, border-color;
    transition-duration: var(--hdr-condense-duration, 300ms);
    transition-timing-function: var(--hdr-condense-easing, cubic-bezier(0.25, 0.1, 0.25, 1));
  }

  #main-header.is-scrolled {
    margin-bottom: var(--hdr-condense-phone, 0rem);
  }

  /* Menu links keep 44px targets on touch screens (DesktopNav). Under
     reduced motion the rows and the reserve snap together. */
  #site-header {
    --nav-link-height: var(--nav-link-height-fine, 2.5rem);
    --hdr-condense-duration: var(--hdr-condense-motion, 300ms);
  }

  @media (pointer: coarse) {
    #site-header {
      --nav-link-height: var(--nav-link-height-coarse, 2.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header {
      --hdr-condense-duration: 0s;
    }
  }

  /* Bottom tabs carry cart and account on phones (mix rule 5). */
  @media (max-width: 63.99rem) {
    #main-header[data-phone-drop~="account"] [data-header-account],
    #main-header[data-phone-drop~="cart"] [data-header-cart],
    #main-header[data-phone-drop~="account"][data-phone-drop~="cart"] [data-header-action-group] {
      display: none;
    }
  }
</style>

<script>
  import { shouldUseCompactHeader } from "./header-scroll-state";
  import { pagePath } from "@/lib/presence-url";

  let isCompact = false;
  let scrollFrame: number | null = null;
  let headerResizeObserver: ResizeObserver | null = null;

  function setHeaderHeight(height: number) {
    document.documentElement.style.setProperty("--header-height", `${height}px`);
  }

  /**
   * The part of the header that sticks: #main-header, or its menu row when
   * only that row stays (a `display: contents` header on computers).
   */
  function stickyPart(): HTMLElement | null {
    const header = document.getElementById("main-header");
    if (!header) return null;
    if (getComputedStyle(header).display !== "contents") return header;
    return header.querySelector<HTMLElement>(".hdr-menu-row") ?? header;
  }

  function updateHeaderHeight() {
    const part = stickyPart();
    if (part) setHeaderHeight(part.offsetHeight);
  }

  function observeHeaderHeight() {
    headerResizeObserver?.disconnect();
    const header = document.getElementById("main-header");
    if (!header || typeof ResizeObserver === "undefined") {
      updateHeaderHeight();
      return;
    }
    headerResizeObserver = new ResizeObserver(() => updateHeaderHeight());
    headerResizeObserver.observe(header);
    const row = header.querySelector<HTMLElement>(".hdr-menu-row");
    if (row) headerResizeObserver.observe(row);
    updateHeaderHeight();
  }

  function applyScrollState() {
    scrollFrame = null;
    const header = document.getElementById("main-header");
    if (!header) return;
    const nextCompact = shouldUseCompactHeader(window.scrollY, isCompact);
    if (nextCompact === isCompact) return;
    isCompact = nextCompact;
    header.classList.toggle("is-scrolled", isCompact);
  }

  function scheduleScrollState() {
    if (scrollFrame !== null) return;
    scrollFrame = window.requestAnimationFrame(applyScrollState);
  }

  const triggerSearch = (event: Event) => {
    event.preventDefault();
    document.dispatchEvent(new CustomEvent("open-search-palette"));
  };

  function bindSearch() {
    // The header search icons and the phone tab bar's Search tab.
    document
      .querySelectorAll<HTMLElement>("#mobile-search-toggle, #scrolled-search-trigger, [data-search-open]")
      .forEach((opener) => {
        if (opener.dataset.searchBound) return;
        opener.dataset.searchBound = "";
        opener.addEventListener("click", triggerSearch);
      });
    // Search fields: a pointer press opens the typeahead palette; keyboard
    // users type in place and press Enter (a GET form to /search).
    document.querySelectorAll<HTMLInputElement>("[data-search-inline]").forEach((input) => {
      if (input.dataset.searchBound) return;
      input.dataset.searchBound = "";
      input.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "") return;
        triggerSearch(event);
      });
    });
    // A department scope searches that category's page instead (?q= there).
    document.querySelectorAll<HTMLFormElement>("form[data-header-search]").forEach((form) => {
      if (form.dataset.searchBound) return;
      form.dataset.searchBound = "";
      form.addEventListener("submit", (event) => {
        const scope = form.querySelector<HTMLSelectElement>("[data-search-scope]")?.value ?? "";
        if (!scope.startsWith("/categories/")) return;
        event.preventDefault();
        const query = (form.querySelector<HTMLInputElement>("input[name='q']")?.value ?? "").trim();
        const target = new URL(scope, window.location.origin);
        if (query) target.searchParams.set("q", query);
        window.location.assign(pagePath(target.pathname + target.search));
      });
    });
  }

  window.addEventListener("scroll", scheduleScrollState, { passive: true });
  applyScrollState();
  observeHeaderHeight();
  bindSearch();

  document.addEventListener("astro:page-load", () => {
    isCompact = false;
    applyScrollState();
    observeHeaderHeight();
    bindSearch();
  });

  // Handle account icon click (check for cs_auth cookie)
  function checkCustomerSession() {
    const hasCookie = document.cookie.split(";").some((c) => c.trim().startsWith("cs_auth=1"));
    // The header account icon, the top bar's and the phone tab bar's Account links.
    document.querySelectorAll<HTMLElement>("#account-link, [data-account-link]").forEach((accountLink) => {
      accountLink.onclick = (e) => {
        if (!hasCookie) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent("open-auth-modal"));
        }
      };
    });
  }
  checkCustomerSession();
  window.addEventListener("customer-login", checkCustomerSession);
  window.addEventListener("customer-logout", checkCustomerSession);
  document.addEventListener("astro:page-load", checkCustomerSession);
</script>
