---
// A row of top-level items whose children open as a dropdown column and
// deeper levels fly out to the side, one level at a time (Star Tech: a 200px
// column, then fly-outs; Apple Gadgets: one 200px column). Each level is a
// native <details>, so the menu opens without JavaScript; nav-menus.ts adds
// hover intent, arrow keys, Escape with focus return and flipping at the
// viewport's end. Items that don't fit on one line move into "More"
// (nav-disclosure.ts builds its entries from the row).
// - layout row: items side by side (a header row or inline in the bar).
// - layout bar: the category bar, items spread across the full width.
// - flyouts cascade: fly-outs beside the column; indent: nested lists inside it.
import type { NavigationItem } from "@/lib/api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import FlyoutList from "./FlyoutList.astro";
import {
  ariaCurrent,
  navigationChildren,
  navigationCurrent,
  navigationLinkAttributes,
} from "./navigation-state";

interface Props {
  navigation: NavigationItem[];
  /** Unique per rendered instance. */
  id: string;
  layout: "row" | "bar";
  flyouts: "cascade" | "indent";
  label?: string;
}

const { navigation = [], id, layout, flyouts, label = "Main navigation" } = Astro.props;
const items = navigation.filter((item) => item?.title);
const link = (item: NavigationItem) => ({
  href: item.href,
  "aria-current": ariaCurrent(navigationCurrent(item, Astro.url)),
  "data-astro-prefetch": getStorefrontPrefetchAttribute(item.href, Astro.url),
  ...navigationLinkAttributes(item),
});
---

<nav id={id} class="cnav" data-cnav-layout={layout} aria-label={label} data-menu-root>
  <ul class="cnav-bar" data-menu-bar data-nav-overflow data-nav-pending>
    {
      items.map((item, index) => {
        const children = navigationChildren(item);
        return (
          <li class="cnav-item" data-nav-index={index}>
            {item.href ? (
              <a class="cnav-link" data-menu-top-link {...link(item)}>
                {item.title}
              </a>
            ) : (
              children.length === 0 && <span class="cnav-link">{item.title}</span>
            )}
            {children.length > 0 && (
              <details class="cnav-menu" data-menu="popup" data-menu-hover>
                <summary class:list={["cnav-toggle", !item.href && "cnav-link"]} data-menu-top-link={item.href ? undefined : ""}>
                  {item.href ? <span class="sr-only">{item.title} submenu</span> : <span>{item.title}</span>}
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="m4 6 4 4 4-4" />
                  </svg>
                </summary>
                <div class="cnav-panel" data-menu-panel>
                  <FlyoutList items={children} mode={flyouts} parent={item} />
                </div>
              </details>
            )}
          </li>
        );
      })
    }
    <li class="cnav-item cnav-more" data-nav-more hidden>
      <details class="cnav-menu" data-menu="popup">
        <summary class="cnav-toggle cnav-link">
          <span>More</span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
        </summary>
        <div class="cnav-panel cnav-panel--end" data-menu-panel>
          <ul class="cnav-more-list" data-menu-list data-nav-more-list></ul>
        </div>
      </details>
    </li>
  </ul>
  <template data-nav-more-template>
    <li class="cnav-more-entry" data-nav-more-index="" hidden>
      <a class="cnav-more-link" data-more-parent href="#">More</a>
      <ul class="cnav-more-sublist" data-more-sublist>
        <li><a class="cnav-more-link" href="#">More</a></li>
      </ul>
    </li>
  </template>
</nav>

<style>
  .cnav {
    display: none;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .cnav {
      display: block;
    }
  }

  .cnav-bar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.125rem;
    width: 100%;
    min-width: 0;
  }

  .cnav[data-cnav-layout="bar"] .cnav-bar {
    justify-content: space-between;
  }

  /* Until the script has moved what doesn't fit into "More"; revealed anyway
     after 1.2s so the menu never stays hidden without JavaScript. */
  .cnav-bar[data-nav-pending] {
    opacity: 0;
    animation: cnav-reveal 0s linear 1.2s forwards;
  }

  @keyframes cnav-reveal {
    to {
      opacity: 1;
    }
  }

  .cnav-item {
    position: relative;
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  .cnav-item[hidden] {
    display: none;
  }

  .cnav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2.5rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius);
    color: var(--nav-ink, var(--foreground));
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    list-style: none;
    cursor: pointer;
  }

  .cnav[data-cnav-layout="bar"] .cnav-link {
    padding-inline: 0.5rem;
    font-size: 0.9375rem;
  }

  .cnav-link:hover,
  .cnav-link[aria-current],
  .cnav-item:has(> .cnav-menu[open]) > .cnav-link,
  .cnav-menu[open] > .cnav-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }

  .cnav-link[aria-current] {
    font-weight: 600;
  }

  a.cnav-link:has(+ .cnav-menu) {
    padding-right: 0.125rem;
  }

  .cnav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    list-style: none;
    cursor: pointer;
    color: var(--nav-ink-muted, var(--muted-foreground));
  }

  .cnav-toggle.cnav-link {
    width: auto;
    color: var(--nav-ink, var(--foreground));
  }

  .cnav-toggle::-webkit-details-marker {
    display: none;
  }

  .cnav-toggle svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms ease;
  }

  .cnav-menu[open] > .cnav-toggle svg {
    transform: rotate(180deg);
  }

  .cnav-link:focus-visible,
  .cnav-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  @media (pointer: coarse) {
    .cnav-link,
    .cnav-toggle {
      height: 2.75rem;
    }

    .cnav-toggle:not(.cnav-link) {
      width: 2.75rem;
    }
  }

  /* The first column hangs from its item; near the end it aligns to the item's end. */
  .cnav-panel {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    z-index: 60;
    width: max-content;
    min-width: 12.5rem;
    max-width: 18rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 0.25rem);
    background: var(--popover);
    color: var(--popover-foreground);
    text-transform: none;
    letter-spacing: normal;
    font-weight: 400;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 16px 40px -12px rgb(0 0 0 / 0.22);
  }

  .cnav-menu[open] > .cnav-panel {
    animation: cnav-enter 160ms ease-out;
  }

  @keyframes cnav-enter {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  .cnav-panel--end,
  [data-align-end] > .cnav-menu > .cnav-panel,
  .cnav-menu[data-flip] > .cnav-panel {
    left: auto;
    right: 0;
  }

  .cnav-more-list {
    display: flex;
    flex-direction: column;
    padding: 0.375rem;
  }

  .cnav-more-entry[hidden] {
    display: none;
  }

  .cnav-more-link {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius);
    color: var(--popover-foreground);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .cnav-more-sublist .cnav-more-link {
    min-height: 2rem;
    padding-left: 1.25rem;
    color: var(--muted-foreground);
    font-weight: 400;
  }

  a.cnav-more-link:hover,
  a.cnav-more-link:focus-visible {
    background: var(--accent);
    color: var(--accent-foreground);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cnav-toggle svg {
      transition: none;
    }

    .cnav-menu[open] > .cnav-panel {
      animation: none;
    }
  }
</style>
