---
// A row of top-level items whose children open as a dropdown column and
// deeper levels fly out to the side, one level at a time (Star Tech: a 200px
// column, then fly-outs; Apple Gadgets: one 200px column). Each level is a
// native <details>, so the menu opens without JavaScript; nav-menus.ts adds
// hover intent, arrow keys, Escape with focus return and flipping at the
// viewport's end. Items that don't fit on one line move, as they are, into
// "More" (nav-disclosure.ts), which also names the roots past `maxTopItems`
// and "All categories"; columns cut to the link budget fill up on intent
// (nav-panels.ts).
// - layout row: items side by side (a header row or inline in the bar).
// - layout bar: the category bar, items spread across the full width.
// - flyouts cascade: fly-outs beside the column; indent: nested lists inside it.
import type { NavigationItem } from "@/lib/api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import FlyoutList from "./FlyoutList.astro";
import { navigationPanelKey } from "./nav-tree";
import {
  ariaCurrent,
  navigationChildren,
  navigationCurrent,
  navigationLinkAttributes,
} from "./navigation-state";

interface Props {
  navigation: NavigationItem[];
  /** Unique per rendered instance. */
  id: string;
  layout: "row" | "bar";
  flyouts: "cascade" | "indent";
  label?: string;
  /** Roots past `maxTopItems`: named in "More" only. */
  extras?: NavigationItem[];
  /** "More" ends with "All categories" (/categories). */
  allCategories?: boolean;
  /** The columns here are cut to the link budget; this URL serves them whole (filled on intent, nav-panels.ts). */
  panelsSrc?: string;
}

const { navigation = [], id, layout, flyouts, label = "Main navigation", extras = [], allCategories = false, panelsSrc } = Astro.props;
const items = navigation.filter((item) => item?.title);
const hasExtras = extras.length > 0 || allCategories;
const link = (item: NavigationItem) => ({
  href: item.href,
  "aria-current": ariaCurrent(navigationCurrent(item, Astro.url)),
  "data-astro-prefetch": getStorefrontPrefetchAttribute(item.href, Astro.url),
  ...navigationLinkAttributes(item),
});
---

<nav id={id} class="cnav" data-cnav-layout={layout} aria-label={label} data-menu-root data-nav-panels={panelsSrc}>
  <ul class="cnav-bar" data-menu-bar data-nav-overflow data-nav-pending>
    {
      items.map((item, index) => {
        const children = navigationChildren(item);
        return (
          <li class="cnav-item" data-nav-index={index} data-nav-key={panelsSrc && children.length > 0 ? navigationPanelKey(item) : undefined}>
            {item.href ? (
              <a class="cnav-link" data-menu-top-link title={item.title.length > 24 ? item.title : undefined} {...link(item)}>
                <span class="nav-label">{item.title}</span>
              </a>
            ) : (
              children.length === 0 && <span class="cnav-link">{item.title}</span>
            )}
            {children.length > 0 && (
              <details class="cnav-menu" data-menu="popup" data-menu-hover>
                <summary class:list={["cnav-toggle", !item.href && "cnav-link"]} data-menu-top-link={item.href ? undefined : ""}>
                  {item.href ? <span class="sr-only">{item.title} submenu</span> : <span>{item.title}</span>}
                  <i class="nav-chevron" aria-hidden="true"></i>
                </summary>
                <div class="cnav-panel" data-menu-panel>
                  <FlyoutList items={children} mode={flyouts} parent={item} />
                </div>
              </details>
            )}
          </li>
        );
      })
    }
    <li class="cnav-item cnav-more" data-nav-more hidden={!hasExtras}>
      <details class="cnav-menu" data-menu="popup">
        <summary class="cnav-toggle cnav-link">
          <span>More</span>
          <i class="nav-chevron" aria-hidden="true"></i>
        </summary>
        <div class="cnav-panel cnav-panel--end" data-menu-panel>
          {/* Row items that don't fit are moved in here first (nav-disclosure.ts). */}
          <ul class="cnav-more-list" data-menu-list data-nav-more-list>
            {extras.map((item) => (
              <li class="cnav-more-entry">
                <a class="cnav-more-link" {...link(item)}>{item.title}</a>
              </li>
            ))}
            {allCategories && (
              <li class="cnav-more-entry cnav-more-all">
                <a class="cnav-more-link" href="/categories">All categories</a>
              </li>
            )}
          </ul>
        </div>
      </details>
    </li>
  </ul>
</nav>

<style is:global>
  .cnav {
    display: none;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .cnav {
      display: block;
    }
  }

  .cnav-bar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.125rem;
    width: 100%;
    min-width: 0;
  }

  .cnav[data-cnav-layout="bar"] .cnav-bar {
    justify-content: space-between;
  }

  /* Until the script has moved what doesn't fit into "More" (revealed after
     1.2s anyway should it fail). Without JavaScript a <noscript> rule
     (header.astro) reveals the row at once and lets it wrap. */
  .cnav-bar[data-nav-pending] {
    opacity: 0;
    animation: cnav-reveal 0s linear 1.2s forwards;
  }

  @keyframes cnav-reveal {
    to {
      opacity: 1;
    }
  }

  .cnav-item {
    position: relative;
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  .cnav-item[hidden] {
    display: none;
  }

  .cnav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2.5rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius);
    color: var(--nav-ink, var(--foreground));
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    list-style: none;
    cursor: pointer;
  }

  /* Star Tech's category bar: 14px labels spread across the row, no
     chevrons (hover or Down opens a department; its toggle shows on
     keyboard focus), a dropdown column of 27-36px rows. */
  .cnav[data-cnav-layout="bar"] .cnav-link {
    padding-inline: 0.5rem;
    font-size: 0.875rem;
  }

  .cnav[data-cnav-layout="bar"] a.cnav-link:has(+ .cnav-menu) {
    padding-right: 0.5rem;
  }

  .cnav[data-cnav-layout="bar"] .cnav-item > .cnav-menu:not(:first-child) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cnav[data-cnav-layout="bar"] .cnav-item > .cnav-menu:not(:first-child) > .cnav-toggle {
    position: absolute;
    right: -0.5rem;
    top: 50%;
    width: 1.25rem;
    height: 1.25rem;
    translate: 0 -50%;
    opacity: 0;
    pointer-events: auto;
  }

  .cnav[data-cnav-layout="bar"] .cnav-item > .cnav-menu:not(:first-child) > .cnav-toggle:focus-visible,
  .cnav[data-cnav-layout="bar"] .cnav-item > .cnav-menu[open]:not(:first-child) > .cnav-toggle {
    opacity: 1;
  }

  .cnav[data-cnav-layout="bar"] .cnav-item > .cnav-menu:not(:first-child) > .cnav-panel {
    top: 100%;
    pointer-events: auto;
  }

  .cnav[data-cnav-layout="bar"] .fly-link {
    min-height: 2rem;
    padding-block: 0.25rem;
  }

  .cnav[data-cnav-layout="bar"] .fly-toggle {
    height: 2rem;
  }

  @media (pointer: coarse) {
    .cnav[data-cnav-layout="bar"] .fly-link,
    .cnav[data-cnav-layout="bar"] .fly-toggle {
      min-height: 2.75rem;
      height: auto;
    }
  }

  .cnav-link:hover,
  .cnav-link[aria-current],
  .cnav-item:has(> .cnav-menu[open]) > .cnav-link,
  .cnav-menu[open] > .cnav-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }

  .cnav-link[aria-current] {
    font-weight: 600;
  }

  a.cnav-link:has(+ .cnav-menu) {
    padding-right: 0.125rem;
  }

  .cnav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    list-style: none;
    cursor: pointer;
    color: var(--nav-ink-muted, var(--muted-foreground));
  }

  .cnav-toggle.cnav-link {
    width: auto;
    color: var(--nav-ink, var(--foreground));
  }

  .cnav-toggle::-webkit-details-marker {
    display: none;
  }

  .cnav-toggle .nav-chevron {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms ease;
  }

  .cnav-menu[open] > .cnav-toggle .nav-chevron {
    transform: rotate(180deg);
  }

  .cnav-link:focus-visible,
  .cnav-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  @media (pointer: coarse) {
    .cnav-link,
    .cnav-toggle {
      height: 2.75rem;
    }

    .cnav-toggle:not(.cnav-link) {
      width: 2.75rem;
    }
  }

  /* The first column hangs from its item; near the end it aligns to the item's end. */
  .cnav-panel {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    z-index: 60;
    width: max-content;
    min-width: 12.5rem;
    max-width: 18rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 0.25rem);
    background: var(--popover);
    color: var(--popover-foreground);
    text-transform: none;
    letter-spacing: normal;
    font-weight: 400;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 16px 40px -12px rgb(0 0 0 / 0.22);
  }

  .cnav-menu[open] > .cnav-panel {
    animation: cnav-enter 160ms ease-out;
  }

  @keyframes cnav-enter {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  .cnav-panel--end,
  [data-align-end] > .cnav-menu > .cnav-panel,
  .cnav-menu[data-flip] > .cnav-panel {
    left: auto;
    right: 0;
  }

  .cnav-more-list {
    display: flex;
    flex-direction: column;
    padding: 0.375rem;
  }

  .cnav-more-entry[hidden] {
    display: none;
  }

  .cnav-more-all {
    margin-top: 0.25rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--border);
  }

  /* A row item moved into "More" is a plain row there: its link; a parent
     without a link opens its column in place. */
  .cnav-more-list > .cnav-item {
    display: block;
  }

  .cnav-more-list > .cnav-item > a.cnav-link {
    display: flex;
    height: auto;
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    color: var(--popover-foreground);
    font-size: 0.875rem;
    font-weight: 500 !important;
    white-space: normal;
    text-decoration: none;
    text-transform: none !important;
    letter-spacing: normal;
  }

  .cnav-more-list > .cnav-item > a.cnav-link:hover,
  .cnav-more-list > .cnav-item > a.cnav-link:focus-visible {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .cnav-more-list > .cnav-item:has(> a) > .cnav-menu {
    display: none;
  }

  .cnav-more-list > .cnav-item > .cnav-menu {
    position: static;
    inset: auto;
    pointer-events: auto;
  }

  .cnav-more-list > .cnav-item > .cnav-menu > .cnav-toggle {
    width: 100%;
    justify-content: space-between;
    padding-inline: 0.75rem;
    color: var(--popover-foreground);
    text-transform: none !important;
  }

  .cnav-more-list > .cnav-item > .cnav-menu > .cnav-panel {
    position: static;
    border: 0;
    box-shadow: none;
    animation: none;
  }

  .cnav-more-link {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius);
    color: var(--popover-foreground);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .cnav-more-sublist .cnav-more-link {
    min-height: 2rem;
    padding-left: 1.25rem;
    color: var(--muted-foreground);
    font-weight: 400;
  }

  a.cnav-more-link:hover,
  a.cnav-more-link:focus-visible {
    background: var(--accent);
    color: var(--accent-foreground);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cnav-toggle .nav-chevron {
      transition: none;
    }

    .cnav-menu[open] > .cnav-panel {
      animation: none;
    }
  }
</style>
