---
// The store header: the app header the theme names (`apps.header`, an app's
// header slot), else the theme's own header (CoreHeader.astro). An app
// header that is inactive, fails or is late gives way to the core header,
// so a page always has one.
import { storefrontExtensionBase } from "@scalius/shared/plugins/storefront-protocol";
import { THEME_EDITOR_MARKS } from "@scalius/shared/theme-editor-bridge";
import AppComponent from "@/components/apps/AppComponent.astro";
import { appSlot, requestExtensions } from "@/lib/extensions";
import { headerData } from "@/lib/extensions/data";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import CoreHeader from "./CoreHeader.astro";

type Props = import("astro/types").ComponentProps<typeof CoreHeader>;

const props = Astro.props;
const app = await appSlot(Astro.locals, Astro.url, "header");
let html: string | null = null;
if (app) {
  const theme = await currentRequestTheme(Astro.locals);
  const { host } = await requestExtensions(Astro.locals, Astro.url);
  html = await host.render(app.extension, {
    kind: "slot",
    slot: "header",
    component: app.component,
    settings: app.settings,
    data: headerData({ theme, storeName: props.storeName ?? null, navigation: props.navigation ?? [], categoryTree: props.categoryTree }),
  });
}
const preview = (await currentRequestTheme(Astro.locals)).preview !== null;
---

{html !== null && app
  ? <AppComponent html={html} pluginId={app.extension.pluginId} base={storefrontExtensionBase(app.extension.pluginId, app.extension.release)} editorMark={preview ? THEME_EDITOR_MARKS.header : undefined} />
  : <CoreHeader {...props} />}
