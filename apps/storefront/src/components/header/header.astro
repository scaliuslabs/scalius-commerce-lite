---
// The storefront header: top bar, header, desktop menu and phone navigation,
// each the variant the resolved theme chose (theme blocks topBar, header,
// desktopNav, mobileNav; the resolver already applied fit fallbacks). The
// menu tree comes from nav-tree.ts and each rendering of it gets its share
// of the header's 150-link budget, so large trees are drilled into rather
// than dumped into the HTML.
import type { HeaderData, NavigationItem, SocialLink } from "@/lib/api";
import HeaderLayout from "./HeaderLayout.astro";
import TopBar from "./TopBar.astro";
import DesktopNav from "./DesktopNav.astro";
import CascadingNav from "./CascadingNav.astro";
import CategoryBar from "./CategoryBar.astro";
import DepartmentsRail from "./DepartmentsRail.astro";
import DrawerTrigger from "./DrawerTrigger.astro";
import MobileMenu from "./MobileMenu.astro";
import MobileTabBar from "./MobileTabBar.astro";
import PillNav from "./PillNav.astro";
import { HEADER_LOGO_WIDTH_DEFAULT } from "@scalius/shared/brand-presentation";
import type {
  STOREFRONT_MOBILE_TABS,
  StorefrontHeaderRenderer,
  StorefrontMobileNavigationRenderer,
  StorefrontNavigationRenderer,
} from "@scalius/shared/storefront-theme";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { headerSpec } from "./header-variants";
import {
  navigationLinkShare,
  navigationShortcuts,
  navigationTree,
  pruneNavigation,
} from "./nav-tree";

interface Props {
  headerData: HeaderData;
  navigation: NavigationItem[];
  /** The store's support phone and single social set (see lib/store-identity). */
  storeName: string | null;
  storePhone: string | null;
  social: SocialLink[];
  /** The coarse renderer facts (`resolved.layout`); the variants come from the resolved theme. */
  variant: StorefrontHeaderRenderer;
  /** The theme's top bar block can show a bar (its text lives in Header settings). */
  showTopBar: boolean;
  navigationStyle: StorefrontNavigationRenderer;
  /** Layout's coarse phone fact; the phone menu follows the resolved `mobileNav` variant. */
  mobileNavigation: StorefrontMobileNavigationRenderer;
}

const {
  headerData: apiHeaderData,
  navigation: navigationItems,
  storeName,
  storePhone,
  social,
  variant: headerStyle,
  showTopBar,
  navigationStyle,
} = Astro.props;

const { resolved } = await currentRequestTheme(Astro.locals);
const { topBar, header, desktopNav, mobileNav } = resolved.blocks;

const headerData: HeaderData = {
  topBar: {
    text: apiHeaderData?.topBar?.text || "",
    isEnabled: showTopBar && (apiHeaderData?.topBar?.isEnabled ?? true),
  },
  logo: apiHeaderData?.logo?.src
    ? { ...apiHeaderData.logo, alt: storeName || apiHeaderData.logo.alt || "Store" }
    : {
        src: "",
        alt: storeName || apiHeaderData?.logo?.alt || "Store",
        width: HEADER_LOGO_WIDTH_DEFAULT,
      },
  contact: {
    phone: storePhone ?? "",
    text: apiHeaderData?.contact?.text || "",
    isEnabled: apiHeaderData?.contact?.isEnabled ?? true,
  },
  social,
};

// ── Which menus render where ───────────────────────────────────────────
const tree = navigationTree(navigationItems);
const hasNavigation = tree.length > 0;
const desktopKind = desktopNav.variant;
const desktopSettings = desktopNav.settings as Record<string, unknown>;
const railAlways = desktopKind === "departments-rail" && desktopSettings.open === "always";
const mobileSettings = mobileNav.settings as Record<string, unknown>;
const phoneTree: "accordion" | "drill" =
  mobileNav.variant === "drill-in-drawer" || (mobileNav.variant === "bottom-tabs" && mobileSettings.drawer === "drill-in")
    ? "drill"
    : "accordion";
const tabs =
  mobileNav.variant === "bottom-tabs" ? (mobileSettings.tabs as ReadonlyArray<(typeof STOREFRONT_MOBILE_TABS)[number]>) : null;
const desktopDrill = hasNavigation && desktopKind === "drill-in-drawer";
// One drawer serves both screens when both drill in.
const sharedDrawer = desktopDrill && phoneTree === "drill";
const desktopDrawer = sharedDrawer ? "mobile-menu" : "nav-drawer";
// The departments column (always open) is the Layout's, beside the page.
const desktopMenu = hasNavigation && !railAlways;

const spec = header.variant === "mall-departments" ? null : headerSpec(header.variant, header.settings as Record<string, unknown>);
const retailPill = header.variant === "retail-pill";
const shortcutRow = Boolean(spec?.phoneShortcuts) && hasNavigation;
const rowLinks = desktopDrill && !retailPill ? 8 : 0;

// Link budget: one share per rendering of the tree in the header HTML
// (the classic compact copy and "More" entries are built in the browser).
const renderings = (desktopMenu && !sharedDrawer ? 1 : 0) + 1;
const share = navigationLinkShare(renderings, (shortcutRow ? 10 : 0) + rowLinks);
const desktopAllLinks = desktopKind !== "dropdown";
const desktopTree = desktopMenu ? pruneNavigation(tree, share, { allLinks: desktopAllLinks }) : [];
const drawerTree = pruneNavigation(tree, share, { allLinks: phoneTree === "drill" });

const flyouts = desktopSettings.flyouts === "cascading" ? "cascading" : "dropdown";
const departments = tree.filter((item) => item.href);
const phoneDrop = tabs ? tabs.filter((tab) => tab === "cart" || tab === "account").join(" ") : "";

// The classic header folds the dropdown row into the bar on scroll.
const condensedMenu = !spec && desktopMenu && desktopKind === "dropdown";
const menuPlacement: "inline" | "row" =
  !spec || desktopKind === "sticky-category-bar" ? "row" : spec.menu;
const stickyMenuRow =
  Boolean(spec) && desktopMenu && menuPlacement === "row" && (header.variant === "spec-two-row" || desktopKind === "sticky-category-bar");
---

<header id="site-header" class="contents" data-header-variant={header.variant} data-desktop-nav={desktopKind} data-mobile-nav-variant={mobileNav.variant}>
  <TopBar
    variant={headerData.topBar.isEnabled ? topBar.variant : "none"}
    text={headerData.topBar.text}
    storeName={headerData.logo.alt}
    phone={headerData.contact.isEnabled !== false ? storePhone : null}
  />

  <HeaderLayout
    headerData={headerData}
    variantId={header.variant}
    spec={spec}
    headerStyle={headerStyle}
    navigationStyle={navigationStyle}
    hasMenu={desktopMenu}
    menuPlacement={menuPlacement}
    stickyMenuRow={stickyMenuRow}
    condensedMenu={condensedMenu}
    departments={departments}
    phoneDrop={phoneDrop}
  >
    <Fragment slot="menu">
      {desktopMenu && desktopKind === "dropdown" && (
        <DesktopNav navigation={desktopTree} id="desktop-nav" navStyle="menu" />
      )}
      {desktopMenu && desktopKind === "mega-panel" && (
        <DesktopNav
          navigation={desktopTree}
          id="desktop-nav"
          navStyle="mega"
          promoImages={desktopSettings.promoImages === true}
        />
      )}
      {desktopMenu && desktopKind === "cascading" && (
        <CascadingNav navigation={desktopTree} id="cascading-nav" layout="row" flyouts="cascade" />
      )}
      {desktopMenu && desktopKind === "sticky-category-bar" && (
        <CategoryBar navigation={desktopTree.slice(0, 18)} flyouts={flyouts} />
      )}
      {desktopMenu && desktopKind === "departments-rail" && <DepartmentsRail navigation={desktopTree} />}
      {desktopDrill && (
        <div class="drill-row-menu">
          <DrawerTrigger
            drawer={desktopDrawer}
            shape={retailPill ? "pill" : "text"}
            label={retailPill ? "Categories" : "All"}
          />
          {rowLinks > 0 && (
            <ul class="drill-row-links">
              {navigationShortcuts(tree, rowLinks).map((item) => (
                <li>
                  <a href={item.href} {...(item.openInNewTab ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )}
    </Fragment>
    {
      shortcutRow && (
        <div slot="phone-extras" class="header-phone-shortcuts">
          <PillNav navigation={navigationShortcuts(tree, 10)} />
        </div>
      )
    }
  </HeaderLayout>

  <MobileMenu
    navigation={drawerTree}
    contact={headerData.contact}
    social={headerData.social}
    tree={phoneTree}
    screens={sharedDrawer ? "all" : "phone"}
    title={sharedDrawer ? "Shop by department" : "Menu"}
  />

  {
    desktopDrill && !sharedDrawer && (
      <MobileMenu
        id="nav-drawer"
        navigation={desktopTree}
        contact={headerData.contact}
        tree="drill"
        screens="all"
        title="Shop by department"
      />
    )
  }

  {tabs && <MobileTabBar tabs={tabs} />}
</header>

<style>
  .drill-row-menu {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .drill-row-links {
    display: none;
    min-width: 0;
    overflow: hidden;
    gap: 0.25rem;
  }

  @media (min-width: 64rem) {
    .drill-row-links {
      display: flex;
    }
  }

  .drill-row-links a {
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding-inline: 0.625rem;
    color: var(--nav-ink, var(--foreground));
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .drill-row-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .drill-row-links a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  /* PillNav bleeds to the screen edges by its gutter; this row supplies it. */
  .header-phone-shortcuts {
    padding-inline: 1rem;
    overflow-x: clip;
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }

  @media (min-width: 40rem) {
    .header-phone-shortcuts {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .header-phone-shortcuts {
      display: none;
    }
  }
</style>

<script>
  import { cartStore, hydrateCartFromStorage } from "@/store/cart";
  import { debounce } from "@/lib/utils";
  import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
  import { formatMoney } from "@/lib/currency";
  import { installNavDisclosure } from "./nav-disclosure";
  import { installNavMenus } from "./nav-menus";
  import { installDrawer } from "./drawer";

  installNavDisclosure();
  installNavMenus();

  const openCart = debounce(() => {
    document.dispatchEvent(new CustomEvent("open-cart"));
  }, 50);

  type HeaderRuntimeWindow = Window & {
    __scaliusHeaderCleanup?: () => void;
  };

  function initializeHeader() {
    const runtimeWindow = window as HeaderRuntimeWindow;
    runtimeWindow.__scaliusHeaderCleanup?.();

    hydrateCartFromStorage();

    function updateCartDisplay() {
      const { totalItems, totalAmount } = cartStore.get();
      const sym = window.__CURRENCY_SYMBOL__ || DEFAULT_CURRENCY.symbol;
      const formattedTotal = formatMoney(totalAmount, {
        symbol: sym,
        code: window.__CURRENCY_CODE__ || DEFAULT_CURRENCY.code,
      });

      const countElements = document.querySelectorAll(
        "#cart-count, #mobile-cart-count",
      );
      countElements.forEach((el) => {
        if (el instanceof HTMLElement) {
          el.textContent = String(totalItems);
          el.classList.remove(
            "scale-0",
            "opacity-0",
            "scale-100",
            "opacity-100",
          );
          if (totalItems > 0) {
            el.classList.add("scale-100", "opacity-100");
            requestAnimationFrame(() => {
              el.style.transform = "scale(1.2)";
              setTimeout(() => (el.style.transform = "scale(1)"), 150);
            });
          } else {
            el.classList.add("scale-0", "opacity-0");
          }
        }
      });

      const totalDisplay = document.getElementById("cart-total-display");
      if (totalDisplay) {
        totalDisplay.textContent = formattedTotal;
      }
    }

    updateCartDisplay();
    const unsubscribeCart = cartStore.subscribe(updateCartDisplay);
    document.addEventListener("cart-updated", updateCartDisplay);

    const handleOpenCart = (event: MouseEvent) => {
      event.preventDefault();
      openCart();
    };
    // The header cart and the phone tab bar's Cart tab open the same drawer.
    const cartOpeners = document.querySelectorAll<HTMLElement>("#cart-button, [data-cart-open]");
    cartOpeners.forEach((opener) => (opener.onclick = handleOpenCart));

    const hydrateDeferredHeaderImages = () => {
      document.querySelectorAll<HTMLImageElement>("[data-mobile-header-image]").forEach((image) => {
        if (image.hasAttribute("src")) return;
        const source = image.dataset.deferredSrc;
        if (source) image.src = source;
      });
    };

    // Each drawer: the phone menu (header button, the tab bar's Categories
    // tab, and the "All" button when it serves computers too) and the
    // computer's separate drill-in drawer.
    const cleanups: Array<() => void> = [];
    document.querySelectorAll<HTMLElement>("[data-drawer]").forEach((panel) => {
      const id = panel.dataset.drawer!;
      const overlay = document.getElementById(`${id}-overlay`);
      if (!overlay) return;
      const openers = [
        ...(id === "mobile-menu"
          ? [
              document.getElementById("mobile-menu-toggle"),
              ...document.querySelectorAll<HTMLElement>("[data-mobile-menu-open]"),
            ]
          : []),
        ...document.querySelectorAll<HTMLElement>(`[data-drawer-open="${id}"]`),
      ].filter((opener): opener is HTMLElement => opener !== null);
      cleanups.push(
        installDrawer({
          panel,
          overlay,
          closeButton: document.getElementById(`${id}-close`),
          openers: [...new Set(openers)],
          historyKey: id === "mobile-menu" ? "__scaliusMobileMenu" : `__scalius_${id}`,
          phoneOnly: panel.dataset.drawerScreens !== "all",
          onOpen: hydrateDeferredHeaderImages,
        }),
      );
    });

    runtimeWindow.__scaliusHeaderCleanup = () => {
      unsubscribeCart();
      document.removeEventListener("cart-updated", updateCartDisplay);
      cleanups.forEach((cleanup) => cleanup());
    };
  }

  document.addEventListener("DOMContentLoaded", initializeHeader);
  document.addEventListener("astro:page-load", initializeHeader);
</script>
