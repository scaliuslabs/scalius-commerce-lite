---
// Header component - receives data from Layout.astro
import type { HeaderData, NavigationItem } from "@/lib/api";
import CartFlyout from "../CartFlyout";
import HeaderLayout from "./HeaderLayout.astro";
import DesktopNav from "./DesktopNav.astro";
import MobileMenu from "./MobileMenu.astro";
import { HEADER_LOGO_WIDTH_DEFAULT } from "@scalius/shared/brand-presentation";

interface Props {
  headerData: HeaderData;
  navigation: NavigationItem[];
}

const { headerData: apiHeaderData, navigation: navigationItems } = Astro.props;

const headerData: HeaderData = {
  topBar: {
    text: apiHeaderData?.topBar?.text || "",
    isEnabled: apiHeaderData?.topBar?.isEnabled ?? true,
  },
  logo: apiHeaderData?.logo?.src
    ? apiHeaderData.logo
    : {
        src: "",
        alt: apiHeaderData?.logo?.alt || "Store",
        width: HEADER_LOGO_WIDTH_DEFAULT,
      },
  contact: {
    phone: apiHeaderData?.contact?.phone || "",
    text: apiHeaderData?.contact?.text || "",
    isEnabled: apiHeaderData?.contact?.isEnabled ?? true,
  },
  social: apiHeaderData?.social || [],
};
---

<header id="site-header" class="contents">
  <HeaderLayout headerData={headerData}>
    <DesktopNav
      slot="desktop-nav-full"
      navigation={navigationItems}
      id="desktop-nav-full"
    />

    <DesktopNav
      slot="desktop-nav-compact"
      navigation={navigationItems}
      id="desktop-nav-compact"
    />
  </HeaderLayout>

  <MobileMenu
    navigation={navigationItems}
    contact={headerData.contact}
    social={headerData.social}
  />

  <CartFlyout client:load />
</header>

<script>
  import { cartStore } from "@/store/cart";
  import { debounce } from "@/lib/utils";
  import { DEFAULT_CURRENCY } from "@scalius/shared/currency";

  const openCart = debounce(() => {
    document.dispatchEvent(new CustomEvent("open-cart"));
  }, 50);

  type HeaderRuntimeWindow = Window & {
    __scaliusHeaderCleanup?: () => void;
  };

  function initializeHeader() {
    const runtimeWindow = window as HeaderRuntimeWindow;
    runtimeWindow.__scaliusHeaderCleanup?.();

    function updateCartDisplay() {
      const { totalItems, totalAmount } = cartStore.get();
      const sym = window.__CURRENCY_SYMBOL__ || DEFAULT_CURRENCY.symbol;
      const formattedTotal = `${sym}${totalAmount.toLocaleString()}`;

      const countElements = document.querySelectorAll(
        "#cart-count, #mobile-cart-count",
      );
      countElements.forEach((el) => {
        if (el instanceof HTMLElement) {
          el.textContent = String(totalItems);
          el.classList.remove(
            "scale-0",
            "opacity-0",
            "scale-100",
            "opacity-100",
          );
          if (totalItems > 0) {
            el.classList.add("scale-100", "opacity-100");
            requestAnimationFrame(() => {
              el.style.transform = "scale(1.2)";
              setTimeout(() => (el.style.transform = "scale(1)"), 150);
            });
          } else {
            el.classList.add("scale-0", "opacity-0");
          }
        }
      });

      const totalDisplay = document.getElementById("cart-total-display");
      if (totalDisplay) {
        totalDisplay.textContent = formattedTotal;
      }
    }

    updateCartDisplay();
    const unsubscribeCart = cartStore.subscribe(updateCartDisplay);
    document.addEventListener("cart-updated", updateCartDisplay);

    // Event Delegation for clicks
    const addClick = (id: string, fn: (e: MouseEvent) => void) => {
      const el = document.getElementById(id);
      if (el) {
        el.onclick = (event) => fn(event as MouseEvent);
      }
    };

    const handleOpenCart = (e: MouseEvent) => {
      e.preventDefault();
      openCart();
    };

    addClick("cart-button", handleOpenCart);

    const menuPanel = document.getElementById("mobile-menu-panel");
    const menuOverlay = document.getElementById("mobile-menu-overlay");
    const menuTrigger = document.getElementById("mobile-menu-toggle");
    const menuClose = document.getElementById("mobile-menu-close");
    const menuHistoryKey = "__scaliusMobileMenu";
    let menuIsOpen = false;
    let bodyOverflowBeforeMenu = "";
    let menuVisibilityTimer: number | undefined;

    const historyState = (): Record<string, unknown> =>
      history.state && typeof history.state === "object" ? history.state : {};

    const clearMenuHistoryMarker = () => {
      const nextState = { ...historyState() };
      delete nextState[menuHistoryKey];
      history.replaceState(nextState, "", window.location.href);
    };

    const focusableElements = () =>
      menuPanel
        ? Array.from(
            menuPanel.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
            ),
          ).filter((element) => element.offsetParent !== null)
        : [];

    const toggleMenu = (
      show: boolean,
      options: { syncHistory?: boolean; restoreFocus?: boolean } = {},
    ) => {
      if (!menuPanel || !menuOverlay) return;
      const syncHistory = options.syncHistory ?? true;
      const restoreFocus = options.restoreFocus ?? true;
      if (show === menuIsOpen) return;
      menuIsOpen = show;
      if (menuVisibilityTimer !== undefined) {
        window.clearTimeout(menuVisibilityTimer);
        menuVisibilityTimer = undefined;
      }
      menuPanel.inert = !show;
      menuPanel.setAttribute("aria-hidden", String(!show));
      menuTrigger?.setAttribute("aria-expanded", String(show));
      if (show) {
        bodyOverflowBeforeMenu = document.body.style.overflow;
        menuPanel.classList.remove("invisible");
        menuOverlay.classList.remove("invisible");
        requestAnimationFrame(() => {
          if (!menuIsOpen) return;
          menuPanel.classList.remove("-translate-x-full");
          menuOverlay.classList.remove("opacity-0", "pointer-events-none");
        });
        document.body.style.overflow = "hidden";
        if (syncHistory && historyState()[menuHistoryKey] !== true) {
          history.pushState(
            { ...historyState(), [menuHistoryKey]: true },
            "",
            window.location.href,
          );
        }
        requestAnimationFrame(() => menuClose?.focus());
      } else {
        menuPanel.classList.add("-translate-x-full");
        menuOverlay.classList.add("opacity-0", "pointer-events-none");
        menuVisibilityTimer = window.setTimeout(() => {
          if (menuIsOpen) return;
          menuPanel.classList.add("invisible");
          menuOverlay.classList.add("invisible");
          menuVisibilityTimer = undefined;
        }, 300);
        document.body.style.overflow = bodyOverflowBeforeMenu;
        if (restoreFocus) menuTrigger?.focus();
        if (syncHistory && historyState()[menuHistoryKey] === true) {
          history.back();
        }
      }
    };

    const handlePopState = () => {
      if (menuIsOpen) {
        toggleMenu(false, { syncHistory: false });
      }
    };
    window.addEventListener("popstate", handlePopState);

    addClick("mobile-menu-toggle", () => toggleMenu(true));
    addClick("mobile-menu-close", () => toggleMenu(false));
    if (menuOverlay) {
      menuOverlay.onclick = () => toggleMenu(false);
    }

    if (menuPanel) {
      menuPanel.onkeydown = (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          toggleMenu(false);
          return;
        }

        if (event.key !== "Tab") return;
        const elements = focusableElements();
        const first = elements.at(0);
        const last = elements.at(-1);
        if (!first || !last) {
          event.preventDefault();
          return;
        }

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      };

      menuPanel.onclick = (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest("[data-menu-toggle]");
        if (btn) {
          e.preventDefault();
          const id = btn.getAttribute("data-menu-toggle");
          const submenu = menuPanel.querySelector(`[data-submenu="${id}"]`);
          const icon = btn.querySelector("svg");
          if (submenu) {
            const isHidden = submenu.classList.contains("hidden");
            submenu.classList.toggle("hidden", !isHidden);
            submenu.setAttribute("aria-hidden", String(!isHidden));
            btn.setAttribute("aria-expanded", String(isHidden));
            icon?.classList.toggle("rotate-180", isHidden);
            return;
          }
        }

        if (target.closest("a[href]")) {
          toggleMenu(false, { syncHistory: false, restoreFocus: false });
          if (historyState()[menuHistoryKey] === true) {
            clearMenuHistoryMarker();
          }
        }
      };
    }

    const desktopBreakpoint = window.matchMedia("(min-width: 1024px)");
    desktopBreakpoint.onchange = (event) => {
      if (
        event.matches &&
        menuTrigger?.getAttribute("aria-expanded") === "true"
      ) {
        toggleMenu(false);
      }
    };

    runtimeWindow.__scaliusHeaderCleanup = () => {
      unsubscribeCart();
      document.removeEventListener("cart-updated", updateCartDisplay);
      window.removeEventListener("popstate", handlePopState);
      desktopBreakpoint.onchange = null;
      if (menuPanel) {
        menuPanel.onkeydown = null;
        menuPanel.onclick = null;
      }
      if (menuOverlay) menuOverlay.onclick = null;
      if (menuIsOpen) {
        toggleMenu(false, { syncHistory: false, restoreFocus: false });
      }
      if (menuVisibilityTimer !== undefined) {
        window.clearTimeout(menuVisibilityTimer);
        menuVisibilityTimer = undefined;
      }
      menuPanel?.classList.add("invisible");
      menuOverlay?.classList.add("invisible");
    };
  }

  document.addEventListener("DOMContentLoaded", initializeHeader);
  document.addEventListener("astro:page-load", initializeHeader);
</script>
