---
// A dropdown's contents: second-level links, with each one's own links
// indented beneath it (no fly-outs, so every level is one pointer move and
// a few tab stops away).
import type { NavigationItem } from "@/lib/api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import {
  ariaCurrent,
  navigationChildren,
  navigationCurrent,
  navigationLinkAttributes,
} from "./navigation-state";

interface Props {
  items: NavigationItem[];
  depth?: number;
}

const { items = [], depth = 0 } = Astro.props;
---

<ul class:list={["nav-dropdown-list", depth > 0 && "nav-dropdown-sublist"]}>
  {
    items.map((item) => {
      const children = navigationChildren(item);
      const linkClass = ["nav-dropdown-link", children.length > 0 && "nav-dropdown-link--parent"];
      return (
        <li>
          {item.href ? (
            <a
              href={item.href}
              class:list={linkClass}
              aria-current={ariaCurrent(navigationCurrent(item, Astro.url))}
              data-astro-prefetch={getStorefrontPrefetchAttribute(item.href, Astro.url)}
              {...navigationLinkAttributes(item)}
            >
              {item.title}
            </a>
          ) : (
            <span class:list={linkClass}>{item.title}</span>
          )}
          {children.length > 0 && <Astro.self items={children} depth={depth + 1} />}
        </li>
      );
    })
  }
</ul>

<style is:global>
  .nav-dropdown-sublist {
    margin: 0.125rem 0 0.375rem 0.75rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--border);
  }

  .nav-dropdown-link {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.3;
    color: inherit;
  }

  .nav-dropdown-sublist .nav-dropdown-link {
    min-height: 2rem;
    color: var(--muted-foreground);
  }

  .nav-dropdown-link--parent {
    font-weight: 600;
  }

  a.nav-dropdown-link:hover,
  a.nav-dropdown-link:focus-visible {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  a.nav-dropdown-link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: -2px;
  }

  a.nav-dropdown-link[aria-current="page"] {
    font-weight: 600;
    color: var(--card-foreground);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (pointer: coarse) {
    .nav-dropdown-link,
    .nav-dropdown-sublist .nav-dropdown-link {
      min-height: 2.75rem;
    }
  }
</style>
