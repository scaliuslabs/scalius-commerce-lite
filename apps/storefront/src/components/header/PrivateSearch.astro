---
// The store's search on a private page with the theme's header (`privatePages.search`), in its own
// slot of the header's frame, never inside the theme's region: GET to the store's search path, one
// field named the query parameter and a submit, in the store's words. Its look is the `search`
// target's tokens (private-anatomy.ts); no theme rule reaches it.
interface Props {
  action: string;
  param: string;
  label: string;
}
const { action, param, label } = Astro.props;
---

<form action={action} method="get" role="search" data-host="search">
  <input type="search" name={param} aria-label={label} placeholder={label} autocomplete="off" enterkeyhint="search" />
  <button type="submit" aria-label={label}><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg></button>
</form>
