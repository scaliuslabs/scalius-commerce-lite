---
// The `bottom-tabs` phone navigation: a bottom tab bar below `lg` with the
// tabs the theme chose (4-5 of Home, Categories, Offers, Search, Compare,
// Cart, Account; Star Tech 61px, Apple Gadgets 60px, Fabrilife 56px). A tab
// without a destination yet (Compare, until the compare page lands) is left
// out rather than linking nowhere. The tabs reuse the header's openers
// (header.astro binds `[data-mobile-menu-open]` and `[data-cart-open]`,
// HeaderLayout binds `[data-search-open]` and `[data-account-link]`), and
// each is a real link first (the menu drawer's :target, /search, /cart), so
// the bar works before hydration. The cart badge is `#mobile-cart-count`.
// The page reserves the bar's height in CSS, so nothing sits under it. On
// product pages the phone buy bar replaces the tab bar while it shows.
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { STOREFRONT_MOBILE_TABS } from "@scalius/shared/storefront-theme";

type Tab = (typeof STOREFRONT_MOBILE_TABS)[number];

interface Props {
  tabs?: readonly Tab[];
}

const DEFAULT_TABS: readonly Tab[] = ["home", "categories", "search", "cart", "account"];
/** Tabs with a page to go to today. */
const AVAILABLE = new Set<Tab>(["home", "categories", "offers", "search", "cart", "account"]);
const OFFERS_HREF = "/search?hasDiscount=true";

const { tabs = DEFAULT_TABS } = Astro.props;
const shown = tabs.filter((tab) => AVAILABLE.has(tab));
const path = Astro.url.pathname;
const offers = path === "/search" && Astro.url.searchParams.get("hasDiscount") === "true";
const active = {
  home: path === "/",
  categories: /^\/(categories|collections)\//.test(path),
  search: !offers && (path === "/search" || path.startsWith("/search/")),
  offers,
  account: path === "/account" || path.startsWith("/account/"),
};
---

<nav id="mobile-tab-bar" class="mobile-tab-bar" aria-label="Shortcuts">
  <ul style={`--mobile-tab-count: ${shown.length}`}>
    {
      shown.map((tab) => (
        <li>
          {tab === "home" && (
            <a href="/" class="mobile-tab" aria-current={active.home ? "page" : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
                <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              </svg>
              <span>Home</span>
            </a>
          )}
          {tab === "categories" && (
            <a
              href="#mobile-menu-panel"
              role="button"
              class="mobile-tab"
              aria-current={active.categories ? "true" : undefined}
              aria-haspopup="dialog"
              aria-controls="mobile-menu-panel"
              aria-expanded="false"
              data-mobile-menu-open
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect width="7" height="7" x="3" y="3" rx="1.5" />
                <rect width="7" height="7" x="14" y="3" rx="1.5" />
                <rect width="7" height="7" x="14" y="14" rx="1.5" />
                <rect width="7" height="7" x="3" y="14" rx="1.5" />
              </svg>
              <span>Categories</span>
            </a>
          )}
          {tab === "offers" && (
            <a href={OFFERS_HREF} class="mobile-tab" aria-current={active.offers ? "page" : undefined} data-astro-prefetch="false">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z" />
                <circle cx="7.5" cy="7.5" r="1.5" />
              </svg>
              <span>Offers</span>
            </a>
          )}
          {tab === "search" && (
            <a
              href="/search"
              role="button"
              class="mobile-tab"
              aria-current={active.search ? "true" : undefined}
              aria-haspopup="dialog"
              data-search-open
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
              <span>Search</span>
            </a>
          )}
          {tab === "cart" && (
            <a href="/cart" role="button" class="mobile-tab" aria-haspopup="dialog" data-cart-open data-astro-prefetch="false">
              <span class="mobile-tab-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="8" cy="21" r="1" />
                  <circle cx="19" cy="21" r="1" />
                  <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />
                </svg>
                <span id="mobile-cart-count" class="mobile-tab-badge scale-0 opacity-0" aria-hidden="true">0</span>
              </span>
              <span>Cart</span>
            </a>
          )}
          {tab === "account" && (
            <a
              href="/account"
              class="mobile-tab"
              aria-current={active.account ? "page" : undefined}
              data-account-link
              data-astro-prefetch={getStorefrontPrefetchAttribute("/account", Astro.url)}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="8" r="4" />
                <path d="M20 21a8 8 0 0 0-16 0" />
              </svg>
              <span>Account</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style is:global>
  :root {
    --mobile-tabs-height: 3.5rem;
    --mobile-tabs-reserve: calc(var(--mobile-tabs-height) + 1px + env(safe-area-inset-bottom, 0px));
  }

  /* Reserve the bar's height (zero specificity, so the product buy bar's own
     reserve wins while it replaces the tabs). */
  @media (max-width: 63.999rem) {
    :where(html[data-mobile-nav="tabs"]) {
      scroll-padding-bottom: calc(var(--mobile-tabs-reserve) + 0.5rem);
    }

    :where(html[data-mobile-nav="tabs"]) body {
      padding-bottom: var(--mobile-tabs-reserve);
    }
  }
</style>

<style>
  .mobile-tab-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    padding: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--background) 94%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    transition:
      transform 200ms ease,
      visibility 0s linear 0s;
  }

  @media (min-width: 64rem) {
    .mobile-tab-bar {
      display: none;
    }
  }

  :global(html[data-sticky-buy-visible]) .mobile-tab-bar {
    transform: translateY(100%);
    visibility: hidden;
    transition:
      transform 200ms ease,
      visibility 0s linear 200ms;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(var(--mobile-tab-count, 5), minmax(0, 1fr));
    height: var(--mobile-tabs-height);
    max-width: 40rem;
    margin-inline: auto;
  }

  .mobile-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1875rem;
    width: 100%;
    height: 100%;
    min-height: 2.75rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--theme-label-tracking, 0.01em);
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-tab[aria-current] {
    color: var(--foreground);
    font-weight: 600;
  }

  .mobile-tab:active > :first-child {
    transform: scale(0.92);
  }

  .mobile-tab:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: -4px;
    border-radius: var(--radius);
  }

  .mobile-tab-icon {
    position: relative;
    display: inline-flex;
  }

  svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 120ms ease;
  }

  .mobile-tab[aria-current] svg {
    stroke-width: 2;
  }

  .mobile-tab-badge {
    position: absolute;
    top: -0.375rem;
    right: -0.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.125rem;
    height: 1.125rem;
    padding-inline: 0.25rem;
    border-radius: 9999px;
    box-shadow: 0 0 0 2px var(--background);
    background: var(--destructive);
    color: var(--destructive-foreground);
    font-size: 0.625rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition:
      scale 200ms ease,
      opacity 200ms ease,
      transform 150ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-tab-bar,
    svg,
    .mobile-tab-badge {
      transition: none;
    }
  }
</style>
