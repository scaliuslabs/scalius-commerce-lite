---
// The `bottom-tabs` phone navigation: a bottom tab bar below `lg` with the
// tabs the theme chose (3 to 5: the store's destinations Home, Categories,
// Offers, Search, Compare, Cart and Account, and the theme's link tabs;
// Star Tech 61px, Apple Gadgets 60px, Fabrilife 56px). Compare shows only
// where comparing is possible (`compare`: the product page lists the
// compare-similar module): elsewhere nothing fills the comparison, so the tab
// is left out rather than opening an empty page. A bar left with fewer than
// three tabs takes the standard ones. The Compare tab links to /compare; the
// compare script points it at the buyer's list. The tabs reuse the header's
// openers (header.astro binds `[data-mobile-menu-open]` and
// `[data-cart-open]`, HeaderLayout binds `[data-search-open]` and
// `[data-account-link]`), and each is a real link first (the menu drawer's
// :target, /search, /cart), so the bar works before hydration. The Cart tab
// opens the drawer like the header's cart, and its count is the store's
// (CoreHeader's script, or app-components under an app header). A link tab is the theme's words, its icon (the store's, or a
// file of an active app) and a path of this store. The page reserves the
// bar's height in CSS, so nothing sits under it. On product pages the phone
// buy bar replaces the tab bar while it shows.
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import { getLayoutData } from "@/lib/api";
import { privateAssetUrls } from "@/lib/private-pages/html";
import { privatePagesCss } from "@scalius/shared/storefront-theme";
import { readStorefrontExtensions } from "@scalius/shared/plugins/storefront-components";
import type { STOREFRONT_MOBILE_TAB_ICONS } from "@scalius/shared/storefront-theme";
import { PHONE_OFFERS_HREF, phoneTabCurrent, shownPhoneTabs, type PhoneTab } from "./phone-navigation";
import TabIcon from "./TabIcon.astro";

interface Props {
  tabs?: readonly PhoneTab[];
  /** Comparing is possible (the product page offers compare-similar): show the Compare tab when the merchant chose it. */
  compare?: boolean;
  /**
   * Whose menu drawer the Categories tab opens: the store's (`#mobile-menu-panel`)
   * or an app header's (the element it marked `menuDrawer()`), with the
   * categories page as the link without JavaScript.
   */
  menu?: "core" | "app";
}

type Icon = (typeof STOREFRONT_MOBILE_TAB_ICONS)[number];

const { tabs, compare = false, menu = "core" } = Astro.props;
const { language, theme } = await currentRequestTheme(Astro.locals);
// The theme's look for the bar (`privatePages.tokens.tabBar`, compiled at save: private-tab-bar.ts), the same on every
// page: after the store's own rules below, so it replaces them; a theme's own stylesheet outranks both on a public page.
const look = theme ? privatePagesCss(theme.privatePages, "tabBar") : "";
const copy = storefrontCopy(language).chrome;
const shown = shownPhoneTabs(tabs, compare);
// A link tab's own image: a file of the theme's app while that app is active, else the store's link icon.
const asset = shown.some((tab) => tab.kind === "link" && tab.icon.source === "app")
  ? privateAssetUrls(readStorefrontExtensions((await getLayoutData())?.appExtensions))
  : null;
const current = (tab: PhoneTab): boolean => phoneTabCurrent(tab, Astro.url);
const iconOf = (tab: PhoneTab): { name: Icon } | { src: string } => {
  if (tab.kind !== "link") return { name: tab.kind };
  if (tab.icon.source === "store") return { name: tab.icon.name };
  const src = asset?.({ app: tab.icon.app, file: tab.icon.file }) ?? null;
  return src ? { src } : { name: "link" };
};
const labelOf = (tab: PhoneTab): string => (tab.kind === "link" ? tab.label : copy.tabs[tab.kind]);
---

<nav id="mobile-tab-bar" class="mobile-tab-bar" data-part="tab-bar" data-private="tab-bar" aria-label={copy.tabs.label} data-tab-menu={menu}>
  <ul style={`--mobile-tab-count: ${shown.length}`}>
    {
      shown.map((tab) => {
        const icon = iconOf(tab);
        const page = current(tab) ? "page" : undefined;
        const glyph = "name" in icon
          ? <TabIcon name={icon.name} />
          : <img src={icon.src} alt="" width="22" height="22" loading="lazy" decoding="async" data-part="tab-icon" />;
        return (
          <li>
            {tab.kind === "home" && (
              <a href="/" class="mobile-tab" data-part="tab" aria-current={page}>{glyph}<span data-part="tab-label">{labelOf(tab)}</span></a>
            )}
            {tab.kind === "categories" && (
              <a
                href={menu === "app" ? "/categories" : "#mobile-menu-panel"}
                role="button"
                class="mobile-tab" data-part="tab"
                aria-current={current(tab) ? "true" : undefined}
                aria-haspopup="dialog"
                aria-controls={menu === "app" ? undefined : "mobile-menu-panel"}
                aria-expanded="false"
                data-mobile-menu-open={menu === "app" ? undefined : ""}
                data-app-menu-open={menu === "app" ? "" : undefined}
              >{glyph}<span data-part="tab-label">{labelOf(tab)}</span></a>
            )}
            {tab.kind === "offers" && (
              <a href={PHONE_OFFERS_HREF} class="mobile-tab" data-part="tab" aria-current={page} data-astro-prefetch="false">{glyph}<span data-part="tab-label">{labelOf(tab)}</span></a>
            )}
            {tab.kind === "search" && (
              <a href="/search" class="mobile-tab" data-part="tab" aria-current={page} data-search-open data-astro-prefetch="false">{glyph}<span data-part="tab-label">{labelOf(tab)}</span></a>
            )}
            {tab.kind === "compare" && (
              <a href="/compare" rel="nofollow" class="mobile-tab" data-part="tab" aria-current={page} data-compare-tab data-astro-prefetch="false">{glyph}<span data-part="tab-label">{labelOf(tab)}</span></a>
            )}
            {tab.kind === "cart" && (
              <a href="/cart" class="mobile-tab" data-part="tab" aria-current={page} aria-haspopup="dialog" data-cart-open data-astro-prefetch="false">
                <span class="mobile-tab-icon">{glyph}<span class="mobile-tab-badge" data-part="tab-badge" data-tab-cart-count data-scalius-cart-count aria-hidden="true"></span></span>
                <span data-part="tab-label">{labelOf(tab)}</span>
              </a>
            )}
            {tab.kind === "account" && (
              <a
                href="/account"
                class="mobile-tab" data-part="tab"
                aria-current={page}
                data-account-link
                data-astro-prefetch={getStorefrontPrefetchAttribute("/account", Astro.url)}
              >{glyph}<span data-part="tab-label">{labelOf(tab)}</span></a>
            )}
            {tab.kind === "link" && (
              <a href={tab.href} class="mobile-tab" data-part="tab" aria-current={page} data-astro-prefetch={getStorefrontPrefetchAttribute(tab.href, Astro.url)}>{glyph}<span data-part="tab-label">{labelOf(tab)}</span></a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>
{look && <style is:inline data-tab-bar-look set:html={look} />}

<script>
  import { pagePath } from "@/lib/presence-url";
  import { bindAppMenuTab } from "./app-menu-tab";

  // Under an app header: the Categories tab opens the header's own drawer.
  bindAppMenuTab(document);
  // The Compare tab opens the buyer's list (CompareTray keeps it in this
  // browser); without JavaScript or a list it opens the empty comparison.
  const tab = document.querySelector<HTMLAnchorElement>("[data-compare-tab]");
  if (tab) {
    const point = () => {
      let ids: string[] = [];
      try {
        const value = JSON.parse(localStorage.getItem("scalius:compare") ?? "[]");
        if (Array.isArray(value)) ids = value.filter((id) => typeof id === "string" && /^[A-Za-z0-9_-]{1,80}$/.test(id)).slice(-4);
      } catch {
        // Private mode: the tab keeps /compare.
      }
      tab.href = pagePath(ids.length > 0 ? `/compare?ids=${ids.map(encodeURIComponent).join(",")}` : "/compare");
    };
    point();
    addEventListener("storage", point);
    document.addEventListener("click", () => setTimeout(point, 0), { passive: true });
  }
</script>

<style is:global>
  /* The store's own bar. Every rule here has zero specificity (`:where`), so the theme's tokens (written after it)
     replace it and any rule of a theme's own stylesheet outranks it on a public page, whatever loads first. */
  :where(:root) {
    /* Two lines of a 12px label with room for Bangla's vowel signs under a 22px icon (private-tab-bar.ts). */
    --mobile-tabs-height: 3.75rem;
    --mobile-tabs-reserve: calc(var(--mobile-tabs-height) + 1px + env(safe-area-inset-bottom, 0px));
  }

  /* Reserve the bar's height (the product buy bar's own reserve wins while it replaces the tabs), only where the bar
     is drawn: an app header skin draws its own phone navigation and no tab bar. */
  @media (max-width: 63.999rem) {
    :where(html[data-mobile-nav="tabs"]:has(#mobile-tab-bar)) {
      scroll-padding-bottom: calc(var(--mobile-tabs-reserve) + 0.5rem);
    }

    :where(html[data-mobile-nav="tabs"]:has(#mobile-tab-bar)) body {
      padding-bottom: var(--mobile-tabs-reserve);
    }
  }

  :where(.mobile-tab-bar) {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--scalius-z-content-bar, 40);
    padding: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--background) 94%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    transition:
      transform 200ms ease,
      visibility 0s linear 0s;
  }

  @media (min-width: 64rem) {
    :where(.mobile-tab-bar) {
      display: none;
    }
  }

  :where(html[data-sticky-buy-visible] .mobile-tab-bar) {
    transform: translateY(100%);
    visibility: hidden;
    transition:
      transform 200ms ease,
      visibility 0s linear 200ms;
  }

  /* Every tab shares two rows, centred in the bar: the icons' row as tall as the largest icon box (the current tab's
     chip and ring included) and the labels' row as tall as the longest label. Each chip is centred in its row and
     every label starts on the same line, whatever chip is larger or label wraps (subgrid through the item and tab). */
  :where(.mobile-tab-bar > ul) {
    display: grid;
    grid-template-columns: repeat(var(--mobile-tab-count, 5), minmax(0, 1fr));
    grid-template-rows: 1fr auto auto 1fr;
    row-gap: 0;
    /* A least height: a theme's own larger chip grows the bar instead of pushing every label past it. */
    min-height: var(--mobile-tabs-height);
    max-width: 40rem;
    margin-inline: auto;
  }

  /* The four rows are named by number, not `-1`: a theme that restyles the list leaves the tab its own four rows. */
  :where(.mobile-tab-bar > ul > li) {
    display: grid;
    grid-row: 1 / 5;
    grid-template-rows: subgrid;
    min-width: 0;
  }

  /* Without subgrid (an older browser, or a restyled list) each tab centres its own icon and label. */
  :where(.mobile-tab) {
    display: grid;
    grid-row: 1 / 5;
    grid-template-rows: 1fr auto auto 1fr;
    grid-template-rows: subgrid;
    justify-items: center;
    width: 100%;
    min-width: 0;
    height: 100%;
    min-height: 2.75rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--theme-label-tracking, 0.01em);
    -webkit-tap-highlight-color: transparent;
  }

  /* The current tab: its words and a weight 200 heavier (a cue besides colour, WCAG 1.4.1). */
  :where(.mobile-tab[aria-current]) {
    color: var(--foreground);
    font-weight: 700;
  }

  /* A label is never cut: a long name ("Gaming News" at 320px, in English or Bangla) takes a second line, and its box
     keeps room above and below its lines for Bangla's vowel signs (PRIVATE_TAB_BAR_LABEL). */
  :where(.mobile-tab > :first-child) {
    grid-row: 2;
    align-self: center;
  }

  :where(.mobile-tab [data-part="tab-label"]) {
    grid-row: 3;
    align-self: start;
    margin-top: 0.1875rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    min-width: 0;
    max-width: 100%;
    padding: 0.15em 0.125rem;
    overflow: hidden;
    overflow-wrap: anywhere;
    white-space: normal;
    text-align: center;
    line-height: 1.25;
  }

  :where(.mobile-tab:active > :first-child) {
    transform: scale(0.92);
  }

  :where(.mobile-tab:focus-visible) {
    outline: 2px solid var(--foreground);
    outline-offset: -4px;
    border-radius: var(--radius);
  }

  :where(.mobile-tab-icon) {
    position: relative;
    display: inline-flex;
  }

  :where(.mobile-tab img[data-part="tab-icon"]) {
    width: 1.375rem;
    height: 1.375rem;
    object-fit: contain;
  }

  :where(.mobile-tab svg[data-part="tab-icon"]) {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 120ms ease;
  }

  :where(.mobile-tab[aria-current] svg[data-part="tab-icon"]) {
    stroke-width: 2;
  }

  :where(.mobile-tab-badge:empty) {
    display: none;
  }

  :where(.mobile-tab-badge) {
    position: absolute;
    top: -0.375rem;
    inset-inline-end: -0.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.125rem;
    height: 1.125rem;
    padding-inline: 0.25rem;
    border-radius: 9999px;
    box-shadow: 0 0 0 2px var(--background);
    background: var(--destructive);
    color: var(--destructive-foreground);
    font-size: 0.625rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition:
      scale 200ms ease,
      opacity 200ms ease,
      transform 150ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    :where(.mobile-tab-bar, .mobile-tab svg, .mobile-tab-badge) {
      transition: none;
    }
  }
</style>
