---
// One level of a desktop menu panel, shared by the cascading menu, the
// category bar and the departments rail. Rows are 36px links (Star Tech 27px,
// Apple Gadgets 36px: the larger keeps pointer targets comfortable).
// - cascade: a row with children gets a `<details>` fly-out beside the
//   column (the next level, one at a time); the column ends in "Show all".
// - indent: children are listed under their row, indented (no fly-outs).
// Works without JavaScript (native details); nav-menus.ts adds hover intent,
// arrow keys, Escape and flipping at the viewport's end.
import type { NavigationItem } from "@/lib/api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import {
  ariaCurrent,
  navigationChildren,
  navigationCurrent,
  navigationLinkAttributes,
} from "./navigation-state";

interface Props {
  items: NavigationItem[];
  mode: "cascade" | "indent";
  /** The item this level belongs to: its "Show all" link ends the column. */
  parent?: NavigationItem;
  depth?: number;
}

const { items: allItems = [], mode, parent, depth = 1 } = Astro.props;
// A fly-out column never scrolls (a scrolling column would clip the next
// fly-out), so it shows its first rows and ends in "Show all" (Star Tech: 17).
const MAX_CASCADE_ROWS = 14;
const items = mode === "cascade" && parent?.href ? allItems.slice(0, MAX_CASCADE_ROWS) : allItems;
const link = (item: NavigationItem) => ({
  href: item.href,
  "aria-current": ariaCurrent(navigationCurrent(item, Astro.url)),
  "data-astro-prefetch": getStorefrontPrefetchAttribute(item.href, Astro.url),
  ...navigationLinkAttributes(item),
});
---

<ul class:list={["fly-list", mode === "indent" && depth > 1 && "fly-list--nested"]} data-menu-list data-depth={depth}>
  {
    items.map((item) => {
      const children = navigationChildren(item);
      const cascade = mode === "cascade" && children.length > 0;
      return (
        <li class:list={["fly-row", cascade && "fly-row--parent"]}>
          {item.href ? (
            <a class:list={["fly-link", mode === "indent" && children.length > 0 && "fly-link--heading"]} {...link(item)}>
              {item.title}
            </a>
          ) : (
            !cascade && <span class:list={["fly-link", children.length > 0 && "fly-link--heading"]}>{item.title}</span>
          )}
          {cascade && (
            <details class="fly-menu" data-menu="popup" data-menu-hover>
              <summary class:list={["fly-toggle", !item.href && "fly-link"]}>
                {item.href ? <span class="sr-only">{item.title} submenu</span> : <span>{item.title}</span>}
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m6 4 4 4-4 4" />
                </svg>
              </summary>
              <div class="fly-panel" data-menu-panel>
                <Astro.self items={children} mode={mode} parent={item} depth={depth + 1} />
              </div>
            </details>
          )}
          {mode === "indent" && children.length > 0 && <Astro.self items={children} mode={mode} depth={depth + 1} />}
        </li>
      );
    })
  }
  {
    mode === "cascade" && parent?.href && (
      <li class="fly-row fly-row--all">
        <a class="fly-link" {...link(parent)}>
          Show all {parent.title}
        </a>
      </li>
    )
  }
</ul>

<style>
  .fly-list {
    display: flex;
    flex-direction: column;
    min-width: 12.5rem;
    padding: 0.375rem;
  }

  .fly-list--nested {
    min-width: 0;
    margin: 0 0 0.25rem 0.75rem;
    padding: 0 0 0 0.5rem;
    border-left: 1px solid var(--border);
  }

  .fly-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .fly-link {
    display: flex;
    flex: 1;
    align-items: center;
    min-width: 0;
    min-height: 2.25rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius);
    color: var(--popover-foreground);
    font-size: 0.875rem;
    line-height: 1.3;
    text-align: start;
    overflow-wrap: anywhere;
  }

  .fly-list--nested .fly-link {
    min-height: 2rem;
    color: var(--muted-foreground);
  }

  .fly-link--heading {
    font-weight: 600;
  }

  .fly-row--all {
    margin-top: 0.25rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--border);
  }

  .fly-row--all .fly-link {
    font-weight: 600;
  }

  a.fly-link:hover,
  .fly-row--parent:has(> .fly-menu[open]) > .fly-link,
  summary.fly-link:hover {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  a.fly-link[aria-current="page"] {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .fly-menu {
    flex: 0 0 auto;
  }

  /* A row without a link is its summary, full width. */
  .fly-menu:first-child {
    flex: 1;
    min-width: 0;
  }

  .fly-menu:first-child > .fly-toggle {
    display: flex;
    width: 100%;
  }

  .fly-toggle {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2.25rem;
    border-radius: var(--radius);
    list-style: none;
    cursor: pointer;
    color: var(--muted-foreground);
  }

  .fly-toggle.fly-link {
    justify-content: space-between;
    width: auto;
    color: var(--popover-foreground);
  }

  .fly-toggle::-webkit-details-marker {
    display: none;
  }

  .fly-toggle:hover,
  .fly-menu[open] > .fly-toggle {
    color: var(--accent-foreground);
    background: var(--accent);
  }

  .fly-toggle svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fly-link:focus-visible,
  .fly-toggle:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: -2px;
  }

  /* A fly-out opens beside its row (towards the start when flipped). */
  .fly-panel {
    position: absolute;
    top: -0.375rem;
    left: 100%;
    z-index: 70;
    width: max-content;
    min-width: 12.5rem;
    max-width: 18rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 0.25rem);
    background: var(--popover);
    color: var(--popover-foreground);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 16px 40px -12px rgb(0 0 0 / 0.22);
  }

  .fly-menu[data-flip] > .fly-panel,
  :global([data-flip]) .fly-panel {
    left: auto;
    right: 100%;
  }

  @media (pointer: coarse) {
    .fly-link,
    .fly-toggle {
      min-height: 2.75rem;
    }

    .fly-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>
