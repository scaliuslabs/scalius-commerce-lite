---
// The desktop header menu for the `menu` and `mega` navigation styles: one
// row of top-level links. A parent opens a dropdown list (menu) or a
// full-width panel of columns (mega) through a disclosure button beside its
// link (WAI-ARIA disclosure navigation, not role=menu). Items that don't fit
// move into "More". Behaviour lives in ./nav-disclosure.ts.
import type { NavigationItem } from "@/lib/api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import RecursiveDesktopNav from "./RecursiveDesktopNav.astro";
import MegaMenuPanel from "./MegaMenuPanel.astro";
import {
  ariaCurrent,
  navigationChildren,
  navigationCurrent,
  navigationLinkAttributes,
} from "./navigation-state";

interface Props {
  navigation: NavigationItem[];
  /** Unique per rendered instance; prefixes every id inside. */
  id: string;
  navStyle: "menu" | "mega";
  /** Mega panels show linked items that have photos as 120px tiles (Fabrilife). */
  promoImages?: boolean;
}

const { navigation = [], id, navStyle, promoImages = false } = Astro.props;
const items = (Array.isArray(navigation) ? navigation : []).filter((item) => item?.title);
const moreId = `${id}-more`;
---

<nav id={id} aria-label="Main navigation" class="desktop-nav" data-nav-style={navStyle}>
  <ul class="desktop-nav-list" data-nav-overflow data-nav-pending>
    {
      items.map((item, index) => {
        const children = navigationChildren(item);
        const panelId = `${id}-panel-${index}`;
        const current = ariaCurrent(navigationCurrent(item, Astro.url));
        return (
          <li
            class="desktop-nav-item"
            data-nav-index={index}
            data-disclosure-item={children.length > 0 ? "" : undefined}
          >
            {item.href ? (
              <a
                href={item.href}
                class="desktop-nav-link"
                aria-current={current}
                data-astro-prefetch={getStorefrontPrefetchAttribute(item.href, Astro.url)}
                {...navigationLinkAttributes(item)}
              >
                {item.title}
              </a>
            ) : children.length === 0 ? (
              <span class="desktop-nav-link">{item.title}</span>
            ) : null}
            {children.length > 0 && (
              <button
                type="button"
                class:list={["desktop-nav-toggle", !item.href && "desktop-nav-link"]}
                aria-expanded="false"
                aria-controls={panelId}
                data-disclosure="popup"
              >
                {item.href ? <span class="sr-only">{item.title} submenu</span> : item.title}
                <svg class="desktop-nav-chevron" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </button>
            )}
            {children.length > 0 &&
              (navStyle === "mega" ? (
                <MegaMenuPanel id={panelId} item={item} promoImages={promoImages} />
              ) : (
                <div id={panelId} class="desktop-nav-dropdown" hidden>
                  <RecursiveDesktopNav items={children} />
                </div>
              ))}
          </li>
        );
      })
    }
    <li class="desktop-nav-item desktop-nav-more" data-nav-more data-disclosure-item hidden>
      <button
        type="button"
        class="desktop-nav-toggle desktop-nav-link"
        aria-expanded="false"
        aria-controls={moreId}
        data-disclosure="popup"
      >
        More
        <svg class="desktop-nav-chevron" viewBox="0 0 16 16" aria-hidden="true">
          <path d="m4 6 4 4 4-4" />
        </svg>
      </button>
      <div id={moreId} class="desktop-nav-dropdown" hidden>
        {/* Filled from the row by nav-disclosure.ts, so each link is in the HTML once. */}
        <ul class="nav-dropdown-list" data-nav-more-list></ul>
      </div>
    </li>
  </ul>
  <template data-nav-more-template>
    <li data-nav-more-index="" hidden>
      <RecursiveDesktopNav items={[{ title: "More", href: "#", subMenu: [{ title: "More", href: "#" }] }]} />
    </li>
  </template>
</nav>

<style>
  .desktop-nav {
    display: none;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .desktop-nav {
      display: block;
    }
  }

  .desktop-nav-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    width: 100%;
    min-width: 0;
    transition: opacity 150ms ease;
  }

  /* Until the script has moved what doesn't fit into "More"; revealed anyway
     after 1.2s so the menu never stays hidden without JavaScript. */
  .desktop-nav-list[data-nav-pending] {
    opacity: 0;
    animation: desktop-nav-reveal 0s linear 1.2s forwards;
  }

  @keyframes desktop-nav-reveal {
    to {
      opacity: 1;
    }
  }

  .desktop-nav-item {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  .desktop-nav-item[hidden] {
    display: none;
  }

  /* Dropdowns hang from their item; mega panels span the whole header row. */
  .desktop-nav[data-nav-style="menu"] .desktop-nav-item,
  .desktop-nav-more {
    position: relative;
  }

  .desktop-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    /* The classic header's folding row is sized from the same variable. */
    height: var(--nav-link-height, 2.5rem);
    padding-inline: 0.75rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--nav-ink, var(--foreground));
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 50% calc(100% - 0.5rem);
    background-size: 0 1px;
    transition: background-size 200ms ease;
  }

  .desktop-nav-link:hover,
  .desktop-nav-link[aria-current],
  .desktop-nav-item:has(> [aria-expanded="true"]) > .desktop-nav-link,
  .desktop-nav-link[aria-expanded="true"] {
    background-size: calc(100% - 1.5rem) 1px;
  }

  .desktop-nav-link[aria-current] {
    font-weight: 600;
  }

  /* A link with a disclosure button: the chevron sits snug against it. */
  a.desktop-nav-link:has(+ .desktop-nav-toggle) {
    padding-right: 0.125rem;
  }

  a.desktop-nav-link:has(+ .desktop-nav-toggle):hover,
  a.desktop-nav-link:has(+ .desktop-nav-toggle)[aria-current],
  .desktop-nav-item:has(> [aria-expanded="true"]) > a.desktop-nav-link {
    background-size: calc(100% - 0.875rem) 1px;
  }

  .desktop-nav-toggle:not(.desktop-nav-link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: var(--nav-link-height, 2.5rem);
    margin-right: 0.25rem;
    border-radius: var(--radius);
    color: var(--nav-ink-muted, var(--muted-foreground));
  }

  .desktop-nav-toggle:not(.desktop-nav-link):hover,
  .desktop-nav-toggle[aria-expanded="true"] {
    color: var(--nav-ink, var(--foreground));
  }

  .desktop-nav-chevron {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms ease;
  }

  [aria-expanded="true"] > .desktop-nav-chevron {
    transform: rotate(180deg);
  }

  .desktop-nav-link:focus-visible,
  .desktop-nav-toggle:focus-visible {
    outline: 2px solid var(--nav-ink, var(--foreground));
    outline-offset: 2px;
  }

  /* Touch screens at desktop width (tablets) keep 44px targets. */
  @media (pointer: coarse) {
    .desktop-nav-link,
    .desktop-nav-toggle:not(.desktop-nav-link) {
      height: var(--nav-link-height, 2.75rem);
    }

    .desktop-nav-toggle:not(.desktop-nav-link) {
      width: 2.75rem;
      margin-right: 0;
    }
  }

  .desktop-nav-dropdown {
    position: absolute;
    top: calc(100% + 0.375rem);
    left: 0;
    z-index: 60;
    width: max-content;
    min-width: 14rem;
    max-width: 18rem;
    max-height: calc(100dvh - var(--header-height, 8rem) - 1rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 0.375rem);
    background: var(--card);
    color: var(--card-foreground);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 16px 40px -12px rgb(0 0 0 / 0.22);
  }

  [data-align-end] > .desktop-nav-dropdown,
  .desktop-nav-more > .desktop-nav-dropdown {
    left: auto;
    right: 0;
  }

  .desktop-nav-dropdown:not([hidden]) {
    animation: desktop-nav-enter 160ms ease-out;
  }

  @keyframes desktop-nav-enter {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  .desktop-nav-more .nav-dropdown-list > li + li:not([hidden]) {
    margin-top: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .desktop-nav-list,
    .desktop-nav-link,
    .desktop-nav-chevron {
      transition: none;
    }

    .desktop-nav-dropdown:not([hidden]) {
      animation: none;
    }
  }
</style>
