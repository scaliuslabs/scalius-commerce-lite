---
// The buyer's light or dark switch the store adds to a header skin's
// `header.actions` slot when the theme offers it (Theme settings, Colours),
// as the core header draws its own: a skin never drops the merchant's
// switch. The head script shows and runs it (lib/color-scheme.ts); it stays
// hidden without JavaScript.
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";

const { theme, language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).chrome;
---

{
  theme.tokens.colorSchemeToggle && (
    <button
      type="button"
      class="inline-flex size-11 shrink-0 items-center justify-center rounded-full text-current hover:bg-current/10 focus-visible:outline-2 focus-visible:outline-current"
      data-color-scheme-toggle
      data-sx-host-color-scheme-toggle
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" class="size-[1.375rem] fill-none stroke-current dark:hidden" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.1A8.5 8.5 0 1 1 9.9 3.5a6.6 6.6 0 0 0 10.6 10.6Z" /></svg>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="hidden size-[1.375rem] fill-none stroke-current dark:block" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <span class="sr-only">{copy.header.darkColors}</span>
    </button>
  )
}
