---
// The drill-in menu inside a drawer (44px rows, 52px on Marketplace phones):
// one level at a time. A row with children is a <details>; opening it lays
// its level over the current one, with the row itself (the <summary>) as the
// "back" bar on top, so the pattern works without JavaScript and scales to
// any depth. Each level starts with "All <parent>" when the parent links a
// page. nav-menus.ts adds arrow keys (Right drills in, Left goes back) and
// Escape one level at a time; the drawer closes on Escape at the top level.
//
// Levels are `position: fixed` inside `.drill` (which contains layout), so
// every level fills the drawer's menu area whatever the scroll position of
// the level under it. A long name wraps in the back bar: the level starts
// with an invisible copy of the bar, so its first row is never covered.
// The top level ends with "All categories" (/categories) when the header
// shows only part of the tree.
import type { NavigationItem } from "@/lib/api";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { storefrontCopy } from "@/lib/storefront-copy";
import {
  ariaCurrent,
  navigationChildren,
  navigationCurrent,
  navigationLinkAttributes,
} from "./navigation-state";

interface Props {
  items: NavigationItem[];
  /** Unique per drawer: names the exclusive level groups. */
  idPrefix: string;
  depth?: number;
  parent?: NavigationItem;
  /** The top level ends with "All categories" (/categories). */
  allCategories?: boolean;
}

const { items = [], idPrefix, depth = 0, parent, allCategories = false } = Astro.props;
const { language } = await currentRequestTheme(Astro.locals);
const copy = storefrontCopy(language).chrome;
const visible = items.filter((item) => item?.title);
const link = (item: NavigationItem) => ({
  href: item.href,
  "aria-current": ariaCurrent(navigationCurrent(item, Astro.url)),
  "data-astro-prefetch": getStorefrontPrefetchAttribute(item.href, Astro.url),
  ...navigationLinkAttributes(item),
});
// Levels stack by depth (--drill-depth); the first four come from the style
// block below, deeper ones (rare) carry it inline.
const DRILL_DEPTHS_IN_CSS = 4;
const Wrapper = depth === 0 ? "div" : Fragment;
const wrapperProps = depth === 0 ? { class: "drill", "data-menu-root": "", "data-drill": "" } : {};
---

<Wrapper {...wrapperProps}>
<ul class="drill-list" data-menu-list data-depth={depth}>
  {parent?.href && (
    <li><a class="drill-link drill-link--all" {...link(parent)}>{copy.nav.allOf(parent.title)}</a></li>
  )}
  {visible.map((item) => {
    const children = navigationChildren(item);
    if (children.length === 0) {
      return (
        <li>{item.href ? <a {...link(item)}>{item.title}</a> : <span class="drill-link">{item.title}</span>}</li>
      );
    }
    return (
      <li>
        <details class="drill-node" data-menu="drill" name={`${idPrefix}-${depth}`} style={depth >= DRILL_DEPTHS_IN_CSS ? `--drill-depth:${depth + 1}` : undefined}>
          <summary class="drill-link drill-next"><span>{item.title}</span></summary>
          <div class="drill-level" data-menu-panel data-ghost={item.title}>
            <Astro.self items={children} idPrefix={idPrefix} depth={depth + 1} parent={item} />
          </div>
        </details>
      </li>
    );
  })}
  {depth === 0 && allCategories && (
    <li class="drill-row drill-row--all">
      <a class="drill-link drill-link--all" href="/categories">
        <span>{copy.nav.allCategories}</span>
        <i class="nav-chevron nav-chevron--right drill-next-icon" aria-hidden="true"></i>
      </a>
    </li>
  )}
</ul>
</Wrapper>

<style is:global>
  /* The root wrapper is a dynamic element (no scope attribute): global selector. */
  .drill[data-drill] {
    position: relative;
    height: 100%;
    min-height: 0;
    contain: layout;
  }

  .drill[data-drill] > .drill-list {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .drill-list {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.75rem 1rem;
  }

  /* Rows are plain <li>s and parents carry no icon elements or ghost copy:
     the drawer repeats per page, so its markup stays lean. */
  .drill-list > li {
    display: block;
  }

  .drill-list[data-depth="0"] > li > .drill-node { --drill-depth: 1; }
  .drill-list[data-depth="1"] > li > .drill-node { --drill-depth: 2; }
  .drill-list[data-depth="2"] > li > .drill-node { --drill-depth: 3; }
  .drill-list[data-depth="3"] > li > .drill-node { --drill-depth: 4; }

  /* A leaf row is a bare <a> (every rule reaches it through :where, so the
     specificity is the class's alone). */
  :is(.drill-link, :where(.drill-list > li > a)) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius);
    color: inherit;
    font-size: 1rem;
    text-align: start;
    overflow-wrap: anywhere;
    list-style: none;
    cursor: pointer;
  }

  /* Departments read in the same medium weight as the accordion drawer's rows (the "All" rows and the back bar stand out). */
  .drill-list[data-depth="0"] > li > :is(.drill-link, :where(a)):not(.drill-link--all),
  .drill-list[data-depth="0"] > li > .drill-node:not([open]) > .drill-next {
    font-weight: 500;
  }

  .drill-link--all {
    font-weight: 600;
  }

  .drill-next::-webkit-details-marker {
    display: none;
  }

  .drill-next > span {
    flex: 1;
    min-width: 0;
  }

  .drill-link .nav-chevron {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* A parent row's chevrons (the header's .nav-chevron masks, 1rem): "next"
     after the name, "back" before it once the row is the open level's bar. */
  .drill-next::before,
  .drill-next::after {
    content: "";
    display: inline-block;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    background: currentColor;
    -webkit-mask: var(--nav-chevron-right) center / contain no-repeat;
    mask: var(--nav-chevron-right) center / contain no-repeat;
    transition: transform 200ms ease;
  }

  .drill-next::before {
    display: none;
    -webkit-mask-image: var(--nav-chevron-left);
    mask-image: var(--nav-chevron-left);
  }

  a:is(.drill-link, :where(.drill-list > li > a)):hover,
  .drill-next:hover {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  :is(.drill-link, :where(.drill-list > li > a)):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  :is(.drill-link, :where(.drill-list > li > a))[aria-current="page"] {
    background: var(--accent);
    color: var(--accent-foreground);
    font-weight: 600;
  }

  /* An open row becomes the level's "back" bar on top; its level fills the rest. */
  .drill-node[open] > .drill-next,
  .drill-level::before {
    min-height: 3rem;
    padding: 0.625rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .drill-node[open] > .drill-next {
    position: fixed;
    top: 0;
    inset-inline-start: 0;
    inset-inline-end: 0;
    z-index: calc(var(--drill-depth) * 2 + 1);
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    background: var(--card);
    color: var(--card-foreground);
    font-weight: 700;
  }

  .drill-node[open] > .drill-next::before {
    display: block;
  }

  .drill-node[open] > .drill-next::after {
    display: none;
  }

  /* The bar's twin (the level's ::before, its text from data-ghost): same
     text in the same box, so the level starts under the bar at any length.
     The start padding stands for the bar's back chevron and its gap. */
  .drill-level::before {
    content: attr(data-ghost);
    display: block;
    padding-inline-start: calc(1.25rem + 1rem + 0.5rem);
    visibility: hidden;
    border-bottom: 1px solid transparent;
    overflow-wrap: anywhere;
  }

  .drill-row--all {
    margin-top: 0.25rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--border);
  }

  .drill-row--all .drill-link > span {
    flex: 1;
  }

  .drill-level {
    position: fixed;
    inset: 0;
    z-index: calc(var(--drill-depth) * 2);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--card);
    color: var(--card-foreground);
    animation: drill-in 200ms ease-out;
  }

  @keyframes drill-in {
    from {
      transform: translateX(1.5rem);
      opacity: 0;
    }
  }

  /* Covered rows leave the tab order (the open row's summary is the back bar). */
  .drill-list:has(> li > .drill-node[open]) > li:not(:has(> .drill-node[open])),
  .drill-node[open]:has(.drill-node[open]) > .drill-next {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .drill-level {
      animation: none;
    }
  }
</style>
