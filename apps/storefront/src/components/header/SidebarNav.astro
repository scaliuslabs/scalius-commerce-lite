---
// The departments rail kept open (desktop menu `departments-rail`, open
// "always"; Chaldal's 240px rail): on computers the menu is a column beside
// the page content, sticky under the header, the current department
// expanded. Layout.astro renders it inside `.site-shell[data-site-shell="sidebar"]`
// next to <main>, so every full-bleed section stays within the content column.
// Phones use the drawer or the tab bar instead. Like every menu rendering it
// keeps to its share of the link budget (nav-tree.ts).
import type { CategoryNavigationTree, NavigationItem } from "@/lib/api";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import NavTree from "./NavTree.astro";
import { HEADER_FIXED_LINKS, navigationIndexMode, planHeaderNavigation, sourceNavigation } from "./nav-tree";

interface Props {
  /** The header menu; the theme's navigation source decides what renders. */
  navigation: NavigationItem[];
  categoryTree?: CategoryNavigationTree | null;
}

const { resolved } = await currentRequestTheme(Astro.locals);
const source = resolved.blocks.navigation;
const nodes = Astro.props.categoryTree?.nodes ?? [];
const tree = sourceNavigation(source.source, Astro.props.navigation, nodes);
// The column is its own rendering: the budget less the header's fixed links, halved like any surface.
const plan = planHeaderNavigation(
  tree,
  { maxTopItems: source.maxTopItems, linkBudget: source.linkBudget, index: navigationIndexMode(source.source !== "menu", nodes.length > 0) },
  { desktop: false, desktopRow: false, desktopAllLinks: false, drawerAllLinks: false, desktopWeight: 0, reserved: HEADER_FIXED_LINKS + Math.floor(source.linkBudget / 2) },
);
---

<nav id="sidebar-nav" class="sidebar-nav" aria-label="Main navigation">
  <NavTree items={plan.drawer} idPrefix="sidebar-nav" variant="sidebar" allCategories={plan.allCategories} />
</nav>

<style is:global>
  @media (min-width: 64rem) {
    /* Aligned with the header: the column starts under the logo and the
       content keeps its own gutter, so the right edge matches the cart. */
    .site-shell[data-site-shell="sidebar"] {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: start;
      width: 100%;
      max-width: var(--theme-container-width, 80rem);
      margin-inline: auto;
      padding-left: 2rem;
    }

    /* The divider belongs to the content column, so it runs the page's full
       height instead of stopping where the sticky menu ends. */
    .site-shell[data-site-shell="sidebar"] > main {
      border-left: 1px solid var(--border);
    }
  }
</style>

<style>
  .sidebar-nav {
    display: none;
  }

  @media (min-width: 64rem) {
    .sidebar-nav {
      display: block;
      position: sticky;
      top: var(--header-height, 7rem);
      max-height: calc(100dvh - var(--header-height, 7rem));
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      padding: 1.5rem 0.75rem 2rem 0;
    }
  }
</style>
