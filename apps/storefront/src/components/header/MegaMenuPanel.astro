---
// A mega menu panel: full width under the header, one column per
// second-level item (its photo when it links a category with one, its name,
// then its own links) and a "Shop all" link for the parent. Photos are small,
// lazy, fixed-ratio and decorative (the link text names them).
import type { NavigationItem } from "@/lib/api";
import { mediaImageUrl } from "@/lib/media-url";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import {
  ariaCurrent,
  navigationChildren,
  navigationCurrent,
  navigationLinkAttributes,
} from "./navigation-state";

interface Props {
  id: string;
  item: NavigationItem;
  /**
   * Linked items with a photo render as 120px photo tiles instead of text
   * (Fabrilife's promo images): the same links, so the header's link count
   * does not grow; photos are lazy and fetched only once the panel opens.
   */
  promoImages?: boolean;
}

const { id, item, promoImages = false } = Astro.props;
const columns = navigationChildren(item);
const photo = (url: string | undefined) => (url ? mediaImageUrl(url, 480) : "");
const featurePhoto = item.href ? photo(item.imageUrl) : "";
const link = (target: NavigationItem) => ({
  href: target.href,
  "aria-current": ariaCurrent(navigationCurrent(target, Astro.url)),
  "data-astro-prefetch": getStorefrontPrefetchAttribute(target.href, Astro.url),
  ...navigationLinkAttributes(target),
});
---

<div id={id} class="mega-panel" data-mega-panel hidden>
  <div class="mega-panel-scroll">
    <div class:list={["mega-panel-layout", featurePhoto && "mega-panel-layout--feature"]}>
      <div class="mega-panel-main">
        {
          item.href && !featurePhoto && (
            <a class="mega-shop-all" {...link(item)}>
              Shop all {item.title}
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" /></svg>
            </a>
          )
        }
        <ul class="mega-columns">
          {
            columns.map((column) => {
              const image = photo(column.imageUrl);
              const links = navigationChildren(column);
              const Heading = column.href ? "a" : "p";
              return (
                <li class="mega-column">
                  <Heading class="mega-column-heading" {...(column.href ? link(column) : {})}>
                    {image && (
                      <span class="mega-column-photo">
                        <img src={image} alt="" width="480" height="360" loading="lazy" decoding="async" />
                      </span>
                    )}
                    <span class="mega-column-title">{column.title}</span>
                  </Heading>
                  {promoImages && links.some((entry) => entry.href && entry.imageUrl) && (
                    <ul class="mega-promo">
                      {links
                        .filter((entry) => entry.href && entry.imageUrl)
                        .map((entry) => (
                          <li>
                            <a class="mega-promo-tile" {...link(entry)}>
                              <span class="mega-promo-photo">
                                <img src={mediaImageUrl(entry.imageUrl!, 240)} alt="" width="120" height="120" loading="lazy" decoding="async" />
                              </span>
                              <span class="mega-promo-title">{entry.title}</span>
                            </a>
                          </li>
                        ))}
                    </ul>
                  )}
                  {links.length > 0 && (
                    <ul class="mega-links">
                      {links.filter((entry) => !(promoImages && entry.href && entry.imageUrl)).map((entry) =>
                        entry.href ? (
                          <li>
                            <a class="mega-link" {...link(entry)}>
                              {entry.title}
                            </a>
                          </li>
                        ) : (
                          <li class="mega-link">{entry.title}</li>
                        ),
                      )}
                    </ul>
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>
      {
        featurePhoto && (
          <a class="mega-feature" {...link(item)}>
            <span class="mega-feature-photo">
              <img src={featurePhoto} alt="" width="480" height="600" loading="lazy" decoding="async" />
            </span>
            <span class="mega-shop-all">
              Shop all {item.title}
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" /></svg>
            </span>
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  /* Anchored to the header's menu row (its nearest positioned ancestor), so
     the columns line up with the header content; the backdrop bleeds to the
     viewport edges. */
  .mega-panel {
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    right: 0;
    z-index: 60;
    color: var(--foreground);
  }

  .mega-panel::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline: calc(50% - 50vw);
    background: var(--background);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 28px 48px -32px rgb(0 0 0 / 0.35);
  }

  .mega-panel:not([hidden]) {
    animation: mega-panel-enter 180ms ease-out;
  }

  @keyframes mega-panel-enter {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  .mega-panel-scroll {
    max-height: calc(100dvh - var(--header-height, 8rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.75rem 0.25rem 2.25rem;
  }

  .mega-panel-layout {
    display: grid;
    gap: 2.5rem;
  }

  .mega-panel-layout--feature {
    grid-template-columns: minmax(0, 1fr) clamp(12rem, 20vw, 16rem);
  }

  .mega-columns {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 1.75rem 2rem;
    align-items: start;
  }

  .mega-column-heading {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--foreground);
  }

  .mega-column-photo,
  .mega-feature-photo {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--muted);
  }

  .mega-column-photo {
    aspect-ratio: 4 / 3;
  }

  .mega-feature-photo {
    aspect-ratio: 4 / 5;
  }

  .mega-column-photo img,
  .mega-feature-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  a:hover > .mega-column-photo img,
  a:hover > .mega-feature-photo img {
    transform: scale(1.04);
  }

  .mega-column-title {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: var(--theme-label-tracking, 0.01em);
    line-height: 1.3;
  }

  a.mega-column-heading:hover .mega-column-title,
  a.mega-link:hover,
  .mega-shop-all:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .mega-links {
    margin-top: 0.375rem;
  }

  .mega-links:empty {
    display: none;
  }

  .mega-promo {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.5rem, 7.5rem));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .mega-promo-tile {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    color: var(--foreground);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .mega-promo-photo {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--muted);
  }

  .mega-promo-photo img {
    width: 100%;
    height: 100%;
    object-fit: var(--theme-image-fit, cover);
  }

  .mega-promo-tile:hover .mega-promo-title {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .mega-link {
    display: flex;
    align-items: center;
    min-height: 2rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  a.mega-link:hover,
  a.mega-link[aria-current] {
    color: var(--foreground);
  }

  .mega-shop-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: var(--theme-label-tracking, 0.01em);
    color: var(--foreground);
  }

  .mega-shop-all svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mega-feature {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mega-feature .mega-shop-all {
    margin-bottom: 0;
  }

  .mega-panel a:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 2px;
    border-radius: var(--radius);
  }

  @media (pointer: coarse) {
    .mega-link,
    .mega-shop-all {
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-panel:not([hidden]) {
      animation: none;
    }

    .mega-column-photo img,
    .mega-feature-photo img {
      transition: none;
    }
  }
</style>
