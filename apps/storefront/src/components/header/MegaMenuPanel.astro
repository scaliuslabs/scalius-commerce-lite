---
// A mega menu panel (Fabrilife): about 980px wide under the header row,
// centred, up to four columns. A second-level item with links of its own is
// a column: its name as an uppercase heading, then up to ten links;
// second-level items without links of their own share plain columns of ten.
// "View all <department> →" closes the panel, and with `promoImages` linked
// items that have a photo move out of the columns into photo tiles beside
// them (the same links, so the header's link count does not grow). Photos
// are small, lazy and fetched only once the panel opens.
import type { NavigationItem } from "@/lib/api";
import { mediaImageUrl } from "@/lib/media-url";
import { getStorefrontPrefetchAttribute } from "@/lib/prefetch-policy";
import {
  ariaCurrent,
  navigationChildren,
  navigationCurrent,
  navigationLinkAttributes,
} from "./navigation-state";

interface Props {
  id: string;
  item: NavigationItem;
  promoImages?: boolean;
}

/** Links a column lists (Fabrilife: 7-10). */
const COLUMN_LINKS = 10;
/** Columns a panel shows; a department with more groups lists the rest on its page. */
const MAX_COLUMNS = 4;
const MAX_TILES = 4;

const { id, item, promoImages = false } = Astro.props;
const children = navigationChildren(item);
const link = (target: NavigationItem) => ({
  href: target.href,
  "aria-current": ariaCurrent(navigationCurrent(target, Astro.url)),
  "data-astro-prefetch": getStorefrontPrefetchAttribute(target.href, Astro.url),
  ...navigationLinkAttributes(target),
});

// Photo tiles: linked items with a photo, second or third level, first found first.
const tiles = promoImages
  ? [...children, ...children.flatMap((child) => navigationChildren(child))]
      .filter((entry) => entry.href && entry.imageUrl && navigationChildren(entry).length === 0)
      .slice(0, MAX_TILES)
  : [];
const tiled = new Set(tiles);
const columnCount = tiles.length > 0 ? MAX_COLUMNS - 1 : MAX_COLUMNS;

type Column = { heading: NavigationItem | null; links: NavigationItem[] };
const groups: Column[] = children
  .filter((child) => navigationChildren(child).length > 0)
  .map((child) => ({
    heading: child,
    links: navigationChildren(child).filter((entry) => !tiled.has(entry)).slice(0, COLUMN_LINKS),
  }));
const loose = children.filter((child) => navigationChildren(child).length === 0 && !tiled.has(child));
const plain: Column[] = [];
for (let start = 0; start < loose.length; start += COLUMN_LINKS) {
  plain.push({ heading: null, links: loose.slice(start, start + COLUMN_LINKS) });
}
const columns = [...groups, ...plain].slice(0, columnCount);
---

<div id={id} class="mega-panel" data-mega-panel hidden>
  <div class="mega-body" data-tiles={tiles.length > 0 ? "" : undefined}>
    <ul class="mega-columns" style={`--mega-columns: ${columnCount}`}>
      {
        columns.map((column) => (
          <li class="mega-column">
            {column.heading &&
              (column.heading.href ? (
                <a class="mega-column-heading" {...link(column.heading)}>
                  <span class="mega-column-title">{column.heading.title}</span>
                </a>
              ) : (
                <p class="mega-column-heading">
                  <span class="mega-column-title">{column.heading.title}</span>
                </p>
              ))}
            {column.links.length > 0 && (
              <ul class="mega-links">
                {column.links.map((entry) =>
                  entry.href ? (
                    <li>
                      <a class="mega-link" {...link(entry)}>
                        {entry.title}
                      </a>
                    </li>
                  ) : (
                    <li class="mega-link">{entry.title}</li>
                  ),
                )}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
    {
      tiles.length > 0 && (
        <ul class="mega-promo" aria-label={`Featured in ${item.title}`}>
          {tiles.map((entry) => (
            <li>
              <a class="mega-promo-tile" {...link(entry)}>
                <span class="mega-promo-photo">
                  <img src={mediaImageUrl(entry.imageUrl!, 240)} alt="" width="120" height="120" loading="lazy" decoding="async" />
                </span>
                <span class="mega-promo-title">{entry.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  {
    item.href && (
      <div class="mega-foot">
        <a class="mega-shop-all" {...link(item)}>
          View all {item.title}
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10m-4-4 4 4-4 4" /></svg>
        </a>
      </div>
    )
  }
</div>

<style is:global>
  /* Centred under the header row it hangs from (its nearest positioned
     ancestor): Fabrilife's 980px panel at 1440px. */
  .mega-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 60;
    width: min(61.25rem, calc(100% - 2rem));
    max-height: calc(100dvh - var(--header-height, 8rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    translate: -50% 0;
    border: 1px solid var(--border);
    border-top: 0;
    background: var(--popover, var(--background));
    color: var(--popover-foreground, var(--foreground));
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.35);
    text-transform: none;
    letter-spacing: normal;
  }

  .mega-panel:not([hidden]) {
    animation: mega-panel-enter 180ms ease-out;
  }

  @keyframes mega-panel-enter {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  .mega-body {
    display: grid;
    gap: 2rem;
    padding: 1.75rem 2rem 1.5rem;
  }

  .mega-body[data-tiles] {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .mega-columns {
    display: grid;
    grid-template-columns: repeat(var(--mega-columns, 4), minmax(0, 1fr));
    gap: 1.5rem 2rem;
    align-items: start;
  }

  .mega-column-heading {
    display: block;
    margin-bottom: 0.625rem;
    color: var(--primary);
  }

  .mega-column-title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  a.mega-column-heading:hover .mega-column-title,
  .mega-shop-all:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* Fabrilife's 34px rows. */
  .mega-link {
    display: flex;
    align-items: center;
    min-height: 2.125rem;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--popover-foreground, var(--foreground));
    overflow-wrap: anywhere;
  }

  a.mega-link:hover,
  a.mega-link[aria-current] {
    color: var(--primary);
  }

  a.mega-link[aria-current="page"] {
    font-weight: 600;
  }

  .mega-promo {
    display: grid;
    grid-template-columns: repeat(2, 7.5rem);
    gap: 1rem 1.25rem;
    align-content: start;
    padding-left: 2rem;
    border-left: 1px solid var(--border);
  }

  .mega-promo-tile {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    color: var(--popover-foreground, var(--foreground));
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .mega-promo-photo {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--muted);
  }

  .mega-promo-photo img {
    width: 100%;
    height: 100%;
    object-fit: var(--theme-image-fit, cover);
  }

  .mega-promo-tile:hover .mega-promo-title {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .mega-foot {
    padding: 0.875rem 2rem;
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--muted) 45%, transparent);
  }

  .mega-shop-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 1.5rem;
    color: var(--primary);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .mega-shop-all svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mega-panel a:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 2px;
    border-radius: var(--radius);
  }

  @media (pointer: coarse) {
    .mega-link,
    .mega-shop-all {
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-panel:not([hidden]) {
      animation: none;
    }
  }
</style>
