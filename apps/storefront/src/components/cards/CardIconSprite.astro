---
// The line icons the store's card draws (CARD_ICONS), once per page: every
// card refers to them with <use>, so a listing carries each path once.
import { CARD_ICONS, type CardIconId } from "./card-model";

interface Props {
  icons: CardIconId[];
}

const { icons } = Astro.props;
---

{icons.length > 0 && (
  <svg aria-hidden="true" style="display:none">
    {icons.map((id) => {
      const icon = CARD_ICONS[id];
      return (
        <symbol id={id} viewBox="0 0 24 24">
          <path d={icon.d} fill="none" stroke="currentColor" stroke-width={icon.width} stroke-linecap="round" stroke-linejoin={icon.join ? "round" : undefined} />
        </symbol>
      );
    })}
  </svg>
)}
