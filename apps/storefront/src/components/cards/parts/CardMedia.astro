---
// The card's photo box. Its size is fixed before any photo loads (CLS 0):
// the theme's image ratio and fit tokens (product-card.css). A product
// without a photo shows its initial on the muted surface in the same box,
// never a collapsed tile. The badges and the quick-add button come in the
// default slot.
//
// The hover photo is not in the HTML: the box names its CDN URL
// (`data-hover-src`, with the card's srcset cap in `data-hover-max`), and a
// small script derives its renditions and fetches it at the card's own width when the pointer
// reaches the card (or on idle for cards already on screen), decodes it and
// only then fades it in. No hover bytes before intent below the fold, and
// never a fade over an empty image.
import type { ProductCardImageLoading } from "@/lib/product-card-layout";
import type { ProductCardModel } from "../card-model";

interface Props {
  model: ProductCardModel;
  sizes: string;
  loading: ProductCardImageLoading;
  /** Intrinsic width and height (the box's ratio). */
  dimensions: { width: number; height: number };
}

const { model, sizes, loading, dimensions } = Astro.props;
const { width, height } = dimensions;
const hover = model.image ? model.hoverImage : null;
---

<div class="product-card-media" data-hover-src={hover?.url} data-hover-max={hover?.maxWidth}>
  {
    model.image ? (
      <img
        src={model.image.src}
        srcset={model.image.srcset}
        sizes={sizes}
        alt={model.image.alt}
        width={width}
        height={height}
        loading={loading.loading}
        fetchpriority={loading.fetchpriority === "auto" ? undefined : loading.fetchpriority}
        decoding={loading.decoding}
        class="product-card-photo"
      />
    ) : (
      <div class="product-card-placeholder" aria-hidden="true" data-card-placeholder>
        <span>{model.monogram}</span>
      </div>
    )
  }
  <slot />
</div>

<script>
  import { hoverImageSources } from "@/lib/responsive-image";

  // One listener for every card on the page (Astro bundles this once).
  const BOX = "[data-hover-src]";
  const started = new WeakSet<HTMLElement>();

  function reveal(box: HTMLElement) {
    if (started.has(box)) return;
    started.add(box);
    const url = box.dataset.hoverSrc;
    if (!url) return;
    // The same 480px `src` and capped `srcset` the card photo was given.
    const { src, srcset } = hoverImageSources(url, Number(box.dataset.hoverMax) || undefined);
    const photo = box.querySelector<HTMLImageElement>("img.product-card-photo");
    const image = document.createElement("img");
    image.className = "product-card-photo product-card-hover-image";
    image.alt = "";
    image.setAttribute("aria-hidden", "true");
    image.decoding = "async";
    if (photo) {
      image.width = photo.width;
      image.height = photo.height;
    }
    // The hover photo fills the same box: it takes the card photo's `sizes`.
    if (srcset) {
      image.sizes = photo?.sizes ?? "";
      image.srcset = srcset;
    }
    image.src = src;
    image.decode().then(
      () => {
        box.append(image);
        box.dataset.hoverReady = "";
      },
      () => undefined,
    );
  }

  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
  document.addEventListener(
    "pointerover",
    (event) => {
      if (event.pointerType !== "mouse" || !(event.target instanceof Element)) return;
      const box = event.target.closest('[data-theme-component="product-card"]')?.querySelector<HTMLElement>(BOX);
      if (box) reveal(box);
    },
    { passive: true },
  );

  // Cards already on screen get theirs when the page is idle, so the first
  // hover is instant; cards below the fold wait for the pointer.
  function warmVisible() {
    if (!canHover.matches) return;
    for (const box of document.querySelectorAll<HTMLElement>(BOX)) {
      const { top, bottom } = box.getBoundingClientRect();
      if (bottom > 0 && top < window.innerHeight) reveal(box);
    }
  }
  const whenIdle = (task: () => void) =>
    "requestIdleCallback" in window ? window.requestIdleCallback(task, { timeout: 3000 }) : window.setTimeout(task, 1500);
  if (document.readyState === "complete") whenIdle(warmVisible);
  else window.addEventListener("load", () => whenIdle(warmVisible), { once: true });
</script>
