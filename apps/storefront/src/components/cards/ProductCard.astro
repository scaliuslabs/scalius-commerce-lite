---
// src/components/cards/ProductCard.astro
// One card per store (mix rule 2): listings, rails, related products and
// search render the theme's card variant. `standard` is today's classic card;
// every other variant renders its registry anatomy (variants/anatomy.astro).
import "@/styles/theme-cards.css";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import { buildStorefrontThemeTokens, type ResolvedStorefrontCard } from "@scalius/shared/storefront-theme";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import {
  productCardImageLoading,
  productCardImageSizes,
  productGridFirstRow,
  productGridSpec,
  type ProductGridContext,
  type ProductGridPhoneLayout,
} from "@/lib/product-card-layout";
import { productCardModel, type ProductCardProduct } from "./card-model";
import StandardCard from "./variants/standard.astro";
import AnatomyCard from "./variants/anatomy.astro";

interface Props {
  product: ProductCardProduct;
  currencySymbol?: string;
  currencyCode?: string;
  /** Position in its list; with `aboveFold`, the first row loads eagerly. */
  index?: number;
  /** The list starts in the first viewport (its first photo is a likely LCP). */
  aboveFold?: boolean;
  /**
   * Where the card sits, for image `sizes`: a page-wide grid, the catalog
   * grid beside the filter sidebar, or a horizontal collection rail.
   */
  context?: ProductGridContext;
  /** The grid's phone layout (ProductGrid `phoneLayout`): list rows have a small photo. */
  phoneLayout?: ProductGridPhoneLayout;
  /**
   * The page container's max width when it is not the theme's (the product
   * page keeps `max-w-7xl` at 80rem), so `sizes` caps where the grid does.
   */
  containerWidth?: string;
  /**
   * The photo's `sizes` when the card sits in a layout the grid model does
   * not describe (listing list rows, shelves, the quick-add grid).
   */
  sizes?: string;
  headingLevel?: "h2" | "h3";
  /** The grid's column cap (a homepage grid section's `columns`), for image `sizes`. */
  maxColumns?: number;
}

const {
  product,
  currencySymbol = DEFAULT_CURRENCY.symbol,
  currencyCode = DEFAULT_CURRENCY.code,
  index,
  aboveFold = false,
  context = "grid",
  phoneLayout = "grid",
  containerWidth: containerWidthOverride,
  sizes: sizesOverride,
  headingLevel = "h3",
  maxColumns,
} = Astro.props;

// The card variant and its anatomy come from the resolved theme; the photo
// ratio and fit are tokens; density and the container width set the fluid
// grid the image `sizes` follow.
const { theme, resolved, layout } = await currentRequestTheme(Astro.locals);
const variant = resolved.blocks.card.variant;
const anatomy: ResolvedStorefrontCard = layout.productCard;
const ratio = theme.tokens.imageRatio;
const grid = productGridSpec(layout.grid, ratio);
const containerWidth =
  containerWidthOverride ?? buildStorefrontThemeTokens(theme)["theme-container-width"]!;
const loading = productCardImageLoading(
  productGridFirstRow(grid, containerWidth, maxColumns),
  { index, aboveFold },
);
const sizes = sizesOverride ?? productCardImageSizes(grid, containerWidth, context, phoneLayout, maxColumns);
const model = productCardModel(product, {
  currencySymbol,
  currencyCode,
  hoverImage: anatomy.hoverImage,
  quickBuy: anatomy.quickBuy,
});
---

{
  variant === "standard" ? (
    <StandardCard model={model} ratio={ratio} sizes={sizes} loading={loading} headingLevel={headingLevel} />
  ) : (
    <AnatomyCard
      variant={variant}
      anatomy={anatomy}
      model={model}
      ratio={ratio}
      sizes={sizes}
      loading={loading}
      headingLevel={headingLevel}
    />
  )
}
