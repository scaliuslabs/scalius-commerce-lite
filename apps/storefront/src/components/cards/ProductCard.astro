---
// The product card every listing, rail and search draws: the app card the
// theme names (`apps.productCard`, an app's product-card slot), else the
// theme's own card (CoreProductCard.astro). The app card gets the same
// card model (prices in the page's market, photo renditions, the quick-add
// rules); one that fails or is late gives way to the core card. A grid of
// app cards is one call to the app (lib/extensions/host.ts).
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import { storefrontExtensionBase } from "@scalius/shared/plugins/storefront-protocol";
import AppComponent from "@/components/apps/AppComponent.astro";
import { appSlot, requestExtensions } from "@/lib/extensions";
import { productCardData } from "@/lib/extensions/data";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { productCardModel } from "./card-model";
import CoreProductCard from "./CoreProductCard.astro";

type Props = import("astro/types").ComponentProps<typeof CoreProductCard>;

const props = Astro.props;
const app = await appSlot(Astro.locals, Astro.url, "product-card");
let html: string | null = null;
if (app) {
  const { resolved, layout } = await currentRequestTheme(Astro.locals);
  const currency = { symbol: props.currencySymbol ?? DEFAULT_CURRENCY.symbol, code: props.currencyCode ?? DEFAULT_CURRENCY.code };
  const model = productCardModel(props.product, {
    currencySymbol: currency.symbol,
    currencyCode: currency.code,
    hoverImage: layout.productCard.hoverImage,
    ratings: resolved.facts.hasReviews,
  });
  const { host } = await requestExtensions(Astro.locals, Astro.url);
  html = await host.render(app.extension, {
    kind: "slot",
    slot: "product-card",
    component: app.component,
    settings: app.settings,
    data: {
      product: productCardData(props.product, model, currency),
      position: props.index ?? 0,
      aboveFold: props.aboveFold === true && (props.index ?? 0) < 4,
    },
  });
}
---

{html !== null && app
  ? <AppComponent html={html} pluginId={app.extension.pluginId} base={storefrontExtensionBase(app.extension.pluginId, app.extension.release)} />
  : <CoreProductCard {...props} />}
