---
// src/components/cards/ProductCard.astro
import type { Product } from "@/lib/api";
import { formatDiscountBadge } from "@/components/product/lib/pricing-engine";
import { getProductImageSrcSet, getProductImageUrl } from "@/lib/product-media";
import { formatMoney } from "@/lib/currency";
import { currentRequestTheme } from "@/lib/storefront-theme-context";
import { productCardImageSizes } from "@/lib/product-card-layout";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";

interface Props {
  product: Product & { secondaryImageUrl?: string | null };
  currencySymbol?: string;
  currencyCode?: string;
  priority?: boolean;
  headingLevel?: "h2" | "h3";
}

const {
  product,
  currencySymbol = DEFAULT_CURRENCY.symbol,
  currencyCode = DEFAULT_CURRENCY.code,
  priority = false,
  headingLevel = "h3",
} = Astro.props;
const TitleTag = headingLevel;
const money = (price: number) =>
  formatMoney(price, { symbol: currencySymbol, code: currencyCode });

// Card options come from the theme (Online store → Theme → Product cards).
const { layout } = await currentRequestTheme(Astro.locals);
const card = layout.productCard;

const hasDiscount = product.discountedPrice < product.price;
const pricePrefix = product.priceVaries ? "From " : "";
const discountBadge = formatDiscountBadge(
  product.discountType,
  product.discountPercentage,
  product.discountAmount,
);
const soldOut = product.availableForSale === false;
const productHref = `/products/${product.slug}`;

const productImageUrl = getProductImageUrl(product.imageUrl, 480);
const productImageSrcSet = getProductImageSrcSet(product.imageUrl);
const imageSizes = productCardImageSizes(layout.grid);
// A second photo on hover: pointer devices only (CSS), loaded lazily.
const hoverImage = card.hoverImage && product.secondaryImageUrl
  ? {
      src: getProductImageUrl(product.secondaryImageUrl, 480),
      srcset: getProductImageSrcSet(product.secondaryImageUrl),
    }
  : null;
// "Buy now" needs no choice from the buyer: in stock and without options.
const quickBuyHref = card.quickBuy && !soldOut && !product.hasVariants
  ? `/buy/${encodeURIComponent(product.slug)}`
  : null;
const portrait = card.imageRatio === "portrait";
---

{/* One link per card: the title link stretches over the whole card, so the
    card is a single tab stop and screen readers hear the name once. The
    optional "Buy now" sits above that link as its own control. */}
<div
  data-theme-component="product-card"
  class="group relative flex flex-col h-full bg-card rounded-2xl overflow-hidden transition-all duration-500 hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] border border-border/50 hover:border-transparent"
>
  <div class:list={["relative overflow-hidden bg-muted", portrait ? "aspect-[4/5]" : "aspect-square"]}>
    <img
      src={productImageUrl}
      srcset={productImageSrcSet}
      sizes={imageSizes}
      alt={product.imageAlt || product.name}
      width={400}
      height={portrait ? 500 : 400}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding={priority ? "sync" : "async"}
      class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
    />
    {
      hoverImage && (
        <img
          src={hoverImage.src}
          srcset={hoverImage.srcset}
          sizes={imageSizes}
          alt=""
          aria-hidden="true"
          width={400}
          height={portrait ? 500 : 400}
          loading="lazy"
          decoding="async"
          class="product-card-hover-image absolute inset-0 hidden h-full w-full object-cover object-center opacity-0 transition-opacity duration-300 group-hover:opacity-100"
        />
      )
    }

    <div class="absolute top-3 left-3 flex flex-col gap-1.5 pointer-events-none">
      {
        discountBadge && card.badge === "image" && (
          <span class="px-2.5 py-1 text-xs font-bold text-destructive-foreground bg-destructive rounded-full shadow-sm">
            {discountBadge}
          </span>
        )
      }
      {
        soldOut && (
          <span class="px-2.5 py-1 text-xs font-bold text-foreground bg-background/90 rounded-full shadow-sm border border-border">
            Sold out
          </span>
        )
      }
    </div>
  </div>

  <div class="p-3 sm:p-4 flex flex-col flex-1">
    <TitleTag
      class="mb-1 text-sm sm:text-[15px] font-semibold text-foreground leading-tight line-clamp-2 min-h-[2.25rem] group-hover:text-primary transition-colors duration-300"
    >
      <a
        href={productHref}
        class="after:absolute after:inset-0 after:content-['']"
      >
        {product.name}
      </a>
    </TitleTag>

    <p class="mt-auto flex flex-col">
      {
        hasDiscount && (
          <span class="flex flex-wrap items-center gap-x-2 text-xs text-muted-foreground font-medium leading-none">
            <span><span class="sr-only">Regular price </span><s>{money(product.price)}</s></span>
            {discountBadge && card.badge === "price" && (
              <span class="font-bold text-destructive">{discountBadge}</span>
            )}
          </span>
        )
      }
      <span class="text-base sm:text-lg font-extrabold text-foreground tracking-tight leading-tight">
        <span class="sr-only">{hasDiscount ? "Sale price " : "Price "}</span>
        {pricePrefix}{money(product.discountedPrice)}
      </span>
    </p>

    {
      quickBuyHref && (
        <a
          href={quickBuyHref}
          data-astro-prefetch="false"
          rel="nofollow"
          class="relative z-10 mt-3 inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
          aria-label={`Buy ${product.name} now`}
        >
          Buy now
        </a>
      )
    }
  </div>
</div>

<style>
  /* The hover photo exists only where hover exists. */
  @media (hover: hover) and (pointer: fine) {
    .product-card-hover-image {
      display: block;
    }
  }
</style>
