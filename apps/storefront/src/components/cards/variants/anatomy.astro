---
// Every card variant except `standard`, rendered from its measured anatomy
// in the shared registry (STOREFRONT_CARD_VARIANTS[...].renders): the body
// order, discount wording, facts, buy action and Compare are data; the
// look (photo ratio and fit, radius, surface, title and price type) is the
// card's own (`layout.productCard.look`), drawn per variant by
// theme-cards.css so each card reads as its reference (Dawn, Aarong,
// Fabrilife, Star Tech, Apple Gadgets, Target, Daraz, Chaldal, Amazon).
// Facts without data render nothing.
import type { ResolvedStorefrontCard } from "@scalius/shared/storefront-theme";
import type { ProductCardImageLoading } from "@/lib/product-card-layout";
import CardMedia from "../parts/CardMedia.astro";
import CompareTray from "@/components/compare/CompareTray.astro";
import {
  boughtInPastMonth,
  cardDiscountLabel,
  cardFactPresent,
  type ProductCardModel,
} from "../card-model";

interface Props {
  variant: string;
  anatomy: ResolvedStorefrontCard;
  model: ProductCardModel;
  dimensions: { width: number; height: number };
  sizes: string;
  loading: ProductCardImageLoading;
  headingLevel: "h2" | "h3";
  /** The product id, for Compare. */
  productId: string;
  showBuyNow?: boolean;
}

const { variant, anatomy, model, dimensions, sizes, loading, headingLevel, productId, showBuyNow = false } = Astro.props;
const TitleTag = headingLevel;
const discount = cardDiscountLabel(model, anatomy.discount);
const { facts } = model;
const parts = anatomy.body.filter((part) => part === "title" || part === "price" || cardFactPresent(facts, part));
// Only the spec card reserves a shared footer for its price, Buy now and
// Compare. Other cards keep the price beside whatever facts this product has.
const priceFollowsTitle = parts.indexOf("price") > parts.indexOf("title");
const compactSpec = variant === "spec" && facts.keySpecs.length < 3;
const pushPrice = variant === "spec" && !compactSpec && priceFollowsTitle;
const quickRetail = variant === "retail" && anatomy.action === "outline";
const showcaseAdd = variant === "showcase" && model.quickAddEligible;
const showcaseDetail = variant === "showcase" && !showcaseAdd && !model.soldOut && !model.needsOptions;
const cartAction = variant === "retail" || variant === "quick-add" || (variant === "boutique" && anatomy.quickBuy) || showcaseAdd;
const pushAction = (!priceFollowsTitle && variant !== "retail") || variant === "showcase" || variant === "detailed";
const quickAdd = variant === "quick-add";
const actionText = anatomy.actionLabel === "buy-now" ? "Buy now" : quickRetail || variant === "showcase" ? "Add" : "Add to cart";
const roundAction = anatomy.quickBuy && anatomy.action === "round";
const bodyAction = anatomy.quickBuy && anatomy.action !== "round";
// The title's weight is the card's look (--pc-title-w), drawn by theme-cards.css.
const titleClamp = { 1: "line-clamp-1", 2: "line-clamp-2", 3: "line-clamp-3" }[anatomy.titleLines];
const discounted = model.price.regular !== null;
const priceTone = anatomy.priceTone === "primary"
  ? "text-primary"
  : anatomy.priceTone === "sale-always" || (anatomy.priceTone === "sale" && discounted) ? "text-destructive" : "text-foreground";
const superscriptPrice = variant === "detailed";
// The discount mark on the photo, beside the price, or both (the price row
// then repeats the percentage after the struck price, as Fabrilife does).
const imageMark = anatomy.badge === "image" || anatomy.badge === "both" ? discount : null;
const priceMark = anatomy.badge === "price" ? discount : anatomy.badge === "both" ? model.percentOff : null;
const soldText = facts.sold === null
  ? ""
  : variant === "detailed" ? `${boughtInPastMonth(facts.sold)} bought in past month` : `${facts.sold} sold in 30 days`;
const optionsHint = quickRetail ? "Options" : anatomy.action === "compact" ? "See options" : "Choose options";
const productPageHint = model.needsOptions ? optionsHint : "View product";
const productPageOnly = !model.quickBuyHref && !model.soldOut;
// The card's own look (--pc-ratio, --pc-fit, --pc-radius, --pc-inset, type)
// is one token block per page (Layout.astro, cardLookTokens), and the
// store-wide card flags (photo fit, Target's quick retail, Chaldal's full
// essentials) are body attributes (cardPageAttributes): every card of a
// store shares them, so no card repeats them. Shared utilities live in
// theme-cards.css as zero-specificity rules (.pc-act and friends), and the
// icons are <use> references to the page's sprite (CardIconSprite.astro,
// CARD_ICONS).
---

{/* One link per card (the stretched title link) plus at most the buy action
    and, on the spec card, Compare: each sits above the card link as its own
    control. */}
<div
  data-theme-component="product-card"
  data-card-variant={variant}
  class:list={["product-card group", compactSpec ? "self-start product-card-compact" : "h-full"]}
>
  <CardMedia
    model={model}
    dimensions={dimensions}
    sizes={sizes}
    loading={loading}
    badge={imageMark}
    badgeStyle={anatomy.discountStyle}
    class="product-card-well"
  >
    {
      /* A product that cannot be added here opens its detail page. */
      roundAction && productPageOnly && (
        <span
          aria-hidden="true"
          data-card-action-hint
          class:list={[
            variant === "fashion-value"
              ? "pointer-events-none absolute inline-flex items-center justify-center rounded-full bottom-2.5 inset-e-2.5 min-h-8 whitespace-nowrap bg-background px-2.5 text-xs font-semibold text-foreground shadow-sm"
              : "product-card-round-action",
          ]}
        >
          {variant === "fashion-value" ? productPageHint : (
            <svg class="h-6 w-6"><use href={model.needsOptions ? "#pci-plus" : "#pci-arrow"} /></svg>
          )}
        </span>
      )
    }
    {
      roundAction && model.quickBuyHref && (
        <a
          href={cartAction ? model.href : model.quickBuyHref}
          data-card-quick-add={cartAction ? "" : undefined}
          data-astro-prefetch="false"
          rel="nofollow"
          class="product-card-round-action"
        >
          <svg aria-hidden="true" class="h-6 w-6"><use href={variant === "fashion-value" ? "#pci-cart-round" : "#pci-plus"} /></svg>
          <span class="sr-only">{actionText}: {model.name}</span>
        </a>
      )
    }
  </CardMedia>

  <div class="product-card-body product-card-stack">
    {
      parts.map((part) => {
        if (part === "title") {
          return (
            <>
              <TitleTag class:list={["product-card-name pc-title", titleClamp]}>
                <a href={model.href} class="product-card-link">
                  {model.name}
                  {(variant === "fashion-value" || variant === "showcase") && model.needsOptions && <span class="sr-only"> — Choose options</span>}
                </a>
              </TitleTag>
              {model.condition && <p class="pc-condition" data-card-fact="condition">{model.condition}</p>}
            </>
          );
        }
        if (part === "price") {
          // Exact full-price Showcase cards carry their price in Add; keep
          // the row when there is an original price to disclose or no Add.
          if (variant === "showcase" && showcaseAdd && !discounted) return null;
          const regular = model.price.regular && (
            anatomy.strike === "reg" ? (
              <span class="product-card-meta pc-price-regular pc-price-reg">
                <span aria-hidden="true">reg </span><span class="sr-only">Regular price </span>{model.price.regular}
              </span>
            ) : (
              <span class="product-card-meta pc-price-regular">
                {anatomy.strike === "list" ? <span aria-hidden="true">List: </span> : null}
                <span class="sr-only">Regular price </span><s>{model.price.regular}</s>
              </span>
            )
          );
          const mark = priceMark && (
            <span data-card-discount class:list={["product-card-meta pc-discount", `pc-discount-${anatomy.badge === "both" ? "text" : anatomy.discountStyle}`]}>{priceMark}</span>
          );
          return (
            <p class:list={["product-card-price-row pc-price", pushPrice && "product-card-push mt-auto"]}>
              {/* Amazon's deal box sits on its own line above the price. */}
              {anatomy.discountStyle === "deal" && mark && <span class="pc-deal-row">{mark}</span>}
              {anatomy.strike === "before" && regular}
              {superscriptPrice ? (
                <span class="product-card-price pc-price-super">
                  <span class="sr-only">{discounted ? "Sale price " : "Price "}{model.price.prefix}{model.price.current}</span>
                  <span aria-hidden="true">
                    {model.price.prefix && <span class="pc-price-from">{model.price.prefix}</span>}
                    {model.price.parts.symbol && <span class="pc-price-symbol">{model.price.parts.symbol}</span>}
                    <span class="pc-price-whole">{model.price.parts.whole}</span>
                    {model.price.parts.fraction && <span class="pc-price-fraction">{model.price.parts.fraction}</span>}
                  </span>
                </span>
              ) : (
                <span class:list={["product-card-price", priceTone]}>
                  <span class="sr-only">{discounted ? "Sale price " : "Price "}</span>
                  {model.price.prefix && variant === "fashion-value" ? <span class="pc-price-from">{model.price.prefix}</span> : model.price.prefix}{model.price.current}
                </span>
              )}
              {/* Target reads "Sale" beside the price, then "reg ৳1,200" under it. */}
              {anatomy.strike === "reg" && mark}
              {anatomy.strike !== "before" && regular}
              {anatomy.strike !== "reg" && anatomy.discountStyle !== "deal" && mark}
            </p>
          );
        }
        if (part === "brand") {
          return <p class="product-card-meta pc-brand line-clamp-1" data-card-fact="brand">{facts.brand}</p>;
        }
        if (part === "key-specs") {
          return (
            <ul class="product-card-meta pc-specs" data-card-fact="key-specs">
              {facts.keySpecs.map((spec) => <li>{spec}</li>)}
            </ul>
          );
        }
        if (part === "rating" && facts.rating) {
          return anatomy.rating === "stars" ? (
            <p class="product-card-meta pc-rating pc-rating-stars" data-card-fact="rating">
              <span aria-hidden="true" class="pc-rating-average">{facts.rating.average}</span>
              <span aria-hidden="true" class="pc-stars" style={`--pc-stars:${facts.rating.stars}%`}></span>
              <span aria-hidden="true" class="pc-rating-count">({facts.rating.countLabel})</span>
              <span class="sr-only">Rated {facts.rating.average} out of 5 from {facts.rating.count} reviews</span>
            </p>
          ) : (
            <p class="product-card-meta pc-rating" data-card-fact="rating">
              <span aria-hidden="true">★ {facts.rating.average} <span class="text-muted-foreground">({facts.rating.countLabel})</span></span>
              <span class="sr-only">Rated {facts.rating.average} out of 5 from {facts.rating.count} reviews</span>
            </p>
          );
        }
        if (part === "sold") {
          return <p class="product-card-meta pc-sold" data-card-fact="sold">{soldText}</p>;
        }
        if (part === "savings") {
          return (
            <p class="product-card-meta pc-savings" data-card-fact="savings">
              <span class="pc-savings-chip">
                {variant === "fashion-value" && (
                  <svg aria-hidden="true" class="pc-savings-icon"><use href="#pci-tag" /></svg>
                )}
                {facts.savings}
              </span>
            </p>
          );
        }
        if (part === "pack-size") {
          return <p class="product-card-meta pc-pack line-clamp-1" data-card-fact="pack-size">{facts.packSize}</p>;
        }
        if (part === "delivery" && facts.delivery) {
          return (
            <p class="product-card-meta pc-delivery" data-card-fact="delivery">
              <span class="pc-delivery-text">
                {facts.delivery.free ? <><strong>Free</strong> delivery</> : variant === "quick-add" ? <><strong>{facts.delivery.fee}</strong> delivery</> : <>Delivery from <strong>{facts.delivery.fee}</strong></>}
              </span>
            </p>
          );
        }
        if (part === "emi") {
          return <p class="product-card-meta pc-emi" data-card-fact="emi">{facts.emi}</p>;
        }
        if (part === "swatches") {
          return (
            <p class="pc-swatches" data-card-fact="swatches">
              {facts.swatches.map((swatch) => (
                <span class="pc-swatch" style={`--swatch:${swatch.colour}`} title={swatch.label}></span>
              ))}
              <span class="sr-only">Colours: {facts.swatches.map((swatch) => swatch.label).join(", ")}</span>
            </p>
          );
        }
        if (part === "options" && facts.options) {
          return (
            <p class="product-card-meta pc-options" data-card-fact="options">
              {facts.options.label} <span class="pc-options-count">{facts.options.count} {facts.options.noun}</span>
            </p>
          );
        }
        return null;
      })
    }

    {
      bodyAction && model.quickBuyHref && (variant !== "showcase" || showcaseAdd) && (
        <a
          href={cartAction ? model.href : model.quickBuyHref}
          data-card-quick-add={cartAction ? "" : undefined}
          data-astro-prefetch="false"
          rel="nofollow"
          class:list={[
            "product-card-action pc-act",
            pushAction && "product-card-push mt-auto",
            anatomy.action === "outline" ? "pc-action-outline" : "pc-action-solid",
            anatomy.action === "compact" && "pc-action-compact",
          ]}
        >
          {variant === "spec" && (
            <svg aria-hidden="true" class="h-4 w-4"><use href="#pci-cart" /></svg>
          )}
          {/* The name starts with the visible words (WCAG 2.5.3). */}
          {quickRetail && <span aria-hidden="true">+</span>}{actionText}{showcaseAdd && <> – {model.price.current}</>}<span class="sr-only">: {model.name}</span>
        </a>
      )
    }
    {showcaseDetail && (
      <a href={model.href} class="product-card-action pc-action-solid product-card-push relative z-10 inline-flex w-full items-center justify-center px-3 text-sm font-semibold">
        View product<span class="sr-only">: {model.name}</span>
      </a>
    )}
    {
      quickAdd && showBuyNow && model.quickBuyHref && (
        <a href={model.quickBuyHref} rel="nofollow" data-astro-prefetch="false" class="pc-buy-now relative z-10 self-end text-sm font-medium text-primary underline-offset-2 hover:underline">
          Buy now<span class="sr-only">: {model.name}</span>
        </a>
      )
    }
    {
      /* The hint sits under the stretched product link, not in a second tab stop. */
      bodyAction && productPageOnly && !showcaseDetail && (
        <span
          aria-hidden="true"
          data-card-action-hint
          class:list={[
            "product-card-action pc-act",
            pushAction && "product-card-push mt-auto",
            variant === "spec" ? "pc-action-solid" : "pc-action-hint",
            anatomy.action === "compact" && "pc-action-compact",
          ]}
        >
          {productPageHint}
        </span>
      )
    }
    {
      /* Star Tech's "Add to Compare". Without JavaScript it opens the
         comparison with this product; the compare script turns it into a
         toggle for the floating tray. */
      anatomy.compare && (
        <a
          href={`/compare?ids=${encodeURIComponent(productId)}`}
          rel="nofollow"
          data-astro-prefetch="false"
          data-compare-toggle={productId}
          class="pc-compare"
        >
          <svg aria-hidden="true" class="h-4 w-4"><use href="#pci-compare" /></svg>
          <span data-compare-label>Add to Compare</span><span class="sr-only">: {model.name}</span>
        </a>
      )
    }
  </div>
  <script>
    import { initQuickAddCards } from "../scripts/quick-add-card";
    initQuickAddCards();
  </script>
</div>
{anatomy.compare && <CompareTray />}
