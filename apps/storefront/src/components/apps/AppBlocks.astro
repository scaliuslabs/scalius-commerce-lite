---
// The app blocks drawn at one checkout or customer-account target (Shopify's
// extension target names), in app order. The HTML was sanitized by the API
// and is the same for every buyer: plain content and links, and forms only
// outside checkout (they post to the app's own /apps/<id>/ proxy and work
// without JavaScript). A target without blocks renders nothing.
import type { PluginBlockTarget } from "@scalius/shared/plugins/storefront";
import AppSurface from "./AppSurface.astro";
import { blocksAt } from "@/lib/api/app-blocks";
import type { AppBlock } from "@/lib/app-surfaces";

interface Props {
  blocks: readonly AppBlock[];
  target: PluginBlockTarget;
  class?: string;
}

const { blocks, target, class: className } = Astro.props;
const shown = blocksAt(blocks, target);
---

{shown.length > 0 && (
  <div class:list={["flex flex-col gap-3", className]} data-app-blocks={target}>
    {shown.map((block) => <AppSurface html={block.html} app={block.id} />)}
  </div>
)}
