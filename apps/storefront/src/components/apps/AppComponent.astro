---
// One app component's markup (docs/STOREFRONT-COMPONENTS.md): a section, or
// the header, footer or card slot an app fills. The HTML was drawn by the
// app's storefront module and checked by the host (lib/extensions/host.ts).
// The wrapper names the app and its file base for the client runtime and
// adds no box (`display: contents`), so grids and sticky headers lay out
// as the app wrote them. Core embeds in it (`<scalius-checkout>`) render the
// store's own surface in place (lib/extensions/embeds.ts).
import OrderForm from "@/components/checkout/OrderForm.astro";
import { splitCoreEmbeds } from "@/lib/extensions/embeds";

interface Props {
  html: string;
  pluginId: string;
  /** `/_x/<plugin id>/<release>/`. */
  base: string;
  /** The placement identity, when the caller has one (for repeated embeds). */
  instanceId?: string;
  /** The theme editor's mark (preview only). */
  editorMark?: string | undefined;
  /** The theme editor's preview: embeds never post. */
  preview?: boolean;
  /** The products this component was given, id to handle: the only ones an embed may order. */
  products?: ReadonlyMap<string, string>;
}

const { html, pluginId, base, instanceId, editorMark, preview = false, products } = Astro.props;
const parts = splitCoreEmbeds(html);
const embedPrefix = parts.some((part) => part.kind === "checkout") ? encodeURIComponent(instanceId ?? crypto.randomUUID()) : "";
---

<div class="contents" data-sx-app={pluginId} data-sx-base={base} data-theme-section-id={editorMark}>
  {parts.map((part, index) => part.kind === "html"
    ? <Fragment set:html={part.html} />
    : products?.has(part.product) && <OrderForm slug={products.get(part.product)!} idPrefix={`order-${embedPrefix}-${index}`} maxQuantity={part.maxQuantity} submitLabel={part.submitLabel ?? undefined} preview={preview} />)}
</div>

<script>
  import { installAppComponents } from "@/scripts/app-components";

  installAppComponents();
</script>
