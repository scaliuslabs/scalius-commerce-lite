---
// One app component's markup (packages/plugin-sdk/docs/storefront.md): a section, a
// product block, or a skin of a core-owned unit. The HTML was drawn by the
// app's storefront module, checked by the host (lib/extensions/host.ts) and
// cut at its core embeds (`appMarkup`). The wrapper names the app and its
// file base for the client runtime and adds no box (`display: contents`), so
// grids and sticky headers lay out as the app wrote them. Each embed renders
// the store's own component in place, as the page's `embeds` say
// (lib/extensions/embeds.ts); one the page gives no renderer renders nothing.
// The app's line inputs (manifest `checkout.lineInputs`) go on the wrapper
// for its islands' `addLine` (scripts/app-components.ts): app markup cannot
// carry a `data-sx-*` attribute, so only the host writes it.
import type { AppMarkup } from "@/lib/extensions";
import type { EmbedRenderers } from "@/lib/extensions/embeds";
import { getLayoutData } from "@/lib/api/storefront";
import { getRuntime } from "@/lib/api/runtime";

interface Props {
  markup: AppMarkup;
  embeds?: EmbedRenderers;
  /** The theme editor's mark (preview only). */
  editorMark?: string | undefined;
}

const { markup, embeds = {}, editorMark } = Astro.props;
const lineInputs = (getRuntime() ? await getLayoutData() : null)?.lineInputs
  ?.find((app) => app.appId === markup.pluginId)?.inputs ?? [];
type AnyComponent = (props: Record<string, unknown>) => unknown;
const parts = markup.parts.map((part) => {
  if (part.kind === "html") return part;
  const rendered = embeds[part.embed]?.({ data: part.data, index: part.index }) ?? null;
  return { kind: "embed" as const, embed: part.embed, Embed: rendered ? rendered.component as unknown as AnyComponent : null, props: rendered?.props ?? {} };
});
---

<div class="contents" data-sx-app={markup.pluginId} data-sx-base={markup.base} data-sx-line-inputs={lineInputs.length > 0 ? JSON.stringify(lineInputs) : undefined} data-theme-section-id={editorMark}>
  {parts.map((part) => part.kind === "html"
    ? <Fragment set:html={part.html} />
    : part.Embed && <div class="contents" data-sx-embed={part.embed}><part.Embed {...part.props} /></div>)}
</div>

<script>
  import { installAppComponents } from "@/scripts/app-components";

  installAppComponents();
</script>
