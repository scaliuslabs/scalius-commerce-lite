---
// A component slot (docs/STOREFRONT-COMPONENTS.md "Slots"): the place a core
// unit or a skin (`<Slot name="…" />`) gives active apps' components. Each
// component draws at the edge in the page's existing batch to its app; one
// that draws nothing, fails or is late renders nothing (and a failed one
// keeps the page out of the cache). A slot nobody fills renders nothing and
// reads nothing: the components come from the layout read the page already
// has, and a product or card projection is built only when a component draws.
//
// - `product.buy_box.before` / `.after`: in the buy box, after the title and
//   after the buttons; `product.below`: after the page's modules, each in a
//   module container. The merchant arranges these (the product page's app blocks).
// - `header.actions`: every active app's component, inline beside the
//   account and cart; `footer.columns`: a row of columns after the menus.
// - `product_card.badges` / `.meta`: on every card, over the photo and under
//   the price, with that card's projection, whoever draws the card.
import type { StorefrontComponentSlot, StorefrontProductCardData, StorefrontProductPage } from "@scalius/shared/plugins/storefront-protocol";
import AppComponent from "./AppComponent.astro";
import { appMarkup, appSlotComponents, requestExtensions, type AppMarkup } from "@/lib/extensions";

type SlotData = StorefrontProductPage | StorefrontProductCardData;

interface Props {
  name: StorefrontComponentSlot;
  /** The unit's projection (product slots: the product page; card slots: the card), built only when a component draws. */
  data?: () => SlotData | Promise<SlotData>;
}

const { name, data } = Astro.props;
const components = await appSlotComponents(Astro.locals, Astro.url, name);
const product = name.startsWith("product.");
// Product and card slots draw from their unit's data; without it they draw nothing.
const needsData = product || name.startsWith("product_card.");
let drawn: Array<{ key: string; markup: AppMarkup }> = [];
if (components.length > 0) {
  const { host } = await requestExtensions(Astro.locals, Astro.url);
  const unit = needsData ? await data?.() : undefined;
  if (!needsData || unit) {
    const rendered = await Promise.all(components.map(async (component) => {
      const base = { kind: "component", type: component.type, target: name, settings: component.settings };
      const job = product
        ? { ...base, instanceId: component.instanceId ?? component.type, data: unit }
        : unit ? { ...base, data: unit } : base;
      // Product and card slots keep JSON-LD out: the page's structured data is core's.
      const html = await host.render(component.extension, job as never, { jsonLd: !unit });
      const markup = appMarkup(component.extension, "component", html);
      return markup ? [{ key: `${component.extension.pluginId}/${component.instanceId ?? component.type}`, markup }] : [];
    }));
    drawn = rendered.flat();
  }
}
---

{drawn.length > 0 && name === "product.below" && drawn.map((component) => (
  <section class="product-module mx-auto max-w-7xl border-t border-border px-3 py-6 sm:px-6 lg:px-8 lg:py-10" data-product-module="app" data-app-slot={name}>
    <AppComponent markup={component.markup} />
  </section>
))}
{drawn.length > 0 && name.startsWith("product.buy_box") && (
  <div class="mt-3 flex flex-col gap-3" data-app-slot={name}>
    {drawn.map((component) => <AppComponent markup={component.markup} />)}
  </div>
)}
{drawn.length > 0 && name === "footer.columns" && (
  <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-app-slot={name}>
    {drawn.map((component) => <div><AppComponent markup={component.markup} /></div>)}
  </div>
)}
{drawn.length > 0 && (name === "header.actions" || name === "product_card.badges") && (
  <div class="contents" data-app-slot={name}>
    {drawn.map((component) => <AppComponent markup={component.markup} />)}
  </div>
)}
{drawn.length > 0 && name === "product_card.meta" && (
  <div class="product-card-app-meta" data-app-slot={name}>
    {drawn.map((component) => <AppComponent markup={component.markup} />)}
  </div>
)}
