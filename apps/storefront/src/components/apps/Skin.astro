---
// A core-owned unit an app skin may draw (docs/STOREFRONT-COMPONENTS.md
// "Skins"): the skin the theme names for `target` (or `skin`, a core
// section's own), drawn from the unit's projection, else the core unit in
// the default slot. Core draws whenever there is no skin, its app is not
// active, or the skin draws nothing, fails, is late or misses a required
// embed. The projection is built only when a skin will draw (`data` is
// called lazily), and the core unit renders only when it is needed. Slot
// `drawn` renders after the skin only when it drew (what core adds to it).
// A skin's `<Slot name="…" />` (its unit's slots only) renders the slot
// as the core unit would.
import type { StorefrontSkinRef } from "@scalius/shared/storefront-theme";
import type { StorefrontSkinTarget } from "@scalius/shared/plugins/storefront-protocol";
import AppComponent from "./AppComponent.astro";
import AppSlot from "./AppSlot.astro";
import { appSkin, renderAppSkin } from "@/lib/extensions";
import type { EmbedRender, EmbedRenderers } from "@/lib/extensions/embeds";

interface Props {
  target: StorefrontSkinTarget;
  /** A core section's own skin (`section.skin`); omitted: the theme's `apps.skins.<target>`. */
  skin?: StorefrontSkinRef | null;
  /** The unit's projection (the skin job's `data`), built only when a skin draws. */
  data: () => unknown;
  /** A core section's placement id (section skins). */
  instanceId?: string;
  embeds?: EmbedRenderers;
  editorMark?: string | undefined;
}

const { target, skin: ref, data, instanceId, embeds: pageEmbeds, editorMark } = Astro.props;
// The embed rule already holds a slot to the unit's own slot names; a card's
// slots draw from the same card projection the skin got.
const embeds: EmbedRenderers = { slot: ({ data: slot }) => ({ component: AppSlot as EmbedRender["component"], props: { name: slot.name, data } }), ...pageEmbeds };
// A section without a skin of its own never looks up the theme's skins.
const skin = ref === null ? null : await appSkin(Astro.locals, Astro.url, target, ref);
const markup = skin
  ? await renderAppSkin(Astro.locals, Astro.url, skin, { data: await data(), ...(instanceId !== undefined ? { instanceId } : {}) } as never)
  : null;
---

{markup ? <Fragment><AppComponent markup={markup} embeds={embeds} editorMark={editorMark} /><slot name="drawn" /></Fragment> : <slot />}
