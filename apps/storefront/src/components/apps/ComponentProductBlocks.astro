---
// A product page's component app blocks at one target (`block` jobs,
// docs/STOREFRONT-COMPONENTS.md): each drawn at the edge by its app's
// storefront module from the product page's projection, in the merchant's
// order. `product.buy-box` blocks sit in the buy box after the buttons;
// `product.below` blocks follow the page's modules, each in a module
// container. A block that draws nothing, fails or is late renders nothing
// (and a failed one keeps the page out of the cache). The projection is
// built only when a block draws.
import type { StorefrontBlockTarget, StorefrontProductPage } from "@scalius/shared/plugins/storefront-protocol";
import AppComponent from "./AppComponent.astro";
import { appMarkup, requestExtensions, type AppMarkup, type AppProductBlock } from "@/lib/extensions";

interface Props {
  blocks: readonly AppProductBlock[];
  target: StorefrontBlockTarget;
  data: () => StorefrontProductPage;
}

const { blocks, target, data } = Astro.props;
const shown = blocks.filter((block) => block.target === target);
let drawn: Array<{ id: string; markup: AppMarkup }> = [];
if (shown.length > 0) {
  const { host } = await requestExtensions(Astro.locals, Astro.url);
  const projection = data();
  const rendered = await Promise.all(shown.map(async (block) => {
    const html = await host.render(block.extension, {
      kind: "block", target, type: block.type, instanceId: block.id, settings: block.settings, data: projection,
    }, { jsonLd: false });
    const markup = appMarkup(block.extension, "block", html);
    return markup ? [{ id: block.id, markup }] : [];
  }));
  drawn = rendered.flat();
}
---

{target === "product.buy-box" && drawn.length > 0 && (
  <div class="mt-3 flex flex-col gap-3" data-app-blocks="buy-box">
    {drawn.map((block) => <AppComponent markup={block.markup} />)}
  </div>
)}
{target === "product.below" && drawn.map((block) => (
  <section class="product-module mx-auto max-w-7xl border-t border-border px-3 py-6 sm:px-6 lg:px-8 lg:py-10" data-product-module="app" data-app-blocks="below">
    <AppComponent markup={block.markup} />
  </section>
))}
