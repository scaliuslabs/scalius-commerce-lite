---
// A product page's app blocks in one placement, in the merchant's order:
// `buy-box` blocks sit in the buy box after the buy buttons (before the
// delivery and returns facts); `below` blocks follow the template's
// below-fold modules, each in a module container without a heading. A
// placement without blocks renders nothing.
import AppSurface from "./AppSurface.astro";
import type { ProductAppBlock } from "@/lib/app-surfaces";

interface Props {
  blocks: readonly ProductAppBlock[];
  placement: ProductAppBlock["placement"];
}

const { blocks, placement } = Astro.props;
const shown = blocks.filter((block) => block.placement === placement);
---

{placement === "buy-box" && shown.length > 0 && (
  <div class="mt-3 flex flex-col gap-3" data-app-blocks="buy-box">
    {shown.map((block) => <AppSurface html={block.html} app={block.app} instanceId={block.id} />)}
  </div>
)}
{placement === "below" && shown.map((block) => (
  <section
    class="product-module mx-auto max-w-7xl border-t border-border px-3 py-6 sm:px-6 lg:px-8 lg:py-10"
    data-product-module="app"
    data-app-blocks="below"
  >
    <AppSurface html={block.html} app={block.app} instanceId={block.id} />
  </section>
))}
