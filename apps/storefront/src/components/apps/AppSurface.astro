---
// What an installed app drew (a homepage section, a product block or a proxy
// page body). The HTML is sanitized before it gets here: by the API for
// sections and blocks, by the proxy page for proxy pages
// (`sanitizePluginHtml`). Its forms and toggles are enhanced by the
// platform's own script (scripts/app-forms), loaded once per page that shows
// a surface; without JavaScript they post as plain forms.
interface Props {
  /** Sanitized HTML. */
  html: string;
  /** `<plugin id>/<type>`, or the plugin id for a proxy page. */
  app: string;
  /** The theme's id of this placement (section or block id). */
  instanceId?: string;
}

const { html, app, instanceId } = Astro.props;
---

<div class="app-surface [overflow-wrap:anywhere]" data-app-surface={app} data-app-instance={instanceId} set:html={html} />

<script>
  import { installAppForms } from "@/scripts/app-forms";

  installAppForms();
</script>
