---
// Server-rendered checkout phone field: typeable before any JavaScript runs.
// lib/checkout/phone-field.ts owns validation and the canonical E.164 value;
// the international country picker loads only when a buyer opens it.
import { getCountries, getCountryCallingCode } from "@scalius/shared/customer-utils";
import {
  normalizePhonePolicy,
  phoneCountryAllowed,
} from "@/lib/checkout/phone-field";

interface Props {
  label: string;
  /** Why the number is needed and its format, shown under the field. */
  help?: string;
  /** Help for a pickup order and for an order with nothing to deliver (the cart page switches between them). */
  pickupHelp?: string;
  serviceHelp?: string;
  placeholder?: string;
  allowedCountries?: string[];
  allowedCountriesMode?: "include" | "exclude";
  requiredMessage: string;
  /** A number from another country that doesn't validate. */
  invalidMessage: string;
  /** A Bangladesh number that isn't a mobile number (01[3-9] + 8 digits). */
  mobileMessage: string;
  countryNotAcceptedMessage: string;
  countrySelectLabel: string;
  languageCode: string;
}

const {
  label,
  help,
  pickupHelp,
  serviceHelp,
  placeholder,
  allowedCountries = [],
  allowedCountriesMode = "include",
  requiredMessage,
  invalidMessage,
  mobileMessage,
  countryNotAcceptedMessage,
  countrySelectLabel,
  languageCode,
} = Astro.props;

const policy = normalizePhonePolicy({
  countries: allowedCountries,
  mode: allowedCountriesMode,
});
type CountryCode = Parameters<typeof getCountryCallingCode>[0];
const knownCountries = new Set<string>(getCountries());
// Bangladesh first; otherwise the merchant's first accepted country.
const defaultCountry = phoneCountryAllowed("BD", policy)
  ? "BD"
  : ((policy.mode === "include" ? policy.countries : getCountries()).find(
      (country) => knownCountries.has(country) && phoneCountryAllowed(country, policy),
    ) ?? "BD");
// Bangladesh numbers are typed the local way (01712-345678), so the prefix
// names the country instead of "+880", which would read as +88001….
const callingCode = defaultCountry === "BD" ? "BD" : `+${getCountryCallingCode(defaultCountry as CountryCode)}`;
const singleCountry = policy.mode === "include" && policy.countries.length === 1;
---

<div
  id="customerPhone-field"
  data-countries={policy.countries.join(",")}
  data-country-mode={policy.mode}
  data-default-country={defaultCountry}
  data-required-message={requiredMessage}
  data-invalid-message={invalidMessage}
  data-mobile-message={mobileMessage}
  data-country-message={countryNotAcceptedMessage}
  data-country-label={countrySelectLabel}
  data-language={languageCode}
>
  <label
    for="customerPhone-input"
    class="mb-1 block text-sm font-medium text-foreground"
  >
    {label}
    <span aria-hidden="true" class="ml-0.5 text-destructive">*</span>
  </label>
  <input type="hidden" name="customerPhone" value="" data-e164-value="" />
  <div
    data-phone-box
    class="flex h-11 w-full items-center overflow-hidden rounded-lg border border-input bg-background text-base text-foreground focus-within:border-ring focus-within:ring-2 focus-within:ring-ring/30"
  >
    <span class="relative flex h-full shrink-0 items-center border-r border-input">
      {
        singleCountry ? (
          <span class="px-3 text-sm font-medium text-muted-foreground">{callingCode}</span>
        ) : (
          <button
            type="button"
            data-phone-country
            aria-label={countrySelectLabel}
            class="flex h-full items-center gap-1 px-3 text-sm font-medium text-foreground"
          >
            <span data-phone-code>{callingCode}</span>
            <svg aria-hidden="true" class="h-3 w-3 opacity-60" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 4.5 3 3 3-3" /></svg>
          </button>
        )
      }
    </span>
    <input
      id="customerPhone-input"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      aria-required="true"
      aria-describedby={help ? "customerPhone-help customerPhone-error" : "customerPhone-error"}
      placeholder={placeholder || "Phone number"}
      class="h-full min-w-0 flex-1 border-none bg-transparent px-3 text-base text-foreground outline-none"
    />
  </div>
  {
    help && (
      <p id="customerPhone-help" class="mt-1 text-sm text-muted-foreground">
        {pickupHelp || serviceHelp ? (
          <>
            {/* The page root's delivery need and mode pick the sentence that is true. */}
            <span class="group-data-[delivery-need=none]:hidden group-data-[delivery-mode=pickup]:hidden">{help}</span>
            <span class="hidden group-data-[delivery-mode=pickup]:inline group-data-[delivery-need=none]:hidden">{pickupHelp || help}</span>
            <span class="hidden group-data-[delivery-need=none]:inline">{serviceHelp || help}</span>
          </>
        ) : (
          help
        )}
      </p>
    )
  }
  <p
    id="customerPhone-error"
    role="alert"
    class="mt-1 hidden text-sm font-medium text-destructive"
  >
  </p>
</div>
