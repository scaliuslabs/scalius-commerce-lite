---
// Server-rendered checkout phone field: typeable before any JavaScript runs.
// lib/checkout/phone-field.ts owns validation and the canonical E.164 value;
// the international country picker loads only when a buyer opens it.
import { getCountries, getCountryCallingCode } from "@scalius/shared/customer-utils";
import { phoneCountryMeta, type PhoneCountryMeta } from "@scalius/shared/phone-example";
import {
  normalizePhonePolicy,
  phoneCountryAllowed,
} from "@/lib/checkout/phone-field";
import { phoneHints } from "@/lib/checkout/phone-hint";

interface Props {
  label: string;
  /** Why the number is needed and its format, shown under the field. */
  help?: string;
  /** Help for a pickup order and for an order with nothing to deliver (the cart page switches between them). */
  pickupHelp?: string;
  serviceHelp?: string;
  placeholder?: string;
  allowedCountries?: string[];
  allowedCountriesMode?: "include" | "exclude";
  requiredMessage: string;
  /** A number from another country that doesn't validate. */
  invalidMessage: string;
  /** A Bangladesh number that isn't a mobile number (01[3-9] + 8 digits). */
  mobileMessage: string;
  countryNotAcceptedMessage: string;
  countrySelectLabel: string;
  languageCode: string;
  /**
   * The countries the store sells to, and the one the address form starts on
   * (the field starts in that country when the store accepts its numbers; the
   * script then follows the buyer's choice, lib/checkout/phone-field.ts).
   */
  shippingCountries?: string[];
  shippingCountry?: string;
  /** What the hint says for a number from another country (checkout language). */
  intl?: { help: string; pickupHelp: string; serviceHelp: string; exampleText: string };
  /**
   * Only when the store lets digital and service orders go without a phone
   * (Customer accounts): the label and hint shown while the page root's
   * `data-phone-need` is "optional" (lib/checkout/contact-need.ts).
   */
  optional?: { label: string; help: string };
}

const {
  label,
  help,
  pickupHelp,
  serviceHelp,
  placeholder,
  allowedCountries = [],
  allowedCountriesMode = "include",
  requiredMessage,
  invalidMessage,
  mobileMessage,
  countryNotAcceptedMessage,
  countrySelectLabel,
  languageCode,
  shippingCountries = [],
  shippingCountry,
  intl,
  optional,
} = Astro.props;

const policy = normalizePhonePolicy({
  countries: allowedCountries,
  mode: allowedCountriesMode,
});
type CountryCode = Parameters<typeof getCountryCallingCode>[0];
const knownCountries = new Set<string>(getCountries());
// The country the address form starts on when its numbers are accepted; else
// Bangladesh; else the merchant's first accepted country.
const sold = [...new Set(shippingCountries)]
  .filter((country) => country !== "BD" && knownCountries.has(country) && phoneCountryAllowed(country, policy))
  .sort();
const followed = shippingCountry === "BD" || (shippingCountry !== undefined && sold.includes(shippingCountry));
const defaultCountry = followed && phoneCountryAllowed(shippingCountry!, policy)
  ? shippingCountry!
  : phoneCountryAllowed("BD", policy)
    ? "BD"
    : ((policy.mode === "include" ? policy.countries : getCountries()).find(
        (country) => knownCountries.has(country) && phoneCountryAllowed(country, policy),
      ) ?? "BD");
// Bangladesh numbers are typed the local way (01712-345678), so the prefix
// names the country instead of "+880", which would read as +88001….
const callingCode = defaultCountry === "BD" ? "BD" : `+${getCountryCallingCode(defaultCountry as CountryCode)}`;
// Each country the store sells abroad: its calling code and example number, for
// the script to follow the shipping country without loading libphonenumber.
const soldMeta: Record<string, PhoneCountryMeta> = {};
for (const country of sold) {
  const meta = phoneCountryMeta(country);
  if (meta) soldMeta[country] = meta;
}
// A default country other than Bangladesh asks for the country code and shows
// its example; Bangladesh keeps the merchant's copy as it is.
const words = defaultCountry !== "BD" && intl
  ? phoneHints(
      defaultCountry,
      {
        help: help ?? "",
        pickupHelp: pickupHelp ?? "",
        serviceHelp: serviceHelp ?? "",
        intlHelp: intl.help,
        intlPickupHelp: intl.pickupHelp,
        intlServiceHelp: intl.serviceHelp,
        exampleText: intl.exampleText,
        placeholder: placeholder ?? "",
        label,
      },
      soldMeta[defaultCountry] ?? phoneCountryMeta(defaultCountry),
    )
  : null;
const shownHelp = help && words ? words.hints.delivery : help;
const shownPickupHelp = pickupHelp && words ? words.hints.pickup : pickupHelp;
const shownServiceHelp = serviceHelp && words ? words.hints.none : serviceHelp;
const shownPlaceholder = words ? words.placeholder : placeholder;
const singleCountry = policy.mode === "include" && policy.countries.length === 1;
---

<div
  id="customerPhone-field"
  data-countries={policy.countries.join(",")}
  data-country-mode={policy.mode}
  data-default-country={defaultCountry}
  data-phone-countries={Object.keys(soldMeta).length > 0 ? JSON.stringify(soldMeta) : undefined}
  data-required-message={requiredMessage}
  data-invalid-message={invalidMessage}
  data-mobile-message={mobileMessage}
  data-country-message={countryNotAcceptedMessage}
  data-country-label={countrySelectLabel}
  data-language={languageCode}
>
  <label
    for="customerPhone-input"
    class="mb-1 block text-sm font-medium text-foreground"
  >
    {
      optional ? (
        <>
          <span class="group-data-[phone-need=optional]:hidden">{label}<span aria-hidden="true" class="ms-0.5 text-destructive">*</span></span>
          <span class="hidden group-data-[phone-need=optional]:inline">{optional.label}</span>
        </>
      ) : (
        <>
          {label}
          <span aria-hidden="true" class="ms-0.5 text-destructive">*</span>
        </>
      )
    }
  </label>
  <input type="hidden" name="customerPhone" value="" data-e164-value="" />
  <div
    data-phone-box
    class="flex h-11 w-full items-center overflow-hidden rounded-lg border border-input bg-background text-base text-foreground focus-within:border-ring focus-within:ring-2 focus-within:ring-ring/30"
  >
    <span class="relative flex h-full shrink-0 items-center border-e border-input">
      {
        singleCountry ? (
          <span class="px-3 text-sm font-medium text-muted-foreground">{callingCode}</span>
        ) : (
          <button
            type="button"
            data-phone-country
            class="flex h-full items-center gap-1 px-3 text-sm font-medium text-foreground"
          >
            <span data-phone-code>{callingCode}</span>
            {/* The visible code is part of the name (WCAG 2.5.3): "+880, Phone number country". */}
            <span class="sr-only">{countrySelectLabel}</span>
            <svg aria-hidden="true" class="h-3 w-3 opacity-60" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 4.5 3 3 3-3" /></svg>
          </button>
        )
      }
    </span>
    <input
      id="customerPhone-input"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      aria-required="true"
      aria-describedby={shownHelp ? "customerPhone-help customerPhone-error" : "customerPhone-error"}
      placeholder={shownPlaceholder || "Phone number"}
      class="h-full min-w-0 flex-1 border-none bg-transparent px-3 text-base text-foreground outline-none"
    />
  </div>
  {
    shownHelp && (
      <p id="customerPhone-help" class={optional ? "mt-1 text-sm text-muted-foreground group-data-[phone-need=optional]:hidden" : "mt-1 text-sm text-muted-foreground"}>
        {shownPickupHelp || shownServiceHelp ? (
          <>
            {/* The page root's delivery need and mode pick the sentence that is true. */}
            <span class="group-data-[delivery-need=none]:hidden group-data-[delivery-mode=pickup]:hidden">{shownHelp}</span>
            <span class="hidden group-data-[delivery-mode=pickup]:inline group-data-[delivery-need=none]:hidden">{shownPickupHelp || shownHelp}</span>
            <span class="hidden group-data-[delivery-need=none]:inline">{shownServiceHelp || shownHelp}</span>
          </>
        ) : (
          shownHelp
        )}
      </p>
    )
  }
  {
    optional && (
      <p id="customerPhone-optional-help" class="mt-1 hidden text-sm text-muted-foreground group-data-[phone-need=optional]:block">
        {optional.help}
      </p>
    )
  }
  <p
    id="customerPhone-error"
    role="alert"
    class="mt-1 hidden text-sm font-medium text-destructive"
  >
  </p>
</div>
