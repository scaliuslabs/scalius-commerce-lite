---
// src/components/RichContent.astro
import { getLayoutData } from "@/lib/api";
import { expandShortcodes, type RichContentPiece } from "@/lib/shortcodes";
import {
  demoteRichContentH1,
  optimizeRichContentImages,
} from "@/lib/rich-content-media";
import { applyStorefrontPrefetchPolicyToHtml } from "@/lib/prefetch-policy";
import { sanitizeHtml } from "@scalius/shared/html-sanitize";
import { DEFAULT_CURRENCY } from "@scalius/shared/currency";
import RichContentPieces from "./RichContentPieces.astro";
import RichTextStyles from "./RichTextStyles.astro";

interface Props {
  content: string;
  className?: string;
  processShortcodes?: boolean;
}

const {
  content,
  className = "",
  processShortcodes: shouldProcessShortcodes = true,
} = Astro.props;

// Sanitize merchant-authored content, rewrite it, then draw its trusted shortcodes.
let processedContent = sanitizeHtml(content);
if (processedContent) {
  processedContent = applyStorefrontPrefetchPolicyToHtml(
    optimizeRichContentImages(demoteRichContentH1(processedContent)),
    Astro.url,
  );
}
let pieces: RichContentPiece[] = [{ kind: "html", html: processedContent }];
// Only content with a shortcode reads the layout's currency (the request's one layout read).
if (shouldProcessShortcodes && /\[product\b/i.test(processedContent)) {
  try {
    const currency = (await getLayoutData())?.currency;
    pieces = await expandShortcodes(processedContent, {
      code: currency?.code ?? DEFAULT_CURRENCY.code,
      priceIncrementMinor: currency?.priceIncrementMinor ?? undefined,
    });
  } catch (error: unknown) {
    console.error("Error processing shortcodes:", error);
  }
}

const allClasses = `prose dark:prose-invert max-w-none ${className}`;

if (!content) {
  return null;
}
---

<RichTextStyles />
<div class={allClasses}><RichContentPieces pieces={pieces} /></div>
