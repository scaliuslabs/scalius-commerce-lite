---
// src/components/RichContent.astro
// Merchant rich text inside a page that has its own H1 (product, category,
// collection): written by renderRichHtml, the one rich-text renderer, with
// each product shortcode drawn as the listing's card.
import { renderRichHtml } from "@/lib/rich-html";
import RichContentPieces from "./RichContentPieces.astro";
import RichTextStyles from "./RichTextStyles.astro";

interface Props {
  content: string;
  className?: string;
  processShortcodes?: boolean;
}

const {
  content,
  className = "",
  processShortcodes: shouldProcessShortcodes = true,
} = Astro.props;

const pieces = await renderRichHtml(content, {
  page: Astro.url,
  demoteH1: true,
  shortcodes: shouldProcessShortcodes,
});

const allClasses = `prose dark:prose-invert max-w-none ${className}`;

if (!content) {
  return null;
}
---

<RichTextStyles />
<div class={allClasses}><RichContentPieces pieces={pieces} /></div>
