---
// src/components/RichContent.astro
import { processShortcodes } from "@/lib/shortcodes";
import { optimizeRichContentImages } from "@/lib/rich-content-media";
import { sanitizeHtml } from "@scalius/shared/html-sanitize";

interface Props {
  content: string;
  className?: string;
  processShortcodes?: boolean;
}

const {
  content,
  className = "",
  processShortcodes: shouldProcessShortcodes = true,
} = Astro.props;

// Sanitize merchant-authored content before expanding trusted shortcodes.
let processedContent = sanitizeHtml(content);
if (shouldProcessShortcodes && content) {
  try {
    processedContent = await processShortcodes(processedContent);
  } catch (error: unknown) {
    console.error("Error processing shortcodes:", error);
    processedContent = sanitizeHtml(content);
  }
}

if (processedContent) {
  processedContent = optimizeRichContentImages(processedContent);
}

const allClasses = `prose dark:prose-invert max-w-none ${className}`;

if (!content) {
  return null;
}
---

<div class={allClasses} set:html={processedContent} />
