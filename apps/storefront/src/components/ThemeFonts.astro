---
// Self-hosted fonts for the theme's type pairing: the heading's Latin face
// is preloaded, every face swaps in over a metric-matched fallback (no
// layout shift). The CSS is built from constants only (lib/theme-fonts.ts).
// Under a theme editor preview the style is marked, so the editor's paint
// route can replace it when the merchant picks other fonts.
import type { ThemeFontAssets } from "@/lib/theme-fonts";

interface Props {
  fonts: ThemeFontAssets;
  preview?: boolean;
}

const { fonts, preview = false } = Astro.props;
---

{fonts.preload.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />)}
{(fonts.css || preview) && <style is:inline set:html={fonts.css} data-theme-fonts={preview ? "" : undefined} />}
