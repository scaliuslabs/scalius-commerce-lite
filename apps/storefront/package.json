{
  "name": "@scalius/storefront",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host --port 4322",
    "start": "node ./dist/server/entry.mjs",
    "build": "node scripts/generate-build-id.js && astro check && astro build && node ../../scripts/clean-dist-env-files.mjs apps/storefront",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "node ../../scripts/deploy.mjs --only storefront",
    "typecheck": "node scripts/generate-build-id.js && astro check",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/react": "^5.0.0",
    "@nanostores/react": "^1.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@scalius/api-client": "workspace:*",
    "@scalius/shared": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.6",
    "nanostores": "^1.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-phone-number-input": "^3.4.16",
    "sharp": "^0.34.5",
    "simple-icons": "^16.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^13.5.0",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "happy-dom": "^20.10.2",
    "prettier": "^3.7.4",
