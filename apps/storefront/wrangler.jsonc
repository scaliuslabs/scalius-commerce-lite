{
  "name": "scalius-storefront",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  // Static assets binding (required by @astrojs/cloudflare)
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // Cloudflare KV namespace for cache-busting control
  "kv_namespaces": [
    {
      "binding": "CACHE_CONTROL",
      "id": "b69ad8d7d9b342bb83849caef7142842"
    }
  ],
  // Service binding to the standalone API worker (was "testdash" monolith)
  "services": [
    {
      "binding": "BACKEND_API",
      "service": "scalius-api"
    }
  ],
  "vars": {
    "PUBLIC_API_URL": "https://api.scalius.com/api/v1",
    "PUBLIC_API_BASE_URL": "https://api.scalius.com",
    "STOREFRONT_URL": "https://store.wrygo.com",
    "CDN_DOMAIN_URL": "cloud.scalius.com"
  }
}
