{
	"name": "scalius-storefront",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public",
		"disable_nodejs_process_v2"
	],
	"limits": {
		"cpu_ms": 300000
	},
	// workers_dev: false — Workers only accessible via custom domains, not *.workers.dev
	"workers_dev": false,
	"preview_urls": false,
	"cache": {
		"enabled": true
	},
	"exports": {
		"default": { "type": "worker", "cache": { "enabled": false } },
		"PublicStorefront": { "type": "worker", "cache": { "enabled": true } }
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	// Use a unique inspector port so admin + storefront can run concurrently
	"dev": {
		"inspector_port": 9231
	},
	// Static assets binding (required by @astrojs/cloudflare)
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "7e26aa6f7fb344429379d845e5492cb4"
		}
	],
	// Service binding to the standalone API worker (was "testdash" monolith)
	"services": [
		{
			"binding": "BACKEND_API",
			"service": "scalius-api"
		}
	],
	"vars": {
		"PUBLIC_API_URL": "https://api.scalius.com/api/v1",
		"PUBLIC_API_BASE_URL": "https://api.scalius.com",
		"STOREFRONT_URL": "https://storefront.scalius.com",
		"DASHBOARD_URL": "https://dashboard.scalius.com",
		"CACHE_NAMESPACE": "storefront.scalius.com",
		"CDN_DOMAIN_URL": "cloud.scalius.com"
	}
}
