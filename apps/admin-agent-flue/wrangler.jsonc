{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scalius-admin-agent-flue-canary",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  },
  "migrations": [
    {
      "tag": "flue-admin-v1",
      "new_sqlite_classes": ["FlueRegistry", "FlueAdminCopilotAgent"]
    }
  ],
  "vars": {
    "AGENT_SURFACE": "admin",
    "CANARY_VERSION": "0.1.0"
  }
}
