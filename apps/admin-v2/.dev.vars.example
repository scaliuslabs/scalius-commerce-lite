# Runtime secrets for the Admin V2 worker (Cloudflare Workers, local development)
# Auto-generated by: pnpm dev:setup
# Manual setup: copy this file to .dev.vars and fill in the two values below.
#
# URLs are never configured here: the dashboard reads them from the API
# (GET /api/v1/platform) and local development falls back to localhost ports.

# Master secret. Must be identical to apps/api/.dev.vars and
# apps/storefront/.dev.vars and >= 32 characters.
# Generate with: openssl rand -base64 48
SCALIUS_SECRET="<auto-generated>"

# AES-256-GCM key for merchant credentials at rest. Must match the API worker.
# base64 of exactly 32 random bytes. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="<auto-generated>"

# ─── Optional: non-D1 relational providers only ───
# DATABASE_PROVIDER="turso"            # d1 (default) | turso | postgres
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""
# POSTGRES_DATABASE_URL=""             # or bind HYPERDRIVE in wrangler config
# DATABASE_MIGRATION_FREEZE="1"        # operations-only cutover switch
