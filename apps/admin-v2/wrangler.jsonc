{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scalius-admin-v2",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "limits": {
    "cpu_ms": 30000
  },
  "dev": {
    "inspector_port": 9232
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scalius-commerce",
      "database_id": "2efcad0d-841e-4f8d-b8f6-5b735d881edc",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d6e2d77d898e4b3f9c186802ce63f9b8"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "services": [
    {
      "binding": "API",
      "service": "scalius-api"
    }
  ],
  // The Vite plugin manages the assets directory; the binding lets the Worker
  // serve build assets below a runtime dashboard base path (Platform settings).
  "assets": {
    "binding": "ASSETS"
  }
  // No `vars`. Runtime configuration (storefront/API/dashboard/media URLs)
  // lives in the dashboard: Settings -> System -> Platform, read through the
  // API service binding at GET /api/v1/platform. The only installed secrets
  // are SCALIUS_SECRET and CREDENTIAL_ENCRYPTION_KEY (`wrangler secret put`).
  // `pnpm check:env` fails on any `vars` block.
}
