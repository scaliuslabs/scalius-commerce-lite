---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { PageForm } from "../../../../components/admin/PageForm";
import { getPageEditData } from "@/loaders/admin/catalog";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/pages");
}

const page = await getPageEditData(id);

if (!page) {
  return Astro.redirect("/admin/pages");
}
---

<AdminLayout title={`Edit Page: ${page.title}`}>
  <div class="container max-w-7xl py-4 pb-8">
    <PageForm client:idle defaultValues={page} isEdit={true} />
  </div>
</AdminLayout>
