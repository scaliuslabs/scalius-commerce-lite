---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { CustomerForm } from "../../../components/admin/CustomerForm";

// Default values for the form
const defaultValues = {
  name: "",
  email: null,
  phone: "",
  address: null,
  city: null,
  zone: null,
  area: null,
};
---

<AdminLayout title="New Customer">
  <div class="container max-w-7xl py-4 pb-8">
    <CustomerForm client:idle defaultValues={defaultValues} isEdit={false} />
  </div>
</AdminLayout>
