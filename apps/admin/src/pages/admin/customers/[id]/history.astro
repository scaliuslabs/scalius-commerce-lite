---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { CustomerHistoryView } from "../../../../components/admin/CustomerHistoryView";
import { getCustomerHistoryData } from "@/loaders/admin/customers";

const { id } = Astro.params;

const historyData = id ? await getCustomerHistoryData(id) : null;
if (!historyData) {
  return Astro.redirect("/admin/customers");
}
const { customer, history, orders } = historyData;
---

<AdminLayout title={`Customer History - ${customer.name}`}>
  <CustomerHistoryView
    client:idle
    customer={customer}
    history={history}
    orders={orders}
  />
</AdminLayout>
