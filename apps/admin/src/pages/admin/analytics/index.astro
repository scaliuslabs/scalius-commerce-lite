---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { AnalyticsList } from "../../../components/admin/AnalyticsList";
import { getAnalyticsListData } from "@/loaders/admin/analytics";

const formattedScripts = await getAnalyticsListData();
---

<AdminLayout title="Analytics Scripts">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Analytics Scripts</h1>
      <p class="text-muted-foreground">
        Manage analytics and tracking scripts for your site.
      </p>
    </div>
    <AnalyticsList analytics={formattedScripts} client:idle />
  </div>
</AdminLayout>
