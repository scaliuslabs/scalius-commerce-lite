---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { OrderView } from "@/components/admin/OrderView";
import { DeliveryService } from "@scalius/core/modules/delivery/service";
import { getOrderViewData } from "@/loaders/admin/orders";

// Get order ID from URL
const { id } = Astro.params;

const orderViewData = id ? await getOrderViewData(id) : null;
if (!orderViewData) {
  return Astro.redirect("/admin/orders");
}
const { order, items, totalAmount, cityName, zoneName, areaName } = orderViewData;

// Get delivery providers and shipments
const deliveryService = new DeliveryService();
const shipments = await deliveryService.getShipments(id as string);
const activeProviders = await deliveryService.getActiveProviders();

// Format dates properly
const formattedOrder = {
  ...order,
  createdAt: new Date(order.createdAt * 1000),
  updatedAt: new Date(order.updatedAt * 1000),
  items,
  totalAmount,
  // Add location names
  cityName,
  zoneName,
  areaName,
  // Add shipment data
  shipments,
  deliveryProviders: activeProviders,
};
---

<AdminLayout title={`Order #${order.id}`}>
  <OrderView client:idle order={formattedOrder} />

  <script>
    import { initShipmentActions } from "@/lib/client/shipment-actions";
    initShipmentActions();
  </script>
</AdminLayout>
