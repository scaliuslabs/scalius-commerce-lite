---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { OrderView } from "@/components/admin/OrderView";
import { getOrderViewData, getOrderShipments, getDeliveryProviders } from "@/loaders/admin/orders";

// Get order ID from URL
const { id } = Astro.params;

const orderViewData = id ? await getOrderViewData(id) : null;
if (!orderViewData) {
  return Astro.redirect("/admin/orders");
}
const { order, items, totalAmount, cityName, zoneName, areaName } = orderViewData;

// Get delivery providers and shipments via API
const [shipments, activeProviders] = await Promise.all([
  getOrderShipments(id as string),
  getDeliveryProviders(),
]);

// Format dates properly — API returns Date objects (serialized as ISO strings)
const createdAt = order.createdAt instanceof Date
  ? order.createdAt
  : typeof order.createdAt === "number"
    ? new Date(order.createdAt * 1000)
    : new Date(order.createdAt);
const updatedAt = order.updatedAt instanceof Date
  ? order.updatedAt
  : typeof order.updatedAt === "number"
    ? new Date(order.updatedAt * 1000)
    : new Date(order.updatedAt);

const formattedOrder = {
  ...order,
  createdAt,
  updatedAt,
  items,
  totalAmount,
  // Add location names
  cityName,
  zoneName,
  areaName,
  // Add shipment data
  shipments,
  deliveryProviders: activeProviders,
};
---

<AdminLayout title={`Order #${order.id}`}>
  <OrderView client:idle order={formattedOrder} />

  <script>
    import { initShipmentActions } from "@/lib/client/shipment-actions";
    initShipmentActions();
  </script>
</AdminLayout>
