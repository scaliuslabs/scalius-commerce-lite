---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { CategoryList } from "../../../components/admin/categories";
import { getCategoriesIndexData } from "@/loaders/admin/catalog";

const searchParams = Astro.url.searchParams;
const page = parseInt(searchParams.get("page") || "1");
const limit = parseInt(searchParams.get("limit") || "20");
const search = searchParams.get("search") || "";
const showTrashed = searchParams.get("trashed") === "true";
const sort = (searchParams.get("sort") || "updatedAt") as
  | "name"
  | "createdAt"
  | "updatedAt";
const order = (searchParams.get("order") || "desc") as "asc" | "desc";

type LoaderResult = Awaited<ReturnType<typeof getCategoriesIndexData>>;

let formattedCategories: LoaderResult["categories"] = [];
let pagination: LoaderResult["pagination"] = { total: 0, page, limit, totalPages: 0 };
let stats: LoaderResult["stats"] | null = null;

try {
  const result = await getCategoriesIndexData({
    page,
    limit,
    search,
    showTrashed,
    sort,
    order,
  });
  formattedCategories = result.categories;
  pagination = result.pagination;
  stats = result.stats;
} catch (error) {
  console.error("Error fetching categories in SSR:", error);
  return Astro.redirect("/admin?error=categories-load-failed");
}
---

<AdminLayout title={showTrashed ? "Trash" : "Categories"}>
  <CategoryList
    client:idle
    categories={formattedCategories}
    pagination={{
      total: pagination.total,
      page,
      limit,
      totalPages: pagination.totalPages,
    }}
    initialSearchQuery={search}
    initialSort={{ field: sort, order }}
    showTrashed={showTrashed}
    stats={stats ? {
      totalCategories: stats.totalCategories ?? stats.categoriesCount ?? 0,
      categoriesWithImages: stats.categoriesWithImages ?? 0,
      totalProducts: stats.totalProducts,
    } : undefined}
  />
</AdminLayout>
