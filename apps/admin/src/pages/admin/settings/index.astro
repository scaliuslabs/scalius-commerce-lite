import GeneralSettingsPage from "../../../components/admin/settings/GeneralSettingsPage";
import { getGeneralSettingsData } from "@/loaders/admin/settings";

const { headerConfig, footerConfig } = await getGeneralSettingsData();
---

<AdminLayout title="General Settings">
