---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { DeliveryProviderSettings } from "@/components/admin/DeliveryProviderSettings";
import { getDeliveryProvidersData } from "@/loaders/admin/settings";

const providers = await getDeliveryProvidersData();
---

<AdminLayout title="Delivery Provider Settings">
  <div class="max-w-5xl mx-auto">
    <div class="mb-6">
      <h1 class="text-2xl font-bold tracking-tight">Delivery Providers</h1>
      <p class="text-sm text-muted-foreground mt-1">
        Configure and manage delivery service integrations.
      </p>
    </div>

    <DeliveryProviderSettings client:idle providers={providers} />
  </div>
</AdminLayout>
