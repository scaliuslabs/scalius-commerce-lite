---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { ProductForm } from "../../../../components/admin/ProductForm";
import { VariantManager } from "../../../../components/admin/product-form/variants";
import { getProductEditData } from "@/loaders/admin/products";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/products");
}

const productData = await getProductEditData(id);
if (!productData) {
  return Astro.redirect("/admin/products");
}

const { product, allCategories, defaultValues, formattedVariants } = productData;
---

<AdminLayout title={`Edit ${product.name}`}>
  <div class="container max-w-7xl space-y-6 py-4 pb-8">
    <ProductForm
      client:idle
      categories={allCategories}
      defaultValues={defaultValues}
      isEdit={true}
    />

    <div class="mt-6" id="variant-section">
      <VariantManager
        client:idle
        productId={product.id}
        productSlug={product.slug}
        productName={product.name}
        variants={formattedVariants}
      />
    </div>
  </div>
</AdminLayout>

<script>
  import { initVariantScroll } from "@/lib/client/variant-scroll";
  initVariantScroll();
</script>