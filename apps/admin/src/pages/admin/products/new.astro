---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { ProductForm } from "../../../components/admin/ProductForm";
import { getActiveCategories } from "@/loaders/admin/products";

const allCategories = await getActiveCategories();

// Default values for the form
const defaultValues = {
  name: "",
  description: null,
  price: 0,
  categoryId: "",
  isActive: true,
  discountType: "percentage" as "percentage" | "flat",
  discountPercentage: 0,
  discountAmount: 0,
  freeDelivery: false,
  metaTitle: null,
  metaDescription: null,
  slug: "",
  images: [],
};
---

<AdminLayout title="New Product">
  <div class="container max-w-7xl py-4 pb-8">
    <ProductForm
      client:idle
      categories={allCategories}
      defaultValues={defaultValues}
      isEdit={false}
    />
  </div>
</AdminLayout>

<script>
  import { initProductNewPage } from "@/lib/client/product-actions";
  initProductNewPage();
</script>
