---
/**
 * /scanner — Standalone mobile-first scanner page.
 *
 * Does NOT use AdminLayout. Warehouse staff authenticate via a QR-token
 * generated by an admin, not via normal login.
 *
 * URL: /scanner?token=XXX
 */
import "../styles/global.css";
import favicon from "@/assets/favicon.png";
import ScannerApp from "@/components/scanner/ScannerApp";

const token = Astro.url.searchParams.get("token") || "";
---

<html lang="en" class="dark antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>Scalius Scanner</title>
    <script is:inline>
      // Force dark mode for scanner
      document.documentElement.classList.add("dark");
      document.documentElement.style.setProperty("color-scheme", "dark");
    </script>
  </head>
  <body class="bg-background text-foreground min-h-screen overflow-hidden">
    <div id="scanner-root">
      <ScannerApp client:load token={token} />
    </div>
  </body>
</html>
