---
// src/layouts/components/UserContext.astro
// Sets window.__USER_ID__, __USER_PERMISSIONS__, __IS_SUPER_ADMIN__ for client scripts

interface Props {
  userId: string;
  permissions: string[];
  isSuperAdmin: boolean;
}

const { userId, permissions, isSuperAdmin } = Astro.props;
---

<script is:inline define:vars={{ userId, permissions, isSuperAdmin }}>
  // Store user info in window for the module script to access
  try {
    if (userId) window.__USER_ID__ = userId;
    // Store permissions for React components
    window.__USER_PERMISSIONS__ = permissions || [];
    window.__IS_SUPER_ADMIN__ = isSuperAdmin || false;
  } catch (_e) {
    // Safe defaults if user session expired
    window.__USER_PERMISSIONS__ = [];
    window.__IS_SUPER_ADMIN__ = false;
  }
</script>
