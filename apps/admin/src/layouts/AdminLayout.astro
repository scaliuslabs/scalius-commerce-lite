---
// src/layouts/AdminLayout.astro — Orchestrator
import { Toaster as SonnerToaster } from "@/components/ui/sonner";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SideBar from "@/components/admin/adminLayout/SideBar.astro";
import { generateAdminBreadcrumbs } from "@/lib/adminBreadCrumb";
import favicon from "@/assets/favicon.png";
import { getFilteredNavSections } from "./components/AdminNav";
import ThemeInit from "./components/ThemeInit.astro";
import AdminHeader from "./components/AdminHeader.astro";
import AdminSpinner from "./components/AdminSpinner.astro";
import UserContext from "./components/UserContext.astro";
import FirebaseInit from "./components/FirebaseInit.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

// Auth gate
const user = Astro.locals.user;
const session = Astro.locals.session;
if (!user || !session) {
  return Astro.redirect("/auth/login");
}

// Breadcrumbs
const breadcrumbItems = generateAdminBreadcrumbs(currentPath);

// User data (safe defaults when session expired)
const userData = user ? {
  id: user.id,
  name: user.name,
  email: user.email,
  image: user.image ?? null,
  role: user.role ?? "",
  twoFactorEnabled: user.twoFactorEnabled ?? false,
  isSuperAdmin: (user as any).isSuperAdmin ?? false,
} : {
  id: "",
  name: "",
  email: "",
  image: null as string | null,
  role: "",
  twoFactorEnabled: false,
  isSuperAdmin: false,
};

// Permissions + nav filtering
const permissions = Astro.locals.permissions;
const permissionsArray = permissions ? Array.from(permissions) : [];
const navSections = getFilteredNavSections(permissions, userData.isSuperAdmin);
---

<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <ThemeInit />
    <link rel="icon" type="image/png" href={favicon.src} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - Scalius Admin</title>
  </head>
  <body
    data-current-path={Astro.url.pathname}
    class="bg-background text-foreground transition-colors duration-200"
  >
    <div class="flex min-h-screen">
      <SideBar navSections={navSections} currentPath={currentPath} />

      <!-- Main content -->
      <div class="flex-1 flex flex-col min-h-screen">
        <AdminHeader user={userData} breadcrumbItems={breadcrumbItems} />

        <main
          class="flex-1 p-6 transition-colors duration-200 relative bg-gray-50 dark:bg-[#0a0a0a]"
          id="main-content"
          transition:name="admin-main-content"
          transition:animate="none"
        >
          <AdminSpinner />

          <div class="max-w-7xl mx-auto min-h-[50vh]">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <SonnerToaster richColors closeButton client:idle transition:persist />

    <script>
      import { initNavProgress } from "@/lib/client/nav-progress";

      initNavProgress();

      // Sidebar controls — kept inline (small, DOM-coupled)
      function bindSidebarControl(
        button: HTMLElement | null,
        boundKey: "sidebarToggleBound" | "sidebarCollapseBound",
        eventName: "toggleMobileSidebar" | "toggleSidebarCollapse"
      ) {
        if (!button || button.dataset[boundKey] === "true") return;
        button.dataset[boundKey] = "true";
        button.addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent(eventName));
        });
      }

      function initializeSidebarControls() {
        const sidebarToggleBtn = document.getElementById("sidebar-toggle");
        const sidebarCollapseBtn = document.getElementById("sidebar-collapse");

        bindSidebarControl(sidebarToggleBtn, "sidebarToggleBound", "toggleMobileSidebar");
        bindSidebarControl(sidebarCollapseBtn, "sidebarCollapseBound", "toggleSidebarCollapse");
      }

      if (!(window as any).__adminSidebarPageLoadBound__) {
        (window as any).__adminSidebarPageLoadBound__ = true;
        document.addEventListener("astro:page-load", initializeSidebarControls);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeSidebarControls, { once: true });
      } else {
        initializeSidebarControls();
      }
    </script>

    <UserContext userId={user?.id ?? ""} permissions={permissionsArray} isSuperAdmin={userData?.isSuperAdmin ?? false} />
    <FirebaseInit />
  </body>
</html>
