{
  "name": "@scalius/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to ../../.wrangler/state",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm exec wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config ../../packages/database/drizzle.config.ts",
    "db:migrate:local": "node ../../scripts/deploy.mjs --migrate-only --local",
    "db:migrate:remote": "node ../../scripts/deploy.mjs --migrate-only",
    "test": "vitest run"
  },
  "dependencies": {
    "@scalius/core": "workspace:*",
    "@scalius/database": "workspace:*",
    "@scalius/shared": "workspace:*",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^0.19.10",
    "@hono/zod-validator": "^0.4.3",
    "@paralleldrive/cuid2": "^2.3.1",
    "@polar-sh/sdk": "^0.46.3",
    "better-auth": "^1.5.5",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.12.7",
    "jsonwebtoken": "^9.0.3",
    "mimetext": "^3.0.28",
    "nanoid": "^5.1.6",
    "standardwebhooks": "^1.0.0",
    "stripe": "^20.4.1",
    "fast-xml-parser": "^5.5.3",
    "firebase": "^11.10.0",
    "zod": "^4.3.6",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260310.1",
    "@scalius/tsconfig": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.72.0"
  }
}
