{
  "name": "@scalius/api",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config $(node ../../scripts/plugins.mjs wrangler-config --local) --local --name $(node ../../scripts/dev-ports.mjs api-worker-name) --port ${SCALIUS_DEV_API_PORT:-8787} --persist-to ${SCALIUS_WRANGLER_STATE:-../../.wrangler/state} --show-interactive-dev-session=false",
    "build": "node ../../scripts/check-source-policies.mjs && wrangler deploy --dry-run --outdir dist",
    "deploy": "node ../../scripts/deploy.mjs --only api",
    "typecheck": "../../node_modules/typescript7/bin/tsc --build",
    "db:generate": "cd ../../packages/database && drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:local": "node ../../scripts/deploy.mjs --migrate-only --local",
    "db:migrate:remote": "node ../../scripts/deploy.mjs --migrate-only",
    "test": "vitest run",
    "lint": "oxlint -c ../../.oxlintrc.json src/"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@scalius/core": "workspace:*",
    "@scalius/database": "workspace:*",
    "@scalius/plugin-sdk": "workspace:*",
    "@scalius/shared": "workspace:*",
    "agents": "0.28.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.13",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.2",
    "stripe": "^22.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@scalius/tsconfig": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "4.150.0"
  }
}
