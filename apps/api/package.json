{
  "name": "@scalius/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to ../../.wrangler/state",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm exec wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config ../../packages/database/drizzle.config.ts",
    "db:migrate:local": "node ../../scripts/deploy.mjs --migrate-only --local",
    "db:migrate:remote": "node ../../scripts/deploy.mjs --migrate-only",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.71",
    "@ai-sdk/openai": "^3.0.63",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.2.2",
    "@hono/zod-validator": "^0.7.6",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@paralleldrive/cuid2": "^2.3.1",
    "@polar-sh/sdk": "^0.46.4",
    "@scalius/core": "workspace:*",
    "@scalius/database": "workspace:*",
    "@scalius/shared": "workspace:*",
    "ai": "^6.0.177",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.5.5",
    "drizzle-orm": "^0.45.1",
    "fast-xml-parser": "^5.5.5",
    "firebase": "^12.0.0",
    "hono": "^4.12.7",
    "jsonwebtoken": "^9.0.3",
    "mimetext": "^3.0.28",
    "nanoid": "^5.1.6",
    "standardwebhooks": "^1.0.0",
    "stripe": "^20.4.1",
    "workers-ai-provider": "^3.1.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260313.1",
    "@scalius/tsconfig": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.73.0"
  }
}
