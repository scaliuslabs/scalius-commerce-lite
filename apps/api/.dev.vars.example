# Runtime secrets for the API worker (Cloudflare Workers, local development)
# Auto-generated by: pnpm dev:setup
# Manual setup: copy this file to .dev.vars and fill in the two values below.
#
# Everything else (storefront/API/dashboard/media URLs, cookie domain, CORS
# origins) is configured in the dashboard: Settings -> System -> Platform.
# Local development falls back to localhost:8787/4322/4323 automatically.

# Master secret shared by API, admin, and storefront. Must be >= 32 characters.
# Every other runtime secret (session signing, JWT, service token, purge token,
# agent pepper, customer session hash) is derived from it at Worker entry.
# Generate with: openssl rand -base64 48
SCALIUS_SECRET="<auto-generated>"

# AES-256-GCM key for merchant credentials at rest. Must match the admin worker.
# base64 of exactly 32 random bytes. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="<auto-generated>"

# ─── Optional: non-D1 relational providers only ───
# DATABASE_PROVIDER="turso"            # d1 (default) | turso | postgres
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""
# POSTGRES_DATABASE_URL=""             # or bind HYPERDRIVE in wrangler config
# DATABASE_MIGRATION_FREEZE="1"        # operations-only cutover switch
