# Runtime secrets for API worker (Cloudflare Workers)
# Auto-generated by: pnpm dev:setup
# Manual setup: copy this file to .dev.vars and fill in values

# ─── Shared secrets (must match across all workers) ───
BETTER_AUTH_SECRET="<auto-generated>"
JWT_SECRET="<auto-generated>"
API_TOKEN="<auto-generated>"

# ─── URLs (local development) ───
BETTER_AUTH_URL="http://localhost:4321"
PUBLIC_API_BASE_URL="http://localhost:8787"
STOREFRONT_URL="http://localhost:4322"
R2_PUBLIC_URL="http://localhost:8787/api/v1/media"

# ─── Optional ───
