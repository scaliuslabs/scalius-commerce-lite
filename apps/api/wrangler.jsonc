{
  "name": "scalius-api",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "disable_nodejs_process_v2"
  ],
  "limits": {
    "cpu_ms": 300000
  },
  // workers_dev: false — Workers only accessible via custom domains, not *.workers.dev
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHECKOUT_COORDINATOR",
        "class_name": "CheckoutCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "checkout-coordinator-v1",
      "new_sqlite_classes": ["CheckoutCoordinator"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scalius-commerce",
      "database_id": "2efcad0d-841e-4f8d-b8f6-5b735d881edc",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d6e2d77d898e4b3f9c186802ce63f9b8"
    },
    {
      "binding": "SHARED_AUTH_CACHE",
      "id": "9f577136c05144349f2b8013a4fc1cc5"
    }
  ],
  "ratelimits": [
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "95462026",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "ORDER_IP_RATE_LIMITER",
      "namespace_id": "95462027",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "ORDER_PHONE_RATE_LIMITER",
      "namespace_id": "95462028",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "scalius-media"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PAYMENT_EVENTS_QUEUE",
        "queue": "payment-events"
      },
      {
        "binding": "ORDER_NOTIFICATIONS_QUEUE",
        "queue": "order-notifications"
      },
      {
        "binding": "AUTH_OTP_QUEUE",
        "queue": "auth-otp"
      },
      {
        "binding": "STOREFRONT_CACHE_QUEUE",
        "queue": "storefront-cache"
      }
    ],
    "consumers": [
      {
        "queue": "payment-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "payment-events-dlq"
      },
      {
        "queue": "payment-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5
      },
      {
        "queue": "order-notifications",
        "max_batch_size": 20,
        "max_batch_timeout": 3,
        "max_retries": 3,
        "dead_letter_queue": "order-notifications-dlq"
      },
      {
        "queue": "order-notifications-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5
      },
      {
        "queue": "auth-otp",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "auth-otp-dlq"
      },
      {
        "queue": "auth-otp-dlq",
        "max_batch_size": 3,
        "max_batch_timeout": 5,
        "max_retries": 5
      },
      {
        "queue": "storefront-cache",
        "max_batch_size": 3,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "storefront-cache-dlq"
      },
      {
        "queue": "storefront-cache-dlq",
        "max_batch_size": 3,
        "max_batch_timeout": 5,
        "max_retries": 5
      }
    ]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "DATABASE_PROVIDER": "postgres",
    "PUBLIC_API_BASE_URL": "https://api.scalius.com",
    "BETTER_AUTH_URL": "https://dashboard.scalius.com",
    "STOREFRONT_URL": "https://storefront.scalius.com",
    "CDN_DOMAIN_URL": "cloud.scalius.com",
    "R2_PUBLIC_URL": "https://cloud.scalius.com",
    "PURGE_URL": "https://storefront.scalius.com/api/purge-cache"
  }
}
