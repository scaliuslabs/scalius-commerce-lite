{
  "name": "scalius-api",
  "main": "./src/worker.ts",
  "minify": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "disable_nodejs_process_v2"
  ],
  // No `limits`: this is the Free config (Workers Free has a fixed 10 ms CPU
  // limit and rejects limits.cpu_ms). A Paid deploy (`pnpm run deploy --plan
  // paid`, scripts/plan.mjs) generates a config beside this one that adds
  // limits.cpu_ms 30000 and the plan constant
  // from packages/shared/src/plan-limits.ts. `pnpm check:env` keeps this file
  // at the Free profile.
  // Run the API's fetch handler next to its D1 primary instead of next to the
  // visitor. Every storefront page render is one service-binding call here,
  // and a render's D1 queries come in several dependent waves: from a far
  // colo each wave costs a full round trip to the database (measured ~200 ms
  // per wave from Europe, 1-5 ms beside it). This database lives in APAC and
  // is served from Hong Kong (`wrangler d1 execute ... --remote --json`
  // reports `served_by_colo` HKG); change the region if the database moves.
  // The storefront Worker stays unplaced, so cached pages are still served at
  // the visitor's edge.
  "placement": {
    "region": "aws:ap-east-1"
  },
  "cache": {
    "enabled": true
  },
  "exports": {
    // The RPC-only PluginBridge (src/plugins/bridge-entrypoint.ts) has no
    // fetch handler, so the Workers Cache never applies to it; Cloudflare
    // rejects cache options for it ("unknown entrypoint", code 10375).
    "default": { "type": "worker", "cache": { "enabled": false } }
  },
  // The Worker version isolates dependency-validated entries across deploys.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Large data ships as Text modules, which workerd does not compile at isolate
  // start: generated *.txt (Wrangler's default rule) and the places dataset.
  "rules": [{ "type": "Text", "globs": ["**/places/places.json"], "fallthrough": true }],
  // workers_dev: false — Workers only accessible via custom domains, not *.workers.dev
  "workers_dev": false,
  // The dashboard SPA (built by apps/admin-v2 before this Worker; turbo.json).
  // Hashed bundles under /assets/* are served free by the asset layer; every
  // other path runs this Worker first, which routes the dashboard host
  // (shell, Better Auth, runtime base path) in src/dashboard/surface.ts.
  // The Worker picks the shell itself, so no SPA fallback: a missing chunk
  // must stay a 404, never an HTML 200.
  "assets": {
    "directory": "../admin-v2/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Keep every console.error/warn (payment, webhook, queue, cron failures are
  // masked and rare) but drop the per-request invocation record, which is the
  // bulk of log volume. Traces stay at 1%.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // The realtime hub: one SQLite-backed Durable Object per store (Workers
  // Free and Paid) that fans change notices, presence and save notices out to
  // staff dashboards over hibernatable WebSockets. It stores nothing; the
  // relational database stays the authority (docs/platform/REALTIME.md).
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  // Checkout commits with one guarded database batch per order; the retired
  // checkout coordinator Durable Object is deleted with its stored state.
  "migrations": [
    {
      "tag": "checkout-coordinator-v1",
      "new_sqlite_classes": ["CheckoutCoordinator"]
    },
    {
      "tag": "checkout-coordinator-v2-delete",
      "deleted_classes": ["CheckoutCoordinator"]
    },
    {
      "tag": "realtime-hub-v1",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scalius-commerce-v2",
      "database_id": "83f64596-fee8-4627-9d99-69b099add10c",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  // Two native limiter namespaces. Counters are account-wide per namespace_id,
  // so every key is scoped to this store (src/utils/rate-limit.ts).
  "ratelimits": [
    {
      "name": "RL_STRICT",
      "namespace_id": "95462028",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "RL_STANDARD",
      "namespace_id": "95462026",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      // Public media under media/; sealed agent artifacts under
      // private/agent-artifacts/ (block that prefix on the media hostname).
      "binding": "BUCKET",
      "bucket_name": "scalius-media"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // Background work has no queue: it drains durable rows right after the
  // write that created them (`waitUntil`) and on this every-minute tick, which
  // also runs the maintenance sweeps every 15 minutes
  // (src/scheduled-maintenance.ts, src/scheduled/slices.ts).
  "triggers": {
    "crons": ["* * * * *"]
  }
  // No `vars`. Runtime configuration (storefront/API/dashboard/media URLs,
  // cookie domain, CORS origins) lives in the dashboard: Settings -> System ->
  // Platform, served by GET /api/v1/platform. The only installed secrets are
  // SCALIUS_SECRET and CREDENTIAL_ENCRYPTION_KEY (`wrangler secret put`).
  // Non-D1 deployments may additionally install DATABASE_PROVIDER plus the
  // matching TURSO_*/POSTGRES_* values; `pnpm check:env` fails on any `vars`.
}
