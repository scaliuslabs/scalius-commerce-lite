{
  "extends": "@scalius/tsconfig/worker.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@scalius/database/*": [
        "../../packages/database/src/*"
      ],
      "@scalius/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuild/api.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/database"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/plugin-sdk"
    }
  ]
}
