{
  "extends": "@scalius/tsconfig/worker.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@scalius/database/*": [
        "../../packages/database/src/*"
      ],
      "@scalius/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/**/*",
    "src/**/*.d.ts"
  ]
}
