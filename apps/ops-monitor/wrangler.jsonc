{
  "name": "scalius-ops-monitor",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "kv_namespaces": [
    {
      "binding": "OPS_MONITOR_STATE",
      "id": "6e5d1736490f4e7e82d7a27b1b173355"
    }
  ],
  "send_email": [
    {
      "name": "ALERT_EMAIL"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PAYMENT_EVENTS_QUEUE",
        "queue": "payment-events"
      },
      {
        "binding": "PAYMENT_EVENTS_DLQ",
        "queue": "payment-events-dlq"
      },
      {
        "binding": "ORDER_NOTIFICATIONS_QUEUE",
        "queue": "order-notifications"
      },
      {
        "binding": "ORDER_NOTIFICATIONS_DLQ",
        "queue": "order-notifications-dlq"
      },
      {
        "binding": "AUTH_OTP_QUEUE",
        "queue": "auth-otp"
      },
      {
        "binding": "AUTH_OTP_DLQ",
        "queue": "auth-otp-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "vars": {
    "READYZ_URL": "https://api.scalius.com/api/v1/readyz",
    "READYZ_TIMEOUT_MS": "10000",
    "QUEUE_METRICS_TIMEOUT_MS": "5000",
    "DLQ_BACKLOG_THRESHOLD": "0",
    "QUEUE_OLDEST_AGE_THRESHOLD_MS": "300000",
    "ALERT_STREAK_THRESHOLD": "3",
    "ALERT_COOLDOWN_MS": "300000",
    "STATE_TTL_SECONDS": "86400",
    "ALERT_EMAIL_FROM": "",
    "ALERT_EMAIL_TO": "",
    "ALERT_EMAIL_SUBJECT_PREFIX": "[Scalius ops]"
  }
}
