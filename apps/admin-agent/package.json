  "dependencies": {
    "@scalius/agent-runtime": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@scalius/tsconfig": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "4.107.1"
  }
}
