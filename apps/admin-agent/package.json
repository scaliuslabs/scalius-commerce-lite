{
  "name": "@scalius/admin-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "../../node_modules/typescript7/bin/tsc --noEmit",
