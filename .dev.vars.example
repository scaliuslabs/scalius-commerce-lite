# .dev.vars.example
# Runtime secrets for local development (Cloudflare Worker env bindings).
#
# You don't need to create this manually — `pnpm dev:setup` generates
# .dev.vars in each app directory automatically with random secrets.
#
# This file is just a reference. Each app (api, admin, storefront) has
# its own .dev.vars with the secrets it needs.
#
# Third-party integrations (Stripe, Resend, Firebase, delivery providers,
# CSP domains) are configured from the admin dashboard and stored in D1.

# Required secrets (auto-generated by dev:setup)
BETTER_AUTH_SECRET="generate_a_secure_random_string_here"
JWT_SECRET="generate_a_secure_random_string_here"
API_TOKEN="generate_a_secure_random_string_here"

# Required local URL overrides
BETTER_AUTH_URL="http://localhost:4321"
PUBLIC_API_BASE_URL="http://localhost:8787"
STOREFRONT_URL="http://localhost:4322"

# Optional — only needed if testing media uploads locally
# R2_PUBLIC_URL="https://cdn.yourdomain.com"
# CDN_DOMAIN_URL="cdn.yourdomain.com"

# Optional — storefront cache purge
# PURGE_URL="https://storefront.yourdomain.com/api/purge-cache"
# PURGE_TOKEN="generate_a_secure_random_string_here"
