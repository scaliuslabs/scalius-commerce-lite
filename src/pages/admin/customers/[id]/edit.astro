---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { CustomerForm } from "../../../../components/admin/CustomerForm";
import { getCustomerEditData } from "@/server/loaders/admin/customers";

// Get customer ID from URL
const { id } = Astro.params;

const customer = id ? await getCustomerEditData(id) : null;

if (!customer) {
  return Astro.redirect("/admin/customers");
}
---

<AdminLayout title={`Edit ${customer.name}`}>
  <div class="container max-w-7xl py-4 pb-8">
    <CustomerForm client:idle defaultValues={customer} isEdit={true} />
  </div>
</AdminLayout>
