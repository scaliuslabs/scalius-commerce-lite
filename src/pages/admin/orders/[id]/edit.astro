---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { OrderForm } from "../../../../components/admin/OrderForm";
import { getOrderEditData } from "@/server/loaders/admin/orders";

// Get order ID from URL
const { id } = Astro.params;

const orderData = id ? await getOrderEditData(id) : null;
if (!orderData) {
  return Astro.redirect("/admin/orders");
}
const { order, productsWithVariants, defaultValues } = orderData;
---

<AdminLayout title={`Edit Order #${order.id}`}>
  <div class="container max-w-7xl py-4 pb-8">
    <OrderForm
      client:idle
      products={productsWithVariants}
      defaultValues={defaultValues}
      isEdit={true}
    />
  </div>
</AdminLayout>
