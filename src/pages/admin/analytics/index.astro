---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { AnalyticsList } from "../../../components/admin/AnalyticsList";
import { getAnalyticsListData } from "@/server/loaders/admin/analytics";

const formattedScripts = await getAnalyticsListData();
---

<AdminLayout title="Analytics Scripts">
  <div class="container py-10">
    <div class="mb-10">
      <h1 class="text-3xl font-bold">Analytics Scripts</h1>
      <p class="text-muted-foreground mt-2">
        Manage analytics and tracking scripts for your site.
      </p>
    </div>

    <AnalyticsList analytics={formattedScripts} client:idle />
  </div>
</AdminLayout>
