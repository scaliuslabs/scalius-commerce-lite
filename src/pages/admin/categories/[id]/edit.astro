---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { CategoryForm } from "../../../../components/admin/CategoryForm";
import { getCategoryEditData } from "@/server/loaders/admin/catalog";

// Get category ID from URL
const { id } = Astro.params;

const category = id ? await getCategoryEditData(id) : null;

if (!category) {
  return Astro.redirect("/admin/categories");
}
---

<AdminLayout title={`Edit ${category.name}`}>
  <div class="container max-w-7xl py-4 pb-8">
    <CategoryForm client:idle defaultValues={category} isEdit={true} />
  </div>
</AdminLayout>
