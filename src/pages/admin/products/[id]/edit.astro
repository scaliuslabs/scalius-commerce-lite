---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { ProductForm } from "../../../../components/admin/ProductForm";
import { VariantManager } from "../../../../components/admin/ProductForm/variants";
import { getProductEditData } from "@/server/loaders/admin/products";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/products");
}

const productData = await getProductEditData(id);
if (!productData) {
  return Astro.redirect("/admin/products");
}

const { product, allCategories, defaultValues, formattedVariants } = productData;
---

<AdminLayout title={`Edit ${product.name}`}>
  <div class="container max-w-7xl space-y-6 py-4 pb-8">
    <ProductForm
      client:idle
      categories={allCategories}
      defaultValues={defaultValues}
      isEdit={true}
    />

    <div class="mt-6" id="variant-section">
      <VariantManager
        client:idle
        productId={product.id}
        productSlug={product.slug}
        variants={formattedVariants}
      />
    </div>
  </div>
</AdminLayout>

<script is:inline>
  const urlParams = new URLSearchParams(window.location.search);
  const isNewProduct = urlParams.get("new") === "true";

  if (isNewProduct) {
    setTimeout(() => {
      const variantSection = document.getElementById("variant-section");
      if (variantSection) {
        variantSection.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      }
    }, 500);
  }
</script>