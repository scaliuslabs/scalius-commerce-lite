---
// src/pages/admin/products/[id]/index.astro
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { ProductView } from "../../../../components/admin/ProductView";
import { getProductViewData } from "@/server/loaders/admin/products";

const { id } = Astro.params;

const product = id ? await getProductViewData(id) : null;

if (!product) {
  return Astro.redirect("/admin/products");
}
---

<AdminLayout title={`${product.name} - Product Details`}>
  <ProductView client:idle product={product} />
</AdminLayout>
