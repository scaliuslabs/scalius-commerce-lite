---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { AccountSettingsWithPermissions } from "../../../components/admin/AccountSettingsWithPermissions";
import { getAccountSecurityData } from "@/server/loaders/admin/layout";

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/auth/login");
}

const dbUser = await getAccountSecurityData(user.id);

const userData = {
  id: user.id,
  name: user.name,
  email: user.email,
  image: user.image,
  role: user.role,
  twoFactorEnabled: user.twoFactorEnabled,
  twoFactorMethod: dbUser.twoFactorMethod,
};

const permissions = Astro.locals.permissions;
const permissionsArray = permissions ? Array.from(permissions) : [];
const isSuperAdmin = dbUser.isSuperAdmin;
---

<AdminLayout title="Account Settings">
  <div class="max-w-3xl mx-auto">
    <div class="mb-8">
      <h1 class="text-2xl font-bold">Account Settings</h1>
      <p class="text-sm text-muted-foreground mt-1">
        Manage your account security and administrator access
      </p>
    </div>

    <AccountSettingsWithPermissions
      user={userData}
      permissions={permissionsArray}
      isSuperAdmin={isSuperAdmin}
      client:idle
    />
  </div>
</AdminLayout>
