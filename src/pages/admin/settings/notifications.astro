---
import AdminLayout from "@/layouts/AdminLayout.astro";
import FirebaseSettingsForm from "@/components/admin/settings/FirebaseSettingsForm";
---

<AdminLayout title="Notification Settings">
  <div class="max-w-5xl mx-auto">
    <div class="mb-6">
      <h1 class="text-2xl font-bold tracking-tight">Notification Settings</h1>
      <p class="text-sm text-muted-foreground mt-1">
        Configure push notifications for order alerts and updates.
      </p>
    </div>

    <FirebaseSettingsForm client:idle />
  </div>
</AdminLayout>
