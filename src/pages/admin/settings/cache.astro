---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { CacheManager } from "../../../components/admin/CacheManager";
---

<AdminLayout title="Cache Settings">
  <div class="container py-8 space-y-8 max-w-6xl">
    <div class="flex items-start justify-between">
      <div class="space-y-1">
        <h1 class="text-3xl font-extrabold tracking-tight bg-gradient-to-br from-foreground to-foreground/70 bg-clip-text text-transparent">Cache Settings</h1>
        <p class="text-muted-foreground text-lg">
          Manage application cache to improve storefront performance
        </p>
      </div>
    </div>

    <CacheManager client:only="react" />
  </div>
</AdminLayout>
