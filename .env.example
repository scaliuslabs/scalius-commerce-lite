# .env.example
# Scalius Commerce Lite - Backend Environment Variables
# Copy this file to `.dev.vars` for local development.
# In production, these should be set using `npx wrangler secret put <NAME>`

# ── Required Secrets (Do not share these) ───────────────────────────────────

# Random secure 32+ character strings for cryptography
BETTER_AUTH_SECRET="generate_a_secure_random_string_here"
JWT_SECRET="generate_a_secure_random_string_here"

# Tokens for internal API communication and cache purging
API_TOKEN="generate_a_secure_random_string_here"
PURGE_TOKEN="generate_a_secure_random_string_here"

# ── Required Variables (Configure in wrangler.jsonc for production) ──────────

# Better Auth — Must match where the backend server runs
BETTER_AUTH_URL="http://localhost:4321"

# Public API base (Used for CSP, CORS, and X-Proxy-Base-URL headers)
PUBLIC_API_BASE_URL="http://localhost:4321"

# Storefront URL for redirects (e.g. payment success/cancel)
STOREFRONT_URL="http://localhost:4322"

# ── Optional Variables ──────────────────────────────────────────────────────

# R2 Public URL — Your Cloudflare R2 custom domain for images/media
R2_PUBLIC_URL="https://cdn.yourdomain.com"
CDN_DOMAIN_URL="cdn.yourdomain.com"

# Purge URL — The Storefront API endpoint to hit for cache invalidation
PURGE_URL="http://localhost:4322/api/purge-cache"
