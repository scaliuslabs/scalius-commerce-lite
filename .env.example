# .env.example
# Scalius Commerce Lite - build-time / public environment variables
#
# Copy the values you need from this file into `.env.development`.
# Local runtime secrets and Worker URL overrides belong in `.dev.vars`
# instead; see `.dev.vars.example`.
#
# `pnpm dev:setup` creates both `.env.development` and `.dev.vars`
# automatically for local development.
#
# Resend, payment gateways, delivery providers, and the primary Firebase
# config are dashboard-managed and do not belong in this file.

# Required in practice for the Better Auth React client
PUBLIC_API_BASE_URL="http://localhost:4321"

# Optional Firebase public config fallback.
# The preferred source is the admin dashboard at Settings -> Notifications.
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""
PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Optional AI request metadata
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
PUBLIC_SITE_URL="https://your-site.example"
SITE_TITLE="Your Store Name"
