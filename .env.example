# .env.example
# Build-time variables for Vite/Astro (apps/admin/.env.development).
#
# You don't need to create this manually — `pnpm dev:setup` generates
# .env.development in apps/admin/ automatically.
#
# Runtime secrets belong in .dev.vars, not here. See .dev.vars.example.
# Third-party integrations are configured from the admin dashboard.

# Required — used by the Better Auth React client and Vite dev proxy
PUBLIC_API_BASE_URL="http://localhost:4321"
