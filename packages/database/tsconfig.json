{
  "extends": "@scalius/tsconfig/worker.json",
  "compilerOptions": {
    "paths": {
      "@scalius/database/*": [
        "./src/*"
      ]
    },
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.cache/tsbuild/database",
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuild/database.tsbuildinfo"
  },
  "include": [
    "src/**/*"
  ]
}
