{
  "extends": "@scalius/tsconfig/base.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.cache/tsbuild/plugin-sdk",
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuild/plugin-sdk.tsbuildinfo"
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
