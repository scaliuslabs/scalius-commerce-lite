{
  "version": 4,
  "template": "heritage-editorial",
  "tokens": {
    "typography": "heritage",
    "typeScale": "display",
    "headingCase": "uppercase",
    "density": "airy",
    "radius": "square",
    "buttonShape": "radius",
    "surface": "flat",
    "imageRatio": "portrait",
    "imageFit": "cover",
    "headerTone": "light",
    "container": "1360",
    "colors": {
      "popover": "#fffdf8",
      "popover-foreground": "#2a2018",
      "ring": "#8a3b1e",
      "background": "#faf6ef",
      "foreground": "#2a2018",
      "card": "#fffdf8",
      "card-foreground": "#2a2018",
      "primary": "#123456",
      "primary-foreground": "#fffdf8",
      "secondary": "#f2eadd",
      "secondary-foreground": "#2a2018",
      "muted": "#f2eadd",
      "muted-foreground": "#665646",
      "accent": "#ecdfc9",
      "accent-foreground": "#4a2c14",
      "destructive": "#a3191b",
      "destructive-foreground": "#ffffff",
      "border": "#e2d5bf",
      "input": "#d2c2a6"
    }
  },
  "blocks": {
    "topBar": {
      "variant": "none",
      "settings": {}
    },
    "header": {
      "variant": "fashion-department",
      "settings": {
        "subBrandRow": true
      }
    },
    "desktopNav": {
      "variant": "mega-panel",
      "settings": {
        "promoImages": false
      }
    },
    "mobileNav": {
      "variant": "accordion-drawer",
      "settings": {}
    },
    "card": {
      "variant": "portrait",
      "settings": {
        "hoverImage": true
      }
    },
    "listing": {
      "layout": {
        "variant": "shelves",
        "settings": {
          "maxShelves": 8
        }
      },
      "toolbar": [
        "breadcrumb",
        "sort",
        "applied-chips"
      ],
      "phoneLayout": "grid",
      "paging": "numbered"
    },
    "product": {
      "gallery": {
        "variant": "portrait",
        "settings": {}
      },
      "buyBox": {
        "variant": "fashion",
        "settings": {}
      },
      "below": [
        "description",
        "related",
        "recently-viewed"
      ],
      "sticky": {
        "phoneTop": "none",
        "phoneBottom": "none",
        "desktop": "none"
      }
    },
    "footer": {
      "variant": "newsletter-grey",
      "settings": {}
    }
  },
  "pages": {
    "home": [
      {
        "id": "hero",
        "type": "hero",
        "version": 1,
        "settings": {
          "layout": "full-screen"
        }
      },
      {
        "id": "categories",
        "type": "category-tiles",
        "version": 1,
        "settings": {
          "style": "photo"
        }
      },
      {
        "id": "campaign",
        "type": "banner",
        "version": 1,
        "settings": {
          "layout": "full",
          "heading": "",
          "text": "",
          "mediaId": null,
          "cta": null
        }
      },
      {
        "id": "whats-new",
        "type": "product-rail",
        "version": 1,
        "settings": {
          "title": "",
          "source": {
            "kind": "newest"
          },
          "limit": 12
        }
      },
      {
        "id": "campaign-2",
        "type": "banner",
        "version": 1,
        "settings": {
          "layout": "full",
          "heading": "",
          "text": "",
          "mediaId": null,
          "cta": null
        }
      },
      {
        "id": "merchant-story",
        "type": "editorial",
        "version": 1,
        "settings": {
          "layout": "rich-text",
          "heading": "আমাদের গল্প",
          "body": "Made in Rajshahi. নিজের হাতে তৈরি।"
        }
      },
      {
        "id": "merchant-banner",
        "type": "banner",
        "version": 1,
        "settings": {
          "layout": "full",
          "heading": "ঈদ সংগ্রহ",
          "text": "Merchant campaign copy",
          "mediaId": "media_campaign",
          "cta": {
            "label": "Shop now",
            "href": "/categories/fashion"
          }
        }
      }
    ]
  }
}
