{
  "extends": "@scalius/tsconfig/base.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.cache/tsbuild/shared",
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuild/shared.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "src/**/*.json"
  ]
}
