{
  "extends": "@scalius/tsconfig/base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuild/cli.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
