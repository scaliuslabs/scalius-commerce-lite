{
  "name": "scalius",
  "version": "0.2.1",
  "description": "Secure CLI for every reviewed Scalius Commerce operation",
  "keywords": [
    "scalius",
    "commerce",
    "ecommerce",
    "cli",
    "mcp",
    "automation"
  ],
  "author": "Scalius Labs",
  "homepage": "https://github.com/scaliuslabs/scalius-commerce-lite#readme",
  "bugs": {
    "url": "https://github.com/scaliuslabs/scalius-commerce-lite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scaliuslabs/scalius-commerce-lite.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "scalius": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "skill"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "../../node_modules/typescript7/bin/tsc -p tsconfig.build.json && node scripts/set-bin-mode.mjs",
    "lint": "eslint src/ test/",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test": "vitest run",
    "typecheck": "../../node_modules/typescript7/bin/tsc --noEmit"
  },
  "dependencies": {
    "commander": "15.0.0",
    "open": "11.0.0"
  },
  "devDependencies": {
    "@scalius/tsconfig": "workspace:*",
    "@types/node": "^24.13.3",
    "vitest": "^4.1.10"
  }
}
