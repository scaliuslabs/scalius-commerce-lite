{
  "extends": "@scalius/tsconfig/worker.json",
  "compilerOptions": {
    "paths": {
      "@scalius/core/*": [
        "./src/*"
      ],
      "@scalius/database/*": [
        "../database/src/*"
      ],
      "@scalius/shared/*": [
        "../shared/src/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
