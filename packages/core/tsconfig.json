{
  "extends": "@scalius/tsconfig/worker.json",
  "compilerOptions": {
    "paths": {
      "@scalius/core/*": [
        "./src/*"
      ],
      "@scalius/database/*": [
        "../database/src/*"
      ],
      "@scalius/shared/*": [
        "../shared/src/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM"
    ],
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "../../node_modules/.cache/tsbuild/core",
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuild/core.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "scripts/catalog-projection-fill.ts"
  ],
  "references": [
    {
      "path": "../shared"
    },
    {
      "path": "../database"
    }
  ]
}
